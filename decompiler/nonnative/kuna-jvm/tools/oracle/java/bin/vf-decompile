#!/usr/bin/env bash
# Decompile classes/jars/dirs with the Vineflower 1.12.0 release jar through the same
# ConsoleDecompiler API path as Vineflower's DecompilerTestFixture (see ../../README.md).
#
#   vf-decompile [--fixture] [--opt k=v]... [--javadoc plain|markdown] [--plugins]
#                [--save legacy|folder|file|console] [--lib PATH]... [--inputs-from FILE]
#                [--print-options] INPUT... -o OUT
#
#   --fixture      start from DecompilerTestFixture.setUp()'s base option map
#                  (log-level=warn dgs=1 rsy=1 rbr=1 lit=1 __unit_test_mode__=1 nls=1
#                   error-message="" include-runtime="") before applying --opt pairs
#   --opt k=v      set option k (long name, e.g. decompile-generics=1; "k=" sets an empty string);
#                  later --opt wins. Without --fixture/--opt, Vineflower's built-in defaults apply.
#   --plugins      load the plugins bundled in the release jar (default: none, like the test suite)
#   --save MODE    legacy (default; test fixture) | folder (CLI's mode for a directory destination)
#
# Env: KUNA_JVM_ORACLE, or the overrides CORPUS (holds driver/classes, built by ../driver/build.sh),
#      VF_JAVA (JVM running the decompiler, default JDK 17), VF_JAR; VF_XMX (default 1g),
#      VF_JAVA_OPTS (extra JVM flags).
set -euo pipefail
NO_ORACLE='set it to the JVM oracle workspace (decompiler/nonnative/kuna-jvm/tools/oracle/README.md)'
CORPUS=${CORPUS:-${KUNA_JVM_ORACLE:?$NO_ORACLE}/corpus}
VF_JAVA=${VF_JAVA:-${KUNA_JVM_ORACLE:?$NO_ORACLE}/jdks/jdk17/bin/java}
VF_JAR=${VF_JAR:-${KUNA_JVM_ORACLE:?$NO_ORACLE}/oracle/vineflower-1.12.0.jar}
# shellcheck disable=SC2086
exec "$VF_JAVA" "-Xmx${VF_XMX:-1g}" -Dfile.encoding=UTF-8 ${VF_JAVA_OPTS:-} -cp "$CORPUS/driver/classes:$VF_JAR" corpus.VfDriver "$@"
