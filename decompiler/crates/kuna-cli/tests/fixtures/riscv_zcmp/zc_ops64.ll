target triple = "riscv64-unknown-elf"
module asm ".text"
module asm ".globl swapcall"
module asm ".type swapcall, @function"
module asm "swapcall:"
module asm "cm.push {ra,s0-s1}, -32"
module asm "cm.mvsa01 s0, s1"
module asm "call ext"
module asm "cm.mva01s s1, s0"
module asm "call ext2"
module asm "addi a0, a0, 1"
module asm "cm.popret {ra,s0-s1}, 32"
module asm ".size swapcall, .-swapcall"
module asm ".globl zret"
module asm ".type zret, @function"
module asm "zret:"
module asm "cm.push {ra}, -16"
module asm "call ext"
module asm "cm.popretz {ra}, 16"
module asm ".size zret, .-zret"
module asm ".globl popsep"
module asm ".type popsep, @function"
module asm "popsep:"
module asm "cm.push {ra,s0}, -32"
module asm "mv s0, a0"
module asm "call ext"
module asm "add a0, a0, s0"
module asm "cm.pop {ra,s0}, 32"
module asm "ret"
module asm ".size popsep, .-popsep"
