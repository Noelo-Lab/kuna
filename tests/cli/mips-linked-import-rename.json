    "binary_rel": "tests/fixtures/mips-import-flow/slots/scoped.so",
    "binary_sha256": "5fc4fc93f682f849692ee7c94c4599dccfb2f619ab591f4a142d9cf17bb26f81",
    "binary_size": 18392,
    "binary_source": "in-repo",
