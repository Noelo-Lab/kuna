{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--option",
    "calleevote",
    "off",
    "--option",
    "callbacktype",
    "off"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/calleevote_x86_64",
    "binary_sha256": "87748df9fd521469bdb5a5bbd4ae3946ea8781c775fdea0b1c186d535bfd7648",
    "binary_size": 16176,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/calleevote_x86_64",
    "selector": "peek_used",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "long peek_used\\(void \\*a0\\)",
      "long report\\(struct_\\d+ \\*a0\\)",
      "bool same\\(long a0,long a1\\)",
      "unsigned long get_cap\\(void \\*a0\\)",
      "bool by_used\\(void \\*a0,void \\*a1\\)"
    ]
  },
  "notes": "OFF: `report` reads three fields of its record and passes it to `peek_used`, which stays `void *`; `same`'s one caller passes strings and it stays `long`; the one-field getter `get_cap` prints raw offset arithmetic. `by_used` is the qsort callback control, kept to calleevote alone by `callbacktype off`.",
  "probe_id": "a-9cd2e1983e98"
}
