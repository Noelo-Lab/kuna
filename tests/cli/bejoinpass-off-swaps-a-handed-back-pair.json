{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--option",
    "bejoinpass",
    "off"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/bejoinpass_mips32_O2",
    "binary_sha256": "8f0dea400c794e972b17160b99d97c25b0e9fcaea458d78b6fe9158a4efcb0cb",
    "binary_size": 1964,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/bejoinpass_mips32_O2",
    "selector": "hi",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "unsigned long long hi\\(int a0,unsigned int a1,int a2,int a3\\)",
      "unsigned long long wrap\\(int a0,unsigned int a1,int a2,int a3\\)",
      "return CONCAT44\\(\\(int\\)v1,\\(int\\)\\(\\(unsigned long long\\)v1 >> 0x20\\)\\);",
      "unsigned long long v1; // v1:v0"
    ],
    "stdout_absent": [
      "return add64\\(a0,a1,a2,a3\\);",
      "return v1;"
    ]
  },
  "notes": "OFF: each side joins by its own verdict. The call reads proven add64 high word first while the unproven wrappers' RETURNs join first register low, and viahook's proven RETURN reads the unknown call joined first register low; each prints the pair with its halves swapped."
}
