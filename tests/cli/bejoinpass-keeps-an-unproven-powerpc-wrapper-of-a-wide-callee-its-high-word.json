{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--option",
    "bejoinpass",
    "high"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/bejoinpass_ppc32_O2.o",
    "binary_sha256": "9ff498d789eb7c0299954fa7f5f13a40ce9633b266dafc8c4c36afe5ce45a0b6",
    "binary_size": 1496,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/bejoinpass_ppc32_O2.o",
    "selector": "hi",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "unsigned int hi\\(int a0,unsigned int a1,int a2,unsigned int a3\\)",
      "return \\(int\\)\\(\\(unsigned long long\\)add64\\(a0,a1,a2,a3\\) >> 0x20\\);",
      "unsigned long long v1; // r3:r4",
      "return v1;"
    ],
    "stdout_absent": [
      "CONCAT44\\(\\(int\\)v1,\\(int\\)\\(\\(unsigned long long\\)v1 >> 0x20\\)\\)",
      "// r4:r3"
    ]
  },
  "notes": "HIGH, PowerPC: the same shapes as the MIPS probe. Under bejoinpass high, hi returns add64's high word in r3; viahook returns the r3:r4 pair a call through a function pointer left, joined high word first on both sides."
}
