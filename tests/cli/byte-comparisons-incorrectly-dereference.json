{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "lookup_service"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/covercopy_x86_64",
    "binary_sha256": "39b43dbe5da561f922ee67896b27295fa7a7bcaedaf4175cc995b63e35ecf28b",
    "binary_size": 16312,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/covercopy_x86_64",
    "selector": "lookup_service",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "char \\* lookup_service\\(char \\*a0,int \\*a1\\)",
      "v[0-9]+ = \\*a0;"
    ],
    "stdout_absent": [
      "unsigned long \\*(v[0-9]+);[\\s\\S]*?\\b\\1 = a0;"
    ]
  },
  "notes": "Require the byte read through the char-pointer input and reject an uncast assignment of that input to a word-pointer local. Separate register lifetimes may legitimately give lookup() its own word-pointer local; banning that declaration would reject correct output. verify_cover_miscompile.rs also executes the generated C across failed and successful lookups."
}
