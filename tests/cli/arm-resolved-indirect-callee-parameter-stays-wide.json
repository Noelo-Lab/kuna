{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/callerargs_reltab_thumb",
    "binary_sha256": "2f02a832b55d1b255eb8b0c2c26d125630f5d57cd2f2275b0bb8d06f9eb75652",
    "binary_size": 1336,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/callerargs_reltab_thumb",
    "selector": "cb",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "int cb\\(unsigned int a0,int a1\\)"
    ],
    "stdout_absent": [
      "cb\\(unsigned char a0"
    ]
  },
  "notes": "cb is called with bytes and also through offsets relative to a table and to another function, with a whole word; kuna resolves that indirect call to cb, so its callers cannot all be listed and the parameter keeps its width.",
  "probe_id": "p-fdb89e4d983c"
}
