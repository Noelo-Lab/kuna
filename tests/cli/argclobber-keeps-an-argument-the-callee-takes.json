{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/argclobber_pair_x86_64",
    "binary_sha256": "f86a70a0ddae5381220a9ea4158469798f5dede3d3f9cabf753c179febcb097d",
    "binary_size": 9000,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/argclobber_pair_x86_64",
    "selector": "caller",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "sub_401020\\(v[0-9]+ & 0xffffffff,v[0-9]+,a1\\) \\+ 1",
      "unsigned long sub_401020\\(unsigned int a0,unsigned long a1,unsigned long a2\\)"
    ],
    "stdout_absent": [
      "sub_401020\\(v[0-9]+ & 0xffffffff,a1\\)"
    ]
  },
  "notes": "rdx here is a join of a real `a % d` and the high half of a 16-byte rax:rdx struct return, and `sub_401020` reads it past a jump table -- past the bounded entry probe. Its recovered prototype carries the parameter, so the argument stays.",
  "probe_id": "p-9ab2d24e0e8b"
}
