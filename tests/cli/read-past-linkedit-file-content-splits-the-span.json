{
  "schema": "re-probe/1",
  "kind": "cli",
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/readprov_macho_arm64",
    "binary_sha256": "df44937763178358cb8f5648b662c06a9c65e0cf9df5843a527d5f3eb5ad9ba9",
    "binary_size": 33504,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/readprov_macho_arm64"
  },
  "timeout_s": 60,
  "cmd": [
    "{{KUNA}}",
    "read",
    "{{BIN}}",
    "0x1000102d8",
    "--addr",
    "--bytes",
    "16",
    "--json"
  ],
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "hex",
        "op": "eq",
        "value": "b35ec5eb930c9a510000000000000000"
      },
      {
        "path": "provenance",
        "op": "len_eq",
        "value": 2
      },
      {
        "path": "provenance[0].source",
        "op": "eq",
        "value": "file"
      },
      {
        "path": "provenance[0].file_offset",
        "op": "eq",
        "value": 33496
      },
      {
        "path": "provenance[0].end_hex",
        "op": "eq",
        "value": "0x1000102e0"
      },
      {
        "path": "provenance[1].source",
        "op": "eq",
        "value": "zero-fill"
      },
      {
        "path": "provenance[1].segment.name",
        "op": "eq",
        "value": "__LINKEDIT"
      },
      {
        "path": "provenance[1].segment.permissions",
        "op": "eq",
        "value": "r--"
      }
    ],
    "stderr_matches": [
      "zero fill, not file bytes: 0x1000102e0\\.\\.0x1000102e8 in __LINKEDIT"
    ]
  },
  "notes": "GH #1401. readprov_macho_arm64's __LINKEDIT declares 0x4000 bytes of memory over 0x2e0 in the file (Apple ld64's page rounding); a read across that end is 8 file bytes from offset 0x82d8 and 8 bytes of zero fill, said in provenance and on stderr."
}
