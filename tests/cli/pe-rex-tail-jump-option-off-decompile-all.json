{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--json",
    "--option",
    "rexthunk",
    "off"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/pe_rexthunk_x86_64.exe",
    "binary_sha256": "29043929b1b24babb13b4f9ecb594ef477014d4b7c0b960b19f7e36775779dc8",
    "binary_size": 1536,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/pe_rexthunk_x86_64.exe",
    "selector": null,
    "selector_kind": "none"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "functions[*].address_hex",
        "op": "contains",
        "value": "0x140001038"
      },
      {
        "path": "count",
        "op": "eq",
        "value": 6
      }
    ]
  },
  "notes": "--option rexthunk off must reach the loader through the env bridge in decompile-all: the entry one byte into the 48 ff 25 tail jump at 0x140001030 comes back (6 functions; 5 at the default)."
}
