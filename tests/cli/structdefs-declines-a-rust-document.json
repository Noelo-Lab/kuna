{
  "schema": "re-probe/1",
  "kind": "cli",
  "timeout_s": 120,
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "walk_list",
    "--json",
    "--language",
    "rust",
    "--option",
    "structdefs",
    "on"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "functions[0].types",
        "op": "eq",
        "value": []
      },
      {
        "path": "functions[0].code",
        "op": "not_contains",
        "value": "struct Node {"
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "unsafe fn walk_list"
      }
    ]
  },
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/dwarfstructs_x86_64",
    "binary_sha256": "452f01173b159dcca385e0f00e075dab4fec8e4472b349a240725ce1b37faec5",
    "binary_size": 21808,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/dwarfstructs_x86_64",
    "selector": "walk_list",
    "selector_kind": "name"
  },
  "notes": "The type-definition renderer is C by contract (it builds the decompile-project .h), so a `struct X { ... };` block in a Rust document would be neither valid Rust nor readable C -- decompile-project refuses a non-C language for the same reason. The preamble and the JSON types array decline together, and the Rust body is emitted unchanged."
}
