    "binary_sha256": "9317a948bb47723d33defbe4a4e4ea729b655e6561fbdb3a6c74c13df55f8ecc",
    "binary_size": 15960,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/elemptr_gcc_O0_x86_64",
    "selector": "w_decode",
    "selector_kind": "name"
