{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "0x140001080",
    "--raw-image",
    "--target",
    "x86:LE:64:default:windows",
    "--base",
    "0x140001000"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/raw_endptrbound_x86_64",
    "binary_sha256": "3c1fd264ee4f611faefcdf79b44e151e1314837afa39b938b1bce79e8703f58b",
    "binary_size": 271,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/raw_endptrbound_x86_64",
    "selector": "0x140001080",
    "selector_kind": "addr"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "(?m)^\\s*if \\(v4 != v3\\)\\s*$",
      "(?m)^\\s*\\} while \\(v1\\);\\s*$"
    ],
    "stdout_absent": [
      "&v2\\[8\\]",
      "char v2 \\[8\\]"
    ]
  },
  "notes": "Negative control for endptrbound: the loop is counted by EBX, and the pointer is compared against buf+8 only to skip one call inside the loop. That comparison controls no loop exit, so it must not become an array bound: no char v2 [8], no &v2[8]."
}
