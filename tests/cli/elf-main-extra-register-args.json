{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--addr",
    "0x1026",
    "--json"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/elfmainextra_x86_64",
    "binary_sha256": "7e8d5dcd8239d4b535b6d3832a8276aaed6bcd5f2a304602ba38d05318917fa7",
    "binary_size": 13464,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/elfmainextra_x86_64",
    "selector": "0x1026",
    "selector_kind": "addr"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "functions[0].name",
        "op": "eq",
        "value": "main"
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "int main(int argc,char **argv,char **envp)"
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "unsigned long v1; // r9"
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "sub_1050(0x2000,argc,argv)"
      }
    ]
  },
  "notes": "What declaring main's real prototype costs, pinned so it stays visible. This main forwards two registers past the third that nothing writes: r8 into a call argument, r9 into a global. Body-driven recovery makes both parameters; the locked three-parameter park leaves the stored one `unsigned long v1; // r9` assigned nowhere and drops the forwarded one from the call."
}
