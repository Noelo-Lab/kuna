{
  "schema": "re-probe/1",
  "probe_id": "a-783844207e76",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "printf",
    "--assert",
    "prototype 0x1000005cc int printf(char *fmt,int value)",
    "--assert",
    "data 0x100003000 int (*printf_ptr)(char *,int)",
    "--assert-strict"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/macho_imports",
    "binary_sha256": "0394e1be81c4ccdfb28a50cf5dba55a6d95a692cd5504f2305a8f139e8f86675",
    "binary_size": 16688,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/macho_imports",
    "selector": "printf",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "int printf\\(char \\*fmt,int value\\)",
      "printf\\(fmt,value\\)"
    ],
    "stdout_absent": [
      "printf\\(\\s*\\)",
      "\\(\\*printf_ptr\\)"
    ]
  },
  "notes": "Promoted acceptance for typed-mach-o-tail on the vendored one-instruction x86-64 Mach-O import veneer. DIV-171 binds the typed lazy slot to its loader import name, so the positive call match now pins printf(fmt,value): both asserted arguments must survive even though the raw printf_ptr spelling is deliberately gone."
}
