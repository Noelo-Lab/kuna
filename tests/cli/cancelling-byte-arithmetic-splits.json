    "json": [
      {
        "path": "functions[0].code",
        "op": "matches",
        "value": "builtin_strncpy\\(usage,\"Usage: %s <password>\\\\n\",0x15\\);"
      }
    ]
  },
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/pe_subcommuteshift_x86_64.exe",
    "binary_sha256": "a39bf9ded430fe75b3a84edebf55dec3ac299bc4428b838a041112a1f8c550fb",
    "binary_size": 10240,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/pe_subcommuteshift_x86_64.exe",
    "selector": "0x1406fa160",
    "selector_kind": "addr"
  },
  "notes": "Promoted acceptance a-88e307f76db7 for cancelling-byte-arithmetic-splits, re-pointed from the 9.3 MB dataset PE to a minimal PE containing the exact 9,024-byte function at its original VMA. The positive full-copy clause proves the formerly computed byte and following suffix store survive; the absence clause rejects the old data-dependent middle byte."
