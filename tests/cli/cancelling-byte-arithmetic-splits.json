{
  "schema": "re-probe/1",
  "kind": "cli",
  "timeout_s": 60,
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "0x1406fa160",
    "--assert",
    "data 0x1408f1c08 char usage[22]",
    "--json"
