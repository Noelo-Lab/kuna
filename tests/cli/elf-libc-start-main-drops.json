{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--addr",
    "0x103dc",
    "--json"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/armlibcmain_le32",
    "binary_sha256": "9df3e29ed40dcd06ef28711ab0d51e0fc0b7600b1978fd628bb0beb63deb6351",
    "binary_size": 5196,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/armlibcmain_le32",
    "selector": "0x103dc",
    "selector_kind": "addr"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "functions[0].name",
        "op": "eq",
        "value": "main"
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "int main(int argc,char **argv,char **envp)"
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "__printf_chk(2,\"kuna armlibcmain prompt\",envp,0)"
      },
      {
        "path": "functions[0].code",
        "op": "not_contains",
        "value": "// r2"
      }
    ]
  },
  "notes": "This main forwards its third argument register to __printf_chk without ever touching it. A two-parameter prototype park deleted that parameter, and the forwarded value became a local declared `unsigned int v4; // r2` and assigned nowhere. The last two clauses pin it as a named parameter instead."
}
