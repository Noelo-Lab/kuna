{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "strings",
    "{{BIN}}",
    "--filter",
    "libc",
    "--json"
  ],
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/midstring_x86_64",
    "binary_sha256": "1a4cc3ca2bc124f6228923046c0859465234c2269dae6d4bfe5c1554feb2c682",
    "binary_size": 16072,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/midstring_x86_64",
    "selector": null,
    "selector_kind": "none"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "count",
        "op": "gt",
        "value": 0
      },
      {
        "path": "count",
        "op": "lt",
        "value": 14
      },
      {
        "path": "filter",
        "op": "eq",
        "value": "libc"
      }
    ]
  },
  "notes": "--filter must actually narrow. count<14 is the unfiltered count on this fixture, so a filter that silently matched everything fails here."
}
