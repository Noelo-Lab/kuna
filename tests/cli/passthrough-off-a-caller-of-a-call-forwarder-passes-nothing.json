{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--option",
    "passthrough",
    "off"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/passthrough_callfwd_x86_64",
    "binary_sha256": "30e1c39851d0336f1037b9338849a11b506fa66eed47e85a43554d51cdc264f2",
    "binary_size": 5304,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/passthrough_callfwd_x86_64",
    "selector": "pass_fwd_call",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "long pass_fwd_call\\(void\\)",
      "return fwd_call\\(\\) \\* 2;",
      "long pass_fwd\\(void\\)"
    ],
    "stdout_absent": [
      "pass_fwd_call\\(long a0"
    ]
  },
  "notes": "The same program with passthrough off: no op of pass_fwd_call names rdi or rsi, so its call gets no trial for them and it forwards nothing, so the probe above measures the option and not the base.",
  "probe_id": "p-144cebd10919"
}
