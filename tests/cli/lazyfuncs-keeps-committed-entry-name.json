{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "main",
    "--option",
    "lazyfuncs",
    "on"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/stripped_dynamic_x86_64",
    "binary_sha256": "f899ab7509c55cc0c5e4e2f7b2e7f781ac1fb1aac6c4f7a2e27b4dba256e1c0a",
    "binary_size": 14480,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/stripped_dynamic_x86_64",
    "selector": "main",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "int main\\(int argc,char \\*\\*argv,char \\*\\*envp\\)"
    ],
    "stdout_absent": [
      "unsigned long main\\("
    ]
  },
  "notes": "Desired: `lazyfuncs on` leaves output unchanged. The entry oracle's `main` name and C runtime declaration attach to the Function at the analysis commit; a name-only commit rendered `unsigned long main(int a0,struct_0 *a1)` and `_start` passed `sub_1405`."
}
