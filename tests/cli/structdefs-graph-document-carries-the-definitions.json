{
  "schema": "re-probe/1",
  "kind": "cli",
  "timeout_s": 120,
  "cmd": [
    "{{KUNA}}",
    "decompile-graph",
    "{{BIN}}",
    "--functions",
    "main",
    "--option",
    "structdefs",
    "on"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "functions[*].codeC",
        "op": "contains",
        "value": "typedef struct option option; /* opaque */"
      }
    ]
  },
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/i386_pie_nl",
    "binary_sha256": "2cc72cbd21561b5907af240cc9b5396f20821e7cbc5fabd2588319cf01c6d30b",
    "binary_size": 48024,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/i386_pie_nl",
    "selector": "main",
    "selector_kind": "name"
  },
  "notes": "decompile-graph's document is per-function C with no header artifact, so the definitions have to ride in `codeC` -- the same place `decompile-all` puts them in `code`. The suppression that keeps them out of a decompile-project body is keyed on that export's header, not on asking for a prototype, which this surface also does."
}
