{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "strings",
    "{{BIN}}",
    "--json"
  ],
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/midstring_x86_64",
    "binary_sha256": "1a4cc3ca2bc124f6228923046c0859465234c2269dae6d4bfe5c1554feb2c682",
    "binary_size": 16072,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/midstring_x86_64",
    "selector": null,
    "selector_kind": "none"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "count",
        "op": "gt",
        "value": 0
      },
      {
        "path": "strings[0].address_hex",
        "op": "exists"
      },
      {
        "path": "strings[0].section",
        "op": "exists"
      },
      {
        "path": "strings[0].xrefs_count",
        "op": "exists"
      }
    ]
  },
  "notes": "Five testers across four challenges independently asked for a string inventory. Asserting address_hex/section/xrefs_count, not just count: strings(1) already gives text at a file offset, so a VMA plus the owning section and xref count is the whole reason this subcommand exists."
}
