{
  "schema": "re-probe/1",
  "kind": "cli",
  "timeout_s": 120,
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "main",
    "--json",
    "--option",
    "structdefs",
    "on"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "functions[0].types[0].name",
        "op": "eq",
        "value": "FILE"
      },
      {
        "path": "functions[0].types[0].definition",
        "op": "contains",
        "value": "typedef struct FILE FILE; /* opaque */"
      },
      {
        "path": "functions[0].types[0].size",
        "op": "eq",
        "value": 216
      },
      {
        "path": "functions[0].types[2].name",
        "op": "eq",
        "value": "option"
      },
      {
        "path": "functions[0].types[2].definition",
        "op": "contains",
        "value": "typedef struct option option; /* opaque */"
      },
      {
        "path": "functions[0].types[2].size",
        "op": "eq",
        "value": 32
      },
      {
        "path": "functions[0].code",
        "op": "contains",
        "value": "typedef struct option option; /* opaque */"
      }
    ]
  },
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/datasyms_faillog_x86_64",
    "binary_sha256": "d3b414256e4878f86ff281a7f315b399116c95cf930f0654aecc2125c7ff9578",
    "binary_size": 22992,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/datasyms_faillog_x86_64",
    "selector": "main",
    "selector_kind": "name"
  },
  "notes": "structdefs on: main references four libc shells, among them the `FILE` its streams are and the `struct option` it hands `getopt_long`. The `types` array carries them in definition-before-use order, and two are pinned by name, .h text and size; structscore.py parses that text, so a consumer never parses C out of `code`. Retargeted from the i386 `i386_pie_nl`: the shells carry glibc's x86-64 widths (FILE 216), which are not i386's, so libctypes names nothing there."
}
