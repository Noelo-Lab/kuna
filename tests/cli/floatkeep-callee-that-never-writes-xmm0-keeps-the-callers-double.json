  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/floatkeep_gcc_O2_avx2",
    "binary_sha256": "d94f3f000bf68f84e25c8927a9a9fe64758cded91ccbe26188b65446234dbb3d",
    "binary_size": 16128,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/floatkeep_gcc_O2_avx2",
    "selector": "keep_int",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "^double keep_int\\(double a0,",
      "^  return a0 \\* a0 \\+ \\(double\\)v1;$",
      "^double keep_void\\(double a0,",
      "^  return a0 \\* a0;$"
