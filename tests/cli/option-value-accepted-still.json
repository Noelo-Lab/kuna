{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "main",
    "--option",
    "realtypes",
    "off"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/fauxware",
    "binary_sha256": "c2d90645a45e99221593547e55c601a901b80f807ae96f94c60a7661df0b3e0b",
    "binary_size": 8776,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/fauxware",
    "selector": "main",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "(?s)\\bmain\\s*\\(\\s*void\\s*\\)",
      "v[0-9]+ = authenticate\\(",
      "puts\\(\"Password: \"\\);"
    ],
    "stderr_absent": [
      "option realtypes"
    ]
  },
  "notes": "The other half of the pair: an ACCEPTED value still exits 0 and still emits the whole function. Reading the transcript for a refused `option` line must not turn the console's ordinary success chatter, or a diagnostic raised by some later command, into a failed run."
}
