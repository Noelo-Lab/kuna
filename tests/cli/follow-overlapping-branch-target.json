{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "disassemble",
    "{{BIN}}",
    "audit_overlap",
    "--follow",
    "--json"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/followoverlap_x86_64",
    "binary_sha256": "16ce89d06dc8805fcd80ceee50c398ca28f2aa66abe1b05692e1dcabdb921b8c",
    "binary_size": 1184,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/followoverlap_x86_64",
    "selector": "audit_overlap",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "stdout_absent": [
      "could not re-anchor",
      "no row starts at"
    ],
    "json": [
      {
        "path": "truncated",
        "op": "eq",
        "value": false
      },
      {
        "path": "instructions[2].address_hex",
        "op": "eq",
        "value": "0x401004"
      },
      {
        "path": "instructions[2].text",
        "op": "eq",
        "value": "MOV EAX,0x2ab8"
      },
      {
        "path": "instructions[3].address_hex",
        "op": "eq",
        "value": "0x401005"
      },
      {
        "path": "instructions[3].text",
        "op": "eq",
        "value": "MOV EAX,0x2a"
      },
      {
        "path": "instructions[5].address_hex",
        "op": "eq",
        "value": "0x40100a"
      },
      {
        "path": "instructions[5].text",
        "op": "eq",
        "value": "RET"
      },
      {
        "path": "notes",
        "op": "matches",
        "value": "decoded from one address [^\"]*0x401005"
      }
    ]
  },
  "probe_id": "a-8d52a8ec33d5",
  "notes": "GH #1363: a `je` into the middle of the reachable fall-through `MOV` (the reporter's Mach-O dylib bytes 85 ff 74 01 b8 b8 2a 00 00 00 c3 c3, here in the generated followoverlap_x86_64 ELF). --follow must list both readings -- MOV EAX,0x2ab8 at +4 and MOV EAX,0x2a at +5, then RET at +0xa -- and must not say both that it decoded from +5 and that it could not."
}
