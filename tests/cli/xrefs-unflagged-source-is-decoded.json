{
  "schema": "re-probe/1",
  "kind": "cli",
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/unflagged_macho_arm64",
    "binary_sha256": "37343a81fe2471b9ba2ca2d6beadef04337cb43815e7d4de10247abad7c66be1",
    "binary_size": 33648,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/unflagged_macho_arm64"
  },
  "timeout_s": 60,
  "cmd": [
    "{{KUNA}}",
    "xrefs",
    "{{BIN}}",
    "--from",
    "0x1000003fc",
    "--json"
  ],
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "stderr_matches": [
      "0x1000003fc is in __TEXT,__const, which the image maps executable but does not mark as code: it was decoded as code"
    ],
    "json": [
      {
        "path": "count",
        "op": "eq",
        "value": 1
      },
      {
        "path": "xrefs[0].kind",
        "op": "eq",
        "value": "call"
      },
      {
        "path": "xrefs[0].to_function.name",
        "op": "eq",
        "value": "_goal"
      },
      {
        "path": "coverage.decoded",
        "op": "eq",
        "value": true
      },
      {
        "path": "coverage.section",
        "op": "eq",
        "value": "__TEXT,__const"
      },
      {
        "path": "coverage.code_section",
        "op": "eq",
        "value": false
      },
      {
        "path": "coverage.executable",
        "op": "eq",
        "value": true
      }
    ]
  },
  "notes": "GH-1406: _middle is linked into __TEXT,__const with no instruction attribute, the way Apple's ld64 links it, although __TEXT is r-x, and _main calls it. `--from` it exited 0 with count 0 and nothing saying the address was never decoded. An explicit source in executable memory that decoded code calls is now decoded, and coverage says it was decoded outside the code sections."
}
