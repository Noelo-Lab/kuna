    "_main"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/macho_dup_main",
    "binary_sha256": "3436d99cbb7679bbda4ea32777bba11003c26c1f3173b55d71c11efe9edfcebb",
    "binary_size": 16688,
