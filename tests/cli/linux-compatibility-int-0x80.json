{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "0x1000",
    "--raw-image",
    "--target",
    "x86:LE:64:default",
    "--base",
    "0x1000",
    "--option",
    "linuxsyscall",
    "on"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/raw_compat_int80_x86_64",
    "binary_sha256": "2724e20a8bd5db91b218fc4e67b622d010749ba749ac7253b92c7e44ad74348f",
    "binary_size": 17,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/raw_compat_int80_x86_64",
    "selector": "0x1000",
    "selector_kind": "addr"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "(?m)^\\s*sys_exit\\(0\\);\\s*$"
    ],
    "stdout_absent": [
      "swi\\(0x80\\)",
      "\\bsyscall\\s*\\(",
      "sys_write\\s*\\(",
      "sys_exit\\(0,"
    ]
  },
  "notes": "Promoted acceptance over the exact 17-byte x86-64 witness (ENDBR64; MOV EAX,1; MOV EBX,0; INT 0x80; RET). The positive clause requires a standalone call, so deleting it cannot false-close the need; the negative clauses pin i386 numbering/arity and reject a generic syscall. linuxsyscall off restores raw swi(0x80)."
}
