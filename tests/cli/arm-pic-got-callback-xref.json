{
  "schema": "re-probe/1",
  "probe_id": "a-336a275d03d0",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "xrefs",
    "{{BIN}}",
    "--to",
    "on_expire",
    "--json"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/gotxref_arm_le32",
    "binary_sha256": "7fd54d44cf3d1e1464abd08a9d593f59d2ac94225a50dc2f2eff311b0aaecfb2",
    "binary_size": 71396,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/gotxref_arm_le32",
    "selector": null,
    "selector_kind": "none"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_is_json": true,
    "json": [
      {
        "path": "count",
        "op": "eq",
        "value": 1
      },
      {
        "path": "xrefs[0].from_address_hex",
        "op": "eq",
        "value": "0x10144"
      },
      {
        "path": "xrefs[0].kind",
        "op": "eq",
        "value": "data"
      }
    ]
  },
  "notes": "Promoted acceptance of arm-pic-got-xrefs. `arm_timers` reads `on_expire`'s GOT slot with `ldr r3,[r6,r3]` at 0x10144, through a base made by `ldr r6,[pc]; add r6,pc,r6` around a call. The linker filled the slot with no relocation, so before the fix nothing referenced the callback. The join and refusal cases are in verify_gotxref.rs and kuna_picpool.rs."
}
