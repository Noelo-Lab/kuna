{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}",
    "--option",
    "narrowargs",
    "on"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/callerargs_pic_thumb",
    "binary_sha256": "e62aa1059cc1f8e37186bd00f34e12bbc65b9a01f06c2fbd97e2dc03eff337cc",
    "binary_size": 2052,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/callerargs_pic_thumb",
    "selector": "cb",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "int cb\\(unsigned int a0,int a1\\)"
    ],
    "stdout_absent": [
      "cb\\(unsigned char a0"
    ]
  },
  "notes": "cb is called with bytes and is also passed to apply, which calls it with a whole word; the Thumb-2 PIC code builds its address PC-relatively (ldr rX, [pc, #]; add rX, pc), so its callers cannot all be listed and the parameter keeps its width.",
  "probe_id": "p-e954fcfd4b3e"
}
