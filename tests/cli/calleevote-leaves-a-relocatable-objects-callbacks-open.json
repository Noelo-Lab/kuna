{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile-all",
    "{{BIN}}"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 120,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/calleevote_ops_x86_64.o",
    "binary_sha256": "54ed1e39df182fe8bb81def831f6d38aa282357750bd5fe83ca0d023247db043",
    "binary_size": 2056,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/calleevote_ops_x86_64.o",
    "selector": "get_c",
    "selector_kind": "name"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "unsigned long get_c\\(void \\*a0\\)\\n\\{\\n  return \\*\\(unsigned long \\*\\)\\(\\(long\\)a0 \\+ 0x10\\);",
      "unsigned long get_b\\(void \\*a0\\)",
      "long fwd\\(unsigned long a0\\)"
    ],
    "stdout_absent": [
      "struct_\\d+",
      "fwd\\(char \\*"
    ]
  },
  "notes": "DEFAULT on a relocatable object: get_c, get_b and fwd are each called directly (direct passes its record, use_str a string) and also sit in the const table OPS, whose words are zero in the file and filled by R_X86_64_64 relocations. No function of a .o counts as having every caller known, so the getters keep void * and fwd keeps its integer parameter.",
  "probe_id": "a-8dc7940e5510"
}
