    "--json"
  ],
  "cwd": "{{TMP}}",
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/neolite_packed_pe_i386.exe",
