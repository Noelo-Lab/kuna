<stringmatch name="iteboolean #1: option off leaves the explicit 0/1 constant diamond (gap reproduced)" min="1" max="1">v1 = 1;</stringmatch>
<stringmatch name="iteboolean #2: option off emits the else arm storing the 0 constant" min="1" max="1">v1 = 0;</stringmatch>
