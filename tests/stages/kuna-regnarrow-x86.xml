<!--
    regnarrow on x86-64: an unsigned counter zero-extended in a 64-bit register.
        sum_bytes: xor eax,eax; xor edx,edx
               1:  movzx ecx,byte [rdi+rax]; add edx,ecx; add eax,1
                   cmp eax,esi; jb 1b; mov eax,edx; ret
    `add eax,1` writes the whole of rax as the zero extension of a 32-bit sum,
    and the index reads all 64 bits, so the counter's web is rax and prints as
    `unsigned long`.  Every value of it fits the low 4 bytes and can set bit
    31: it is an `unsigned int`, and the index reads its zero extension.

    Stage: P3 simplification quiescence.  P0 assertion: option regnarrow
    on|off.  Pass 1 (default on) proves the fix (#1, #2); pass 2 (off) the
    register-wide counter (#3).
-->
<bytechunk space="ram" offset="0x401000" readonly="true">
31c031d20fb60c0701ca83c00139f072f389d0c3
</bytechunk>
</binaryimage>
<script>
  <com>map function r0x401000 sum_bytes</com>
  <com>lo fu sum_bytes</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option regnarrow off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="REGNARROW-X86 #1: default counts in 32 bits" min="1" max="1">^    v1 \+= 1;$</stringmatch>
<stringmatch name="REGNARROW-X86 #2: default indexes with the 32-bit counter" min="1" max="1">a0\[v1\]</stringmatch>
<stringmatch name="REGNARROW-X86 #3: off keeps the 64-bit register" min="1" max="1">uint8 v2; // rax</stringmatch>
