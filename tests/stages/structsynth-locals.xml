<script>
  <com>option structsynth param</com>
  <com>lo fu make</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu weigh</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu label</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option structsynth locals</com>
  <com>lo fu make</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu weigh</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu label</com>
  <com>decompile</com>
  <com>print C</com>
  <com>print C types</com>
  <com>quit</com>
