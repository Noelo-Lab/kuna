<stringmatch name="STRUCTSYNTH-LOCALS #1: param writes a returned record through raw offsets" min="1" max="1">\*\(char \*\)\(\(int8\)v1 \+ 0x14\) = 0x6e;</stringmatch>
<stringmatch name="STRUCTSYNTH-LOCALS #2: param reads a returned record as an array of longs" min="1" max="1">return \(int8\)\(int4\)v1\[2\] \+ v1\[1\] \+ \*v1;</stringmatch>
<stringmatch name="STRUCTSYNTH-LOCALS #3: locals declares the allocation a record pointer" min="1" max="1">v1 = \(struct_0 \*\)sub_200000\(0x18\);</stringmatch>
<stringmatch name="STRUCTSYNTH-LOCALS #4: locals writes the allocation's fields by name" min="1" max="1">v1-&gt;field_0x10 = 1;
.*v1-&gt;field_0x14 = 0x6e;</stringmatch>
