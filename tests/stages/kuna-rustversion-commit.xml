<decompilertest>
<!--
  kuna #1639: the stable Rust compiler version was read only from the ELF
  `.comment` record, so an image whose `.comment` was removed lost every
  version-gated recovery. Stage: P0 knowledge (loader image facts,
  `kuna-analysis/src/analyzers/sourcelang/kuna_rustversion.rs`). No option: the
  commit in the standard library's `/rustc/<commit>/` source paths is mapped to
  its stable release. The fixture is `rust_fmt_args_x86_64` linked without
  `.comment` and with one 1.93.1 source path; the 1.93 `rustfmt` argument
  recovery applies to it as it does to the original.
-->
<binaryimage arch="x86:LE:64:default:gcc">
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/rust_fmt_args_nocomment_x86_64</com>
  <com>read symbols</com>
  <com>option setlanguage rust-language</com>
  <com>load function decimal_lf</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function reorder</com>
  <com>decompile</com>
  <com>print C</com>
</script>
<stringmatch name="commit-identified release recovers the decimal print" min="1" max="1">\bprintln!\("\{\}"</stringmatch>
<stringmatch name="commit-identified release recovers repeated indices" min="1" max="1">\bprintln!\("\{0\} \{1\} \{0\}"</stringmatch>
<stringmatch name="no runtime print sink remains" min="0" max="0">std::io::stdio::_print\(</stringmatch>
</decompilertest>
