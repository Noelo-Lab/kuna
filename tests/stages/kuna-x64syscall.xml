<script>
  <com>option x64syscall off</com>
  <com>lo fu kernel_call</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu plain_add</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu split_setup</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option x64syscall on</com>
  <com>lo fu kernel_call</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu plain_add</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu split_setup</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option x64syscall abi</com>
  <com>lo fu kernel_call</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu plain_add</com>
  <com>decompile</com>
