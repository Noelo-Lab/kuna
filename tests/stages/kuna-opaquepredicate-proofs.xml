<stringmatch name="a global another function stores to keeps its test" min="1" max="1">3 &lt;= live</stringmatch>
<stringmatch name="a global whose address is passed on keeps its test" min="1" max="1">3 &lt;= esc</stringmatch>
<stringmatch name="off keeps the remainder of a byte's cube" min="1" max="1">v1 \* v1 \* v1 - v1\) % 3</stringmatch>
<stringmatch name="on folds the remainder for every byte" min="1" max="1">^  return a1 \+ 5;</stringmatch>
<stringmatch name="the same test over 32 bits stays" min="1" max="1">a0 \* a0 \* a0 - a0\) % 3</stringmatch>
<stringmatch name="off keeps the sign test of a byte's square" min="1" max="1">0 &lt;= \(int\)a0 \* \(int\)a0</stringmatch>
<stringmatch name="on folds the sign test" min="1" max="1">^  return a1 \+ 7;</stringmatch>
<stringmatch name="the contradicting test prints only when off" min="1" max="1">if \(a0 &lt;= 5\)</stringmatch>
<stringmatch name="its arm prints only when off" min="1" max="1">v1 \*= 0xf;</stringmatch>
<stringmatch name="a test outside the dominating range prints only when off" min="1" max="1">v1 \*= 0x11;</stringmatch>
<stringmatch name="a test the dominating range leaves open stays" min="1" max="1">v1 \*= 0x13;</stringmatch>
<stringmatch name="identical arms print twice off, once on, once in differ" min="4" max="4">\*a1 = \*a1 \* 0x15 \+ a0;</stringmatch>
<stringmatch name="arms that differ both stay" min="1" max="1">\*a1 = \*a1 \* 0x19 \+ a0;</stringmatch>
<stringmatch name="off selects between two identical calls" min="1" max="1">\? sink\(a1 \* 0x17 \+ 1\) : sink\(a1 \* 0x17 \+ 1\)</stringmatch>
<stringmatch name="on makes the call once" min="1" max="1">^  return sink\(a1 \* 0x17 \+ 1\);</stringmatch>
