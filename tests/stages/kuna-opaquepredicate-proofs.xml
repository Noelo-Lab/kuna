<stringmatch name="off and on keep the test of a global nothing writes" min="2" max="2">10 &lt;= y</stringmatch>
<stringmatch name="globals returns the only value bogus can reach" min="1" max="1">^  return a0 \+ 1;</stringmatch>
<stringmatch name="on keeps the test of an initialized global" min="1" max="1">seven != 7</stringmatch>
<stringmatch name="globals reads the initialized global as its image value" min="1" max="1">^  return a0 \+ 2;</stringmatch>
<stringmatch name="globals reads a zero-filled global beside an indexed array" min="1" max="1">^  return a0 \+ 6;</stringmatch>
