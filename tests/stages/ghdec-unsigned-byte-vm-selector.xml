<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    RE-friction need `unsigned-byte-vm-selector`: lowered-switch label
    signedness is metadata proven by the required range comparisons.

    The XML wrapper only supplies the harness architecture. The script loads
    the exact unmodified KataVM_L1 fixture and decompiles `sub_12d0`.

    The legacy case-bit guess made the unsigned-byte selector's 0x8b label the
    unreachable `case -0x75`. The recovery carries unsigned semantics from
    INT_LESS through the restart and installation, rendering `case 0x8b`; the
    low 0x1e label and the recovered switch are unchanged, so the intervention
    changes metadata rather than flow.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/katavm_level1_x86_64</com>
  <com>read symbols</com>
  <com>load function sub_12d0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
  <!-- The raw stage console spells the CLI's `unsigned char` as `uint1`. -->
  <stringmatch name="UNSIGNED-BYTE-VM-SELECTOR #1: the selector declaration remains" min="1" max="1">uint1\s+v15;</stringmatch>
  <stringmatch name="UNSIGNED-BYTE-VM-SELECTOR #2: the recovered switch remains" min="1" max="1">switch\(v15\)</stringmatch>
<stringmatch name="UNSIGNED-BYTE-VM-SELECTOR #3: the low case remains" min="1" max="1">case 0x1e:</stringmatch>
<stringmatch name="UNSIGNED-BYTE-VM-SELECTOR #4: the impossible negative label never appears" min="0" max="0">case -0x75:</stringmatch>
<stringmatch name="UNSIGNED-BYTE-VM-SELECTOR #5: the unsigned label is preserved" min="1" max="1">case 0x8b:</stringmatch>
</decompilertest>
