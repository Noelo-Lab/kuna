<stringmatch name="sparc-callreturn #1: f1 returns atoi's result plus one" min="1" max="1">return atoi\(a0\) \+ 1;</stringmatch>
<stringmatch name="sparc-callreturn #2: f5 returns atoi's result" min="1" max="1">return atoi\(a0\);</stringmatch>
<stringmatch name="sparc-callreturn #3: f4 and g0 keep atoi's result" min="2" max="2">v1 = atoi\(a0\);</stringmatch>
<stringmatch name="sparc-callreturn #4: f4 returns three times atoi's result, g0 passes it to use" min="2" max="2">(return v1 \* 3;|use\(v1\);)</stringmatch>
<stringmatch name="sparc-callreturn #5: f6 reads atoll's o0:o1 result, not a second argument" min="1" max="1">= atoll\(a0\);</stringmatch>
<stringmatch name="sparc-callreturn #6: fl stores ff's fs0 result" min="1" max="1">\*a1 = ff\(a0\);</stringmatch>
<stringmatch name="sparc-callreturn #7: no call result is dropped" min="0" max="0">^\s*(atoi|atoll|ff)\(</stringmatch>
<stringmatch name="sparc-callreturn #8: widen still returns a long long" min="1" max="1">unsigned long long widen\(int4 a0\)</stringmatch>
<stringmatch name="sparc-callreturn #9: widen does not lose its low word" min="0" max="0">return a0 >> 0x1f;</stringmatch>
