b8004ccd215589e5cd394604cd380e6800cd35e8cd3ac1cd391e7000cd3d5dc3
5589e5c45e04cd3cd907cd391e7000cd3d5dc3cd3c1907cd3c5907cd3c9d0668
00cd3cd905cd3dc3000000000000044000000000000000000000000000000840
</bytechunk>
<symbol space="ram" offset="0x0" name="start"/>
<symbol space="ram" offset="0x25" name="scale"/>
<symbol space="ram" offset="0x40" name="fles"/>
<symbol space="ram" offset="0x53" name="segs"/>
</binaryimage>
<script>
  <com>option fpuemu off</com>
  <com>lo fu scale</com>
  <com>decompile</com>
  <com>print C</com>
  <com>disassemble 0x53 0x68</com>
  <com>option fpuemu on</com>
  <com>lo fu scale</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu fles</com>
  <com>decompile</com>
  <com>print C</com>
  <com>disassemble 0x53 0x68</com>
  <com>quit</com>
</script>
<stringmatch name="fpuemu #1: off, the emulated FLD, FLD1 and FWAIT are calls through swi(0x39), swi(0x35), swi(0x3d)" min="3" max="3">\(\*\(code \*\)swi\(0x3[59d]\)\)\(\);</stringmatch>
<stringmatch name="fpuemu #2: off, FLD1's ModR/M byte E8 reads as a CALL to a phantom function" min="1" max="1">sub_3b03\(\);</stringmatch>
<stringmatch name="fpuemu #3: off, INT 3Ch is an interrupt" min="1" max="1">^0x00000053: INT\s+0x3c</stringmatch>
<stringmatch name="fpuemu #4: on, scale takes its double argument" min="1" max="1">void scale\(float8 a0\)</stringmatch>
<stringmatch name="fpuemu #5: on, scale computes 1 + a0 * k into res" min="1" max="1">\*\(float8 \*\)0x70 = \(float8\)\(\(float10\)1 \+ \(float10\)a0 \* \(float10\)\*\(float8 \*\)0x68\);</stringmatch>
<stringmatch name="fpuemu #6: on, fles loads the float its far pointer names" min="1" max="1">\*\(float8 \*\)0x70 = \(float8\)\*a0;</stringmatch>
<stringmatch name="fpuemu #7: on, segment bits 00 are DS" min="1" max="1">^0x00000053: FLD\s+float ptr DS:\[BX\]</stringmatch>
<stringmatch name="fpuemu #8: on, segment bits 01 are SS" min="1" max="1">^0x00000057: FLD\s+float ptr SS:\[BX\]</stringmatch>
<stringmatch name="fpuemu #9: on, segment bits 10 are CS" min="1" max="1">^0x0000005b: FLD\s+double ptr CS:\[0x68\]</stringmatch>
<stringmatch name="fpuemu #10: on, segment bits 11 are ES" min="1" max="1">^0x00000061: FLD\s+float ptr ES:\[DI\]</stringmatch>
<stringmatch name="fpuemu #11: on, INT 3Dh is FWAIT" min="1" max="1">^0x00000065: WAIT</stringmatch>
