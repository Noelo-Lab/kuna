<!-- P9 C emission, option armshiftguard (default wide), Thumb.
     clang 14 -O2 -mcpu=cortex-m0 of

       uint4 MaskedBit(uint4 pin)                 { return 1u << (pin & 0x1f); }
       uint4 FieldShift(uint4 value, uint4 ctrl)  { return value << ((ctrl >> 8) & 0xf); }
       uint4 AnyShift(uint4 value, uint4 count)   { return value << count; }

       MaskedBit  0x10000: movs r1,#31; ands r1,r0; movs r0,#1; lsls r0,r1; bx lr
       FieldShift 0x10020: lsls r1,r1,#20; lsrs r1,r1,#28; lsls r0,r1; bx lr
       AnyShift   0x10040: lsls r0,r1; bx lr

     and clang 14 -O2 -mcpu=cortex-m3 of the 64-bit shifts

       uint8 ShiftLeft64(uint8 value, uint4 count)  { return value << count; }
       uint8 ShiftRight64(uint8 value, uint4 count) { return value >> count; }

       ShiftLeft64  0x10060: rsb.w r3,r2,#32; lsls r1,r2; lsr.w r3,r0,r3;
                             orrs r1,r3; subs.w r3,r2,#32; it pl;
                             lslpl.w r1,r0,r3; lsl.w r0,r0,r2; it pl;
                             movpl r0,#0; bx lr
       ShiftRight64 0x10080: rsb.w r3,r2,#32; lsrs r0,r2; lsl.w r3,r1,r3;
                             orrs r0,r3; subs.w r3,r2,#32; it pl;
                             lsrpl.w r0,r1,r3; lsr.w r1,r1,r2; it pl;
                             movpl r1,#0; bx lr

     A register LSL shifts by the low byte of the count and yields 0 for 32
     through 255, so `n < 32u ? x << n : 0` computes the machine's value.
     The masked count and the four-bit field cannot reach 32 and print the
     plain shift under every value but `always`. AnyShift's count can: by
     default it prints the plain C shift, defined exactly where the source's
     own `value << count` is. A 64-bit shift splits its count into n, n - 32
     and 32 - n and relies on the machine's 0 (ShiftRight64's `hi << (32 - n)`
     at n = 0), so by default those LSLs keep their guards; `needed` also
     guards AnyShift, `never` drops every guard, `always` restores the bounded
     ones too. With `armconstshift on` the guard-free masked shift still
     converts its signed literal shiftee to unsigned, as for a constant count
     below 32. -->
