<script>
<com>set context TMode 1 [ram,0x10000] [ram,0x1009f]</com>
<com>map function r0x10000 MaskedBit</com>
<com>map function r0x10020 FieldShift</com>
<com>map function r0x10040 AnyShift</com>
<com>map function r0x10060 ShiftLeft64</com>
<com>map function r0x10080 ShiftRight64</com>
<com>parse line extern uint4 MaskedBit(uint4 pin);</com>
<com>parse line extern uint4 FieldShift(uint4 value, uint4 ctrl);</com>
<com>parse line extern uint4 AnyShift(uint4 value, uint4 count);</com>
<com>parse line extern uint8 ShiftLeft64(uint8 value, uint4 count);</com>
<com>parse line extern uint8 ShiftRight64(uint8 value, uint4 count);</com>
<com>lo fu MaskedBit</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu FieldShift</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu AnyShift</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu ShiftLeft64</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu ShiftRight64</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard needed</com>
<com>lo fu AnyShift</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard never</com>
<com>lo fu ShiftLeft64</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu ShiftRight64</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard always</com>
<com>lo fu MaskedBit</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu FieldShift</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu AnyShift</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard needed</com>
<com>option armconstshift on</com>
<com>lo fu MaskedBit</com>
<com>decompile</com>
<com>print C</com>
<com>quit</com>
