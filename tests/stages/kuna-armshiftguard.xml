<decompilertest>
<!-- P9 C emission, option armshiftguard (default needed), Thumb.
     clang 14 -O2 -mcpu=cortex-m0 of

       uint4 MaskedBit(uint4 pin)                 { return 1u << (pin & 0x1f); }
       uint4 FieldShift(uint4 value, uint4 ctrl)  { return value << ((ctrl >> 8) & 0xf); }
       uint4 AnyShift(uint4 value, uint4 count)   { return value << count; }

       MaskedBit  0x10000: movs r1,#31; ands r1,r0; movs r0,#1; lsls r0,r1; bx lr
       FieldShift 0x10020: lsls r1,r1,#20; lsrs r1,r1,#28; lsls r0,r1; bx lr
       AnyShift   0x10040: lsls r0,r1; bx lr

     A register LSL shifts by the low byte of the count and yields 0 for 32
     through 255, so kuna guards it: `n < 32u ? x << n : 0`. The masked count
     and the four-bit field cannot reach 32, so by default they print the
     plain shift; AnyShift's count can, so its guard stays. `never` drops it
     too, and `always` guards all three as before. With `armconstshift on`
     the guard-free masked shift still converts its signed literal shiftee
     to unsigned, as for a constant count below 32. -->
<binaryimage arch="ARM:LE:32:Cortex:default">
<bytechunk space="ram" offset="0x10000" readonly="true">1f210140012088407047</bytechunk>
<bytechunk space="ram" offset="0x10020" readonly="true">0905090f88407047</bytechunk>
<bytechunk space="ram" offset="0x10040" readonly="true">88407047</bytechunk>
</binaryimage>
<script>
<com>set context TMode 1 [ram,0x10000] [ram,0x1004f]</com>
<com>map function r0x10000 MaskedBit</com>
<com>map function r0x10020 FieldShift</com>
<com>map function r0x10040 AnyShift</com>
<com>parse line extern uint4 MaskedBit(uint4 pin);</com>
<com>parse line extern uint4 FieldShift(uint4 value, uint4 ctrl);</com>
<com>parse line extern uint4 AnyShift(uint4 value, uint4 count);</com>
<com>lo fu MaskedBit</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu FieldShift</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu AnyShift</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard never</com>
<com>lo fu AnyShift</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard always</com>
<com>lo fu MaskedBit</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu FieldShift</com>
<com>decompile</com>
<com>print C</com>
<com>lo fu AnyShift</com>
<com>decompile</com>
<com>print C</com>
<com>option armshiftguard needed</com>
<com>option armconstshift on</com>
<com>lo fu MaskedBit</com>
<com>decompile</com>
<com>print C</com>
<com>quit</com>
</script>
<stringmatch name="ARMSHIFTGUARD #1: by default a count masked below 32 prints the plain shift" min="1" max="1">return 1 &lt;&lt; \(pin &amp; 0x1f\);</stringmatch>
<stringmatch name="ARMSHIFTGUARD #2: by default a four-bit field count prints the plain shift" min="1" max="1">return value &lt;&lt; \(\(ctrl &amp; 0xfff\) &gt;&gt; 8\);</stringmatch>
<stringmatch name="ARMSHIFTGUARD #3: the unbounded count keeps its guard by default, and always guards all three" min="4" max="4">&lt; 32u \?</stringmatch>
<stringmatch name="ARMSHIFTGUARD #4: never prints the unbounded count's plain shift" min="1" max="1">return value &lt;&lt; \(count &amp; 0xff\);</stringmatch>
<stringmatch name="ARMSHIFTGUARD #5: always restores the guard on the masked count" min="1" max="1">\(uint4\)\(pin &amp; 0x1f\) &lt; 32u \?</stringmatch>
<stringmatch name="ARMSHIFTGUARD #6: with armconstshift on, a dropped guard keeps the unsigned shift of the signed literal" min="1" max="1">return \(int4\)\(\(uint4\)1 &lt;&lt; \(pin &amp; 0x1f\)\);</stringmatch>
</decompilertest>
