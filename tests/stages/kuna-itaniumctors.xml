  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/itaniumctors_O0_x86_64.so</com>
  <com>option listing on</com>
  <com>option itaniumrtti on</com>
  <com>read symbols</com>
  <com>load function on_stack</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function 0x151c</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/itaniumctors_O2_x86_64.so</com>
