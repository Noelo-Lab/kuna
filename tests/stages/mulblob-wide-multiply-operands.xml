<stringmatch name="MULBLOB #1: no 16-byte local is declared per operand" min="0" max="0">char v[12] \[16\];</stringmatch>
<stringmatch name="MULBLOB #2: no blob is filled in halves before the product is read" min="0" max="0">v1\._8_8_ = 0;</stringmatch>
<stringmatch name="MULBLOB #3: the high half is never read out of a blob product" min="0" max="0">SUB168\(v1\._0_16_ \* v2\._0_16_,8\)</stringmatch>
<stringmatch name="MULBLOB #4: the pipeline prints the high half over the operands themselves" min="1" max="1">\*hi = SUB168\(ZEXT816\(a\) \* ZEXT816\(b\),8\);</stringmatch>
<stringmatch name="MULBLOB #5: the pipeline prints the low half the same way, with no blob left" min="1" max="1">return SUB168\(ZEXT816\(a\) \* ZEXT816\(b\),0\);</stringmatch>
