<stringmatch name="lanefuse #8: on, legacy SSE mulpd stays a scalar product" min="1" max="1">return a0 \* a1;</stringmatch>
<stringmatch name="lanefuse #9: all fuses SSE2 integer lanes" min="1" max="1">_mm_add_epi32\(v1,v2\)</stringmatch>
