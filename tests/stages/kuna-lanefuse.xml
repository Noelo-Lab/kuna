<stringmatch name="lanefuse #1: off, the VADDPS lanes print as separate float additions" min="1" max="1">^unsigned long addv\((unsigned long|uint8) a0,(unsigned long|uint8) a1\)</stringmatch>
<stringmatch name="lanefuse #2: off, the masked add prints unmasked, its mask applied after it" min="1" max="1">_mm512_add_ps\(</stringmatch>
<stringmatch name="lanefuse #3: on, the lane run is one intrinsic" min="1" max="1">_mm256_add_ps\(v1,v2\)</stringmatch>
