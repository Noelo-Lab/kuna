<stringmatch name="OBJCSDKSEND #1: off, the class send is the runtime stub" min="1" max="1">objc_msgSend\$numberWithLongLong:\(&amp;OBJC_CLASS_\$_KNumber,</stringmatch>
<stringmatch name="OBJCSDKSEND #2: off, the undeclared factory's result is untyped" min="1" max="1">unsigned long v2;</stringmatch>
<stringmatch name="OBJCSDKSEND #3: default, the class send to the imported class names the declared method" min="1" max="1">\+\[KNumber numberWithLongLong:\]\(&amp;OBJC_CLASS_\$_KNumber,</stringmatch>
<stringmatch name="OBJCSDKSEND #4: default, the send to its result resolves along the superclass chain" min="3" max="3">-\[KValue stringValue\]\(</stringmatch>
