<!--
    kuna #1883: x86 div/idiv writes the quotient to eax/rax and the remainder
    to edx/rdx at once. A function returning a float or double converted from
    the remainder leaves the unread quotient in rax, and return recovery took
    that quotient as the return value.

        1000  89 f8              MOV      EAX,EDI
        1002  99                 CDQ
        1003  f7 fe              IDIV     ESI          ; quotient unread
        1005  f3 0f 2a c2        CVTSI2SS XMM0,EDX     ; (float)(a % b)
        1009  c3                 RET

        1020  85 d2              TEST     EDX,EDX
        1022  74 0a              JZ       0x102e
        1024  89 f8              MOV      EAX,EDI
        1026  99                 CDQ
        1027  f7 fe              IDIV     ESI
        1029  f3 0f 2a c2        CVTSI2SS XMM0,EDX
        102d  c3                 RET
        102e  f3 0f 2a c7        CVTSI2SS XMM0,EDI     ; rax never written here
        1032  c3                 RET

        1040  85 d2              TEST     EDX,EDX
        1042  74 0b              JZ       0x104f
        1044  89 f8              MOV      EAX,EDI
        1046  31 d2              XOR      EDX,EDX
        1048  f7 f6              DIV      ESI
        104a  f3 0f 2a c2        CVTSI2SS XMM0,EDX
        104e  c3                 RET
        104f  89 f8              MOV      EAX,EDI
        1051  f3 48 0f 2a c0     CVTSI2SS XMM0,RAX     ; rax read into the float
        1056  c3                 RET

        1060  49 89 d0           MOV      R8,RDX
        1063  89 f8              MOV      EAX,EDI
        1065  99                 CDQ
        1066  f7 fe              IDIV     ESI
        1068  f3 0f 2a c2        CVTSI2SS XMM0,EDX
        106c  f3 41 0f 11 00     MOVSS    [R8],XMM0    ; the float is stored
        1071  c3                 RET                   ; the quotient returns

        1080  48 89 f8           MOV      RAX,RDI
        1083  31 d2              XOR      EDX,EDX
        1085  48 f7 f6           DIV      RSI
        1088  f2 48 0f 2a c2     CVTSI2SD XMM0,RDX     ; (double)(a % b)
        108d  c3                 RET

    Stage: P4 return recovery. The first, second, third and fifth functions
    return the float or double; store_rem stores the float and still returns
    the quotient.
-->
