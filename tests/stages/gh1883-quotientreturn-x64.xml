<stringmatch name="QUOTIENTRETURN #2: the float is the remainder" min="1" max="1">^  return \(float4\)\(a0 % a1\);</stringmatch>
<stringmatch name="QUOTIENTRETURN #3: a path that never writes rax returns the float" min="1" max="1">^float4 pick\(int4 a0,int4 a1,int4 a2\)</stringmatch>
