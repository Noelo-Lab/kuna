<stringmatch name="QUOTIENTRETURN #5: a path that converts rax returns the float" min="1" max="1">^float4 scale\(uint4 a0,uint4 a1,int4 a2\)</stringmatch>
<stringmatch name="QUOTIENTRETURN #6: the div path returns its remainder" min="1" max="1">^    return \(float4\)\(int4\)\(a0 % a1\);</stringmatch>
