<script>
  <com>map address r0x4014 int4 gi</com>
  <com>map address r0x403020 int4 sink</com>
  <com>parse line extern int4 ew(int4 *p, int4 b);</com>
  <com>parse line extern int4 pick(uint4 mode);</com>
  <com>load function ew</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="globalorder #1: the aliasing load precedes the computed global store" min="1" max="1">v[0-9]+ = \*p;
  gi = </stringmatch>
<stringmatch name="globalorder #2: the computed value keeps its variable" min="1" max="1">b \+= gi \* 2;</stringmatch>
<stringmatch name="globalorder #3: the switch reads the computed value without an early global store" min="1" max="1">switch\(v[0-9]+\)</stringmatch>
<stringmatch name="globalorder #4: no case reads the stored global back" min="0" max="0">(switch\(sink\)|return[^;]*sink)</stringmatch>
<stringmatch name="globalorder #5: the three case groups store only on their paths" min="3" max="3">^      sink = v[0-9]+;</stringmatch>
</decompilertest>
