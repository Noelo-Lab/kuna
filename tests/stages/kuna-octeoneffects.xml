<decompilertest>
<binaryimage arch="MIPS:BE:64:octeon2:default">
<!--
    kuna octeoneffects: an Octeon atomic or load-linked accesses memory through
    its address operand, but a user operation has no memory effect of its own,
    so a store before it was forwarded past it or dropped. Upstream's MIPS spec
    lifts ll/sc as a plain load/store and sync as SYNC(n); `off` restores that.

    update  (0x1000): ori a0,zero,0x2000; daddiu a1,zero,7; sd a1,0(a0);
                      laad zero,(a0),a1; ld v0,0(a0); jr ra; nop
    barrier (0x1100): the same with syncw in place of laad
    spill   (0x1200): daddiu sp,sp,-16; sd a0,8(sp); syncw; ld v0,8(sp);
                      jr ra; daddiu sp,sp,16
    reserve (0x1300): the same as update with sc a2,0(a0) in place of laad
    linked  (0x1400): ori a0,zero,0x2000; sd a1,0(a0); lld t0,0(a0);
                      sd zero,0(a0); jr ra; or v0,t0,zero

    Stage: P2 lift (callother fixups) and P3 dataflow (heritage guards).
    Three passes: off (update returns the stored 7; barrier and reserve lift
    as upstream does), atomic (the default: update rereads, the store linked
    reads stays, a barrier writes nothing so barrier returns 7 and the spill
    stays a value), ordered (barrier rereads too).

    Assert #1: `return 7;` for update and barrier under off, barrier under atomic.
    Assert #2: the spill across syncw stays the incoming value under atomic.
    Assert #3: atomic and ordered keep the barrier as octeon_syncw.
    Assert #4: off lifts syncw as upstream's SYNC(4).
    Assert #5: off lifts sc as upstream's plain store into the reloaded word.
    Assert #6: atomic keeps the store the load-linked reads.
-->
<bytechunk space="ram" offset="0x1000" readonly="true">3404200064050007fc850000708504dfdc82000003e0000800000000</bytechunk>
<bytechunk space="ram" offset="0x1100" readonly="true">3404200064050007fc8500000000010fdc82000003e0000800000000</bytechunk>
<bytechunk space="ram" offset="0x1200" readonly="true">67bdfff0ffa400080000010fdfa2000803e0000867bd0010</bytechunk>
<bytechunk space="ram" offset="0x1300" readonly="true">3404200064050007fc850000e0860000dc82000003e0000800000000</bytechunk>
<bytechunk space="ram" offset="0x1400" readonly="true">34042000fc850000d08c0000fc80000003e0000801801025</bytechunk>
<bytechunk space="ram" offset="0x2000">0000000000000000</bytechunk>
<symbol space="ram" offset="0x1000" name="update"/>
<symbol space="ram" offset="0x1100" name="barrier"/>
<symbol space="ram" offset="0x1200" name="spill"/>
<symbol space="ram" offset="0x1300" name="reserve"/>
<symbol space="ram" offset="0x1400" name="linked"/>
</binaryimage>
<script>
<com>parse line extern unsigned long long update(void);</com>
<com>parse line extern unsigned long long barrier(void);</com>
<com>parse line extern unsigned long long spill(unsigned long long value);</com>
<com>parse line extern unsigned long long reserve(unsigned long long unused0,unsigned long long unused1,unsigned int value);</com>
<com>parse line extern unsigned long long linked(unsigned long long unused,unsigned long long value);</com>
<com>option octeoneffects off</com>
<com>lo fu update</com><com>decompile</com><com>print C</com>
<com>lo fu barrier</com><com>decompile</com><com>print C</com>
<com>lo fu reserve</com><com>decompile</com><com>print C</com>
<com>option octeoneffects atomic</com>
<com>lo fu update</com><com>decompile</com><com>print C</com>
<com>lo fu barrier</com><com>decompile</com><com>print C</com>
<com>lo fu spill</com><com>decompile</com><com>print C</com>
<com>lo fu linked</com><com>decompile</com><com>print C</com>
<com>option octeoneffects ordered</com>
<com>lo fu barrier</com><com>decompile</com><com>print C</com>
<com>quit</com>
</script>
<stringmatch name="octeoneffects #1: off forwards past the atomic and barrier; atomic past a barrier only" min="3" max="3">return 7;</stringmatch>
<stringmatch name="octeoneffects #2: a stack spill across syncw stays the value" min="1" max="1">return value;</stringmatch>
<stringmatch name="octeoneffects #3: atomic and ordered keep the barrier as an Octeon operation" min="3" max="3">octeon_syncw\(\);</stringmatch>
<stringmatch name="octeoneffects #4: off lifts syncw as upstream SYNC(4)" min="1" max="1">SYNC\(4\);</stringmatch>
<stringmatch name="octeoneffects #5: off lifts sc as upstream's plain store" min="1" max="1">CONCAT44\(value,7\)</stringmatch>
<stringmatch name="octeoneffects #6: atomic keeps the store a load-linked reads" min="1" max="1">= value;</stringmatch>
</decompilertest>
