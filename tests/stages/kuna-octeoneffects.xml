<stringmatch name="octeoneffects #6: atomic keeps the store a load-linked reads" min="1" max="1">= value;</stringmatch>
<stringmatch name="octeoneffects #7: pointer snapshots stay before atomic updates" min="2" max="2">= \*pointer;
  octeon_fetch_add64\(pointer,increment\);</stringmatch>
<stringmatch name="octeoneffects #8: ordered preserves pointer load ordering at a barrier" min="1" max="1">= \*pointer;
  octeon_syncw\(\);</stringmatch>
<stringmatch name="octeoneffects #9: opaque atomic and unordered barrier controls still inline the load" min="2" max="2">return \*pointer;</stringmatch>
<stringmatch name="octeoneffects #10: only off forwards a neighboring stack value across zeroing" min="2" max="2">return neighbor_value;</stringmatch>
<stringmatch name="octeoneffects #11: both zero operations retain neighboring stores in both guarded modes" min="4" max="4">= neighbor_value;
  octeon_zero_cache_block</stringmatch>
