<stringmatch name="octeoneffects #3: atomic and ordered keep the barrier as an Octeon operation" min="5" max="5">octeon_syncw\(\);</stringmatch>
<stringmatch name="octeoneffects #4: off lifts syncw as upstream SYNC(4)" min="1" max="1">SYNC\(4\);</stringmatch>
