<!--
    pebnames (GH-468 finding 6): a Windows anti-debug probe reads the PEB through
    the GS segment base, and the C names none of it.

    A Windows user-mode thread keeps its Thread Environment Block at the GS base
    on x86-64. SLEIGH lowers GS:[disp] to GS_OFFSET + disp over a register input
    nothing writes, so with no type on that register every read is a magic offset
    and the only hint is the storage comment, which is just the lowercased
    register name. Stage model: P5 type-propagation (a type-locked Symbol mapped
    over the register input before heritage).

    Layout (x86-64 Windows), the reporter's shape plus the IsDebuggerPresent-style
    route through TEB.Self and one TEB offset the table does not name:
      0x140001000  48 83 ec 28              sub   rsp,0x28
      0x140001004  65 48 8b 04 25 60 00 ..  mov   rax,gs:[0x60]       ; TEB.ProcessEnvironmentBlock
      0x14000100d  0f b6 48 02              movzx ecx,byte [rax+2]    ; PEB.BeingDebugged
      0x140001011  85 c9 / 75 2f            test ecx,ecx ; jne dbg
      0x140001015  8b 80 bc 00 00 00        mov   eax,[rax+0xbc]      ; PEB.NtGlobalFlag
      0x14000101b  83 e0 70 / 83 f8 70      and eax,0x70 ; cmp eax,0x70
      0x140001021  74 21                    je    dbg
      0x140001023  65 48 8b 04 25 30 00 ..  mov   rax,gs:[0x30]       ; TEB.Self
      0x14000102c  48 8b 40 60              mov   rax,[rax+0x60]      ; ->ProcessEnvironmentBlock
      0x140001030  48 8b 40 30              mov   rax,[rax+0x30]      ; ->ProcessHeap
      0x140001034  8b 40 70                 mov   eax,[rax+0x70]      ; a heap field, not modelled
      0x140001037  65 03 04 25 00 01 00 00  add   eax,gs:[0x100]      ; a TEB offset with no entry
      0x14000103f  48 83 c4 28 / c3         add rsp,0x28 ; ret
      0x140001044  b8 01 00 00 00 / ...     dbg: mov eax,1 ; add rsp,0x28 ; ret

    Pass 1 (pebnames off, the bug): long long v1 // gs_offset read through 0x60/+2
    and 0x60/+0xbc.
    Pass 2 (pebnames on, the fix): TEB *teb // gs_offset, and every read renders
    through the named fields. GS:[0x100] is WOW32Reserved in the real TEB, which
    this table does not carry; it sits between Win32ThreadInfo (0x78) and
    CurrentLocale (0x108) and must print as the offset-named field_0x100, never as
    either neighbour.
    Pass 3 (pebnames auto, the shipped default): an XML bytechunk has no PE
    container, so there is no user-mode-PE fact and auto is inert; the Symbol the
    previous pass mapped is taken back and the render is pass 1's again.

    Near misses, decompiled under pebnames on, none of which may gain a name:
      0x140001100  mov rax,gs:[0x18d8]        ; 0x1878 + 0x60: past the largest TEB,
                                              ; lined up with ProcessEnvironmentBlock
      0x140001110  mov rax,gs:[0x60]
                   mov rax,[rax+0x68]         ; ApiSetMap from Windows 7, FreeList or
                                              ; SparePebPtr0 before it
      0x140001120  mov rax,gs:[rcx]           ; a variable displacement through the base
      0x140001130  mov rax,fs:[0x58]          ; FS is not the TEB in 64-bit mode
      0x140001140  mov gs:[0x68],ecx          ; a write through the base (LastErrorValue)
                   mov rax,gs:[0x60]
                   movzx eax,byte [rax+2]     ; so the PEB probe beside it stays untyped

    Re-running the pass must not map the segment base twice. The Symbol is
    type-locked, so it survives a second decompile of the same function, and the
    pass has to recognise it rather than map another (which rendered
    TEB *v2 // gs_offset with every field read through the anonymous copy):
      0x140001200  mov rax,gs:[0x60]          ; then a four-way jump table whose
                   cmp ecx,3 / ja dflt        ; cases read BeingDebugged,
                   lea rdx,[table] / ...      ; NtGlobalFlag, OSMajorVersion and
                   jmp r8                     ; ImageBaseAddress; decompiled twice
-->
