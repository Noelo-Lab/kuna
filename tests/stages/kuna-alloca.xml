<script>
  <com>option alloca off</com>
  <com>lo fu vla</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu vla2</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option alloca on</com>
  <com>lo fu vla</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu vla2</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
