8610e0db111eacbc8990a5200f2ad13bdf09cdff78b2111fa4108cc82028e004
2c00e4200739074800800bd2e0db05d2e0db16d2e0db25d2e0db29d2e0dba11b
84200f22816078563412e0dbe0db0004060802
</bytechunk>
<symbol space="ram" offset="0x1000" name="ext"/>
<symbol space="ram" offset="0x1008" name="sum"/>
<symbol space="ram" offset="0x1024" name="wrap"/>
<symbol space="ram" offset="0x1038" name="sel"/>
<symbol space="ram" offset="0x1060" name="big"/>
</binaryimage>
<script>
  <com>lo fu ext</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu sum</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu wrap</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu sel</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu big</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="nanoMIPS #1: 16-bit xor and 32-bit lsa lift to plain arithmetic" min="1" max="1">return a1 \* 8 \+ \(a0 \^ a1\);</stringmatch>
<stringmatch name="nanoMIPS #2: the lwxs loop reads p[i] through a scaled index" min="1" max="1">\*\(int4 \*\)\(.* \+ a0\)</stringmatch>
<stringmatch name="nanoMIPS #3: save / restore.jrc leave no frame traffic, both calls keep their arguments" min="1" max="1">return a1 \+ ext\(</stringmatch>
<stringmatch name="nanoMIPS #4: move.balc passes the moved register" min="1" max="1">ext\(a0 \+ 1,a1 \* 3</stringmatch>
<stringmatch name="nanoMIPS #5: lapc + lbux + brsc recover the switch" min="1" max="1">switch\(a0\)</stringmatch>
<stringmatch name="nanoMIPS #6: with all five table targets" min="5" max="5">case [0-4]:</stringmatch>
<stringmatch name="nanoMIPS #7: the bc to ext is a tail call" min="1" max="1">return ext\(a0,a0\);</stringmatch>
<stringmatch name="nanoMIPS #8: the 48-bit addiu carries its 32-bit immediate" min="1" max="1">return a0 \* 3 \+ 0x12345678;</stringmatch>
<stringmatch name="nanoMIPS #9: nothing is left undecoded" min="0" max="0">halt_baddata|WARNING</stringmatch>
</decompilertest>
