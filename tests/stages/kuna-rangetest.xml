<!-- P9 emission, option rangetest (default auto). gcc 11 -O2 -fno-inline,
     x86-64; the functions of decompiler/crates/kuna-analysis/tests/fixtures/rangetest.c:

       void printable(unsigned char c) { if (c >= 0x20 && c <= 0x7e) knob = c; }
       void reject(int n) { if (n < 1 || n > 30) knob = n; }
       void digit(unsigned char c) { if (c >= '0' && c <= '9') knob = c; }
       int lower_after(int a, char c) { if (a > 2 && c >= 'a' && c <= 'z') return 1; return 0; }
       int isdig(int c) { return c >= '0' && c <= '9'; }
       int small(int x) { return x >= -16 && x < 16; }
       int number(const char *s) { int n = 0; while (*s >= '0' && *s <= '9') { n = n * 10 + (*s - '0'); s++; } return n; }
       int ctl(int b, int c) { int n = 0; while (b > 0) { b = b - 1; if (b == 7 || ((c < 9 || c > 10) && c != 5)) n += c; knob = b; } return n; }

     gcc folds each pair of comparisons into one unsigned comparison of a
     subtraction. By default the stand-alone tests of 95 and 30 values, the
     operand of && and the returned test print as the two comparisons; the
     ten-value stand-alone test and the loop condition stay merged, and split
     splits them too. small's range wraps past zero, so every value keeps it
     merged. In ctl the split || heads an && chain that is itself the second
     clause of an ||, where the clause gets no parenthesis of its own, so the
     split carries one. Under rangetest merged every test prints as compiled. -->
