<symbol space="ram" offset="0x100000" name="limbs"/>
<symbol space="ram" offset="0x100010" name="record"/>
</binaryimage>
<script>
  <com>lo fu limbs</com>
  <com>option structsynth off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option structsynth param</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu record</com>
  <com>decompile</com>
  <com>print C</com>
  <com>print C types</com>
  <com>quit</com>
</script>
<stringmatch name="STRUCTSYNTH-ELEMENT-PAIR #1: the integer pair keeps its element pointer with the option off and on" min="2" max="2">void limbs\(int8 \*a0\)</stringmatch>
<stringmatch name="STRUCTSYNTH-ELEMENT-PAIR #2: both reads stay element reads" min="2" max="2">\*a0 = \*a0 \+ a0\[1\];</stringmatch>
<stringmatch name="STRUCTSYNTH-ELEMENT-PAIR #3: the pointer-plus-integer pair is still a record, and the first one minted" min="1" max="1">void record\(struct_0 \*a0\)</stringmatch>
<stringmatch name="STRUCTSYNTH-ELEMENT-PAIR #4: no structure of two integers is declared" min="0" max="0">int8 field_0x0;</stringmatch>
<stringmatch name="STRUCTSYNTH-ELEMENT-PAIR #5: the record's offset 0 is the pointer it dereferences" min="1" max="1">int8 \*field_0x0;</stringmatch>
