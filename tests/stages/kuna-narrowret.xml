<script>
  <com>set context TMode 1 [ram,0x10000] [ram,0x1011f]</com>
  <com>map function r0x10000 next_byte</com>
  <com>map function r0x10006 scaled</com>
  <com>map function r0x1000e above</com>
  <com>map function r0x1001a signed_byte</com>
  <com>map function r0x1001e whole</com>
  <com>map function r0x10024 mix</com>
  <com>map function r0x1002c larger_byte</com>
  <com>map function r0x10056 halfword_pair</com>
  <com>map function r0x1007a count_above</com>
  <com>map function r0x100a4 keeps_sign</com>
  <com>map function r0x100d0 keeps_width</com>
  <com>map function r0x100fa returns_word</com>
  <com>lo fu next_byte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu above</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu larger_byte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu count_above</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu keeps_sign</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option narrowret off</com>
  <com>lo fu next_byte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu above</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu larger_byte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu count_above</com>
  <com>decompile</com>
