<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Swift runtime prototypes.

    Issue: a stripped Swift binary's runtime calls carried no signature, so
    `swift_allocObject` returned a `long` and took whatever the call site
    passed.

    Stage / sub-stage: P1 external-refinement, `SwiftRuntimePass`
    (`kuna-analysis/src/analyzers/swift/kuna_swiftruntime.rs`). No option: the
    signatures are the runtime headers'.

    The pass loads the real fixture `swift_types_elf` with `swiftmetadata on`
    for the names: the allocating initializer's `swift_allocObject` takes a
    `swift.type_metadata *` and two sizes and returns the object as a
    `void *`.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/swift_types_elf</com>
  <com>option swiftmetadata on</com>
  <com>read symbols</com>
  <com>load addr 0x3940</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="the allocation returns the object" min="1" max="1">void \*v1; // rax</stringmatch>
<stringmatch name="the allocation takes the metadata" min="1" max="1">swift_allocObject\(\(swift\.type_metadata \*\)self,0x28,7\)</stringmatch>
</decompilertest>
