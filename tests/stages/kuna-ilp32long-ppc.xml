7c0802a6900100049421fff04bffffd51c63000380010014382100107c0803a6
4e8000207c0802a6900100049421fff04bffffb938a000037ca4281680010014
1c6300037c651a141c840003382100107c0803a64e8000207c0802a690010004
9421fff038e000074bffff8d5463083c80010014382100107c0803a64e800020
</bytechunk>
<symbol space="ram" offset="0x10000" name="ln"/>
<symbol space="ram" offset="0x10008" name="ll"/>
<symbol space="ram" offset="0x10014" name="pick"/>
<symbol space="ram" offset="0x10020" name="cl"/>
<symbol space="ram" offset="0x10044" name="cll"/>
<symbol space="ram" offset="0x10078" name="cp"/>
</binaryimage>
<script>
  <com>lo fu cll</com>
  <com>decompile</com>
  <com>print C</com>
  <com>parse line extern long ln(long a);</com>
  <com>parse line extern long long ll(long long a);</com>
  <com>parse line extern long pick(long a,long long b,long c);</com>
  <com>lo fu ln</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ll</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cl</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cp</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option ctypes on</com>
  <com>lo fu ln</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ll</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="ilp32long ppc #1: an 8-byte return spells long long" min="1" max="1">unsigned long long cll\(unsigned int a0,unsigned int a1\)</stringmatch>
<stringmatch name="ilp32long ppc #1b: an 8-byte constant is ULL" min="1" max="1">v1 \* 3ULL &gt;&gt; 0x20</stringmatch>
<stringmatch name="ilp32long ppc #2: a declared long is one 4-byte register" min="1" max="1">int4 ln\(int4 a\)</stringmatch>
<stringmatch name="ilp32long ppc #2b: ln and ll both add one" min="4" max="4">return a \+ 1;</stringmatch>
<stringmatch name="ilp32long ppc #3: pick has a 4-byte a and c around the 8-byte b" min="1" max="1">int4 pick\(int4 a,int8 b,int4 c\)</stringmatch>
<stringmatch name="ilp32long ppc #3b: pick adds a, c and the low word of b" min="2" max="2">return c \+ a \+ \((int4|int)\)b;</stringmatch>
<stringmatch name="ilp32long ppc #4: cl passes ln one register" min="1" max="1">return ln\(a0\) \* 3;</stringmatch>
<stringmatch name="ilp32long ppc #4b: cp passes pick r3, r5:r6 and 7" min="1" max="1">return pick\(a0,CONCAT44\(a2,a3\),7\) &lt;&lt; 1;</stringmatch>
<stringmatch name="ilp32long ppc #5: ctypes spells the declared long as int" min="1" max="1">^int ln\(int a\)</stringmatch>
<stringmatch name="ilp32long ppc #5b: ctypes spells the 8-byte integer long long" min="1" max="1">^long long ll\(long long a\)</stringmatch>
<stringmatch name="ilp32long ppc #5c: ctypes pick prototype" min="1" max="1">^int pick\(int a,long long b,int c\)</stringmatch>
<stringmatch name="ilp32long ppc #6: no 8-byte integer spells unsigned long" min="0" max="0">unsigned long(\)| [^l])</stringmatch>
</decompilertest>
