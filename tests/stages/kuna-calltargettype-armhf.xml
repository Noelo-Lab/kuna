003193e70100a0e10210a0e133ff2fe1030080e20088bde8
</bytechunk>
<symbol space="ram" offset="0x10000" name="fstore"/>
<symbol space="ram" offset="0x10028" name="fmul"/>
<symbol space="ram" offset="0x10050" name="icall"/>
</binaryimage>
<script>
<com>option ctypes on</com>
<com>option calltargettype off</com>
<com>lo fu fstore</com><com>decompile</com><com>print C</com>
<com>lo fu fmul</com><com>decompile</com><com>print C</com>
<com>lo fu icall</com><com>decompile</com><com>print C</com>
<com>option ctypes on</com>
<com>option calltargettype on</com>
<com>lo fu fstore</com><com>decompile</com><com>print C</com>
<com>lo fu fmul</com><com>decompile</com><com>print C</com>
<com>lo fu icall</com><com>decompile</com><com>print C</com>
<com>quit</com>
</script>
<stringmatch name="CALLTARGETTYPE-ARMHF #1: on types a float call float (*)(float)" min="1" max="1">float \(\*v1\)\(float\); // pc \| r0</stringmatch>
<stringmatch name="CALLTARGETTYPE-ARMHF #2: the float call itself prints as it did" min="2" max="2">return \(float\)\(\*v1\)\(a0 \+ a0\) \+ 1\.0;</stringmatch>
<stringmatch name="CALLTARGETTYPE-ARMHF #3: on types an integer call" min="1" max="1">int \(\*v1\)\(unsigned int,unsigned int\); // pc \| r3</stringmatch>
<stringmatch name="CALLTARGETTYPE-ARMHF #4: a float held as an integer in s0 keeps the call untyped" min="2" max="2">unsigned int v2; // s0</stringmatch>
<stringmatch name="CALLTARGETTYPE-ARMHF #5: that call prints as it did" min="2" max="2">a1\->field_0x0 = \(\*v1\)\(v2\);</stringmatch>
<stringmatch name="CALLTARGETTYPE-ARMHF #6: no integer function type is built over s0" min="0" max="0">unsigned int \(\*v1\)\(unsigned int\)</stringmatch>
</decompilertest>
