<symbol space="ram" offset="0x100000" name="probe"/>
<symbol space="ram" offset="0x10002b" name="sink"/>
</binaryimage>
<script>
  <com>parse line extern int4 MSABI probe(void *popup,int4 property);</com>
  <com>parse line extern int4 MSABI sink(void *popup,int4 cleared);</com>
  <com>lo fu probe</com>
  <com>type varnode %EDX(0x10000e) int4 cleared_property</com>
  <com>decompile</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
