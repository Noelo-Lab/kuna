<stringmatch name="mba solve #5: off keeps the complemented sum" min="1" max="1">\(x - 1U? \^ 0xffffffffU?\) \+ y</stringmatch>
<stringmatch name="mba solve #6: off keeps the and/or spelling of xor" min="1" max="1">\(x \^ 0xffffffff\) &amp; y \| x &amp; \(y \^ 0xffffffff\)</stringmatch>
<stringmatch name="mba solve #7: off keeps the mask plus its complement" min="1" max="1">return \(x &amp; 0xff00ff00\) \+ 0xff00ff;</stringmatch>
<stringmatch name="mba solve #8: on folds a constant operand to x + c" min="1" max="1">return x \+ 0x3039;</stringmatch>
<stringmatch name="mba solve #9: on folds the polynomial to x * c" min="1" max="1">return x \* 0x4d;</stringmatch>
<stringmatch name="mba solve #10: on solves a leaf plus one boolean term" min="1" max="1">return \([xy] \^ [xy]\) \+ x;</stringmatch>
<stringmatch name="mba solve #11: on reads the shared complement as ~x" min="1" max="1">return [xy] &amp; [xy];</stringmatch>
<stringmatch name="mba solve #12: on reads ~ over a sum as -1 - sum" min="1" max="1">return y - x;</stringmatch>
<stringmatch name="mba solve #13: on folds bit logic alone by its truth table" min="1" max="1">return [xy] \^ [xy];</stringmatch>
<stringmatch name="mba solve #14: on folds a mask plus its complement to an or" min="1" max="1">return x \| 0xff00ff;</stringmatch>
