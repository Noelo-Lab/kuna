<!--
    Kuna (MBA with constant operands, shared complements, a complemented sum,
    a leaf plus a boolean term, bit logic alone): P3 simplification quiescence,
    option mba (default off). Each function starts with endbr64.

      0x1000 mba_addc: (x ^ 0x3039) + 2*(x & 0x3039)  ==  x + 0x3039   (constant operand)
          mov eax,edi; xor edi,0x3039; and eax,0x3039; lea eax,[rdi+rax*2]; ret
      0x1040 mba_mulc: (~x & 0x4d)*(x & ~0x4d) + (x & 0x4d)*(x | 0x4d)  ==  x * 0x4d   (polynomial, constant operand)
          mov eax,edi; mov edx,edi; not eax; and edx,0xffffffb2; and eax,0x4d; imul eax,edx; mov
          edx,edi; or edi,0x4d; and edx,0x4d; imul edx,edi; add eax,edx; ret
      0x1080 mba_lin: 2*(x | y) - (x ^ y) + (x & ~y) - (x & y)  ==  x + (x ^ y)   (leaf plus one boolean term)
          mov eax,edi; mov edx,edi; or eax,esi; xor edx,esi; add eax,eax; sub eax,edx; mov edx,esi;
          not edx; and edx,edi; and edi,esi; add eax,edx; sub eax,edi; ret
      0x10c0 mba_and: (~x | y) - ~x  ==  x & y   (~x has two readers)
          push rbp; mov rbp,rsp; xor edi,0xffffffff; mov eax,edi; or eax,esi; sub eax,edi; pop rbp;
          ret
      0x1100 mba_neg: ~(x - 1) + y  ==  y - x   (complement of a sum)
          push rbp; mov rbp,rsp; mov eax,edi; sub eax,0x1; xor eax,0xffffffff; add eax,esi; pop rbp;
          ret
      0x1140 mba_xor: (~x & y) | (x & ~y)  ==  x ^ y   (bit logic only)
          push rbp; mov rbp,rsp; mov eax,edi; xor eax,0xffffffff; and eax,esi; xor esi,0xffffffff;
          and edi,esi; or eax,edi; pop rbp; ret
      0x1180 mba_orc: (x & 0xff00ff00) + 0x00ff00ff  ==  x | 0x00ff00ff   (constant and its complement)
          push rbp; mov rbp,rsp; mov eax,edi; and eax,0xff00ff00; add eax,0xff00ff; pop rbp; ret

    Asserts #1-#7 are the off pass: each form prints as written.
    Asserts #8-#14 are the on pass: each folds.
-->
