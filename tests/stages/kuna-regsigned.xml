  <com>map function r0x10000 total</com>
  <com>map function r0x10022 keep</com>
  <com>map function r0x1003e widen</com>
  <com>lo fu total</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu keep</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu widen</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option regsigned on</com>
  <com>lo fu total</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu keep</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu widen</com>
