<stringmatch name="FCVTROUND control: table_lerp keeps its declared prototype" min="1" max="1">float4 table_lerp\(float4 x,float4 \*t\)</stringmatch>
<stringmatch name="FCVTROUND #1: no float to int conversion of x is a plain truncation" min="0" max="0">\(u?int4\)x\b</stringmatch>
<stringmatch name="FCVTROUND #2: fcvtms rounds down (floor_i, ufloor)" min="2" max="2">^\s*return \(int4\)FLOAT_FLOOR\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #3: fcvtps rounds up (ceil_i, SIMD-scalar ceil_simd)" min="2" max="2">^\s*return \(int4\)FLOAT_CEIL\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #4: table_lerp computes both the floor and the ceil of x" min="2" max="2">^\s*\w+ = \(uint4\)\(int4\)FLOAT_(FLOOR|CEIL)\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #5: the lo != hi branch survives" min="1" max="1">^\s*if \(\w+ != \w+\)$</stringmatch>
<stringmatch name="FCVTROUND #6: the interpolation weight 1.0 - w survives" min="1" max="1">1\.0f - </stringmatch>
<stringmatch name="FCVTROUND #7: fcvtas rounds ties away from zero" min="1" max="1">^\s*return \(int4\)FLOAT_ROUND\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #8: fcvtns rounds ties to even" min="1" max="1">^\s*return \(int4\)FLOAT_ROUNDEVEN\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #9: fcvtms of a double into a 64-bit register" min="1" max="1">^\s*return \(int8\)FLOAT_FLOOR\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #10: fcvtpu of a double into a 64-bit register" min="1" max="1">^\s*return \(int8\)FLOAT_CEIL\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #11: frintm, frintp and frinta stay floats" min="3" max="3">^\s*return FLOAT_(FLOOR|CEIL|ROUND)\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #12: frintn, frintx and frinti are the typed rounding user ops" min="3" max="3">^\s*return FLOAT_(ROUNDEVEN|RINT|NEARBYINT)\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #13: frintz truncates toward zero and stays a double" min="1" max="1">^\s*return FLOAT_TRUNC\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #14: floor(x) != ceil(x) is not folded" min="1" max="1">^\s*return FLOAT_FLOOR\(x\) != FLOAT_CEIL\(x\);$</stringmatch>
<stringmatch name="FCVTROUND #15: vector fcvtms floors every lane" min="2" max="2">CONCAT44\(\(int4\)FLOAT_FLOOR\(.*\),\(int4\)FLOAT_FLOOR\(</stringmatch>
<stringmatch name="FCVTROUND #16: half-precision fcvtms floors" min="1" max="1">^\s*return \(int4\)FLOAT_FLOOR\(a0\);$</stringmatch>
<stringmatch name="FCVTROUND #17: no rounded value is reinterpreted as integer bits" min="0" max="0">from = v\d+ \}</stringmatch>
<stringmatch name="FCVTROUND #18: frint32z of a 2S vector zeroes the upper half of the register" min="1" max="1">^\s*return 0;$</stringmatch>
<stringmatch name="FCVTROUND #19: frint64x rounds in the current mode through a 64-bit integer" min="1" max="1">^\s*return .*\(float4\)\(int8\)FLOAT_RINT\(x\)</stringmatch>
<stringmatch name="FCVTROUND #20: frint64x zeroes the register bits above its single" min="0" max="0">CONCAT44\(\w</stringmatch>
</decompilertest>
