<binaryimage arch="MIPS:BE:32:default:default">
<!--
    The XML wrapper only provides the harness architecture. The script loads
    original GCC 7.3 O32 PIC callers linked with Clang/llc 21.1.8 declaration
    units (tests/fixtures/mips-import-flow/abi and slots, recipes in that
    directory's README).

    The live proof wrappers contain call-site DIEs and retained CALL16/JALR
    relocations. Their signatures apply to ordinary GCC callers of the same
    import. Controls cover linker aliases, a discarded caller, a truncated
    declaration unit, unsupported parameter storage and a shared GOT stub.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">03e0000800000000</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
