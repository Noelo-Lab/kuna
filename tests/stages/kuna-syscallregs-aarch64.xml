010000d40800098b1f0000f100a19fdac0035fd6bf3b03d5c0035fd6
</bytechunk>
<symbol space="ram" offset="0x100000" name="pair"/>
<symbol space="ram" offset="0x100018" name="after"/>
<symbol space="ram" offset="0x100034" name="fence"/>
</binaryimage>
<script>
  <com>option syscallregs on</com>
  <com>lo fu pair</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu after</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu fence</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option syscallregs off</com>
  <com>lo fu pair</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu after</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu fence</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option syscallregs auto</com>
  <com>lo fu pair</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="SYSCALLREGS-AARCH64 #1: with option syscallregs on pair is a one-register function" min="1" max="1">unsigned long pair\(unsigned long a0,unsigned long a1\)</stringmatch>
<stringmatch name="SYSCALLREGS-AARCH64 #2: pair returns the svc result and shows the registers it set up" min="1" max="1">return CallSupervisor\(0,0x40,a1,a0\);</stringmatch>
<stringmatch name="SYSCALLREGS-AARCH64 #3: with option syscallregs off or auto the setup comes back as a 16-byte pair" min="2" max="2">undefined16 pair\(</stringmatch>
<stringmatch name="SYSCALLREGS-AARCH64 #4: after reads the svc result" min="1" max="1">v1 = CallSupervisor\(0,0xac\);</stringmatch>
<stringmatch name="SYSCALLREGS-AARCH64 #5: after adds its argument to the svc result" min="1" max="1">a0 = v1 \+ a0;</stringmatch>
<stringmatch name="SYSCALLREGS-AARCH64 #6: with option syscallregs off after doubles its own argument" min="1" max="1">v1 = a0 \* 2;</stringmatch>
<stringmatch name="SYSCALLREGS-AARCH64 #7: the barrier in fence is not a system call in either pass" min="2" max="2">DataMemoryBarrier\(2,3\);</stringmatch>
