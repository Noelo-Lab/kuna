  <script>
    <com>parse line typedef struct CalleePair { int first; int second; } CalleePair;</com>
    <com>parse line extern int overwrite_after_read_second(void);</com>
    <com>parse line extern int overwrite_after_no_memory(void);</com>
    <com>parse line extern int overwrite_after_hidden_read(void);</com>
