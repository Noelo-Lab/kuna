</bytechunk>
<symbol space="ram" offset="0x10000" name="ln"/>
<symbol space="ram" offset="0x10008" name="ll"/>
<symbol space="ram" offset="0x1001c" name="pick"/>
<symbol space="ram" offset="0x1002c" name="cl"/>
<symbol space="ram" offset="0x10050" name="cll"/>
<symbol space="ram" offset="0x10090" name="cp"/>
</binaryimage>
<script>
  <com>lo fu cll</com>
  <com>decompile</com>
  <com>print C</com>
  <com>parse line extern long ln(long a);</com>
  <com>parse line extern long long ll(long long a);</com>
  <com>parse line extern long pick(long a,long long b,long c);</com>
  <com>lo fu ln</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ll</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cl</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cp</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option ctypes on</com>
  <com>lo fu ln</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ll</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="ilp32long mips #1: an 8-byte return and local spell long long" min="1" max="1">unsigned long long cll\(unsigned int a0,unsigned int a1\)</stringmatch>
<stringmatch name="ilp32long mips #1b: the 8-byte local spells long long" min="1" max="1">unsigned long long v3; // v1:v0</stringmatch>
<stringmatch name="ilp32long mips #2: a declared long is one 4-byte register" min="1" max="1">int4 ln\(int4 a\)</stringmatch>
<stringmatch name="ilp32long mips #2b: ln and ll both add one" min="4" max="4">return a \+ 1;</stringmatch>
<stringmatch name="ilp32long mips #3: pick has a 4-byte a and c around the 8-byte b" min="1" max="1">int4 pick\(int4 a,int8 b,int4 c\)</stringmatch>
<stringmatch name="ilp32long mips #3b: pick adds a, c and the low word of b" min="2" max="2">return a \+ c \+ \((int4|int)\)b;</stringmatch>
<stringmatch name="ilp32long mips #4: cl passes ln one register" min="1" max="1">return ln\(a0\) \* 3;</stringmatch>
<stringmatch name="ilp32long mips #4b: cp passes pick a0, a2:a3 and 7" min="1" max="1">return pick\(a0,CONCAT44\(a3,a2\),7\) &lt;&lt; 1;</stringmatch>
<stringmatch name="ilp32long mips #5: ctypes spells the declared long as int" min="1" max="1">^int ln\(int a\)</stringmatch>
<stringmatch name="ilp32long mips #5b: ctypes spells the 8-byte integer long long" min="1" max="1">^long long ll\(long long a\)</stringmatch>
<stringmatch name="ilp32long mips #5c: ctypes pick prototype" min="1" max="1">^int pick\(int a,long long b,int c\)</stringmatch>
<stringmatch name="ilp32long mips #6: no long is joined with an unset high word" min="0" max="0">CONCAT44\(v[0-9]+,</stringmatch>
<stringmatch name="ilp32long mips #6b: no 8-byte integer spells unsigned long" min="0" max="0">unsigned long(\)| [^l])</stringmatch>
</decompilertest>
