  <com>decompile</com>
  <com>print C</com>
  <com>lo fu fence</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option syscallregs off</com>
  <com>lo fu pair</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu after</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu fence</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option syscallregs auto</com>
  <com>lo fu pair</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="SYSCALLREGS-PPC #1: with option syscallregs on pair is a one-register function" min="1" max="1">unsigned int pair\(unsigned int a0,unsigned int a1\)</stringmatch>
<stringmatch name="SYSCALLREGS-PPC #2: pair returns the sc result and shows the registers it set up" min="1" max="1">return syscall\(4,a1,a0,a1\);</stringmatch>
<stringmatch name="SYSCALLREGS-PPC #3: with option syscallregs off or auto the setup comes back as a register pair" min="2" max="2">return CONCAT44\(a0,a1\);</stringmatch>
