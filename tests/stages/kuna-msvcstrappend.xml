<!--
    GH-468 finding 6: MSVC x64 inlines std::string::push_back (operator+=(char))
    and the literal append(const char *, size_t) at every call site as a
    capacity diamond, so a run of appends prints as a run of near-identical
    if/else blocks.  Stage P2 flow-classification, P0 assertion
    `option msvcstrappend on|off` (default off).

    The image is hand-assembled (nasm) in the MSVC shape.  A string object s
    is _Bx (16 bytes) / _Mysize at +16 / _Myres at +24:

      build_password  four constant appends to a stack string:
            mov rcx,[rsp+0x30]; mov rdx,[rsp+0x38]; cmp rcx,rdx; jae grow
            lea rax,[rcx+1]; mov [rsp+0x30],rax
            lea rax,[rsp+0x20]; cmp rdx,0xf; cmova rax,[rsp+0x20]
            mov word [rax+rcx],'k'; jmp join
      grow: mov r9b,'k'; mov edx,1; lea rcx,[rsp+0x20]; call grow
      append_chars    loop: movzx r9d,byte [rsi]; push_back(r9b) on the
                      string at RDI, grow helper taking only (RCX, R9B)
      quote           string at RBX+8: append(" \"", 2) with the count
                      visible and the reference in RAX used after the
                      join; then append("\"", n) whose count is RSI, set
                      outside the head (not provable)
      near_miss       a 16-byte small-string threshold, and a grow arm
                      handed a different char ('z' for a stored 'y')
      nm_*            27 more near misses, one defect each, every one calling
                      its own grow stub grow_nmN: the heap pointer or the
                      capacity read from the wrong object or field, an
                      extra store, the terminator in a local, missing or
                      at the wrong index, a two-byte append storing one
                      byte, a signed or inverted room check, a changed
                      register or flag read after the join (on every path
                      or on one), a callee-saved register written, the
                      grow call handed another object or two bytes, the
                      character stored through the small buffer on the
                      heap path or differing between paths, a four-byte
                      size store, a writable or mismatched literal, a
                      mismatched outgoing count, a buffer pointer left in
                      RAX and read, an arm or grow block entered from
                      outside, and a grow block that keeps the result
      pos_zeroes_after  a push_back followed by xor ecx,ecx / xor edx,edx:
                      zeroing a changed register is not a read

    Pass 1 (on) and pass 2 (off).  On is run first because a branchflip
    warning recorded by an earlier decompile of the same function in one
    console session is printed again on the later output.
      #1 #2 #3 #4  the provable appends collapse (on)
      #5           no std::string call is synthesized in the off pass
      #6 #7        the off pass keeps every unrolled diamond; the
                   unprovable register-count append stays unrolled in both
      #8 #9        the original two near misses survive both passes
      #10 - #36    every nm_* near miss keeps its grow call in both passes
-->
