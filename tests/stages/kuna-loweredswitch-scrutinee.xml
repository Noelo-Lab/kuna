<script>
  <com>lo fu swfn</com>
  <com>option loweredswitch off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option loweredswitch on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #1: the re-rolled switch dispatches on the compared parameter" min="1" max="1">switch\(a0\)</stringmatch>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #2: the scrutinee is never a constant nor empty" min="0" max="0">switch\(0?\)</stringmatch>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #3: neither pass drops the dispatched-on parameter from the prototype" min="0" max="0">swfn\(void\)</stringmatch>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #4: case 0x1000 recovered" min="1" max="1">case 0x1000:</stringmatch>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #5: case 0x400b recovered" min="1" max="1">case 0x400b:</stringmatch>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #6: pass 1 keeps the compiler's chain over the same parameter" min="1" max="1">if \(a0 == 0x3007\)</stringmatch>
<stringmatch name="LOWEREDSWITCH-SCRUTINEE #7: a case body is present in BOTH passes" min="2" max="2">return 0x7b;</stringmatch>
