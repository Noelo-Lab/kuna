<binaryimage arch="x86:LE:64:default:gcc">
<!--
    A value living only in a register piece no register name covers.
        sh_openpipe (gcc -O2):  mov rcx,rdi; call xpipe; test eax,eax
                                js done; ... done: ret
    xpipe returns an int, so the call writes only eax, and the early return
    hands back all of rax: the C reads the register's upper half, storage
    register 0x4 (the upper half of rax), which no register name covers.
    Naming routed such a high to the global `dat_<addr>` arm because the
    register space is a processor space like ram, and the function printed
    `return CONCAT44(dat_4,v1);` with nothing declaring `dat_4`.  A register
    piece is now a local, declared with its storage.

    Stage: P6 variable naming (ActionNameVars).  A strict fix with no
    option: #1 is the declared local, #2 the old global-looking name.
-->
<bytechunk space="ram" offset="0x401000" readonly="true">
8b05fa2f000089078b05f22f00008947048b05e92f0000c30f1f8400000000008b05da2f00
0001f8c30f1f80000000004889f9e8c8ffffff85c078208b3fba40000000be01000000e8d3
ffffff8b79048901e8c9ffffff89410431c0c3
</bytechunk>
<bytechunk space="ram" offset="0x404000">
0000000000000000
</bytechunk>
</binaryimage>
<script>
  <com>map function r0x401000 xpipe</com>
  <com>map function r0x401020 mtf</com>
  <com>parse line extern int4 xpipe(int4 *p);</com>
  <com>parse line extern int4 mtf(int4 fd,int4 a,int4 b);</com>
  <com>map function r0x401030 sh_openpipe</com>
  <com>lo fu sh_openpipe</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="REGPIECE #1: the upper half of rax is a declared local" min="1" max="1">^  unsigned int v\d+; // register 0x4$</stringmatch>
<stringmatch name="REGPIECE #2: no global-looking register piece" min="0" max="0">dat_4</stringmatch>
</decompilertest>
