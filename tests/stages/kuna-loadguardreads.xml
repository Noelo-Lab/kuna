<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!-- GH-1034, P3 heritage LOAD guards read at renaming.
     gather hands the address of its 64-word table and of each of 64 stack
     structs to reg, so every stack slot is address-tied, then reads the
     table at 256 data-dependent indexes. Under upstream placement the
     heritage pass that first meets those indexed LOADs still guards the
     whole stack, so it builds an address-forced COPY of every address-tied
     stack range in front of every LOAD (81,135 ops created), then propagates
     every one of them away before the pass ends. Renaming instead reads each
     guarded range at its LOAD, one guard COPY is built per Varnode those
     reads reach, and one per guarded range a later read sees on top of its
     stack, 51,311 fewer ops for the same live IR and body. The fixture's
     source and provenance are beside it.
-->
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/loadguardreads_x86_64</com>
  <com>read symbols</com>
  <com>load function gather</com>
  <com>decompile</com>
  <com>print C</com>
  <com>count pcode</com>
</script>
<stringmatch name="loadguardreads #1: gather prints" min="1" max="1">^int8 gather\(int8 a0,unsigned long a1\)$</stringmatch>
<stringmatch name="loadguardreads #2: the 65 calls to reg are kept" min="65" max="65">reg\(</stringmatch>
<stringmatch name="loadguardreads #3: the 64 struct writes each callee may read are kept" min="64" max="64">^  v[0-9]+ = v1( \+ (0x)?[0-9a-f]+)?;$</stringmatch>
<stringmatch name="loadguardreads #4: the table is read at all 256 indexes" min="1" max="1">v5\[v4\[0xff\] &amp; 0x3f\];$</stringmatch>
<stringmatch name="loadguardreads #5: the live IR is upstream's" min="1" max="1">Count - pcode = 11538</stringmatch>
<stringmatch name="loadguardreads #6: no guard COPY per LOAD per range is built" min="0" max="0">Count - created = 81135</stringmatch>
<stringmatch name="loadguardreads #7: a guard COPY is built only per Varnode reached and per guard read again" min="1" max="1">Count - created = 29824</stringmatch>
</decompilertest>
