<stringmatch name="ebpf #2: the map reference is the named map symbol" min="3" max="3">bpf_map_lookup_elem\(counters,&amp;</stringmatch>
<stringmatch name="ebpf #3: the helper id names the pspec helper" min="3" max="3">v1 = .*bpf_map_lookup_elem\(counters,&amp;v2\);</stringmatch>
<stringmatch name="ebpf #4: the subprogram call resolves to the .text callee" min="1" max="1">helper\(v1\);</stringmatch>
<stringmatch name="ebpf #5: the map increment is recovered in every object" min="2" max="2">\*v1 = \*v1 \+ 1;</stringmatch>
