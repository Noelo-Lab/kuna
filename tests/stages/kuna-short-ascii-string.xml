<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    Four visible ASCII characters are enough to identify a NUL-terminated
    string (option strings, default on).

    The XML wrapper only supplies the harness architecture. Both passes load
    the same in-tree ELF fixture through the object loader. Its main function
    copies the five bytes "xyzw\0" from rodata into a stack object.

    Pass 1 turns string analysis off and reproduces the missing literal: the
    four data bytes and terminator are emitted as separate raw data symbols.
    Pass 2 uses the default analyzer and plants a char[5], allowing the existing
    constant-copy rule to render one builtin_strncpy with the complete literal.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/callrettype_clang_O0_x86_64</com>
  <com>option strings off</com>
  <com>read symbols</com>
  <com>load function main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/callrettype_clang_O0_x86_64</com>
  <com>read symbols</com>
  <com>load function main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="SHORT ASCII STRING #1: off, the four bytes remain a raw data word" min="1" max="1">v9 = dat_2013;</stringmatch>
<stringmatch name="SHORT ASCII STRING #2: default, the four-byte literal is one string copy" min="1" max="1">builtin_strncpy\(&amp;v10,"xyzw",5\);</stringmatch>
<stringmatch name="SHORT ASCII STRING #3: both passes preserve the surrounding string transform" min="2" max="2">upper_after_blanks</stringmatch>
</decompilertest>
