<script>
  <com>lo fu walk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option indirectonly on</com>
  <com>lo fu walk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="indirectonly-escape #1: by default the count lives in a register local" min="1" max="1">int4 v2; // r14d</stringmatch>
<stringmatch name="indirectonly-escape #2: and the escaped slot is read, not written" min="1" max="1">v2 = v3 \+ -1;</stringmatch>
<stringmatch name="indirectonly-escape #3: that slot is its own variable by default" min="1" max="1">int4 v3; // stack - 0x30</stringmatch>
<stringmatch name="indirectonly-escape #4: with the option on the register is merged into the slot" min="1" max="1">int4 v2; // stack - 0x30</stringmatch>
