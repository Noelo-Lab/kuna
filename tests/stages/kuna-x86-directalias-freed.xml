<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    x86-64: a stack pointer is saved in a frame slot, restored, moved below
    the outgoing-argument area and used both as a store's address and as the
    %rdi of a call to nouse, which never reads %rdi:

        freed_call: w7(1,2,3,4,5,6, 7);
                    p = restored - 48; *p = 0x55; nouse(p);
                    y8(1,2,3,4,5,6, 7,8);

    Scoring nouse drops its %rdi, after which the pointer is only a store's
    address and touches only its own four bytes. The direct/indirect split of
    the gathered pointers was drawn before that and not redrawn, so y8's stack
    arguments above the pointer were taken as aliased: y8(1,2,3,4,5,6).
    Source: fixtures/x86-directalias-freed.s.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">

</bytechunk>
<symbol space="ram" offset="0x100000" name="freed_call"/>
<symbol space="ram" offset="0x100100" name="nouse"/>
<symbol space="ram" offset="0x100120" name="w7"/>
<symbol space="ram" offset="0x100140" name="y8"/>
</binaryimage>
<script>
  <com>lo fu freed_call</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="x86-directalias-freed #1: the call after the freed pointer keeps its stack arguments" min="1" max="1">y8\(1,2,3,4,5,6,7,8\);</stringmatch>
<stringmatch name="x86-directalias-freed #2: no stack argument of the later call is dropped" min="0" max="0">y8\(1,2,3,4,5,6\);</stringmatch>
</decompilertest>
