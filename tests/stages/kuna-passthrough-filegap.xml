<stringmatch name="filegap x86 #2: and passes it to bits" min="1" max="1">^  bits\(a0\); // tail-call$</stringmatch>
<stringmatch name="filegap x86 #3: the sst wrapper takes the rdi it forwards" min="1" max="1">^uint8 sst_tail\([^,()]* \*?a0\)$</stringmatch>
