<script>
  <com>option callsitestackargs off</com>
  <com>lo fu caller</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option callsitestackargs on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
