<decompilertest>
  <!--Kuna #810 / P6 merge order and P9 memory versions. stackviews off keeps the old scalar frame model; on keeps conditional native stores and a genuine saved word without printing reconstructed frame writes.-->
  <binaryimage arch="x86:LE:64:default:gcc">
    <bytechunk space="ram" offset="0x401000"></bytechunk>
    <bytechunk space="ram" offset="0x402000"></bytechunk>
    <symbol space="ram" offset="0x0000000000401000" name="frame_alias" />
    <symbol space="ram" offset="0x000000000040109a" name="frame_seed" />
    <symbol space="ram" offset="0x000000000040112d" name="frame_cached" />
    <symbol space="ram" offset="0x000000000040116f" name="advance_word" />
    <symbol space="ram" offset="0x0000000000401174" name="expose_input" />
    <symbol space="ram" offset="0x0000000000401179" name="read_key" />
    <symbol space="ram" offset="0x00000000004011af" name="read_item" />
    <symbol space="ram" offset="0x00000000004011ba" name="_start" />
  </binaryimage>
  <script>
    <com>parse line struct ChoiceArray { unsigned int count; unsigned char padding[4]; struct ChoiceItem **items; };</com>
    <com>parse line struct ChoiceQueue { struct ChoiceItem **begin; struct ChoiceItem **end; struct ChoiceItem **capacity; };</com>
    <com>parse line struct ChoiceItem { int kind; int key; };</com>
    <com>parse line extern void frame_alias(struct ChoiceArray *array,struct ChoiceQueue *queue);</com>
    <com>parse line extern void read_key(const int *key);</com>
    <com>parse line extern void read_item(struct ChoiceItem *const *item);</com>
    <com>parse line extern void expose_input(const struct ChoiceItem *item);</com>
    <com>parse line extern void frame_seed(struct ChoiceArray *array,struct ChoiceQueue *queue);</com>
    <com>parse line extern unsigned long long frame_cached(unsigned long long input);</com>
    <com>parse line extern void advance_word(unsigned long long *word);</com>
    <com>map address 0x402060 ChoiceItem item_two</com>
    <com>option stackalias off</com>
    <com>option stackviews off</com>
    <com>lo fu frame_alias</com>
    <com>decompile</com>
    <com>print C</com>
    <com>option stackviews on</com>
    <com>lo fu frame_alias</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu frame_seed</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu frame_cached</com>
    <com>decompile</com>
    <com>print C</com>
    <com>quit</com>
  </script>
  <stringmatch name="frame versions: seed writes only four bytes" min="1" max="1">view_uint4 = 0;</stringmatch>
  <stringmatch name="frame versions: pointer store stays conditional" min="2" max="2">if \(v[0-9]+-&gt;kind == 2\) \{
v[0-9]+\.view_uint8 = \(uint8\)v[0-9]+;</stringmatch>
  <stringmatch name="frame versions: cached word remains independent" min="1" max="1">v[0-9]+ = v[0-9]+\.view_uint8;</stringmatch>
</decompilertest>
