  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/msvcbyval_i386.exe</com>
  <com>read symbols</com>
  <com>load addr 0x401000</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load addr 0x401020</com>
