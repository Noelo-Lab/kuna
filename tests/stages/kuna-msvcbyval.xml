<stringmatch name="MSVCBYVAL #1: off keeps only MakeStack's hidden return pointer" min="1" max="1">MakeStack\(a1\);</stringmatch>
<stringmatch name="MSVCBYVAL #2: off reads the reserving push of ecx as a parameter" min="1" max="1">Arr \* sub_401020\(unsigned int a0,Arr \*a1,Arr \*a2,unsigned int a3\)</stringmatch>
<stringmatch name="MSVCBYVAL #3: off drops both of Join's arguments" min="1" max="1">Join\(\);</stringmatch>
<stringmatch name="MSVCBYVAL #4: on passes MakeStack every argument, the copy in place" min="1" max="1">MakeStack\(a0,v1,a1,a2\);</stringmatch>
<stringmatch name="MSVCBYVAL #5: on, the copy constructor builds that same local" min="1" max="1">Arr::Arr\(\(Arr \*\)&amp;v1,a1\);</stringmatch>
<stringmatch name="MSVCBYVAL #6: on, Build takes exactly its three parameters" min="1" max="1">Arr \* sub_401020\(Arr \*a0,Arr \*a1,Arr \*a2\)</stringmatch>
<stringmatch name="MSVCBYVAL #7: on sizes the 8-byte Pair from sub esp,8" min="1" max="1">Join\(v1,a0\);</stringmatch>
<stringmatch name="MSVCBYVAL #8: on, the Pair copy constructor builds the argument" min="1" max="1">Pair::Pair\(\(Pair \*\)&amp;v1,a0\);</stringmatch>
<stringmatch name="MSVCBYVAL #9: a deferred pop in the cleanup is declined in both passes" min="2" max="2">MakeStack\(a0\);</stringmatch>
<stringmatch name="MSVCBYVAL #10: a local released by the cleanup is declined in both passes" min="2" max="2">MakeStack\(\(Arr \*\)&amp;v2\);</stringmatch>
</decompilertest>
