  <com>load addr 0x2fe0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load addr 0x2ab0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/swift_metadata_elf</com>
  <com>option swiftmetadata on</com>
  <com>read symbols</com>
  <com>load addr 0x30b0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load addr 0x2fe0</com>
  <com>decompile</com>
