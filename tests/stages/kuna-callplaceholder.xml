<stringmatch name="KUNA-CALLPLACEHOLDER #1: strncpy takes its three declared arguments" min="1" max="1">strncpy\([^;]*,a0,\(int8\)\(a1 \+ -1\)\);</stringmatch>
<stringmatch name="KUNA-CALLPLACEHOLDER #2: strlen takes its one declared argument" min="1" max="1">strlen\(v7\);</stringmatch>
<stringmatch name="KUNA-CALLPLACEHOLDER #3: no call reads the return-address slot as an argument" min="0" max="0">,v4\[v1 \+ -8\]\);</stringmatch>
