<script>
  <!-- kuna: pin the pre-sweep (DIV-13 flags-off) structuring baseline so pass 1
       sees the canonical negated-guard if/else diamond; pass 2 enables only the
       iteregion knob under test. -->
  <com>option gotoreduce off</com>
  <com>option crossjumprevert off</com>
  <com>option taildup off</com>
  <com>option dedupitetail off</com>
  <com>option regionlooprefine off</com>
  <com>option ifelseflatten off</com>
  <com>option switchmultipred off</com>
  <com>option tailcalljump off</com>
  <com>option foldcallret off</com>
  <com>option branchflip off</com>
  <!-- kuna: iteregion is default-ON (DIV-17); pass 1 explicitly flips it OFF to pin
       the upstream if/else baseline the pass converts, pass 2 turns it back on. -->
  <com>option iteregion off</com>
  <com>parse line extern void pick(int4 x);</com>
  <com>lo fu pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option iteregion on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
