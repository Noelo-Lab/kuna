<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!-- GH-1034, P3 return guards, option readonlyreturns.
     exits reads 256 read-only table words between 256 calls, so readonlycalls
     leaves them unguarded at calls, and returns early after each call: 257
     RETURN ops. Pass 1 is upstream placement (option off): a return guard COPY
     for every read-only word before every RETURN, 65,792 COPYs that survive to
     the final IR (69890 live ops). Pass 2 is the default: a read-only word no
     write and no call guard reaches has its entry value at every return, so
     it gets no return COPY and the live IR is 4098 ops. The writable global
     hits keeps its guards and both of its stores. Both passes print the same
     body. The fixture's source and provenance are beside it.
-->
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/readonlyreturns_x86_64</com>
  <com>read symbols</com>
  <com>option readonlyreturns off</com>
  <com>load function exits</com>
  <com>decompile</com>
  <com>print C</com>
  <com>count pcode</com>
  <com>option readonlyreturns on</com>
  <com>load function exits</com>
  <com>decompile</com>
  <com>print C</com>
  <com>count pcode</com>
</script>
<stringmatch name="readonlyreturns #1: both passes print exits" min="2" max="2">^int8 exits\(int8 a0\)$</stringmatch>
<stringmatch name="readonlyreturns #2: both passes keep the 256 calls" min="512" max="512">sink\(dat_</stringmatch>
<stringmatch name="readonlyreturns #3: both passes keep the 257 returns" min="514" max="514">^ +return </stringmatch>
<stringmatch name="readonlyreturns #4: both passes keep both stores to the writable global" min="4" max="4">^ +hits = v[0-9]+ \+ </stringmatch>
<stringmatch name="readonlyreturns #5: upstream placement keeps a return COPY per read-only word per RETURN" min="1" max="1">Count - pcode = 69890</stringmatch>
<stringmatch name="readonlyreturns #6: upstream placement builds them all" min="1" max="1">Count - created = 83666</stringmatch>
<stringmatch name="readonlyreturns #7: the default keeps none of them" min="1" max="1">Count - pcode = 4098</stringmatch>
<stringmatch name="readonlyreturns #8: the default never builds them" min="1" max="1">Count - created = 17874</stringmatch>
</decompilertest>
