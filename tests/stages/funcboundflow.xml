<bytechunk space="ram" offset="0x100060" readonly="true">f30f1efa8d47fbc30f1f840000000000</bytechunk>
<bytechunk space="ram" offset="0x100070" readonly="true">f30f1efaebfe</bytechunk>
<symbol space="ram" offset="0x100040" name="caller"/>
<symbol space="ram" offset="0x100060" name="neighbor"/>
<symbol space="ram" offset="0x100070" name="fatal"/>
</binaryimage>
<script>
  <com>lo fu caller</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option funcboundflow off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="FUNCBOUNDFLOW #1: default does NOT merge neighbor; only the funcboundflow-off pass shows its body (exactly one occurrence across both passes)" min="1" max="1">\(int4\)a0 - 5</stringmatch>
<stringmatch name="FUNCBOUNDFLOW #2: both passes resolve the unnamed no-return call to fatal(), so the sole difference is the boundary truncation" min="2" max="2">fatal\(\);</stringmatch>
