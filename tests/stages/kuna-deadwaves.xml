<!-- GH-1034, P3 rule pools, dead-removal waves. churn (the prunedssa
     fixture) reads 256 read-only table words between 256 calls; its rule
     pool passes remove dead INDIRECT and MULTIEQUAL chains one link per
     pass. A pass that follows one whose only change was dead-op removal
     visits only the ops that removal touched. The body, the live IR and the
     ops created are the ones a sweep of every op in every pass leaves.
-->
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/prunedssa_x86_64</com>
  <com>read symbols</com>
  <com>load function churn</com>
  <com>decompile</com>
  <com>print C</com>
  <com>count pcode</com>
</script>
<stringmatch name="deadwaves #1: churn prints" min="1" max="1">^uint8 churn\(int8 a0,char \*a1\)$</stringmatch>
<stringmatch name="deadwaves #2: churn keeps its 256 calls" min="256" max="256">sink\(</stringmatch>
<stringmatch name="deadwaves #3: the live IR is the sweep's" min="1" max="1">Count - pcode = 8135</stringmatch>
<stringmatch name="deadwaves #4: the ops created are the sweep's" min="1" max="1">Count - created = 35936</stringmatch>
</decompilertest>
