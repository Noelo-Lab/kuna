<stringmatch name="ehcatch #1: off: the header counts the hidden handler" min="1" max="1">guarded\(.*\) // warn: 1 catch handler not shown</stringmatch>
<stringmatch name="ehcatch #2: off prints no handler: one per default decompile of a guarded function" min="4" max="4">^  catch \(</stringmatch>
<stringmatch name="ehcatch #3: the guarded call sits in a try block" min="4" max="4">^  try \{$</stringmatch>
<stringmatch name="ehcatch #4: the handler names the caught type" min="3" max="3">^  catch \(int\) \{$</stringmatch>
<stringmatch name="ehcatch #5: x86-64: the handler rejoins the normal return with the caught value" min="1" max="1">^  return v2;$</stringmatch>
<stringmatch name="ehcatch #6: a hidden class and a catch-all share one pad" min="1" max="1">^  catch \(Odd \| \.\.\.\) \{$</stringmatch>
<stringmatch name="ehcatch #7: the pad dispatches on the selector" min="1" max="1">v3 = __eh_selector\(\);</stringmatch>
<stringmatch name="ehcatch #8: ARM: the handler returns the caught value" min="2" max="2">^    return v2;$</stringmatch>
<stringmatch name="ehcatch #9: the exception object comes from the unwinder" min="4" max="4">v1 = __eh_exception\(\);</stringmatch>
<stringmatch name="ehcatch #10: the stripped Thumb helper decodes as Thumb" min="1" max="1">^  return a0 &lt;&lt; 1;$</stringmatch>
<stringmatch name="ehcatch #11: no handler falls back to the plain test" min="0" max="0">__eh_catch</stringmatch>
</decompilertest>
