  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/ehcatch_x86_64.so</com>
  <com>read symbols</com>
  <com>load function guarded</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function sorted</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/ehcatch_arm.so</com>
  <com>read symbols</com>
  <com>load function guarded</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/ehcatch_thumb_stripped.so</com>
  <com>read symbols</com>
  <com>load function guarded</com>
