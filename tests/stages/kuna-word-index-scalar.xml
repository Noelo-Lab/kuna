<decompilertest>
<binaryimage arch="CP1600:BE:16:default:default">
<!-- MVII #0x65a7,R0; JR R5. The same bytes return a word index or a pointer. -->
<bytechunk space="ram" offset="0x1000" readonly="true">02b865a700af</bytechunk>
<bytechunk space="ram" offset="0x1010" readonly="true">02b865a700af</bytechunk>
<!-- MVII #0x65a7,R4; MVI@ R4,R0; JR R5. -->
<bytechunk space="ram" offset="0x1020" readonly="true">02bc65a702a000af</bytechunk>
<!-- MVII #0x1040,R0; JR R5. The word address of helper's entry. -->
<bytechunk space="ram" offset="0x1030" readonly="true">02b8104000af</bytechunk>
<!-- MVII #0x65a7,R6; TSTR R1; BNEQ +2; MVII #0x65ad,R6; MOVR R6,R0; JR R5. -->
<bytechunk space="ram" offset="0x1050" readonly="true">02be65a70089020c000202be65ad00b000af</bytechunk>
<!-- The same selection between the entries of helper and helper2. -->
<bytechunk space="ram" offset="0x1070" readonly="true">02be10400089020c000202be104800b000af</bytechunk>
<symbol space="ram" offset="0x1000" name="scalar_index"/>
<symbol space="ram" offset="0x1010" name="cell_pointer"/>
<symbol space="ram" offset="0x1020" name="load_cell"/>
<symbol space="ram" offset="0x1030" name="entry_ref"/>
<symbol space="ram" offset="0x1050" name="selected_index"/>
<symbol space="ram" offset="0x1070" name="selected_entry"/>
</binaryimage>
<script>
  <com>map address 0x65a7 uint2 cell</com>
  <com>map address 0x65ad uint2 other</com>
  <com>map return scalar_index::%R0 uint2</com>
  <com>map return cell_pointer::%R0 uint2 *</com>
  <com>map return load_cell::%R0 uint2</com>
  <com>map param selected_index::0 %R1 uint2 cond</com>
  <com>map return selected_index::%R0 uint2</com>
  <com>map param selected_entry::0 %R1 uint2 cond</com>
  <com>map return selected_entry::%R0 uint2</com>
  <com>map function r0x1040 helper</com>
  <com>map function r0x1048 helper2</com>
  <com>lo fu scalar_index</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cell_pointer</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu load_cell</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu entry_ref</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option returndup off</com>
  <com>lo fu selected_index</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu selected_entry</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="WORD-INDEX #1: a returned word index stays numeric" min="1" max="1">^  return 0x65a7;$</stringmatch>
<stringmatch name="WORD-INDEX #2: the typed pointer returns the cell address" min="1" max="1">^  return &amp;cell;$</stringmatch>
<stringmatch name="WORD-INDEX #3: an indirect load still reads the cell" min="1" max="1">^  return cell;$</stringmatch>
<stringmatch name="WORD-INDEX #4: a word index on a function entry still names the function" min="1" max="1">^  return helper;$</stringmatch>
<stringmatch name="WORD-INDEX #5: a branch-selected stack register value stays numeric" min="1" max="1">0x65ad</stringmatch>
<stringmatch name="WORD-INDEX #6: only the address-valued output names a cell address" min="1" max="1">&amp;(cell|other)\b</stringmatch>
<stringmatch name="WORD-INDEX #7: a function entry selected through the stack register keeps its name" min="1" max="1">= helper2;$</stringmatch>
</decompilertest>
