  <com>lo fu ld64</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ldbyte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu rec16</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu diff</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option castindex on</com>
  <com>lo fu ldidx</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ld64</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu ldbyte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu rec16</com>
  <com>decompile</com>
