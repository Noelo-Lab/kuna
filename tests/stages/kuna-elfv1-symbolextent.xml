  <com>lo fu exact24</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/elfv1_symbol_extent_le.so</com>
  <com>option listing on</com>
  <com>option aif on</com>
  <com>read symbols</com>
  <com>functions</com>
  <com>lo fu sample</com>
  <com>decompile</com>
