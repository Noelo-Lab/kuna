<decompilertest>
<binaryimage arch="AARCH64:LE:64:v8A:default">
<!--
    switchmerge with value-aware holes, and a jump table longer than jumptablemax.

    Authored AArch64 (clang -c of hand-written assembly). f and g range-check
    w0 against 0x41..0x48 and index an eight-entry table; an out-of-range value
    goes to `x == 0x60` and `x == 0x70` tests. The holes 0x43 and 0x46 go to the
    code the failed tests reach: in f a block of stores that `x1 == 0` also
    reaches, in g the shared `lsl w0,w0,#1; ret` after the switch.
    h bounds w0 by `cmp w0,#1100; b.hs` and indexes an 1100-entry table.

    Fixed: f and g print no label for a hole, since `default:` sends 0x43 and
    0x46 through both failed tests to the same code; h prints a switch with
    1100 labels.
    Before: f printed `case 0x43: case 0x46: goto label_...;`, g
    `case 0x43: case 0x46: break;`, and h `jump-as-call` (the table is longer
    than jumptablemax 1024). Option switchmerge off keeps f's labels.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">

</bytechunk>
<bytechunk space="ram" offset="0x101000" readonly="true">

</bytechunk>
<bytechunk space="ram" offset="0x102000" readonly="true">

</bytechunk>
<symbol space="ram" offset="0x100000" name="f"/>
<symbol space="ram" offset="0x101000" name="g"/>
<symbol space="ram" offset="0x102000" name="h"/>
</binaryimage>
<script>
  <com>parse line extern int4 f(int4 x,int4 *p);</com>
  <com>parse line extern int4 g(int4 x);</com>
  <com>parse line extern int4 h(uint4 x);</com>
  <com>lo fu f</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu g</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu h</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option switchmerge off</com>
  <com>lo fu f</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="SWITCHVALUES #1: a hole label prints only in h and the unmerged f" min="4" max="4">case 0x4[36]:</stringmatch>
<stringmatch name="SWITCHVALUES #2: f, g, h and the unmerged f keep their six value labels" min="24" max="24">case 0x4[124578]:</stringmatch>
<stringmatch name="SWITCHVALUES #3: the hole arm's jump is gone from f" min="3" max="3">goto label_[0-9a-f]+;</stringmatch>
<stringmatch name="SWITCHVALUES #4: h prints its table as a switch" min="1" max="1">case 1099:</stringmatch>
<stringmatch name="SWITCHVALUES #5: no dispatch prints as a computed call" min="0" max="0">jump-as-call</stringmatch>
</decompilertest>
