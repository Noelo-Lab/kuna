<decompilertest>
<!--
  angr TestRustStoreWidth checks that the STORE's native width survives type recovery.
  P9 strict correctness: no option. These authored x86-64 functions write a qword
  through a byte pointer and one byte into a recovered word field. The emitted
  Rust must keep both physical widths without aligned dereferences or borrows.
  The retained fmt fixture also contains a halfword store into an indexed byte
  array in escape_unicode; the place must not become a mutable reference.
-->
<binaryimage arch="x86:LE:64:default:gcc">
<bytechunk space="ram" offset="0x101000" readonly="true">488937c3</bytechunk>
<bytechunk space="ram" offset="0x101040" readonly="true">40887704c3</bytechunk>
<bytechunk space="ram" offset="0x101080" readonly="true">488937c3</bytechunk>
<symbol space="ram" offset="0x101000" name="wide"/>
<symbol space="ram" offset="0x101040" name="bytefield"/>
<symbol space="ram" offset="0x101080" name="matched"/>
</binaryimage>
<script>
  <com>option outlang rust</com>
  <com>parse line struct Record { uint4 head; uint4 tail; };</com>
  <com>map prototype wide void wide(uint1 *p,uint8 v);</com>
  <com>map prototype bytefield void bytefield(struct Record *p,uint1 v);</com>
  <com>map prototype matched void matched(uint8 *p,uint8 v);</com>
  <com>load function wide</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function bytefield</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function matched</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/rust_fmt_write_real_x86_64</com>
  <com>read symbols</com>
  <com>option outlang rust</com>
  <com>load function 0x1b509</com>
  <com>decompile</com>
  <com>print C</com>
</script>
<stringmatch name="Rust physical store: qword stays unaligned through the byte pointer" min="1" max="1">value: u64, pointer: \*mut u64\| unsafe \{ ::core::ptr::write_unaligned\(pointer, value\) \}\)</stringmatch>
<stringmatch name="Rust physical store: word field is addressed without borrowing" min="1" max="1">&amp;raw mut \(\*p\)\.tail as \*mut u8</stringmatch>
<stringmatch name="Rust physical store: matching pointer keeps normal assignment" min="1" max="1">\*p = v;</stringmatch>
<stringmatch name="Rust physical store: indexed byte array supplies a raw halfword address" min="1" max="1">\)\(0x755c,\s*&amp;raw mut v[0-9]+\[.*\] as \*mut u16\);</stringmatch>
