<stringmatch name="FLOATEQ #3: two floats' bits both reinterpret" min="4" max="4">\{ \.from = a0 \}\)\.to [!=]= \(\(union \{ float from; unsigned int to; \}\)\{ \.from = a1 \}\)\.to\)</stringmatch>
<stringmatch name="FLOATEQ #4: the bits of a double's -0.0 compare as an integer" min="3" max="3">\(\(union \{ double from; unsigned long long to; \}\)\{ \.from = a0 \}\)\.to [!=]= 0x8000000000000000\)</stringmatch>
<stringmatch name="FLOATEQ #5: a double's quiet NaN pattern compares as an integer" min="3" max="3">\(\(union \{ double from; unsigned long long to; \}\)\{ \.from = ABS\(a0\) \}\)\.to [!=]= 0x7ff8000000000000\)</stringmatch>
<stringmatch name="FLOATEQ #6: no float comparison with -0.0 or NAN is left" min="0" max="0">[!=]= (-0\.0|-?NAN)\b</stringmatch>
