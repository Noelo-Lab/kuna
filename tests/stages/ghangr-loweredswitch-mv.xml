<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<!--
    angr LoweredSwitchSimplifier, second binary: coreutils mv compiled at -O2.
    The getopt_long option dispatch in main was lowered by GCC into a binary-search
    comparison tree on the return value; loweredswitch (DIV-4 default-on)
    reconstructs it into a switch.  See ghangr-loweredswitch.xml for the full
    write-up; this case adds a second real-world binary (a PIE this time).

    angr's test_reverting_switch_clustering_and_lowering_mv_o2_main expects one
    switch with cases 102,116,118,128,105,110,83,4294967165(-131),4294967166(-130),
    90,98.  kuna recovers a single switch with the simple option characters as
    explicit cases (83/90/98/102/105/116/118/128 = S/Z/b/f/i/t/v/0x80) plus a
    default; the three special-return values (110, -131, -130) fold into the
    default block's getopt/usage loop rather than as discrete case labels
    (a partial but correct recovery).

    Neighbour functions are mapped+named only to bound main's flow.  Pass 1 sets
    the option off (it is DIV-4 default-on) to show the upstream if/else chain.
-->
<bytechunk space="ram" offset="0x2b40">

</bytechunk>
<symbol space="ram" offset="0x2b40" name="main"/>
<symbol space="ram" offset="0x3210" name="_start"/>
<symbol space="ram" offset="0x3240" name="deregister_tm_clones"/>
<symbol space="ram" offset="0x3270" name="register_tm_clones"/>
<symbol space="ram" offset="0x32b0" name="__do_global_dtors_aux"/>
<symbol space="ram" offset="0x32f0" name="frame_dummy"/>
<symbol space="ram" offset="0x3300" name="target_directory_operand"/>
</binaryimage>
<script>
  <com>option loweredswitch off</com>
  <com>lo fu main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option loweredswitch on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="angr-mv #1: one switch (none in pass 1 off, one in pass 2 on)" min="1" max="1">switch\(</stringmatch>
<stringmatch name="angr-mv #2: default present" min="1" max="1">default:</stringmatch>
<stringmatch name="angr-mv #3: case 0x66 (102 f) recovered" min="1" max="1">case 0x66:</stringmatch>
<stringmatch name="angr-mv #4: case 0x74 (116 t) recovered" min="1" max="1">case 0x74:</stringmatch>
<stringmatch name="angr-mv #5: case 0x53 (83 S) recovered" min="1" max="1">case 0x53:</stringmatch>
<stringmatch name="angr-mv #6: case 0x80 (128) recovered" min="1" max="1">case 0x80:</stringmatch>
</decompilertest>
