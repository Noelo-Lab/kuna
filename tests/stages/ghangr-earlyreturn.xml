<script>
  <com>option earlyreturn off</com>
  <com>lo fu f</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option earlyreturn on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="earlyreturn #1: OFF keeps the diamond's else-arm, ON hoists it away (else appears once, in the OFF pass only)" min="1" max="1">else</stringmatch>
