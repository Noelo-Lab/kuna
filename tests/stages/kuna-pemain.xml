<!--
    The PE user-entry naming.

    The XML wrapper only provides the harness architecture. The pass clears
    it and loads the stripped in-tree MinGW PE fixture through the CLI's own
    loader. Its `__tmainCRTStartup` stores `envp` into msvcrt's `__initenv`
    through `.refptr.__imp___initenv` and then calls `main(argc, argv, envp)`
    at 0x140001592 (the unstripped twin `pe_imports.exe` names it there).

    Before the pass the CRT startup called the program's own entry as one
    more `sub_<addr>`, so nothing in the inventory said where the program
    starts. The pass names that callee `main`, at the call site and at its
    own definition.
    The first argument is a variable: the startup reads `dat_14000c028` into
    ecx before it stores `__initenv` through `.refptr.__imp___initenv`, and
    passes that register to main (`option indexaliasguard`).
-->
<bytechunk space="ram" offset="0x100000" readonly="true">
c3
</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/pe_imports_stripped.exe</com>
  <com>read symbols</com>
  <com>load function sub_1400011a0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function main</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="PEMAIN #1: the CRT startup never calls the program entry as an anonymous sub" min="0" max="0">= sub_140001592\(v\d+,dat_14000c020\);</stringmatch>
<stringmatch name="PEMAIN #2: the call site names main" min="1" max="1">= main\(v\d+,dat_14000c020\);</stringmatch>
<stringmatch name="PEMAIN #3: main is defined under its name" min="1" max="1">unsigned long long main\(unsigned int a0\)</stringmatch>
</decompilertest>
