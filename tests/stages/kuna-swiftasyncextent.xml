<stringmatch name="a run-on into an async body does not make the function async" min="1" max="1">void \* kuna_pick\(int4 a0\)</stringmatch>
<stringmatch name="the run-on still reaches the neighbour's call" min="2" max="2">swift_task_alloc\(0x40\)</stringmatch>
<stringmatch name="the async neighbour keeps its context" min="1" max="1">kuna_alloc\(swift\.AsyncContext \*async_context\)</stringmatch>
