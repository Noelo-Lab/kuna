<script>
  <com>option argclobber off</com>
  <com>lo fu caller2</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option argclobber on</com>
  <com>lo fu caller2</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
