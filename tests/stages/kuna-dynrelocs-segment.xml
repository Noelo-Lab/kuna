<decompilertest>
<binaryimage arch="x86:LE:64:default">
<!--
    kuna-dynrelocs-segment: the dynamic relocations of an image with no
    section table are read from PT_DYNAMIC.

    Stage: P1 environment binding (`loader/kuna_dynrelocs.rs
    (segment_relocations)`; fix, no option). Fixture
    tests/fixtures/relocs/lld-nosht.elf: an lld-linked PIE with its section
    headers zeroed (source and recipe in d.c). The section walk found no
    relocation table, so the RELA RELATIVE slots of the RELRO function-pointer
    table stayed zero and the call through tab[1] printed `(*dat_2848)(a0)`.
    DT_RELA now fills them and the call resolves to the function.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file tests/fixtures/relocs/lld-nosht.elf</com>
  <com>read symbols</com>
  <com>load addr 0x1730</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="dynrelocs segment #1: the RELRO table slot is filled from DT_RELA" min="1" max="1">sub_1690\(a0\);</stringmatch>
<stringmatch name="dynrelocs segment #2: no call through the unrelocated slot" min="0" max="0">\(\*dat_2848\)</stringmatch>
</decompilertest>
