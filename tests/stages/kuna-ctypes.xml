<stringmatch name="CTYPES #2: on, the same type spells as C" min="1" max="1">int printf\(</stringmatch>
<stringmatch name="CTYPES #3: off, an 8-byte unsigned cast is uint8" min="1" max="1">\(uint8\)</stringmatch>
<stringmatch name="CTYPES #4: on, LP64 spells an 8-byte unsigned `unsigned long`, not `unsigned long long`" min="1" max="1">\(unsigned long\)a0</stringmatch>
<stringmatch name="CTYPES #5: on, the 4-byte parameter is `unsigned int`" min="1" max="1">main\(unsigned int a0</stringmatch>
