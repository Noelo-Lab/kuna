  <com>option bejoin evidence</com>
  <com>lo fu add64</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu add_hi</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/bejoin_mipsunal</com>
  <com>read symbols</com>
  <com>option mipsunaligned off</com>
  <com>option bejoin callers</com>
