<script>
  <com>lo fu pk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pkw</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu syn</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu cop2</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu st</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option retsysreg off</com>
  <com>lo fu st</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
