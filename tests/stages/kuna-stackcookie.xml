  <com>function bounds 0x401090 as gsebp</com>
  <com>load function gsebp</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401130 as keyarg</com>
  <com>load function keyarg</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401150 as keyread</com>
  <com>load function keyread</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x4011a0 as copyarg</com>
  <com>load function copyarg</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x4011f0 as sehkey</com>
  <com>load function sehkey</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401240 as sehebp</com>
