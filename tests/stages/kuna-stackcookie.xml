<stringmatch name="STACKCOOKIE #1: the call under an SEH frame takes only its pushed name" min="1" max="1">= \(\*dat_403004\)\(s_40301c\);</stringmatch>
<stringmatch name="STACKCOOKIE #2: the method under an SEH frame takes only this" min="1" max="1">^  sub_4010c0\(a0 \+ 8\);</stringmatch>
<stringmatch name="STACKCOOKIE #3: the call in an EBP frame takes only its argument" min="1" max="1">\(\*dat_403008\)\(a0\);</stringmatch>
