<stringmatch name="STACKCOOKIE #5: without an SEH frame a pushed key ^ esp is the call's argument" min="1" max="1">= \(\*dat_403004\)\(dat_403021 \^ \(uint4\)&amp;Stack00000000\);</stringmatch>
