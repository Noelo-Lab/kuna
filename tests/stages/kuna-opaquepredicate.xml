<!-- P3 simplification quiescence, P0 option opaquepredicate (default off).
     A comparison that has one result for every input is folded, and the
     branch it guards loses the arm that never runs. clang -O0, x86-64:

       int check(int x, int y)   { if (((x * (x + 1)) & 1) == 0 || y < 10) return y + 1; return y - 1; }
       int keep(int x, int y)    { if (((x * (x + 2)) & 1) == 0 || y < 10) return y + 1; return y - 1; }
       int square(int x, int y)  { if (((x * x) & 3) == 2) return y * 3; return y - 7; }
       int mixed(unsigned x, unsigned y, int z)
                                 { if ((x | y) - (x & y) != (x ^ y)) return z * 5; return z + 2; }
       int mixedkeep(unsigned x, unsigned y, int z)
                                 { if ((x | y) - (x & y) != (x ^ (y & 4))) return z * 5; return z + 2; }
       int parity(unsigned x, unsigned y, int z)
                                 { if (x * (x + 1) == 2 * y + 1) return z * 9; return z + 4; }

     x * (x + 1) is even and x * x is 0 or 1 modulo 4 (decided by the low
     bits); (x | y) - (x & y) equals x ^ y (decided with each input all zeros
     or all ones); an even product never equals an odd sum (the low bits of
     the two sides always differ). keep and mixedkeep depend on their inputs
     and must stay. -->
