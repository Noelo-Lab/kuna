<script>
  <com>option calleearityfwd off</com>
  <com>lo fu caller</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option calleearityfwd on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="calleearityfwd #1: option off drops the argument at the call site that finalizes BEFORE its witness (bug reproduced)" min="1" max="1">callee\(\);</stringmatch>
<stringmatch name="calleearityfwd #2: option on recovers the size the small arm leaves in the argument register" min="1" max="1">callee\(a[0-9]+\);</stringmatch>
<stringmatch name="calleearityfwd #3: the site that was already right keeps exactly one argument in both passes" min="2" max="2">callee\(a[0-9]+ \+ 0x27\)</stringmatch>
</decompilertest>
