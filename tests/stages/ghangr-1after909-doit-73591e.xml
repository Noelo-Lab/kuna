<!--
    angr loop-successor break/continue recovery (Phoenix/SAILR), the upstream
    equivalent of Ghidra BlockGraph::scopeBreak(-1,-1) called in
    ActionFinalStructure right after finalizePrinting and before markUnstructured.

    This is the angr CTF binary 1after909 'doit' (x86-64, GCC, PIE): the
    command-processing `while (v12 <= 0x38e)` loop has nine error/`quit` paths
    that exit to the shared cleanup block at 0x239f (fflush / free-loop / fclose /
    puts("Bye!") / return).  kuna's port left scopeBreak an explicit SEAM stub, so
    every such loop-exit edge rendered as a raw `goto label_239f;` plus a
    synthesized `label_239f:`.  angr recovers the structured `break;`.

    The bytechunk is doit's exact bytes [0x1869, 0x2467); the called helpers
    (read_str/read_bin/convert/create_filename/verify_password) and main bound its
    flow by symbol exactly as `read symbols` would for the whole ELF; only doit is
    decompiled.

    Stage model: S8 "structuring" / goto-quality.  The option `loopbreak_recovery`
    is DIV-7 default-ON (the ablation over the 675-assertion datatest corpus and
    the cargo golden suite is clean); `off` restores the raw-goto rendering.
    Pass 1 (option loopbreak_recovery off): the bug. nine `goto label_239f;` and
    the synthesized `label_239f:` line.
    Pass 2 (option loopbreak_recovery on): the fix. those nine become `break;`
    and the now-dead `label_239f:` label is suppressed.
-->
<bytechunk space="ram" offset="0x1869">

</bytechunk>
<symbol space="ram" offset="0x111a" name="read_str"/>
<symbol space="ram" offset="0x119a" name="read_bin"/>
<symbol space="ram" offset="0x12eb" name="convert"/>
<symbol space="ram" offset="0x1710" name="create_filename"/>
<symbol space="ram" offset="0x177b" name="verify_password"/>
<symbol space="ram" offset="0x1869" name="doit"/>
<symbol space="ram" offset="0x2467" name="main"/>
</binaryimage>
<script>
  <com>option loopbreak_recovery off</com>
  <com>lo fu doit</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option loopbreak_recovery on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="angr-loopbreak #1: nine loop-exit gotos (pass1 off only; pass2 on recovers all)" min="9" max="9">goto label_239f;</stringmatch>
<stringmatch name="angr-loopbreak #2: synthesized cleanup label present in pass1, suppressed in pass2" min="1" max="1">label_239f:</stringmatch>
</decompilertest>
