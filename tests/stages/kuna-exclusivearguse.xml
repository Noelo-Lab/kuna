  <com>lo fu append_loop</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option exclusivearguse on</com>
  <com>lo fu append</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu append_loop</com>
  <com>decompile</com>
