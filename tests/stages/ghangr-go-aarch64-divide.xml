<script>
  <!-- kuna: returndup auto re-spells the returns of optimized functions; this test pins the structured form -->
  <com>option returndup record</com>
  <com>option tailform off</com>
  <com>option sourcelang go</com><com>option outlang go</com>
  <com>option noreturn runtime.panicdivide</com>
  <com>option noreturn application.panicdivide</com>
  <com>map prototype guarded_quotient int8 guarded_quotient(int8 a,int8 b);</com>
  <com>map prototype raw_quotient int8 raw_quotient(int8 a,int8 b);</com>
  <com>map prototype bounds_control int8 bounds_control(int8 *data,uint8 index,uint8 length);</com>
  <com>map prototype application_guard int8 application_guard(int8 a,int8 b);</com>
  <com>map prototype mixed_panics void mixed_panics(int8 a,int8 b);</com>
  <com>map prototype abi_quotient int8 abi_quotient(int8 a,int8 b);</com>
  <com>load function guarded_quotient</com><com>decompile</com><com>print C</com><com>print raw</com>
  <com>option gobounds off</com>
  <com>decompile</com><com>print C</com><com>print raw</com>
  <com>option gobounds on</com>
  <com>load function raw_quotient</com><com>decompile</com><com>print C</com><com>print raw</com>
  <com>load function bounds_control</com><com>decompile</com><com>print C</com><com>print raw</com>
  <com>load function application_guard</com><com>decompile</com><com>print C</com>
  <com>load function mixed_panics</com><com>decompile</com><com>print C</com><com>print raw</com>
  <com>load function abi_quotient</com><com>decompile</com><com>print C</com><com>print raw</com>
  <com>option sourcelang auto</com>
</script>
<stringmatch name="Go AArch64 compiler division keeps the original fail edge in default and audit modes" min="2" max="2">^0x00100000:[[:xdigit:]]+:[[:space:]]+goto .*else Block_.*:0x0010000c</stringmatch>
<stringmatch name="Go AArch64 compiler division prints its terminal panic in both modes" min="3" max="3">^[[:space:]]+runtime\.panicdivide\(\) // no-return</stringmatch>
<stringmatch name="Go AArch64 divide guard recognizes the exact ABI0 helper" min="1" max="1">^0x0010014c:[[:xdigit:]]+:[[:space:]]+call fruntime\.panicdivide\.abi0\(</stringmatch>
<stringmatch name="Go AArch64 bare SDIV still computes its quotient" min="1" max="1">^0x00100040:[[:xdigit:]]+:.*x0\(i\) / x1\(i\)</stringmatch>
<stringmatch name="Go AArch64 bare SDIV never gains a panic helper" min="0" max="0">^0x001000(40|44):[[:xdigit:]]+:.*call</stringmatch>
<stringmatch name="Go AArch64 ordinary bounds folding still keeps the indexed access" min="1" max="1">return \*\(\*int64\)\(unsafe.Add\(unsafe.Pointer\(data\),index \* 8\)\)</stringmatch>
<stringmatch name="Go AArch64 ordinary bounds folding still removes its own helper" min="0" max="0">^0x00100090:[[:xdigit:]]+:.*call</stringmatch>
<stringmatch name="Go AArch64 an application helper with the same suffix remains" min="1" max="1">^[[:space:]]+application\.panicdivide\(\) // no-return</stringmatch>
<stringmatch name="Go AArch64 a two-panic branch retains both arms" min="2" max="2">^0x001001(04|0c):[[:xdigit:]]+:[[:space:]]+call fruntime\.panic(Index|divide)\(</stringmatch>
