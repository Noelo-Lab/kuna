<script>
<com>map address r0x200000 void *gfp</com>
<com>parse line struct ops { int4 tag; void *add; code *done; };</com>
<com>parse line extern int4 viafield(ops *o, int4 x);</com>
<com>option ctypes on</com>
<com>option calltargettype off</com>
<com>lo fu viaparam</com><com>decompile</com><com>print C</com>
<com>lo fu viaglobal</com><com>decompile</com><com>print C</com>
<com>lo fu viafield</com><com>decompile</com><com>print C</com>
<com>option calltargettype on</com>
<com>lo fu viaparam</com><com>decompile</com><com>print C</com>
<com>lo fu viaglobal</com><com>decompile</com><com>print C</com>
<com>lo fu viafield</com><com>decompile</com><com>print C</com>
<com>option setlanguage rust-language</com>
<com>lo fu viaparam</com><com>decompile</com><com>print C</com>
<com>lo fu viaglobal</com><com>decompile</com><com>print C</com>
<com>lo fu viafield</com><com>decompile</com><com>print C</com>
<com>quit</com>
</script>
