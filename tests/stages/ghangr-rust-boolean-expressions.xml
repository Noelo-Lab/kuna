<stringmatch name="Merged Boolean XOR assignments retain Boolean identity" min="2" max="2">v1 = \(v1 \^ \(count == 3\)\) as bool;</stringmatch>
<stringmatch name="Merged Boolean AND assignment retains Boolean identity" min="1" max="1">v1 = \(v1 &amp; \(count != 3\)\) as bool;</stringmatch>
<stringmatch name="Merged Boolean OR assignment retains Boolean identity" min="1" max="1">v1 = \(v1 \| \(count == 3\)\) as bool;</stringmatch>
<stringmatch name="Callback Boolean expressions preserve all three bitwise operators" min="3" max="3">v1 = \(v1 [&amp;|^] observe\(count\)\) as bool;</stringmatch>
<stringmatch name="Boolean returns retain identity casts" min="6" max="6">return \(\(p == core::ptr::null_mut\(\)\) [&amp;|^] v1\) as bool;</stringmatch>
<stringmatch name="Boolean store retains identity cast" min="1" max="1">\*out = \(v1 &amp; \(a == 4\)\) as bool;</stringmatch>
<stringmatch name="Boolean expressions are never compared with integer zero" min="0" max="0">\(v1 [&amp;|^].*\) != 0;</stringmatch>
<stringmatch name="C keeps its Boolean bitwise return" min="1" max="1">return \(bool\)\(p == NULL &amp; v1\);</stringmatch>
</decompilertest>
