  <com>lo fu sysreset</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu park</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu toggle</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu irred</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
