<script>
  <com>set track r2 0x3000 0x1000 0x1001</com>
  <com>option callmechanisms on</com>
  <com>lo fu dispatch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option callmechanisms off</com>
  <com>lo fu dispatch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option callmechanisms auto</com>
  <com>lo fu dispatch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="PPC64 TOC reload #1: on recovers the switch over the table" min="1" max="1">switch\(</stringmatch>
<stringmatch name="PPC64 TOC reload #2: on labels the last case" min="1" max="1">case 3:</stringmatch>
<stringmatch name="PPC64 TOC reload #3: on keeps every case body" min="1" max="1">return 0x2c;</stringmatch>
<stringmatch name="PPC64 TOC reload #4: off and the default on a byte chunk keep the jump-as-call" min="2" max="2">jump-as-call</stringmatch>
