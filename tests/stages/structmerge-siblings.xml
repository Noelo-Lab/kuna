<script>
  <com>option structsynth param</com>
  <com>option structmerge off</com>
  <com>lo fu off_a</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu off_b</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu off_a</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option structmerge siblings</com>
  <com>lo fu on_a</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu on_b</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu on_a</com>
  <com>decompile</com>
  <com>print C</com>
  <com>print C types</com>
  <com>quit</com>
</script>
