<!-- P1 known Go no-return facts. The default must reach the terminal gopanic
     after the returning panicCheck1 helper. noreturn_known off exposes the
     sentinel beyond gopanic as a control for the terminal-call boundary. -->
<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file tests/fixtures/go-paniccheck-return/paniccheck-elf</com>
  <com>read symbols</com>
  <com>load function runtime.panicshift</com><com>decompile</com><com>print C</com>
  <com>load function runtime.panicCheck1</com><com>decompile</com><com>print C</com>
  <com>clear architecture</com>
  <com>load file tests/fixtures/go-paniccheck-return/paniccheck-elf</com>
  <com>option noreturn_known off</com>
  <com>read symbols</com>
  <com>load function runtime.panicshift</com><com>decompile</com><com>print C</com>
</script>
<stringmatch name="Go panicCheck1 returns to the terminal gopanic call" min="1" max="1">^void runtime\.panicshift\(void\)$
^\{$
^\s+runtime\.panicCheck1\(\);$
^\s+runtime\.gopanic\(\); // no-return$
^\}$</stringmatch>
<stringmatch name="Go panicCheck1 keeps its return and terminal throw paths" min="1" max="1">^void runtime\.panicCheck1\(.*\)$
^\{$
^\s+if \(!a0\)$
^\s+return;$
^\s+runtime\.throw\(\); // no-return$
^\}$</stringmatch>
<stringmatch name="Go gopanic fallthrough sentinel appears only with known no-return off" min="1" max="1">^void runtime\.panicshift\(void\)$
^\{$
^\s+runtime\.panicCheck1\(\);$
^\s+runtime\.gopanic\(\);$
^\s+dat_[[:xdigit:]]+ = 0x5a;$
^\}$</stringmatch>
</decompilertest>
