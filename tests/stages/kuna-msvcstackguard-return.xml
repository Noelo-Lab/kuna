<script>
  <com>option msvcstackguard off</com>
  <com>option calleeretpreserves off</com>
  <com>lo fu guarded_returns</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option calleeretpreserves on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option msvcstackguard on</com>
  <com>option calleeretpreserves off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option calleeretpreserves on</com>
  <com>decompile</com>
  <com>print C</com>
