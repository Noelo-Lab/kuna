<!--
    Switch arm order and the default arm of a void function's tail switch.
    P8 structure `switchcaseorder` (no option) and P9 `voidtailreturn`.

    BUG 1: upstream sorts the arms of a switch by label and the `default:` arm
    sorts under its table entry's label, so `force_str` printed `default:` between
    `case 0:` and `case 1:`; its arm ends in a call to the no-return `die`, which
    prints no statement that stops it, so the text fell through into `case 1:`,
    an edge the program does not have.  FIX: `default:` prints after the other
    arms and an arm ending in a no-return call after all of them.  Asserts #1
    and #2 pin the fixed order in one pass.

    BUG 2: `enable` ends with a switch that has no `default:`; with the
    epilogue duplicated into each arm, the values that leave the switch printed
    as `default: return;`.  FIX (`voidtailreturn`, default on): the switch is the
    last statement of a void function, so that arm is left out.  Pass 1 (default)
    asserts #3, pass 2 (`option voidtailreturn off`) keeps the arm, #4.

    The linear chains need `option loweredswitch linear` to re-roll.  gcc 11.4
    -O2 -fno-pie -no-pie -fno-jump-tables -fno-tree-switch-conversion
    -fcf-protection=none -nostdlib -static -Wl,-Ttext=0x401000 (x86-64) of

        __attribute__((noreturn, noinline)) void die(const char *fmt, int v) { for (;;) __asm__ volatile("" ::"r"(fmt), "r"(v)); }
        const char *nid_name(int nid) {
          switch (nid) {
          case 415: return "p256";
          case 715: return "p384";
          case 716: return "p521";
          default: return 0;
          }
        }
        void enable(unsigned *r, int ch) {
          switch (ch) {
          case 1: *r |= 1; break;
          case 2: *r |= 0x10000; break;
          case 3: *r |= 0x10001; break;
          }
        }
        const char *force_str(int t) {
          switch (t) {
          case 0: return "   ";
          case 1: return "[*]";
          case 2: return "[!]";
          default: die("bad %d", t);
          }
        }
        __attribute__((noinline)) int sink(int x) { return x * 7 + 3; }
        int two(int t, int *p) {
          switch (t) {
          case 4: p[0] = sink(1); break;
          case 9: p[1] = sink(2); break;
          default: p[2] = 0; break;
          }
          return p[3];
        }
        void _start(void) {}
-->
