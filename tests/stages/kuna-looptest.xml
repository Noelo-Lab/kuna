<stringmatch name="LOOPTEST #1: fill tests its pointer at the top" min="1" max="1">^  while \(a != v1\) \{$</stringmatch>
<stringmatch name="LOOPTEST #2: fill keeps its n == 0 guard only under binary" min="1" max="1">^  if \(n\) \{$</stringmatch>
<stringmatch name="LOOPTEST #3: drain and count test i &lt; n at the top" min="2" max="2">^  while \(v1 &lt; n\) \{$</stringmatch>
<stringmatch name="LOOPTEST #4: drain is a guarded do-while under binary" min="1" max="1">^    \} while \(v1 &lt; n\);$</stringmatch>
<stringmatch name="LOOPTEST #5: zero16's entry test folds to true" min="1" max="1">^  while \(v1 != 0x10\) \{$</stringmatch>
<stringmatch name="LOOPTEST #6: zero16 is a do-while under binary" min="1" max="1">^  \} while \(v1 != 0x10\);$</stringmatch>
<stringmatch name="LOOPTEST #7: count's latch i != n prints as i &lt; n" min="0" max="0">^    \} while \(v1 != n\);$</stringmatch>
<stringmatch name="LOOPTEST #8: the n &gt; 0 guard is printed only for drain under binary" min="1" max="1">^  if \(1 &lt;= n\) \{$</stringmatch>
<stringmatch name="LOOPTEST #9: walk tests the variable q is copied into" min="1" max="1">^  while \(p\) \{$</stringmatch>
<stringmatch name="LOOPTEST #10: walk keeps its guard and do-while under binary" min="1" max="1">^    \} while \(v1\);$</stringmatch>
<stringmatch name="LOOPTEST #11: skip's test reads a body value, so it stays a do-while" min="1" max="1">^  \} while \(v1 != ' '\);$</stringmatch>
<stringmatch name="LOOPTEST #12: no guarded loop prints a second return" min="0" max="0">^  return;$</stringmatch>
