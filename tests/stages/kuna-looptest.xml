  <com>parse line extern void fill(int8 *a,int8 n,int8 v);</com>
  <com>parse line extern int8 drain(int8 n,int8 *a);</com>
  <com>parse line extern void zero16(int8 *a);</com>
  <com>parse line extern void count(int8 *a,int8 n);</com>
  <com>parse line extern int8 walk(int8 **p);</com>
  <com>parse line extern void skip(char *s,char **out);</com>
  <com>lo fu fill</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu drain</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu zero16</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu count</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu walk</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu skip</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option looptest binary</com>
  <com>lo fu fill</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu drain</com>
  <com>decompile</com>
