<stringmatch name="CLEANUPCODE #4: the deallocation's argument setup dies with the call too" min="1" max="1">0x55667788</stringmatch>
<stringmatch name="CLEANUPCODE #5: the real call is untouched in BOTH passes, so the transform is surgical" min="2" max="2">real_work</stringmatch>
