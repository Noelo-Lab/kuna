<stringmatch name="LIBCTYPES #2: on, the same parameter is a named FILE *" min="1" max="1">int4 fclose\(FILE \*a0\)</stringmatch>
<stringmatch name="LIBCTYPES #3: off, the fopen result is an opaque void *" min="1" max="1">void \* fopen\(char \*a0,char \*a1\)</stringmatch>
<stringmatch name="LIBCTYPES #4: on, the fopen result is a named FILE *" min="1" max="1">FILE \* fopen\(char \*a0,char \*a1\)</stringmatch>
