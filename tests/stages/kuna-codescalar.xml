  <com>lo fu databyte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option codescalar on</com>
  <com>lo fu codebyte</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu databyte</com>
  <com>decompile</com>
  <com>print C</com>
