<stringmatch name="sparc64-hiddenret-slot-locals #2: the call receives the declared buffer" min="1" max="1">mutate\(v1\);</stringmatch>
<stringmatch name="sparc64-hiddenret-slot-locals #3: the result is reloaded after the call" min="1" max="1">return v1\[0\];</stringmatch>
<stringmatch name="sparc64-hiddenret-slot-locals #4: no undeclared stack location" min="0" max="0">Stack0</stringmatch>
