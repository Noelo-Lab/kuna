<!--
    GH-468: a stack char buffer terminated by an explicit zero at its last
    element printed one element short, with the terminator as a separate
    char nothing reads.  Stage: P6 stack-frame layout (ScopeLocal::restructure),
    option nulterminator on|off.  Every function is decompiled twice, option
    off then on; the assertion counts span all passes.

    canary_check is the real 183 bytes at 0x140001160 of the reporter's
    ab_od.exe (MSVC /Od /GS /Zi):

        int canary_check(const char *in) {
            char buf[64]; int acc = 0;
            strncpy(buf, in, sizeof(buf) - 1);
            buf[sizeof(buf) - 1] = 0;
            for (int i = 0; buf[i]; i++) acc += (unsigned char)buf[i];
            return acc;
        }

    buf is [rsp+0x30, rsp+0x70) against the /GS cookie at rsp+0x70.  Heritage
    folds the constant-index terminator into a direct one-byte store at
    stack - 0x19, and the scan loop's index is unbounded, so the open hint for
    buf keeps the gatherOpen index floor of 3 and restructure ends buf at the
    store.  Off: uint1 [63] beside char at stack - 0x19.  On: uint1 [64] and
    the store renders as v[0x3f] = 0.  strncpy carries the libc prototype the
    loader gives the real binary; __report_rangecheckfailure and
    __security_check_cookie are shortened to their fast-fail shapes.

    The other functions are hand-assembled (Windows x64, sub rsp,0x58, so
    [rsp+X] is stack - (0x58 - X)); fill(char *), fill_int(int4 *) and
    fill_wide(uint2 *) are `xor eax,eax; ret` stubs.

    pad_after (the array is closed one element after its terminator, never
    over the alignment padding that follows it):
        lea rcx,[rsp+0x20]; call fill       ; char buf[34] at stack - 0x38
        mov byte [rsp+0x41],0                ; buf[33] = 0, stack - 0x17
        mov dword [rsp+0x48],eax             ; int after 6 bytes of padding
        lea rcx,[rsp+0x20]; call fill; add eax,[rsp+0x48]
    Off: char [33] + char at stack - 0x17.  On: char [34].  An array that
    kept filling to the int would print [40].

    gap_zero (a second zero two elements past the new end stays separate):
        lea rcx,[rsp+0x20]; call fill       ; char buf[21]
        mov byte [rsp+0x34],0                ; buf[20] = 0, stack - 0x24
        mov byte [rsp+0x36],0                ; unread zero at stack - 0x22
        mov dword [rsp+0x48],eax; lea rcx,[rsp+0x20]; call fill; add eax,[rsp+0x48]
    Off: char [20] + two chars.  On: char [21] + the char at stack - 0x22.

    pad_zero (a zero byte after alignment padding stays separate):
        lea rcx,[rsp+0x20]; call fill       ; char buf[27]
        mov byte [rsp+0x3a],0                ; buf[26] = 0, stack - 0x1e
        mov byte [rsp+0x40],0                ; byte local at stack - 0x18
        mov dword [rsp+0x48],eax; lea rcx,[rsp+0x20]; call fill; add eax,[rsp+0x48]
    Off: char [26] + two chars.  On: char [27] + the char at stack - 0x18.

    read_later (a zeroed local that is read later is not a terminator):
        mov byte [rsp+0x37],0; lea rcx,[rsp+0x20]; call fill
        movsx eax,byte [rsp+0x37]            ; return the local
    Both passes: char [23] + char at stack - 0x21.

    read_direct (a terminator slot the code also reads directly):
        mov byte [rsp+0x38],0
      l: lea rcx,[rsp+0x20]; call fill; cmp byte [rsp+0x38],0; je l
    Both passes: char [24] + char at stack - 0x20.

    nonzero (a non-zero store is not a terminator):
        lea rcx,[rsp+0x20]; call fill; mov byte [rsp+0x32],0x78
        mov dword [rsp+0x48],eax; lea rcx,[rsp+0x20]; call fill; add eax,[rsp+0x48]
    Both passes: char [18] + char at stack - 0x26.

    wide_elem (a zeroed element after an int4 array is not a terminator):
        lea rcx,[rsp+0x20]; call fill_int; mov dword [rsp+0x30],0
        lea rcx,[rsp+0x20]; call fill_int
    Both passes: int4 [4] + unsigned int at stack - 0x28.

    wide_zero (a zeroed two-byte slot after a char array is not a terminator):
        lea rcx,[rsp+0x20]; call fill; mov word [rsp+0x31],0
        mov dword [rsp+0x48],eax; lea rcx,[rsp+0x20]; call fill; add eax,[rsp+0x48]
    Both passes: char [17] + unsigned short at stack - 0x27.

    addr_taken (a zeroed byte whose address is taken is not a terminator):
        mov byte [rsp+0x3f],0; lea rcx,[rsp+0x20]; call fill
        lea rcx,[rsp+0x3f]; call fill
    Both passes: char [31] + char [25] at stack - 0x19.

    wide_str (a UTF-16 terminator):
        lea rcx,[rsp+0x20]; call fill_wide   ; uint2 buf[15]
        mov word [rsp+0x3c],0                ; buf[14] = 0, stack - 0x1c
        mov dword [rsp+0x48],eax; lea rcx,[rsp+0x20]; call fill_wide; add eax,[rsp+0x48]
    Off: uint2 [14] + unsigned short at stack - 0x1c.  On: uint2 [15].

    two_literals (a zero after a pointer into the middle of the range belongs
    to the second object, as in grep's
    strcoll((char []){i, 0}, (char []){i + 1, 0})):
        mov eax,ecx; add eax,1
        mov byte [rsp+0x22],al; mov byte [rsp+0x23],0   ; b[2] = {c + 1, 0}
        mov byte [rsp+0x20],cl; mov byte [rsp+0x21],0   ; a[2] = {c, 0}
        lea rdx,[rsp+0x22]; lea rcx,[rsp+0x20]; call cmp2
    Upstream already merges both literals into one char [3]; both passes keep
    it and the char at stack - 0x35 rather than growing it to [4].
-->
