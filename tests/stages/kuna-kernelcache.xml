<decompilertest>
<binaryimage arch="AARCH64:LE:64:v8A:default">
<!--
    Kuna `kernelcache` option (P1 code-data partition): load an iOS kernelcache
    straight from its IMG4 / IM4P container and pick one MH_FILESET entry.

    The fixtures are generated by gen_fileset.py next to them: a two-entry arm64
    kernel collection (com.apple.kernel + com.example.driver.Widget) sharing one
    DYLD_CHAINED_PTR_64_KERNEL_CACHE fixup table and one LINKEDIT, wrapped as
    IMG4(IM4P(LZFSE)) and as a bare IM4P(complzss).

    Pass 1 (`option kernelcache off`) is the bug: the bare collection loads as
    one image with no symbol table, so the kext's direct call into the kernel is
    sub_<addr> calling sub_<addr> (and the IMG4 does not load at all).
    Pass 2 (`option kernelcache Widget`) loads the kext out of the IMG4: the
    kext's direct `bl` into the kernel and its __stubs call both render
    kernel_add, bound through the collection's symbols. Pass 3 (`auto`) loads
    the kernel entry out of the complzss IM4P.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c0035fd6</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>option kernelcache off</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/fileset.macho</com>
  <com>read symbols</com>
  <com>load addr 0xfffffff007007800</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option kernelcache Widget</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/kernelcache.img4</com>
  <com>read symbols</com>
  <com>load function widget_start</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function widget_via_stub</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option kernelcache auto</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/kernelcache/kernelcache.lzss.im4p</com>
  <com>read symbols</com>
  <com>load function kernel_add</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="KERNELCACHE #1: off leaves the kext and its kernel callee unnamed" min="1" max="1">^  sub_fffffff007007000\(a0,7\);</stringmatch>
<stringmatch name="KERNELCACHE #2: the selected kext entry carries its own symbol" min="1" max="1">^void widget_start\(</stringmatch>
<stringmatch name="KERNELCACHE #3: the kext's direct call into the kernel is bound by name" min="1" max="1">^  kernel_add\(a0,7\);</stringmatch>
<stringmatch name="KERNELCACHE #4: the kext's __stubs call is named" min="1" max="1">^  kernel_add\(a0,8\);</stringmatch>
<stringmatch name="KERNELCACHE #5: auto loads the kernel entry out of the complzss IM4P" min="1" max="1">return a0 \+ a1;</stringmatch>
</decompilertest>
