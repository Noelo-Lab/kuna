<stringmatch name="EPILOGUE-POP #1: halfsel takes the index" min="1" max="1">^[a-z0-9 ]+ halfsel\(void \*a0,uint4 a1\)$</stringmatch>
<stringmatch name="EPILOGUE-POP #2: halfsel returns the element the index selects" min="1" max="1">^  return \(\(unsigned int \*\)&amp;v1\)\[a1\];$</stringmatch>
<stringmatch name="EPILOGUE-POP #3: no function returns the popped double" min="0" max="0">^  return \(\(unsigned long long \*\)a0\)\[0x21\];$</stringmatch>
<stringmatch name="EPILOGUE-POP #4: scaled returns a float by index" min="1" max="1">
^float4 scaled\(float4 \*a0,uint4 a1\)$
^\{$
^  float4 v1 \[2\];.*$
^  $
^  v1\[1\] = a0\[1\] \* dat_1100;$
^  v1\[0\] = \*a0 \+ \*a0;$
^  return v1\[a1\];$
</stringmatch>
<stringmatch name="EPILOGUE-POP #5: a pop with no rival still returns the flags" min="1" max="1">^uint8 eflags\(void\)$</stringmatch>
<stringmatch name="EPILOGUE-POP #6: xmm0 only stored leaves the popped argument returned" min="1" max="1">
^unsigned long long spill\(unsigned long long \*a0,unsigned long long \*a1,unsigned long long a2\)$
^\{$
^  \*a1 = \*a0;$
^  return a2;$
</stringmatch>
<stringmatch name="EPILOGUE-POP #7: a struct built in the frame keeps its rax return" min="1" max="1">^unsigned long long pair\(float4 \*a0,unsigned int a1\)$</stringmatch>
