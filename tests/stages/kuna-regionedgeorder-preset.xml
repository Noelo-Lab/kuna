<script>
  <com>lo fu set_exit_status</com>
  <com>decompile</com>
  <com>print C</com>
  <com>mode aggressive</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option regionedgeorder on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="regionedgeorder preset #1: the defaults and mode aggressive print the source's else if" min="2" max="2">  else if \(!dat_404000\)$</stringmatch>
<stringmatch name="regionedgeorder preset #2: option regionedgeorder on prints a guard return" min="1" max="1">    if \(dat_404000\)$</stringmatch>
<stringmatch name="regionedgeorder preset #3: only the ordering returns early" min="1" max="1">      return;$</stringmatch>
<stringmatch name="regionedgeorder preset #4: every pass stores 2 and 1" min="6" max="6">dat_404000 = [12];$</stringmatch>
