<decompilertest>
  <!-- Kuna #810. P3 callee-memory summaries / P6 physical-write liveness. option stackviews off (default) retains the first initializer; on removes it through a stack-passed pointer. Direct caller-frame reads, const-declared writes and returned-pointer reads before/after overwrite preserve native behavior. -->
  <binaryimage arch="x86:LE:32:default:gcc">
    <bytechunk space="ram" offset="0x401000"></bytechunk>
    <bytechunk space="ram" offset="0x402000">00000000</bytechunk>
    <symbol space="ram" offset="0x401000" name="overwrite_after_stack_read" />
    <symbol space="ram" offset="0x40103d" name="overwrite_after_stack_hidden" />
    <symbol space="ram" offset="0x40107a" name="read_after_stack_write" />
    <symbol space="ram" offset="0x4010a5" name="returned_pointer_read_before_overwrite" />
    <symbol space="ram" offset="0x4010e7" name="returned_pointer_read_after_overwrite" />
    <symbol space="ram" offset="0x401129" name="stack_return_pointer" />
    <symbol space="ram" offset="0x40112f" name="stack_read_pair" />
    <symbol space="ram" offset="0x40113b" name="stack_read_second" />
    <symbol space="ram" offset="0x401143" name="stack_hidden_read" />
    <symbol space="ram" offset="0x401148" name="stack_const_write" />
    <symbol space="ram" offset="0x401155" name="_start" />
    <symbol space="ram" offset="0x402000" name="stack_saved_pointer" />
    <symbol space="ram" offset="0x402004" name="__bss_start" />
    <symbol space="ram" offset="0x402004" name="_edata" />
    <symbol space="ram" offset="0x402004" name="_end" />
  </binaryimage>
  <script>
    <com>parse line typedef struct CalleePair { int first; int second; } CalleePair;</com>
    <com>parse line extern int overwrite_after_stack_read(void);</com>
    <com>parse line extern int overwrite_after_stack_hidden(void);</com>
    <com>parse line extern int read_after_stack_write(void);</com>
    <com>parse line extern int returned_pointer_read_before_overwrite(void);</com>
    <com>parse line extern int returned_pointer_read_after_overwrite(void);</com>
    <com>parse line extern struct CalleePair *stack_return_pointer(const struct CalleePair *pair);</com>
    <com>parse line extern int stack_read_pair(const struct CalleePair *pair);</com>
    <com>parse line extern int stack_read_second(const struct CalleePair *pair);</com>
    <com>parse line extern int stack_hidden_read(const struct CalleePair *pair);</com>
    <com>parse line extern int stack_const_write(const struct CalleePair *pair);</com>
    <com>map addr r0x402000 struct CalleePair *stack_saved_pointer</com>
    <com>option stackalias off</com>
    <com>option stackviews off</com>
    <com>lo fu overwrite_after_stack_read</com>
    <com>decompile</com>
    <com>print C</com>
    <com>option stackviews on</com>
    <com>lo fu overwrite_after_stack_read</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu overwrite_after_stack_hidden</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu read_after_stack_write</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu returned_pointer_read_before_overwrite</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu returned_pointer_read_after_overwrite</com>
    <com>decompile</com>
    <com>print C</com>
    <com>quit</com>
  </script>
  <stringmatch name="x86 callee stack: first writes survive off and real observers" min="4" max="4"> = 5;</stringmatch>
  <stringmatch name="x86 callee stack: all second words survive" min="6" max="6"> = 7;</stringmatch>
  <stringmatch name="x86 callee stack: all later overwrites survive" min="5" max="5"> = 9;</stringmatch>
  <stringmatch name="x86 callee stack: stack-passed const writer does not fold stale bytes" min="0" max="0">return 12;</stringmatch>
