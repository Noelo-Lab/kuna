<script>
  <com>parse line extern int above(float x);</com>
  <com>parse line extern int at_least(float x);</com>
  <com>parse line extern int not_above(float x);</com>
  <com>parse line extern int not_at_least(float x);</com>
  <com>parse line extern int pick(double x,double y);</com>
  <com>parse line extern int above_branch(float x);</com>
  <com>parse line extern double nan_or_huge(double x);</com>
  <com>parse line extern int ordered_below_pair(float x,float y);</com>
  <com>parse line extern int nan_or_above(double x);</com>
  <com>parse line extern int ordered_below(float x);</com>
  <com>parse line extern int jp_jbe(float x);</com>
  <com>parse line extern double work(double x);</com>
  <com>map address r0x402000 float one</com>
  <com>map address r0x405000 float8 huge</com>
  <com>map address r0x405008 float8 bound</com>
