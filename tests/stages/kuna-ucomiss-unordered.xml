<stringmatch name="UCOMISS unordered #1: seta is one &lt; x" min="1" max="1">return one &lt; x;</stringmatch>
<stringmatch name="UCOMISS unordered #2: setae is one &lt;= x" min="1" max="1">return one &lt;= x;</stringmatch>
<stringmatch name="UCOMISS unordered #3: setbe keeps the unordered case" min="1" max="1">return !\(one &lt; x\);</stringmatch>
<stringmatch name="UCOMISS unordered #4: setb keeps the unordered case" min="1" max="1">return !\(one &lt;= x\);</stringmatch>
<stringmatch name="UCOMISS unordered #5: sbb borrow keeps the unordered case" min="1" max="1">-\(uint4\)!\(y &lt;= x\)</stringmatch>
<stringmatch name="UCOMISS unordered #6: jbe branch is one &lt; x" min="1" max="1">if \(one &lt; x\)</stringmatch>
<stringmatch name="UCOMISS unordered #7: nanignore none keeps the guards" min="1" max="1">\(NAN\(x\) \|\| NAN\(one\)\) \|\| x &lt;= one</stringmatch>
<stringmatch name="UCOMISS unordered #8: no ordered spelling of an unordered flag" min="0" max="0">x != one|return x &lt;= one;|return x &lt; one;|!\(x &lt;= one\)|!\(x &lt; one\)|\(x &lt; y\)</stringmatch>
<stringmatch name="UCOMISS unordered #9: an isnan test beside an exact jbe stays" min="1" max="1">if \(\(!NAN\(x\)\) &amp;&amp; \(!\(huge &lt; x\)\)\)</stringmatch>
<stringmatch name="UCOMISS unordered #10: setnp beside an exact setb stays" min="1" max="1">\(!NAN\(x\) &amp;&amp; !NAN\(y\)\) &amp;&amp; !\(y &lt;= x\)</stringmatch>
<stringmatch name="UCOMISS unordered #11: setp beside an exact seta stays" min="1" max="1">return bound &lt; x \|\| NAN\(x\);</stringmatch>
<stringmatch name="UCOMISS unordered #12: setnp beside an exact setb through a pointer stays" min="1" max="1">return !\(limit &lt;= x\) &amp;&amp; !NAN\(x\);</stringmatch>
<stringmatch name="UCOMISS unordered #13: jp then jbe on one memory compare" min="1" max="1">if \(\(!NAN\(x\) &amp;&amp; !NAN\(limit\)\) &amp;&amp; \(limit &lt; x\)\)</stringmatch>
<stringmatch name="UCOMISS unordered #14: no NaN test dropped beside an exact compare" min="0" max="0">if \(x &lt;= limit\)|return x &lt; limit;|!\(x &lt; bound\)|!\(x &lt;= huge\)</stringmatch>
</decompilertest>
