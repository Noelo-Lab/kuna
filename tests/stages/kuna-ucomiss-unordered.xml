<decompilertest>
<!--
  Authored SSE COMISS/COMISD probe: seta, setae, setbe and setb after a
  compare with a memory operand, a borrow (sbb) after COMISD, and a jbe
  branch after UCOMISS. Each condition flag is true for unordered inputs
  (ZF=PF=CF=1), so x > one must print as one < x (false for a NaN) and
  setbe as !(one < x) (true for a NaN), never as x <= one.
  P3 nanignore folding (kuna_floatnegation.rs) keeps the exact single
  comparison before the NaN guards are dropped. Strict correctness fix,
  no new option: pass 1 pins the defaults, pass 2 (nanignore none) keeps
  the explicit guards. The compiled-C oracle is in
  kuna-cli/tests/float_unordered_compare.rs.
-->
<binaryimage arch="x86:LE:64:default:gcc">
  <bytechunk space="ram" offset="0x401000">
    31c00f2f05f70f00000f97c0c331c00f2f05ea0f00000f93c0c331c00f2f
    05dd0f00000f96c0c331c00f2f05d00f00000f92c0c3660f2fc119c083e0
    0283c003c30f2e05b80f00007606b803000000c3b805000000c3
  </bytechunk>
  <bytechunk space="ram" offset="0x402000">0000803f</bytechunk>
  <symbol space="ram" offset="0x401000" name="above"/>
  <symbol space="ram" offset="0x40100d" name="at_least"/>
  <symbol space="ram" offset="0x40101a" name="not_above"/>
  <symbol space="ram" offset="0x401027" name="not_at_least"/>
  <symbol space="ram" offset="0x401034" name="pick"/>
  <symbol space="ram" offset="0x401041" name="above_branch"/>
</binaryimage>
<script>
  <com>parse line extern int above(float x);</com>
  <com>parse line extern int at_least(float x);</com>
  <com>parse line extern int not_above(float x);</com>
  <com>parse line extern int not_at_least(float x);</com>
  <com>parse line extern int pick(double x,double y);</com>
  <com>parse line extern int above_branch(float x);</com>
  <com>map address r0x402000 float one</com>
  <com>lo fu above</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu at_least</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu not_above</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu not_at_least</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu pick</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu above_branch</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option nanignore none</com>
  <com>lo fu not_above</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="UCOMISS unordered #1: seta is one &lt; x" min="1" max="1">return one &lt; x;</stringmatch>
<stringmatch name="UCOMISS unordered #2: setae is one &lt;= x" min="1" max="1">return one &lt;= x;</stringmatch>
<stringmatch name="UCOMISS unordered #3: setbe keeps the unordered case" min="1" max="1">return !\(one &lt; x\);</stringmatch>
<stringmatch name="UCOMISS unordered #4: setb keeps the unordered case" min="1" max="1">return !\(one &lt;= x\);</stringmatch>
<stringmatch name="UCOMISS unordered #5: sbb borrow keeps the unordered case" min="1" max="1">!\(y &lt;= x\)</stringmatch>
<stringmatch name="UCOMISS unordered #6: jbe branch is one &lt; x" min="1" max="1">if \(one &lt; x\)</stringmatch>
<stringmatch name="UCOMISS unordered #7: nanignore none keeps the guards" min="1" max="1">NAN\(x\)</stringmatch>
<stringmatch name="UCOMISS unordered #8: no ordered spelling of an unordered flag" min="0" max="0">x != one|return x &lt;= one;|return x &lt; one;|!\(x &lt;= one\)|!\(x &lt; one\)|\(x &lt; y\)</stringmatch>
</decompilertest>
