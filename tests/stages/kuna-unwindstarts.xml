<stringmatch name="unwindstarts on: the second unwind-only start joins the inventory (default pass: absent)" min="1" max="1">0x100000328 sub_100000328</stringmatch>
<stringmatch name="unwindstarts on: the third unwind-only start joins the inventory (default pass: absent)" min="1" max="1">0x100000370 sub_100000370</stringmatch>
