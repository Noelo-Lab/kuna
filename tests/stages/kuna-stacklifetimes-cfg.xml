<!-- Kuna #810; P6 physical lifetime families / P9 storage presentation.
     stackalias off/on checks conditional native writes. stackviews off reproduces
     numeric float assignment; on preserves member bits and call memory versions. -->
<decompilertest>
  <binaryimage arch="x86:LE:64:default:gcc">
    <bytechunk space="ram" offset="0x401000"></bytechunk>
    <bytechunk space="ram" offset="0x402000">0000000000000000</bytechunk>
    <symbol space="ram" offset="0x401000" name="all_paths_overwrite" />
    <symbol space="ram" offset="0x401030" name="one_path_overwrites" />
    <symbol space="ram" offset="0x401057" name="loop_overwrites" />
    <symbol space="ram" offset="0x40107f" name="loop_may_skip" />
    <symbol space="ram" offset="0x4010ab" name="read_escaped" />
    <bytechunk space="ram" offset="0x405000"></bytechunk>
    <bytechunk space="ram" offset="0x406000">00000040000000000000803f0000000000000000000000400000000000000000</bytechunk>
    <symbol space="ram" offset="0x405000" name="xor_view" />
    <symbol space="ram" offset="0x40504d" name="constant_bits" />
    <symbol space="ram" offset="0x405082" name="effect_bits" />
    <symbol space="ram" offset="0x4050bb" name="double_bits" />
    <symbol space="ram" offset="0x405033" name="read_float" />
    <symbol space="ram" offset="0x4050f5" name="read_double" />
    <symbol space="ram" offset="0x405044" name="observe_word" />
    <symbol space="ram" offset="0x405106" name="observe_quad" />
    <symbol space="ram" offset="0x4050b4" name="write_word" />
  </binaryimage>
  <script>
    <com>map addr r0x402000 int4 *escaped_pointer</com>
    <com>parse line extern int4 all_paths_overwrite(int4 value);</com>
    <com>parse line extern int4 one_path_overwrites(int4 value);</com>
    <com>parse line extern int4 loop_overwrites(int4 value);</com>
    <com>parse line extern int4 loop_may_skip(int4 value);</com>
    <com>parse line extern int4 read_escaped(void);</com>
    <com>option stackalias off</com>
    <com>lo fu one_path_overwrites</com>
    <com>decompile</com>
    <com>print C</com>
    <com>option stackalias on</com>
    <com>lo fu all_paths_overwrite</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu one_path_overwrites</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu loop_overwrites</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu loop_may_skip</com>
    <com>decompile</com>
    <com>print C</com>
    <com>parse line struct FloatStorage { float4 value; };</com>
    <com>parse line struct DoubleStorage { float8 value; };</com>
    <com>parse line extern int4 xor_view(float4 initial);</com>
    <com>parse line extern int4 double_bits(float8 initial);</com>
    <com>parse line extern int4 constant_bits(void);</com>
    <com>parse line extern int4 effect_bits(void (*writer)(uint4 *value));</com>
    <com>parse line extern int4 read_float(const float4 *value);</com>
    <com>parse line extern int4 read_double(const float8 *value);</com>
    <com>parse line extern void observe_word(const uint4 *value);</com>
    <com>parse line extern void observe_quad(const uint8 *value);</com>
    <com>map addr r0x406000 float4 two</com>
    <com>map addr r0x406004 uint4 observed_word</com>
    <com>map addr r0x406010 float8 two_double</com>
    <com>map addr r0x406018 uint8 observed_quad</com>
    <com>option stackalias off</com>
    <com>option stackviews off</com>
    <com>lo fu xor_view</com>
    <com>map addr s0xffffffffffffffe8 FloatStorage protected_float</com>
    <com>decompile</com>
    <com>print C</com>
    <com>option stackviews on</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu double_bits</com>
    <com>map addr s0xffffffffffffffe8 DoubleStorage protected_double</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu constant_bits</com>
    <com>decompile</com>
    <com>print C</com>
    <com>lo fu effect_bits</com>
    <com>decompile</com>
    <com>print C</com>
    <com>quit</com>
  </script>
  <stringmatch name="stack lifetimes: the off control and observable paths retain initialization" min="3" max="3">^  .* = 1;$</stringmatch>
  <stringmatch name="stack lifetimes: the fully overwritten branch values stay observable" min="1" max="1">= \(value\) \? 5 : 7;</stringmatch>
  <stringmatch name="stack lifetimes: both loops preserve their physical write" min="2" max="2">^    .* = 7;$</stringmatch>
  <stringmatch name="stack lifetimes: unknown memory observers remain in both modes" min="5" max="5">= read_escaped\(\);</stringmatch>
  <stringmatch name="stack lifetimes: the off control uses a numeric float conversion" min="1" max="1">protected_float.value = \(float4\)\(\(uint4\)protected_float.value \^ 0x400000\);</stringmatch>
  <stringmatch name="stack lifetimes: a declared float member receives the integer bits" min="1" max="1">protected_float.value = \(\(union \{ unsigned int from; float to;</stringmatch>
  <stringmatch name="stack lifetimes: a declared double member receives the integer bits" min="1" max="1">protected_double.value = \(\(union \{ unsigned long long from; double to;</stringmatch>
  <stringmatch name="stack lifetimes: call versions do not copy fields out of constants" min="0" max="0">\.bytes\._</stringmatch>
  <stringmatch name="stack lifetimes: the real constant replacement stays written" min="1" max="1">v2.view_uint4 = 0x3fc00000;</stringmatch>
  <stringmatch name="stack lifetimes: an unknown writer still executes" min="1" max="1">\(\*writer\)\(&amp;v1.view_uint4\);</stringmatch>
  <stringmatch name="stack lifetimes: observations surround the unknown writer" min="2" max="2">observe_word\(&amp;v1.view_uint4\);</stringmatch>
  <stringmatch name="stack lifetimes: a read uses bytes after the unknown writer" min="1" max="1">return read_float\(&amp;v1.view_float4\);</stringmatch>
</decompilertest>
