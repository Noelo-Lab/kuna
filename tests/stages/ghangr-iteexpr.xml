<script>
  <!-- iteexpr is default-off; set it explicitly in pass 1 to guard a future flip,
       then flip it on for pass 2 (the only change between the two passes). -->
  <com>option iteexpr off</com>
  <com>lo fu expr_arm</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option iteexpr on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="iteexpr on folds a computed-arm diamond to one ?: ternary (off = if/else)" min="1" max="1">\? </stringmatch>
