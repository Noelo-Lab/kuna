<stringmatch name="bejoin-evidence #1b: only off puts the low product first" min="1" max="1">return CONCAT44\(a1 \* a0,</stringmatch>
<stringmatch name="bejoin-evidence #2: the default returns widen's argument sign-extended" min="1" max="1">int8 widen\(int4 a0\)</stringmatch>
<stringmatch name="bejoin-evidence #2b: only off shifts widen's sign into the low word" min="1" max="1">return CONCAT44\(a0,a0 &gt;&gt; 0x1f\);</stringmatch>
<stringmatch name="bejoin-evidence #3: the default returns zsum's sum zero-extended" min="1" max="1">return \(uint4\)\(a1 \+ a0\);</stringmatch>
