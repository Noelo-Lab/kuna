  <com>option calleereginputs off</com>
  <com>load function use</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option calleereginputs on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/vcall_pe_i386.exe</com>
  <com>read symbols</com>
  <com>option calleereginputs off</com>
  <com>function bounds 0x401000 as vcall_off</com>
  <com>load function vcall_off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401010 as comcall_off</com>
  <com>load function comcall_off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401020 as reserve_off</com>
  <com>load function reserve_off</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option calleereginputs on</com>
  <com>function bounds 0x401000 as vcall_on</com>
  <com>load function vcall_on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401010 as comcall_on</com>
  <com>load function comcall_on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>function bounds 0x401020 as reserve_on</com>
  <com>load function reserve_on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
