  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/swift_stdlib_macho</com>
  <com>read symbols</com>
  <com>parse line extern void _report_rect(float8 x,float8 y,float8 width,float8 height);</com>
  <com>load addr 0x100004054</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load addr 0x100004080</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load addr 0x1000040b0</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load addr 0x1000040e8</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="the report takes the two names, their lengths and the flags" min="1" max="1">_swift_stdlib_reportUnimplementedInitializer\("Frame",5,"init\(frame:\)",0xc,0\);</stringmatch>
<stringmatch name="the version triple is the struct" min="1" max="1">swift\.NSOperatingSystemVersion v1;</stringmatch>
<stringmatch name="the major version is its first field" min="1" max="1">return v1\.majorVersion;</stringmatch>
<stringmatch name="the failed try! does not return" min="1" max="1">swift_unexpectedError\(a0,"Lib\.swift",9,1,0x2a\); // no-return</stringmatch>
<stringmatch name="nothing after swift_unexpectedError is reached" min="0" max="0">return 7;</stringmatch>
<stringmatch name="the box is the one argument" min="1" max="1">swift_deallocBox\(a1\);</stringmatch>
