<decompilertest>
<!--
    Small compare-lowered switches re-roll by default.  P2 "switch-model",
    `option loweredswitch off|on|linear`.

    gcc lowers every switch below its case-count threshold to equality tests.
    `nid_name` loads each case's string before the compare that selects it
    (`mov eax,K ; cmp ; je ret`, a `cmovne` for the last case) and every case
    reaches one shared `ret`; `enable` is a chain of three tests with a body
    each; `two` is a two-case switch.

    Pass 1 (`option loweredswitch off`) is the compiler's chain: #1 nested
    tests.  Pass 2 (the default, `on`): `nid_name` re-rolls along the raw paths
    of its compare tree, each case returning its own string and NULL as the
    default (#2, #3); `enable` re-rolls (#4); the two-case chain stays an if
    (#5).  `colon` (openssh misc.c) scans a string with a chain of tests on each
    character inside a loop; re-rolled, its arms continue the loop and the
    structurer loses the loop to gotos, so the switch is withdrawn and the
    function prints as with `loweredswitch off`: the loop stays (#8, #9).
    The switch reads its selector as the `int` the compares read (#10), and
    `kind`'s labels over a `char` print as characters (#11). `pick` compares a
    function pointer against three functions; no case label can spell their
    names, so it stays a chain of compares (#12).
    Pass 3 (`option loweredswitch linear`) re-rolls `two` as well (#6).

    gcc 11.4 -O2 -fno-pie -no-pie -fno-jump-tables -fno-tree-switch-conversion
    -fcf-protection=none -nostdlib -static -Wl,-Ttext=0x401000 (x86-64) of

        __attribute__((noreturn, noinline)) void die(const char *fmt, int v) { for (;;) __asm__ volatile("" ::"r"(fmt), "r"(v)); }
        const char *nid_name(int nid) {
          switch (nid) {
          case 415: return "p256";
          case 715: return "p384";
          case 716: return "p521";
          default: return 0;
          }
        }
        void enable(unsigned *r, int ch) {
          switch (ch) {
          case 1: *r |= 1; break;
          case 2: *r |= 0x10000; break;
          case 3: *r |= 0x10001; break;
          }
        }
        const char *force_str(int t) {
          switch (t) {
          case 0: return "   ";
          case 1: return "[*]";
          case 2: return "[!]";
          default: die("bad %d", t);
          }
        }
        __attribute__((noinline)) int sink(int x) { return x * 7 + 3; }
        int two(int t, int *p) {
          switch (t) {
          case 4: p[0] = sink(1); break;
          case 9: p[1] = sink(2); break;
          default: p[2] = 0; break;
          }
          return p[3];
        }
        void _start(void) {}

    `colon`, `kind` and `pick`, built the same way on their own and placed at
    0x403000, 0x403100 and 0x403200 (`pick` with fa, fb, fc and g ahead of it):

        char *colon(char *cp)
        {
            int flag = 0;

            if (*cp == ':')
                return 0;
            if (*cp == '[')
                flag = 1;
            for (; *cp; ++cp) {
                if (*cp == '@' && *(cp+1) == '[')
                    flag = 1;
                if (*cp == ']' && *(cp+1) == ':' && flag)
                    return (cp+1);
                if (*cp == ':' && !flag)
                    return (cp);
                if (*cp == '/')
                    return 0;
            }
            return 0;
        }
        void kind(char c, int *p)
        {
            switch (c) {
            case 'a': p[0] = 1; break;
            case 'm': p[1] = 7; break;
            case 'z': p[2] = 9; break;
            default: p[3] = 0; break;
            }
        }
        __attribute__((noinline)) void fa(void) { __asm__ volatile(""); }
        __attribute__((noinline)) void fb(void) { __asm__ volatile("nop"); }
        __attribute__((noinline)) void fc(void) { __asm__ volatile("nop; nop"); }
        __attribute__((noinline)) void g(int v) { __asm__ volatile("" :: "r"(v)); }
        __attribute__((noinline)) void pick(void (*f)(void))
        {
            if (f == fa) g(1);
            else if (f == fb) g(7);
            else if (f == fc) g(9);
            else g(0);
        }
    The script pins `option dedupitetail on`: the default `latch` joins a loop
    latch gcc duplicated here, which changes the shape these asserts pin.
-->
