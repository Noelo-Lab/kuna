<decompilertest>
<!-- Octeon review: P4 declared ABI storage. Original GCC 7.3 -O2 -g,
     BE -mabi=64 -msoft-float; source/build recipe in tests/fixtures/octeon-abi.
     Strict spec fixes, selected by the explicit target. Old N32 loses aggregate
     arguments/returns; old N64 loses alignment and half the quad result. -->
<binaryimage arch="MIPS:BE:64:octeon:default">
<bytechunk space="ram" offset="0x100000" readonly="true"></bytechunk>
<symbol space="ram" offset="0x00000000001000a0" name="quad_after"/>
<symbol space="ram" offset="0x00000000001000a8" name="quad_identity"/>
<symbol space="ram" offset="0x0000000000100120" name="quad_last_after"/>
</binaryimage>
<script>
<com>option ctypes on</com>
<com>parse line struct Pair { long long a, b; };</com>
<com>parse line struct Small { int x; };</com>
<com>parse line extern long long quad_after(long long a, long double b, long long c);</com>
<com>lo fu quad_after</com><com>decompile</com><com>print C</com>
<com>parse line extern long double quad_identity(long double b);</com>
<com>lo fu quad_identity</com><com>decompile</com><com>print C</com>
<com>parse line extern long long quad_last_after(long long p0, long long p1, long long p2, long long p3, long long p4, long long p5, long long p6, long double q, long long value);</com>
<com>lo fu quad_last_after</com><com>decompile</com><com>print C</com>
<com>quit</com>
</script>
<stringmatch name="Octeon 64 ABI quad_after returns the source value" min="1" max="1">return c;</stringmatch>
<stringmatch name="Octeon 64 ABI quad_identity returns the source value" min="1" max="1">return b;</stringmatch>
<stringmatch name="Octeon 64 ABI quad_last_after returns the source value" min="1" max="1">return value;</stringmatch>
</decompilertest>
