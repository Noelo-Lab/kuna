<!--
    GH-867: a local array indexed up to a clamped bound is declared with four
    elements and its last elements split into scalars.

    Stage: P6 stack-frame-layout.  P0 assertion: option arrayextent off|bound|on.

    MapState::gatherOpen gives an indexed stack base room for four elements and
    RangeHint::attempt_join refuses a fixed hint past them, so unless the
    value-set refinement locks the guard's range, element 4 onward is laid out
    as its own scalar and the printed subscript runs off the declared array.
    `arrayextent bound` sizes a base from the known bits of its index
    (`v[n & 7]`); `on` (the default) also lets an unbounded indexed base take
    the contiguous same-width slots after it that are never read except
    through a pointer.

    Source, x86-64, clang -O1 at 0x100000 and gcc -O2 at 0x200000 (both with
    -fno-stack-protector -fcf-protection=none -fno-inline; sink in its own
    file so neither compiler sees its body), linked with ld -Ttext:

      int h(int a, int b, int c, int d, int e, int f, int n) {
        int v[6] = {a, b, c, d, e, f};
        int t = 0;
        for (int i = 0; i < n && i < 6; i++) t += v[i] * (i + 1);
        return t;
      }
      int m(int a, int b, int c, int d, int e, int f, int g, int h, int n) {
        int v[8] = {a, b, c, d, e, f, g, h};
        return v[n & 7] * 3 + v[(n >> 3) & 7];
      }
      struct Q { int arr[4]; int s; int t; };
      void sink(struct Q *p);
      int q(int a, int b, int c, int d, int e, int f, int n) {
        struct Q x;
        x.arr[0] = a; x.arr[1] = b; x.arr[2] = c; x.arr[3] = d; x.s = e; x.t = f;
        sink(&x);
        int r = 0;
        for (int i = 0; i < n; i++) r += x.arr[i];
        return r + x.s * x.t;
      }
      int w(int a, int b, int c, int d, int e, int f, int g, int h, int n, int k) {
        int u[4] = {a, b, c, d};
        int z[4] = {e, f, g, h};
        int r = 0;
        for (int i = 0; i < n; i++) r += u[i] * z[(i + k) & 3];
        for (int i = 0; i < k; i++) r ^= z[i];
        return r;
      }

    Passes: default (on), `option arrayextent bound`, `option arrayextent off`.
    #1, #2, #4 and #6 prove the fix; #3, #5 and #7 reproduce the split in the
    passes that do not cover the case.  #8 and #9 are the negative cases: struct
    fields read on their own after the array stay scalars, and two adjacent
    indexed arrays stay two arrays, in every pass.
-->
