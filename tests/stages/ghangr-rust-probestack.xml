<!--
  Upstream: angr test_decompiler.py::test_decompiling_rust_binary_rust_probestack.
  P2 / flow classification; P0: rustprobestack off|auto|always (default off).
  Authored harmless Rust-linked AMD64 fixture; no upstream executable is run.
  Off retains three helpers and unknown R11/saved-RBP values. Auto recovers all
  eleven values, including zero/page boundaries and the saved-RBP/return slots.
  Flag observations, unknown frames and an effectful non-probe retain their calls.
-->
<decompilertest>
<binaryimage arch="x86:LE:64:default:gcc">
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/rust_probestack_x86_64</com>
  <com>option rustprobestack off</com>
  <com>read symbols</com>
  <com>parse line extern uint4 probe_page(uint4 x);</com>
  <com>load function probe_page</com>
  <com>decompile</com>
  <com>print C</com>
  <com>parse line extern uint4 probe_observes_r11(uint4 x);</com>
  <com>load function probe_observes_r11</com>
  <com>decompile</com>
  <com>print C</com>
