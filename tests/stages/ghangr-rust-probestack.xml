  <com>load function probe_saved_rbp</com>
  <com>decompile</com>
  <com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/rust_probestack_x86_64</com>
  <com>option rustprobestack auto</com>
  <com>read symbols</com>
