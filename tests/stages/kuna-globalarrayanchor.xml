<stringmatch name="unbiased indexing stays unchanged" min="1" max="1">^  flags\[slot\] = 0;</stringmatch>
<stringmatch name="unmapped base is not guessed" min="1" max="1">\*\(unsigned short \*\)\(slot \* 2 \+ 0x600016\) = 0;</stringmatch>
