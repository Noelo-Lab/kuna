<stringmatch name="disabled anchor or pointer inference retains folded literal" min="2" max="2">\*\(unsigned short \*\)\(slot \* 2 \+ 0x400016\) = 0;</stringmatch>
<stringmatch name="enabled retains declared array" min="1" max="1">^  flags\[slot \+ -1\] = 0;</stringmatch>
