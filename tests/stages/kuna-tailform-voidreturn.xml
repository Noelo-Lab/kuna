<!--
    kuna `tailform`: in a void function whose last statement is a one-arm
    `if (c) { S; return; }`, the arm's `return;` repeats the end of the
    function and is not printed (the valued case, an arm ending in the
    function's own final `return K;`, was already dropped).

    Stage / sub-stage: P8 "goto-quality", a print-tree edit after final
    structuring, with `voidtailreturn` on (the default).

    The image is decompiler/crates/kuna-analysis/tests/fixtures/
    callerptr_O0_x86_64, loaded whole.  Its `__do_global_dtors_aux` (the C
    runtime's) ends in `if (!completed) { ...; completed = 1; return; }`.  Pass 1
    (`option tailform off`) prints the inner `return;`; pass 2 (`option
    tailform on`, whose size rule keeps this four-line tail wrapped; the
    default `model` prints it after a guard clause) does not.
-->
<bytechunk space="ram" offset="0x100000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x100000" name="harness_stub"/>
</binaryimage>
<script>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/callerptr_O0_x86_64</com>
  <com>read symbols</com>
  <com>option tailform off</com>
  <com>load function __do_global_dtors_aux</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option tailform on</com>
  <com>load function __do_global_dtors_aux</com>
  <com>decompile</com>
  <com>print C</com>
</script>
<stringmatch name="tailform void return #1: off, the arm ends in a return" min="1" max="1">^    completed\.0 = 1;$
^    return;$
^  \}$</stringmatch>
<stringmatch name="tailform void return #2: on, the arm ends in its store" min="1" max="1">^    completed\.0 = 1;$
^  \}$
^\}$</stringmatch>
</decompilertest>
