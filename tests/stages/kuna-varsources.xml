<script>
  <com>option namestyle angr</com>
  <com>lo fu copy_home</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu loop_home</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu merged_homes</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu arithmetic_home</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu constant_home</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu joined_home</com>
  <com>decompile</com>
  <com>print C</com>
