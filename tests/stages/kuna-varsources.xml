<!--
    Kuna user report: local declarations lost their machine-storage comments
    after COPY elimination, phi merging, or paired-register return recovery.
    P6 variables / P9 declaration emission. This is a correctness fix under
    the existing P0 presentation policy: namestyle angr includes sources;
    namestyle ghidra omits them. No new option is introduced.

    All instructions are independently assembled synthetic x86-64 examples
    (GNU as, Intel syntax), with functions aligned to 16 bytes:

      copy_home: mov eax,[rdi+24]; test eax,eax; je zero;
        lea ecx,[rax+1]; mov [rsi],eax; mov eax,ecx; ret;
        zero: xor eax,eax; ret
      loop_home: mov eax,[rdi+24]; mov ecx,[rdi+28]; test eax,eax;
        je ret; lea r9d,[rax+rcx]; xor r8d,r8d;
        loop: shl r8d,2; movzx edx,byte ptr [rdi+rcx]; or r8d,edx;
        inc ecx; cmp ecx,r9d; jne loop; mov eax,r8d; ret
      merged_homes: push rbx; test edi,edi; je other;
        mov eax,[rsi]; jmp sink; other: mov ebx,[rsi+4]; mov eax,ebx;
        sink: mov [rdx],eax; add eax,1; pop rbx; ret
      arithmetic_home: mov eax,[rdi]; imul ecx,eax,3; mov [rsi],ecx;
        lea edx,[rcx+1]; mov [rsi+4],ecx; add eax,edx; ret
      constant_home: test edi,edi; je other; mov eax,7; jmp sink;
        other: mov ebx,[rsi]; mov eax,ebx;
        sink: mov [rdx],eax; add eax,7; ret
      joined_home: push rbx; call joined_helper; mov [rdi],rax;
        mov [rdi+8],rdx; add rax,rdx; pop rbx; ret
      joined_helper: mov rax,1; mov rdx,2; ret
      stack_home: sub rsp,24; lea rax,[rdi+rdi*2]; mov [rsp+8],rax;
        lea rdi,[rsp+8]; call stack_helper; mov rax,[rsp+8]; add rsp,24; ret
      stack_helper: add qword ptr [rdi],1; ret
      byte_source: push r15; movzx r15d,byte ptr [rdi+3]; mov r8d,r15d;
        shl r15d,24; movzx ecx,byte ptr [rdi+2]; shl ecx,16; or r15d,ecx;
        movzx ecx,byte ptr [rdi+1]; shl ecx,8; or r15d,ecx;
        movzx ecx,byte ptr [rdi]; or r15d,ecx; mov [rsi],r8d;
        mov eax,r15d; pop r15; ret
      cmov_source: push r13; mov r13d,edi; lea eax,[r13-1]; add r13d,1;
        cmp esi,5; cmovne r13d,eax; mov [rdx],r13d; mov eax,r13d; pop r13; ret
      parameter_source: push rbx; mov rbx,rdi; mov eax,[rbx];
        add eax,[rbx+4]; pop rbx; ret

      The outgoing_* callers all preserve rbx/r14 and call_sink stores its
      second argument at [rdi+8]. Their relevant value instructions are:

      outgoing_only: mov r14d,[rbx]; mov esi,r14d; call call_sink;
        mov [rbx+4],r14d
      outgoing_definition: mov esi,[rbx]; mov r14d,esi; call call_sink;
        mov [rbx+4],r14d
      outgoing_rmw: mov r14d,[rbx]; mov esi,r14d; imul esi,esi,7;
        xor esi,0x13579bd; inc esi; mov r14d,esi; call call_sink;
        mov [rbx+4],r14d
      outgoing_local_use: mov r14d,[rbx]; mov esi,r14d; mov [rbx+12],esi;
        call call_sink; mov [rbx+4],r14d
      outgoing_indirect: mov rax,rsi; mov r14d,[rbx]; mov esi,r14d;
        call rax; mov [rbx+4],r14d
      durable_call_result: call make_value; mov r14d,eax;
        mov esi,r14d; mov rdi,rbx; call call_sink;
        mov esi,r14d; mov rdi,rbx; call call_sink
      make_value: mov eax,[rdi]; ret
      stack_outgoing: push rbx; sub rsp,16; mov rbx,rdi; lea rdi,[rsp+15];
        call write_byte; movzx esi,byte ptr [rsp+15]; mov rdi,rbx;
        call call_sink; add rsp,16; pop rbx; ret
      write_byte: mov byte ptr [rdi],7; ret
      outgoing_independent_write: mov r14d,[rbx]; mov esi,r14d; call call_sink;
        mov esi,[rbx+16]; imul esi,esi,5; xor esi,0x2468ace; inc esi;
        mov r14d,esi; mov rdi,rbx; call call_sink; mov [rbx+4],r14d

    Before the fix copy_home v1 had no comment, merged_homes reported no
    registers, and joined_home / joined_helper had no source for the pair.
    The load's source is eax alone: the derived ecx value is a different
    value. The multiply's result is ecx alone, not its eax input. A repeated
    literal 7 must not give unrelated values one another's storage.

    The byte loads are narrowed when their zero extensions become implied
    casts; their homes must remain visible at the byte width. CMOV merges
    arithmetic results already held in eax / r13d, without borrowing edi from
    the arithmetic input. Parameters have no source comments, including when
    an explicit prototype supplies the parameter name.

    Outgoing argument-only copies do not add local homes: both the direct and
    indirect calls must leave the local attributed to r14d alone. ESI remains
    a home when it holds a load result, a read-modify-write computation, or a
    copied value also used by a local store. A callee-saved r14d copy from a
    call result remains a durable home across calls even when every later use
    forwards it to an argument. Reloading a helper-written stack byte only to
    pass it in esi does not add sil or esi to the stack variable's homes.
    A later independent computation in esi must retain that home after an
    earlier argument-only write to the same register.
-->
