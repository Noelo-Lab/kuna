  <com>decompile</com>
  <com>print C</com>
  <com>lo fu stack_home</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu stack_home</com>
  <com>map addr s0xfffffffffffffff0 int8 named_value</com>
  <com>decompile</com>
  <com>print C</com>
  <com>lo fu byte_source</com>
  <com>decompile</com>
  <com>print C</com>
