  <com>parse line extern int4 parameter_source(int4 *cursor);</com>
  <com>lo fu parameter_source</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option namestyle ghidra</com>
  <com>lo fu arithmetic_home</com>
  <com>decompile</com>
