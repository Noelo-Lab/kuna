<stringmatch name="WSIGNLOAD-A64 #2: lsb: ldrsb w unsigned offset" min="1" max="1">return \(uint4\)p\[1\];</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #3: lsh_idx/lsb_idx: register offset" min="2" max="2">return \(uint4\)p\[i\];</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #4: lsh_neg/lsb_neg: ldursh and ldursb w" min="2" max="2">return \(uint4\)p\[-1\];</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #5: lsh_pre: pre-index" min="1" max="1">return \(int8\)&amp;p\[1\] \+ \(uint8\)\(uint4\)p\[1\];</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #6: lsb_post: post-index" min="1" max="1">return \(uint8\)&amp;p\[\(uint4\)\*p \+ 1UL\];</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #7: tbl: the index is the 32-bit value" min="1" max="1">return t\[\(uint4\)\*p\];</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #8: no 64-bit sign extension of a w load" min="0" max="0">\(int8\)p\[</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #9: no zero extension of ldursb w" min="0" max="0">\(uint1\)p\[</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #10: lsh64: x destination still sign-extends" min="1" max="1">return \*p;</stringmatch>
<stringmatch name="WSIGNLOAD-A64 #11: lsb_neg64: ldursb x still sign-extends" min="1" max="1">return p\[-1\];</stringmatch>
