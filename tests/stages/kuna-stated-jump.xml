<decompilertest>
<binaryimage arch="x86:LE:64:default">
<bytechunk space="ram" offset="0x1000" readonly="true">c3</bytechunk>
<symbol space="ram" offset="0x1000" name="stage_entry"/>
</binaryimage>
<script>
<com>clear architecture</com>
<com>load file tests/fixtures/stated-jump/dispatch.elf</com>
<com>read symbols</com>
