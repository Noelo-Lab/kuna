<stringmatch name="Stated second destination labels the target operand" min="2" max="2">case 0x401030:</stringmatch>
<stringmatch name="Stated third destination labels the target operand" min="2" max="2">case 0x401050:</stringmatch>
<stringmatch name="Stating taken destinations preserves the independent miss" min="2" max="2">if \(\(uint4\)a1 &gt; 2\)
