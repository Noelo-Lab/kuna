<com>option tailform on</com>
<com>load function dispatch</com>
<com>decompile</com>
<com>print C</com>
<com>override jumptable 401009 401050 401020 401030 401020</com>
<com>decompile</com>
<com>print C</com>
<com>decompile</com>
<com>print C</com>
<com>quit</com>
</script>
<stringmatch name="Opaque jump is unresolved before its destinations are stated" min="1" max="1">jump-as-call</stringmatch>
