  <com>load function self_loop_exit</com><com>decompile</com><com>print C</com>
  <com>load function mixed_loop</com><com>decompile</com><com>print C</com>
  <com>clear architecture</com>
  <com>load file decompiler/crates/kuna-analysis/tests/fixtures/switch_self_loop_clang_x86_64.o</com>
  <com>read symbols</com>
  <com>load function self_loop</com><com>decompile</com><com>print C</com>
  <com>load function self_loop_exit</com><com>decompile</com><com>print C</com>
  <com>load function mixed_loop</com><com>decompile</com><com>print C</com>
  <com>load function direct_mixed</com><com>decompile</com><com>print C</com>
