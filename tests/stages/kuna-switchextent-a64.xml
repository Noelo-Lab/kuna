<binaryimage arch="AARCH64:LE:64:v8A:default">
<!--
    AArch64 compact jump tables with no range check, assembled from
    decompiler/crates/kuna-analysis/tests/fixtures/switchextent_aarch64.s
    (the .text and .rodata of switchextent_aarch64).

    `unchecked` dispatches twice on a call's result (`bl pick`), through
    halfword offset tables laid out back to back in .rodata: tab_first
    (3 entries at 0x11160) is followed by tab_second (4 entries at 0x11166).
    Nothing bounds either index, so the basic model finds the whole 32-bit
    range and both dispatches print as computed calls. With switchextent
    (default on) the first table ends where the function's second begins
    and recovers as a three-case switch; the second is the function's last
    and stays a computed call. `last` dispatches once through tab_last
    (0x1116e), followed by a byte array the function reads (bytes_last,
    0x11172): an object that is not a jump table bounds nothing, so it
    stays a computed call too. `entering` is bounded by the `cmp w0,#2;
    b.ls` that branches into its dispatch block.
-->
<bytechunk space="ram" offset="0x10000">

</bytechunk>
<bytechunk space="ram" offset="0x11158">
00020406000204000000020004000000020004000600000002000102030405060708
</bytechunk>
<symbol space="ram" offset="0x10000" name="guarded"/>
<symbol space="ram" offset="0x10048" name="entering"/>
<symbol space="ram" offset="0x10088" name="pick"/>
<symbol space="ram" offset="0x10090" name="unchecked"/>
<symbol space="ram" offset="0x10118" name="last"/>
</binaryimage>
<script>
  <com>load function unchecked</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function last</com>
  <com>decompile</com>
  <com>print C</com>
  <com>load function entering</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option switchextent off</com>
  <com>load function unchecked</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="switchextent #1: the first unchecked table ends at the function's second and is a switch" min="1" max="1">switch\(pick\(a0\)\) \{</stringmatch>
<stringmatch name="switchextent #2: the switch has the three cases the second table's start admits, and entering its three" min="6" max="6">case [0-2]:</stringmatch>
<stringmatch name="switchextent #3: a function's last table stays a computed call: unchecked's second, last's only, and unchecked's first with the option off (the second is then unreached)" min="3" max="3">// jump-as-call</stringmatch>
<stringmatch name="switchextent #4: a byte array the function reads bounds nothing: last's table is still read by the computed call" min="1" max="1">\* 2UL \+ 0x1116e\) \* 4UL</stringmatch>
<stringmatch name="switchextent #5: a range check that branches into the dispatch block bounds the table" min="1" max="1">switch\(a0\) \{</stringmatch>
</decompilertest>
