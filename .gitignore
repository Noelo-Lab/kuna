# Upstream Makefile build output dirs (created under decompiler/cpp/)
decompiler/cpp/com_dbg/
decompiler/cpp/com_opt/
decompiler/cpp/test_dbg/
decompiler/cpp/ghi_dbg/
decompiler/cpp/ghi_opt/
decompiler/cpp/sla_dbg/
decompiler/cpp/sla_opt/

# Built binaries
decompiler/cpp/decomp_dbg
decompiler/cpp/decomp_opt
decompiler/cpp/decomp_test_dbg
decompiler/cpp/sleigh_dbg
decompiler/cpp/sleigh_opt
decompiler/cpp/ghidra_dbg
decompiler/cpp/ghidra_opt
decompiler/cpp/*.a
*.o

# Generated SLEIGH artifacts (built by `make specs`)
specs/**/*.sla
specs/**/*.sla.lock

# Rust port build output (rust/, see docs/rust-port/)
rust/target/

# Golden snapshot dumps produced by the Rust-port differential harness
tests/golden/snapshots/

# Python
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# Local libbfd prefix fetched by tools/fetch_bfd.sh (no-root builds)
.bfdlocal/

# kuna pipeline runtime state: worker inventory, heartbeats, logs, isolated worktrees.
# The durable backlog (docs/pipeline/*.json, matrix.md) IS committed; live state is not.
.kuna-pipeline/

# Rewritten patch left by tools/sync_upstream.py (dry runs / failed applies)
.kuna_sync.patch

# Coverage / editor leftovers
*.gcov
*.gcno
*.gcda
TAGS
*~
.claude/
out.txt
