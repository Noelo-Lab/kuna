# Generated SLEIGH artifacts (built by `make specs`)
specs/**/*.sla
specs/**/*.sla.lock

# Rust build output (decompiler/, the Cargo workspace)
decompiler/target/

# Golden snapshot dumps produced by the differential harness
tests/golden/snapshots/

# Python
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/

# kuna pipeline runtime state: worker inventory, heartbeats, logs, isolated worktrees.
# The durable backlog (docs/improvement-pipeline/*.json, matrix.md) IS committed; live state is not.
.kuna-pipeline/

# RE-friction loop runtime state: inventory, rounds, tester arenas, per-run CODEX_HOMEs,
# worktrees, logs. The durable backlog (docs/re-needs/) and the promoted regression probes
# (tests/cli/) ARE committed; nothing under here is.
.kuna-repipe/

# Rewritten patch left by tools/sync_upstream.py (dry runs / failed applies)
.kuna_sync.patch

# Coverage / editor leftovers
*.gcov
*.gcno
*.gcda
TAGS
*~
.claude/
out.txt

# pyjoern scratch (created when scripts/decbench rescore/triage run from repo root)
workspace/

# decbench mined pools: tens of MB of machine-generated rows, regenerable from the
# results tree with `scripts.decbench.mine` / `.novel`. The ranked tables
# (docs/decbench/*.md), the triage queues and the triage records ARE committed.
docs/decbench/cases*.json
docs/decbench/novel.json
