:clmh c_rhA,0,BD6 is c_op8=0xeb & c_opl=0x20 & c_rhA & BD6 & c_nB=0 { CC0 = 1; CC1 = 0; CC2 = 0; CC3 = 0; ccAux(); }

# String instructions. Each one stops at the character in r0 or at a CPU-chosen
# limit; the model is the completed operation, so the retry branch never fires.
:srst b_rE,b_rF is b_op16=0xb25e & b_rE & b_rF { local hit:8 = search_string(r0l:1, b_rF, b_rE); CC0 = 0; CC1 = (hit != b_rE); CC2 = (hit == b_rE); CC3 = 0; ccAux(); b_rE = hit; }
:clst b_rE,b_rF is b_op16=0xb25d & b_rE & b_rF { local res:1 = compare_string(r0l:1, b_rE, b_rF); CC0 = (res == 0); CC1 = (res == 1); CC2 = (res == 2); CC3 = 0; ccAux(); }
:mvst b_rE,b_rF is b_op16=0xb255 & b_rE & b_rF { b_rE = move_string(r0l:1, b_rE, b_rF); CC0 = 0; CC1 = 1; CC2 = 0; CC3 = 0; ccAux(); }
