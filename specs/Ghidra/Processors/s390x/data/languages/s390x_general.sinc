# Branches. A mask of 15 is unconditional and a mask of 0 never branches;
# BCR with register 0 is a no-op whatever its mask.
:br a_rB is a_op8=0x07 & a_nA=15 & a_nB=14 & a_rB { return [r14]; }
:br a_rB is a_op8=0x07 & a_nA=15 & a_rB { goto [a_rB]; }
:nopr is a_op8=0x07 & a_nA=15 & a_nB=0 {  }
:nopr a_rB is a_op8=0x07 & a_nA=0 & a_rB {  }
:nopr is a_op8=0x07 & COND2 & a_nB=0 {  }
:b^COND2^"r" a_rB is a_op8=0x07 & COND2 & a_nB=14 & a_rB { if (!COND2) goto inst_next; return [r14]; }
:b^COND2^"r" a_rB is a_op8=0x07 & COND2 & a_rB { if (!COND2) goto inst_next; goto [a_rB]; }
:b XBD4 is b_op8=0x47 & b_nA=15 & XBD4 { goto [XBD4]; }
:nop XBD4 is b_op8=0x47 & b_nA=0 & XBD4 {  }
:b^COND4 XBD4 is b_op8=0x47 & COND4 & XBD4 { if (!COND4) goto inst_next; goto [XBD4]; }
:j REL16_4 is b_op8=0xa7 & b_op4=0x4 & b_nA=15 & REL16_4 { goto REL16_4; }
:jnop REL16_4 is b_op8=0xa7 & b_op4=0x4 & b_nA=0 & REL16_4 {  }
