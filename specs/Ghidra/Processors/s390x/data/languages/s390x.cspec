<?xml version="1.0" encoding="UTF-8"?>
<!-- s390x ELF ABI (Linux on IBM Z).

     r2..r6 carry the integer arguments and f0, f2, f4, f6 the floating-point
     ones (a float is the leftmost four bytes of its register, so each register
     is listed as its short view and then as the whole register); further arguments start at 160(r15). r2 or f0 returns the value, r14
     holds the return address and r15 is the stack pointer. The caller owns a
     160-byte register save area at 0(r15), which the callee fills from its own
     prologue, so those bytes are part of the callee's locals. r6..r13, r15 and
     f8..f15 are preserved across a call.
-->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0"/>
     <machine_alignment value="2"/>
     <default_alignment value="1"/>
     <default_pointer_alignment value="8"/>
     <pointer_size value="8"/>
     <wchar_size value="4"/>
     <short_size value="2"/>
     <integer_size value="4"/>
     <long_size value="8"/>
     <long_long_size value="8"/>
     <float_size value="4"/>
     <double_size value="8"/>
     <long_double_size value="16"/>
     <size_alignment_map>
          <entry size="1" alignment="1"/>
          <entry size="2" alignment="2"/>
          <entry size="4" alignment="4"/>
          <entry size="8" alignment="8"/>
          <entry size="16" alignment="8"/>
     </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="r15" space="ram"/>
  <funcptr align="2"/>
  <returnaddress>
    <register name="r14"/>
  </returnaddress>
  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="4" maxsize="4" metatype="float">
          <register name="f0s"/>
        </pentry>
        <pentry minsize="8" maxsize="8" metatype="float">
          <register name="f0"/>
        </pentry>
        <pentry minsize="4" maxsize="4" metatype="float">
          <register name="f2s"/>
        </pentry>
        <pentry minsize="8" maxsize="8" metatype="float">
          <register name="f2"/>
        </pentry>
        <pentry minsize="4" maxsize="4" metatype="float">
          <register name="f4s"/>
        </pentry>
        <pentry minsize="8" maxsize="8" metatype="float">
          <register name="f4"/>
        </pentry>
        <pentry minsize="4" maxsize="4" metatype="float">
          <register name="f6s"/>
        </pentry>
        <pentry minsize="8" maxsize="8" metatype="float">
          <register name="f6"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="inttype">
          <register name="r2"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="inttype">
          <register name="r3"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="inttype">
          <register name="r4"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="inttype">
          <register name="r5"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="inttype">
          <register name="r6"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="8">
          <addr offset="160" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="4" maxsize="4" metatype="float">
          <register name="f0s"/>
        </pentry>
        <pentry minsize="8" maxsize="8" metatype="float">
          <register name="f0"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="inttype">
          <register name="r2"/>
        </pentry>
      </output>
      <unaffected>
        <register name="r6"/>
        <register name="r7"/>
        <register name="r8"/>
        <register name="r9"/>
        <register name="r10"/>
        <register name="r11"/>
        <register name="r12"/>
        <register name="r13"/>
        <register name="r15"/>
        <register name="f8"/>
        <register name="f9"/>
        <register name="f10"/>
        <register name="f11"/>
        <register name="f12"/>
        <register name="f13"/>
        <register name="f14"/>
        <register name="f15"/>
      </unaffected>
      <killedbycall>
        <register name="r0"/>
        <register name="r1"/>
        <register name="r2"/>
        <register name="r3"/>
        <register name="r4"/>
        <register name="r5"/>
        <register name="r14"/>
        <register name="f0"/>
        <register name="f1"/>
        <register name="f2"/>
        <register name="f3"/>
        <register name="f4"/>
        <register name="f5"/>
        <register name="f6"/>
        <register name="f7"/>
        <register name="CC0"/>
        <register name="CC1"/>
        <register name="CC2"/>
        <register name="CC3"/>
        <register name="CCA"/>
        <register name="CCB"/>
      </killedbycall>
      <localrange>
        <range space="stack" first="0xfffffffffff0bdc1" last="0xffffffffffffffff"/>
        <range space="stack" first="0" last="159"/>
      </localrange>
    </prototype>
  </default_proto>
</compiler_spec>
