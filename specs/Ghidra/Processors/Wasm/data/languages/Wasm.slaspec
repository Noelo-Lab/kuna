:i64.extend16_s is op=0x00c3; S1_8; lo; hi { local v:2 = S1_8:2; S1_8 = sext(v); }
:i64.extend32_s is op=0x00c4; S1_8; lo; hi { local v:4 = S1_8:4; S1_8 = sext(v); }
:i32.trunc_sat_f32_s is op=0xfc00; S1_4; lo; hi { S1_4 = trunc(S1_4); }
:i32.trunc_sat_f32_u is op=0xfc01; S1_4; lo; hi { local v:8 = trunc(S1_4); S1_4 = v:4; }
:i32.trunc_sat_f64_s is op=0xfc02; S1_4 & S1_8; lo; hi { local v:4 = trunc(S1_8); S1_4 = v; }
:i32.trunc_sat_f64_u is op=0xfc03; S1_4 & S1_8; lo; hi { local v:8 = trunc(S1_8); S1_4 = v:4; }
:i64.trunc_sat_f32_s is op=0xfc04; S1_4 & S1_8; lo; hi { local v:8 = trunc(S1_4); S1_8 = v; }
:i64.trunc_sat_f32_u is op=0xfc05; S1_4 & S1_8; lo; hi { local v:8 = trunc(S1_4); S1_8 = v; }
:i64.trunc_sat_f64_s is op=0xfc06; S1_8; lo; hi { S1_8 = trunc(S1_8); }
:i64.trunc_sat_f64_u is op=0xfc07; S1_8; lo; hi { S1_8 = trunc(S1_8); }
:memory.copy is op=0xfc0a; S1_4 & S2_4 & S3_4; lo; hi { memory_copy(S3_4, S2_4, S1_4); }
:memory.fill is op=0xfc0b; S1_4 & S2_4 & S3_4; lo; hi { memory_fill(S3_4, S2_4, S1_4); }

# Records the lowering adds; they have no wasm opcode.
:param lo, hi is op=0xff00 & ty=0; h; L_4 & lo; A_4 & hi { L_4 = A_4; }
:zero lo is op=0xff01 & ty=0; h; L_4 & lo; hi { L_4 = 0; }
:arg hi is op=0xff02 & ty=0; T_4; lo; A_4 & hi { A_4 = T_4; }
:result hi is op=0xff03 & ty=0; T_4; lo; RI & hi { T_4 = RI; }
:retval hi is op=0xff04 & ty=0; T_4; lo; RI & hi { RI = T_4; }
:move is op=0xff05 & ty=0; T_4; X_4; hi { X_4 = T_4; }
:param lo, hi is op=0xff00 & ty=1; h; L_8 & lo; A_8 & hi { L_8 = A_8; }
:zero lo is op=0xff01 & ty=1; h; L_8 & lo; hi { L_8 = 0; }
:arg hi is op=0xff02 & ty=1; T_8; lo; A_8 & hi { A_8 = T_8; }
:result hi is op=0xff03 & ty=1; T_8; lo; RL & hi { T_8 = RL; }
:retval hi is op=0xff04 & ty=1; T_8; lo; RL & hi { RL = T_8; }
:move is op=0xff05 & ty=1; T_8; X_8; hi { X_8 = T_8; }
:param lo, hi is op=0xff00 & ty=2; h; L_4 & lo; A_4 & hi { L_4 = A_4; }
:zero lo is op=0xff01 & ty=2; h; L_4 & lo; hi { L_4 = 0; }
:arg hi is op=0xff02 & ty=2; T_4; lo; A_4 & hi { A_4 = T_4; }
:result hi is op=0xff03 & ty=2; T_4; lo; RF & hi { T_4 = RF; }
:retval hi is op=0xff04 & ty=2; T_4; lo; RF & hi { RF = T_4; }
:move is op=0xff05 & ty=2; T_4; X_4; hi { X_4 = T_4; }
:param lo, hi is op=0xff00 & ty=3; h; L_8 & lo; A_8 & hi { L_8 = A_8; }
:zero lo is op=0xff01 & ty=3; h; L_8 & lo; hi { L_8 = 0; }
:arg hi is op=0xff02 & ty=3; T_8; lo; A_8 & hi { A_8 = T_8; }
:result hi is op=0xff03 & ty=3; T_8; lo; RD & hi { T_8 = RD; }
:retval hi is op=0xff04 & ty=3; T_8; lo; RD & hi { RD = T_8; }
:move is op=0xff05 & ty=3; T_8; X_8; hi { X_8 = T_8; }
:br_unless dest is op=0xff06; S1_4; dest; hi { if (S1_4 == 0) goto dest; }
:br_table.default dest is op=0xff07; S1_4; dest; hi { if (S1_4 >= hi) goto dest; }
:br_table lo is op=0xff08; S1_4; lo; hi { local t:4 = *[ram]:4 (lo + S1_4 * 4); goto [t]; }
:unsupported is op=0xff09; h; lo; hi { unsupported(); local ra:4 = 0; return [ra]; }
