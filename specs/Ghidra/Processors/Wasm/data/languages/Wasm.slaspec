define pcodeop trap;
define pcodeop unsupported;
define pcodeop memory_size;
define pcodeop memory_grow;
define pcodeop memory_copy;
define pcodeop memory_fill;
define pcodeop ctz;
define pcodeop rotl;
define pcodeop rotr;
define pcodeop FLOAT_TRUNC;
define pcodeop FLOAT_ROUNDEVEN;
define pcodeop fmin;
define pcodeop fmax;
define pcodeop fcopysign;

define token w0 (32)
  op = (0,15)
  ty = (16,23)
;
define token w1 (32)
  h = (0,31)
;
define token w2 (32)
  lo = (0,31)
  slo = (0,31) signed
;
define token w3 (32)
  hi = (0,31)
;

# Operand slots by stack height: T is the slot a push fills, S1 the top of the
# stack, S2 and S3 the ones under it. X is a slot named by `lo`. L is a local,
# G a global (memory), A an argument register, each in a 4- and an 8-byte view.
T_4: o is h [ o = $(SLOT) + h * 16; ] { export *[register]:4 o; }
S1_4: o is h [ o = $(SLOT) + (h - 1) * 16; ] { export *[register]:4 o; }
S2_4: o is h [ o = $(SLOT) + (h - 2) * 16; ] { export *[register]:4 o; }
S3_4: o is h [ o = $(SLOT) + (h - 3) * 16; ] { export *[register]:4 o; }
X_4: o is lo [ o = $(SLOT) + lo * 16; ] { export *[register]:4 o; }
L_4: o is lo [ o = $(LOCAL) + lo * 16; ] { export *[register]:4 o; }
G_4: o is lo [ o = $(GLOBAL) + lo * 16; ] { export *[ram]:4 o; }
A_4: o is hi [ o = $(ARG) + hi * 16; ] { export *[register]:4 o; }
T_8: o is h [ o = $(SLOT) + h * 16; ] { export *[register]:8 o; }
S1_8: o is h [ o = $(SLOT) + (h - 1) * 16; ] { export *[register]:8 o; }
S2_8: o is h [ o = $(SLOT) + (h - 2) * 16; ] { export *[register]:8 o; }
S3_8: o is h [ o = $(SLOT) + (h - 3) * 16; ] { export *[register]:8 o; }
X_8: o is lo [ o = $(SLOT) + lo * 16; ] { export *[register]:8 o; }
L_8: o is lo [ o = $(LOCAL) + lo * 16; ] { export *[register]:8 o; }
G_8: o is lo [ o = $(GLOBAL) + lo * 16; ] { export *[ram]:8 o; }
A_8: o is hi [ o = $(ARG) + hi * 16; ] { export *[register]:8 o; }

# The result register of each value type.
RI: o is hi [ o = $(RES) + hi * 64; ] { export *[register]:4 o; }
RL: o is hi [ o = $(RES) + hi * 64 + 16; ] { export *[register]:8 o; }
RF: o is hi [ o = $(RES) + hi * 64 + 32; ] { export *[register]:4 o; }
RD: o is hi [ o = $(RES) + hi * 64 + 48; ] { export *[register]:8 o; }

dest: lo is lo { export *[ram]:4 lo; }
imm32: slo is slo { export *[const]:4 slo; }
imm64: v is lo; hi [ v = (hi << 32) | lo; ] { export *[const]:8 v; }

# Control, locals and globals. `ty` selects the width where the opcode does not.
:unreachable is op=0x0000; h; lo; hi { trap(); goto inst_start; }
:br dest is op=0x000c; h; dest; hi { goto dest; }
:br_if dest is op=0x000d; S1_4; dest; hi { if (S1_4 != 0) goto dest; }
:return is op=0x000f; h; lo; hi { local ra:4 = 0; return [ra]; }
:call dest is op=0x0010; h; dest; hi { call dest; }
:call_indirect lo is op=0x0011; S1_4; lo; hi { local t:4 = *[ram]:4 (lo + S1_4 * 4); call [t]; }
:select is op=0x001b & ty=0; S1_4 & S2_4 & S3_4; lo; hi { if (S1_4 != 0) goto <keep>; S3_4 = S2_4; <keep> }
:local.get lo is op=0x0020 & ty=0; T_4; L_4 & lo; hi { T_4 = L_4; }
:local.set lo is op=0x0021 & ty=0; S1_4; L_4 & lo; hi { L_4 = S1_4; }
:local.tee lo is op=0x0022 & ty=0; S1_4; L_4 & lo; hi { L_4 = S1_4; }
:global.get lo is op=0x0023 & ty=0; T_4; G_4 & lo; hi { T_4 = G_4; }
:global.set lo is op=0x0024 & ty=0; S1_4; G_4 & lo; hi { G_4 = S1_4; }
:select is op=0x001b & ty=1; S1_4 & S2_8 & S3_8; lo; hi { if (S1_4 != 0) goto <keep>; S3_8 = S2_8; <keep> }
:local.get lo is op=0x0020 & ty=1; T_8; L_8 & lo; hi { T_8 = L_8; }
:local.set lo is op=0x0021 & ty=1; S1_8; L_8 & lo; hi { L_8 = S1_8; }
:local.tee lo is op=0x0022 & ty=1; S1_8; L_8 & lo; hi { L_8 = S1_8; }
:global.get lo is op=0x0023 & ty=1; T_8; G_8 & lo; hi { T_8 = G_8; }
:global.set lo is op=0x0024 & ty=1; S1_8; G_8 & lo; hi { G_8 = S1_8; }
:select is op=0x001b & ty=2; S1_4 & S2_4 & S3_4; lo; hi { if (S1_4 != 0) goto <keep>; S3_4 = S2_4; <keep> }
:local.get lo is op=0x0020 & ty=2; T_4; L_4 & lo; hi { T_4 = L_4; }
:local.set lo is op=0x0021 & ty=2; S1_4; L_4 & lo; hi { L_4 = S1_4; }
:local.tee lo is op=0x0022 & ty=2; S1_4; L_4 & lo; hi { L_4 = S1_4; }
:global.get lo is op=0x0023 & ty=2; T_4; G_4 & lo; hi { T_4 = G_4; }
:global.set lo is op=0x0024 & ty=2; S1_4; G_4 & lo; hi { G_4 = S1_4; }
:select is op=0x001b & ty=3; S1_4 & S2_8 & S3_8; lo; hi { if (S1_4 != 0) goto <keep>; S3_8 = S2_8; <keep> }
