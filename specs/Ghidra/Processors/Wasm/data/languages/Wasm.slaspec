# WebAssembly, as the loader lowers it: one fixed 16-byte record per operation,
# holding the wasm opcode, the operand-stack height it runs at, and its
# immediates with branch and call targets already resolved to addresses.
# The operand stack and the locals are register slots, so no stack pointer moves.
# Record layout and the lowering: decompiler/crates/kuna-analysis/src/loader/kuna_wasmlower.rs

define endian=little;
define alignment=1;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x0  size=4 [ sp ];
define register offset=0x8  size=4 [ pc ];

@define RES   "0x1000"
@define ARG   "0x100000"
@define LOCAL "0x10000000"
@define SLOT  "0x40000000"
@define GLOBAL "0xd0000000"

# Every operand-stack slot, local and argument is a 16-byte register; an i32 or
# f32 is its low 4 bytes, an i64 or f64 its low 8. A result has one register per
# value type, so a result of one type never reads as the stale half of another.
# The lowering refuses a body that needs more of any kind than is named here,
# and so a function type with more than one result.
define register offset=$(RES) size=16 [ ri0 rl0 rf0 rd0 ];
define register offset=$(ARG) size=16 [
