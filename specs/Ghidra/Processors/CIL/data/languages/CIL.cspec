          <register name="a14"/>
        </pentry>
        <pentry minsize="1" maxsize="8">
          <register name="a15"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="8">
          <addr offset="8" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="8">
          <register name="rv"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="a0"/>
