:cmp_s sb, sU7 is maj=0x1c & sbit7=1 & sb & sU7 { local x:4 = sb; local y:4 = sU7; local r:4 = x - y; flagsSub(x, y); flagsZN(r); }
:breq_s sb, 0, sRel8 is maj=0x1d & sbit7=0 & sb & sRel8 { if (sb == 0) goto sRel8; }
:brne_s sb, 0, sRel8 is maj=0x1d & sbit7=1 & sb & sRel8 { if (sb != 0) goto sRel8; }

:b_s sRel10 is maj=0x1e & sbrop=0 & sRel10 { goto sRel10; }
:beq_s sRel10 is maj=0x1e & sbrop=1 & sRel10 { if (Z) goto sRel10; }
:bne_s sRel10 is maj=0x1e & sbrop=2 & sRel10 { if (!Z) goto sRel10; }
:bgt_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=0 & sRel7 { if ((N == V) && !Z) goto sRel7; }
:bge_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=1 & sRel7 { if (N == V) goto sRel7; }
:blt_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=2 & sRel7 { if (N != V) goto sRel7; }
:ble_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=3 & sRel7 { if (Z || (N != V)) goto sRel7; }
:bhi_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=4 & sRel7 { if (!C && !Z) goto sRel7; }
:bhs_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=5 & sRel7 { if (!C) goto sRel7; }
:blo_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=6 & sRel7 { if (C) goto sRel7; }
:bls_s sRel7 is maj=0x1e & sbrop=3 & sbrcc=7 & sRel7 { if (C || Z) goto sRel7; }
:bl_s sRel13 is maj=0x1f & sRel13 { blink = inst_next; call sRel13; }

} # with : phase=1

# ---- zero-overhead loop end ----

lpBack: addr is lpstart [ addr = lpstart + 0; ] { export *[ram]:4 addr; }

:^instruction  is phase=0 & lpend=0 & instruction [ phase = 1; ] { build instruction; }
:^instruction  is phase=0 & lpend=1 & lpBack & instruction [ phase = 1; ]
{
  lp_count = lp_count - 1;
  if (lp_count != 0) goto lpBack;
  build instruction;
}
