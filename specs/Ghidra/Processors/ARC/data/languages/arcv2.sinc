enterRegs: "r13-r24" is su4=12 & linkOff { local base:4 = sp + linkOff; *:4 (base + 0) = r13; *:4 (base + 4) = r14; *:4 (base + 8) = r15; *:4 (base + 12) = r16; *:4 (base + 16) = r17; *:4 (base + 20) = r18; *:4 (base + 24) = r19; *:4 (base + 28) = r20; *:4 (base + 32) = r21; *:4 (base + 36) = r22; *:4 (base + 40) = r23; *:4 (base + 44) = r24; local e:4 = base + 48; export e; }
