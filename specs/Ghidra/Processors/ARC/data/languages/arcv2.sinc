enterSize: v is su4 & sfp & slink [ v = (su4 + sfp + slink) << 2; ] { export *[const]:4 v; }

:enter_s "{"^enterRegs enterLink^"}" is maj=0x18 & sU=0 & sop3=7 & sbit0=0 & sfp=0 & enterRegs & enterLink & enterSize { sp = sp - enterSize; build enterLink; build enterRegs; }
:enter_s "{"^enterRegs "fp" enterLink^"}" is maj=0x18 & sU=0 & sop3=7 & sbit0=0 & sfp=1 & enterRegs & enterLink & enterSize { sp = sp - enterSize; build enterLink; build enterRegs; *:4 enterRegs = fp; fp = sp; }
:leave_s "{"^leaveRegs leaveLink^"}" is maj=0x18 & sjmp=0 & sop3=6 & sbit0=0 & sfp=0 & leaveRegs & leaveLink & enterSize { build leaveLink; build leaveRegs; sp = sp + enterSize; }
:leave_s "{"^leaveRegs "fp" leaveLink^"}" is maj=0x18 & sjmp=0 & sop3=6 & sbit0=0 & sfp=1 & leaveRegs & leaveLink & enterSize { sp = fp; build leaveLink; build leaveRegs; fp = *:4 leaveRegs; sp = sp + enterSize; }
:leave_s "{"^leaveRegs leaveLink "pcl}" is maj=0x18 & sjmp=1 & sop3=6 & sbit0=0 & sfp=0 & leaveRegs & leaveLink & enterSize { build leaveLink; build leaveRegs; sp = sp + enterSize; return [blink]; }
:leave_s "{"^leaveRegs "fp" leaveLink "pcl}" is maj=0x18 & sjmp=1 & sop3=6 & sbit0=0 & sfp=1 & leaveRegs & leaveLink & enterSize { sp = fp; build leaveLink; build leaveRegs; fp = *:4 leaveRegs; sp = sp + enterSize; return [blink]; }

:ld_s "r0", ["gp", sS9x4] is maj=0x19 & sgpop=0 & sS9x4 { local ea:4 = gp + sS9x4; r0 = *:4 ea; }
:ldb_s "r0", ["gp", sS9] is maj=0x19 & sgpop=1 & sS9 { local ea:4 = gp + sS9; local t:1 = *:1 ea; r0 = zext(t); }
:ldh_s "r0", ["gp", sS9x2] is maj=0x19 & sgpop=2 & sS9x2 { local ea:4 = gp + sS9x2; local t:2 = *:2 ea; r0 = zext(t); }
