Wm1: is rt_w1 & RSsrc ; wm_dir=0 & wm_count>1 & S9 { rt_w1 = *:4 (RSsrc + S9 + 4); }
Wm1: is rt_w1 & RSsrc ; wm_dir=1 & wm_count=0 & S9 { *:4 (RSsrc + S9 + 4) = rt_w1; }
Wm1: is rt_w1 & RSsrc ; wm_dir=1 & wm_count>1 & S9 { *:4 (RSsrc + S9 + 4) = rt_w1; }
Wm1: is rt=0 & RSsrc ; wm_dir=1 & wm_count=0 & S9 { *:4 (RSsrc + S9 + 4) = 0:4; }
Wm1: is rt=0 & RSsrc ; wm_dir=1 & wm_count>1 & S9 { *:4 (RSsrc + S9 + 4) = 0:4; }
