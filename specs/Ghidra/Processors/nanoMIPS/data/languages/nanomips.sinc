WmCount: wm_count is wm_count { }
WmCount: "8" is wm_count=0 { }
WmAll: is Wm0 & Wm1 & Wm2 & Wm3 & Wm4 & Wm5 & Wm6 & Wm7 { }

:lwm rt, S9(RSsrc), WmCount is (op=0x29 & rt & RSsrc ; ls9t=4 & wm_dir=0 & S9 & WmCount) & WmAll { }
:swm rt, S9(RSsrc), WmCount is (op=0x29 & rt & RSsrc ; ls9t=4 & wm_dir=1 & S9 & WmCount) & WmAll { }
:ualwm rt, S9(RSsrc), WmCount is (op=0x29 & rt & RSsrc ; ls9t=5 & wm_dir=0 & S9 & WmCount) & WmAll { }
:uaswm rt, S9(RSsrc), WmCount is (op=0x29 & rt & RSsrc ; ls9t=5 & wm_dir=1 & S9 & WmCount) & WmAll { }

# Compare-and-branch
:beqc RSsrc, RTsrc, Rel14 is op=0x22 & RTsrc & RSsrc ; brf=0 & Rel14 { if (RSsrc == RTsrc) goto Rel14; }
:beqzc RSsrc, Rel14 is op=0x22 & rtnum=0 & RSsrc ; brf=0 & Rel14 { if (RSsrc == 0) goto Rel14; }
:beqzc RTsrc, Rel14 is op=0x22 & RTsrc & rsnum=0 ; brf=0 & Rel14 { if (RTsrc == 0) goto Rel14; }
:bgezc RSsrc, Rel14 is op=0x22 & rtnum=0 & RSsrc ; brf=2 & Rel14 { if (RSsrc s>= 0) goto Rel14; }
:blezc RTsrc, Rel14 is op=0x22 & RTsrc & rsnum=0 ; brf=2 & Rel14 { if (RTsrc s<= 0) goto Rel14; }
:bgec RSsrc, RTsrc, Rel14 is op=0x22 & RTsrc & RSsrc ; brf=2 & Rel14 { if (RSsrc s>= RTsrc) goto Rel14; }
:bgeuc RSsrc, RTsrc, Rel14 is op=0x22 & RTsrc & RSsrc ; brf=3 & Rel14 { if (RSsrc >= RTsrc) goto Rel14; }
:bnec RSsrc, RTsrc, Rel14 is op=0x2a & RTsrc & RSsrc ; brf=0 & Rel14 { if (RSsrc != RTsrc) goto Rel14; }
:bnezc RSsrc, Rel14 is op=0x2a & rtnum=0 & RSsrc ; brf=0 & Rel14 { if (RSsrc != 0) goto Rel14; }
:bnezc RTsrc, Rel14 is op=0x2a & RTsrc & rsnum=0 ; brf=0 & Rel14 { if (RTsrc != 0) goto Rel14; }
:bltzc RSsrc, Rel14 is op=0x2a & rtnum=0 & RSsrc ; brf=2 & Rel14 { if (RSsrc s< 0) goto Rel14; }
:bgtzc RTsrc, Rel14 is op=0x2a & RTsrc & rsnum=0 ; brf=2 & Rel14 { if (RTsrc s> 0) goto Rel14; }
:bltc RSsrc, RTsrc, Rel14 is op=0x2a & RTsrc & RSsrc ; brf=2 & Rel14 { if (RSsrc s< RTsrc) goto Rel14; }
:bltuc RSsrc, RTsrc, Rel14 is op=0x2a & RTsrc & RSsrc ; brf=3 & Rel14 { if (RSsrc < RTsrc) goto Rel14; }

:beqic RTsrc, Bri7, Rel11 is (op=0x32 & RTsrc & b24=0) ... & Bri7 & (rt ; Rel11) { if (RTsrc == Bri7) goto Rel11; }
:bbeqzc RTsrc, Bit5, Rel11 is (op=0x32 & RTsrc & b24=1) ... & Bit5 & (rt ; Rel11) { if (((RTsrc >> Bit5) & 1) == 0) goto Rel11; }
:bgeic RTsrc, Bri7, Rel11 is (op=0x32 & RTsrc & b24=2) ... & Bri7 & (rt ; Rel11) { if (RTsrc s>= Bri7) goto Rel11; }
:bgeiuc RTsrc, Bri7, Rel11 is (op=0x32 & RTsrc & b24=3) ... & Bri7 & (rt ; Rel11) { if (RTsrc >= Bri7) goto Rel11; }
:bneic RTsrc, Bri7, Rel11 is (op=0x32 & RTsrc & b24=4) ... & Bri7 & (rt ; Rel11) { if (RTsrc != Bri7) goto Rel11; }
:bbnezc RTsrc, Bit5, Rel11 is (op=0x32 & RTsrc & b24=5) ... & Bit5 & (rt ; Rel11) { if (((RTsrc >> Bit5) & 1) != 0) goto Rel11; }
:bltic RTsrc, Bri7, Rel11 is (op=0x32 & RTsrc & b24=6) ... & Bri7 & (rt ; Rel11) { if (RTsrc s< Bri7) goto Rel11; }
:bltiuc RTsrc, Bri7, Rel11 is (op=0x32 & RTsrc & b24=7) ... & Bri7 & (rt ; Rel11) { if (RTsrc < Bri7) goto Rel11; }

# P.LUI
:lui RT, Lui is (op=0x38 & RT) ... & (rt ; c1=0) & Lui { RT = Lui; }
:aluipc RT, PcHi is (op=0x38 & RT) ... & (rt ; c1=1) & PcHi { RT = PcHi; }

# ---- 48-bit instructions ----

:li RT, Imm32 is op=0x18 & RT & b04=0x00 ; Imm32 { RT = Imm32; }
:addiu RT, RTsrc, Simm32 is op=0x18 & RT & RTsrc & b04=0x01 ; Simm32 { RT = RTsrc + Simm32; }
:addiu RT, gp, Simm32 is op=0x18 & RT & b04=0x02 & gp ; Simm32 { RT = gp + Simm32; }
:lapc RT, Pc32 is op=0x18 & RT & b04=0x03 ; Pc32 { RT = Pc32; }
:lwpc RT, Rel32 is op=0x18 & RT & b04=0x0b ; Rel32 { RT = Rel32; }
:swpc RTsrc, Rel32 is op=0x18 & RTsrc & b04=0x0f ; Rel32 { Rel32 = RTsrc; }
