:save Sr32U^Sr32 is (op=0x20 & b4=0 ; u12f=3 & sr_dir=0 & sr_jrc=0 & Sr32U) & Sr32 { sp = sp - Sr32U; }
:restore Sr32U^Sr32 is (op=0x20 & b4=0 ; u12f=3 & sr_dir=1 & sr_jrc=0 & Sr32U) & Sr32 { sp = sp + Sr32U; build Sr32; }
:restore.jrc Sr32U^Sr32 is (op=0x20 & b4=0 ; u12f=3 & sr_dir=1 & sr_jrc=1 & Sr32U) & Sr32 { sp = sp + Sr32U; build Sr32; return [ra]; }

# P.LS.U12
:lb  RT, u12(RSsrc) is op=0x21 & RT & RSsrc ; u12f=0x0 & u12 { RT = sext(*:1 (RSsrc + u12)); }
:sb  RTsrc, u12(RSsrc) is op=0x21 & RTsrc & RSsrc ; u12f=0x1 & u12 { *:1 (RSsrc + u12) = RTsrc:1; }
:lbu RT, u12(RSsrc) is op=0x21 & RT & RSsrc ; u12f=0x2 & u12 { RT = zext(*:1 (RSsrc + u12)); }
:pref rtnum, u12(RSsrc) is op=0x21 & rtnum & RSsrc ; u12f=0x3 & u12 { }
:synci u12(RSsrc) is op=0x21 & rtnum=31 & RSsrc ; u12f=0x3 & u12 { }
:lh  RT, u12(RSsrc) is op=0x21 & RT & RSsrc ; u12f=0x4 & u12 { RT = sext(*:2 (RSsrc + u12)); }
:sh  RTsrc, u12(RSsrc) is op=0x21 & RTsrc & RSsrc ; u12f=0x5 & u12 { *:2 (RSsrc + u12) = RTsrc:2; }
:lhu RT, u12(RSsrc) is op=0x21 & RT & RSsrc ; u12f=0x6 & u12 { RT = zext(*:2 (RSsrc + u12)); }
:lw  RT, u12(RSsrc) is op=0x21 & RT & RSsrc ; u12f=0x8 & u12 { RT = *:4 (RSsrc + u12); }
:sw  RTsrc, u12(RSsrc) is op=0x21 & RTsrc & RSsrc ; u12f=0x9 & u12 { *:4 (RSsrc + u12) = RTsrc; }

# P.LS.S9: 9-bit signed offsets, the unaligned and atomic accesses, and the EVA forms
:lb  RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=0 & ls9f=0x0 & S9 { RT = sext(*:1 (RSsrc + S9)); }
:sb  RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=0 & ls9f=0x1 & S9 { *:1 (RSsrc + S9) = RTsrc:1; }
:lbu RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=0 & ls9f=0x2 & S9 { RT = zext(*:1 (RSsrc + S9)); }
:pref rtnum, S9(RSsrc) is op=0x29 & rtnum & RSsrc ; ls9t=0 & ls9f=0x3 & S9 { }
:synci S9(RSsrc) is op=0x29 & rtnum=31 & RSsrc ; ls9t=0 & ls9f=0x3 & S9 { }
:lh  RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=0 & ls9f=0x4 & S9 { RT = sext(*:2 (RSsrc + S9)); }
:sh  RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=0 & ls9f=0x5 & S9 { *:2 (RSsrc + S9) = RTsrc:2; }
:lhu RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=0 & ls9f=0x6 & S9 { RT = zext(*:2 (RSsrc + S9)); }
:lw  RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=0 & ls9f=0x8 & S9 { RT = *:4 (RSsrc + S9); }
:sw  RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=0 & ls9f=0x9 & S9 { *:4 (RSsrc + S9) = RTsrc; }

:aset asetbit, S9(RSsrc) is op=0x29 & b8=0 & b9=0 & asetbit & RSsrc ; ls9t=1 & ls9f=0x2 & S9 {
  local address:4 = RSsrc + S9;
  *:1 address = *:1 address | (1:1 << asetbit);
}
:aclr asetbit, S9(RSsrc) is op=0x29 & b8=0 & b9=1 & asetbit & RSsrc ; ls9t=1 & ls9f=0x2 & S9 {
  local address:4 = RSsrc + S9;
  *:1 address = *:1 address & ~(1:1 << asetbit);
}
:ualh RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=1 & ls9f=0x4 & S9 { RT = sext(*:2 (RSsrc + S9)); }
:uash RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=1 & ls9f=0x5 & S9 { *:2 (RSsrc + S9) = RTsrc:2; }
:cache rtnum, S9(RSsrc) is op=0x29 & rtnum & RSsrc ; ls9t=1 & ls9f=0x7 & S9 { cacheOp(rtnum:1, RSsrc + S9); }
:ll RT, S9w(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=1 & ls9f=0xa & f2=0 & S9w { local address:4 = RSsrc + S9w; lockLoad(address); RT = *:4 address; }
:sc RT, S9w(RSsrc) is op=0x29 & RT & RTsrc & RSsrc ; ls9t=1 & ls9f=0xb & f2=0 & S9w { local address:4 = RSsrc + S9w; *:4 address = RTsrc; RT = lockStore(address); }
:llwp RT, RU, (RSsrc) is op=0x29 & RT & RSsrc ; ls9t=1 & ls9f=0xa & f2=1 & RU {
  local address:4 = RSsrc;
  lockLoad(address);
@if ENDIAN == "big"
  RU = *:4 address;
  RT = *:4 (address + 4);
@else
  RT = *:4 address;
  RU = *:4 (address + 4);
@endif
}
:scwp RT, RUsrc, (RSsrc) is op=0x29 & RT & RTsrc & RSsrc ; ls9t=1 & ls9f=0xb & f2=1 & RUsrc {
  local address:4 = RSsrc;
@if ENDIAN == "big"
  *:4 address = RUsrc;
  *:4 (address + 4) = RTsrc;
@else
  *:4 address = RTsrc;
  *:4 (address + 4) = RUsrc;
@endif
  RT = lockStore(address);
}

:lbe  RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=2 & ls9f=0x0 & S9 { RT = sext(*:1 (RSsrc + S9)); }
:sbe  RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=2 & ls9f=0x1 & S9 { *:1 (RSsrc + S9) = RTsrc:1; }
:lbue RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=2 & ls9f=0x2 & S9 { RT = zext(*:1 (RSsrc + S9)); }
:prefe rtnum, S9(RSsrc) is op=0x29 & rtnum & RSsrc ; ls9t=2 & ls9f=0x3 & S9 { }
:syncie S9(RSsrc) is op=0x29 & rtnum=31 & RSsrc ; ls9t=2 & ls9f=0x3 & S9 { }
:lhe  RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=2 & ls9f=0x4 & S9 { RT = sext(*:2 (RSsrc + S9)); }
:she  RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=2 & ls9f=0x5 & S9 { *:2 (RSsrc + S9) = RTsrc:2; }
:lhue RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=2 & ls9f=0x6 & S9 { RT = zext(*:2 (RSsrc + S9)); }
:cachee rtnum, S9(RSsrc) is op=0x29 & rtnum & RSsrc ; ls9t=2 & ls9f=0x7 & S9 { cacheOp(rtnum:1, RSsrc + S9); }
:lwe  RT, S9(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=2 & ls9f=0x8 & S9 { RT = *:4 (RSsrc + S9); }
:swe  RTsrc, S9(RSsrc) is op=0x29 & RTsrc & RSsrc ; ls9t=2 & ls9f=0x9 & S9 { *:4 (RSsrc + S9) = RTsrc; }
:lle RT, S9w(RSsrc) is op=0x29 & RT & RSsrc ; ls9t=2 & ls9f=0xa & f2=0 & S9w { local address:4 = RSsrc + S9w; lockLoad(address); RT = *:4 address; }
:sce RT, S9w(RSsrc) is op=0x29 & RT & RTsrc & RSsrc ; ls9t=2 & ls9f=0xb & f2=0 & S9w { local address:4 = RSsrc + S9w; *:4 address = RTsrc; RT = lockStore(address); }

# LWM, SWM and their unaligned forms. Slot i of the register run is the word at offset + 4*i.

Wm0: is rt_w0 & RSsrc ; wm_dir=0 & S9 { rt_w0 = *:4 (RSsrc + S9 + 0); }
Wm0: is rt_w0 & RSsrc ; wm_dir=1 & S9 { *:4 (RSsrc + S9 + 0) = rt_w0; }
Wm0: is rt=0 & RSsrc ; wm_dir=1 & S9 { *:4 (RSsrc + S9 + 0) = 0:4; }
Wm1: is rt ; wm_count>0 & wm_count<2 { }
