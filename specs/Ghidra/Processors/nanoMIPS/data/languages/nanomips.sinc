Wm3: is rt_w3 & RSsrc ; wm_dir=1 & wm_count=0 & S9 { *:4 (RSsrc + S9 + 12) = rt_w3; }
Wm3: is rt_w3 & RSsrc ; wm_dir=1 & wm_count>3 & S9 { *:4 (RSsrc + S9 + 12) = rt_w3; }
Wm3: is rt=0 & RSsrc ; wm_dir=1 & wm_count=0 & S9 { *:4 (RSsrc + S9 + 12) = 0:4; }
Wm3: is rt=0 & RSsrc ; wm_dir=1 & wm_count>3 & S9 { *:4 (RSsrc + S9 + 12) = 0:4; }
Wm4: is rt ; wm_count>0 & wm_count<5 { }
Wm4: is rt_w4 & RSsrc ; wm_dir=0 & wm_count=0 & S9 { rt_w4 = *:4 (RSsrc + S9 + 16); }
Wm4: is rt_w4 & RSsrc ; wm_dir=0 & wm_count>4 & S9 { rt_w4 = *:4 (RSsrc + S9 + 16); }
Wm4: is rt_w4 & RSsrc ; wm_dir=1 & wm_count=0 & S9 { *:4 (RSsrc + S9 + 16) = rt_w4; }
Wm4: is rt_w4 & RSsrc ; wm_dir=1 & wm_count>4 & S9 { *:4 (RSsrc + S9 + 16) = rt_w4; }
Wm4: is rt=0 & RSsrc ; wm_dir=1 & wm_count=0 & S9 { *:4 (RSsrc + S9 + 16) = 0:4; }
Wm4: is rt=0 & RSsrc ; wm_dir=1 & wm_count>4 & S9 { *:4 (RSsrc + S9 + 16) = 0:4; }
Wm5: is rt ; wm_count>0 & wm_count<6 { }
Wm5: is rt_w5 & RSsrc ; wm_dir=0 & wm_count=0 & S9 { rt_w5 = *:4 (RSsrc + S9 + 20); }
