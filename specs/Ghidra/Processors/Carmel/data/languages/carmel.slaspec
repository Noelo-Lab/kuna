# Address processing may run with a false result predicate. LINK samples
# the old frame word, updates its register and SP, then gates the DATA store.
macro frame_store(address, saved) {
    *[data]:2 address = saved;
    if (((saved & 0xfc00) == 0) || ((ECFG & 0x10) == 0)) goto <frame_store_done>;
    EST = EST | 0x4000;
  <frame_store_done>
}

macro compact_frame_link(frame_reg, delta) {
    local small:1 = delta;
    local old_sp:2 = SP;
    local saved:2 = frame_reg;
    frame_reg = old_sp - 1;
    SP = old_sp + sext(small);
    frame_store(old_sp, saved);
    publish_alu_ce(EST & 0xcfff);
}

macro compact_frame_leave(frame_reg, qualified) {
    local first:2;
    local second:2;
    unary_ce(CECFG1, EST, CETBL, 0, first);
    unary_ce(CECFG2, EST, CETBL, 1, second);
    if (qualified != 0 && first == 0 && (CECFG1 & 0x1000) == 0) goto <publish>;
    local address:2 = frame_reg + 1;
    SP = address;
    frame_reg = *[data]:2 address;
  <publish>
    EST = (EST & 0xcfff) | (first << 12) | (second << 13);
}

