macro cliw_alu_limit32(value, limited) {
    limited = 0x7fffffff;
    if (value < 0x8000000000) goto <cliw_alu_limit_done>;
    limited = 0xff80000000;
    <cliw_alu_limit_done>
}
macro cliw_alu_finish(value, carry_out, overflow, config, word, result, flags) {
    cliw_alu_status(value, flags);
