# Address qualification enables the configuration ports. Static destinations
# sample the pre-writeback feedback before either CE latch is replaced.
ce_config_value: config is ce_config_bits_0 & ce_config_bits_6 [ config = ce_config_bits_0 | (ce_config_bits_6 << 6); ] { export *[const]:2 config; }
ce_truth_value: ce_truth_bits is ce_truth_bits { export *[const]:2 ce_truth_bits; }

macro load_ce_ports(prefix, config, truth, low, high, invert) {
    local incoming:2 = EST;
    local new_config:2 = config;
    local table_byte:2 = truth;
    local first_config:2 = CECFG1;
    local second_config:2 = CECFG2;
    local result_enabled:2;
    local address_enabled:2;
    local write_lo:1 = low;
    local write_hi:1 = high;
    local invert_hi:2 = invert;
    wide_issue_enable(prefix, result_enabled, address_enabled);
    if (address_enabled == 0) goto <feedback>;
    if (write_lo == 0) goto <write_upper>;
    CECFG1 = new_config;
    CETBL = (CETBL & 0xff00) | table_byte;
    first_config = new_config & 0x1fff;
  <write_upper>
    if (write_hi == 0) goto <feedback>;
    CECFG2 = new_config;
    CETBL = (CETBL & 0x00ff) | ((table_byte ^ invert_hi) << 8);
    second_config = new_config & 0x1fff;
  <feedback>
    local first:2;
    local second:2;
    unary_ce(first_config, incoming, CETBL, 0:2, first);
    unary_ce(second_config, incoming, CETBL, 1:2, second);
    EST = (incoming & 0xcfff) | (first << 12) | (second << 13);
}

@define WIDE_LOADCE "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1 & wide_13_22=0x26f & wide_ce_prefix & ce_config_value & ce_truth_value"
:LOADCE1 wide_ce_prefix ce_config_value,ce_truth_value is $(WIDE_LOADCE) & wide_9_10=0 {
    build wide_ce_prefix;
    load_ce_ports(wide_ce_prefix, ce_config_value, ce_truth_value, 1:1, 0:1, 0:2);
}
:LOADCE2 wide_ce_prefix ce_config_value,ce_truth_value is $(WIDE_LOADCE) & wide_9_10=1 {
    build wide_ce_prefix;
    load_ce_ports(wide_ce_prefix, ce_config_value, ce_truth_value, 0:1, 1:1, 0:2);
}
:LOADCE wide_ce_prefix ce_config_value,ce_truth_value is $(WIDE_LOADCE) & wide_9_10=2 {
    build wide_ce_prefix;
    load_ce_ports(wide_ce_prefix, ce_config_value, ce_truth_value, 1:1, 1:1, 0:2);
}
:"LOADCE.NOT" wide_ce_prefix ce_config_value,ce_truth_value is $(WIDE_LOADCE) & wide_9_10=3 {
    build wide_ce_prefix;
    load_ce_ports(wide_ce_prefix, ce_config_value, ce_truth_value, 1:1, 1:1, 0xff:2);
}

# LOAD's fixed word/long stride uses the old mode field, not the
# newly programmed PACFG field. No RN or reversal port feeds this increment.
macro wide_load_next(base, mode, modulo, limit, stride, next) {
    next = base + stride;
    if (mode < 2) goto <wide_load_next_done>;
    local size:4 = zext(modulo & 0xfff) + 1;
    local lower:4 = zext(limit) * zext(mode == 3);
    local upper:4 = lower + size;
    if (upper <= 0x10000 && lower <= zext(next) && zext(next) < upper) goto <wide_load_next_done>;
    next = next - size:2;
  <wide_load_next_done>
}

macro wide_load_flags(zero, negative, extended, limit) {
    local flags:2 = (zext(zero) << 3) | (zext(negative) << 4) | (zext(extended) << 5) | (zext(limit) << 2);
    # L is sticky here: a successful range check does not clear it.
    EST = (EST & 0xffc4) | flags;
}
wide_load_literal: "#"^wide_load_literal_bits is wide_load_literal_bits { export *[const]:2 wide_load_literal_bits; }
:LOAD "R2","A0L",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x28a & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xffcf) | (new_mode << 4); local low:2 = A0L; R2 = low; }
:LOAD "RN2","R2",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x2aa & wide_13_22=0x213 & wide_40_45=0x22 & wide_load_mode { local low:2 = R2; RN2 = low; }
:LOAD "RL0",wide_load_literal,wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x2c2 & wide_13_22=0x213 & wide_40_45=0xf & wide_load_mode & wide_load_literal { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfffc) | (new_mode << 0); R0 = wide_load_literal; }
:LOAD "RM0","A0L",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x2ca & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xffcf) | (new_mode << 4); local low:2 = A0L; RM0 = low & 0xfff; }
:LOAD "A1",wide_load_literal,wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x226 & wide_13_22=0x213 & wide_40_45=0xf & wide_load_mode & wide_load_literal { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); R1 = wide_load_literal; local low:2 = wide_load_literal; A1L = low; A1H = 0 - (low >> 15); GB1 = (A1H >= 0x8000) * 0xff; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); }
:LOAD "A2H",wide_load_literal,wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x26a & wide_13_22=0x213 & wide_40_45=0xf & wide_load_mode & wide_load_literal { RN2 = wide_load_literal; local low:2 = wide_load_literal; A2H = low; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); }
:LOAD "selector_8e","A0L",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x23a & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xcfff) | (new_mode << 12); local low:2 = A0L; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); }
:LOAD "A1L","A0",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x246 & wide_13_22=0x213 & wide_40_45=0x8 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); local low:2 = A0L; local high:2 = A0H; local guard:1 = GB0; A1L = high; local sign_guard:1 = (high >= 0x8000) * 0xff; local is_extended:1 = guard != sign_guard; wide_load_flags(high == 0 && guard == 0, guard >= 0x80, is_extended, is_extended && (ECFG & 0xc) == 0); }
:LOAD "*R3++","A0L",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x4e & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local base:2 = R3; local old_mode:2 = (PACFG >> 6) & 3; local updated:2; wide_load_next(base, old_mode, RM2, RL2, 1, updated); local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xff3f) | (new_mode << 6); R3 = updated; local low:2 = A0L; local shifted:2 = low s>> ((ECFG >> 5) & 1); *[data]:2 0xffff:2 = shifted; }
:LOAD "A0L","A1",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x242 & wide_13_22=0x213 & wide_40_45=0x9 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfffc) | (new_mode << 0); local low:2 = A1L; local high:2 = A1H; local guard:1 = GB1; A0L = high; local sign_guard:1 = (high >= 0x8000) * 0xff; local is_extended:1 = guard != sign_guard; wide_load_flags(high == 0 && guard == 0, guard >= 0x80, is_extended, is_extended && (ECFG & 0xc) == 0); }
:LOAD "A1","*R3++:long",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x225 & wide_13_22=0x213 & wide_40_45=0x13 & wide_load_mode { local base:2 = R3; local old_mode:2 = (PACFG >> 6) & 3; local updated:2; wide_load_next(base, old_mode, RM2, RL2, 2, updated); local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); R3 = updated; local low:2 = *[data]:2 base; local second:2 = base + 1; local high:2 = *[data]:2 second; A1L = low; A1H = high; GB1 = (A1H >= 0x8000) * 0xff; wide_load_flags((low | high) == 0, high >= 0x8000, 0:1, 0:1); }
:LOAD "A0L","*R0:long",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x241 & wide_13_22=0x213 & wide_40_45=0x0 & wide_load_mode { local base:2 = R0; local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfffc) | (new_mode << 0); local low:2 = *[data]:2 base; local second:2 = base + 1; local high:2 = *[data]:2 second; A0L = high; wide_load_flags(high == 0, high >= 0x8000, 0:1, 0:1); }
:LOAD "R3","*R3++",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x28c & wide_13_22=0x213 & wide_40_45=0x13 & wide_load_mode { local base:2 = R3; local old_mode:2 = (PACFG >> 6) & 3; local updated:2; wide_load_next(base, old_mode, RM2, RL2, 1, updated); local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xff3f) | (new_mode << 6); R3 = updated; local low:2 = *[data]:2 base; R3 = low; }
:LOAD "A0","*R0++",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x220 & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local base:2 = R0; local old_mode:2 = (PACFG >> 0) & 3; local updated:2; wide_load_next(base, old_mode, RM0, RL0, 1, updated); local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfffc) | (new_mode << 0); R0 = updated; local low:2 = *[data]:2 base; A0L = low; A0H = 0 - (low >> 15); GB0 = (A0H >= 0x8000) * 0xff; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); }
:LOAD "GB1","*R1",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x204 & wide_13_22=0x213 & wide_40_45=0x1 & wide_load_mode { local base:2 = R1; local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); local low:2 = *[data]:2 base; GB1 = low:1; }
:LOAD "LC1","A0L",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x352 & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfcff) | (new_mode << 8); local low:2 = A0L; LC1 = low; }
:LOAD "CECFG1","R2",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x30a & wide_13_22=0x213 & wide_40_45=0x22 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xffcf) | (new_mode << 4); local low:2 = R2; CECFG1 = low & 0x3fff; }
:LOAD "A1","A0L",wide_load_mode is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x226 & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); local low:2 = A0L; A1L = low; A1H = 0 - (low >> 15); GB1 = (A1H >= 0x8000) * 0xff; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); }
:LOAD "CE1" "A1",wide_load_literal,wide_load_mode is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_load_ce_bank=0 & wide_0_9=0x226 & wide_13_22=0x213 & wide_40_45=0xf & wide_load_mode & wide_load_literal { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <wide_load_done>; local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); R1 = wide_load_literal; if (enabled == 0) goto <wide_load_done>; local low:2 = wide_load_literal; A1L = low; A1H = 0 - (low >> 15); GB1 = (A1H >= 0x8000) * 0xff; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); <wide_load_done> }
:LOAD "CE1" "R2","A0L",wide_load_mode is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_load_ce_bank=0 & wide_0_9=0x28a & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <wide_load_done>; local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xffcf) | (new_mode << 4); local low:2 = A0L; R2 = low; <wide_load_done> }
:LOAD "CE1" "A1","A0L",wide_load_mode is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_load_ce_bank=0 & wide_0_9=0x226 & wide_13_22=0x213 & wide_40_45=0x10 & wide_load_mode { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <wide_load_done>; local new_mode:2 = wide_load_mode; PACFG = (PACFG & 0xfff3) | (new_mode << 2); if (enabled == 0) goto <wide_load_done>; local low:2 = A0L; A1L = low; A1H = 0 - (low >> 15); GB1 = (A1H >= 0x8000) * 0xff; wide_load_flags(low == 0, low >= 0x8000, 0:1, 0:1); <wide_load_done> }

# The fixed EX ports need address enable, not the late result predicate.
macro wide_load_set_mode(mode, shift) {
    local new_mode:2 = mode;
    PACFG = (PACFG & ~(3 << shift)) | (new_mode << shift);
}

macro wide_load_loop_address(pointer, address) {
    local low:2 = *[data]:2 pointer;
    local following:2 = pointer + 1;
    local high:2 = *[data]:2 following;
    address = ((zext(high) << 16) | zext(low)) & 0xfffffe;
}

macro wide_load_saved_bound(address, saved1, saved2, saved3, saved4) {
    local frame:2 = PSTATUS & 7;
    if (frame == 2) goto <second>;
    if (frame == 3) goto <third>;
    if (frame == 4) goto <fourth>;
    if (frame > 4) goto <done>;
    saved1 = address;
    goto <done>;
  <second>
    saved2 = address;
    goto <done>;
  <third>
    saved3 = address;
    goto <done>;
  <fourth>
    saved4 = address;
  <done>
}

wide_load_execute: "FF1","A0L" is wide_0_9=0x25a & wide_40_45=0x10 & wide_load_mode {
    wide_load_set_mode(wide_load_mode, 12);
    FF1 = A0L;
}
wide_load_execute: "X1","A0L" is wide_0_9=0x27a & wide_40_45=0x10 {
    X1 = A0L;
}
wide_load_execute: "MINMAX","A0L" is wide_0_9=0x2ea & wide_40_45=0x10 {
    MINMAX = A0L;
}
wide_load_execute: "EST","A0L" is wide_0_9=0x306 & wide_40_45=0x10 & wide_load_mode {
    # The EX-only EST view does not replace the guest flags fed to the next issue.
    wide_load_set_mode(wide_load_mode, 2);
}
wide_load_execute: "CECFG1","A0L" is wide_0_9=0x30a & wide_40_45=0x10 & wide_load_mode {
    wide_load_set_mode(wide_load_mode, 4);
    CECFG1 = A0L & 0x3fff;
}
wide_load_execute: "PSTATUS","A0L" is wide_0_9=0x356 & wide_40_45=0x10 & wide_load_mode {
    wide_load_set_mode(wide_load_mode, 10);
    select_saved_loop_frame(A0L);
}
wide_load_execute: "USER_IO","A0L" is wide_0_9=0x35e & wide_40_45=0x10 & wide_load_mode {
    wide_load_set_mode(wide_load_mode, 14);
    USER_IO = A0L & 0xf;
}
wide_load_execute: "LSA1","*R0:long" is wide_0_9=0x349 & wide_40_45=0 & wide_load_mode {
    wide_load_set_mode(wide_load_mode, 4);
    local address:4;
    wide_load_loop_address(R0, address);
    wide_load_saved_bound(address, LSA1W, LSA2W, LSA3W, LSA4W);
    publish_loop_word(address, LSAH, LSAL);
}
wide_load_execute: "LEA1","*R1:long" is wide_0_9=0x34d & wide_40_45=1 & wide_load_mode {
    wide_load_set_mode(wide_load_mode, 6);
    local address:4;
    wide_load_loop_address(R1, address);
    wide_load_saved_bound(address, LEA1W, LEA2W, LEA3W, LEA4W);
    publish_loop_word(address, LEAH, LEAL);
}

:LOAD "EST","*"^wide_load_literal_bits is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1
    & wide_0_22=0x436304 & wide_40_45>=0x38 & wide_load_literal_bits {
    local address:2 = wide_load_literal_bits;
    EST = (*[data]:2 address) & 0x7fff;
}

@define WIDE_LOAD_CE1_PORT "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_load_ce_bank=0 & wide_13_22=0x213"
:LOAD "CE1" wide_load_execute,wide_load_mode is $(WIDE_LOAD_CE1_PORT) & wide_load_execute & wide_load_mode {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <feedback>;
    build wide_load_execute;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:LOAD "CE1" "BTR1","A0L",wide_load_mode is $(WIDE_LOAD_CE1_PORT) & wide_0_9=0x31a & wide_40_45=0x10 & wide_load_mode {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <feedback>;
    wide_load_set_mode(wide_load_mode, 12);
    if (enabled == 0) goto <feedback>;
    BTR1 = A0L;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

# SWAP exchanges one DATA word even when the operand selector names a long.
swap_word_register: swap_reg_lo is wide_0_1<2 & (swap_reg_short_group=0 | swap_reg_short_group=4 | swap_reg_short_group=5 | swap_reg_short_group=7) & swap_reg_lo { export swap_reg_lo; }
# A DATA selector in the second operand can update a pointer, but the
# exchanged value comes from its register alias, not a second DATA read.
swap_word_register: swap_reg_lo is wide_0_1<2 & (swap_reg_short_group=1 | swap_reg_short_group=2 | swap_reg_short_group=3)
    & (swap_register_address=1 | swap_address_group=0 | swap_address_group=8 | swap_address_group=7 | swap_address_group=15 | swap_address_index!=swap_peer_index)
    & swap_reg_lo & wide_0_0 & swap_peer_base & swap_peer_step & swap_peer_modulo & swap_peer_bound & swap_peer_pacfg_shift & swap_peer_modify {
    local stride:2 = 1 + wide_0_0;
    modify_ptr_scaled(swap_peer_base, swap_peer_step, swap_peer_modulo, swap_peer_bound, swap_peer_pacfg_shift, swap_peer_modify, stride);
    export swap_reg_lo;
}
swap_word_register: swap_reg_full is wide_0_1=2 & swap_reg_full_group=1 & swap_reg_full { export swap_reg_full; }
swap_address: "*"^word_address is (wide_2_9=0x86 | wide_2_9=0x87 | wide_2_9=0x8e | wide_2_9=0x8f | swap_address_group=0x1c | swap_address_group=0x1d | swap_address_group=0x1e | swap_address_group=0x1f) [ word_address = 0xffff; ] { export *[const]:2 word_address; }
swap_address: "*"^absolute_data_addr is (swap_address_group=7 | swap_address_group=15) & absolute_data_addr { export *[const]:2 absolute_data_addr; }
swap_address: "*"^swap_base is swap_register_address=0 & wide_7_7=0 & swap_modify & swap_long & swap_base & swap_step & swap_modulo & swap_bound & swap_pacfg_shift {
    local address:2 = swap_base;
    local stride:2 = 1 + swap_long;
    modify_ptr_scaled(swap_base, swap_step, swap_modulo, swap_bound, swap_pacfg_shift, swap_modify, stride);
    export address;
}

:SWAP swap_address,swap_word_register is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_13_22=0x21a & swap_address & swap_word_register {
    build swap_address;
    build swap_word_register;
    local data_word:2 = *[data]:2 swap_address;
    local register_word:2 = swap_word_register;
    swap_word_register = data_word;
    *[data]:2 swap_address = register_word;
    local flags:2 = (EST & 0xffc4) | (zext(data_word == 0) << 3) | (zext(data_word >= 0x8000) << 4);
    local ce1:2;
    local ce2:2;
    unary_ce(CECFG1, flags, CETBL, 0, ce1);
    unary_ce(CECFG2, flags, CETBL, 1, ce2);
    EST = (flags & 0xcfff) | (ce1 << 12) | (ce2 << 13);
}

# The ALU sees 40 bits; use normalized u64 bit patterns, not 5-byte C arithmetic.
macro compact_long_sample(lo, hi, guard, bits) {
    bits = (zext(guard) << 32) | (zext(hi) << 16) | zext(lo);
}
macro compact_long_finish(bits, carry_out, overflow, data_result, mixed, result, flags) {
    local negative:1 = bits >= 0x8000000000;
    local extend:1 = bits > 0x7fffffff && bits < 0xff80000000;
    local auto_limit:1 = (ECFG & 4) != 0;
    local saturated:1 = (ECFG & 0x28) == 8;
    local loss:1 = (overflow || (data_result != 0 && extend)) && !auto_limit && !saturated;
    # Status uses the pre-limit value, including the guard and sign.
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(bits == 0) << 3) | (zext(negative) << 4) | (zext(extend) << 5);
    result = bits;
    if (mixed != 0) goto <limited>;
    if (data_result == 0 || !saturated || !(extend || overflow)) goto <auto>;
    # Saturation sees the sign of the exact sum, before 40-bit wrap.
    negative = negative != overflow;
    goto <clamp>;
  <auto>
    if (!auto_limit || ((((bits >> 31) ^ (bits >> 32)) & 1) == 0)) goto <limited>;
  <clamp>
    result = 0x7fffffff;
    if (!negative) goto <mark_loss>;
    result = 0xff80000000;
  <mark_loss>
    flags = flags | 4;
  <limited>
    # SR1 is a DATA port operation; bit 32 already supplies the new bit 31.
    if (data_result == 0) goto <finish>;
    result = result >> ((ECFG >> 5) & 1);
  <finish>
}

macro compact_aux_add(lhs, rhs, word_result, result, flags) {
    local sum:8 = lhs + rhs;
    local bits:8 = sum & 0xffffffffff;
    local carry_out:1 = sum >= 0x10000000000;
    local overflow:1 = ((lhs ^ rhs) < 0x8000000000) && ((lhs ^ bits) >= 0x8000000000);
    compact_long_finish(bits, carry_out, overflow, 0:1, 0:1, result, flags);
    if (word_result == 0) goto <done>;
    flags = (flags & 0xfff7) | (zext((bits >> 16) == 0) << 3);
    if ((flags & 0x20) == 0 || (ECFG & 4) != 0 || (ECFG & 0x28) == 8) goto <done>;
    flags = flags | 4;
  <done>
}

compact_aux_agu: pair_ptr_1 is slot_1_5<=7 & pair_ptr_1 {
    local bits:8 = zext(pair_ptr_1);
    export bits;
}
compact_aux_agu: pair_rn_1 is slot_1_5>=8 & slot_1_5<=15 & pair_rn_1 {
    local bits:8 = sext(pair_rn_1) & 0xffffffffff;
    export bits;
}

@define COMPACT_AUX_LONG "slot_12_22=0x12b & compact_aux_agu"

compact_aux_long: compact_aux_acc_dst,"FF12",compact_aux_agu is $(COMPACT_AUX_LONG)
    & slot_6_8>=6 & slot_9_11<=5 & compact_aux_acc_dst & compact_aux_dst_lo & compact_aux_dst_hi & compact_aux_dst_guard {
    build compact_aux_agu;
    local pair:8 = (zext(FF2) << 16) | zext(FF1);
    local result:8;
    local flags:2;
    compact_aux_add(pair, compact_aux_agu, 0:1, result, flags);
    compact_aux_dst_lo = result:2;
    compact_aux_dst_hi = result(2);
    compact_aux_dst_guard = result(4);
    export flags;
}
compact_aux_long: "FF12",indexed_load_acc,compact_aux_agu is $(COMPACT_AUX_LONG)
    & slot_9_11>=6 & slot_6_8<=5 & indexed_load_acc & indexed_load_lo & indexed_load_hi & indexed_load_guard {
    build compact_aux_agu;
    local lhs:8;
    compact_long_sample(indexed_load_lo, indexed_load_hi, indexed_load_guard, lhs);
    local result:8;
    local flags:2;
    compact_aux_add(lhs, compact_aux_agu, 0:1, result, flags);
    FF1 = result:2;
    FF2 = result(2);
    export flags;
}

compact_aux_word_sum: cmp_full_lhs_full,cmp_full_rhs_full is slot_12_22=0x132 & slot_11_11=1
    & slot_4_6<=5 & slot_1_3<=5 & (slot_7_10=6 | slot_7_10=7 | slot_7_10=14 | slot_7_10=15)
    & cmp_full_lhs_full & cmp_full_lhs_lo & cmp_full_lhs_hi & cmp_full_lhs_guard
    & cmp_full_rhs_full & cmp_full_rhs_lo & cmp_full_rhs_hi & cmp_full_rhs_guard {
    local lhs:8;
    local rhs:8;
    compact_long_sample(cmp_full_lhs_lo, cmp_full_lhs_hi, cmp_full_lhs_guard, lhs);
    compact_long_sample(cmp_full_rhs_lo, cmp_full_rhs_hi, cmp_full_rhs_guard, rhs);
    local result:8;
    local flags:2;
    compact_aux_add(lhs, rhs, 1:1, result, flags);
    local word:2 = result(2);
    local packed:4 = (zext(flags) << 16) | zext(word);
    export packed;
}

compact_aux_left_payload: compact_aux_long is compact_aux_long { build compact_aux_long; export compact_aux_long; }
compact_aux_right_payload: compact_aux_long is compact_aux_long { build compact_aux_long; export compact_aux_long; }
compact_aux_left_payload: compact_aux_word_left,compact_aux_word_sum is compact_aux_word_left & compact_aux_word_sum {
    build compact_aux_word_sum;
    compact_aux_word_left = compact_aux_word_sum:2;
    local flags:2 = compact_aux_word_sum(2);
    export flags;
}
compact_aux_right_payload: compact_aux_word_right,compact_aux_word_sum is compact_aux_word_right & compact_aux_word_sum {
    build compact_aux_word_sum;
    compact_aux_word_right = compact_aux_word_sum:2;
    local flags:2 = compact_aux_word_sum(2);
    export flags;
}

compact_aux_ce1: is slot_0_0=0 { export 1:2; }
compact_aux_ce1: "CE1" is slot_0_0=1 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0:2, enabled); export enabled; }
compact_aux_ce2: is slot_0_0=0 { export 1:2; }
compact_aux_ce2: "CE2" is slot_0_0=1 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1:2, enabled); export enabled; }

compact_aux_left: "ADD" compact_aux_ce1 compact_aux_left_payload is compact_aux_ce1 & compact_aux_left_payload {
    local prev:2 = EST;
    build compact_aux_ce1;
    if (compact_aux_ce1 == 0) goto <publish>;
    build compact_aux_left_payload;
    EST = (prev & 0xffc4) | compact_aux_left_payload;
  <publish>
    publish_ce_feedback(EST & 0xcfff, prev);
}
compact_aux_right: "ADD" compact_aux_ce2 compact_aux_right_payload is compact_aux_ce2 & compact_aux_right_payload {
    local prev:2 = EST;
    build compact_aux_ce2;
    if (compact_aux_ce2 == 0) goto <publish>;
    build compact_aux_right_payload;
    EST = (prev & 0xf13f) | (compact_aux_right_payload << 6);
  <publish>
    publish_ce_feedback(EST & 0xcfff, prev);
}

:^compact_aux_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_aux_left); (slot_mode=0 & nop_right) { build compact_aux_left; }
:^nop_left "||" compact_aux_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_aux_right) { build compact_aux_right; }
:^compact_aux_left is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_aux_left { build compact_aux_left; }

# The unqualified binary ALU routes input selectors through the chosen result bank.
@define WIDE_ALIAS_ALU "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & logic_ce_bank=0"
@define WIDE_ALIAS_ADD "$(WIDE_ALIAS_ALU) & wide_alias_add_op=8"
@define WIDE_ALIAS_XOR "$(WIDE_ALIAS_ALU) & wide_20_22=6 & wide_logic_rmw_op=2"

alias_add_acc_input: "-1" is (wide_alias_add_lhs=0x8e | wide_alias_add_lhs=0xe6 | wide_alias_add_lhs=0xf6) {
    export 0xffffffffff:8;
}
alias_add_acc_input: "FF1" is wide_alias_add_lhs=0xbe {
    local bits:8 = sext(FF1) & 0xffffffffff;
    export bits;
}
alias_add_acc_input: "LSA1" is wide_alias_add_lhs=0xd2 {
    local bits:8 = (zext(LSA1H) << 16) | zext(LSA1L);
    export bits;
}
alias_add_acc_input: "LEA1" is wide_alias_add_lhs=0xd3 {
    local bits:8 = (zext(LEA1H) << 16) | zext(LEA1L);
    export bits;
}
alias_add_acc_input: "A0" is (wide_alias_add_lhs=0xe0 | wide_alias_add_lhs=0xf0) {
    local bits:8;
    compact_long_sample(A0L, A0H, GB0, bits);
    export bits;
}
alias_add_acc_input: "A5" is (wide_alias_add_lhs=0xe5 | wide_alias_add_lhs=0xf5) {
    local bits:8;
    compact_long_sample(A5L, A5H, GB5, bits);
    export bits;
}

macro wide_alias_add(left, right, word, result) {
    local raw:8 = left + right;
    local bits:8 = raw & 0xffffffffff;
    local carry_out:1 = raw >= 0x10000000000;
    local overflow:1 = ((left ^ right) < 0x8000000000) && ((left ^ bits) >= 0x8000000000);
    local flags:2;
    compact_long_finish(bits, carry_out, overflow, 0:1, 0:1, result, flags);
    local narrow_loss:1 = word != 0 && (flags & 0x20) != 0 && (ECFG & 4) == 0 && (ECFG & 0x28) != 8;
    EST = (EST & 0xffc4) | flags | (zext(narrow_loss) << 2);
}

:ADD "A1",alias_add_acc_input,"R0" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x89 & alias_add_acc_input & wide_40_45=0x20 & wide_0_0=1 {
    local rhs:8 = sext(R0) & 0xffffffffff;
    local result:8;
    wide_alias_add(alias_add_acc_input, rhs, 0:1, result);
    A1L = result:2;
    A1H = result(2);
    GB1 = result(4);
}

# The raw selector does not encode the operand-fetch route.
alias_of_word: "OF" is carmel_of_route=1 { export 0:2; }
alias_of_word: "*0xffff" is carmel_of_route=2 {
    local word:2 = *[data]:2 0xffff:2;
    export word;
}
alias_of_word: "*0x0" is carmel_of_route=3 {
    local word:2 = *[data]:2 0:2;
    export word;
}
alias_of_long: "OF" is carmel_of_route=1 { export 0:4; }
alias_of_long: "*0xffff" is carmel_of_route=2 {
    local word:2 = *[data]:2 0xffff:2;
    local value:4 = zext(word);
    export value;
}
alias_of_long: "*0x0" is carmel_of_route=3 {
    local word:2 = *[data]:2 0:2;
    local value:4 = zext(word) | (zext(word) << 16);
    export value;
}

:ADD "A0",alias_of_word,"A3L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x88 & wide_alias_add_lhs=0xe7 & wide_40_45=0x13 & wide_0_0=1 & alias_of_word {
    local lhs:8 = sext(alias_of_word) & 0xffffffffff;
    local rhs:8 = sext(A3L) & 0xffffffffff;
    local result:8;
    wide_alias_add(lhs, rhs, 0:1, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
}

:ADD "long *R0",alias_of_long,"A3L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x40 & wide_alias_add_lhs=0xe6 & wide_40_45=0x13 & wide_0_0=1 & alias_of_long {
    local lhs:8 = zext(alias_of_long);
    local rhs:8 = sext(A3L) & 0xffffffffff;
    local result:8;
    wide_alias_add(lhs, rhs, 0:1, result);
    local upper:2 = R0 + 1;
    *[data]:2 R0 = result:2;
    *[data]:2 upper = result(2);
}

macro wide_alias_r0_word(word) {
    local address:2 = R0;
    word = *[data]:2 address;
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
}

:ADD "GB4","*R0++","A1L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x84 & wide_alias_add_lhs=0x10 & wide_40_45=0x11 & wide_0_0=1 {
    local word:2;
    wide_alias_r0_word(word);
}

:ADD "RMW2","*R0++","A1L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x87 & wide_alias_add_lhs=0x10 & wide_40_45=0x11 & wide_0_0=1 {
    local word:2;
    wide_alias_r0_word(word);
    local lhs:8 = (sext(word) << 16) & 0xffffffffff;
    local rhs:8 = (sext(A1L) << 16) & 0xffffffffff;
    local result:8;
    wide_alias_add(lhs, rhs, 1:1, result);
    A1L = result(2);
}

:XOR "X1","A2L","long *R4--" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x9e & wide_alias_logic_lhs=0x92 & wide_40_45=0x1c & wide_0_1=1 {
    local low:2;
    local high:2;
    wide_unary_data_read(R4, 2:2, low, high);
    modify_ptr_scaled(R4, RN4, RM4, RL4, 8, 3, 2:2);
    local result:4 = (zext(high) << 16) | zext(low ^ A2L);
    X1 = result:2;
    local flags:2 = (zext(result == 0) << 3) | (zext(high >= 0x8000) << 5);
    commit_logic_flags(flags, 0);
}

:XOR "A0",alias_of_word,"A3L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x88 & wide_alias_logic_lhs=0xe7 & wide_40_45=0x13 & wide_0_1=2 & alias_of_word {
    local word:2 = alias_of_word;
    A0L = word ^ A3L;
    A0H = 0;
    GB0 = 0;
    commit_logic_flags(zext(A0L == 0) << 3, 0);
}

:XOR "*R0",alias_of_word,"A3L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0 & wide_alias_logic_lhs=0xee & wide_40_45=0x13 & wide_0_1=2 & alias_of_word {
    local word:2 = alias_of_word;
    local result:2 = word ^ A3L;
    *[data]:2 R0 = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

:XOR "GB4","*R0++","A1L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x84 & wide_alias_logic_lhs=0x10 & wide_40_45=0x11 & wide_0_1=2 {
    local word:2;
    wide_alias_r0_word(word);
}

:XOR "RMW2","*R0++","A1L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x8e & wide_alias_logic_lhs=0x10 & wide_40_45=0x11 & wide_0_1=2 {
    local word:2;
    wide_alias_r0_word(word);
    A1L = word ^ A1L;
    commit_logic_flags(zext(A1L == 0) << 3, 0);
}

# The two-operand logic family reads its destination before publishing the result.
wide_logic_accumulate: "OR" is wide_logic_accumulate_op=0 { export 0:2; }
wide_logic_accumulate: "AND" is wide_logic_accumulate_op=1 { export 1:2; }
wide_logic_accumulate: "XOR" is wide_logic_accumulate_op=2 { export 2:2; }

macro wide_logic_accumulate_flags(result) {
    local flags:2 = (zext(result == 0) << 3) | (zext(result >= 0x8000000000) << 4)
                  | (zext(result > 0x7fffffff && result < 0xff80000000) << 5);
    commit_logic_flags(flags, 0);
}

@define WIDE_LOGIC_ACCUMULATE "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & logic_ce_bank=0 & wide_logic_accumulate_family=0xe & wide_0_1=0"
:^wide_logic_accumulate "A0","A1" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=0x48 & wide_logic_accumulate_src=0x49 {
    local left:8;
    local right:8;
    compact_long_sample(A0L, A0H, GB0, left);
    compact_long_sample(A1L, A1H, GB1, right);
    local result:8;
    wide_logic_bitop(wide_logic_accumulate, left, right, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    wide_logic_accumulate_flags(result);
}
:^wide_logic_accumulate "A0H","A1" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=0x58 & wide_logic_accumulate_src=0x49 {
    local right:8;
    compact_long_sample(A1L, A1H, GB1, right);
    local result:8;
    wide_logic_bitop(wide_logic_accumulate, zext(A0H), right, result);
    A0H = result:2;
    wide_logic_accumulate_flags(result);
}
:^wide_logic_accumulate "GB0","A1" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=0x40 & wide_logic_accumulate_src=0x49 {
    local result:2;
    wide_logic_bitop(wide_logic_accumulate, 0:2, A1H, result);
    GB0 = result:1;
}
:^wide_logic_accumulate "*R0+=RN0","A0L" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=8 & wide_logic_accumulate_src=0x50 {
    local address:2 = R0;
    local left:2 = *[data]:2 address;
    local result:2;
    wide_logic_bitop(wide_logic_accumulate, left, A0L, result);
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    *[data]:2 address = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}
:^wide_logic_accumulate "*R0+=RN0","*R0" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=8 & wide_logic_accumulate_src=0 {
    local address:2 = R0;
    local word:2 = *[data]:2 address;
    local result:2;
    wide_logic_bitop(wide_logic_accumulate, word, word, result);
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    *[data]:2 address = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

# The displacement queue is shared by the result and both operand AGUs.
# It supplies low, high, then zero; postmodify addresses retain their incoming base.
@define WIDE_OR_DISP "$(WIDE_ALIAS_ALU) & wide_20_22=6 & wide_logic_rmw_op=0"
@define WIDE_OR_DISP_ACC "wide_alias_logic_dst>=0x88 & wide_alias_logic_dst<=0x8d & wide_disp_dst_acc & wide_disp_dst_lo & wide_logic_dst_hi & wide_disp_dst_guard"
@define WIDE_OR_DISP_DST "wide_alias_logic_dst>=0x30 & wide_alias_logic_dst<=0x37 & wide_disp_dst_ptr & wide_disp_dst_modulo & wide_disp_dst_bound & wide_disp_dst_shift"
@define WIDE_OR_DISP_LHS "wide_alias_logic_lhs>=0x20 & wide_alias_logic_lhs<=0x27 & wide_logic_lhs_ptr"
@define WIDE_OR_DISP_RHS "wide_0_1=0 & wide_40_45>=0x20 & wide_40_45<=0x27 & wide_disp_rhs_lo"
@define WIDE_OR_DISP_DISTINCT "((wide_disp_lhs_ptr_index=0 & wide_disp_rhs_ptr_index!=0) | (wide_disp_lhs_ptr_index=1 & wide_disp_rhs_ptr_index!=1) | (wide_disp_lhs_ptr_index=2 & wide_disp_rhs_ptr_index!=2) | (wide_disp_lhs_ptr_index=3 & wide_disp_rhs_ptr_index!=3) | (wide_disp_lhs_ptr_index=4 & wide_disp_rhs_ptr_index!=4) | (wide_disp_lhs_ptr_index=5 & wide_disp_rhs_ptr_index!=5) | (wide_disp_lhs_ptr_index=6 & wide_disp_rhs_ptr_index!=6) | (wide_disp_lhs_ptr_index=7 & wide_disp_rhs_ptr_index!=7))"

macro wide_or_disp_read(first, second, result) {
    local left:2 = *[data]:2 first;
    local right:2 = *[data]:2 second;
    result = left | right;
}

macro wide_or_disp_acc(lo, hi, guard, result) {
    lo = result;
    hi = 0;
    guard = 0;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

:OR wide_disp_dst_acc,"*"^wide_logic_lhs_ptr^"+"^wide_shift_dst_disp,"*"^wide_disp_rhs_lo^"+"^wide_shift_count_disp is
    $(WIDE_OR_DISP) & $(WIDE_OR_DISP_ACC) & $(WIDE_OR_DISP_LHS) & $(WIDE_OR_DISP_RHS)
    & wide_shift_dst_disp & wide_shift_count_disp {
    local first:2 = wide_logic_lhs_ptr + sext(wide_shift_dst_disp:1);
    local second:2 = wide_disp_rhs_lo + sext(wide_shift_count_disp:1);
    local result:2;
    wide_or_disp_read(first, second, result);
    wide_or_disp_acc(wide_disp_dst_lo, wide_logic_dst_hi, wide_disp_dst_guard, result);
}

:OR "*"^wide_disp_dst_ptr^"+="^wide_shift_dst_disp,"*"^wide_logic_lhs_ptr^"+"^wide_shift_count_disp,"*"^wide_disp_rhs_lo^"+0" is
    $(WIDE_OR_DISP) & $(WIDE_OR_DISP_DST) & $(WIDE_OR_DISP_LHS) & $(WIDE_OR_DISP_RHS)
    & wide_shift_dst_disp & wide_shift_count_disp {
    local destination:2 = wide_disp_dst_ptr;
    local first:2 = wide_logic_lhs_ptr + sext(wide_shift_count_disp:1);
    local second:2 = wide_disp_rhs_lo;
    local delta:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(wide_disp_dst_ptr, delta, wide_disp_dst_modulo, wide_disp_dst_bound, wide_disp_dst_shift, 4);
    local result:2;
    wide_or_disp_read(first, second, result);
    *[data]:2 destination = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

:OR "*"^wide_disp_dst_ptr^"+="^wide_shift_dst_disp,"*"^wide_logic_lhs_ptr^"+"^wide_shift_count_disp,"A0L" is
    $(WIDE_OR_DISP) & $(WIDE_OR_DISP_DST) & $(WIDE_OR_DISP_LHS) & wide_0_1=2 & wide_40_45=0x10
    & wide_shift_dst_disp & wide_shift_count_disp {
    local destination:2 = wide_disp_dst_ptr;
    local first:2 = wide_logic_lhs_ptr + sext(wide_shift_count_disp:1);
    local delta:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(wide_disp_dst_ptr, delta, wide_disp_dst_modulo, wide_disp_dst_bound, wide_disp_dst_shift, 4);
    local left:2 = *[data]:2 first;
    local result:2 = left | A0L;
    *[data]:2 destination = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

# A shared postmodify register on both source ports is an address conflict.
:OR wide_disp_dst_acc,"*"^wide_logic_lhs_ptr^"+="^wide_shift_dst_disp,"*"^wide_disp_rhs_lo^"+="^wide_shift_count_disp is
    $(WIDE_OR_DISP) & $(WIDE_OR_DISP_ACC) & wide_alias_logic_lhs>=0x30 & wide_alias_logic_lhs<=0x37
    & wide_0_1=0 & wide_40_45>=0x30 & wide_40_45<=0x37 & $(WIDE_OR_DISP_DISTINCT)
    & wide_logic_lhs_ptr & wide_logic_lhs_modulo & wide_logic_lhs_bound & wide_logic_lhs_mode_shift
    & wide_disp_rhs_lo & wide_logic_rhs_modulo & wide_logic_rhs_bound & wide_logic_rhs_mode_shift
    & wide_shift_dst_disp & wide_shift_count_disp {
    local first:2 = wide_logic_lhs_ptr;
    local second:2 = wide_disp_rhs_lo;
    local first_delta:2 = sext(wide_shift_dst_disp:1);
    local second_delta:2 = sext(wide_shift_count_disp:1);
    modify_ptr(wide_logic_lhs_ptr, first_delta, wide_logic_lhs_modulo, wide_logic_lhs_bound, wide_logic_lhs_mode_shift, 4);
    modify_ptr(wide_disp_rhs_lo, second_delta, wide_logic_rhs_modulo, wide_logic_rhs_bound, wide_logic_rhs_mode_shift, 4);
    local result:2;
    wide_or_disp_read(first, second, result);
    wide_or_disp_acc(wide_disp_dst_lo, wide_logic_dst_hi, wide_disp_dst_guard, result);
}

# Immediate address-unit transfers and fixed long strides.
macro transfer_address_word(pointer, modulo, bound, shift, delta, result) {
    local base:2 = pointer;
    local mode:2 = (PACFG >> shift) & 3;
    local candidate:4 = sext(base) + sext(delta);
    if (mode < 2) goto <transfer_done>;

    local size:4;
    local lower:4;
    if (mode == 3) goto <transfer_explicit>;
    local mask:2 = modulo;
    mask = mask | (mask >> 1);
    mask = mask | (mask >> 2);
    mask = mask | (mask >> 4);
    mask = mask | (mask >> 8);
    lower = sext(base & ~mask);
    size = zext(modulo & 0xfff) + 1;
    if (candidate s>= lower && candidate s< lower + size) goto <transfer_done>;
    goto <transfer_wrap>;

  <transfer_explicit>
    candidate = zext(candidate:2);
    lower = zext(bound);
    size = zext(modulo) + 1;
    local limit:4 = lower + size;
    if (limit <= 0x10000 && lower <= candidate && candidate < limit) goto <transfer_done>;
  <transfer_wrap>
    if (delta s< 0) goto <transfer_reverse>;
    candidate = candidate - size;
    goto <transfer_done>;
  <transfer_reverse>
    candidate = candidate + size;
  <transfer_done>
    result = candidate:2;
}

macro wide_adjust_result(left, right, subtract, unsigned_right, sticky_enabled, result) {
    local mask:8 = 0xffffffffff;
    local sign:8 = 0x8000000000;
    local lhs:8 = left;
    local rhs:8 = right & mask;
    local raw:8 = lhs + rhs;
    local carry_bit:1 = raw > mask;
    local sign_difference:1 = ((lhs ^ rhs) & sign) != 0;
    local subtracting:1 = subtract;
    if (subtracting == 0) goto <status>;
    raw = lhs - rhs;
    carry_bit = lhs >= rhs;
  <status>
    result = raw & mask;
    local overflow:1 = (sign_difference == subtracting) && (((lhs ^ result) & sign) != 0);
    if (unsigned_right == 0) goto <adjust_flags>;
    overflow = raw >= sign + ((lhs & sign) << 1);
  <adjust_flags>
    local flags:2 = zext(carry_bit) | (zext(overflow) << 1)
                  | (zext(overflow && sticky_enabled) << 2) | (zext(result == 0) << 3)
                  | (zext(result >= sign) << 4)
                  | (zext(result > 0x7fffffff && result < 0xff80000000) << 5);
    EST = (EST & 0xffc4) | flags;
}

wide_adjust_high: "ADDH" is wide_adjust_op=5 { export 0:1; }
wide_adjust_high: "SUBH" is wide_adjust_op=1 { export 1:1; }

@define WIDE_ADJUST_CE2 "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_13_22=0x210"
:ADDH "CE2" "*R1:long","*R0+="^wide_shift_dst_disp is $(WIDE_ADJUST_CE2) & wide_adjust_op=5 & wide_2_9=0x41 & wide_40_45=0x30 & wide_0_1=0 & wide_shift_dst_disp {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local source:2 = R0;
    local delta:2 = sext(wide_shift_dst_disp:1);
    transfer_address_word(source, RM0, RL0, 0, delta, R0);
    local word:2 = *[data]:2 source;
    if (enabled == 0) goto <finish>;
    local right:8 = (zext(word) << 16) | ((0 - zext(word >= 0x8000)) & 0xff00000000);
    local result:8;
    wide_adjust_result(zext(R1), right, 0:1, 0:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:ADDL "CE2" "*R1+="^wide_shift_dst_disp^":long","*R0+="^wide_shift_count_disp is $(WIDE_ADJUST_CE2) & wide_adjust_op=4 & wide_2_9=0x71 & wide_40_45=0x30 & wide_0_1=0 & wide_shift_dst_disp & wide_shift_count_disp {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local destination:2 = R1;
    local source:2 = R0;
    local destination_delta:2 = sext(wide_shift_dst_disp:1);
    local source_delta:2 = sext(wide_shift_count_disp:1);
    transfer_address_word(destination, RM0, RL0, 2, destination_delta, R1);
    transfer_address_word(source, RM0, RL0, 0, source_delta, R0);
    local word:2 = *[data]:2 source;
    if (enabled == 0) goto <finish>;
    local result:8;
    wide_adjust_result(zext(destination), zext(word), 0:1, 0:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:^wide_adjust_high "CE2" "*R1:long","*R0:long" is $(WIDE_ADJUST_CE2) & wide_adjust_high & wide_2_9=0x41 & wide_40_45=0 & wide_0_1=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local low:2;
    local high:2;
    wide_unary_data_read(R0, 2:2, low, high);
    if (enabled == 0) goto <finish>;
    local word:4 = zext(low) | (zext(high) << 16);
    local result:8;
    wide_adjust_result(zext(R1), sext(word), wide_adjust_high, 0:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:ADDH "CE2" "A0","*R0:long" is $(WIDE_ADJUST_CE2) & wide_adjust_op=5 & wide_2_9=0x88 & wide_40_45=0 & wide_0_1=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local low:2;
    local high:2;
    wide_unary_data_read(R0, 2:2, low, high);
    if (enabled == 0) goto <finish>;
    local word:4 = zext(low) | (zext(high) << 16);
    local left:8;
    compact_long_sample(A0L, A0H, GB0, left);
    local result:8;
    wide_adjust_result(left, sext(word), 0:1, 0:1, 1:1, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:SUBL "CE2" "*R1++",wide_load_literal is $(WIDE_ADJUST_CE2) & wide_adjust_op=0 & (wide_2_9=0x11 | wide_2_9=0x51) & wide_40_45=0xf & wide_0_1=2 & wide_adjust_long_dst & wide_load_literal {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local destination:2 = R1;
    local stride:2 = wide_adjust_long_dst + 1;
    modify_ptr_scaled(R1, RN1, RM0, RL0, 2, 2, stride);
    if (enabled == 0) goto <finish>;
    local result:8;
    wide_adjust_result(zext(destination), zext(wide_load_literal), 1:1, 0:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_ROUTED_ALU "wide_left_mode=1 & wide_right_mode=1 & carmel_issue=5"

macro wide_adjust_immediate_a0(operand, subtract) {
    local original:8;
    compact_long_sample(A0L, A0H, GB0, original);
    local result:8;
    local sticky_enabled:1 = (ECFG & 0xc) == 0;
    wide_adjust_result(original, operand, subtract, 0:1, sticky_enabled, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_ADJUST_IMMEDIATE "$(WIDE_ROUTED_ALU) & wide_40_45=0xf & wide_load_literal_bits"
:ADDL "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x421222 {
    local operand:8 = zext(wide_load_literal_bits:2);
    wide_adjust_immediate_a0(operand, 0:1);
}
:ADDH "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x421622 {
    local operand:8 = sext(wide_load_literal_bits:2) * 0x10000;
    wide_adjust_immediate_a0(operand, 0:1);
}
:SUBL "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x420222 {
    local operand:8 = zext(wide_load_literal_bits:2);
    wide_adjust_immediate_a0(operand, 1:1);
}
:SUBH "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x420622 {
    local operand:8 = sext(wide_load_literal_bits:2) * 0x10000;
    wide_adjust_immediate_a0(operand, 1:1);
}
@undef WIDE_ADJUST_IMMEDIATE

:ADDL "A0","A2" is $(WIDE_ROUTED_ALU) & wide_13_22=0x210 & wide_adjust_op=4
    & wide_40_45=0xa & wide_0_1=2 & wide_2_9=0x88 {
    local left:8;
    local right:8;
    compact_long_sample(A0L, A0H, GB0, left);
    compact_long_sample(A2L, A2H, GB2, right);
    local result:8;
    local automatic:1 = (ECFG & 4) != 0;
    local sticky_enabled:1 = !automatic && (ECFG & 0x28) != 8;
    wide_adjust_result(left, right, 0:1, 1:1, sticky_enabled, result);
    if (!automatic || (((result >> 31) ^ (result >> 32)) & 1) == 0) goto <writeback>;
    EST = EST | 4;
    result = 0x7fffffff;
    if ((EST & 0x10) == 0) goto <writeback>;
    result = 0xff80000000;
  <writeback>
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce(EST & 0xcfff);
}

# Inputs have already been widened or aligned by their physical ports.
macro wide_routed_arithmetic(left, right, adjust, subtract, word_result, data_result, result) {
    local mask:8 = 0xffffffffff;
    local sign:8 = 0x8000000000;
    local lhs:8 = left & mask;
    local rhs:8 = right & mask;
    local carry_in:8 = zext(adjust);
    local signed_lhs:8 = lhs - ((lhs & sign) << 1);
    local signed_rhs:8 = rhs - ((rhs & sign) << 1);
    local raw:8;
    local exact:8;
    if (subtract != 0) goto <difference>;
    raw = lhs + rhs + carry_in;
    exact = signed_lhs + signed_rhs + carry_in;
    goto <finish>;
  <difference>
    raw = lhs + (mask ^ rhs) + 1 - carry_in;
    exact = signed_lhs - signed_rhs - carry_in;
  <finish>
    local bits:8 = raw & mask;
    local overflow:1 = exact != bits - ((bits & sign) << 1);
    local flags:2;
    compact_long_finish(bits, raw > mask, overflow, 0:1, 0:1, result, flags);
    if (word_result == 0 || (bits >> 16) != 0) goto <limit>;
    flags = flags | 8;
  <limit>
    if ((word_result == 0 && data_result == 0) || (flags & 0x20) == 0 || (ECFG & 4) != 0) goto <publish>;
    if ((ECFG & 0x28) != 8) goto <mark_loss>;
    if (data_result == 0) goto <publish>;
    result = 0x7fffffff;
    if ((flags & 0x10) == 0) goto <mark_loss>;
    result = 0xff80000000;
  <mark_loss>
    flags = flags | 4;
  <publish>
    publish_alu_ce((EST & 0xcfc4) | flags);
}

@define WIDE_ADD_LITERAL_PORT "$(WIDE_ROUTED_ALU) & wide_alias_add_op=8 & wide_40_45=0xf & wide_0_0=1 & wide_load_literal_bits"

:ADD "A0","GB1",wide_load_literal_bits is $(WIDE_ADD_LITERAL_PORT) & wide_alias_add_dst=0x88 & wide_alias_add_lhs=0x81 {
    local left:8 = zext(GB1);
    local right:8 = sext(wide_load_literal_bits:2);
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 0:1, 0:1, 0:1, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
}

macro wide_add_a0_literal_word(operand, result) {
    local left:8;
    compact_long_sample(A0L, A0H, GB0, left);
    local right:8 = sext(operand);
    wide_routed_arithmetic(left, right, 0:1, 0:1, 1:1, 0:1, result);
}

:ADD "A0L","A0",wide_load_literal_bits is $(WIDE_ADD_LITERAL_PORT) & wide_alias_add_dst=0x90 & wide_alias_add_lhs=0x88 {
    local result:8;
    wide_add_a0_literal_word(wide_load_literal_bits:2, result);
    A0L = result(2);
}

:ADD "EST","A0",wide_load_literal_bits is $(WIDE_ADD_LITERAL_PORT) & wide_alias_add_dst=0xc1 & wide_alias_add_lhs=0x88 {
    local unused:8;
    wide_add_a0_literal_word(wide_load_literal_bits:2, unused);
}

@undef WIDE_ADD_LITERAL_PORT

:SUB "RMW2","A0L","*R4" is $(WIDE_ROUTED_ALU) & wide_alias_add_op=0 & wide_0_0=0
    & wide_alias_add_dst=0x87 & wide_alias_add_lhs=0x90 & wide_40_45=4 {
    local address:2 = R4;
    local word:2 = *[data]:2 address;
    local left:8 = (sext(A0L) & 0xffffff) << 16;
    local right:8 = (sext(word) & 0xffffff) << 16;
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 1:1, 1:1, 1:1, result);
    result = result >> ((ECFG >> 5) & 1);
    *[data]:2 address = result(2);
}

:ADDC2 "*"^absolute_data_addr,"MINMAX","GB1" is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=0xd & wide_alias_add_dst=0x3b & wide_alias_add_lhs=0xba & wide_40_45=1 & wide_0_0=1 & absolute_data_addr {
    local left:8 = sext(MINMAX);
    local right:8 = zext(GB1);
    local result:8;
    local carry_set:1 = (EST & 0x40) != 0;
    wide_routed_arithmetic(left, right, carry_set, 0:1, 1:1, 1:1, result);
    local address:2 = absolute_data_addr;
    *[data]:2 address = result(2);
}

# The extended source selector supplies a DATA route, not the extra word.
round_extended: "DATA" is wide_0_1=3 & wide_40_45>=0x20 {}
round_high_address: "A0L" is carmel_of_route=2 { export A0L; }
round_high_address: "0" is carmel_of_route=3 { export 0:2; }

wide_unary_gate: "" is carmel_issue=5 & wide_left_mode=1 { export 3:2; }
wide_unary_gate: "CE1" is carmel_issue=4 & wide_left_mode=0 & unary_wide_ce_bank=0 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local gate:2 = enabled | ((CECFG1 >> 11) & 2);
    export gate;
}
wide_unary_gate: "CE2" is carmel_issue=4 & wide_left_mode=0 & unary_wide_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local gate:2 = enabled | ((CECFG2 >> 11) & 2);
    export gate;
}

# A wide ABS extended selector can drive different inputs for different result banks.
# The DATA routes are not fixed by the instruction bits.
@define WIDE_ABS_REGISTER "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_10_22=0x108a & wide_0_1=3"

wide_abs_acc_source: "A0" is wide_40_45=0x20 {
    local bits:8;
    compact_long_sample(A0L, A0H, GB0, bits);
    export bits;
}
wide_abs_acc_source: "-1" is wide_40_45=0x26 { export 0xffffffffff:8; }

:ABS "A0",wide_abs_acc_source is $(WIDE_ABS_REGISTER) & wide_2_9=0x88 & wide_abs_acc_source {
    local source:8 = wide_abs_acc_source;
    local magnitude:8 = (source - ((source << 1) * zext(source >= 0x8000000000))) & 0xffffffffff;
    local result:8;
    local flags:2;
    compact_long_finish(magnitude, 0:1, source == 0x8000000000, 0:1, 0:1, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:ABS "FF2","FF2" is $(WIDE_ABS_REGISTER) & wide_2_9=0x97 & wide_40_45=0x27 {
    local word:2 = FF2;
    local magnitude:2 = word - ((word << 1) * zext(word >= 0x8000));
    local bits:8 = zext(magnitude) << 16;
    local result:8;
    local flags:2;
    compact_long_finish(bits, 0:1, 0:1, 0:1, 0:1, result, flags);
    if ((flags & 0x20) == 0 || (ECFG & 0x28) == 8) goto <publish>;
    flags = flags | 4;
  <publish>
    FF2 = result(2);
    publish_alu_ce((EST & 0xcfc4) | flags);
}
@undef WIDE_ABS_REGISTER

wide_bit_index: "#"^index is wide_40_45 & wide_0_1 [ index = wide_40_45 | (wide_0_1 << 6); ] {
    export *[const]:1 index;
}

@define WIDE_BIT "wide_right_mode=1 & wide_14_22=0x134 & wide_unary_gate & wide_bit_index"
@define WIDE_GUARD_BIT "$(WIDE_BIT) & wide_2_9>=0x80 & wide_2_9<=0x85 & wide_guard_bit_port"

macro wide_guard_bit_write(gate, guard, value) {
    if ((gate & 1) == 0) goto <feedback>;
    guard = value;
  <feedback>
    publish_ce_feedback(EST & 0xcfff, EST);
}

:TESTBIT wide_unary_gate wide_guard_bit_port,wide_bit_index is $(WIDE_GUARD_BIT) & wide_bit_op=0 {
    local flags:2 = EST & 0xcfff;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:1 = 1:1 << wide_bit_index;
    flags = (flags & 0xfff7) | (zext((wide_guard_bit_port & mask) == 0) << 3);
  <feedback>
    publish_ce_feedback(flags, EST);
}

# The mutation input mux sees zero, even though its guard write port is connected.
:SETBIT wide_unary_gate wide_guard_bit_port,wide_bit_index is $(WIDE_GUARD_BIT) & wide_bit_op=1 {
    wide_guard_bit_write(wide_unary_gate, wide_guard_bit_port, 1:1 << wide_bit_index);
}

:CHANGEBIT wide_unary_gate wide_guard_bit_port,wide_bit_index is $(WIDE_GUARD_BIT) & wide_bit_op=2 {
    wide_guard_bit_write(wide_unary_gate, wide_guard_bit_port, 1:1 << wide_bit_index);
}

:CLEARBIT wide_unary_gate wide_guard_bit_port,wide_bit_index is $(WIDE_GUARD_BIT) & wide_bit_op=3 {
    wide_guard_bit_write(wide_unary_gate, wide_guard_bit_port, 0:1);
}

@undef WIDE_GUARD_BIT

wide_bit_mutation: "SETBIT" is wide_bit_op=1 { export 1:1; }
wide_bit_mutation: "CHANGEBIT" is wide_bit_op=2 { export 2:1; }
wide_bit_mutation: "CLEARBIT" is wide_bit_op=3 { export 3:1; }

macro wide_bit_mask(index, mask) {
    # The bit unit spans 40 bits. Bound the host shift without wrapping the architectural index.
    mask = (1:8 << (index & 63)) * zext(index < 40);
}

macro wide_bit_modify(operation, value, mask, result) {
    result = value | mask;
    if (operation == 1) goto <done>;
    result = value ^ mask;
    if (operation == 2) goto <done>;
    result = value & ~mask;
  <done>
}

:TESTBIT wide_unary_gate "RN1",wide_bit_index is $(WIDE_BIT) & wide_2_9=0xa9 & wide_bit_op=0 {
    local flags:2 = EST & 0xcfff;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:8;
    wide_bit_mask(wide_bit_index, mask);
    local value:8 = sext(RN1);
    flags = (flags & 0xfff7) | (zext((value & mask) == 0) << 3);
  <feedback>
    publish_ce_feedback(flags, EST);
}

:^wide_bit_mutation wide_unary_gate "RN1",wide_bit_index is $(WIDE_BIT) & wide_2_9=0xa9 & wide_bit_mutation {
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:8;
    local result:2;
    wide_bit_mask(wide_bit_index, mask);
    wide_bit_modify(wide_bit_mutation, RN1, mask:2, result);
    RN1 = result;
  <feedback>
    publish_ce_feedback(EST & 0xcfff, EST);
}

:TESTBIT wide_unary_gate "A0",wide_bit_index is $(WIDE_BIT) & wide_2_9=0x88 & wide_bit_op=0 {
    local flags:2 = EST & 0xcfff;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:8;
    local value:8;
    wide_bit_mask(wide_bit_index, mask);
    compact_long_sample(A0L, A0H, GB0, value);
    flags = (flags & 0xfff7) | (zext((value & mask) == 0) << 3);
  <feedback>
    publish_ce_feedback(flags, EST);
}

:^wide_bit_mutation wide_unary_gate "A0",wide_bit_index is $(WIDE_BIT) & wide_2_9=0x88 & wide_bit_mutation {
    local flags:2 = EST & 0xcfff;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:8;
    local value:8;
    local result:8;
    wide_bit_mask(wide_bit_index, mask);
    compact_long_sample(A0L, A0H, GB0, value);
    wide_bit_modify(wide_bit_mutation, value, mask, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    flags = (flags & 0xfff7) | (zext(result == 0) << 3);
  <feedback>
    publish_ce_feedback(flags, EST);
}

:TESTBIT wide_unary_gate "long *R0",wide_bit_index is $(WIDE_BIT) & wide_2_9=0x40 & wide_bit_op=0 {
    local flags:2 = EST & 0xcfff;
    if (wide_unary_gate == 0) goto <feedback>;
    local address:2 = R0;
    local next:2 = address + 1;
    local low:2 = *[data]:2 address;
    local high:2 = *[data]:2 next;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:8;
    wide_bit_mask(wide_bit_index, mask);
    local value:4 = (zext(high) << 16) | zext(low);
    local tested:8 = sext(value);
    flags = (flags & 0xfff7) | (zext((tested & mask) == 0) << 3);
  <feedback>
    publish_ce_feedback(flags, EST);
}

:^wide_bit_mutation wide_unary_gate "long *R0",wide_bit_index is $(WIDE_BIT) & wide_2_9=0x40 & wide_bit_mutation {
    local flags:2 = EST & 0xcfff;
    if (wide_unary_gate == 0) goto <feedback>;
    local address:2 = R0;
    local next:2 = address + 1;
    local low:2 = *[data]:2 address;
    local high:2 = *[data]:2 next;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local mask:8;
    local result:8;
    wide_bit_mask(wide_bit_index, mask);
    local value:8 = (zext(high) << 16) | zext(low);
    wide_bit_modify(wide_bit_mutation, value, mask, result);
    *[data]:2 address = result:2;
    *[data]:2 next = result(2);
    flags = (flags & 0xfff7) | (zext(result == 0) << 3);
  <feedback>
    publish_ce_feedback(flags, EST);
}

@undef WIDE_BIT

# Family 50's short port is not the full register selector with its high bit
# restored: 0x7e samples signed FF1 alone; 0x7d and 0x7f are open on select operators.
short_alu_word: short_alu_rhs_addr is wide_40_45>=0x30 & wide_40_45<=0x37 & short_alu_rhs_addr {
    export short_alu_rhs_addr;
}
short_alu_word: "FF1" is wide_40_45=0x3e { export FF1; }
short_alu_reverse_word: short_alu_word is short_alu_word { export short_alu_word; }
short_alu_reverse_word: "0" is (wide_40_45=0x3d | wide_40_45=0x3f) { export 0:2; }

short_alu_reverse_op: "SUBR" is wide_alias_add_op=1 { export 1:2; }
short_alu_reverse_op: "SUBRC1" is wide_alias_add_op=3 { export 3:2; }
short_alu_reverse_op: "SUBRC2" is wide_alias_add_op=7 { export 7:2; }
short_alu_reverse_op: "ADDABS" is wide_alias_add_op=11 { export 11:2; }

@define SHORT_ALU "wide_right_mode=1 & wide_0_0=1 & wide_unary_gate"
@define SHORT_ALU_ACC_DST "wide_alias_add_dst>=0x88 & wide_alias_add_dst<=0x8d & short_alu_dst_acc & short_alu_dst_lo & short_alu_dst_hi & short_alu_dst_guard"
@define SHORT_ALU_LOW_SRC "wide_alias_add_lhs>=0x90 & wide_alias_add_lhs<=0x95 & packed_lhs_lo"
@define SHORT_ALU_LONG_SRC "wide_alias_add_lhs>=0x60 & wide_alias_add_lhs<=0x67 & short_alu_src_ptr & wide_shift_dst_disp"
@define SHORT_ALU_LONG_DST "wide_alias_add_dst>=0x40 & wide_alias_add_dst<=0x47 & short_alu_dst_ptr"

macro short_alu_reverse(first, second, op, unit, word_result, data_result, result) {
    local operation:2 = op;
    local subtract:1 = operation != 11;
    local left:8 = second;
    local right:8 = first;
    local adjust:8 = 0;
    if (operation == 1) goto <compute>;
    if (operation == 11) goto <absolute>;
    local carry_mask:2 = 1;
    if (operation == 3) goto <read_carry>;
    carry_mask = 0x40;
  <read_carry>
    adjust = zext((EST & carry_mask) == 0) * unit;
    goto <compute>;
  <absolute>
    if (right s>= 0) goto <compute>;
    right = 0 - right;
  <compute>
    wide_routed_arithmetic(left, right, adjust, subtract, word_result, data_result, result);
}

macro short_alu_long_source(base, displacement, value) {
    local address:2 = base + displacement;
    local low:2;
    local high:2;
    wide_unary_data_read(address, 2:2, low, high);
    value = sext(high) * 0x10000 + zext(low);
}

macro short_alu_store_long(address, result) {
    local scaled:8 = result >> ((ECFG >> 5) & 1);
    *[data]:2 address = scaled:2;
    local upper:2 = address + 1;
    *[data]:2 upper = scaled(2);
}

:short_alu_reverse_op wide_unary_gate short_alu_dst_acc,packed_lhs_lo,short_alu_reverse_word
is $(SHORT_ALU) & $(SHORT_ALU_ACC_DST) & $(SHORT_ALU_LOW_SRC) & short_alu_reverse_op & short_alu_reverse_word {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local first:8 = sext(packed_lhs_lo);
    local second:8 = sext(short_alu_reverse_word);
    local result:8;
    short_alu_reverse(first, second, short_alu_reverse_op, 1:8, 0:1, 0:1, result);
    short_alu_dst_lo = result:2;
    short_alu_dst_hi = result(2);
    short_alu_dst_guard = result(4);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:short_alu_reverse_op wide_unary_gate "*"^short_alu_dst_ptr^"++",packed_lhs_lo,short_alu_reverse_word
is $(SHORT_ALU) & wide_alias_add_dst>=0x10 & wide_alias_add_dst<=0x17 & $(SHORT_ALU_LOW_SRC)
   & short_alu_reverse_op & short_alu_reverse_word & short_alu_dst_ptr & short_alu_dst_modulo
   & short_alu_dst_bound & short_alu_dst_mode_shift {
    local address:2 = short_alu_dst_ptr;
    if (wide_unary_gate == 0) goto <veto>;
    modify_ptr(short_alu_dst_ptr, 0:2, short_alu_dst_modulo, short_alu_dst_bound, short_alu_dst_mode_shift, 2);
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local first:8 = sext(packed_lhs_lo) * 0x10000;
    local second:8 = sext(short_alu_reverse_word) * 0x10000;
    local result:8;
    short_alu_reverse(first, second, short_alu_reverse_op, 0x10000:8, 1:1, 1:1, result);
    local scaled:8 = result >> ((ECFG >> 5) & 1);
    *[data]:2 address = scaled(2);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:short_alu_reverse_op wide_unary_gate "long *"^short_alu_dst_ptr,"long *"^short_alu_src_ptr^"+"^wide_shift_dst_disp,short_alu_reverse_word
is $(SHORT_ALU) & $(SHORT_ALU_LONG_DST) & $(SHORT_ALU_LONG_SRC) & short_alu_reverse_op & short_alu_reverse_word {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local first:8;
    local delta:2 = sext(wide_shift_dst_disp:1);
    short_alu_long_source(short_alu_src_ptr, delta, first);
    local second:8 = sext(short_alu_reverse_word);
    local result:8;
    short_alu_reverse(first, second, short_alu_reverse_op, 1:8, 0:1, 1:1, result);
    short_alu_store_long(short_alu_dst_ptr, result);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:short_alu_reverse_op wide_unary_gate "*"^short_alu_dst_ptr,"long *"^short_alu_src_ptr^"+"^wide_shift_dst_disp,short_alu_reverse_word
is $(SHORT_ALU) & wide_alias_add_dst<=7 & short_alu_dst_ptr & $(SHORT_ALU_LONG_SRC) & short_alu_reverse_op & short_alu_reverse_word {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local first:8;
    local delta:2 = sext(wide_shift_dst_disp:1);
    short_alu_long_source(short_alu_src_ptr, delta, first);
    local second:8 = sext(short_alu_reverse_word);
    local result:8;
    short_alu_reverse(first, second, short_alu_reverse_op, 1:8, 1:1, 1:1, result);
    local scaled:8 = result >> ((ECFG >> 5) & 1);
    *[data]:2 short_alu_dst_ptr = scaled(2);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:ADD wide_unary_gate "long *"^short_alu_dst_ptr,"long *"^short_alu_src_ptr^"+"^wide_shift_dst_disp,short_alu_word
is $(SHORT_ALU) & wide_alias_add_op=8 & $(SHORT_ALU_LONG_DST) & $(SHORT_ALU_LONG_SRC) & short_alu_word {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local first:8;
    local delta:2 = sext(wide_shift_dst_disp:1);
    short_alu_long_source(short_alu_src_ptr, delta, first);
    local second:8 = sext(short_alu_word);
    local result:8;
    wide_routed_arithmetic(first, second, 0:1, 0:1, 0:1, 1:1, result);
    short_alu_store_long(short_alu_dst_ptr, result);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

# A connected accumulator ADD publishes carry to the primary bank for later issues.
:ADD wide_unary_gate short_alu_dst_acc,packed_lhs_acc,packed_rhs_acc
is $(SHORT_ALU) & wide_alias_add_op=8 & $(SHORT_ALU_ACC_DST)
   & wide_alias_add_lhs>=0x88 & wide_alias_add_lhs<=0x8d & packed_lhs_acc & packed_lhs_lo & packed_lhs_hi & packed_lhs_guard
   & wide_40_45>=8 & wide_40_45<=13 & packed_rhs_acc & packed_rhs_lo & packed_rhs_hi & packed_rhs_guard {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local first:8;
    local second:8;
    compact_long_sample(packed_lhs_lo, packed_lhs_hi, packed_lhs_guard, first);
    compact_long_sample(packed_rhs_lo, packed_rhs_hi, packed_rhs_guard, second);
    local result:8;
    wide_routed_arithmetic(first, second, 0:1, 0:1, 0:1, 0:1, result);
    short_alu_dst_lo = result:2;
    short_alu_dst_hi = result(2);
    short_alu_dst_guard = result(4);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}
@undef SHORT_ALU_LONG_DST
@undef SHORT_ALU_LONG_SRC
@undef SHORT_ALU_LOW_SRC
@undef SHORT_ALU_ACC_DST
@undef SHORT_ALU

# Open result ports do not cancel operand fetch. Arithmetic D3 also
# disconnects status, whereas D8 retains the ALU's aligned word flags.
@define WIDE_SUBRC1_OPEN "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & logic_ce_bank=0 & wide_alias_add_op=3 & wide_0_0=1"
:SUBRC1 "discard","long *("^short_alu_src_ptr^"+"^short_alu_src_step^")",short_alu_rhs_step is $(WIDE_SUBRC1_OPEN)
    & wide_alias_add_dst=0xd3 & wide_alias_add_lhs>=0x68 & wide_alias_add_lhs<=0x6f
    & wide_40_45>=0x28 & wide_40_45<=0x2f & short_alu_src_ptr & short_alu_src_step & short_alu_rhs_step {
    local address:2 = short_alu_src_ptr + short_alu_src_step;
    local low:2;
    local high:2;
    wide_unary_data_read(address, 2:2, low, high);
    publish_alu_ce(EST & 0xcfff);
}

:SUBRC1 "discard",packed_lhs_lo,packed_rhs_lo is $(WIDE_SUBRC1_OPEN) & wide_alias_add_dst=0xd8
    & wide_alias_add_lhs>=0x90 & wide_alias_add_lhs<=0x95 & wide_40_45>=0x10 & wide_40_45<=0x15
    & packed_lhs_lo & packed_rhs_lo {
    local first:8 = sext(packed_lhs_lo) << 16;
    local second:8 = sext(packed_rhs_lo) << 16;
    local result:8;
    short_alu_reverse(first, second, 3:2, 0x10000:8, 1:1, 0:1, result);
}
@undef WIDE_SUBRC1_OPEN

:^wide_logic_rmw_operator wide_unary_gate wide_logic_dst_hi,"0","*"^wide_move_base^"--"
is $(WIDE_LOGIC_CE) & unary_wide_ce_bank=0 & wide_alias_logic_lhs=0xd8 & wide_0_1=0
    & wide_alias_logic_dst>=0x98 & wide_alias_logic_dst<=0x9d & wide_40_45>=0x18 & wide_40_45<=0x1f
    & wide_unary_gate & wide_logic_dst_hi & wide_move_base & wide_logic_rhs_modulo & wide_logic_rhs_bound
    & wide_logic_rhs_mode_shift {
    local flags:2 = EST & 0xcfff;
    if (wide_unary_gate == 0) goto <publish>;
    local address:2 = wide_move_base;
    local word:2 = *[data]:2 address;
    modify_ptr(wide_move_base, 0:2, wide_logic_rhs_modulo, wide_logic_rhs_bound, wide_logic_rhs_mode_shift, 3);
    if ((wide_unary_gate & 1) == 0) goto <publish>;
    local result:2;
    wide_logic_bitop(wide_logic_rmw_operator, 0:2, word, result);
    wide_logic_dst_hi = result;
    flags = (flags & 0xffc7) | (zext(result == 0) << 3);
  <publish>
    publish_alu_ce(flags);
}

:^wide_logic_rmw_operator "discard","long *"^wide_logic_lhs_ptr^"+="^wide_shift_dst_disp,wide_move_base
is $(WIDE_ALIAS_ALU) & wide_20_22=6 & wide_logic_rmw_operator & wide_alias_logic_dst=0xd8 & wide_0_1=2
    & wide_alias_logic_lhs>=0x70 & wide_alias_logic_lhs<=0x77 & wide_40_45>=0x20 & wide_40_45<=0x27
    & wide_logic_lhs_ptr & wide_logic_lhs_modulo & wide_logic_lhs_bound & wide_logic_lhs_mode_shift
    & wide_shift_dst_disp & wide_move_base {
    local address:2 = wide_logic_lhs_ptr;
    local rhs:2 = wide_move_base;
    local low:2;
    local high:2;
    wide_unary_data_read(address, 2:2, low, high);
    local delta:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(wide_logic_lhs_ptr, delta, wide_logic_lhs_modulo, wide_logic_lhs_bound, wide_logic_lhs_mode_shift, 4);
    local lhs:4 = zext(low) | (zext(high) << 16);
    local result:4;
    wide_logic_bitop(wide_logic_rmw_operator, lhs, zext(rhs), result);
    local flags:2 = (zext(result == 0) << 3) | (zext(result >= 0x80000000) << 5);
    publish_alu_ce((EST & 0xcfc7) | flags);
}

:XOR wide_unary_gate "*"^absolute_data_addr,"-1" is wide_right_mode=1 & wide_0_1=1 & unary_wide_ce_bank=1
    & wide_left_mode=0 & carmel_issue=4 & wide_unary_gate & wide_logic_accumulate_family=0xe & wide_logic_accumulate_op=2
    & wide_logic_accumulate_dst>=0x38 & wide_logic_accumulate_dst<=0x3f & wide_logic_accumulate_src=0x4e & absolute_data_addr {
    local flags:2 = EST & 0xcfff;
    if (wide_unary_gate == 0) goto <publish>;
    local address:2 = absolute_data_addr;
    local word:2 = *[data]:2 address;
    if ((wide_unary_gate & 1) == 0) goto <publish>;
    *[data]:2 address = ~word;
    # The all-ones input spans 40 bits; the original DATA is zero-extended.
    flags = (flags & 0xffc7) | 0x10;
  <publish>
    publish_alu_ce(flags);
}


macro wide_round_write_long(address, low, high, flags) {
    local scale:4 = zext((ECFG >> 5) & 1);
    local bits:4 = zext(high);
    local upper:4 = bits >> scale;
    local midpoint:1 = low == 0x8000;
    local above:1 = low > 0x8000;
    if (scale == 0) goto <apply_round>;
    local extra_bit:1 = (high & 1) != 0;
    midpoint = extra_bit && low == 0;
    above = extra_bit && low != 0;
  <apply_round>
    local increment:1 = above || (midpoint && ((ECFG & 2) == 0 || (upper & 1) != 0));
    upper = upper + zext(increment);
    # A signed 32-bit input can extend positively, but cannot overflow the 40-bit adder.
    local sign:4 = 0x8000 >> scale;
    local carry_out:1 = upper == sign * 2;
    local negative:1 = high >= 0x8000 && !carry_out;
    local extend:1 = high < 0x8000 && upper == sign;
    flags = zext(carry_out) | (zext(upper == 0 || carry_out) << 3) |
            (zext(negative) << 4) | (zext(extend) * 0x24);
    if (!extend || ((ECFG & 4) == 0 && (ECFG & 0x28) != 8)) goto <store>;
    upper = sign - 1;
  <store>
    local word:4 = (upper & (sign * 2 - 1)) | (zext(negative) * scale << 15);
    local second:2 = address + 1;
    *[data]:2 address = 0;
    *[data]:2 second = word:2;
}

@define WIDE_ROUND_DATA "wide_right_mode=1 & wide_10_22=0x10b6 & wide_unary_gate"
:ROUND wide_unary_gate "long *R1+=RN1",round_extended^":"^round_high_address is $(WIDE_ROUND_DATA) & wide_2_9=0x49 & round_extended & round_high_address {
    local gate:2 = wide_unary_gate;
    local flags:2 = EST & 0x3f;
    if (gate == 0) goto <done>;
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    if ((gate & 1) == 0) goto <done>;
    local low:2 = *[data]:2 0xffff:2;
    local high:2 = *[data]:2 round_high_address;
    wide_round_write_long(address, low, high, flags);
  <done>
    publish_alu_ce((EST & 0xcfc0) | flags);
}

:ROUND wide_unary_gate "long *R1+=RN1","long *R1" is $(WIDE_ROUND_DATA) & wide_2_9=0x49 & wide_40_45=1 & wide_0_1=1 {
    local gate:2 = wide_unary_gate;
    local flags:2 = EST & 0x3f;
    if (gate == 0) goto <done>;
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    if ((gate & 1) == 0) goto <done>;
    local low:2;
    local high:2;
    wide_unary_data_read(address, 2:2, low, high);
    wide_round_write_long(address, low, high, flags);
  <done>
    publish_alu_ce((EST & 0xcfc0) | flags);
}

:ROUND wide_unary_gate "*R1+=RN1",round_extended is $(WIDE_ROUND_DATA) & wide_2_9=9 & round_extended {
    local gate:2 = wide_unary_gate;
    local flags:2 = EST & 0x3f;
    if (gate == 0) goto <done>;
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    if ((gate & 1) == 0) goto <done>;
    local word:2 = *[data]:2 0xffff:2;
    *[data]:2 address = word;
    flags = (zext(word == 0) << 3) | (zext(word >= 0x8000) << 4);
  <done>
    publish_alu_ce((EST & 0xcfc0) | flags);
}

:ROUND wide_unary_gate "FF1","*R6+RN6" is wide_right_mode=1 & wide_10_22=0x10b7 & wide_2_9=0xbe & wide_0_1=0 & wide_40_45=0x2e & wide_unary_gate {
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local address:2 = R6 + RN6;
    local word:2 = *[data]:2 address;
    FF1 = word;
    unary_limit_flags(word);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

# Plain indirect long input still reads both DATA words when the result
# selector has neither a writeback port nor an arithmetic flag port.
@define WIDE_ROUND_R1 "$(WIDE_ROUND_DATA) & wide_40_45=1 & wide_0_1=1"
:ROUND wide_unary_gate round_result_selector,"long *R1" is $(WIDE_ROUND_R1) & wide_2_9>=0xe0 & round_result_selector {
    if (wide_unary_gate == 0) goto <feedback>;
    local address:2 = R1;
    local low:2 = *[data]:2 address;
    local upper:2 = address + 1;
    local high:2 = *[data]:2 upper;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:ROUND wide_unary_gate "A2L","long *R1" is $(WIDE_ROUND_R1) & wide_2_9=0x92 {
    local flags:2 = EST & 0xcfff;
    if (wide_unary_gate == 0) goto <feedback>;
    local address:2 = R1;
    local low:2 = *[data]:2 address;
    local upper:2 = address + 1;
    local high:2 = *[data]:2 upper;
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local increment:1 = low > 0x8000 ||
        (low == 0x8000 && ((ECFG & 2) == 0 || (high & 1) != 0));
    local word:2 = high + zext(increment);
    local carry_out:1 = high == 0xffff && increment;
    local extend:1 = high == 0x7fff && increment;
    local limit:1 = extend && (ECFG & 4) != 0;
    local sticky:1 = extend && (ECFG & 0x2c) != 8;
    local rounded_zero:1 = carry_out || (high == 0 && !increment);
    flags = (flags & 0xffc4) | zext(carry_out) | (zext(sticky) << 2) |
        (zext(rounded_zero) << 3) | (zext(high >= 0x8000 && !carry_out) << 4) | (zext(extend) << 5);
    if (!limit) goto <write>;
    word = 0x7fff;
  <write>
    A2L = word;
  <feedback>
    publish_alu_ce(flags);
}
@undef WIDE_ROUND_R1
@undef WIDE_ROUND_DATA

@define WIDE_LIMIT "wide_right_mode=1 & (wide_10_22=0x10b8 | wide_10_22=0x10bb) & wide_unary_gate"

limit_word: "FF1" is wide_0_1=2 & wide_40_45=0x16 { export FF1; }
limit_word: "FF2" is wide_0_1=2 & wide_40_45=0x17 { export FF2; }
limit_word: "A0L" is wide_0_1=2 & wide_40_45=0x10 { export A0L; }
limit_word: "A0H" is wide_0_1=2 & wide_40_45=0x18 { export A0H; }
limit_word: alias_of_word is wide_0_1=2 & wide_40_45=0xf & (carmel_of_route=2 | carmel_of_route=3) & alias_of_word {
    build alias_of_word;
    export alias_of_word;
}

limit_acc: "A0" is wide_0_1=2 & wide_40_45=8 {
    local raw:8 = zext(GB0) * 0x100000000 + zext(A0H) * 0x10000 + zext(A0L);
    export raw;
}
limit_acc: "A1" is wide_0_1=2 & wide_40_45=9 {
    local raw:8 = zext(GB1) * 0x100000000 + zext(A1H) * 0x10000 + zext(A1L);
    export raw;
}

limit_word_dst: "A1L" is wide_2_9=0x91 { export A1L; }
limit_word_dst: "A0H" is wide_2_9=0x98 { export A0H; }
limit_word_dst: "A1H" is wide_2_9=0x99 { export A1H; }
limit_word_dst: "LC" is wide_2_9=0xd4 { export LC1; }
limit_word_dst: "*R1+="^wide_shift_dst_disp is wide_2_9=0x31 & wide_shift_dst_disp {
    local address:2 = R1;
    local delta:2 = sext(wide_shift_dst_disp:1);
    transfer_address_word(R1, RM0, RL0, 2, delta, R1);
    export *[data]:2 address;
}

:LIM wide_unary_gate "*R5+=RN5",round_extended is wide_right_mode=1 & wide_10_22=0x10b8 & wide_2_9=0xd & round_extended & wide_unary_gate {
    local gate:2 = wide_unary_gate;
    if (gate == 0) goto <feedback>;
    local address:2 = R5;
    modify_ptr(R5, RN5, RM4, RL4, 10, 1);
    if ((gate & 1) == 0) goto <feedback>;
    local word:2 = *[data]:2 0xffff:2;
    *[data]:2 address = word;
    unary_limit_flags(word);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LIM wide_unary_gate "long *R5+=RN5",round_extended^":"^round_high_address is wide_right_mode=1 & wide_10_22=0x10b8 & wide_2_9=0x4d & round_extended & round_high_address & wide_unary_gate {
    local gate:2 = wide_unary_gate;
    if (gate == 0) goto <feedback>;
    local address:2 = R5;
    modify_ptr(R5, RN5, RM4, RL4, 10, 1);
    if ((gate & 1) == 0) goto <feedback>;
    local low:2 = *[data]:2 0xffff:2;
    local high:2 = *[data]:2 round_high_address;
    local flags:2 = (zext((low | high) == 0) << 3) | (zext(high >= 0x8000) << 4);
    EST = (EST & 0xffc4) | flags;
    *[data]:2 address = low;
    local second:2 = address + 1;
    *[data]:2 second = high;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

limit_acc_dst: "A0" is wide_2_9=0x88 {}
limit_acc_dst: "A1" is wide_2_9=0x89 {}
limit_dst_low: is wide_2_9=0x88 { export A0L; }
limit_dst_low: is wide_2_9=0x89 { export A1L; }
limit_dst_high: is wide_2_9=0x88 { export A0H; }
limit_dst_high: is wide_2_9=0x89 { export A1H; }
limit_dst_guard: is wide_2_9=0x88 { export GB0; }
limit_dst_guard: is wide_2_9=0x89 { export GB1; }

# Explicit signed-32 limiting ignores ECFG. Z samples the selected result
# width, M and E sample the incoming 40 bits, and limiting sets sticky L.
macro limit_acc_value(raw, word_result, value) {
    local flags:2;
    shift_flags(raw, 0:1, flags);
    if (word_result == 0 || (raw >> 16) != 0) goto <clamp>;
    flags = flags | 8;
  <clamp>
    value = raw;
    if ((flags & 0x20) == 0) goto <commit>;
    local negative:8 = zext((flags & 0x10) != 0);
    value = 0x7fffffff + negative * 0xff00000001;
    flags = flags | 4;
  <commit>
    EST = (EST & 0xffc4) | flags;
}

:LIM wide_unary_gate limit_word_dst,limit_word is $(WIDE_LIMIT) & limit_word_dst & limit_word {
    local gate:2 = wide_unary_gate;
    if (gate == 0) goto <feedback>;
    build limit_word_dst;
    build limit_word;
    if ((gate & 1) == 0) goto <feedback>;
    local word:2 = limit_word;
    limit_word_dst = word;
    unary_limit_flags(word);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LIM wide_unary_gate limit_word_dst,limit_acc is $(WIDE_LIMIT) & limit_word_dst & limit_acc {
    local gate:2 = wide_unary_gate;
    if (gate == 0) goto <feedback>;
    build limit_word_dst;
    if ((gate & 1) == 0) goto <feedback>;
    local value:8;
    limit_acc_value(limit_acc, 1:1, value);
    limit_word_dst = value(2);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

@define LIMIT_ACC_DST "limit_acc_dst & limit_dst_low & limit_dst_high & limit_dst_guard"
:LIM wide_unary_gate limit_acc_dst,limit_word is $(WIDE_LIMIT) & $(LIMIT_ACC_DST) & limit_word {
    local gate:2 = wide_unary_gate;
    if (gate == 0) goto <feedback>;
    build limit_word;
    if ((gate & 1) == 0) goto <feedback>;
    local word:2 = limit_word;
    limit_dst_low = word;
    local sign:2 = 0 - zext(word >= 0x8000);
    limit_dst_high = sign;
    limit_dst_guard = sign:1;
    unary_limit_flags(word);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LIM wide_unary_gate limit_acc_dst,limit_acc is $(WIDE_LIMIT) & $(LIMIT_ACC_DST) & limit_acc {
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local value:8;
    limit_acc_value(limit_acc, 0:1, value);
    limit_dst_low = value:2;
    limit_dst_high = value(2);
    limit_dst_guard = value(4);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LIM wide_unary_gate "IO",limit_acc is $(WIDE_LIMIT) & wide_2_9=0xd8 & limit_acc {
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local discarded:8;
    limit_acc_value(limit_acc, 1:1, discarded);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LIM wide_unary_gate "0xe8",limit_acc is $(WIDE_LIMIT) & wide_2_9=0xe8 & limit_acc {
    if ((wide_unary_gate & 1) == 0) goto <feedback>;
    local flags:2;
    shift_flags(limit_acc, 0:1, flags);
    local extension:2 = flags & 0x20;
    EST = (EST & 0xffdc) | extension | (extension >> 3);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LIM wide_unary_gate "IO","*R3+="^wide_shift_dst_disp is $(WIDE_LIMIT) & wide_2_9=0xd8 & wide_0_1=0 & wide_40_45=0x33 & wide_shift_dst_disp {
    local gate:2 = wide_unary_gate;
    if (gate == 0) goto <feedback>;
    local address:2 = R3;
    local delta:2 = sext(wide_shift_dst_disp:1);
    transfer_address_word(R3, RM2, RL2, 6, delta, R3);
    local word:2 = *[data]:2 address;
    if ((gate & 1) == 0) goto <feedback>;
    unary_limit_flags(word);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

# These implicit DATA operands need established OF context, not a CODE-address guess.
:SUBRC1 "CE1" "long *R1+="^wide_shift_dst_disp,"*R3+RN3",alias_of_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & logic_ce_bank=0 & wide_alias_add_op=3 & wide_alias_add_dst=0x71 & wide_alias_add_lhs=0xf5 & wide_40_45=0x2b & wide_0_0=0 & wide_shift_dst_disp & carmel_of_route=2 & alias_of_word {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local destination:2 = R1;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <veto>;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(R1, displacement, RM0, RL0, 2, 4);
    if (enabled == 0) goto <veto>;
    build alias_of_word;
    local source:2 = R3 + RN3;
    local low:2 = *[data]:2 source;
    local high:2 = *[data]:2 0:2;
    local first:4 = zext(low) | (zext(high) << 16);
    local left:8 = sext(alias_of_word);
    local right:8 = (zext(first) ^ 0x80000000) - 0x80000000;
    local result:8;
    local carry_clear:1 = (EST & 1) == 0;
    wide_routed_arithmetic(left, right, carry_clear, 1:1, 0:1, 1:1, result);
    *[data]:2 destination = result:2;
    local upper:2 = destination + 1;
    *[data]:2 upper = result(2);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:ADDABS "SP","RL6","RL0" is $(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0xb & wide_alias_add_dst=0xbb & wide_alias_add_lhs=0xe5 & wide_40_45=0x30 & wide_0_0=1 {
    local left:8 = (zext(RL6) ^ 0x8000) - 0x8000;
    if (RL6 < 0x8000) goto <positive>;
    left = 0 - left;
  <positive>
    left = (left & 0xffffffffff) << 16;
    local right:8 = (zext(RL0) ^ 0x8000) - 0x8000;
    right = (right & 0xffffffffff) << 16;
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 0:1, 1:1, 0:1, result);
    SP = result(2);
}

:ADDC2 "RM6","FF1","X2" is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=0xd & wide_alias_add_dst=0xb7 & wide_alias_add_lhs=0xee & wide_40_45=0x1f & wide_0_0=1 {
    local left:8 = (sext(FF1) & 0xffffffffff) << 16;
    local right:8 = (sext(X2) & 0xffffffffff) << 16;
    local result:8;
    local carry_set:1 = (EST & 0x40) != 0;
    wide_routed_arithmetic(left, right, carry_set, 0:1, 1:1, 0:1, result);
    RM6 = result(2);
}

:SUBC1 "*"^absolute_data_addr,"*R4++",alias_of_word is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=2 & wide_alias_add_dst=0x3a & wide_alias_add_lhs=0xfa & wide_40_45=0x14 & wide_0_0=0 & absolute_data_addr & carmel_of_route=2 & alias_of_word {
    local address:2 = R4;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local word:2 = *[data]:2 address;
    local left:8 = (sext(word) & 0xffffffffff) << 16;
    local right:8 = (sext(alias_of_word) & 0xffffffffff) << 16;
    local result:8;
    local carry_clear:1 = (EST & 1) == 0;
    local word_adjust:4 = zext(carry_clear) << 16;
    wide_routed_arithmetic(left, right, word_adjust, 1:1, 1:1, 1:1, result);
    local destination:2 = absolute_data_addr;
    *[data]:2 destination = result(2);
}

:SUBRC1 "long *R4--","A2","long *R0" is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=3 & wide_alias_add_dst=0x5c & wide_alias_add_lhs=0x40 & wide_40_45=0xa & wide_0_0=1 {
    local destination:2 = R4;
    modify_ptr_scaled(R4, RN4, RM4, RL4, 8, 3, 2:2);
    local low:2;
    local high:2;
    wide_unary_data_read(R0, 2:2, low, high);
    local input:4 = zext(low) | (zext(high) << 16);
    local right:8 = (zext(input) ^ 0x80000000) - 0x80000000;
    local left:8;
    compact_long_sample(A2L, A2H, GB2, left);
    local result:8;
    local carry_clear:1 = (EST & 1) == 0;
    wide_routed_arithmetic(left, right, carry_clear, 1:1, 0:1, 1:1, result);
    *[data]:2 destination = result:2;
    local upper:2 = destination + 1;
    *[data]:2 upper = result(2);
}

:SUB "PSTATUS","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0 & wide_alias_add_dst=0xd5 & wide_alias_add_lhs=0x30 & wide_40_45=0x2f & wide_0_0=1 & wide_shift_dst_disp {
    local address:2 = R0;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(R0, displacement, RM0, RL0, 0, 4);
    local word:2 = *[data]:2 address;
    publish_alu_ce(EST & 0xcfff);
}

macro wide_sub_r0_disp(displacement, word) {
    local address:2 = R0;
    modify_ptr(R0, displacement, RM0, RL0, 0, 4);
    word = *[data]:2 address;
}

macro wide_sub_word(lhs, rhs, to_data, word) {
    local left:8 = (sext(lhs) & 0xffffff) << 16;
    local right:8 = (sext(rhs) & 0xffffff) << 16;
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 1:1, 1:1, to_data, result);
    word = result(2);
}

# Direct USER_IO has no result or flag port, but still fetches DATA.
# The IO selector instead drives the word flags without doing an IO access.
@define WIDE_SUB_R0_RN7 "$(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0 & wide_alias_add_lhs=0x30 & wide_40_45=0x2f & wide_0_0=1 & wide_shift_dst_disp"
:SUB "USER_IO","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_SUB_R0_RN7) & wide_alias_add_dst=0xd7 {
    local word:2;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    wide_sub_r0_disp(displacement, word);
    publish_alu_ce(EST & 0xcfff);
}
:SUB "INTBASE","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_SUB_R0_RN7) & wide_alias_add_dst=0xd6 {
    local word:2;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    wide_sub_r0_disp(displacement, word);
    wide_sub_word(word, RN7, 0:1, INTBASE);
}
:SUB "IO","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_SUB_R0_RN7) & wide_alias_add_dst=0xd8 {
    local word:2;
    local discarded:2;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    wide_sub_r0_disp(displacement, word);
    wide_sub_word(word, RN7, 0:1, discarded);
}

macro wide_control_word(value, word) {
    local bits:8 = value & 0xffffffffff;
    word = bits(2);
    if ((ECFG & 4) == 0 || ((bits ^ (bits >> 1)) & 0x80000000) == 0) goto <done>;
    word = 0x7fff + zext(bits >= 0x8000000000);
  <done>
}

# The control aliases take the high word of an unaligned subtraction,
# including the borrow from the low bits, without changing ALU flags.
macro wide_sub_control(lhs, rhs, word) {
    local difference:8 = sext(lhs) - rhs;
    wide_control_word(difference, word);
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_SUB_RMW "$(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0 & wide_alias_add_dst=0x86 & wide_0_0=1"
:SUB "PSTATUS","PSTATUS","RN7" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd5 & wide_40_45=0x2f {
    local word:2;
    wide_sub_control(PSTATUS, sext(RN7), word);
    wide_logic_rmw_pstatus(word);
}
:SUB "PSTATUS","PSTATUS","A0" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd5 & wide_40_45=8 {
    local source:8;
    compact_long_sample(A0L, A0H, GB0, source);
    local word:2;
    wide_sub_control(PSTATUS, source, word);
    wide_logic_rmw_pstatus(word);
}
:SUB "USER_IO","USER_IO","RN7" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd7 & wide_40_45=0x2f {
    wide_sub_control(USER_IO, sext(RN7), USER_IO);
}
:SUB "USER_IO","USER_IO","A0" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd7 & wide_40_45=8 {
    local source:8;
    compact_long_sample(A0L, A0H, GB0, source);
    wide_sub_control(USER_IO, source, USER_IO);
}
:SUB "*R0++","*R0++","RN7" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0x10 & wide_40_45=0x2f {
    local address:2 = R0;
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
    local word:2 = *[data]:2 address;
    local result:2;
    wide_sub_word(word, RN7, 1:1, result);
    *[data]:2 address = result;
}

wide_add_intbase_low: "LSA1" is wide_intbase_add_port=2 {
    local value:8 = (zext(LSA1H) << 16) | zext(LSA1L);
    export value;
}
wide_add_intbase_low: "LEA1" is wide_intbase_add_port=3 {
    local value:8 = (zext(LEA1H) << 16) | zext(LEA1L);
    export value;
}
wide_add_intbase_low: "PSTATUS" is wide_intbase_add_port=5 {
    local value:8 = sext(PSTATUS);
    export value;
}
wide_add_intbase_low: "USER_IO" is wide_intbase_add_port=7 {
    local value:8 = sext(USER_IO);
    export value;
}

macro wide_add_intbase(left, right) {
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 0:1, 1:1, 0:1, result);
    INTBASE = result(2);
}

macro wide_add_intbase_aligned(gate, source, half) {
    if ((gate & 1) == 0) goto <veto>;
    local left:8 = sext(source) << 16;
    local right:8 = sext(half) << 16;
    wide_add_intbase(left, right);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

@define WIDE_ADD_INTBASE "wide_right_mode=1 & wide_0_0=1 & wide_unary_gate & wide_alias_add_op=8 & wide_alias_add_dst=0xd6 & wide_intbase_add_bank=7"
@define WIDE_ADD_INTBASE_HALF "wide_40_45>=0x10 & wide_40_45<=0x15 & packed_rhs_lo"
:ADD wide_unary_gate "INTBASE",wide_add_intbase_low,packed_rhs_lo
is $(WIDE_ADD_INTBASE) & $(WIDE_ADD_INTBASE_HALF) & wide_add_intbase_low {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    build wide_add_intbase_low;
    local right:8 = sext(packed_rhs_lo);
    wide_add_intbase(wide_add_intbase_low, right);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}
:ADD wide_unary_gate "INTBASE","LC1",packed_rhs_lo
is $(WIDE_ADD_INTBASE) & $(WIDE_ADD_INTBASE_HALF) & wide_intbase_add_port=4 {
    wide_add_intbase_aligned(wide_unary_gate, LC1, packed_rhs_lo);
}
:ADD wide_unary_gate "INTBASE","INTBASE",packed_rhs_lo
is $(WIDE_ADD_INTBASE) & $(WIDE_ADD_INTBASE_HALF) & wide_intbase_add_port=6 {
    wide_add_intbase_aligned(wide_unary_gate, INTBASE, packed_rhs_lo);
}
:ADD wide_unary_gate "INTBASE","0",packed_rhs_lo
is $(WIDE_ADD_INTBASE) & $(WIDE_ADD_INTBASE_HALF) & wide_intbase_add_port=8 {
    wide_add_intbase_aligned(wide_unary_gate, 0:2, packed_rhs_lo);
}
:ADD wide_unary_gate "INTBASE","PACFG",packed_rhs_lo
is $(WIDE_ADD_INTBASE) & $(WIDE_ADD_INTBASE_HALF) & wide_intbase_add_port=10 {
    wide_add_intbase_aligned(wide_unary_gate, PACFG, packed_rhs_lo);
}
:ADD wide_unary_gate "INTBASE","0",packed_rhs_acc
is $(WIDE_ADD_INTBASE) & wide_40_45>=8 & wide_40_45<=13 & wide_intbase_add_port=8
    & packed_rhs_acc & packed_rhs_lo & packed_rhs_hi & packed_rhs_guard {
    if ((wide_unary_gate & 1) == 0) goto <veto>;
    local right:8;
    compact_long_sample(packed_rhs_lo, packed_rhs_hi, packed_rhs_guard, right);
    wide_add_intbase(0:8, right);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}
@undef WIDE_ADD_INTBASE_HALF
@undef WIDE_ADD_INTBASE

macro compact_rmw_r3(cfg, bank, address, enabled) {
    address = R3;
    local ce_bank:2 = zext(bank);
    unary_ce(cfg, EST, CETBL, ce_bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <done>;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
  <done>
}

macro compact_rmw_half(cfg, bank, subtract, write_half, store) {
    local enabled:2;
    local address:2;
    compact_rmw_r3(cfg, bank, address, enabled);
    if (enabled == 0) goto <done>;
    local word:2 = *[data]:2 address;
    local mask:8 = 0xffffffffff;
    local a:8 = (sext(A5H) << 16) & mask;
    local b:8 = (sext(word) << 16) & mask;
    local raw:8 = a + b;
    if (subtract == 0) goto <finish>;
    raw = a + ((~b) & mask) + 1;
  <finish>
    local result:8;
    local flags:2;
    compact_long_finish(raw & mask, raw > mask, 0:1, store, 0:1, result, flags);
    if (store != 0) goto <data_writeback>;
    if ((flags & 0x20) == 0 || (ECFG & 0x28) == 8) goto <write_register>;
    flags = flags | 4;
  <write_register>
    if (write_half == 0) goto <status>;
    A5H = result(2);
    goto <status>;
  <data_writeback>
    *[data]:2 address = result(2);
  <status>
    local shift:4 = zext(bank) * 6;
    local status_bits:2 = (EST & ~(0x3000 | (0x3b << shift))) | (flags << shift);
    publish_alu_ce(status_bits);
  <done>
}

macro compact_rmw_register(cfg, bank, target, connected) {
    local enabled:2;
    local address:2;
    compact_rmw_r3(cfg, bank, address, enabled);
    if (enabled == 0) goto <done>;
    local value:2 = *[data]:2 address;
    if (connected == 0) goto <status>;
    target = target + value;
  <status>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:"ADD" "CE1" "RMW1","A5H","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10b757); (slot_mode=0 & nop_right) { compact_rmw_half(CECFG1, 0:1, 0:1, 0:1, 0:1); }
:^nop_left "||" "ADD" "CE2" "RMW1","A5H","*R3+=RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x10b757) { compact_rmw_half(CECFG2, 1:1, 0:1, 1:1, 0:1); }
:"ADD" "CE1" "RMW1","A5H","*R3+=RN3" is carmel_issue=2 & slot_mode=1 & slot_0_22=0x10b757 { compact_rmw_half(CECFG1, 0:1, 0:1, 1:1, 0:1); }
:"ADD" "CE1" "RMW2","A5H","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10bf57); (slot_mode=0 & nop_right) { compact_rmw_half(CECFG1, 0:1, 0:1, 0:1, 1:1); }
:"SUB" "CE1" "RMW1","A5H","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0xb757); (slot_mode=0 & nop_right) { compact_rmw_half(CECFG1, 0:1, 1:1, 0:1, 0:1); }
:^nop_left "||" "SUB" "CE2" "RMW1","A5H","*R3+=RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0xb757) { compact_rmw_half(CECFG2, 1:1, 1:1, 1:1, 0:1); }
:"ADD" "CE1" "RMW1","R0","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10b017); (slot_mode=0 & nop_right) { compact_rmw_register(CECFG1, 0:1, R0, 0:1); }
:^nop_left "||" "ADD" "CE2" "RMW1","R0","*R3+=RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x10b017) { compact_rmw_register(CECFG2, 1:1, R0, 1:1); }
:"ADD" "CE1" "RMW1","FF1","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10b597); (slot_mode=0 & nop_right) { compact_rmw_register(CECFG1, 0:1, FF1, 1:1); }
:"ADD" "CE1" "RMW1","RN1","*R2+RN2" is carmel_issue=2 & slot_mode=1 & slot_0_22=0x136c95 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <done>;
    local address:2 = R2 + RN2;
    local value:2 = *[data]:2 address;
    RN1 = RN1 + value;
    publish_alu_ce(EST & 0xcfff);
  <done>
}

# Selector 14 uses the physical ALU's latch; selector 15 explicitly uses X2.
x_alu_primary_rhs: "X1" is slot_1_4=14 { export X1; }
x_alu_primary_rhs: "X2" is slot_1_4=15 { export X2; }
x_alu_secondary_rhs: "X2" is (slot_1_4=14 | slot_1_4=15) { export X2; }
x_alu_secondary_lhs: "X2" is (slot_6_9=14 | slot_6_9=15) { export X2; }

macro compact_x_sum(lhs, rhs, sum, flags) {
    sum = sext(lhs) + sext(rhs);
    local lhs_negative:1 = lhs >= 0x8000;
    local rhs_negative:1 = rhs >= 0x8000;
    local negative:1 = sum s< 0;
    # Carry from sign-extended inputs requires two negatives, or a
    # negative plus a nonnegative whose sum reaches zero.
    local carry_out:1 = (lhs_negative && rhs_negative) || (!negative && (lhs_negative || rhs_negative));
    flags = zext(carry_out) | (zext(sum == 0) << 3) | (zext(negative) << 4);
}

macro compact_x_add_half(target, lhs, rhs, cfg, bank) {
    local enabled:2;
    local status:2 = EST & 0xcfff;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0) goto <feedback>;
    local sum:4;
    local flags:2;
    compact_x_sum(lhs, rhs, sum, flags);
    target = sum:2;
    # A half sees the signed sum above bit 16: E and sticky L describe
    # the discarded extension, not the sign bit of the truncated word.
    if (sum s>= -0x8000 && sum s<= 0x7fff) goto <publish>;
    flags = flags | 0x20;
    if ((ECFG & 4) == 0) goto <unlimited>;
    target = 0x7fff + zext(sum s< 0);
    flags = flags | 4;
    goto <publish>;
  <unlimited>
    if ((ECFG & 0x28) == 8) goto <publish>;
    flags = flags | 4;
  <publish>
    local shift:4 = zext(bank) * 6;
    status = (status & ~(0x3b << shift)) | (flags << shift);
  <feedback>
    publish_alu_ce(status);
}

macro compact_x_add_acc(lo, hi, guard, lhs, rhs) {
    local enabled:2;
    local status:2 = EST & 0xcfff;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <feedback>;
    local sum:4;
    local flags:2;
    compact_x_sum(lhs, rhs, sum, flags);
    lo = sum:2;
    hi = 0 - zext(sum s< 0);
    guard = hi:1;
    status = (status & ~(0x3b << 6)) | (flags << 6);
  <feedback>
    publish_alu_ce(status);
}

macro compact_x_or_acc(lo, hi, guard, lhs, rhs) {
    local enabled:2;
    local status:2 = EST & 0xcfff;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <feedback>;
    local word:2 = lhs | rhs;
    lo = word;
    hi = 0;
    guard = 0;
    status = (status & ~(0x38 << 6)) | (zext(word == 0) << 9);
  <feedback>
    publish_alu_ce(status);
}

@define X_ALU_ADD_HALF "slot_14_22=0x48 & slot_0_0=1 & slot_10_12<6 & x_alu_half_dst & parallel_word_src>=16 & slot_5_7<6 & x_alu_half_src"
@define X_ALU_ACC "slot_mode=0 & slot_0_0=1 & slot_10_12<6 & x_alu_acc & x_alu_acc_lo & x_alu_acc_hi & x_alu_acc_gb & x_alu_secondary_lhs & slot_1_5<30 & logical_right"

:ADD "CE1" x_alu_half_dst,x_alu_half_src,x_alu_primary_rhs is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & $(X_ALU_ADD_HALF) & x_alu_primary_rhs { compact_x_add_half(x_alu_half_dst, x_alu_half_src, x_alu_primary_rhs, CECFG1, 0:2); }
:ADD "CE1" x_alu_half_dst,x_alu_half_src,x_alu_primary_rhs "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(X_ALU_ADD_HALF) & x_alu_primary_rhs); (slot_mode=0 & nop_right) { compact_x_add_half(x_alu_half_dst, x_alu_half_src, x_alu_primary_rhs, CECFG1, 0:2); }
:^nop_left "||" "ADD" "CE2" x_alu_half_dst,x_alu_half_src,x_alu_secondary_rhs is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(X_ALU_ADD_HALF) & x_alu_secondary_rhs) { compact_x_add_half(x_alu_half_dst, x_alu_half_src, x_alu_secondary_rhs, CECFG2, 1:2); }
:^nop_left "||" "ADD" "CE2" x_alu_acc,x_alu_secondary_lhs,logical_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_13_22=0x94 & $(X_ALU_ACC)) { compact_x_add_acc(x_alu_acc_lo, x_alu_acc_hi, x_alu_acc_gb, x_alu_secondary_lhs, logical_right); }
:^nop_left "||" "OR" "CE2" x_alu_acc,x_alu_secondary_lhs,logical_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_13_22=0x354 & $(X_ALU_ACC)) { compact_x_or_acc(x_alu_acc_lo, x_alu_acc_hi, x_alu_acc_gb, x_alu_secondary_lhs, logical_right); }

# OP1/OP2 are disconnected on these ADD input ports only when the peer is idle.
compact_token_left_alu: "OP1" is slot_5_9=30 { }
compact_token_left_alu: "OP2" is slot_5_9=31 { }
compact_token_right: "OP1" is slot_1_5=30 { }
compact_token_right: "OP2" is slot_1_5=31 { }
compact_token_ce1: "" is slot_0_0=0 { export 0:1; }
compact_token_ce1: "CE1" is slot_0_0=1 { export 1:1; }
compact_token_ce2: "" is slot_0_0=0 { export 0:1; }
compact_token_ce2: "CE2" is slot_0_0=1 { export 1:1; }

@define COMPACT_TOKEN_SEQ "((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0))"
@define COMPACT_TOKEN_PAR "carmel_issue=1 & slot_mode=0"
@define COMPACT_TOKEN_DATA "slot_9_10=2 & pair_ptr_6 & pair_rm_6 & pair_rl_6 & pair_bank_6"
@define COMPACT_TOKEN_ACC "slot_11_13<6 & pair_acc_11 & pair_acc_11_lo & pair_acc_11_hi & pair_acc_11_gb"
@define COMPACT_TOKEN_ADD_HALF "slot_14_22=0x48 & slot_10_12<6 & x_alu_half_dst & compact_token_left_alu & slot_1_4<14 & pair_count"
@define COMPACT_TOKEN_ADD_ACC "slot_14_22=0x4b & $(COMPACT_TOKEN_DATA) & $(COMPACT_TOKEN_ACC) & compact_token_right"

macro compact_token_enable(cfg, bank, qualified, enabled) {
    enabled = 1;
    if (qualified == 0) goto <done>;
    unary_ce(cfg, EST, CETBL, bank, enabled);
  <done>
}

macro compact_token_read(ptr, modulo, bound, shift, word) {
    local address:2 = ptr;
    modify_ptr(ptr, 0:2, modulo, bound, shift, 2:2);
    word = *[data]:2 address;
}

macro compact_token_flags(flags, active, bank) {
    local shift:4 = zext(bank) * 6;
    flags = (flags & ~(0x3b:2 << shift)) | (active << shift);
}

macro compact_token_add_half(dst, word, cfg, bank, qualified) {
    local flags:2 = EST & 0xcfff;
    local enabled:2;
    compact_token_enable(cfg, bank, qualified, enabled);
    if (enabled == 0) goto <publish>;
    local active:2 = (zext(word == 0) << 3) | (zext(word >= 0x8000) << 4);
    dst = word;
    compact_token_flags(flags, active, bank);
  <publish>
    publish_alu_ce(flags);
}

macro compact_token_add_acc(lo, hi, guard, ptr, modulo, bound, shift, cfg, bank, qualified) {
    local flags:2 = EST & 0xcfff;
    local enabled:2;
    compact_token_enable(cfg, bank, qualified, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <publish>;
    local word:2;
    compact_token_read(ptr, modulo, bound, shift, word);
    if (enabled == 0) goto <publish>;
    local active:2 = (zext(word == 0) << 3) | (zext(word >= 0x8000) << 4);
    local result:8 = sext(word);
    write_accumulator40(lo, hi, guard, result);
    compact_token_flags(flags, active, bank);
  <publish>
    publish_alu_ce(flags);
}

:ADD compact_token_ce1 x_alu_half_dst,compact_token_left_alu,pair_count is
    $(COMPACT_TOKEN_SEQ) & $(COMPACT_TOKEN_ADD_HALF) & compact_token_ce1 {
    compact_token_add_half(x_alu_half_dst, pair_count, CECFG1, 0:2, compact_token_ce1);
}
:ADD compact_token_ce1 x_alu_half_dst,compact_token_left_alu,pair_count "||" nop_right is
    ($(COMPACT_TOKEN_PAR) & $(COMPACT_TOKEN_ADD_HALF) & compact_token_ce1); (slot_mode=0 & nop_right) {
    compact_token_add_half(x_alu_half_dst, pair_count, CECFG1, 0:2, compact_token_ce1);
}
:^nop_left "||" "ADD" compact_token_ce2 x_alu_half_dst,compact_token_left_alu,pair_count is
    ($(COMPACT_TOKEN_PAR) & nop_left); (slot_mode=0 & $(COMPACT_TOKEN_ADD_HALF) & compact_token_ce2) {
    compact_token_add_half(x_alu_half_dst, pair_count, CECFG2, 1:2, compact_token_ce2);
}

:ADD compact_token_ce1 pair_acc_11,"*"^pair_ptr_6^"++",compact_token_right is
    $(COMPACT_TOKEN_SEQ) & $(COMPACT_TOKEN_ADD_ACC) & compact_token_ce1 {
    compact_token_add_acc(pair_acc_11_lo, pair_acc_11_hi, pair_acc_11_gb,
                          pair_ptr_6, pair_rm_6, pair_rl_6, pair_bank_6, CECFG1, 0:2, compact_token_ce1);
}
:ADD compact_token_ce1 pair_acc_11,"*"^pair_ptr_6^"++",compact_token_right "||" nop_right is
    ($(COMPACT_TOKEN_PAR) & $(COMPACT_TOKEN_ADD_ACC) & compact_token_ce1); (slot_mode=0 & nop_right) {
    compact_token_add_acc(pair_acc_11_lo, pair_acc_11_hi, pair_acc_11_gb,
                          pair_ptr_6, pair_rm_6, pair_rl_6, pair_bank_6, CECFG1, 0:2, compact_token_ce1);
}
:^nop_left "||" "ADD" compact_token_ce2 pair_acc_11,"*"^pair_ptr_6^"++",compact_token_right is
    ($(COMPACT_TOKEN_PAR) & nop_left); (slot_mode=0 & $(COMPACT_TOKEN_ADD_ACC) & compact_token_ce2) {
    compact_token_add_acc(pair_acc_11_lo, pair_acc_11_hi, pair_acc_11_gb,
                          pair_ptr_6, pair_rm_6, pair_rl_6, pair_bank_6, CECFG2, 1:2, compact_token_ce2);
}

# The logical RMW1 result bus reaches accumulator halves, but the
# address/increment and FF word ports receive zero without ALU status.
macro compact_logic_rmw1_zero(target, cfg, bank, address, qualified) {
    local enabled:2 = 1;
    if (qualified == 0) goto <fetch>;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <done>;
  <fetch>
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <done>;
    target = 0;
  <done>
}

macro compact_logic_rmw_word(target, cfg, bank, address, op, to_data) {
    local enabled:2;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <status>;
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <status>;
    local result:2;
    wide_logic_bitop(op, target, word, result);
    if (to_data != 0) goto <store>;
    target = result;
    goto <publish_flags>;
  <store>
    *[data]:2 address = result;
  <publish_flags>
    local shift:4 = zext(bank) * 6;
    local flags:2 = zext(result == 0) << 3;
    commit_logic_flags(flags, shift);
  <status>
    publish_alu_ce(EST & 0xcfff);
}

:"ADDC" "*R5+=RN5","A4H","*R5+RN5" "||" "OR" "RMW1","R2","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x175bca); (slot_mode=0 & slot_0_22=0x6b6c26) {
    local destination:2 = R5;
    local left_address:2 = R5 + RN5;
    local right_address:2 = R3 + RN3;
    modify_ptr(R5, RN5, RM4, RL4, 10, 1);
    local word:2 = *[data]:2 left_address;
    local mask:8 = 0xffffffffff;
    local a:8 = (sext(A4H) << 16) & mask;
    local b:8 = (sext(word) << 16) & mask;
    local raw:8 = a + b + (zext(EST & 1) << 16);
    local result:8;
    local flags:2;
    compact_long_finish(raw & mask, raw > mask, 0:1, 0:1, 0:1, result, flags);
    if ((flags & 0x20) == 0) goto <publish>;
    if ((ECFG & 0x28) != 8) goto <loss>;
    result = 0x7fffffff;
    if ((flags & 0x10) == 0) goto <loss>;
    result = 0xff80000000;
  <loss>
    flags = flags | 4;
  <publish>
    compact_logic_rmw1_zero(R2, CECFG2, 1, right_address, 0:1);
    *[data]:2 destination = result(2);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:^nop_left "||" "OR" "CE2" "RMW1","R2","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x6b6c27) {
    local address:2 = R3 + RN3;
    compact_logic_rmw1_zero(R2, CECFG2, 1, address, 1:1);
    publish_alu_ce(EST & 0xcfff);
}
:"OR" "CE1" "RMW1","RN2","*R3+RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6b6ca7); (slot_mode=0 & nop_right) {
    local address:2 = R3 + RN3;
    compact_logic_rmw1_zero(RN2, CECFG1, 0, address, 1:1);
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" "OR" "CE2" "RMW1","FF1","*R2" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x68b585) {
    local address:2 = R2;
    compact_logic_rmw1_zero(FF1, CECFG2, 1, address, 1:1);
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" "AND" "CE2" "RMW1","A2L","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x636d27) {
    local address:2 = R3 + RN3;
    compact_logic_rmw_word(A2L, CECFG2, 1:2, address, 1:2, 0:1);
}
:"XOR" "CE1" "RMW1","A2L","*R3+RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6f6d27); (slot_mode=0 & nop_right) {
    local address:2 = R3 + RN3;
    compact_logic_rmw_word(A2L, CECFG1, 0:2, address, 2:2, 0:1);
}
:"OR" "CE1" "RMW1","A2L","*R2" is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_22=0x68b485 {
    local address:2 = R2;
    compact_logic_rmw_word(A2L, CECFG1, 0:2, address, 0:2, 0:1);
}
:^nop_left "||" "OR" "CE2" "RMW2","R2","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x6b6e27) {
    local address:2 = R3 + RN3;
    compact_logic_rmw_word(R2, CECFG2, 1:2, address, 0:2, 1:1);
}

# Covered parallel logic lanes. Address override drives the AGU and OF
# even when CE vetoes the result. The next postmodify can use that AGU value.
macro parallel_logic_access(cfg, bank, enabled, access) {
    unary_ce(cfg, EST, CETBL, bank, enabled);
    access = enabled != 0 || ((cfg & 0x1000) != 0);
}

macro parallel_or_r6(cfg, bank, result, enabled) {
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local address:2 = R6;
    modify_ptr(R6, 0:2, RM6, RL6, 12, 2);
    local word:2 = *[data]:2 address;
    result = word | R2;
  <done>
}

macro parallel_or_r5(cfg, bank, result, enabled) {
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local address:2 = R5;
    modify_ptr(R5, 0:2, RM4, RL4, 10, 2);
    local first:2 = *[data]:2 R7;
    local second:2 = *[data]:2 address;
    result = first | second;
  <done>
}

macro parallel_xor_r4_r6(cfg, bank, result, enabled) {
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local first_address:2 = R4;
    local second_address:2 = R6;
    modify_ptr(R4, RN4, RM4, RL4, 8, 1);
    modify_ptr(R6, 0:2, RM6, RL6, 12, 2);
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    result = first ^ second;
  <done>
}

macro parallel_xor_r5(result, enabled) {
    local access:1;
    parallel_logic_access(CECFG2, 1:2, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local address:2 = R5;
    modify_ptr(R5, 0:2, RM4, RL4, 10, 3);
    local word:2 = *[data]:2 address;
    result = R7 ^ word;
  <done>
}

macro parallel_logic_status(result, shift) {
    local flags:2 = zext(result == 0) << 3;
    commit_logic_flags(flags, shift);
}

# Compact rotates drive both address ports, but only the primary ALU
# connects the operand-fetch, result and arithmetic-status ports.
macro compact_rotate_agu(cfg, bank, update_result, address, enabled) {
    address = R3;
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    if (!access) goto <done>;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
    if (update_result == 0) goto <done>;
    modify_ptr(R4, RN4, RM4, RL4, 8, 1);
  <done>
}

macro compact_rol_data(flags) {
    local address:2;
    local enabled:2;
    compact_rotate_agu(CECFG1, 0:2, 0:1, address, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <done>;
    local result:2 = (word + word) | (EST & 1);
    *[data]:2 R4 = result;
    flags = (flags & 0xffc6) | (word >> 15) |
            (zext(result == 0) << 3) | (zext(result >= 0x8000) << 4);
  <done>
}

macro compact_or_r7_indexed(shift, flags) {
    local address:2 = R7 + RN7;
    local word:2 = *[data]:2 address;
    local result:2 = word | A2L;
    A1L = result;
    A1H = 0;
    GB1 = 0;
    flags = (flags & ~(0x38 << shift)) | (zext(result == 0) << (shift + 3));
}

macro compact_xor_a4h_r7(flags) {
    local enabled:2;
    local access:1;
    parallel_logic_access(CECFG1, 0:2, enabled, access);
    if (!access) goto <done>;
    local address:2 = R7;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <done>;
    local result:2 = A4L ^ word;
    A4H = result;
    flags = (flags & 0xffc7) | (zext(result == 0) << 3);
  <done>
}

compact_rotate_right: "ROL CE2" "*R4","*R3+=RN3" is slot_0_22=0x21c117 {
    local address:2;
    local enabled:2;
    compact_rotate_agu(CECFG2, 1:2, 0:1, address, enabled);
}
compact_rotate_right: "ROL CE2" "*R5","*R3+=RN3" is slot_0_22=0x21c157 {
    local address:2;
    local enabled:2;
    compact_rotate_agu(CECFG2, 1:2, 0:1, address, enabled);
}
compact_rotate_right: "ROL CE2" "*R4+=RN4","*R3+=RN3" is slot_0_22=0x21c317 {
    local address:2;
    local enabled:2;
    compact_rotate_agu(CECFG2, 1:2, 1:1, address, enabled);
}
compact_rotate_right: "ROR CE2" "*R4","*R3+=RN3" is slot_0_22=0x21e117 {
    local address:2;
    local enabled:2;
    compact_rotate_agu(CECFG2, 1:2, 0:1, address, enabled);
}

:^nop_left "||" compact_rotate_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_rotate_right) {
    build compact_rotate_right;
    publish_alu_ce(EST & 0xcfff);
}
:OR "A1","*R7+RN7","A2L" "||" compact_rotate_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6aa3e4); (slot_mode=0 & compact_rotate_right) {
    local flags:2 = EST & 0xcfff;
    build compact_rotate_right;
    compact_or_r7_indexed(0:2, flags);
    publish_alu_ce(flags);
}
:XOR "CE1" "A4H","A4L","*R7+=RN7" "||" compact_rotate_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6ce51f); (slot_mode=0 & compact_rotate_right) {
    local flags:2 = EST & 0xcfff;
    build compact_rotate_right;
    compact_xor_a4h_r7(flags);
    publish_alu_ce(flags);
}
:ROL "CE1" "*R4","*R3+=RN3" "||" "OR" "A1","*R7+RN7","A2L" is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x21c117); (slot_mode=0 & slot_0_22=0x6aa3e4) {
    local flags:2 = EST & 0xcfff;
    compact_or_r7_indexed(6:2, flags);
    compact_rol_data(flags);
    publish_alu_ce(flags);
}
:ROL "CE1" "*R4","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x21c117); (slot_mode=0 & nop_right) {
    local flags:2 = EST & 0xcfff;
    compact_rol_data(flags);
    publish_alu_ce(flags);
}
:ROL "CE1" "*R4","*R3+=RN3" is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_22=0x21c117 {
    local flags:2 = EST & 0xcfff;
    compact_rol_data(flags);
    publish_alu_ce(flags);
}

# WB results are already visible when register contention stops the issue.
# Neither status publication nor the next issue belongs to the stop path.
define pcodeop carmel_register_write_conflict;
macro parallel_logic_conflict() {
  <stopped>
    carmel_register_write_conflict();
    goto <stopped>;
}

:XOR "CE1" "A4H","A4L","*R7+=RN7" "||" compact_extract_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6ce51f); (slot_mode=0 & compact_extract_right) {
    local flags:2 = EST & 0xcfff;
    build compact_extract_right;
    compact_xor_a4h_r7(flags);
    publish_alu_ce(flags);
}

macro parallel_logic_full_half(half, full_cfg, full_bank, half_cfg, half_bank, shares) {
    local full_result:2;
    local half_result:2;
    local full_enabled:2;
    local half_enabled:2;
    parallel_or_r6(full_cfg, full_bank, full_result, full_enabled);
    parallel_or_r5(half_cfg, half_bank, half_result, half_enabled);
    if (full_enabled == 0) goto <half_only>;
    A2L = full_result;
    A2H = 0;
    GB2 = 0;
    if (shares && half_enabled != 0) goto <conflict>;
    parallel_logic_status(full_result, 6 * full_bank);
  <half_only>
    if (half_enabled == 0) goto <status>;
    half = half_result;
    parallel_logic_status(half_result, 6 * half_bank);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_halves() {
    local left:2;
    local right:2;
    local ce1:2;
    local ce2:2;
    parallel_or_r5(CECFG1, 0:2, left, ce1);
    parallel_or_r5(CECFG2, 1:2, right, ce2);
    if (ce1 == 0) goto <right_port>;
    A2H = left;
  <right_port>
    if (ce2 == 0) goto <left_status>;
    A2L = right;
    if (ce1 != 0) goto <conflict>;
    parallel_logic_status(right, 6);
  <left_status>
    if (ce1 == 0) goto <status>;
    parallel_logic_status(left, 0);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_xor_pair(acc_half, shares) {
    local left:2;
    local right:2;
    local ce1:2;
    local ce2:2;
    parallel_xor_r4_r6(CECFG1, 0:2, left, ce1);
    parallel_xor_r5(right, ce2);
    if (ce1 == 0) goto <right_port>;
    acc_half = left;
  <right_port>
    if (ce2 == 0) goto <left_status>;
    X2 = right;
    if (shares && ce1 != 0) goto <conflict>;
    parallel_logic_status(right, 6);
  <left_status>
    if (ce1 == 0) goto <status>;
    parallel_logic_status(left, 0);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_ff12_pair() {
    local left:2;
    local right:2;
    local ce1:2;
    local ce2:2;
    parallel_or_r6(CECFG1, 0:2, left, ce1);
    parallel_or_r6(CECFG2, 1:2, right, ce2);
    if (ce1 == 0) goto <right_port>;
    FF1 = left;
    FF2 = 0;
  <right_port>
    if (ce2 == 0) goto <left_status>;
    FF1 = right;
    FF2 = 0;
    if (ce1 != 0) goto <conflict>;
    parallel_logic_status(right, 6);
  <left_status>
    if (ce1 == 0) goto <status>;
    parallel_logic_status(left, 0);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_mac_ff12(latch, mac_shift, word_shift) {
    local direct_word:2 = A4L | A0L;
    local incoming:2 = FF2;
    local operand:2 = *[data]:2 R7;
    local product:8 = sext(operand) * zext(R7) * (1 + zext(ECFG & 1));
    local mask:8 = 0xffffffffff;
    local raw:8 = zext(incoming) + (product & mask);
    local result:8;
    local flags:2;
    compact_long_finish(raw & mask, raw > mask, 0:1, 0:1, 0:1, result, flags);
    latch = operand;
    # The paired result suppresses the direct FF word, not that lane's flags.
    FF1 = result:2;
    FF2 = result(2);
    parallel_logic_status(direct_word, word_shift);
    local packed:2 = (EST & 0xcfff & ~(0x3b << mac_shift)) | (flags << mac_shift);
    publish_alu_ce(packed);
}

@define PAR_LOGIC_LEFT "carmel_issue=1 & slot_mode=0"
@define PAR_LOGIC_OR_R6 "slot_15_22=0xd5 & parallel_logic_src=22 & logical_right=2 & slot_0_0=1"
@define PAR_LOGIC_OR_R5 "slot_15_22=0xd3 & parallel_logic_src=7 & logical_right=21 & slot_0_0=1"
@define PAR_LOGIC_XOR_R4_R6 "slot_15_22=0xdb & parallel_logic_src=12 & logical_right=22 & slot_0_0=1"
@define PAR_LOGIC_XOR_R5 "slot_15_22=0xd9 & parallel_logic_src=7 & logical_right=29 & slot_0_0=1"
@define PAR_LOGIC_DIRECT_OR "slot_14_22=0x1a8 & parallel_word_src=20 & slot_1_4=0 & slot_0_0=0"
@define PAR_LOGIC_MAC_FF12 "slot_14_22=0x148 & parallel_logic_dst=7 & parallel_logic_src=7 & logical_right=7 & slot_0_0=0"

:OR "CE1" "A2","*R6++","R2" "||" "OR" "CE2" "A2H","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=10) { parallel_logic_full_half(A2H, CECFG1, 0:2, CECFG2, 1:2, 1:1); }
:OR "CE1" "A2H","*R7","*R5++" "||" "OR" "CE2" "A2","*R6++","R2" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10) { parallel_logic_full_half(A2H, CECFG2, 1:2, CECFG1, 0:2, 1:1); }
:OR "CE1" "A2","*R6++","R2" "||" "OR" "CE2" "A2L","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=2) { parallel_logic_full_half(A2L, CECFG1, 0:2, CECFG2, 1:2, 1:1); }
:OR "CE1" "A2","*R6++","R2" "||" "OR" "CE2" "A0H","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=8) { parallel_logic_full_half(A0H, CECFG1, 0:2, CECFG2, 1:2, 0:1); }
