# Build the signed or unsigned input from its native register aliases. Shifts
# and flags operate on the 40-bit field of an ordinary 64-bit temporary.
macro shift_write(lo, hi, guard, result, flags) {
    lo = result:2;
    hi = result(2);
    guard = result(4);
    EST = (EST & 0xffc6) | flags;
}

macro shift_flags(result, carry_bit, flags) {
    local negative:1 = (result & 0x8000000000) != 0;
    local sign_extension:8 = zext(negative);
    local extension:1 = ((result >> 31) & 0x1ff) != sign_extension * 0x1ff;
    flags = zext(carry_bit) | (zext(result == 0) << 3) | (zext(negative) << 4) | (zext(extension) << 5);
}

macro shift_limit(result, flags) {
    # ASHIFT ALIM tests the transition from the low 32 bits to the guard.
    # C, Z, M and E describe the pre-limit result; L is set, not cleared.
    local crossing:1 = (((result >> 31) ^ (result >> 32)) & 1) != 0;
    if (((ECFG & 4) == 0) || !crossing) goto <unlimited>;
    local negative:8 = zext((result & 0x8000000000) != 0);
    result = 0x7fffffff + negative * 0xff00000001;
    flags = flags | 4;
    <unlimited>
}
