# CE predicates consume the incoming execution feedback. Both banks sample
# the same flags before either makes its feedback visible.
# The four-bit CECFG selectors map V,V2,C,C2,L,L2,M,M2,Z,Z2,E,E2,CE1,CE2.
macro unary_ce_select(cfg, est, shift, bit) {
    local selector:2 = (cfg >> shift) & 0xf;
    local taps:8 = 0x00dcb593a4826071;
    local tap:8 = (taps >> (selector << 2)) & 0xf;
    bit = ((est >> tap) & 1) * zext(selector < 14);
}
macro unary_ce(cfg, est, tbl, bank, enabled) {
    enabled = (est >> (12 + bank)) & 1;
    if ((cfg & 0x2000) != 0) goto <unary_ce_ready>;
    local first:2;
    local second:2;
    local third:2;
    unary_ce_select(cfg, est, 8, first);
    unary_ce_select(cfg, est, 4, second);
    unary_ce_select(cfg, est, 0, third);
    local index:2 = (first << 2) | (second << 1) | third;
    enabled = (tbl >> (index + bank * 8)) & 1;
    <unary_ce_ready>
}

# The compact word port carries a 16-bit input in the upper lane of the
# shifter. Its flags see the 24 bits that remain above the low result word.
macro compact_shift_word(input, n, result, flags) {
    local carry_bit:1 = (EST & 1) != 0;
    local lane:4 = input;
    if (n == 0) goto <align>;
    if (n s< 0) goto <right>;
    carry_bit = 0;
    if (n > 16) goto <left>;
    carry_bit = ((lane >> (16 - n)) & 1) != 0;
  <left>
    if (n < 24) goto <shift_left>;
    lane = 0;
    goto <align>;
  <shift_left>
    lane = (lane & 0xffffff) << n;
    goto <align>;
  <right>
    local distance:4 = 0 - n;
    if (distance <= 17) goto <shift_right>;
    distance = 17;
  <shift_right>
    carry_bit = ((lane s>> (distance - 1)) & 1) != 0;
    lane = lane s>> distance;
  <align>
    result = zext(lane & 0xffffff) << 16;
    shift_flags(result, carry_bit, flags);
}

macro compact_word_logical(destination, source, count) {
    local input:4 = zext(source);
    local n:4 = (count ^ 32) - 32;
    local result:8;
    local flags:2;
    compact_shift_word(input, n, result, flags);
    destination = result(2);
    EST = (EST & 0xffc6) | flags;
}

macro compact_word_arithmetic(destination, source, count) {
    local input:4 = sext(source);
    local n:4 = (zext(count & 127) ^ 64) - 64;
    local result:8;
    local flags:2;
    compact_shift_word(input, n, result, flags);
    shift_limit(result, flags);
    destination = result(2);
    EST = (EST & 0xffc6) | flags;
}

macro compact_word_logical_store(pointer, source, count) {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <done>;
    local input:4 = zext(source);
    local n:4 = (zext(count & 127) ^ 64) - 64;
    local result:8;
    local flags:2;
    compact_shift_word(input, n, result, flags);
    *[data]:2 pointer = result(2);
    EST = (EST & 0xffc6) | flags;
  <done>
}

macro compact_long_logical_ce(lo, hi, guard, source, count) {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <done>;
    local n:4 = (count ^ 64) - 64;
    local input:8 = zext(source);
    local result:8 = input;
    local carry_bit:1 = (EST & 1) != 0;
    if (n == 0) goto <publish>;
    if (n s< 0) goto <right>;
    if (n <= 40) goto <left>;
    n = 40;
  <left>
    carry_bit = ((input >> (40 - n)) & 1) != 0;
    result = (input << n) & 0xffffffffff;
    goto <publish>;
  <right>
    local distance:4 = 0 - n;
    if (distance <= 40) goto <shift_right>;
    distance = 40;
  <shift_right>
    carry_bit = ((input >> (distance - 1)) & 1) != 0;
    result = input >> distance;
  <publish>
    local flags:2;
    shift_flags(result, carry_bit, flags);
    shift_write(lo, hi, guard, result, flags);
  <done>
}

@define SHIFT_SEQ "((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0))"
@define SHIFT_WORD_IMM "slot_16_22=0x39 & slot_0_0=0 & (slot_13_14=0 | slot_13_14=1 | slot_13_14=2) & shift_literal_dst & slot_11_11=1 & (slot_8_9=0 | slot_8_9=1 | slot_8_9=2) & shift_literal_src & shift_word_literal"
@define SHIFT_RN_IMM "slot_16_22=0x38 & slot_0_0=1 & (slot_15_15=0 | slot_14_15=2) & shift_0_dst & slot_11_12=1 & shift_rn_src & shift_count"
@define SHIFT_WORD_AS "slot_14_22=0xfb & slot_0_0=0 & (slot_11_12=0 | slot_11_12=1 | slot_11_12=2) & shift_word_dst & slot_9_9=1 & (slot_6_7=0 | slot_6_7=1 | slot_6_7=2) & shift_word_src & slot_1_4=6"
@define SHIFT_WORD_DATA "slot_14_22=0xec & slot_0_0=1 & slot_13_13=0 & shift_word_r & slot_7_9=2 & shift_word_src & slot_1_4=6"
@define SHIFT_LONG_AGU "slot_12_22=0x3fc & slot_0_0=0 & slot_11_11=1 & shift_agu_base & (slot_6_7=0 | slot_6_7=1 | slot_6_7=2) & shift_agu_src & (slot_1_4=0 | slot_1_4=1 | slot_1_4=2 | slot_1_4=3 | slot_1_4=4 | slot_1_4=5) & shift_agu_count"

:LSHIFT shift_literal_dst,shift_literal_src,shift_word_literal is $(SHIFT_SEQ) & $(SHIFT_WORD_IMM) & shift_word_literal_bits {
    compact_word_logical(shift_literal_dst, shift_literal_src, shift_word_literal_bits:4);
}
:LSHIFT shift_literal_dst,shift_literal_src,shift_word_literal "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(SHIFT_WORD_IMM) & shift_word_literal_bits); (slot_mode=0 & nop_right) {
    compact_word_logical(shift_literal_dst, shift_literal_src, shift_word_literal_bits:4);
}
:^nop_left "||" "LSHIFT" shift_literal_dst,shift_literal_src,shift_word_literal is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(SHIFT_WORD_IMM)) { }

:LSHIFT shift_0_dst,shift_rn_src,shift_count is $(SHIFT_SEQ) & $(SHIFT_RN_IMM) & shift_count_encoding & shift_0_dst_lo & shift_0_dst_hi & shift_0_dst_guard {
    compact_long_logical_ce(shift_0_dst_lo, shift_0_dst_hi, shift_0_dst_guard, shift_rn_src, shift_count_encoding:4);
}
:LSHIFT shift_0_dst,shift_rn_src,shift_count "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(SHIFT_RN_IMM) & shift_count_encoding & shift_0_dst_lo & shift_0_dst_hi & shift_0_dst_guard); (slot_mode=0 & nop_right) {
    compact_long_logical_ce(shift_0_dst_lo, shift_0_dst_hi, shift_0_dst_guard, shift_rn_src, shift_count_encoding:4);
}
:^nop_left "||" "LSHIFT" shift_0_dst,shift_rn_src,shift_count is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(SHIFT_RN_IMM)) { }

:ASHIFT shift_word_dst,shift_word_src,"FF1" is $(SHIFT_SEQ) & $(SHIFT_WORD_AS) {
    compact_word_arithmetic(shift_word_dst, shift_word_src, FF1);
}
:ASHIFT shift_word_dst,shift_word_src,"FF1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(SHIFT_WORD_AS)); (slot_mode=0 & nop_right) {
    compact_word_arithmetic(shift_word_dst, shift_word_src, FF1);
}
:^nop_left "||" "ASHIFT" shift_word_dst,shift_word_src,"FF1" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(SHIFT_WORD_AS)) { }

:LSHIFT "("shift_word_r")",shift_word_src,"FF1" is $(SHIFT_SEQ) & $(SHIFT_WORD_DATA) {
    compact_word_logical_store(shift_word_r, shift_word_src, FF1);
}
:LSHIFT "("shift_word_r")",shift_word_src,"FF1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(SHIFT_WORD_DATA)); (slot_mode=0 & nop_right) {
    compact_word_logical_store(shift_word_r, shift_word_src, FF1);
}
:^nop_left "||" "LSHIFT" "("shift_word_r")",shift_word_src,"FF1" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(SHIFT_WORD_DATA)) { }

:^nop_left "||" "ASHIFT" "("shift_agu_base"+="shift_agu_step")",shift_agu_src,shift_agu_count is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(SHIFT_LONG_AGU) & shift_agu_step & shift_agu_rm & shift_agu_rl & shift_agu_mode) {
    modify_ptr(shift_agu_base, shift_agu_step, shift_agu_rm, shift_agu_rl, shift_agu_mode, 1);
}

@define WIDE_IMMEDIATE_LOOP "wide_right_mode=1 & wide_14_22=0x138 & wide_loop_tag=1 & wide_loop_delay_high & (wide_loop_count_high>0 | wide_loop_count_low>0) & $(BLOCK_LOOP_PLAN)"
wide_loop_count: count is wide_loop_count_high & wide_loop_count_low [ count = wide_loop_count_high * 4 + wide_loop_count_low; ] {
    export *[const]:2 count;
}
wide_loop_endpoint: address is wide_loop_end [ address = (inst_start + wide_loop_end) & 0xfffffe; ] {
    export *[code]:3 address;
}
wide_dynamic_loop_endpoint: address is wide_loop_end [ address = (inst_start + wide_loop_end) & 0xffffff; ] {
    export *[code]:3 address;
}

@define WIDE_DYNAMIC_LOOP "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_loop_dynamic_prefix=1 & wide_repeat_delay & wide_dynamic_loop_endpoint & $(BLOCK_LOOP_PLAN)"
:REPEAT "*R1",wide_dynamic_loop_endpoint "delay" wide_repeat_delay is $(WIDE_DYNAMIC_LOOP) & wide_14_22=0x13a & wide_loop_tag=0 & wide_0_9=0 {
    local count:2 = *[data]:2 R1;
    arm_block_loop(count, 4:1, $(ARM_LOOP_PLAN));
}
:REPEAT "*R1+=RN1",wide_dynamic_loop_endpoint "delay" wide_repeat_delay is $(WIDE_DYNAMIC_LOOP) & wide_14_22=0x13a & wide_loop_tag=1 & wide_0_9=2 {
    local count:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    arm_block_loop(count, 4:1, $(ARM_LOOP_PLAN));
}
# The cold AGU route samples A0H before any subsequent issue can write it.
:REPEAT "A0H",wide_dynamic_loop_endpoint is carmel_of_route=2 & carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_loop_dynamic_prefix=0 & wide_14_22=0x13a & wide_loop_tag=1 & wide_repeat_delay=0 & wide_0_9=0x26 & wide_dynamic_loop_endpoint & $(BLOCK_LOOP_PLAN) {
    arm_block_loop(A0H, 4:1, $(ARM_LOOP_PLAN));
}


:REPEAT wide_loop_count,wide_loop_endpoint is $(WIDE_IMMEDIATE_LOOP) & carmel_issue=5 & wide_left_mode=1 & wide_loop_count & wide_loop_endpoint {
    arm_block_loop(wide_loop_count, 3:1 - wide_loop_delay_high:1, $(ARM_LOOP_PLAN));
}
:REPEAT "CE1" wide_loop_count,wide_loop_endpoint is $(WIDE_IMMEDIATE_LOOP) & carmel_issue=4 & wide_left_mode=0 & unary_wide_ce_bank=0 & wide_loop_count & wide_loop_endpoint {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    arm_block_loop(wide_loop_count, 3:1 - wide_loop_delay_high:1, $(ARM_LOOP_PLAN));
  <done>
}
:REPEAT "CE2" wide_loop_count,wide_loop_endpoint is $(WIDE_IMMEDIATE_LOOP) & carmel_issue=4 & wide_left_mode=0 & unary_wide_ce_bank=1 & wide_loop_count & wide_loop_endpoint {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <done>;
    arm_block_loop(wide_loop_count, 3:1 - wide_loop_delay_high:1, $(ARM_LOOP_PLAN));
  <done>
}

# An aliased control result uses the high word, while an ordinary RMW
# destination uses the low word and publishes the ALU's zero flag.
wide_logic_rmw_operator: "OR"  is wide_logic_rmw_op=0 { export 0:2; }
wide_logic_rmw_operator: "AND" is wide_logic_rmw_op=1 { export 1:2; }
wide_logic_rmw_operator: "XOR" is wide_logic_rmw_op=2 { export 2:2; }

macro wide_logic_bitop(op, lhs, rhs, result) {
    local operation:2 = op;
    result = lhs | rhs;
    if (operation == 0) goto <done>;
    result = lhs & rhs;
    if (operation == 1) goto <done>;
    result = lhs ^ rhs;
  <done>
}

macro publish_ce_feedback(flags, feedback) {
    local first:2;
    local second:2;
    unary_ce(CECFG1, feedback, CETBL, 0, first);
    unary_ce(CECFG2, feedback, CETBL, 1, second);
    EST = flags | (first << 12) | (second << 13);
}

macro publish_alu_ce(flags) {
    local feedback:2 = (EST & 0x3000) | flags;
    publish_ce_feedback(flags, feedback);
}

:^nop_left is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & nop_left {
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & nop_right) {
    publish_alu_ce(EST & 0xcfff);
}

compact_cmpu: "CMPU" cmpu_lhs,cmpu_rhs is slot_0_0=0 & slot_10_22=0x82e
    & (slot_7_9=4 | slot_6_9=10 | slot_7_9=6 | slot_6_9=14)
    & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & cmpu_lhs & cmpu_rhs {
    local flags:2 = (zext(cmpu_lhs == cmpu_rhs) << 3) | zext(cmpu_lhs >= cmpu_rhs);
    export flags;
}

:^compact_cmpu is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_cmpu {
    build compact_cmpu;
    publish_ce_feedback((EST & 0xcff6) | compact_cmpu, EST);
}
:^compact_cmpu "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_cmpu); (slot_mode=0 & nop_right) {
    build compact_cmpu;
    publish_ce_feedback((EST & 0xcff6) | compact_cmpu, EST);
}
:^nop_left "||" compact_cmpu is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_cmpu) {
    build compact_cmpu;
    publish_ce_feedback((EST & 0xcdbf) | (compact_cmpu << 6), EST);
}

compact_cmp: "CMP" cmp_lhs,cmp_rhs is slot_0_0=0 & slot_10_22=0x826
    & (slot_7_9=4 | slot_6_9=10 | slot_7_9=6 | slot_6_9=14)
    & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & cmp_lhs & cmp_rhs {
    local flags:2 = (zext(cmp_lhs == cmp_rhs) << 3) | (zext(cmp_lhs s< cmp_rhs) << 4);
    export flags;
}

:^compact_cmp is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_cmp {
    build compact_cmp;
    publish_ce_feedback((EST & 0xcfe5) | compact_cmp, EST);
}
:^compact_cmp "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_cmp); (slot_mode=0 & nop_right) {
    build compact_cmp;
    publish_ce_feedback((EST & 0xcfe5) | compact_cmp, EST);
}
:^nop_left "||" compact_cmp is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_cmp) {
    build compact_cmp;
    publish_ce_feedback((EST & 0xc97f) | (compact_cmp << 6), EST);
}

macro bank_pointer(active, shadow, increment, shadow_increment, mask) {
    local difference:2 = (PACFG ^ PACFGS) & mask;
    PACFG = PACFG ^ difference;
    PACFGS = PACFGS ^ difference;
    swap16(active, shadow);
    swap16(increment, shadow_increment);
}

compact_bank_address: "BANKXCHG" bank_exchange_mask is slot_14_22=0xae & slot_0_0=0 & bank_exchange_mask {
    local mask:2 = bank_exchange_mask;
    if ((mask & 0x001) == 0) goto <r1>;
    bank_pointer(R0, R0S, RN0, RN0S, 0x0003);
  <r1>
    if ((mask & 0x002) == 0) goto <r2>;
    bank_pointer(R1, R1S, RN1, RN1S, 0x000c);
  <r2>
    if ((mask & 0x004) == 0) goto <r3>;
    bank_pointer(R2, R2S, RN2, RN2S, 0x0030);
  <r3>
    if ((mask & 0x008) == 0) goto <r4>;
    bank_pointer(R3, R3S, RN3, RN3S, 0x00c0);
  <r4>
    if ((mask & 0x010) == 0) goto <r5>;
    bank_pointer(R4, R4S, RN4, RN4S, 0x0300);
  <r5>
    if ((mask & 0x020) == 0) goto <r6>;
    bank_pointer(R5, R5S, RN5, RN5S, 0x0c00);
  <r6>
    if ((mask & 0x040) == 0) goto <r7>;
    bank_pointer(R6, R6S, RN6, RN6S, 0x3000);
  <r7>
    if ((mask & 0x080) == 0) goto <rm0>;
    bank_pointer(R7, R7S, RN7, RN7S, 0xc000);
  <rm0>
    if ((mask & 0x100) == 0) goto <rm2>;
    swap16(RM0, RM0S);
    swap16(RL0, RL0S);
  <rm2>
    if ((mask & 0x200) == 0) goto <rm4>;
    swap16(RM2, RM2S);
    swap16(RL2, RL2S);
  <rm4>
    if ((mask & 0x400) == 0) goto <rm6>;
    swap16(RM4, RM4S);
    swap16(RL4, RL4S);
  <rm6>
    if ((mask & 0x800) == 0) goto <done>;
    swap16(RM6, RM6S);
    swap16(RL6, RL6S);
  <done>
}

bank_alu2: is bank_exchange_alu=0 { export 0:2; }
bank_alu2: ",A2,EST" is bank_exchange_alu=1 { export 1:2; }
bank_alu3: is bank_exchange_alu=0 { export 0:2; }
bank_alu3: ",A3,EST" is bank_exchange_alu=1 { export 1:2; }

macro compact_bank_result(exchange, low, low_shadow, high, high_shadow, guard, guard_shadow, flags) {
    if (exchange == 0) goto <address_only>;
    swap16(low, low_shadow);
    swap16(high, high_shadow);
    local old_guard:1 = guard;
    guard = guard_shadow;
    guard_shadow = old_guard;
    # Save the incoming word, not the peer's C/Z. The restore wins over the peer.
    swap16(EST, ESTS);
    goto <done>;
  <address_only>
    publish_ce_feedback(flags, EST);
  <done>
}

:^compact_bank_address^bank_alu2 is
    ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_bank_address & bank_alu2 {
    build compact_bank_address;
    compact_bank_result(bank_alu2, A2L, A2LS, A2H, A2HS, GB2, GB2S, EST & 0xcfff);
}
:^compact_bank_address^bank_alu2 "||" nop_right is
    (carmel_issue=1 & slot_mode=0 & compact_bank_address & bank_alu2); (slot_mode=0 & nop_right) {
    build compact_bank_address;
    compact_bank_result(bank_alu2, A2L, A2LS, A2H, A2HS, GB2, GB2S, EST & 0xcfff);
}
:^nop_left "||" compact_bank_address^bank_alu3 is
    (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_bank_address & bank_alu3) {
    build compact_bank_address;
    compact_bank_result(bank_alu3, A3L, A3LS, A3H, A3HS, GB3, GB3S, EST & 0xcfff);
}
:^compact_bank_address^bank_alu2 "||" compact_cmpu is
    (carmel_issue=1 & slot_mode=0 & compact_bank_address & bank_alu2); (slot_mode=0 & compact_cmpu) {
    build compact_cmpu;
    build compact_bank_address;
    compact_bank_result(bank_alu2, A2L, A2LS, A2H, A2HS, GB2, GB2S, (EST & 0xcdbf) | (compact_cmpu << 6));
}
:^compact_cmpu "||" compact_bank_address^bank_alu3 is
    (carmel_issue=1 & slot_mode=0 & compact_cmpu); (slot_mode=0 & compact_bank_address & bank_alu3) {
    build compact_cmpu;
    build compact_bank_address;
    compact_bank_result(bank_alu3, A3L, A3LS, A3H, A3HS, GB3, GB3S, (EST & 0xcff6) | compact_cmpu);
}

wide_ce_prefix: is wide_left_mode=1 { local kind:2 = 0; export kind; }
wide_ce_prefix: "CE1" is wide_left_mode=0 & unary_wide_ce_bank=0 { local kind:2 = 1; export kind; }
wide_ce_prefix: "CE2" is wide_left_mode=0 & unary_wide_ce_bank=1 { local kind:2 = 2; export kind; }

macro wide_issue_enable(prefix, result, address) {
    result = 1;
    address = 1;
    local kind:2 = prefix;
    if (kind == 0) goto <done>;
    if (kind == 2) goto <second>;
    unary_ce(CECFG1, EST, CETBL, 0:2, result);
    address = zext(result != 0 || (CECFG1 & 0x1000) != 0);
    goto <done>;
  <second>
    unary_ce(CECFG2, EST, CETBL, 1:2, result);
    address = zext(result != 0 || (CECFG2 & 0x1000) != 0);
  <done>
}

@define COMPACT_LOAD_WORD "slot_12_22=0x2c0 & slot_10_11=0"

compact_load_first: "LOAD" load_left_destination,load_left_source,load_left_mode is $(COMPACT_LOAD_WORD) & load_left_qualified=0 & load_left_destination & load_left_source & load_left_mode { }
compact_load_first: "LOAD" "CE1" load_left_destination,load_left_source,load_left_mode is $(COMPACT_LOAD_WORD) & load_left_qualified=1 & load_left_destination & load_left_source & load_left_mode { }
compact_load_second: "LOAD" load_right_destination,load_right_source,load_right_mode is $(COMPACT_LOAD_WORD) & load_right_qualified=0 & load_right_destination & load_right_source & load_right_mode { }
compact_load_second: "LOAD" "CE2" load_right_destination,load_right_source,load_right_mode is $(COMPACT_LOAD_WORD) & load_right_qualified=1 & load_right_destination & load_right_source & load_right_mode { }

macro compact_load_enabled(qualified, cfg, bank, enabled) {
    enabled = 1;
    local is_qualified:1 = qualified;
    if (is_qualified == 0 || (cfg & 0x1000) != 0) goto <ready>;
    unary_ce(cfg, EST, CETBL, bank, enabled);
  <ready>
}

compact_status_data: "*"^pair_ptr_1 is slot_4_5=0 & pair_ptr_1 {
    local address:2 = pair_ptr_1;
    export *[data]:2 address;
}

@define STATUS_AGU "pair_ptr_1 & pair_rm_1 & pair_rl_1 & pair_bank_1"

compact_status_data: "*"^pair_ptr_1^"+="^pair_rn_1 is slot_4_5=1 & $(STATUS_AGU) & pair_rn_1 {
    local address:2 = pair_ptr_1;
    modify_ptr(pair_ptr_1, pair_rn_1, pair_rm_1, pair_rl_1, pair_bank_1, 1:2);
    export *[data]:2 address;
}
compact_status_data: "*"^pair_ptr_1^"++" is slot_4_5=2 & $(STATUS_AGU) {
    local address:2 = pair_ptr_1;
    modify_ptr(pair_ptr_1, 0:2, pair_rm_1, pair_rl_1, pair_bank_1, 2:2);
    export *[data]:2 address;
}
compact_status_data: "*"^pair_ptr_1^"--" is slot_4_5=3 & $(STATUS_AGU) {
    local address:2 = pair_ptr_1;
    modify_ptr(pair_ptr_1, 0:2, pair_rm_1, pair_rl_1, pair_bank_1, 3:2);
    export *[data]:2 address;
}

compact_status_ce1: is slot_0_0=0 { export 1:2; }
compact_status_ce1: "CE1" is slot_0_0=1 {
    local enabled:2;
    compact_load_enabled(1:1, CECFG1, 0:2, enabled);
    export enabled;
}
compact_status_ce2: is slot_0_0=0 { export 1:2; }
compact_status_ce2: "CE2" is slot_0_0=1 {
    local enabled:2;
    compact_load_enabled(1:1, CECFG2, 1:2, enabled);
    export enabled;
}

compact_status_first: "MOVE" compact_status_ce1 "PSTATUS",compact_status_data is slot_6_22=0xc6d5
    & compact_status_ce1 & compact_status_data {
    build compact_status_ce1;
    if (compact_status_ce1 == 0) goto <done>;
    build compact_status_data;
    select_saved_loop_frame(compact_status_data);
  <done>
}
compact_status_second: "MOVE" compact_status_ce2 "PSTATUS",compact_status_data is slot_6_22=0xc6d5
    & compact_status_ce2 & compact_status_data {
    build compact_status_ce2;
    if (compact_status_ce2 == 0) goto <done>;
    build compact_status_data;
    select_saved_loop_frame(compact_status_data);
  <done>
}

:^compact_status_first "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_status_first); (slot_mode=0 & nop_right) {
    build compact_status_first;
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" compact_status_second is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_status_second) {
    build compact_status_second;
    publish_alu_ce(EST & 0xcfff);
}
:^compact_status_first is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_status_first {
    build compact_status_first;
    publish_alu_ce(EST & 0xcfff);
}

macro compact_load_pacfg(shift, mode) {
    local lane:4 = shift;
    local value:2 = mode;
    PACFG = (PACFG & ~(3 << lane)) | (value << lane);
}

macro compact_load_word(destination, shift, source, mode, qualified, cfg, bank) {
    local enabled:2;
    compact_load_enabled(qualified, cfg, bank, enabled);
    if (enabled == 0) goto <done>;
    compact_load_pacfg(shift, mode);
    destination = source;
  <done>
    local flags:2 = EST & 0xcfff;
    publish_alu_ce(flags);
}

:^compact_load_first is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_load_first & load_left_shift & load_left_qualified & load_left_destination & load_left_source & load_left_mode {
    compact_load_word(load_left_destination, load_left_shift, load_left_source, load_left_mode, load_left_qualified, CECFG1, 0:2);
}
:^compact_load_first "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_load_first & load_left_shift & load_left_qualified & load_left_destination & load_left_source & load_left_mode); (slot_mode=0 & nop_right) {
    compact_load_word(load_left_destination, load_left_shift, load_left_source, load_left_mode, load_left_qualified, CECFG1, 0:2);
}
:^nop_left "||" compact_load_second is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_load_second & load_right_shift & load_right_qualified & load_right_destination & load_right_source & load_right_mode) {
    compact_load_word(load_right_destination, load_right_shift, load_right_source, load_right_mode, load_right_qualified, CECFG2, 1:2);
}

# The right lane wins the single decode port before a dual write stops, so
# neither execution-stage pointer update belongs to the contention path.
define pcodeop carmel_address_config_conflict;
:^compact_load_first "||" compact_load_second is (carmel_issue=1 & slot_mode=0 & compact_load_first & load_left_shift & load_left_qualified & load_left_destination & load_left_source & load_left_mode); (slot_mode=0 & compact_load_second & load_right_shift & load_right_qualified & load_right_destination & load_right_source & load_right_mode) {
    local left_enabled:2;
    local right_enabled:2;
    compact_load_enabled(load_left_qualified, CECFG1, 0:2, left_enabled);
    compact_load_enabled(load_right_qualified, CECFG2, 1:2, right_enabled);
    if (right_enabled == 0) goto <left_only>;
    compact_load_pacfg(load_right_shift, load_right_mode);
    if (left_enabled != 0) goto <conflict>;
    load_right_destination = load_right_source;
    goto <done>;
  <left_only>
    if (left_enabled == 0) goto <done>;
    compact_load_pacfg(load_left_shift, load_left_mode);
    load_left_destination = load_left_source;
  <done>
    local flags:2 = EST & 0xcfff;
    publish_alu_ce(flags);
    goto <end>;
  <conflict>
    carmel_address_config_conflict(PACFG);
    goto <conflict>;
  <end>
}

@define WIDE_LIM8_CE2 "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_10_22=0x10ec & wide_0_1=2"

wide_lim8_source: "RM6" is wide_40_45=0x37 { export RM6; }
wide_lim8_source: "A0L" is wide_40_45=0x10 { export A0L; }
wide_lim8_disconnected: "GB0" is wide_2_9=0x80 { }
wide_lim8_disconnected: "0xf5" is wide_2_9=0xf5 { }
wide_lim8_disconnected: "0xff" is wide_2_9=0xff { }
wide_lim8_result: "RMW1" is wide_2_9=0x86 { export RM6; }
wide_lim8_result: "FF12" is wide_2_9=0xbe { export FF1; }
wide_lim8_result: "LC" is wide_2_9=0xd4 { export LC1; }

# L1 is sticky and its driver is independent of the register result port.
macro wide_lim8_status(input, enabled) {
    local limited:2 = zext((enabled != 0) && (input > 0xff)) << 2;
    publish_alu_ce((EST & 0xcfff) | limited);
}

macro wide_lim8_clamp(input, result) {
    result = input;
    if (input <= 0xff) goto <done>;
    result = 0xff * zext(input < 0x8000);
  <done>
}

:LIM8 "CE2" wide_lim8_disconnected,wide_lim8_source is $(WIDE_LIM8_CE2) & wide_lim8_disconnected & wide_lim8_source {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    wide_lim8_status(wide_lim8_source, enabled);
}
:LIM8 "CE2" wide_lim8_result,"RM6" is $(WIDE_LIM8_CE2) & wide_40_45=0x37 & wide_lim8_result {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local input:2 = RM6;
    if (enabled == 0) goto <finish>;
    local result:2;
    wide_lim8_clamp(input, result);
    wide_lim8_result = result;
  <finish>
    wide_lim8_status(input, enabled);
}

:LIM8 "RN4",wide_lim8_pointer is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_10_22=0x10e8 & wide_0_1=3 & wide_2_9=0xac & wide_40_45>=0x20 & wide_lim8_pointer {
    local input:2 = wide_lim8_pointer;
    wide_lim8_clamp(input, RN4);
    wide_lim8_status(input, 1:2);
}

# Qualified SUB with a proven reset operand-fetch route. The extension word
# is not the address of the first input in this route.
@define WIDE_SUBTRACT_COLD "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & logic_ce_bank=0 & wide_subtract_opcode=0 & wide_0_0=0 & wide_40_45=2 & carmel_of_route=2"

macro wide_subtract_cold(address, word_lane, data_result, enabled, result, flags) {
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    flags = EST & 0xcfff;
    result = 0;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    local lhs:2 = *[data]:2 0xffff:2;
    local rhs:2 = *[data]:2 address;
    if (enabled == 0) goto <done>;
    local left:4 = zext(lhs ^ 0x8000);
    local right:4 = zext(rhs ^ 0x8000);
    result = left - right;
    # Two signed words cannot overflow 40 bits. Only the aligned word
    # lane can extend past bit 31, with E/L determined before writeback.
    local negative:1 = result >= 0x80000000;
    local extended:1 = word_lane != 0 && result + 0x8000 > 0xffff;
    local saturated:1 = (ECFG & 0x28) == 8;
    local auto_limit:1 = (ECFG & 4) != 0;
    local clipped:1 = extended && (auto_limit || (data_result != 0 && saturated));
    local loss:1 = extended && (!saturated || clipped);
    flags = (flags & 0xffc4) | zext(lhs >= rhs) | (zext(loss) << 2) |
            (zext(result == 0) << 3) | (zext(negative) << 4) | (zext(extended) << 5);
    if (!clipped) goto <done>;
    result = 0x7fff;
    if (!negative) goto <done>;
    result = 0xffff8000;
  <done>
}

:SUB "CE1" "RMW2","OF","*R2" is $(WIDE_SUBTRACT_COLD) & wide_subtract_destination=0x8e &
    (wide_subtract_left=0x8f | wide_subtract_left=0xe7 | wide_subtract_left=0xf7) {
    local address:2 = R2;
    local enabled:2;
    local result:4;
    local flags:2;
    wide_subtract_cold(address, 1:1, 1:1, enabled, result, flags);
    if (enabled == 0) goto <publish>;
    *[data]:2 address = result:2;
  <publish>
    publish_alu_ce(flags);
}

:SUB "CE1" "A0","OF","*R2" is $(WIDE_SUBTRACT_COLD) & wide_subtract_destination=0x88 &
    (wide_subtract_left=0x8f | wide_subtract_left=0xe7) {
    local enabled:2;
    local result:4;
    local flags:2;
    wide_subtract_cold(R2, 0:1, 0:1, enabled, result, flags);
    if (enabled == 0) goto <publish>;
    A0L = result:2;
    A0H = result(2);
    GB0 = 0 - (result >= 0x80000000);
  <publish>
    publish_alu_ce(flags);
}

:SUB "CE1" "FF1","OF","*R2" is $(WIDE_SUBTRACT_COLD) & wide_subtract_destination=0xbe & wide_subtract_left=0x8f {
    local enabled:2;
    local result:4;
    local flags:2;
    wide_subtract_cold(R2, 1:1, 0:1, enabled, result, flags);
    if (enabled == 0) goto <publish>;
    FF1 = result:2;
  <publish>
    publish_alu_ce(flags);
}

:SUB "CE1" "EST","OF","*R2" is $(WIDE_SUBTRACT_COLD) & wide_subtract_destination=0xc1 & wide_subtract_left=0x8f {
    local enabled:2;
    local result:4;
    local flags:2;
    wide_subtract_cold(R2, 1:1, 0:1, enabled, result, flags);
    publish_alu_ce(flags);
}

macro compact_extract_bits(word, count, offset, signed_result, result) {
    local n:4 = zext(count & 31);
    local start:4 = zext(offset & 31);
    local mask:4 = 0x7fffffff >> (31 - n);
    result = (sext(word) s>> start) & mask;
    if (signed_result == 0 || n == 0) goto <flags>;
    local sign:4 = (mask >> 1) + 1;
    result = (result ^ sign) - sign;
  <flags>
    local bits:2 = (zext(result == 0) << 3) | (zext((result & 0x80000000) != 0) << 4);
    EST = (EST & 0xffe7) | bits;
}

macro compact_extract_full(word, count, offset, low, high, guard) {
    local result:4;
    compact_extract_bits(word, count, offset, 0:1, result);
    low = result:2;
    high = result(2);
    guard = 0;
}

macro compact_extract_signed_data(cfg, bank, write_result) {
    local enabled:2;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <done>;
    local address:2 = R0;
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    if (enabled == 0 || write_result == 0) goto <done>;
    local word:2 = *[data]:2 address;
    local result:4;
    compact_extract_bits(word, A1L, A1H, 1:1, result);
    A0L = result:2;
  <done>
}

compact_extract_active: "EXTRACTZ" "*R5,*R5+=RN5,FF2:FF1" is slot_0_22=0x372ade {
    local address:2 = R5;
    local word:2 = *[data]:2 address;
    modify_ptr(R5, RN5, RM4, RL4, 10, 1);
    local result:4;
    compact_extract_bits(word, FF2, FF1, 0:1, result);
    *[data]:2 address = result:2;
}
compact_extract_active: "EXTRACTZ" "X2,*R2+RN2,*R1+=RN1:long" is slot_0_22=0x365f52 {
    local source:2 = R2 + RN2;
    local descriptor:2 = R1;
    local upper:2 = descriptor + 1;
    local word:2 = *[data]:2 source;
    local count:2 = *[data]:2 descriptor;
    local offset:2 = *[data]:2 upper;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    local result:4;
    compact_extract_bits(word, count, offset, 0:1, result);
    X2 = result:2;
}
compact_extract_active: "EXTRACTZ CE1" "A0,A2H,A4" is slot_0_22=0x37c0a9 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <done>;
    compact_extract_full(A2H, A4L, A4H, A0L, A0H, GB0);
  <done>
}
compact_extract_active: "EXTRACTS CE1" "A0L,*R0+=RN0,A1" is slot_0_22=0x350083 {
    compact_extract_signed_data(CECFG1, 0:2, 1:1);
}
compact_extract_active: "EXTRACTZ" "A1,A0H,FF1:FF2" is slot_0_22=0x37c18c {
    compact_extract_full(A0H, FF1, FF2, A1L, A1H, GB1);
}
compact_extract_active: "EXTRACTZ" "A1,A0H,FF2:FF1" is slot_0_22=0x37c18e {
    compact_extract_full(A0H, FF2, FF1, A1L, A1H, GB1);
}

compact_extract_active: "EXTRACTZ CE1" "A2,A5L,*R3:long" is slot_0_22=0x36c4a7 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0:2, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    local address:2 = R3;
    local upper:2 = address + 1;
    local count:2 = *[data]:2 address;
    local offset:2 = *[data]:2 upper;
    if (enabled == 0) goto <done>;
    compact_extract_full(A5L, count, offset, A2L, A2H, GB2);
  <done>
}

macro compact_extract_agu(pointer, step, modulus, limit, shift) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1:2, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <done>;
    modify_ptr(pointer, step, modulus, limit, shift, 1);
  <done>
}

compact_extract_right: "EXTRACTZ CE2" "A2,A5L,*R3:long" is slot_0_22=0x36c4a7 { }
compact_extract_right: "EXTRACTS CE2" "A2,A5L,*R3:long" is slot_0_22=0x34c4a7 { }
compact_extract_right: "EXTRACTZ CE2" "A2,A5L,*R3+=RN3:long" is slot_0_22=0x36c4b7 {
    compact_extract_agu(R3, RN3, RM2, RL2, 6);
}
compact_extract_right: "EXTRACTZ CE2" "A2,*R5+=RN5,*R3:long" is slot_0_22=0x3644a7 {
    compact_extract_agu(R5, RN5, RM4, RL4, 10);
}
compact_extract_passive: compact_extract_right is compact_extract_right { build compact_extract_right; }

compact_extract_passive: "EXTRACTZ" "*R5,*R5+=RN5,FF2:FF1" is slot_0_22=0x372ade {
    modify_ptr(R5, RN5, RM4, RL4, 10, 1);
}
compact_extract_passive: "EXTRACTZ" "X2,*R2+RN2,*R1+=RN1:long" is slot_0_22=0x365f52 {
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
}
compact_extract_passive: "EXTRACTZ CE2" "A0,A2H,A4" is slot_0_22=0x37c0a9 { }
compact_extract_passive: "EXTRACTS CE2" "A0L,*R0+=RN0,A1" is slot_0_22=0x350083 {
    compact_extract_signed_data(CECFG2, 1:2, 0:1);
}
compact_extract_passive: "EXTRACTZ" "A1,A0H,FF1:FF2" is slot_0_22=0x37c18c { }
compact_extract_passive: "EXTRACTZ" "A1,A0H,FF2:FF1" is slot_0_22=0x37c18e { }

:^compact_extract_active "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_extract_active); (slot_mode=0 & nop_right) {
    build compact_extract_active;
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" compact_extract_passive is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_extract_passive) {
    build compact_extract_passive;
    publish_alu_ce(EST & 0xcfff);
}
:^compact_extract_active is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_extract_active {
    build compact_extract_active;
    publish_alu_ce(EST & 0xcfff);
}

# The long descriptor selects the opposite short-result bank.
macro packed_extract_store(pointer, increment, modulus, limit, mode_shift, word, descriptor) {
    local address:2 = pointer;
    local desc_hi:2 = descriptor + 1;
    local count:2 = *[data]:2 descriptor;
    local offset:2 = *[data]:2 desc_hi;
    modify_ptr(pointer, increment, modulus, limit, mode_shift, 1);
    local result:4;
    compact_extract_bits(word, count, offset, 0:1, result);
    *[data]:2 address = result:2;
    publish_alu_ce(EST & 0xcfff);
}

@define PACKED_DM_EXTRACT "slot_13_22=0x1b5 & slot_0_0=0 & packed_extract_dst=7 & packed_extract_desc_mode=0 & packed_extract_src_selector<=5 & packed_extract_src & packed_extract_desc"
:EXTRACTZ "*R3+=RN3",packed_extract_src,"*"^packed_extract_desc^":long" "||" nop_right is
    (carmel_issue=1 & slot_mode=0 & $(PACKED_DM_EXTRACT) & packed_extract_bank=1); (slot_mode=0 & nop_right) {
    packed_extract_store(R3, RN3, RM2, RL2, 6, packed_extract_src, packed_extract_desc);
}
:EXTRACTZ "*R7+=RN7",packed_extract_src,"*"^packed_extract_desc^":long" "||" nop_right is
    (carmel_issue=1 & slot_mode=0 & $(PACKED_DM_EXTRACT) & packed_extract_bank=0); (slot_mode=0 & nop_right) {
    packed_extract_store(R7, RN7, RM6, RL6, 14, packed_extract_src, packed_extract_desc);
}

macro wide_logic_rmw_pstatus(word) {
    local depth:2 = (word & 3) * zext((word & 8) != 0);
    PSTATUS = (word & 0xfff8) | depth;
}

@define WIDE_LOGIC_RMW "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & logic_ce_bank=1 & wide_20_22=6 & wide_logic_rmw_operator"
:^wide_logic_rmw_operator "USER_IO","USER_IO",wide_load_literal_bits is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x35f5e & wide_40_45=0xf & wide_load_literal_bits {
    publish_alu_ce(EST & 0xcfff);
}
:^wide_logic_rmw_operator "PSTATUS","USER_IO",wide_load_literal_bits is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x3575e & wide_40_45=0xf & wide_load_literal_bits {
    publish_alu_ce(EST & 0xcfff);
}
:^wide_logic_rmw_operator "INTBASE","USER_IO",wide_load_literal_bits is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x35b5e & wide_40_45=0xf & wide_load_literal_bits {
    local literal:2 = wide_load_literal_bits;
    local result:2;
    wide_logic_bitop(wide_logic_rmw_operator, USER_IO, literal, result);
    INTBASE = result;
    publish_alu_ce((EST & 0xcfc7) | (zext(result == 0) << 3));
}
:^wide_logic_rmw_operator "USER_IO","USER_IO",wide_load_literal_bits is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21b5e & wide_40_45=0xf & wide_load_literal_bits {
    USER_IO = 0;
    publish_alu_ce(0:2);
}
:^wide_logic_rmw_operator "USER_IO","USER_IO","A0" is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21b5e & wide_40_45=8 {
    local upper:2;
    wide_logic_bitop(wide_logic_rmw_operator, 0:2, A0H, upper);
    USER_IO = upper;
    publish_alu_ce(0:2);
}
:^wide_logic_rmw_operator "USER_IO","USER_IO","*R0++" is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21b5c & wide_40_45=0x10 {
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
    USER_IO = 0;
    publish_alu_ce(0:2);
}
:^wide_logic_rmw_operator "PSTATUS","A0L","PSTATUS" is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21e43 & wide_40_45=0x15 {
    wide_logic_rmw_pstatus(0:2);
    publish_alu_ce(0:2);
}
:^wide_logic_rmw_operator "OP3","A0L","INTBASE" is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x23a43 & wide_40_45=0x16 {
    INTBASE = 0;
    publish_alu_ce(0:2);
}
:^wide_logic_rmw_operator "A0L","A0L","A0L" is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21e42 & wide_40_45=0x10 {
    local result:2;
    wide_logic_bitop(wide_logic_rmw_operator, A0L, A0L, result);
    A0L = result;
    local flags:2 = zext(result == 0) << 3;
    publish_alu_ce(flags);
}
:^wide_logic_rmw_operator "*R0++","*R0++",wide_load_literal_bits is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21842 & wide_40_45=0xf & wide_load_literal_bits {
    local address:2 = R0;
    local value:2 = *[data]:2 address;
    local rhs:2 = wide_load_literal_bits;
    local result:2;
    wide_logic_bitop(wide_logic_rmw_operator, value, rhs, result);
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
    *[data]:2 address = result;
    local flags:2 = zext(result == 0) << 3;
    publish_alu_ce(flags);
}
:^wide_logic_rmw_operator "PSTATUS","PSTATUS","A0" is $(WIDE_LOGIC_RMW) & wide_logic_rmw_route=0x21b56 & wide_40_45=8 {
    local upper:2;
    wide_logic_bitop(wide_logic_rmw_operator, 0:2, A0H, upper);
    wide_logic_rmw_pstatus(upper);
    publish_alu_ce(0:2);
}

macro wide_logic_ce1(dst, lhs, rhs, op) {
    local flags:2 = EST & 0xcfff;
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    local a:4 = zext(lhs);
    local b:4 = zext(rhs);
    local result:4;
    wide_logic_bitop(op, a, b, result);
    dst = result:2;
    flags = (flags & 0xffc7) | (zext(result == 0) << 3);
  <publish>
    publish_alu_ce(flags);
}

@define WIDE_LOGIC_CE "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_20_22=6 & wide_logic_rmw_operator"

# These selectors take their word input from the result's register bank.
:^wide_logic_rmw_operator "CE1" "RL4","RM4","RM4" is $(WIDE_LOGIC_CE) & unary_wide_ce_bank=0
    & wide_alias_logic_dst=0xb4 & wide_alias_logic_lhs=0xf6 & wide_40_45=0x36 & wide_0_1=2 & wide_logic_rmw_op=0 {
    wide_logic_ce1(RL4, RM4, RM4, wide_logic_rmw_operator);
}

wide_logic_address_input: "RM4" is wide_alias_logic_lhs=0xe6 { export RM4; }
wide_logic_address_input: "MINMAX" is wide_alias_logic_lhs=0xea { export MINMAX; }
wide_logic_address_input: "FF1" is wide_alias_logic_lhs=0xee { export FF1; }
wide_logic_config_input: "EST" is wide_alias_logic_lhs=0xe1 { export EST; }
wide_logic_config_input: "CETBL" is wide_alias_logic_lhs=0xe4 { export CETBL; }
wide_logic_config_input: "BTR1" is wide_alias_logic_lhs=0xe6 { export BTR1; }

macro wide_logic_word_xor(dst, lhs, rhs) {
    local result:2 = lhs ^ rhs;
    dst = result;
    publish_alu_ce((EST & 0xcfc7) | (zext(result == 0) << 3));
}

@define WIDE_LOGIC_WORD "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_20_22=6 & wide_logic_rmw_operator & wide_logic_rmw_op=2 & wide_40_45=0x11 & wide_0_1=2"
:^wide_logic_rmw_operator "RL4",wide_logic_address_input,"A1L" is $(WIDE_LOGIC_WORD)
    & wide_alias_logic_dst=0xb4 & wide_logic_address_input {
    wide_logic_word_xor(RL4, wide_logic_address_input, A1L);
}
:^wide_logic_rmw_operator "ECFG",wide_logic_config_input,"A1L" is $(WIDE_LOGIC_WORD)
    & wide_alias_logic_dst=0xc0 & wide_logic_config_input {
    wide_logic_word_xor(ECFG, wide_logic_config_input, A1L);
}
@undef WIDE_LOGIC_WORD

@define WIDE_LOGIC_CONTROL_INPUT "$(WIDE_LOGIC_CE) & unary_wide_ce_bank=0 & wide_40_45=0x1e"
:^wide_logic_rmw_operator "CE1" "INTBASE","IO","X1" is $(WIDE_LOGIC_CONTROL_INPUT) & wide_logic_rmw_route=0x35be2 {
    wide_logic_ce1(INTBASE, 0:2, X1, wide_logic_rmw_operator);
}
:^wide_logic_rmw_operator "CE1" "INTBASE","LSA1","X1" is $(WIDE_LOGIC_CONTROL_INPUT) & (wide_logic_rmw_route=0x35b4a | wide_logic_rmw_route=0x35b8a) {
    wide_logic_ce1(INTBASE, LSA1, X1, wide_logic_rmw_operator);
}
:^wide_logic_rmw_operator "CE1" "LC1","LEA1","X1" is $(WIDE_LOGIC_CONTROL_INPUT) & wide_logic_rmw_route=0x3538e {
    wide_logic_ce1(LC1, LEA1, X1, wide_logic_rmw_operator);
}
:^wide_logic_rmw_operator "CE1" "LC1","USER_IO","X1" is $(WIDE_LOGIC_CONTROL_INPUT) & wide_logic_rmw_route=0x3539e {
    wide_logic_ce1(LC1, USER_IO, X1, wide_logic_rmw_operator);
}
:^wide_logic_rmw_operator "CE1" "INTBASE","PACFG","X1" is $(WIDE_LOGIC_CONTROL_INPUT) & wide_logic_rmw_route=0x35baa {
    wide_logic_ce1(INTBASE, PACFG, X1, wide_logic_rmw_operator);
}
:^wide_logic_rmw_operator "CE2" "discard","IO","*R6--:long" is $(WIDE_LOGIC_CE) & unary_wide_ce_bank=1 & wide_logic_rmw_route=0x35fe1 & wide_40_45=0x1e {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    # The DATA AGU still advances by two words; neither result drives writeback.
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 3, 2:2);
  <publish>
    local flags:2 = EST & 0xcfff;
    publish_alu_ce(flags);
}

macro qualified_data_multiply(latch, cfg, bank, shift, mixed) {
    local flags:2 = EST & 0xcfff;
    local enabled:2;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <publish>;
    local address:2 = R0;
    local word:2 = *[data]:2 address;
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
    latch = word;
    if (enabled == 0) goto <publish>;
    local a:8 = sext(word);
    local unsigned_first:1 = mixed;
    if (unsigned_first == 0) goto <operands_ready>;
    a = zext(word);
  <operands_ready>
    local b:8 = sext(A1L);
    local scale:8 = 1 + zext(ECFG & 1);
    local product:8 = a * b * scale;
    local upper:8 = (product & 0xffffffffff) >> 31;
    local extended:1 = (upper != 0) && (upper != 0x1ff);
    local limited:1 = (unsigned_first == 0) && extended && ((ECFG & 4) != 0);
    local result:8 = product - zext(limited);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    local active:2 = (zext(limited) << 2) | (zext(product == 0) << 3)
                  | (zext(product s< 0) << 4) | (zext(extended) << 5);
    local lane:4 = shift;
    flags = (flags & ~(0x3b:2 << lane)) | (active << lane);
  <publish>
    publish_alu_ce(flags);
}

@define QUALIFIED_MUL "slot_0_22=0x410423"
:"MUL CE1" "A0","*R0++","A1L" is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & $(QUALIFIED_MUL) { qualified_data_multiply(X1, CECFG1, 0, 0, 0); }
:"MUL CE1" "A0","*R0++","A1L" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(QUALIFIED_MUL)); (slot_mode=0 & nop_right) { qualified_data_multiply(X1, CECFG1, 0, 0, 0); }
:^nop_left "||" "MUL CE2" "A0","*R0++","A1L" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(QUALIFIED_MUL)) { qualified_data_multiply(X2, CECFG2, 1, 6, 0); }

@define QUALIFIED_WIDE_MUL "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_24_45=0x110cd6 & wide_0_22=0x328821"
:"MULUS CE1" "A0","*R0++","A1L" is $(QUALIFIED_WIDE_MUL) & unary_wide_ce_bank=0 { qualified_data_multiply(X1, CECFG1, 0, 0, 1); }
:"MULUS CE2" "A0","*R0++","A1L" is $(QUALIFIED_WIDE_MUL) & unary_wide_ce_bank=1 { qualified_data_multiply(X1, CECFG2, 1, 0, 1); }

macro move_address_literal(dst, immediate, cfg, bank) {
    local incoming:2 = EST;
    local first:2;
    local second:2;
    unary_ce(CECFG1, incoming, CETBL, 0, first);
    unary_ce(CECFG2, incoming, CETBL, 1, second);
    local selected:2 = first * (1 - bank) + second * bank;
    if (selected == 0 && (cfg & 0x1000) == 0) goto <publish>;
    local byte:1 = immediate;
    dst = sext(byte);
  <publish>
    EST = (incoming & 0xcfff) | (first << 12) | (second << 13);
}

@define ADDRESS_LITERAL "slot_13_22=0x188 & slot_0_0=1 & address_literal_dst & address_literal_value"
:"MOVE CE1" address_literal_dst,address_literal_value is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & $(ADDRESS_LITERAL) { move_address_literal(address_literal_dst, address_literal_value, CECFG1, 0); }
:"MOVE CE1" address_literal_dst,address_literal_value "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(ADDRESS_LITERAL)); (slot_mode=0 & nop_right) { move_address_literal(address_literal_dst, address_literal_value, CECFG1, 0); }
:^nop_left "||" "MOVE CE2" address_literal_dst,address_literal_value is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(ADDRESS_LITERAL)) { move_address_literal(address_literal_dst, address_literal_value, CECFG2, 1); }

:"MOVE" "A2","*R1++RN1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x31dc92); (slot_mode=0 & nop_right) {
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    local value:2 = *[data]:2 address;
    local negative:1 = value s< 0;
    A2L = value;
    A2H = 0 - zext(negative);
    GB2 = 0 - negative;
    local flags:2 = (EST & 0x3000) | (zext(value == 0) << 3) | (zext(negative) << 4);
    local first:2;
    local second:2;
    unary_ce(CECFG1, flags, CETBL, 0, first);
    unary_ce(CECFG2, flags, CETBL, 1, second);
    EST = (flags & 0xfff) | (first << 12) | (second << 13);
}

macro unary_not_flags(word) {
    local flags:2 = (zext(word == 0xffff) << 3) | (zext(word < 0x8000) << 4);
    EST = (EST & 0xffc7) | flags;
}
macro unary_limit_flags(word) {
    local flags:2 = (zext(word == 0) << 3) | (zext(word >= 0x8000) << 4);
    EST = (EST & 0xffc4) | flags;
}
macro unary_fraction_flags(word) {
    # Signed fractional word * 2^16 + (-1) on the 40-bit adder. For this
    # disconnected result the only outputs are its carry and signed flags.
    local flags:2 = zext(word != 0) | (zext(word s<= 0) << 4) | (zext(word == 0x8000) << 5);
    EST = (EST & 0xffc4) | flags;
}
macro unary_max_flags(word) {
    # Compare a sign-extended word against the implicit 40-bit -1 input.
    local flags:2 = (zext(word == 0xffff) << 3) | (zext(word s< 0xffff) << 4);
    EST = (EST & 0xffe5) | flags;
}

macro wide_unary_data_read(address, width, low, high) {
    low = *[data]:2 address;
    high = 0;
    if (width == 1) goto <done>;
    local upper:2 = address + 1;
    high = *[data]:2 upper;
  <done>
}

macro wide_unary_r4(width, low, high, enabled) {
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    local address:2 = R4;
    wide_unary_data_read(address, width, low, high);
    modify_ptr_scaled(R4, RN4, RM4, RL4, 8, 2, width);
  <done>
}

macro wide_unary_r4_discard(width) {
    local low:2;
    local high:2;
    local enabled:2;
    wide_unary_r4(width, low, high, enabled);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_unary_r4_rotate(width, right) {
    local low:2;
    local high:2;
    local enabled:2;
    wide_unary_r4(width, low, high, enabled);
    if (enabled == 0) goto <done>;
    local carry_bit:2 = low & 1;
    if (right != 0) goto <commit>;
    carry_bit = low >> 15;
    if (width == 1) goto <commit>;
    carry_bit = high >> 15;
  <commit>
    EST = (EST & 0xfffe) | carry_bit;
  <done>
    publish_alu_ce(EST & 0xcfff);
}

macro wide_unary_subh_status(value) {
    local result:4 = ~value;
    local flags:2 = 1 | (zext(result == 0) << 3) | (zext((result & 0x80000000) != 0) << 4);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

@define WIDE_UNARY_DATA "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0"
:INC "CE1" "discard","*R4++" is $(WIDE_UNARY_DATA) & wide_0_22=0x4237cc & wide_40_45=0x14 { wide_unary_r4_discard(1:2); }
:NOT "CE1" "discard","*R4++:long" is $(WIDE_UNARY_DATA) & wide_0_22=0x422fcd & wide_40_45=0x14 { wide_unary_r4_discard(2:2); }
:ROL "CE1" "discard","*R4++" is $(WIDE_UNARY_DATA) & wide_0_22=0x423bcc & wide_40_45=0x14 { wide_unary_r4_rotate(1:2, 0:1); }
:ROL "CE1" "discard","*R4++:long" is $(WIDE_UNARY_DATA) & wide_0_22=0x423bcd & wide_40_45=0x14 { wide_unary_r4_rotate(2:2, 0:1); }
:ROR "CE1" "discard","*R4++:long" is $(WIDE_UNARY_DATA) & wide_0_22=0x423fcd & wide_40_45=0x14 { wide_unary_r4_rotate(2:2, 1:1); }

@define WIDE_ROTATE_DATA "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1"
@define WIDE_ROR_DATA "$(WIDE_ROTATE_DATA) & wide_10_22=0x108f"

macro wide_rotate_flags(is_zero, is_negative, carry_bit) {
    local flags:2 = (EST & 0xcfc6) | carry_bit | (zext(is_zero) << 3) | (zext(is_negative) << 4);
    publish_alu_ce(flags);
}

macro wide_ror_disconnected(address, destination) {
    local low:2 = *[data]:2 address;
    local next:2 = address + 1;
    local high:2 = *[data]:2 next;
    destination = 0;
    publish_alu_ce(EST & 0xcfff);
}

:ROR "R2","*R1:long" is $(WIDE_ROR_DATA) & wide_2_9=0xa2 & wide_40_45=1 & wide_0_1=1 {
    local address:2 = R1;
    wide_ror_disconnected(address, R2);
}
:ROR "R1","*R1++:long" is $(WIDE_ROR_DATA) & wide_2_9=0xa1 & wide_40_45=0x11 & wide_0_1=1 {
    local address:2 = R1;
    modify_ptr_scaled(R1, RN1, RM0, RL0, 2, 2, 2:2);
    wide_ror_disconnected(address, R1);
}
:ROR "R1","*R1++" is $(WIDE_ROR_DATA) & wide_2_9=0xa1 & wide_40_45=0x11 & wide_0_1=0 {
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 2);
    local low:2 = *[data]:2 address;
    local middle:2 = low >> 1;
    local in_bit:2 = EST & 1;
    R1 = middle | (in_bit * 0x8000);
    wide_rotate_flags(middle == 0 && in_bit == 0, in_bit != 0, low & 1);
}
:ROR "A1","*R1:long" is $(WIDE_ROR_DATA) & wide_2_9=0x89 & wide_40_45=1 & wide_0_1=1 {
    local address:2 = R1;
    local low:2 = *[data]:2 address;
    local next:2 = address + 1;
    local high:2 = *[data]:2 next;
    local in_bit:2 = EST & 1;
    local middle:2 = low >> 1;
    A1L = middle | ((high & 1) * 0x8000);
    A1H = (high >> 1) | (in_bit * 0x8000);
    GB1 = (in_bit != 0) * 0xff;
    wide_rotate_flags(middle == 0 && high == 0 && in_bit == 0, in_bit != 0, low & 1);
}
:ROL "R2","*R1:long" is $(WIDE_ROTATE_DATA) & wide_10_22=0x108e & wide_2_9=0xa2 & wide_40_45=1 & wide_0_1=1 {
    local address:2 = R1;
    local low:2 = *[data]:2 address;
    local next:2 = address + 1;
    local high:2 = *[data]:2 next;
    local in_bit:2 = EST & 1;
    R2 = (high + high) | (low >> 15) | in_bit;
    wide_rotate_flags(low == 0 && (high & 0x7fff) == 0 && in_bit == 0, (high & 0x4000) != 0, high >> 15);
}
:INC "CE1" "discard","*R2+RN2" is $(WIDE_UNARY_DATA) & wide_0_22=0x4237cc & wide_40_45=0x2a {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    local address:2 = R2 + RN2;
    local word:2 = *[data]:2 address;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:SUBL "CE1" "discard","*R4++:long" is $(WIDE_UNARY_DATA) & wide_0_22=0x4203cd & wide_40_45=0x14 {
    local low:2;
    local high:2;
    local enabled:2;
    wide_unary_r4(2:2, low, high, enabled);
    if (enabled == 0) goto <done>;
    EST = (EST & 0xffc4) | 0x11 | ((high >> 15) << 5);
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:SUBH "CE1" "discard","*R4++" is $(WIDE_UNARY_DATA) & wide_0_22=0x4207cc & wide_40_45=0x14 {
    local low:2;
    local high:2;
    local enabled:2;
    wide_unary_r4(1:2, low, high, enabled);
    if (enabled == 0) goto <done>;
    EST = (EST & 0xffc4) | 1 | (zext((low >> 15) == 0) << 4);
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:ADDL "CE1" "discard","*R4++" is $(WIDE_UNARY_DATA) & wide_0_22=0x4213cc & wide_40_45=0x14 {
    local low:2;
    local high:2;
    local enabled:2;
    wide_unary_r4(1:2, low, high, enabled);
    if (enabled == 0) goto <done>;
    EST = (EST & 0xffc4) | zext(low != 0) | (zext(low == 1) << 3) | (zext(low == 0) << 4);
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:SUBH "CE1" "discard","*R6+RN6:long" is $(WIDE_UNARY_DATA) & wide_0_22=0x4207f5 & wide_40_45=0x2e {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <finish>;
    local address:2 = R6 + RN6;
    local low:2;
    local high:2;
    wide_unary_data_read(address, 2:2, low, high);
    if (enabled == 0) goto <finish>;
    local result:4 = zext(low) | (zext(high) << 16);
    wide_unary_subh_status(result);
    goto <done>;
  <finish>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:^wide_logic_rmw_operator "LC1",wide_lc_rn,wide_lc_r is $(WIDE_LOGIC_RMW) & wide_lc_r_bank=4 & wide_lc_logic_form=0x1a95 & wide_0_1=2 & wide_lc_r & wide_lc_rn {
    local result:2;
    wide_logic_bitop(wide_logic_rmw_operator, wide_lc_rn, wide_lc_r, result);
    LC1 = result;
    local flags:2 = zext(result == 0) << 3;
    publish_alu_ce(flags);
}

macro wide_logic_discard_long(op, base, step, modulo, bound, shift, accumulator) {
    local address:2 = base;
    local upper:2 = address + 1;
    local low:2 = *[data]:2 address;
    local high:2 = *[data]:2 upper;
    modify_ptr_scaled(base, step, modulo, bound, shift, 2, 2:2);
    local sampled:8 = zext(low) | (zext(high) << 16);
    local acc:8 = zext(accumulator);
    local result:8;
    wide_logic_bitop(op, acc, sampled, result);
    local guard:1 = result(4);
    local negative:1 = (guard & 0x80) != 0;
    local extension:1 = guard != (0 - zext((result & 0x80000000) != 0));
    local flags:2 = (zext(result == 0) << 3) | (zext(negative) << 4) | (zext(extension) << 5);
    publish_alu_ce(flags);
}

:^wide_logic_rmw_operator "EST","*R5++","A3" is $(WIDE_LOGIC_RMW) & wide_40_45=0xb & wide_logic_rmw_route=0x30556 {
    wide_logic_discard_long(wide_logic_rmw_operator, R5, RN5, RM4, RL4, 10, A3);
}
:^wide_logic_rmw_operator "discard","*R5++","A3" is $(WIDE_LOGIC_RMW) & wide_40_45=0xb & wide_logic_rmw_route=0x36156 {
    wide_logic_discard_long(wide_logic_rmw_operator, R5, RN5, RM4, RL4, 10, A3);
}

macro unary_acc_biased(lo, hi, gb, value) {
    value = zext(gb ^ 0x80) * 0x100000000 + zext(hi) * 0x10000 + zext(lo);
}
macro unary_trace_max(lo, hi, gb, guard, word, trace, status) {
    local a:8;
    unary_acc_biased(lo, hi, gb, a);
    local raw_guard:8 = zext(guard);
    local b:8 = 0x8000000000 + raw_guard;
    local take:1 = a < b;
    word = a(2);
    if (!take) goto <unary_max_kept>;
    word = 0;  # The selected guard has no bits in the upper word.
    <unary_max_kept>
    local old_trace:2 = BTR1;
    trace = (old_trace << 1) | zext(take);
    # Compare A minus the guard. It underflows int40 iff biased A < guard,
    # in which case the wrapped result is positive. E/C and sticky L persist.
    local overflow:1 = a < raw_guard;
    local flags:2 = (zext(a == b) << 3) | (zext(take && !overflow) << 4) | (zext(overflow) << 1);
    local limit:1 = overflow && ((ECFG & 0xc) == 0);
    status = (EST & 0xffe5) | flags | (zext(limit) << 2);
}
macro unary_trace_max_only(lo, hi, gb, guard) {
    local a:8;
    unary_acc_biased(lo, hi, gb, a);
    local b:8 = 0x8000000000 + zext(guard);
    local old_trace:2 = BTR1;
    BTR1 = (old_trace << 1) | zext(a < b);
}
macro unary_trace_min_only(guard, word) {
    local a:2 = zext(guard);
    local old_trace:2 = BTR1;
    BTR1 = (old_trace << 1) | zext(word > a);
}

macro unary_ff12(negate, high, result, flags) {
    # FF2:FF1 enters the full datapath *zero* extended, including when FF2
    # has its high bit set. Use ordinary C widths for the guard/halves.
    local source:8 = zext(FF2) * 0x10000 + zext(FF1);
    local value:8 = (source - 2 * source * negate) & 0xffffffffff;
    local negative:1 = value >= 0x8000000000;
    local extended:1 = value > 0x7fffffff && value < 0xff80000000;
    local config:2 = ECFG;
    local limit:1 = extended && ((config & 4) != 0);
    local loss:1 = limit || (extended && high && ((config & 0x28) != 8));
    flags = (zext(source == 0) << 3) | (zext(negative) << 4) | (zext(extended) << 5)
            | (zext(loss) << 2) | (zext(source == 0) * negate);
    result = value;
    if (!limit) goto <unary_ff12_done>;
    result = 0x7fffffff;
    if (!negative) goto <unary_ff12_done>;
    result = 0xff80000000;
    <unary_ff12_done>
}
:NOT "CE1" "discard","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x422f62 & wide_40_45=0x10 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_not_flags(A0L); <unary_not_executed> }
:NOT "CE1" "discard","A1L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x422f62 & wide_40_45=0x11 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_not_flags(A1L); <unary_not_executed> }
:NOT "CE1" "discard","A2L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x422f62 & wide_40_45=0x12 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_not_flags(A2L); <unary_not_executed> }
:NOT "CE1" "discard","A3L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x422f62 & wide_40_45=0x13 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_not_flags(A3L); <unary_not_executed> }
:NOT "CE1" "discard","A4L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x422f62 & wide_40_45=0x14 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_not_flags(A4L); <unary_not_executed> }
:NOT "CE1" "discard","A5L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x422f62 & wide_40_45=0x15 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_not_flags(A5L); <unary_not_executed> }
:LIM "CE2" "discard","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_0_9=0x362 & wide_13_22=0x217 & wide_40_45=0x10 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <unary_not_executed>; unary_limit_flags(A0L); <unary_not_executed> }
:LIM "CE2" "discard","A1L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_0_9=0x362 & wide_13_22=0x217 & wide_40_45=0x11 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <unary_not_executed>; unary_limit_flags(A1L); <unary_not_executed> }
:LIM "CE2" "discard","A2L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_0_9=0x362 & wide_13_22=0x217 & wide_40_45=0x12 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <unary_not_executed>; unary_limit_flags(A2L); <unary_not_executed> }
:LIM "CE2" "discard","A3L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_0_9=0x362 & wide_13_22=0x217 & wide_40_45=0x13 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <unary_not_executed>; unary_limit_flags(A3L); <unary_not_executed> }
:LIM "CE2" "discard","A4L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_0_9=0x362 & wide_13_22=0x217 & wide_40_45=0x14 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <unary_not_executed>; unary_limit_flags(A4L); <unary_not_executed> }
