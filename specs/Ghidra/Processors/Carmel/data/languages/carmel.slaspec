conditional_target: word_address is conditional_words [ word_address = (inst_start + conditional_words) & 0xffffff; ] { export *[code]:3 word_address; }

macro pop_block_loop(depth) {
    local outer:2 = depth - 1;
    PSTATUS = (PSTATUS & 0xfff0) | outer | (zext(outer != 0) << 3);
    if (LOOP_FRAME != depth:1) goto <done>;
    LOOP_FRAME = outer:1;
  <done>
}

macro select_loop_continue(depth, counter, start, next, repeating) {
    if (counter == 0) goto <done>;
    counter = counter - 1;
    LC = counter;
    if (counter == 0) goto <finished>;
    repeating = 1;
    next = start & 0xffffff;
    goto <done>;
  <finished>
    pop_block_loop(depth);
  <done>
}

# CONTINUE resolves the selected frame before executing its exposed issues.
macro loop_continue(next, repeating) {
    next = 0;
    repeating = 0;
    if ((PSTATUS & 8) == 0) goto <done>;
    local depth:2 = PSTATUS & 7;
    if (depth != 1) goto <outer>;
    select_loop_continue(depth, LC1, LSA1W, next, repeating);
    goto <done>;
  <outer>
    if (depth != 2) goto <deep>;
    select_loop_continue(depth, LC2, LSA2W, next, repeating);
    goto <done>;
  <deep>
    if (depth != 3) goto <fourth>;
    select_loop_continue(depth, LC3, LSA3W, next, repeating);
    goto <done>;
  <fourth>
    if (depth != 4) goto <done>;
    select_loop_continue(depth, LC4, LSA4W, next, repeating);
  <done>
}

# BREAK leaves the innermost count unchanged and pops at writeback.
macro loop_break() {
    local depth:2 = PSTATUS & 7;
    if ((PSTATUS & 8) == 0 || depth == 0) goto <done>;
    pop_block_loop(depth);
  <done>
}

:CONTINUE direct_target "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_13_22=0x15a & slot_0_2=0 & direct_target); (slot_mode=0 & nop_right) {
    local next:4; local repeating:1;
    loop_continue(next, repeating);
    if (!repeating) goto direct_target;
    goto [next];
}

:CONTINUE direct_target "delay 1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_13_22=0x15a & slot_0_2=2 & direct_target); (slot_mode=0 & nop_right) [ carmel_counted_delay=1; ] {
    local next:4; local repeating:1;
    loop_continue(next, repeating);
    delayslot(1);
    if (!repeating) goto direct_target;
    goto [next];
}

