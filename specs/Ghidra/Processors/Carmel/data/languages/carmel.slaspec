:XOR "CE1" "A0H","*R4+=RN4","*R6++" "||" "XOR" "CE2" "X2","R7","*R5--" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_XOR_R4_R6) & parallel_logic_dst=8); (slot_mode=0 & $(PAR_LOGIC_XOR_R5) & parallel_logic_dst=14) { parallel_logic_xor_pair(A0H, 1:1); }
:XOR "CE1" "A1L","*R4+=RN4","*R6++" "||" "XOR" "CE2" "X2","R7","*R5--" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_XOR_R4_R6) & parallel_logic_dst=1); (slot_mode=0 & $(PAR_LOGIC_XOR_R5) & parallel_logic_dst=15) { parallel_logic_xor_pair(A1L, 0:1); }
