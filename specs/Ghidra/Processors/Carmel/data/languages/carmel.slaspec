# CALL uses the ordinary issue size, not inst_next after delay expansion.
macro store_link(old_sp, saved_pc) {
    local low_address:2 = old_sp - 1;
    local high_word:1 = saved_pc(2);
    *[data]:2 old_sp = zext(high_word);
    *[data]:2 low_address = saved_pc:2;
}

macro push_link(saved_pc) {
    local old_sp:2 = SP;
    SP = old_sp - 2;
    store_link(old_sp, saved_pc);
}

macro pop_link(target) {
    local low_address:2 = SP + 1;
    local high_address:2 = SP + 2;
    local low_word:2 = *[data]:2 low_address;
    local high_word:2 = *[data]:2 high_address;
    target = zext(low_word) | (zext(high_word) << 16);
    SP = high_address;
}

# TRAPCTX holds nested trap sources, newest in the two low bits.
macro retire_trap() {
    local active:2 = zext(TRAPCTX != 0);
    PSTATUS = PSTATUS & (0xffef | (active << 4));
    TRAPCTX = TRAPCTX >> 2;
}

