@define WIDE_SHORT_CALLABS "wide_right_mode=1 & ((wide_0_1=3 & wide_40_45>=32) | (wide_0_1=2 & (wide_40_45=6 | wide_40_45=7)))"

short_call_mode: is carmel_issue=5 & wide_left_mode=1 { export 3:1; }
short_call_mode: "CE1" is carmel_issue=4 & wide_left_mode=0 & wide_goto_ce_bank=0 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local mode:1 = (zext(enabled != 0) << 1) | zext(enabled != 0 || (CECFG1 & 0x1000) != 0);
    export mode;
}
short_call_mode: "CE2" is carmel_issue=4 & wide_left_mode=0 & wide_goto_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local mode:1 = (zext(enabled != 0) << 1) | zext(enabled != 0 || (CECFG2 & 0x1000) != 0);
    export mode;
}

macro prepare_short_call(mode, old_sp, target) {
    old_sp = SP;
    target = 0;
    if (mode == 0) goto <done>;
    SP = old_sp - 2;
    local low:2 = *[data]:2 0xffff:2;
    target = zext(low);
  <done>
}

macro complete_short_call(mode, old_sp, target, link, resume) {
    if (mode == 0) goto <done>;
    if ((mode & 2) == 0) goto <address_only>;
    store_link(old_sp, link);
    call [target];
    goto resume;
  <address_only>
    goto [target];
  <done>
}

:"CALLABS (*0xffff)" short_call_mode is $(WIDE_SHORT_CALLABS) & wide_10_22=0x13d1
    & short_call_mode & link_2_0 & resume_2_0 {
    local mode:1 = short_call_mode;
    local old_sp:2;
    local target:4;
    prepare_short_call(mode, old_sp, target);
    complete_short_call(mode, old_sp, target, link_2_0, resume_2_0);
}
:"CALLABS (*0xffff)" "delay 1" short_call_mode is $(WIDE_SHORT_CALLABS) & wide_10_22=0x13d3
    & short_call_mode & link_2_1 & resume_2_1 [ carmel_counted_delay=1; ] {
    local mode:1 = short_call_mode;
    local old_sp:2;
    local target:4;
    prepare_short_call(mode, old_sp, target);
    delayslot(1);
    complete_short_call(mode, old_sp, target, link_2_1, resume_2_1);
}
