# Stage arithmetic without publishing either packet lane's WB effects.
# The result is low 16, with the EST set bits in the next 16. L is sticky.
macro stage_move(value, staged) {
    local source:2 = value;
    local flags:4 = (zext(source == 0) << 3) | (zext(source s< 0) << 4);
    staged = zext(source) | (flags << 16);
}

macro stage_inc(value, staged) {
    local source:2 = value;
    local sum:2 = source + 1;
    local extend:1 = (source == 0x7fff);
    local limit:1 = extend && ((ECFG & 4) != 0);
    local sticky:1 = extend && (limit || ((ECFG & 0x28) != 8));
    local flags:4 = zext(source == 0xffff) | (zext(sticky) << 2) |
                    (zext(sum == 0) << 3) | (zext(source s< -1) << 4) |
                    (zext(extend) << 5);
    sum = sum - zext(limit);
    staged = zext(sum) | (flags << 16);
}

macro commit_half(destination, stage, shift) {
    destination = stage:2;
    EST = (EST & ~(0x3b << shift)) | (stage(2) << shift);
}

left_a0l: "INC" "A0L",inc_source is slot_0_0=0x0 & slot_6_22=0x86b0 & (slot_3_5=4 | slot_2_5=10) & inc_source { local staged:4; stage_inc(inc_source, staged); export staged; }
