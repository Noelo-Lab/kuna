# Assigned ADDRUPDATE ports are disjoint; no DATA access takes place.
macro reverse_word(value, reversed) {
    local x:2 = ((value & 0x5555) << 1) | ((value >> 1) & 0x5555);
    x = ((x & 0x3333) << 2) | ((x >> 2) & 0x3333);
    x = ((x & 0x0f0f) << 4) | ((x >> 4) & 0x0f0f);
    reversed = (x << 8) | (x >> 8);
}

macro modify_ptr_scaled(reg, increment, rm, rl, shift, modifier, width) {
    local action:2 = modifier;
    if (action == 0) goto <done>;
    local incoming:2 = reg;
    local mode_shift:4 = shift;
    local mode:2 = (PACFG >> mode_shift) & 3;
    local delta:2 = increment;
    if (action == 1) goto <with_delta>;
    delta = (5 - action * 2) * width;
  <with_delta>
    local result:2 = incoming + delta;
    if (mode == 2) goto <pair>;
    if (mode == 3) goto <explicit>;
    if (mode != 1 || action != 1) goto <publish>;
    local rev_in:2;
    local rev_step:2;
    reverse_word(incoming, rev_in);
    reverse_word(delta, rev_step);
    local rev_sum:2 = rev_in + rev_step;
    reverse_word(rev_sum, result);
    goto <publish>;
  <pair>
    # The implicit window starts at zero. Compare the wrapped 16-bit
    # candidate, not the incoming pointer's aligned block.
    local size:4 = zext(rm & 0xfff) + 1;
    if (zext(result) < size) goto <publish>;
    goto <wrap>;
  <explicit>
    size = zext(rm & 0xfff) + 1;
    local limit:4 = zext(rl) + size;
    if (limit <= 0x10000 && rl <= result && zext(result) < limit) goto <publish>;
  <wrap>
    if (delta s< 0) goto <wrapped_neg>;
    result = result - size:2;
    goto <publish>;
  <wrapped_neg>
    result = result + size:2;
  <publish>
    reg = result;
  <done>
}

macro modify_ptr(reg, increment, rm, rl, shift, modifier) {
    modify_ptr_scaled(reg, increment, rm, rl, shift, modifier, 1:2);
}

