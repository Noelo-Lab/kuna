# Immediate address-unit transfers and fixed long strides.
macro transfer_address_word(pointer, modulo, bound, shift, delta, result) {
    local base:2 = pointer;
    local mode:2 = (PACFG >> shift) & 3;
    local candidate:4 = sext(base) + sext(delta);
    if (mode < 2) goto <transfer_done>;

    local size:4;
    local lower:4;
    if (mode == 3) goto <transfer_explicit>;
    local mask:2 = modulo;
    mask = mask | (mask >> 1);
    mask = mask | (mask >> 2);
    mask = mask | (mask >> 4);
    mask = mask | (mask >> 8);
    lower = sext(base & ~mask);
    size = zext(modulo & 0xfff) + 1;
    if (candidate s>= lower && candidate s< lower + size) goto <transfer_done>;
    goto <transfer_wrap>;

  <transfer_explicit>
    candidate = zext(candidate:2);
    lower = zext(bound);
    size = zext(modulo) + 1;
    local limit:4 = lower + size;
    if (limit <= 0x10000 && lower <= candidate && candidate < limit) goto <transfer_done>;
  <transfer_wrap>
    if (delta s< 0) goto <transfer_reverse>;
    candidate = candidate - size;
    goto <transfer_done>;
  <transfer_reverse>
    candidate = candidate + size;
  <transfer_done>
    result = candidate:2;
}
