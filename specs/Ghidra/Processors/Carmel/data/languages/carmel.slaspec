:"GOTO NEQ2" conditional_target "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_1=0x0 & slot_9_22=0x142f & conditional_target); (slot_mode=0 & nop_right) { if (!((EST & 0x200) != 0)) goto conditional_target; }
:^nop_left "||" "GOTO NEQ2" conditional_target is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_1=0x0 & slot_9_22=0x142f & conditional_target) { if (!((EST & 0x200) != 0)) goto conditional_target; }
:"GOTO LE2" conditional_target is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_1=0x0 & slot_9_22=0x1430 & conditional_target { if ((((EST ^ (EST << 3)) & 0x400) != 0) || ((EST & 0x200) != 0)) goto conditional_target; }
:"GOTO LE2" conditional_target "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_1=0x0 & slot_9_22=0x1430 & conditional_target); (slot_mode=0 & nop_right) { if ((((EST ^ (EST << 3)) & 0x400) != 0) || ((EST & 0x200) != 0)) goto conditional_target; }
:^nop_left "||" "GOTO LE2" conditional_target is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_1=0x0 & slot_9_22=0x1430 & conditional_target) { if ((((EST ^ (EST << 3)) & 0x400) != 0) || ((EST & 0x200) != 0)) goto conditional_target; }
:"GOTO LT2" conditional_target is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_1=0x0 & slot_9_22=0x1432 & conditional_target { if ((((EST ^ (EST << 3)) & 0x400) != 0)) goto conditional_target; }
:"GOTO LT2" conditional_target "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_1=0x0 & slot_9_22=0x1432 & conditional_target); (slot_mode=0 & nop_right) { if ((((EST ^ (EST << 3)) & 0x400) != 0)) goto conditional_target; }
:^nop_left "||" "GOTO LT2" conditional_target is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_1=0x0 & slot_9_22=0x1432 & conditional_target) { if ((((EST ^ (EST << 3)) & 0x400) != 0)) goto conditional_target; }

:"REP" repeat_count is carmel_next_issue_size=3 & ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_10_22=0xaf0 & repeat_count { local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(3); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" repeat_count "||" nop_right is carmel_next_issue_size=3 & (carmel_issue=1 & slot_mode=0 & slot_10_22=0xaf0 & repeat_count); (slot_mode=0 & nop_right) { local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(3); count = count - 1; if (count != 0) goto <again>; <exit> }
:^nop_left "||" "REP" repeat_count is carmel_next_issue_size=3 & (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_10_22=0xaf0 & repeat_count) { local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(3); count = count - 1; if (count != 0) goto <again>; <exit> }
:^complete_left "||" "REP" repeat_count is carmel_next_issue_size=3 & (carmel_issue=1 & slot_mode=0 & $(COMPACT_COMPUTE) & complete_left); (slot_mode=0 & slot_10_22=0xaf0 & repeat_count) { build complete_left; local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(3); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" wide_repeat_count is carmel_next_issue_size=3 & carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_14_22=0x13b & wide_repeat_count { local count:2 = wide_repeat_count; if (count == 0) goto <exit>; <again> delayslot(3); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" wide_repeat_count "CE1" is carmel_next_issue_size=3 & carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_goto_ce_bank=0 & wide_14_22=0x13b & wide_repeat_count { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); local count:2 = 1; if ((enabled == 0) && ((CECFG1 & 0x1000) == 0)) goto <count_ready>; count = wide_repeat_count; <count_ready> if (count == 0) goto <exit>; <again> delayslot(3); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" repeat_count is carmel_next_issue_size=6 & ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_10_22=0xaf0 & repeat_count { local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(6); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" repeat_count "||" nop_right is carmel_next_issue_size=6 & (carmel_issue=1 & slot_mode=0 & slot_10_22=0xaf0 & repeat_count); (slot_mode=0 & nop_right) { local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(6); count = count - 1; if (count != 0) goto <again>; <exit> }
:^nop_left "||" "REP" repeat_count is carmel_next_issue_size=6 & (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_10_22=0xaf0 & repeat_count) { local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(6); count = count - 1; if (count != 0) goto <again>; <exit> }
:^complete_left "||" "REP" repeat_count is carmel_next_issue_size=6 & (carmel_issue=1 & slot_mode=0 & $(COMPACT_COMPUTE) & complete_left); (slot_mode=0 & slot_10_22=0xaf0 & repeat_count) { build complete_left; local count:2 = repeat_count; if (count == 0) goto <exit>; <again> delayslot(6); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" wide_repeat_count is carmel_next_issue_size=6 & carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_14_22=0x13b & wide_repeat_count { local count:2 = wide_repeat_count; if (count == 0) goto <exit>; <again> delayslot(6); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" wide_repeat_count "CE1" is carmel_next_issue_size=6 & carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_goto_ce_bank=0 & wide_14_22=0x13b & wide_repeat_count { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); local count:2 = 1; if ((enabled == 0) && ((CECFG1 & 0x1000) == 0)) goto <count_ready>; count = wide_repeat_count; <count_ready> if (count == 0) goto <exit>; <again> delayslot(6); count = count - 1; if (count != 0) goto <again>; <exit> }

# Dynamic count is sampled before three setup issues. A zero count skips
# the first body issue only, even when a nonzero count would replay a range.
repeat_setup: is epsilon { delayslot(3); }
repeat_first: is epsilon { delayslot(1); }

:"REP A0L" "||" nop_right^repeat_setup is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x2bc400 & repeat_setup); (slot_mode=0 & nop_right) [ carmel_counted_delay=1; carmel_split_delay=1; ] { local count:2 = A0L; build repeat_setup; if (count == 0) goto <exit>; <again> delayslot(1); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP (R1)+RN1" "delay 3"^repeat_setup is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x4f1c00 & wide_24_45=0x90000 & repeat_setup [ carmel_counted_delay=1; carmel_split_delay=1; ] { local count:2 = R1; modify_ptr(R1, RN1, RM0, RL0, 2, 1); build repeat_setup; if (count == 0) goto <exit>; <again> delayslot(1); count = count - 1; if (count != 0) goto <again>; <exit> }

@define REPEAT_DATA "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_14_22=0x13c & wide_0_10=0 & wide_40_45=0x38 & absolute_data_addr & repeat_setup"
:"REP" "*"^absolute_data_addr "delay" wide_repeat_delay^repeat_setup is $(REPEAT_DATA) & wide_repeat_long=0 & wide_repeat_delay [ carmel_counted_delay=1; carmel_split_delay=1; ] { local address:2 = absolute_data_addr; local count:2 = *[data]:2 address; local delay:1 = wide_repeat_delay; build repeat_setup; if (count == 0) goto <exit>; if (delay == 3) goto <again>; count = 1; <again> delayslot(1); count = count - 1; if (count != 0) goto <again>; <exit> }
:"REP" "*"^absolute_data_addr "delay 4"^repeat_setup^repeat_first is $(REPEAT_DATA) & wide_repeat_delay=4 & repeat_first [ carmel_counted_delay=1; carmel_split_delay=1; ] { local address:2 = absolute_data_addr; local count:2 = *[data]:2 address; build repeat_setup; if (count == 0) goto <tail>; <again> build repeat_first; <tail> delayslot(1); if (count <= 1) goto <exit>; count = count - 1; goto <again>; <exit> }
:"REP" "*"^absolute_data_addr "delay 5"^repeat_setup^repeat_first is $(REPEAT_DATA) & wide_repeat_delay=5 & repeat_first [ carmel_counted_delay=1; carmel_split_delay=1; ] { local address:2 = absolute_data_addr; local count:2 = *[data]:2 address; build repeat_setup; if (count == 0) goto <tail>; <again> build repeat_first; <tail> delayslot(2); if (count <= 1) goto <exit>; count = count - 1; goto <again>; <exit> }
:"REP" "*"^absolute_data_addr "delay 6"^repeat_setup^repeat_first is $(REPEAT_DATA) & wide_repeat_delay=6 & repeat_first [ carmel_counted_delay=1; carmel_split_delay=1; ] { local address:2 = absolute_data_addr; local count:2 = *[data]:2 address; build repeat_setup; if (count == 0) goto <tail>; <again> build repeat_first; <tail> delayslot(3); if (count <= 1) goto <exit>; count = count - 1; goto <again>; <exit> }
:"REP" "*"^absolute_data_addr "delay 7"^repeat_setup^repeat_first is $(REPEAT_DATA) & wide_repeat_delay=7 & repeat_first [ carmel_counted_delay=1; carmel_split_delay=1; ] { local address:2 = absolute_data_addr; local count:2 = *[data]:2 address; build repeat_setup; if (count == 0) goto <tail>; <again> build repeat_first; <tail> delayslot(4); if (count <= 1) goto <exit>; count = count - 1; goto <again>; <exit> }

# The extended count selects an implicit DATA word; the encoded address is
# disconnected. The console guard proves the first replay issue is the end.
:"REP *0xffff delay 3"^repeat_setup is carmel_issue=5 & carmel_implicit_repeat=1
    & wide_left_mode=1 & wide_right_mode=1 & wide_10_22=0x13c6 & wide_repeat_extended=1
    & repeat_setup [ carmel_counted_delay=1; carmel_split_delay=1; ] {
    local count:2 = *[data]:2 0xffff:2;
    build repeat_setup;
    if (count == 0) goto <exit>;
  <again>
    delayslot(1);
    count = count - 1;
    if (count != 0) goto <again>;
  <exit>
}

data_load_dst: "R0" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x280 & wide_13_22=0x21b & wide_40_45=0x38 { export R0; }
data_load_dst: "R1" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x284 & wide_13_22=0x21b & wide_40_45=0x38 { export R1; }
data_load_dst: "R2" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x288 & wide_13_22=0x21b & wide_40_45=0x38 { export R2; }
data_load_dst: "R3" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x28c & wide_13_22=0x21b & wide_40_45=0x38 { export R3; }
data_load_dst: "R4" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x290 & wide_13_22=0x21b & wide_40_45=0x38 { export R4; }
data_load_dst: "R5" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x294 & wide_13_22=0x21b & wide_40_45=0x38 { export R5; }
data_load_dst: "R6" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x298 & wide_13_22=0x21b & wide_40_45=0x38 { export R6; }
data_load_dst: "R7" is wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x29c & wide_13_22=0x21b & wide_40_45=0x38 { export R7; }
:MOVE data_load_dst,"*"^absolute_data_addr is carmel_issue=5 & data_load_dst & absolute_data_addr { local address:2 = absolute_data_addr; data_load_dst = *[data]:2 address; }

@define WIDE_DISPLACED_MOVE "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45>=0x20 & wide_40_45<=0x27 & wide_move_base & wide_move_displacement"

:MOVE wide_move_load_dst,"*"^wide_move_base^"+"^wide_move_displacement is $(WIDE_DISPLACED_MOVE) & wide_move_load_opcode=0x21b14 & wide_0_1=0 & wide_move_load_dst {
    local address:2 = wide_move_base + sext(wide_move_displacement:1);
    wide_move_load_dst = *[data]:2 address;
}
:MOVE "*R0","*"^wide_move_base^"+"^wide_move_displacement is $(WIDE_DISPLACED_MOVE) & wide_0_22=0x436020 {
    local address:2 = wide_move_base + sext(wide_move_displacement:1);
    local word:2 = *[data]:2 address;
    local shift:1 = (ECFG & 0x20) != 0;
    *[data]:2 R0 = word s>> shift;
}

# The signed MOVE mux uses separate DATA widths for the source and destination AGUs.
wide_smove_word_src: "*"^wide_move_base is wide_smove_src_mode=0 & wide_move_base { }
wide_smove_word_src: "*"^wide_move_base^"++" is wide_smove_src_mode=2
    & wide_move_base & wide_logic_rhs_modulo & wide_logic_rhs_bound & wide_logic_rhs_mode_shift {
    modify_ptr(wide_move_base, 0:2, wide_logic_rhs_modulo, wide_logic_rhs_bound, wide_logic_rhs_mode_shift, 2:2);
}
wide_smove_long_src: "long *"^wide_move_base is wide_smove_src_mode=0 & wide_move_base { }
wide_smove_long_src: "long *"^wide_move_base^"++" is wide_smove_src_mode=2
    & wide_move_base & wide_logic_rhs_modulo & wide_logic_rhs_bound & wide_logic_rhs_mode_shift {
    modify_ptr_scaled(wide_move_base, 0:2, wide_logic_rhs_modulo, wide_logic_rhs_bound, wide_logic_rhs_mode_shift, 2:2, 2:2);
}
wide_smove_dst_update: wide_logic_lhs_ptr is wide_logic_lhs_ptr & wide_smove_dst_long
    & wide_logic_lhs_modulo & wide_logic_lhs_bound & wide_logic_lhs_mode_shift {
    local stride:2 = 1 + wide_smove_dst_long;
    modify_ptr_scaled(wide_logic_lhs_ptr, 0:2, wide_logic_lhs_modulo, wide_logic_lhs_bound, wide_logic_lhs_mode_shift, 2:2, stride);
}
wide_smove_dst: "*"^wide_logic_lhs_ptr is wide_smove_dst_mode=0 & wide_logic_lhs_ptr { }
wide_smove_dst: "long *"^wide_logic_lhs_ptr is wide_smove_dst_mode=8 & wide_logic_lhs_ptr { }
wide_smove_dst: "*"^wide_smove_dst_update^"++" is wide_smove_dst_mode=2 & wide_smove_dst_update {
    build wide_smove_dst_update;
}
wide_smove_dst: "long *"^wide_smove_dst_update^"++" is wide_smove_dst_mode=10 & wide_smove_dst_update {
    build wide_smove_dst_update;
}
wide_smove_saved: "LSA1" is wide_40_45=0x12 { export LSA1; }
wide_smove_saved: "LEA1" is wide_40_45=0x13 { export LEA1; }

macro wide_smove_read_long(address, value) {
    local low:2 = *[data]:2 address;
    local upper:2 = address + 1;
    local high:2 = *[data]:2 upper;
    value = (zext(high) << 16) | zext(low);
}
macro wide_smove_write_long(address, value) {
    local upper:2 = address + 1;
    *[data]:2 address = value(0);
    *[data]:2 upper = value(2);
}
macro wide_smove_sr1(value, shifted) {
    local scale:4 = zext((ECFG & 0x20) != 0);
    shifted = value s>> scale;
}

@define WIDE_SIGNED_MOVE "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1 & wide_10_22=0x10d8 & wide_ce_prefix & wide_smove_dst & wide_logic_lhs_ptr"

# Dual updates to a single pointer can stop in the address stage.
@define WIDE_SIGNED_MOVE_SAFE "wide_smove_src_mode=0 | wide_smove_dst_mode=0 | wide_smove_dst_mode=8 | (wide_smove_src_r0=0 & wide_smove_dst_r0=1) | (wide_smove_src_r0=1 & wide_smove_dst_r0=0) | (wide_smove_src_r1=0 & wide_smove_dst_r1=1) | (wide_smove_src_r1=1 & wide_smove_dst_r1=0) | (wide_smove_src_r2=0 & wide_smove_dst_r2=1) | (wide_smove_src_r2=1 & wide_smove_dst_r2=0)"

:MOVE wide_ce_prefix wide_smove_dst,wide_smove_word_src is $(WIDE_SIGNED_MOVE)
    & ($(WIDE_SIGNED_MOVE_SAFE)) & wide_move_base & wide_0_1=0 & wide_smove_dst_long=1 & wide_smove_word_src {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <publish>;
    local source:2 = wide_move_base;
    local dest:2 = wide_logic_lhs_ptr;
    build wide_smove_word_src;
    build wide_smove_dst;
    local word:2 = *[data]:2 source;
    if (execute == 0) goto <publish>;
    local value:4 = sext(word);
    local shifted:4;
    wide_smove_sr1(value, shifted);
    wide_smove_write_long(dest, shifted);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:MOVE wide_ce_prefix wide_smove_dst,wide_smove_long_src is $(WIDE_SIGNED_MOVE)
    & ($(WIDE_SIGNED_MOVE_SAFE)) & wide_move_base & wide_0_1=1 & wide_smove_dst_long=0 & wide_smove_long_src {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <publish>;
    local source:2 = wide_move_base;
    local dest:2 = wide_logic_lhs_ptr;
    build wide_smove_long_src;
    build wide_smove_dst;
    local value:4;
    wide_smove_read_long(source, value);
    if (execute == 0) goto <publish>;
    local shifted:4;
    wide_smove_sr1(value, shifted);
    *[data]:2 dest = shifted(2);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:MOVE wide_ce_prefix wide_smove_dst,wide_smove_long_src is $(WIDE_SIGNED_MOVE)
    & ($(WIDE_SIGNED_MOVE_SAFE)) & wide_move_base & wide_0_1=1 & wide_smove_dst_long=1 & wide_smove_long_src {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <publish>;
    local source:2 = wide_move_base;
    local dest:2 = wide_logic_lhs_ptr;
    build wide_smove_long_src;
    build wide_smove_dst;
    local value:4;
    wide_smove_read_long(source, value);
    if (execute == 0) goto <publish>;
    local shifted:4;
    wide_smove_sr1(value, shifted);
    wide_smove_write_long(dest, shifted);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:MOVE wide_ce_prefix wide_smove_dst,wide_smove_saved is $(WIDE_SIGNED_MOVE)
    & wide_0_1=3 & (wide_smove_dst_mode=8 | wide_smove_dst_mode=10) & wide_smove_saved {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <publish>;
    local dest:2 = wide_logic_lhs_ptr;
    build wide_smove_dst;
    if (execute == 0) goto <publish>;
    local value:4 = zext(wide_smove_saved);
    local shifted:4;
    wide_smove_sr1(value, shifted);
    wide_smove_write_long(dest, shifted);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_SIGNED_MOVE_REG "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1 & wide_10_22=0x10d9 & wide_ce_prefix"
@define SIGNED_MOVE_HALF_DST "(wide_2_9>=0x90 & wide_2_9<=0x95) | (wide_2_9>=0x98 & wide_2_9<=0x9d)"
@define SIGNED_MOVE_LATCH_DST "wide_2_9=0x96 | wide_2_9=0x97 | wide_2_9=0x9e | wide_2_9=0x9f"

:MOVE wide_ce_prefix wide_smove_reg_dst,wide_smove_acc is $(WIDE_SIGNED_MOVE_REG)
    & wide_0_1=2 & ($(SIGNED_MOVE_HALF_DST)) & wide_smove_reg_dst
    & wide_40_45>=8 & wide_40_45<=13 & wide_smove_acc & wide_smove_acc_high & wide_smove_acc_guard {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    local flags:2 = EST & 0xcfff;
    if (execute == 0) goto <publish>;
    local high:2 = wide_smove_acc_high;
    local guard:1 = wide_smove_acc_guard;
    local extended:1 = guard != (0:1 - zext(high s< 0));
    local limited:1 = extended && (ECFG & 0xc) == 0;
    wide_smove_reg_dst = high;
    flags = (flags & 0xffc4) | (zext(limited) << 2) | (zext(high == 0 && guard == 0) << 3)
          | (zext(guard s< 0) << 4) | (zext(extended) << 5);
  <publish>
    publish_ce_feedback(flags, EST);
}

:MOVE wide_ce_prefix wide_smove_reg_dst,wide_smove_reg_src is $(WIDE_SIGNED_MOVE_REG)
    & wide_0_1=2 & ($(SIGNED_MOVE_LATCH_DST)) & wide_smove_reg_dst
    & ((wide_40_45>=16 & wide_40_45<=21) | (wide_40_45>=24 & wide_40_45<=29)) & wide_smove_reg_src {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <publish>;
    wide_smove_reg_dst = wide_smove_reg_src;
  <publish>
    publish_ce_feedback(EST & 0xcfff, EST);
}

wide_smove_latch_source: wide_smove_word_src is wide_smove_word_src { build wide_smove_word_src; }
wide_smove_latch_source: "*"^wide_move_base^"--" is wide_smove_src_mode=3
    & wide_move_base & wide_logic_rhs_modulo & wide_logic_rhs_bound & wide_logic_rhs_mode_shift {
    modify_ptr(wide_move_base, 0:2, wide_logic_rhs_modulo, wide_logic_rhs_bound, wide_logic_rhs_mode_shift, 3:2);
}

:MOVE wide_ce_prefix wide_smove_reg_dst,wide_smove_latch_source is $(WIDE_SIGNED_MOVE_REG)
    & wide_0_1=0 & ($(SIGNED_MOVE_LATCH_DST)) & wide_smove_reg_dst & wide_move_base & wide_smove_latch_source {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <publish>;
    local address:2 = wide_move_base;
    build wide_smove_latch_source;
    wide_smove_reg_dst = *[data]:2 address;
  <publish>
    publish_ce_feedback(EST & 0xcfff, EST);
}

:MOVE "A3","X1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1
    & wide_10_22=0x10d8 & wide_2_9=0x8b & wide_0_1=2 & wide_40_45=0x1e {
    local source:2 = X1;
    local signed_high:2 = 0 - zext(source s< 0);
    A3L = source;
    A3H = signed_high;
    GB3 = signed_high:1;
    local flags:2 = (EST & 0xcfc4) | (zext(source == 0) << 3) | (zext(source s< 0) << 4);
    publish_alu_ce(flags);
}

