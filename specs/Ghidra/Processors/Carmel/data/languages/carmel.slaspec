@define COMPACT_A0L "((slot_0_0=0x0 & slot_6_22=0x86b0 & (slot_3_5=4 | slot_2_5=10)) | (slot_0_0=0x0 & slot_5_22=0x18d50 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A1L "((slot_0_0=0x0 & slot_6_22=0x86b1 & (slot_3_5=4 | slot_2_5=10)) | (slot_0_0=0x0 & slot_5_22=0x18d51 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A2L "((slot_0_0=0x0 & slot_6_22=0x86b2 & (slot_3_5=4 | slot_2_5=10)) | (slot_0_0=0x0 & slot_5_22=0x18d52 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A3L "((slot_0_0=0x0 & slot_6_22=0x86b3 & (slot_3_5=4 | slot_2_5=10)) | (slot_0_0=0x0 & slot_5_22=0x18d53 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A4L "((slot_0_0=0x0 & slot_6_22=0x86b4 & (slot_3_5=4 | slot_2_5=10)) | (slot_0_0=0x0 & slot_5_22=0x18d54 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A5L "((slot_0_0=0x0 & slot_6_22=0x86b5 & (slot_3_5=4 | slot_2_5=10)) | (slot_0_0=0x0 & slot_5_22=0x18d55 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A0H "((slot_0_0=0x0 & slot_5_22=0x18d58 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A1H "((slot_0_0=0x0 & slot_5_22=0x18d59 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A2H "((slot_0_0=0x0 & slot_5_22=0x18d5a & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A3H "((slot_0_0=0x0 & slot_5_22=0x18d5b & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A4H "((slot_0_0=0x0 & slot_5_22=0x18d5c & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_A5H "((slot_0_0=0x0 & slot_5_22=0x18d5d & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6)))"
@define COMPACT_COMPUTE "($(COMPACT_A0L) | $(COMPACT_A1L) | $(COMPACT_A2L) | $(COMPACT_A3L) | $(COMPACT_A4L) | $(COMPACT_A5L) | $(COMPACT_A0H) | $(COMPACT_A1H) | $(COMPACT_A2H) | $(COMPACT_A3H) | $(COMPACT_A4H) | $(COMPACT_A5H))"

complete_left: left_a0l is $(COMPACT_A0L) & left_a0l { build left_a0l; commit_half(A0L, left_a0l, 0); }
complete_left: left_a1l is $(COMPACT_A1L) & left_a1l { build left_a1l; commit_half(A1L, left_a1l, 0); }
complete_left: left_a2l is $(COMPACT_A2L) & left_a2l { build left_a2l; commit_half(A2L, left_a2l, 0); }
complete_left: left_a3l is $(COMPACT_A3L) & left_a3l { build left_a3l; commit_half(A3L, left_a3l, 0); }
complete_left: left_a4l is $(COMPACT_A4L) & left_a4l { build left_a4l; commit_half(A4L, left_a4l, 0); }
complete_left: left_a5l is $(COMPACT_A5L) & left_a5l { build left_a5l; commit_half(A5L, left_a5l, 0); }
complete_left: left_a0h is $(COMPACT_A0H) & left_a0h { build left_a0h; commit_half(A0H, left_a0h, 0); }
complete_left: left_a1h is $(COMPACT_A1H) & left_a1h { build left_a1h; commit_half(A1H, left_a1h, 0); }
complete_left: left_a2h is $(COMPACT_A2H) & left_a2h { build left_a2h; commit_half(A2H, left_a2h, 0); }
complete_left: left_a3h is $(COMPACT_A3H) & left_a3h { build left_a3h; commit_half(A3H, left_a3h, 0); }
complete_left: left_a4h is $(COMPACT_A4H) & left_a4h { build left_a4h; commit_half(A4H, left_a4h, 0); }
complete_left: left_a5h is $(COMPACT_A5H) & left_a5h { build left_a5h; commit_half(A5H, left_a5h, 0); }
complete_right: right_a0l is $(COMPACT_A0L) & right_a0l { build right_a0l; commit_half(A0L, right_a0l, 6); }
complete_right: right_a1l is $(COMPACT_A1L) & right_a1l { build right_a1l; commit_half(A1L, right_a1l, 6); }
complete_right: right_a2l is $(COMPACT_A2L) & right_a2l { build right_a2l; commit_half(A2L, right_a2l, 6); }
complete_right: right_a3l is $(COMPACT_A3L) & right_a3l { build right_a3l; commit_half(A3L, right_a3l, 6); }
complete_right: right_a4l is $(COMPACT_A4L) & right_a4l { build right_a4l; commit_half(A4L, right_a4l, 6); }
complete_right: right_a5l is $(COMPACT_A5L) & right_a5l { build right_a5l; commit_half(A5L, right_a5l, 6); }
complete_right: right_a0h is $(COMPACT_A0H) & right_a0h { build right_a0h; commit_half(A0H, right_a0h, 6); }
complete_right: right_a1h is $(COMPACT_A1H) & right_a1h { build right_a1h; commit_half(A1H, right_a1h, 6); }
complete_right: right_a2h is $(COMPACT_A2H) & right_a2h { build right_a2h; commit_half(A2H, right_a2h, 6); }
complete_right: right_a3h is $(COMPACT_A3H) & right_a3h { build right_a3h; commit_half(A3H, right_a3h, 6); }
complete_right: right_a4h is $(COMPACT_A4H) & right_a4h { build right_a4h; commit_half(A4H, right_a4h, 6); }
complete_right: right_a5h is $(COMPACT_A5H) & right_a5h { build right_a5h; commit_half(A5H, right_a5h, 6); }

loop_restart: address is epsilon [ address = hw_loop_restart; ] {
    export *[code]:3 address;
}

loop_endpoint: address is hw_loop_end [ address = (inst_start + hw_loop_end) & 0xfffffe; ] {
    export *[code]:3 address;
}

loop_register_endpoint: address is hw_loop_reg_end [ address = (inst_start + hw_loop_reg_end) & 0xffffff; ] {
    export *[code]:3 address;
}

loop_prepare_end: value is epsilon [ value = hw_loop_prepare_end; ] { export *[const]:4 value; }
loop_tail_end: value is epsilon [ value = hw_loop_tail_end; ] { export *[const]:4 value; }
loop_first: value is epsilon [ value = hw_loop_first; ] { export *[const]:4 value; }
loop_last: value is epsilon [ value = hw_loop_last; ] { export *[const]:4 value; }
loop_start_at: value is epsilon [ value = hw_loop_start_at; ] { export *[const]:4 value; }
loop_end_at: value is epsilon [ value = hw_loop_end_at; ] { export *[const]:4 value; }

@define BLOCK_LOOP_PLAN "hw_loop_setup=1 & loop_first & loop_last & loop_start_at & loop_end_at"
@define ARM_LOOP_PLAN "loop_first, loop_last, loop_start_at, loop_end_at"

macro publish_loop_word(value, high, low) {
    high = value(2);
    low = value(0);
}

# Publications are pending in the live frame, not in a per-instruction owner
# slot. When phases coincide, immediate address writes precede dynamic EX.
macro publish_loop_address(due, value, pending, address, high, low, bit, depth, level) {
    local at:4 = inst_start;
    if (depth < level) goto <done>;
    if ((pending & bit) == 0 || at != due) goto <done>;
    address = value;
    publish_loop_word(value, high, low);
    pending = pending & ~bit;
  <done>
}

macro activate_loop_bank(due, first, last, pending, count, start, end, counter, depth, level, frame) {
    local at:4 = inst_start;
    if (depth < level) goto <done>;
    if ((pending & 4) == 0 || at != due) goto <done>;
    start = first;
    end = last;
    counter = count;
    publish_loop_word(first, LSAH, LSAL);
    publish_loop_word(last, LEAH, LEAL);
    LC = count;
    LOOP_FRAME = frame;
    pending = pending & 0xfb;
  <done>
}

macro capture_loop_count(due, pending, count, depth, level) {
    local at:4 = inst_start;
    if (depth < level) goto <done>;
    if ((pending & 8) == 0 || at != due) goto <done>;
    count = RN0;
    pending = pending & 0xf7;
  <done>
}

loop_publish_start: is hw_loop_start_publish=0 { }
loop_publish_start: is hw_loop_start_publish=1 {
    local depth:2 = PSTATUS & 0x000f;
    publish_loop_address(LOOP_FIRST_AT1, LOOP_FIRST_WORD1, LOOP_PENDING1, LSA1W, LSAH, LSAL, 1:1, depth, 9:2);
    publish_loop_address(LOOP_FIRST_AT2, LOOP_FIRST_WORD2, LOOP_PENDING2, LSA2W, LSAH, LSAL, 1:1, depth, 10:2);
    publish_loop_address(LOOP_FIRST_AT3, LOOP_FIRST_WORD3, LOOP_PENDING3, LSA3W, LSAH, LSAL, 1:1, depth, 11:2);
    publish_loop_address(LOOP_FIRST_AT4, LOOP_FIRST_WORD4, LOOP_PENDING4, LSA4W, LSAH, LSAL, 1:1, depth, 12:2);
}

loop_publish_end: is hw_loop_end_publish=0 { }
loop_publish_end: is hw_loop_end_publish=1 {
    local depth:2 = PSTATUS & 0x000f;
    publish_loop_address(LOOP_LAST_AT1, LOOP_LAST_WORD1, LOOP_PENDING1, LEA1W, LEAH, LEAL, 2:1, depth, 9:2);
    publish_loop_address(LOOP_LAST_AT2, LOOP_LAST_WORD2, LOOP_PENDING2, LEA2W, LEAH, LEAL, 2:1, depth, 10:2);
    publish_loop_address(LOOP_LAST_AT3, LOOP_LAST_WORD3, LOOP_PENDING3, LEA3W, LEAH, LEAL, 2:1, depth, 11:2);
    publish_loop_address(LOOP_LAST_AT4, LOOP_LAST_WORD4, LOOP_PENDING4, LEA4W, LEAH, LEAL, 2:1, depth, 12:2);
}

loop_activate: is hw_loop_activate=0 { }
loop_activate: is hw_loop_activate=1 {
    local depth:2 = PSTATUS & 0x000f;
    activate_loop_bank(LOOP_LAST_AT1, LOOP_FIRST_WORD1, LOOP_LAST_WORD1, LOOP_PENDING1, LOOP_COUNT1, LSA1W, LEA1W, LC1, depth, 9:2, 1:1);
    activate_loop_bank(LOOP_LAST_AT2, LOOP_FIRST_WORD2, LOOP_LAST_WORD2, LOOP_PENDING2, LOOP_COUNT2, LSA2W, LEA2W, LC2, depth, 10:2, 2:1);
    activate_loop_bank(LOOP_LAST_AT3, LOOP_FIRST_WORD3, LOOP_LAST_WORD3, LOOP_PENDING3, LOOP_COUNT3, LSA3W, LEA3W, LC3, depth, 11:2, 3:1);
    activate_loop_bank(LOOP_LAST_AT4, LOOP_FIRST_WORD4, LOOP_LAST_WORD4, LOOP_PENDING4, LOOP_COUNT4, LSA4W, LEA4W, LC4, depth, 12:2, 4:1);
}

loop_capture: is hw_loop_capture_rn0=0 { }
loop_capture: is hw_loop_capture_rn0=1 {
    local depth:2 = PSTATUS & 0x000f;
    capture_loop_count(LOOP_FIRST_AT1, LOOP_PENDING1, LOOP_COUNT1, depth, 9:2);
    capture_loop_count(LOOP_FIRST_AT2, LOOP_PENDING2, LOOP_COUNT2, depth, 10:2);
    capture_loop_count(LOOP_FIRST_AT3, LOOP_PENDING3, LOOP_COUNT3, depth, 11:2);
    capture_loop_count(LOOP_FIRST_AT4, LOOP_PENDING4, LOOP_COUNT4, depth, 12:2);
}

# A prepared decision belongs to one physical terminal issue. Retire only
# the frame that was on top at selection, including when ends coincide.
macro retire_loop_bank(word, pending, counter, start, end_hi, end_lo, depth, top, next, previous_frame) {
    if (depth != top) goto <done>;
    local expected_hi:1 = word(2);
    local expected_lo:2 = word:2;
    if ((pending & 7) != 0 || end_hi != expected_hi || end_lo != expected_lo || counter == 0) goto <done>;
    counter = counter - 1;
    LC = counter;
    if (counter == 0) goto <pop>;
    LOOP_REDIRECT = 2;
    LOOP_TARGET = start & 0xffffff;
    goto <done>;
  <pop>
    PSTATUS = (PSTATUS & 0xfff0) | next;
    LOOP_FRAME = previous_frame;
  <done>
}

macro prepare_loop_redirect(word) {
    LOOP_REDIRECT_AT = word;
    LOOP_REDIRECT = 1;
    LOOP_TARGET = 0;
    local depth:2 = PSTATUS & 0x000f;
    retire_loop_bank(word, LOOP_PENDING1, LC1, LSA1W, LEA1H, LEA1L, depth, 9:2, 0:2, 0:1);
    retire_loop_bank(word, LOOP_PENDING2, LC2, LSA2W, LEA2H, LEA2L, depth, 10:2, 9:2, 1:1);
    retire_loop_bank(word, LOOP_PENDING3, LC3, LSA3W, LEA3H, LEA3L, depth, 11:2, 10:2, 2:1);
    retire_loop_bank(word, LOOP_PENDING4, LC4, LSA4W, LEA4H, LEA4L, depth, 12:2, 11:2, 3:1);
}

macro select_current_tail(word) {
    if (LOOP_REDIRECT != 0 && LOOP_REDIRECT_AT == word) goto <selected>;
    prepare_loop_redirect(word);
  <selected>
    LOOP_TAIL_REDIRECT = LOOP_REDIRECT == 2;
    LOOP_TAIL_TARGET = LOOP_TARGET;
    LOOP_REDIRECT = 0;
}

loop_decide: is hw_loop_prepare=0 & hw_loop_tail=0 { }
loop_decide: is hw_loop_prepare=1 & hw_loop_tail=0 & loop_prepare_end {
    prepare_loop_redirect(loop_prepare_end);
}
loop_decide: is hw_loop_prepare=0 & hw_loop_tail=1 & loop_tail_end {
    select_current_tail(loop_tail_end);
}
loop_decide: is hw_loop_prepare=1 & hw_loop_tail=1 & loop_tail_end & loop_prepare_end {
    select_current_tail(loop_tail_end);
    if (LOOP_TAIL_REDIRECT != 0) goto <done>;
    prepare_loop_redirect(loop_prepare_end);
  <done>
}

loop_finish: is hw_loop_tail=0 { }
loop_finish: is hw_loop_tail=1 & hw_loop_indirect=0 & loop_restart {
    if (LOOP_TAIL_REDIRECT != 0) goto loop_restart;
}
loop_finish: is hw_loop_tail=1 & hw_loop_indirect=1 {
    if (LOOP_TAIL_REDIRECT == 0) goto <done>;
    goto [LOOP_TAIL_TARGET];
  <done>
}

:^instruction is hw_loop_phase=0 & hw_loop_actions=1 & loop_publish_start & loop_publish_end & loop_activate & loop_decide & instruction & loop_capture & loop_finish [ hw_loop_phase=1; ] {
    build loop_publish_start;
    build loop_publish_end;
    build loop_activate;
    build loop_decide;
    build instruction;
    build loop_capture;
    build loop_finish;
}
:^instruction is hw_loop_phase=0 & hw_loop_actions=0 & instruction [ hw_loop_phase=1; ] {
    build instruction;
}

macro install_loop_bank(value, flags, pending, count, counter, first_word, last_word,
                        first_at, last_at, staged_first, staged_last, start_due, end_due, frame) {
    pending = flags;
    count = value;
    staged_first = first_word;
    staged_last = last_word;
    start_due = first_at;
    end_due = last_at;
    if ((flags & 4) != 0) goto <done>;
    counter = value;
    LC = value;
    LOOP_FRAME = frame;
  <done>
}

macro arm_block_loop(value, flags, first_word, last_word, first_at, last_at) {
    local prior:2 = PSTATUS & 0x000f;
    if (prior == 9) goto <bank2>;
    if (prior == 10) goto <bank3>;
    if (prior == 11) goto <bank4>;
    if (prior != 0) goto <done>;
    install_loop_bank(value, flags, LOOP_PENDING1, LOOP_COUNT1, LC1,
                      first_word, last_word, first_at, last_at,
                      LOOP_FIRST_WORD1, LOOP_LAST_WORD1, LOOP_FIRST_AT1, LOOP_LAST_AT1, 1:1);
    PSTATUS = (PSTATUS & 0xfff0) | 9;
    goto <done>;
  <bank2>
    install_loop_bank(value, flags, LOOP_PENDING2, LOOP_COUNT2, LC2,
                      first_word, last_word, first_at, last_at,
                      LOOP_FIRST_WORD2, LOOP_LAST_WORD2, LOOP_FIRST_AT2, LOOP_LAST_AT2, 2:1);
    PSTATUS = (PSTATUS & 0xfff0) | 10;
    goto <done>;
  <bank3>
    install_loop_bank(value, flags, LOOP_PENDING3, LOOP_COUNT3, LC3,
                      first_word, last_word, first_at, last_at,
                      LOOP_FIRST_WORD3, LOOP_LAST_WORD3, LOOP_FIRST_AT3, LOOP_LAST_AT3, 3:1);
    PSTATUS = (PSTATUS & 0xfff0) | 11;
    goto <done>;
  <bank4>
    install_loop_bank(value, flags, LOOP_PENDING4, LOOP_COUNT4, LC4,
                      first_word, last_word, first_at, last_at,
                      LOOP_FIRST_WORD4, LOOP_LAST_WORD4, LOOP_FIRST_AT4, LOOP_LAST_AT4, 4:1);
    PSTATUS = (PSTATUS & 0xfff0) | 12;
  <done>
}

with : hw_loop_phase=1 {

:REPEAT hw_loop_count,loop_endpoint is (carmel_issue=1 & slot_mode=0 & slot_16_22=0x2a & slot_15_15=0 & hw_loop_count & loop_endpoint & hw_loop_delay & $(BLOCK_LOOP_PLAN)); (slot_mode=0 & nop_right) {
    arm_block_loop(hw_loop_count, 3:1, $(ARM_LOOP_PLAN));
}
:REPEAT hw_loop_count,loop_endpoint is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_16_22=0x2a & slot_15_15=0 & hw_loop_count & loop_endpoint & hw_loop_delay & $(BLOCK_LOOP_PLAN) {
    arm_block_loop(hw_loop_count, 3:1, $(ARM_LOOP_PLAN));
}
:REPEAT "0",loop_endpoint is (carmel_issue=1 & slot_mode=0 & slot_16_22=0x2a & slot_15_15=0 & hw_loop_count=0 & loop_endpoint & hw_loop_delay); (slot_mode=0 & nop_right) unimpl
:REPEAT "0",loop_endpoint is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_16_22=0x2a & slot_15_15=0 & hw_loop_count=0 & loop_endpoint & hw_loop_delay unimpl

:REPEAT "RN0",loop_register_endpoint "delay" hw_loop_reg_delay is (carmel_issue=1 & slot_mode=0 & slot_16_22=0x2a & slot_15_15=1 & hw_loop_reg_source=24 & loop_register_endpoint & hw_loop_reg_delay & $(BLOCK_LOOP_PLAN)); (slot_mode=0 & nop_right) {
    arm_block_loop(0:2, 12:1, $(ARM_LOOP_PLAN));
}

:^nop_left is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & nop_left { }
:^complete_left is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & $(COMPACT_COMPUTE) & complete_left { build complete_left; }
:^nop_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & nop_right) { }
:^complete_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_COMPUTE) & complete_left); (slot_mode=0 & nop_right) { build complete_left; }
:^nop_left "||" complete_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_COMPUTE) & complete_right) { build complete_right; }

# Sample and compute both lanes before publishing either lane's result.
:^left_a0l "||" right_a0l is (carmel_issue=1 & slot_mode=0 & $(COMPACT_A0L) & left_a0l); (slot_mode=0 & $(COMPACT_A0L) & right_a0l) unimpl
:^left_a0l "||" right_a1l is (carmel_issue=1 & slot_mode=0 & $(COMPACT_A0L) & left_a0l); (slot_mode=0 & $(COMPACT_A1L) & right_a1l) { build left_a0l; build right_a1l; commit_half(A0L, left_a0l, 0); commit_half(A1L, right_a1l, 6); }
