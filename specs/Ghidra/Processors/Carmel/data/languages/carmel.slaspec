# R0's AGU reserves the incoming address; the store uses it after update.
macro advance_r0(address) {
    local mode:2 = PACFG & 3;
    local next_address:2 = address + 1;
    if (mode < 2) goto <publish>;
    local modulo:2 = RM0 & 0xfff;
    local count:2 = modulo + 1;
    if (mode == 3) goto <bounded>;
    # Expand the low modulo bits to the power-of-two aligned window mask.
    local span:2 = modulo | (modulo >> 1);
    span = span | (span >> 2);
    span = span | (span >> 4);
    span = span | (span >> 8);
    if ((address & span) < modulo) goto <publish>;
    goto <wrap>;
  <bounded>
    local end:4 = zext(RL0) + zext(count);
    if ((end <= 0x10000) && (RL0 <= next_address) && (zext(next_address) < end)) goto <publish>;
  <wrap>
    next_address = next_address - count;
  <publish>
    R0 = next_address;
}

