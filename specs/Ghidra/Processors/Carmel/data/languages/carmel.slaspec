:ADDFRAC "CE1" "discard","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x4217ce & wide_40_45=0x10 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_fraction_flags(A0L); <unary_not_executed> }
:ADDFRAC "CE1" "discard","A1L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_0_22=0x4217ce & wide_40_45=0x11 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <unary_not_executed>; unary_fraction_flags(A1L); <unary_not_executed> }
