frame_displacement: encoded is wide_frame_delta_0 & wide_frame_delta_22 [ encoded = wide_frame_delta_0 | (wide_frame_delta_22 << 22); ] { export *[const]:2 encoded; }

:LINK wide_ce_prefix link_ce_register,frame_displacement is carmel_issue=4 & wide_left_mode=0
    & wide_right_mode=1 & wide_14_22=0x118 & link_qualifier=0
    & wide_2_9>=0xc2 & wide_2_9<=0xc4 & wide_ce_prefix & link_ce_register & frame_displacement {
    build wide_ce_prefix;
    local execute:2;
    local agu:2;
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (agu == 0) goto <done>;
    local old_sp:2 = SP;
    local saved:2 = link_ce_register;
    link_ce_register = old_sp - 1;
    SP = old_sp + frame_displacement;
    # The early register result can change the later DATA store predicate.
    wide_issue_enable(wide_ce_prefix, execute, agu);
    if (execute == 0) goto <done>;
    frame_store(old_sp, saved);
  <done>
    publish_alu_ce(EST & 0xcfff);
}

macro wide_frame_link(frame_reg, displacement) {
    local old_sp:2 = SP;
    local saved:2 = frame_reg;
    frame_reg = old_sp - 1;
    SP = old_sp + displacement;
    frame_store(old_sp, saved);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_frame_link_ce(frame_reg, displacement, config, bank) {
    local enabled:2;
    unary_ce(config, EST, CETBL, bank, enabled);
    if (enabled == 0 && (config & 0x1000) == 0) goto <feedback>;
    local old_sp:2 = SP;
    local saved:2 = frame_reg;
    frame_reg = old_sp - 1;
    SP = old_sp + displacement;
    if (enabled == 0) goto <feedback>;
    frame_store(old_sp, saved);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

macro wide_frame_link_open(displacement, saved) {
    local old_sp:2 = SP;
    SP = old_sp + displacement;
    frame_store(old_sp, saved);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_frame_link_open_ce(displacement, config, bank) {
    local enabled:2;
    unary_ce(config, EST, CETBL, bank, enabled);
    if (enabled == 0 && (config & 0x1000) == 0) goto <feedback>;
    local old_sp:2 = SP;
    SP = old_sp + displacement;
    if (enabled == 0) goto <feedback>;
    frame_store(old_sp, 0xffff:2);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:LINK "GB0",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0x80 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement {
    local old_sp:2 = SP;
    local saved:2 = zext(GB0);
    local frame:2 = old_sp - 1;
    GB0 = frame:1;
    SP = old_sp + frame_displacement;
    frame_store(old_sp, saved);
    publish_alu_ce(EST & 0xcfff);
}
