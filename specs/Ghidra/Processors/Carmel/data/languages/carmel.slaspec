# MAC1 signed-register product. Inactive ALUs do not own EST.
macro signed_product_result(lo, hi, guard, left, right, flags) {
    # Sign-extend into a native C integer width before multiplication.
    # Doubling by multiplication avoids C's undefined left shift of a negative result.
    local a:8 = sext(left);
    local b:8 = sext(right);
    local scale:8 = 1 + sext(ECFG & 1);
    local product:8 = a * b * scale;
    local extend:1 = (product s> 0x7fffffff);
    local limit:1 = extend && ((ECFG & 4) != 0);
    flags = (zext(limit) << 2) | (zext(product == 0) << 3) |
                    (zext(product s< 0) << 4) | (zext(extend) << 5);
    # A signed 16x16 result has no magnitude beyond the low 32 bits.
    # Keep the native guard without requiring a nonstandard C integer width.
    local result:4 = product:4 - zext(limit);
    lo = result:2;
    hi = result(2);
    guard = -zext(product s< 0);
}
macro signed_product(lo, hi, guard, left, right) {
    local flags:2;
    signed_product_result(lo, hi, guard, left, right, flags);
    EST = (EST & 0xffc4) | flags;
}

template_index: encoded is index_low_0 & index_high_0 [ encoded = index_low_0 | (index_high_0 << 10); ] { }
:CLIW template_index is (((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1) & wide_20_22=0x5 & template_index unimpl
:CLIW template_index is (((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1) & template_index & carmel_cliw_known=1 & wide_0_0=0x0 & wide_3_7=0x18 & wide_10_14=0x18 & wide_20_22=0x5 & wide_34_46=0x318 & wide_8_9<2 & wide_1_2<2 & tpl_52_63=0xfff & tpl_64_72=0xff & tpl_49_51=0x0 & tpl_24_31=0xff & tpl_32_46=0x3fff & tpl_3_23=0xfffff & tpl_0_2=0x0 & tpl_73_95=0x3fffff { }
@define CLIW_SIGNED_MAC1 "tpl_52_63=0xfff & tpl_64_72=0xff & tpl_49_51=0x0 & tpl_24_31=0xff & tpl_32_46=0x3fff & tpl_3_23=0xfffff & tpl_0_2=0x0 & tpl_91_95=0x10 & tpl_78_82=0x1f & (tpl_87_90=0 | tpl_87_90=1 | tpl_87_90=2 | tpl_87_90=3 | tpl_87_90=4 | tpl_87_90=5 | tpl_87_90=6 | tpl_87_90=7) & mac_left & (tpl_83_86=0 | tpl_83_86=1 | tpl_83_86=2 | tpl_83_86=3 | tpl_83_86=4 | tpl_83_86=5 | tpl_83_86=6 | tpl_83_86=7) & mac_right & (tpl_73_77=16 | tpl_73_77=17 | tpl_73_77=18 | tpl_73_77=19 | tpl_73_77=20 | tpl_73_77=21) & mac_lo & mac_hi & mac_guard"
:CLIW template_index is (((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1) & template_index & carmel_cliw_known=1 & wide_0_0=0x0 & wide_3_7=0x18 & wide_10_14=0x18 & wide_20_22=0x5 & wide_34_46=0x318 & wide_8_9<2 & wide_1_2<2 & $(CLIW_SIGNED_MAC1) { signed_product(mac_lo, mac_hi, mac_guard, mac_left, mac_right); }

# A bound DATA port is fetched even when the template does not use its word.
macro cliw_read_discarded(address) {
    local discarded:2 = *[data]:2 address;
}

cliw_ma4_access: is cliw_terminal_ma4=8 { cliw_read_discarded(R0); modify_ptr(R0, RN0, RM0, RL0, 0, 2); }
cliw_ma4_access: is cliw_terminal_ma4=14 { cliw_read_discarded(R2); modify_ptr(R2, RN2, RM2, RL2, 4, 3); }
cliw_ma4_access: is cliw_terminal_ma4=25 { local address:2 = SP + 1; cliw_read_discarded(address); SP = SP + 2; }
cliw_ma4_access: is cliw_terminal_ma4=26 { local address:2 = SP + 1; cliw_read_discarded(address); SP = SP + 1; }
cliw_ma4_access: is cliw_terminal_ma4=24 | cliw_terminal_ma4=27 { }
cliw_ma4_access: is cliw_terminal_ma4=28 { cliw_read_discarded(R0); }
cliw_ma4_access: is cliw_terminal_ma4=29 { cliw_read_discarded(R1); }
cliw_ma4_access: is cliw_terminal_ma4=30 { cliw_read_discarded(R2); }
cliw_ma4_access: is cliw_terminal_ma4=31 { cliw_read_discarded(R3); }

@define CLIW_TERMINAL_MAC "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & template_index & carmel_cliw_known=1 & wide_20_22=5 & cliw_address_bank=14 & wide_10_14=22 & wide_8_9=0 & wide_3_7=8 & wide_1_2=0 & wide_0_0=0 & $(CLIW_SIGNED_MAC1)"
macro cliw_terminal_product(lo, hi, guard, left, right) {
    local flags:2;
    signed_product_result(lo, hi, guard, left, right, flags);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:CLIW template_index is $(CLIW_TERMINAL_MAC) & cliw_terminal_ma3_condition=7 & cliw_ma4_access {
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    cliw_read_discarded(R3);
    build cliw_ma4_access;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
    cliw_terminal_product(mac_lo, mac_hi, mac_guard, mac_left, mac_right);
}

:CLIW template_index is $(CLIW_TERMINAL_MAC) & cliw_terminal_ma3_condition=28 &
    cliw_terminal_ma4>=24 & cliw_terminal_ma4<=27 & cliw_ma4_access {
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    build cliw_ma4_access;
    cliw_terminal_product(mac_lo, mac_hi, mac_guard, mac_left, mac_right);
}
@undef CLIW_TERMINAL_MAC
@undef CLIW_SIGNED_MAC1

# CLIW: sample one physical ALU lane, compute, then publish its result and EST bits.
macro cliw_alu_sample(lo, hi, guard, bits) {
    bits = zext(guard) * 0x100000000 + zext(hi) * 0x10000 + zext(lo);
}
macro cliw_alu_status(bits, flags) {
    flags = (zext(bits == 0) << 3) | (zext(bits >= 0x8000000000) << 4) |
            (zext(bits > 0x7fffffff && bits < 0xff80000000) << 5);
}
macro cliw_alu_limit32(value, limited) {
    limited = 0x7fffffff;
    if (value < 0x8000000000) goto <cliw_alu_limit_done>;
    limited = 0xff80000000;
    <cliw_alu_limit_done>
}
macro cliw_alu_finish(value, carry_out, overflow, config, word, result, flags) {
    cliw_alu_status(value, flags);
    local auto_limit:1 = (config & 4) != 0;
    local saturated:1 = (config & 0x28) == 8;
    local loss:1 = (overflow || (word != 0 && (flags & 0x20) != 0)) && !auto_limit && !saturated;
    flags = flags | zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2);
    result = value;
    if (!auto_limit || ((value >> 31) & 1) == ((value >> 32) & 1)) goto <cliw_alu_finish_done>;
    cliw_alu_limit32(value, result);
    flags = flags | 4;
    <cliw_alu_finish_done>
}
macro cliw_alu_add(left, right, result, flags) {
    local sum:8 = left + right;
    local value:8 = sum & 0xffffffffff;
    local carry_out:1 = sum > 0xffffffffff;
    local overflow:1 = (left ^ right) < 0x8000000000 && (left ^ value) >= 0x8000000000;
    cliw_alu_finish(value, carry_out, overflow, ECFG, 0:1, result, flags);
}
macro cliw_alu_cmp(left, right, config, flags) {
    local diff:8 = (left - right) & 0xffffffffff;
    local negative:1 = diff >= 0x8000000000;
    local overflow:1 = ((left ^ right) >= 0x8000000000) && ((diff ^ left) >= 0x8000000000);
    local loss:1 = overflow && ((config & 0xc) == 0);
    flags = (zext(diff == 0) << 3) | (zext(negative) << 4) |
            (zext(overflow) << 1) | (zext(loss) << 2);
}
macro cliw_alu_shift(left, right, width, signed_shift, config, incoming, result, flags) {
    # Count is signed seven-bit for both result widths. The wide datapath
    # clips to its own width; the narrow one keeps the full signed count.
    local sign:8 = 1 << (width - 1);
    local mask:8 = sign * 2 - 1;
    local negative:1 = signed_shift != 0 && left >= sign;
    local fill:8 = -zext(negative);
    local count:4 = right:4 & 127;
    local carry_out:1 = (incoming & 1) != 0;
    local shifted:8 = left | (fill & ~mask);
    if (count == 0) goto <cliw_shift_flags>;
    if (count >= 64) goto <cliw_shift_right>;
    if (width != 40 || count <= 40) goto <cliw_shift_left>;
    count = 40;
    <cliw_shift_left>
    carry_out = 0;
    if (count > width) goto <cliw_shift_left_done>;
    carry_out = ((left >> (width - count)) & 1) != 0;
    <cliw_shift_left_done>
    shifted = shifted << count;
    goto <cliw_shift_flags>;
    <cliw_shift_right>
    local distance:4 = 128 - count;
    if (width != 40 || distance <= 40) goto <cliw_shift_right_data>;
    distance = 40;
    <cliw_shift_right_data>
    carry_out = negative;
    shifted = fill;
    if (distance > width) goto <cliw_shift_flags>;
    carry_out = ((left >> (distance - 1)) & 1) != 0;
    shifted = (left >> distance) | (fill << (width - distance));
    <cliw_shift_flags>
    if (width != 16) goto <cliw_shift_aligned>;
    shifted = shifted << 16;
    <cliw_shift_aligned>
    result = shifted & 0xffffffffff;
    cliw_alu_status(result, flags);
    flags = flags | zext(carry_out);
    if (signed_shift == 0 || (config & 4) == 0 || ((result >> 31) & 1) == ((result >> 32) & 1))
        goto <cliw_shift_done>;
    local limited:8;
    cliw_alu_limit32(result, limited);
    result = limited;
    flags = flags | 4;
    <cliw_shift_done>
}
macro cliw_alu_extract(left, right, result, flags) {
    local count:4 = right:4 & 31;
    local high:2 = right(2);
    local offset:4 = zext(high & 31);
    local one:8 = 1;
    local mask:8 = (one << count) - 1;
    local fill:8 = -zext(left >= 0x8000000000);
    local bits:8 = ((left | (fill & 0xffffff0000000000)) >> offset) & mask;
    # The sign-extended field is zero when count is zero, without shifting
    # by count - 1 or doing arithmetic in a signed host type.
    local sign:8 = (one << count) >> 1;
    result = ((bits ^ sign) - sign) & 0xffffffffff;
    cliw_alu_status(result, flags);
    flags = flags & 0x18;
}
macro cliw_alu_packed(left, right, minimum, old1, old2, result, trace1, trace2) {
    local lh:2 = left(2);
    local ll:2 = left:2;
    local rh:2 = right(2);
    local rl:2 = right:2;
    local take_high:1 = (lh s< rh && minimum != 0) || (lh s> rh && minimum == 0);
    local take_low:1 = (ll s< rl && minimum != 0) || (ll s> rl && minimum == 0);
    local high:2 = rh;
    local low:2 = rl;
    if (!take_high) goto <cliw_packed_low>;
    high = lh;
    <cliw_packed_low>
    if (!take_low) goto <cliw_packed_done>;
    low = ll;
    <cliw_packed_done>
    result = (zext(low) + (sext(high) * 0x10000)) & 0xffffffffff;
    trace1 = (old1 << 1) | zext(take_high);
    trace2 = (old2 << 1) | zext(take_low);
}

# Immutable templates with no active DATA ports. Match the invocation's
# address and predicate fields independently of the template index.
@define CLIW_EXT_CALL "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_20_22=5 & cliw_address_bank=12 & wide_34_46=0x318 & wide_0_0=0 & wide_10_14=24 & wide_3_7=24 & wide_8_9=1 & wide_1_2=1 & carmel_cliw_known=1 & template_index"
@define CLIW_EXT_NO_LOADS "tpl_49_51=0 & tpl_0_2=0"
@define CLIW_EXT_IDLE_2 "tpl_24_31=0xff & tpl_32_46=0x3fff & tpl_3_23=0xfffff"
@define CLIW_EXT_ALU1_NOP "tpl_52_63=0xfff & tpl_64_72=0xff"

# The shared selector crosses the MAC2/ALU1 seam. Both lanes read the same
# RN word; MAC2 latches it into X2 before the accumulator writebacks.
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) &
    tpl_73_95=0x3fffff & tpl_3_23=0xfffff & cliw_shared_rn &
    tpl_67_72=36 & tpl_64_66=3 & tpl_62_63=3 & tpl_57_61=31 & tpl_52_56=16 &
    cliw_mac2_op=16 & cliw_mac2_left=14 & cliw_mac2_right=2 &
    cliw_mac2_addend_hi=3 & cliw_mac2_addend_lo=7 & cliw_mac2_dest=17 {
    local source:2 = cliw_shared_rn;
    local factor:2 = A2L;
    local moved:8 = ((zext(source) ^ 0x8000) - 0x8000) & 0xffffffffff;
    local alu_flags:2;
    cliw_alu_status(moved, alu_flags);
    X2 = source;
    local mac_flags:2;
    signed_product_result(A1L, A1H, GB1, source, factor, mac_flags);
    write_accumulator40(A0L, A0H, GB0, moved);
    publish_alu_ce((EST & 0xc106) | alu_flags | (mac_flags << 6));
}

@define CLIW_EXT_MAC1_ACC_DEST "tpl_73_77>=16 & tpl_73_77<=21 & mac_lo & mac_hi & mac_guard"
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_NOP) & $(CLIW_EXT_MAC1_ACC_DEST) &
    tpl_91_95=4 & tpl_87_90=15 & tpl_83_86=15 & tpl_78_82=23 {
    local pair:4 = zext(FF1) * 0x10000 + zext(FF2);
    local value:8 = ((zext(pair) ^ 0x80000000) - 0x80000000) & 0xffffffffff;
    local flags:2;
    cliw_alu_status(value, flags);
    write_accumulator40(mac_lo, mac_hi, mac_guard, value);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

macro cliw_arithmetic_write(lo, hi, guard, exact, raw) {
    local value:8;
    local flags:2;
    raw_mac_finish(exact, raw, 0:1, 0:1, 0:1, value, flags);
    write_accumulator40(lo, hi, guard, value);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

@define CLIW_EXT_MAC1_WORD "tpl_87_90=15 & tpl_83_86<8 & mac_right & tpl_78_82>=16 & tpl_78_82<=21 & cliw_mac1_acc_lo & cliw_mac1_acc_hi & cliw_mac1_acc_guard"
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_NOP) & $(CLIW_EXT_MAC1_ACC_DEST) & $(CLIW_EXT_MAC1_WORD) & tpl_91_95=5 {
    local base:8;
    cliw_alu_sample(cliw_mac1_acc_lo, cliw_mac1_acc_hi, cliw_mac1_acc_guard, base);
    local word:8 = (zext(mac_right) ^ 0x8000) - 0x8000;
    local exact:8 = ((base ^ 0x8000000000) - 0x8000000000) + word;
    cliw_arithmetic_write(mac_lo, mac_hi, mac_guard, exact, base + (word & 0xffffffffff));
}
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_NOP) & $(CLIW_EXT_MAC1_ACC_DEST) & $(CLIW_EXT_MAC1_WORD) & tpl_91_95=8 {
    local base:8;
    cliw_alu_sample(cliw_mac1_acc_lo, cliw_mac1_acc_hi, cliw_mac1_acc_guard, base);
    local word:8 = (zext(mac_right) ^ 0x8000) - 0x8000;
    local exact:8 = ((base ^ 0x8000000000) - 0x8000000000) - word;
    cliw_arithmetic_write(mac_lo, mac_hi, mac_guard, exact, base + (~word & 0xffffffffff) + 1);
}
@undef CLIW_EXT_MAC1_WORD
@undef CLIW_EXT_MAC1_ACC_DEST
@undef CLIW_EXT_ALU1_NOP

cliw_ext_alu1_left: is tpl_64_66=4 & cliw_alu_62_acc_4_0 & cliw_alu_62_acc_4_1 & cliw_alu_62_acc_4_2 {
    local value:8;
    cliw_alu_sample(cliw_alu_62_acc_4_0, cliw_alu_62_acc_4_1, cliw_alu_62_acc_4_2, value);
    export value;
}
cliw_ext_alu1_left: is tpl_64_66=5 & tpl_62_63<2 & cliw_alu_62_acc_5_0 & cliw_alu_62_acc_5_1 & cliw_alu_62_acc_5_2 {
    local value:8;
    cliw_alu_sample(cliw_alu_62_acc_5_0, cliw_alu_62_acc_5_1, cliw_alu_62_acc_5_2, value);
    export value;
}
@define CLIW_EXT_ALU1_ACC "tpl_73_95=0x3fffff & cliw_ext_alu1_left & tpl_57_61>=16 & tpl_57_61<=21 & cliw_alu_57_acc_0_0 & cliw_alu_57_acc_0_1 & cliw_alu_57_acc_0_2 & tpl_52_56>=16 & tpl_52_56<=21 & cliw_alu_52_acc_0_0 & cliw_alu_52_acc_0_1 & cliw_alu_52_acc_0_2"

# These rounded ALU routes use the fixed upward tie bias, even with
# ECFG.R set. Carry is from the biased adder, before clearing the low word.
macro cliw_round_finish(exact, raw, value, flags) {
    raw_mac_finish((exact + 0x8000) & 0xffffffffffff0000, raw + 0x8000, 0:1, 0:1, 0:1, value, flags);
}
macro cliw_round_write(lo, hi, guard, exact, raw) {
    local value:8;
    local flags:2;
    cliw_round_finish(exact, raw, value, flags);
    lo = 0;
    hi = value(2);
    guard = value(4);
    publish_alu_ce((EST & 0xcfc4) | flags);
}
macro cliw_round_subtract(lo, hi, guard, left, right) {
    local exact:8 = ((left ^ 0x8000000000) - 0x8000000000) - ((right ^ 0x8000000000) - 0x8000000000);
    cliw_round_write(lo, hi, guard, exact, left + (~right & 0xffffffffff) + 1);
}

# Register-only MAC1: select and latch the OF input before publishing a result.
cliw_mac1_first: is tpl_87_90<8 & mac_left { export mac_left; }
cliw_mac1_first: is tpl_87_90=12 { X1 = FF1; export FF1; }
cliw_mac1_first: is tpl_87_90=13 { X1 = FF2; export FF2; }
cliw_mac1_first: is tpl_87_90=15 { export X1; }
cliw_mac1_second: is tpl_83_86<8 & mac_right { export mac_right; }
cliw_mac1_second: is tpl_83_86=12 { export FF1; }
cliw_mac1_second: is tpl_83_86=13 { export FF2; }

# Plain signed products from two accumulator halves already have a route.
cliw_mac1_product_signs: is tpl_91_95=16 & (tpl_87_90>=12 | tpl_83_86>=12) { export 3:1; }
cliw_mac1_product_signs: is tpl_91_95=17 { export 1:1; }
cliw_mac1_product_signs: is tpl_91_95=18 { export 2:1; }
cliw_mac1_product_signs: is tpl_91_95=19 { export 0:1; }

cliw_mac1_accumulate: is tpl_91_95=24 { export 0:1; }
cliw_mac1_accumulate: is tpl_91_95=28 { export 1:1; }

macro cliw_mac1_status(flags) {
    publish_ce_feedback((EST & 0xcfc4) | flags, EST);
}

macro cliw_mac1_wide_product(left, right, signs, product) {
    local a:8 = zext(left);
    local b:8 = zext(right);
    if ((signs & 1) == 0) goto <left_ready>;
    a = sext(left);
  <left_ready>
    if ((signs & 2) == 0) goto <right_ready>;
    b = sext(right);
  <right_ready>
    product = a * b * (1 + zext(ECFG & 1));
}

macro cliw_mac1_rounded_write(lo, hi, guard, exact, raw) {
    local value:8;
    local flags:2;
    cliw_round_finish(exact, raw, value, flags);
    lo = 0;
    hi = value(2);
    guard = value(4);
    cliw_mac1_status(flags);
}

@define CLIW_EXT_MAC1_FACTORS "cliw_mac1_first & cliw_mac1_second"
@define CLIW_EXT_MAC1_FULL "tpl_73_77>=16 & tpl_73_77<=21 & mac_lo & mac_hi & mac_guard"
@define CLIW_EXT_MAC1_ADDEND "tpl_78_82>=16 & tpl_78_82<=21 & cliw_mac1_acc_lo & cliw_mac1_acc_hi & cliw_mac1_acc_guard"

cliw_mac1_compute: is $(CLIW_EXT_MAC1_FACTORS) & $(CLIW_EXT_MAC1_FULL) &
    tpl_78_82=31 & cliw_mac1_product_signs {
    build cliw_mac1_first;
    local signs:1 = cliw_mac1_product_signs;
    local product:8;
    cliw_mac1_wide_product(cliw_mac1_first, cliw_mac1_second, signs, product);
    local value:8;
    local flags:2;
    raw_mac_finish_limit(product, product & 0xffffffffff, 0:1, 0:1, 0:1, signs == 3, value, flags);
    write_accumulator40(mac_lo, mac_hi, mac_guard, value);
    cliw_mac1_status(flags);
}

cliw_mac1_compute: is $(CLIW_EXT_MAC1_FACTORS) & tpl_91_95=16 & tpl_78_82=31 &
    tpl_73_77>=8 & tpl_73_77<=13 & cliw_mac1_high_dest {
    build cliw_mac1_first;
    local product:8;
    raw_mac_product(cliw_mac1_first, cliw_mac1_second, 1:1, 1:1, product);
    local value:8;
    local flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, value, flags);
    cliw_mac1_high_dest = value(2);
    cliw_mac1_status(flags);
}

cliw_mac1_compute: is $(CLIW_EXT_MAC1_FACTORS) & $(CLIW_EXT_MAC1_FULL) &
    $(CLIW_EXT_MAC1_ADDEND) & cliw_mac1_accumulate {
    build cliw_mac1_first;
    local product:8;
    raw_mac_product(cliw_mac1_first, cliw_mac1_second, 1:1, 1:1, product);
    local base:8;
    cliw_alu_sample(cliw_mac1_acc_lo, cliw_mac1_acc_hi, cliw_mac1_acc_guard, base);
    local carry_in:8 = zext(cliw_mac1_accumulate);
    local term:8 = product ^ -carry_in;
    local exact:8 = ((base ^ 0x8000000000) - 0x8000000000) + term + carry_in;
    local value:8;
    local flags:2;
    raw_mac_finish(exact, base + (term & 0xffffffffff) + carry_in, 0:1, 0:1, 0:1, value, flags);
    write_accumulator40(mac_lo, mac_hi, mac_guard, value);
    cliw_mac1_status(flags);
}

cliw_mac1_compute: is $(CLIW_EXT_MAC1_FACTORS) & $(CLIW_EXT_MAC1_FULL) &
    tpl_91_95=0 & $(CLIW_EXT_MAC1_ADDEND) {
    build cliw_mac1_first;
    local product:8;
    raw_mac_product(cliw_mac1_first, cliw_mac1_second, 1:1, 1:1, product);
    local base:8;
    cliw_alu_sample(cliw_mac1_acc_lo, cliw_mac1_acc_hi, cliw_mac1_acc_guard, base);
    local exact:8 = ((base ^ 0x8000000000) - 0x8000000000) + product;
    cliw_mac1_rounded_write(mac_lo, mac_hi, mac_guard, exact, base + (product & 0xffffffffff));
}

cliw_mac1_compute: is $(CLIW_EXT_MAC1_FACTORS) & $(CLIW_EXT_MAC1_FULL) &
    tpl_91_95=21 & tpl_78_82=31 {
    build cliw_mac1_first;
    local product:8;
    raw_mac_product(cliw_mac1_first, cliw_mac1_second, 1:1, 1:1, product);
    cliw_mac1_rounded_write(mac_lo, mac_hi, mac_guard, product, product & 0xffffffffff);
}

:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    tpl_52_63=0xfff & tpl_64_72=0xff & cliw_mac1_compute {
    build cliw_mac1_compute;
}
@undef CLIW_EXT_MAC1_FACTORS
@undef CLIW_EXT_MAC1_FULL
@undef CLIW_EXT_MAC1_ADDEND

:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_ACC) & tpl_67_72=46 {
    local left:8 = cliw_ext_alu1_left;
    local right:8;
    cliw_alu_sample(cliw_alu_57_acc_0_0, cliw_alu_57_acc_0_1, cliw_alu_57_acc_0_2, right);
    local exact:8 = ((left ^ 0x8000000000) - 0x8000000000) + ((right ^ 0x8000000000) - 0x8000000000);
    cliw_round_write(cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2, exact, left + right);
}
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_ACC) & tpl_67_72=18 {
    local right:8;
    cliw_alu_sample(cliw_alu_57_acc_0_0, cliw_alu_57_acc_0_1, cliw_alu_57_acc_0_2, right);
    cliw_round_subtract(cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2, cliw_ext_alu1_left, right);
}
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_ACC) & tpl_67_72=19 {
    local right:8;
    cliw_alu_sample(cliw_alu_57_acc_0_0, cliw_alu_57_acc_0_1, cliw_alu_57_acc_0_2, right);
    cliw_round_subtract(cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2, right, cliw_ext_alu1_left);
}

:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_ACC) & tpl_67_72=7 {
    local right:8;
    cliw_alu_sample(cliw_alu_57_acc_0_0, cliw_alu_57_acc_0_1, cliw_alu_57_acc_0_2, right);
    # Compare 2*dividend with the full signed divisor scaled by 2^16.
    # Bias both sides by 2^40 + 2^55 to keep the trial in unsigned C.
    local doubled:8 = (cliw_ext_alu1_left ^ 0x8000000000) * 2;
    local lhs:8 = doubled + 0x80000000000000;
    local rhs:8 = ((right ^ 0x8000000000) << 16) + 0x10000000000;
    local value:8 = doubled;
    if (lhs < rhs) goto <write>;
    value = (lhs - rhs) | 1;
  <write>
    write_accumulator40(cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2, value);
    publish_alu_ce(EST & 0xcfff);
}
:CLIW template_index is $(CLIW_EXT_CALL) & $(CLIW_EXT_NO_LOADS) & $(CLIW_EXT_IDLE_2) &
    $(CLIW_EXT_ALU1_ACC) & tpl_67_72=6 {
    local left:8 = cliw_ext_alu1_left;
    local right:8;
    cliw_alu_sample(cliw_alu_57_acc_0_0, cliw_alu_57_acc_0_1, cliw_alu_57_acc_0_2, right);
    local take:1 = (left ^ 0x8000000000) >= (right ^ 0x8000000000);
    local value:8 = (left - right * zext(take)) * 2;
    write_accumulator40(cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2, value);
    BTR1 = (BTR1 << 1) | zext(take);
    publish_alu_ce(EST & 0xcfff);
}
@undef CLIW_EXT_ALU1_ACC
@undef CLIW_EXT_IDLE_2
@undef CLIW_EXT_NO_LOADS
@undef CLIW_EXT_CALL

@include "carmel_cliw_data.sinc"

# Only the qualified short MA1/MA2 write ports are visible to DATA.
cliw_ma1_clear: is cliw_ma1_write=0 { }
cliw_ma1_clear: is cliw_ma1_write=1 { *[data]:2 R3 = 0:2; }
cliw_ma2_clear: is cliw_ma2_write=0 { }
cliw_ma2_clear: is cliw_ma2_write=1 { *[data]:2 R6 = 0:2; }

# Bank 0: MA1 (*R3++), MA2 (*R6--), MA34 (long *R5++). The invocation
# predicates apply only to the inactive MAC lanes.
:CLIW template_index is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_20_22=5 &
    cliw_address_bank=0 & wide_34_46=0x17aa & wide_0_0=0 & wide_10_14=11 & wide_3_7=14 &
    template_index & carmel_cliw_known=1 & cliw_ma1_clear & cliw_ma2_clear &
    tpl_73_95=0x3fffff & tpl_49_51=0 & tpl_24_31=0xff & tpl_32_46=0x3fff & tpl_3_23=0xfffff & tpl_0_2=0 &
    tpl_67_72=0x20 & tpl_64_66=4 & cliw_alu_62_acc_4_0 & cliw_alu_62_acc_4_1 & cliw_alu_62_acc_4_2 &
    (tpl_57_61=16 | tpl_57_61=17 | tpl_57_61=18 | tpl_57_61=19 | tpl_57_61=20 | tpl_57_61=21) &
    cliw_alu_57_acc_0_0 & cliw_alu_57_acc_0_1 & cliw_alu_57_acc_0_2 &
    (tpl_52_56=16 | tpl_52_56=17 | tpl_52_56=18 | tpl_52_56=19 | tpl_52_56=20 | tpl_52_56=21) &
    cliw_alu_52_acc_0_0 & cliw_alu_52_acc_0_1 & cliw_alu_52_acc_0_2 {
    local next3:2;
    local next6:2;
    local next5:2;
    transfer_address_word(R3, RM2, RL2, 6, 1:2, next3);
    transfer_address_word(R6, RM6, RL6, 12, 0xffff:2, next6);
    transfer_address_word(R5, RM4, RL4, 10, 2:2, next5);
    local left:8;
    local right:8;
    cliw_alu_sample(cliw_alu_62_acc_4_0, cliw_alu_62_acc_4_1, cliw_alu_62_acc_4_2, left);
    cliw_alu_sample(cliw_alu_57_acc_0_0, cliw_alu_57_acc_0_1, cliw_alu_57_acc_0_2, right);
    local flags:2;
