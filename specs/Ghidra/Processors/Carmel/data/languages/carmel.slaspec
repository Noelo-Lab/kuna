# Absolute peripheral words, distinct from ordinary DATA.
io_word: "IO["^io_word_address^"]" is io_word_address { export *[io]:2 io_word_address; }
ext_read_word: "EXT["^peripheral_address^"]" is ext_read_word_0 & ext_read_word_6 [ peripheral_address = ext_read_word_0 | (ext_read_word_6 << 6); ] { export *[ext]:2 peripheral_address; }
ext_write_word: "EXT["^ext_write_word_address^"]" is ext_write_word_address { export *[ext]:2 ext_write_word_address; }
peripheral_literal: peripheral_literal_bits is peripheral_literal_bits { export *[const]:2 peripheral_literal_bits; }
:MOVE "A0",io_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_11=0x620 & wide_14_22=0x119 & wide_40_45=0x0 & io_word { A0 = zext(io_word); }
