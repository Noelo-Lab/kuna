# MAC1 signed-register product. Inactive ALUs do not own EST.
macro signed_product(lo, hi, guard, left, right) {
    # Sign-extend into a native C integer width before multiplication.
    # Doubling by multiplication avoids C's undefined left shift of a negative result.
    local a:8 = sext(left);
    local b:8 = sext(right);
    local scale:8 = 1 + sext(ECFG & 1);
    local product:8 = a * b * scale;
    local extend:1 = (product s> 0x7fffffff);
    local limit:1 = extend && ((ECFG & 4) != 0);
    local flags:2 = (zext(limit) << 2) | (zext(product == 0) << 3) |
                    (zext(product s< 0) << 4) | (zext(extend) << 5);
    # A signed 16x16 result has no magnitude beyond the low 32 bits.
    # Keep the native guard without requiring a nonstandard C integer width.
    local result:4 = product:4 - zext(limit);
    lo = result:2;
    hi = result(2);
    guard = -zext(product s< 0);
    EST = (EST & 0xffc4) | flags;
}

