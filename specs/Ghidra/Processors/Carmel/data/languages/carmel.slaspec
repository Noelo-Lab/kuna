# Address processing may run with a false result predicate. LINK samples
# the old frame word, updates its register and SP, then gates the DATA store.
macro frame_store(address, saved) {
    *[data]:2 address = saved;
    if (((saved & 0xfc00) == 0) || ((ECFG & 0x10) == 0)) goto <frame_store_done>;
    EST = EST | 0x4000;
  <frame_store_done>
}
:LINK "R0",compact_frame_delta "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_0=0x0 & slot_9_22=0x1620 & compact_frame_delta); (slot_mode=0 & nop_right) { local small:1 = compact_frame_delta; local old_sp:2 = SP; local saved:2 = R0; local frame:2 = old_sp - 1; R0 = frame; SP = old_sp + sext(small); frame_store(old_sp, saved); }
:LEAVE "R0" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x2c5800); (slot_mode=0 & nop_right) { local address:2 = R0 + 1; SP = address; R0 = *[data]:2 address; }
:LEAVE "CE1" "R0" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x2c5801); (slot_mode=0 & nop_right) { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <stack_done>; local address:2 = R0 + 1; SP = address; R0 = *[data]:2 address; <stack_done> }
:LINK "R1",compact_frame_delta "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_0=0x0 & slot_9_22=0x1621 & compact_frame_delta); (slot_mode=0 & nop_right) { local small:1 = compact_frame_delta; local old_sp:2 = SP; local saved:2 = R1; local frame:2 = old_sp - 1; R1 = frame; SP = old_sp + sext(small); frame_store(old_sp, saved); }
