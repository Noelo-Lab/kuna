:POP "CE2" "R5" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x25 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; R5 = word; <stack_done> }
:POP "R6" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x26 { local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; R6 = word; }
:POP "CE1" "R6" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x26 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; R6 = word; <stack_done> }
:POP "CE2" "R6" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x26 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; R6 = word; <stack_done> }
:POP "R7" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x27 { local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; R7 = word; }
:POP "CE1" "R7" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x27 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; R7 = word; <stack_done> }
