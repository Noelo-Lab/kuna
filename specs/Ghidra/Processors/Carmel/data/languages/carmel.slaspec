:MOVE "CE1" "A0L",io_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=0 & wide_0_11=0x640 & wide_14_22=0x119 & io_word { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <peripheral_done>; A0L = io_word; <peripheral_done> }
:MOVE "CE2" "A0L",io_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=1 & wide_0_11=0x640 & wide_14_22=0x119 & io_word { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <peripheral_done>; A0L = io_word; <peripheral_done> }

io_discard_dst: "RL0" is wide_0_11=0x6c0 { }
io_discard_dst: "selector_f0" is wide_0_11=0x7c0 { }
io_discard_dst: "discard" is (wide_0_11=0x600 | wide_0_11=0x638 | wide_0_11=0x63c | wide_0_11=0x718 | wide_0_11=0x7fc) { }
io_discard_source: "IO["^io_word_address^"]" is io_word_address { export *[const]:3 io_word_address; }

macro io_read_discard(address, config, bank) {
    local enabled:2;
    unary_ce(config, EST, CETBL, bank, enabled);
    if (enabled == 0 && (config & 0x1000) == 0) goto <peripheral_done>;
    local ignored:2 = *[io]:2 address;
    <peripheral_done>
}

:MOVE io_discard_dst,io_discard_source is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_14_22=0x119 & io_discard_dst & io_discard_source {
    local ignored:2 = *[io]:2 io_discard_source;
}
:MOVE "*R0+=RN0",io_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_11=0x420 & wide_14_22=0x119 & io_word {
    local address:2 = R0;
    local word:2 = io_word;
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    *[data]:2 address = word;
}
:MOVE io_word,"*R0+=RN0" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x20 & wide_14_22=0x11a & io_word {
    local address:2 = R0;
    local word:2 = *[data]:2 address;
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    io_word = word;
}

:MOVE "CE1" io_discard_dst,io_discard_source is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=0 & wide_14_22=0x119 & wide_40_45=0x0 & (wide_0_11=0x6c0 | wide_0_11=0x7c0) & io_discard_dst & io_discard_source {
    io_read_discard(io_discard_source, CECFG1, 0);
}
