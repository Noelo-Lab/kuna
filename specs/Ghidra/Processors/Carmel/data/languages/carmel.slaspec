# The left DATA ports feed PReg, not the multiplier or X1. Only the
# existing accumulator reaches the MAC result; the secondary ALU sees zero.
macro compact_mac_preg_addresses(first_address, second_address) {
    second_address = R3;
    first_address = second_address + RN3;
    modify_ptr(R3, RN3, RM2, RL2, 6, 2);
}

macro compact_mac_preg_status(first_address, second_address, enabled, clear_right, set_right) {
    local preg_first:2 = *[data]:2 first_address;
    local preg_second:2 = *[data]:2 second_address;
    local sign_word:1 = A1H >= 0x8000;
    local extended:1 = GB1 != (0 - sign_word);
    local flags:2 = (EST & 0xcfc4) | (zext((A1L | A1H) == 0 && GB1 == 0) << 3)
                  | (zext(GB1 >= 0x80) << 4) | (zext(extended) << 5);
    if (enabled == 0) goto <publish>;
    flags = (flags & ~clear_right) | set_right;
  <publish>
    publish_alu_ce(flags);
}

macro compact_preg_ce(qualified, enabled) {
    enabled = 1;
    if (qualified == 0) goto <done>;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
  <done>
}

macro compact_mac_preg_xor(qualified, postincrement) {
    local enabled:2;
    compact_preg_ce(qualified, enabled);
    local first_address:2;
    local second_address:2;
    compact_mac_preg_addresses(first_address, second_address);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <fetch>;
    modify_ptr(R6, RN6, RM6, RL6, 12, 1);
    if (postincrement == 0) goto <fetch>;
    modify_ptr(R7, RN7, RM6, RL6, 14, 2);
  <fetch>
    compact_mac_preg_status(first_address, second_address, enabled, 0xe00:2, 0x200:2);
}

macro compact_mac_preg_sub(qualified) {
    local enabled:2;
    compact_preg_ce(qualified, enabled);
    local first_address:2;
    local second_address:2;
    compact_mac_preg_addresses(first_address, second_address);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <fetch>;
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
  <fetch>
    compact_mac_preg_status(first_address, second_address, enabled, 0xec0:2, 0x240:2);
}

@define MAC_PREG_LEFT "slot_16_22=0x5b & mac_preg_form=0xa & mac_preg_acc=1 & mac_preg_index=3 & mac_preg_data=19 & slot_0_0=0"
@define MAC_PREG_XOR "slot_16_22=0x6c & mac_preg_dst=14"
@define MAC_PREG_SUB "slot_16_22=0 & mac_preg_dst=1 & mac_preg_src=31 & mac_preg_data=10"
mac_preg_src_name: "OP1" is mac_preg_src=30 { }
mac_preg_src_name: "OP2" is mac_preg_src=31 { }

