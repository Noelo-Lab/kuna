right_a2l: "MOVE" "A2L",move_source is slot_0_0=0x0 & slot_5_22=0x18d52 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
left_a3l: "MOVE" "A3L",move_source is slot_0_0=0x0 & slot_5_22=0x18d53 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
right_a3l: "MOVE" "A3L",move_source is slot_0_0=0x0 & slot_5_22=0x18d53 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
left_a4l: "MOVE" "A4L",move_source is slot_0_0=0x0 & slot_5_22=0x18d54 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
right_a4l: "MOVE" "A4L",move_source is slot_0_0=0x0 & slot_5_22=0x18d54 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
left_a5l: "MOVE" "A5L",move_source is slot_0_0=0x0 & slot_5_22=0x18d55 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
right_a5l: "MOVE" "A5L",move_source is slot_0_0=0x0 & slot_5_22=0x18d55 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
left_a0h: "MOVE" "A0H",move_source is slot_0_0=0x0 & slot_5_22=0x18d58 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
right_a0h: "MOVE" "A0H",move_source is slot_0_0=0x0 & slot_5_22=0x18d58 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
left_a1h: "MOVE" "A1H",move_source is slot_0_0=0x0 & slot_5_22=0x18d59 & (slot_3_4=0 | slot_2_4=2 | slot_3_4=2 | slot_2_4=6) & move_source { local staged:4; stage_move(move_source, staged); export staged; }
