# One architectural redirect, after the native-proven peers retire.
# Do not emit speculative debugger PC updates or suppress an unmapped-target stop.
peer_left_target: word_address is peer_left_target_words [ word_address = (inst_start + peer_left_target_words) & 0xffffff; ] { export *[code]:3 word_address; }
peer_right_target: word_address is peer_right_target_words [ word_address = (inst_start + peer_right_target_words) & 0xffffff; ] { export *[code]:3 word_address; }
