# Bias signed operands before comparing them so the math stays nonnegative
# even in emitted C. All remainder calculations fit ordinary 64-bit integers.
macro divide_accumulator(lo, hi, guard, value) {
    value = (zext(guard ^ 0x80) << 32) | (zext(hi) << 16) | zext(lo);
}

macro divide_write(lo, hi, guard, result) {
    lo = result:2;
    hi = result(2);
    guard = result(4);
}

macro divide_step(lo, hi, guard, divisor) {
    local dividend:8;
    divide_accumulator(lo, hi, guard, dividend);
    # dividend = A + 2^39. Double it, then give both comparison sides
    # the common bias 2^40 + 2^31. The output discards that bias modulo 2^40.
    local doubled:8 = dividend * 2;
    local lhs:8 = doubled + 0x80000000;
    local rhs:8 = (zext(divisor ^ 0x8000) << 16) + 0x10000000000;
    local result:8 = doubled;
    if (lhs < rhs) goto <publish>;
    result = (lhs - rhs) | 1;
    <publish>
    divide_write(lo, hi, guard, result);
}

macro divide_trace(lo, hi, guard, div_lo, div_hi, div_guard, btr) {
    local dividend:8;
    local divisor:8;
    divide_accumulator(lo, hi, guard, dividend);
    divide_accumulator(div_lo, div_hi, div_guard, divisor);
    local take:1 = dividend >= divisor;
    local trace:2 = (btr << 1) | zext(take);
    # Subtract BEFORE shifting; the trial bit belongs to BTR, not the remainder.
    if (!take) goto <publish>;
    dividend = dividend - divisor;
    <publish>
    local result:8 = dividend * 2;
    divide_write(lo, hi, guard, result);
    btr = trace;
}
