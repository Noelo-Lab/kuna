# A conditional CALL emits its link store even when the condition is false.
compact_call_test: "NC1" is slot_9_22=0x1441 {
    local taken:1 = (EST & 1) == 0;
    export taken;
}
compact_call_test: "EQ1" is slot_9_22=0x144e {
    local taken:1 = (EST & 8) != 0;
    export taken;
}

:CALL compact_call_test conditional_target "||" nop_right is
    ((carmel_issue=1 & slot_mode=0 & slot_0_1=0 & compact_call_test & conditional_target);
     (slot_mode=0 & nop_right)) & link_2_0 {
    store_link(SP, link_2_0);
    if (!compact_call_test) goto <veto>;
    SP = SP - 2;
    call conditional_target;
  <veto>
}
