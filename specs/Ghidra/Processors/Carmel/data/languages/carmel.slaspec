:"LOADCE.NOT" ce_config_value,ce_truth_value is (((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1) & wide_7_7=0x1 & wide_9_10=0x3 & wide_13_22=0x26f & ce_config_value & ce_truth_value { local incoming:2 = EST; local config:2 = ce_config_value; local truth:2 = ce_truth_value; CECFG1 = config; CECFG2 = config; CETBL = truth | ((truth ^ 0xff) << 8); local select_config:2 = config & 0x1fff; local published:2 = 0; local feedback_1:2; unary_ce(select_config, incoming, CETBL, 0, feedback_1); published = published | (feedback_1 << 12); local feedback_2:2; unary_ce(select_config, incoming, CETBL, 1, feedback_2); published = published | (feedback_2 << 13); EST = (incoming & 0xcfff) | published; }

# LOAD's fixed word/long stride uses the old mode field, not the
# newly programmed PACFG field. No RN or reversal port feeds this increment.
macro wide_load_next(base, mode, modulo, limit, stride, next) {
    next = base + stride;
    if (mode < 2) goto <wide_load_next_done>;
    local size:4 = zext(modulo & 0xfff) + 1;
    local lower:4 = zext(limit) * zext(mode == 3);
    local upper:4 = lower + size;
    if (upper <= 0x10000 && lower <= zext(next) && zext(next) < upper) goto <wide_load_next_done>;
    next = next - size:2;
  <wide_load_next_done>
}

macro wide_load_flags(zero, negative, extended, limit) {
    local flags:2 = (zext(zero) << 3) | (zext(negative) << 4) | (zext(extended) << 5) | (zext(limit) << 2);
    # L is sticky here: a successful range check does not clear it.
    EST = (EST & 0xffc4) | flags;
}
