:TRANSFER "R4","SP" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x407690 & wide_24_45=0x0 { R4 = SP; }
:TRANSFER "SP","R5" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x404aec & wide_24_45=0x0 { SP = R5; }
:TRANSFER "R5","SP" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x407694 & wide_24_45=0x0 { R5 = SP; }
:TRANSFER "SP","R6" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x404cec & wide_24_45=0x0 { SP = R6; }
:TRANSFER "R6","SP" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x407698 & wide_24_45=0x0 { R6 = SP; }
:TRANSFER "SP","R7" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x404eec & wide_24_45=0x0 { SP = R7; }
:TRANSFER "R7","SP" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x40769c & wide_24_45=0x0 { R7 = SP; }

# Bias signed operands before a 64-bit trial subtraction. Neither the
# signed 40-bit dividend nor the signed word shift needs a C signed shift.
macro wide_div_biased(lo, hi, guard, biased) {
    biased = zext(guard ^ 0x80) * 0x100000000 + zext(hi) * 0x10000 + zext(lo);
}
macro wide_div_trial_biased(biased, divisor, bias, result) {
    local doubled:8 = biased * 2;
    local lhs:8 = doubled + bias;
    local rhs:8 = 0x10000000000 + divisor;
    result = doubled;
    if (lhs < rhs) goto <wide_div_failed_trial>;
    result = (lhs - rhs) | 1;
    <wide_div_failed_trial>
}
macro wide_div_trial(biased, word, alignment, word_bias, result) {
    local divisor:8 = zext(word ^ 0x8000) << alignment;
    wide_div_trial_biased(biased, divisor, word_bias, result);
}

macro wide_div_read_long(address, divisor) {
    local low:2 = *[data]:2 address;
    local next:2 = address + 1;
    local high:2 = *[data]:2 next;
    divisor = (zext(high ^ 0x8000) << 32) | (zext(low) << 16);
}

macro wide_div_publish_ce(enabled) {
    local incoming:2 = EST;
    local second:2;
    unary_ce(CECFG1, incoming, CETBL, 0, enabled);
    unary_ce(CECFG2, incoming, CETBL, 1, second);
    EST = (incoming & 0xcfff) | (enabled << 12) | (second << 13);
}

macro wide_div_low_long(divisor) {
    local enabled:2;
    wide_div_publish_ce(enabled);
    if (enabled == 0) goto <veto>;
    local dividend:8;
    wide_div_biased(A5L, A5H, GB5, dividend);
    local result:8;
    wide_div_trial_biased(dividend, divisor, 0x800000000000, result);
    A5L = result:2;
    A5H = result(2);
    GB5 = result(4);
  <veto>
}

macro wide_div_high_long(divisor, high, guard, result) {
    local dividend:8 = 0x8000000000 + zext(guard) * 0x10000 + zext(high);
    wide_div_trial_biased(dividend, divisor, 0x800000000000, result);
    high = result:2;
    guard = result(2);
}
macro wide_div_trace_sink(lo, hi, guard) {
    # The dividend port is fixed at zero; only the signed comparison and
    # the trace register are live. The discarded remainder has no store.
    local take:1 = guard >= 0x80 || ((guard == 0) && (hi == 0) && (lo == 0));
    local previous:2 = BTR2;
    BTR2 = (previous << 1) | zext(take);
}

:DIVIDE "CE2" "*R2--","FF1" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_div_ce_bank=1 & wide_13_22=0x218 & wide_40_45=0x3e & wide_0_9=0x06a {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <feedback>;
    modify_ptr(R2, 0:2, RM2, RL2, 4, 3);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:DIVIDE "discard","long *R2+RN2" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_13_22=0x218 & wide_40_45=0x2a & (wide_0_9=0x39d | wide_0_9=0x3fd) {
    local address:2 = R2 + RN2;
    local second:2 = address + 1;
    local low:2 = *[data]:2 address;
    local high:2 = *[data]:2 second;
    publish_alu_ce(EST & 0xcfff);
}

:DIVIDE "A5","FF1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x236 & wide_13_22=0x218 & wide_40_45=0x3e { local dividend:8; wide_div_biased(A5L, A5H, GB5, dividend); local result:8; wide_div_trial(dividend, FF1, 16, 0x80000000, result); A5L = result:2; A5H = result(2); GB5 = result(4); }
:DIVIDE "CE1" "A5L","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_div_ce_bank=0 & wide_0_9=0x256 & wide_13_22=0x218 & wide_40_45=0x10 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <wide_div_disabled>; local dividend:8; wide_div_biased(A5L, A5H, GB5, dividend); local result:8; wide_div_trial(dividend, A0L, 32, 0x800000000000, result); A5L = result:2; A5H = result(2); GB5 = result(4); <wide_div_disabled> }
:DIVIDE "CE1" "A5H","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_div_ce_bank=0 & wide_0_9=0x276 & wide_13_22=0x218 & wide_40_45=0x10 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <wide_div_disabled>; local dividend:8; dividend = 0x8000000000 + zext(GB5) * 0x10000 + zext(A5H); local result:8; wide_div_trial(dividend, A0L, 32, 0x800000000000, result); A5H = result:2; GB5 = result(2); <wide_div_disabled> }
:DIVIDE "CE1" "A5L",wide_div_literal is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_div_ce_bank=0 & wide_0_9=0x256 & wide_13_22=0x218 & wide_40_45=0xf & wide_div_literal { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <wide_div_disabled>; local dividend:8; wide_div_biased(A5L, A5H, GB5, dividend); local result:8; wide_div_trial(dividend, wide_div_literal:2, 32, 0x800000000000, result); A5L = result:2; A5H = result(2); GB5 = result(4); <wide_div_disabled> }
:DIVTRACE "discard","A1","BTR2" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_10=0x762 & wide_13_22=0x219 & wide_40_45=0x9 { wide_div_trace_sink(A1L, A1H, GB1); }

@define WIDE_DIV_ABSOLUTE "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_div_ce_bank=0 & wide_13_22=0x218 & wide_40_45=0x3c & wide_div_literal"
:DIVIDE "CE1" "A5L","*"^wide_div_literal is $(WIDE_DIV_ABSOLUTE) & wide_0_9=0x254 {
    local address:2 = wide_div_literal;
    local divisor:2 = *[data]:2 address;
    local enabled:2;
    wide_div_publish_ce(enabled);
    if (enabled == 0) goto <veto>;
    local dividend:8;
    wide_div_biased(A5L, A5H, GB5, dividend);
    local result:8;
    wide_div_trial(dividend, divisor, 32, 0x800000000000, result);
    A5L = result:2;
    A5H = result(2);
    GB5 = result(4);
  <veto>
}
:DIVIDE "CE1" "A5L","long *"^wide_div_literal is $(WIDE_DIV_ABSOLUTE) & wide_0_9=0x255 {
    local divisor:8;
    wide_div_read_long(wide_div_literal:2, divisor);
    wide_div_low_long(divisor);
}
:DIVIDE "CE1" "GB0","long *"^wide_div_literal is $(WIDE_DIV_ABSOLUTE) & wide_0_9=0x201 {
    local divisor:8;
    wide_div_read_long(wide_div_literal:2, divisor);
    local enabled:2;
    wide_div_publish_ce(enabled);
    if (enabled == 0) goto <veto>;
    # GB0 supplies the low byte, and the low byte of A1L supplies the sign byte.
    local top:1 = A1L:1;
    local dividend:8 = zext(top ^ 0x80) * 0x100000000 + zext(GB0);
    local result:8;
    wide_div_trial_biased(dividend, divisor, 0x800000000000, result);
    GB0 = result:1;
    local neighbor:1 = result(4);
    A1L = zext(neighbor);
    A1H = 0;
  <veto>
}
:DIVIDE "CE1" "GB5","long *"^wide_div_literal is $(WIDE_DIV_ABSOLUTE) & wide_0_9=0x215 {
    local divisor:8;
    wide_div_read_long(wide_div_literal:2, divisor);
    local enabled:2;
    wide_div_publish_ce(enabled);
    if (enabled == 0) goto <veto>;
    local dividend:8 = 0x8000000000 + zext(GB5);
    local result:8;
    wide_div_trial_biased(dividend, divisor, 0x800000000000, result);
    GB5 = result:1;
  <veto>
}
:DIVIDE "CE1" "A0H","long *"^wide_div_literal is $(WIDE_DIV_ABSOLUTE) & wide_0_9=0x261 {
    local divisor:8;
    wide_div_read_long(wide_div_literal:2, divisor);
    local enabled:2;
    wide_div_publish_ce(enabled);
    if (enabled == 0) goto <veto>;
    local result:8;
    wide_div_high_long(divisor, A0H, GB0, result);
    A1L = 0;
  <veto>
}
:DIVIDE "CE1" "A5H","long *"^wide_div_literal is $(WIDE_DIV_ABSOLUTE) & wide_0_9=0x275 {
    local divisor:8;
    wide_div_read_long(wide_div_literal:2, divisor);
    local enabled:2;
    wide_div_publish_ce(enabled);
    if (enabled == 0) goto <veto>;
    local result:8;
    wide_div_high_long(divisor, A5H, GB5, result);
  <veto>
}

# Use unsigned 64-bit carriers for signed-40 arithmetic, never a size-5 value.
macro wide_mac_su_subtract(addend, left, right, word_result, result, flags) {
    local signed_left:8 = (zext(left) ^ 0x8000) - 0x8000;
    local product:8 = (signed_left * zext(right) * (1 + zext(ECFG & 1))) & 0xffffffffff;
    result = (addend - product) & 0xffffffffff;
    local carry_out:1 = addend >= product;
    local negative:1 = result >= 0x8000000000;
    local extended:1 = result > 0x7fffffff && result < 0xff80000000;
    local overflow:1 = ((addend ^ product) & (addend ^ result) & 0x8000000000) != 0;
    local zero:1 = result == 0 || (word_result != 0 && (result >> 16) == 0);
    # This mixed-sign route does not clamp at ALIM. ALIM and S (unless SR1
    # is also set) inhibit new L; neither configuration clears sticky L.
    local loss:1 = (ECFG & 4) == 0 && (ECFG & 0x28) != 8 &&
                   (overflow || (word_result != 0 && extended));
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(zero) << 3) | (zext(negative) << 4) | (zext(extended) << 5);
}

:MSUSU "discard","RL0","RN5","ECFG" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_mac_prefix=1 & wide_0_11=0xdc1 & wide_14_22=0x12e & wide_24_45=0x386df0 { local left:2 = RL0; local right:2 = RN5; local addend:8 = sext(ECFG) & 0xffffffffff; local result:8; local flags:2; wide_mac_su_subtract(addend, left, right, 1:1, result, flags); X1 = left; EST = (EST & 0xffc4) | flags; }
:MSUSU "discard","RL0","RN5","FFTV" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_mac_prefix=1 & wide_0_11=0xdc1 & wide_14_22=0x12e & wide_24_45=0x386df5 { local left:2 = RL0; local right:2 = RN5; local addend:8 = sext(FFTV) & 0xffffffffff; local result:8; local flags:2; wide_mac_su_subtract(addend, left, right, 1:1, result, flags); X1 = left; EST = (EST & 0xffc4) | flags; }
:MSUSU "CETBL","RL0","RN5","FFTV" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_mac_prefix=1 & wide_0_11=0xdc4 & wide_14_22=0x12e & wide_24_45=0x386df5 { local left:2 = RL0; local right:2 = RN5; local addend:8 = sext(FFTV) & 0xffffffffff; local result:8; local flags:2; wide_mac_su_subtract(addend, left, right, 1:1, result, flags); X1 = left; CETBL = result(2); EST = (EST & 0xffc4) | flags; }
