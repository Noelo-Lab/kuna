:"TRAP 3" "||" nop_right is ((carmel_issue=1 & slot_mode=0 & slot_0_22=0x2bd003); (slot_mode=0 & nop_right)) & link_2_0 & trap_resume {
    if (TRAPCTX != 0) goto <ignored>;
    push_trap(link_2_0, 3:1);
    goto trap_resume;
    <ignored>
}

:"TRAP 1" is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_22=0x2bd001 & link_1_0 & trap_resume {
