:^nop_left "||" "XOR CE2" "*R6+=RN6","OP2","*R7" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(MAC_PREG_XOR) & mac_preg_src=31 & mac_preg_data=7 & slot_0_0=1) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    local destination:2 = R6;
    modify_ptr(R6, RN6, RM6, RL6, 12, 1);
    local word:2 = *[data]:2 R7;
    if (enabled == 0) goto <publish>;
    *[data]:2 destination = word;
    flags = (flags & 0xf1ff) | (zext(word == 0) << 9);
  <publish>
    publish_alu_ce(flags);
}

# The long DATA result selects the opposite pointer bank for these short
# inputs. The physical issue lane, not that pointer bank, selects X and EST.
macro compact_indexed_store(address, a, b, shift, flags) {
    local product:8 = a * b * (1 + zext(ECFG & 1));
    local result:8;
    local product_flags:2;
    compact_long_finish(product & 0xffffffffff, 0:1, 0:1, 1:1, 1:1, result, product_flags);
    local upper:2 = address + 1;
    *[data]:2 address = result:2;
    *[data]:2 upper = result(2);
    local lane:4 = shift;
    flags = (flags & ~(0x3b:2 << lane)) | (product_flags << lane);
}

macro compact_indexed_sub_pair(destination, delta, modulo, bound, shift, index, stride) {
    local address:2 = destination;
    local left_addr:2 = R4;
    local right_addr:2 = R5;
    local indexed_addr:2 = index + stride;
    local first:2 = *[data]:2 left_addr;
    local second:2 = *[data]:2 right_addr;
    local word:2 = *[data]:2 indexed_addr;
    local multiplier:8 = zext(R1);
    modify_ptr(destination, delta, modulo, bound, shift, 1);
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    modify_ptr(R5, RN5, RM4, RL4, 10, 2);
    X2 = word;
    local mask:8 = 0xffffffffff;
    local lhs:8 = (sext(first) & 0xffffff) << 16;
    local rhs:8 = (sext(second) & 0xffffff) << 16;
    local borrow_in:8 = (1 - zext(EST & 1)) << 16;
    local raw:8 = lhs - rhs - borrow_in;
    local result:8;
    local sub_flags:2;
    compact_long_finish(raw & mask, lhs >= rhs + borrow_in, 0:1, 0:1, 0:1, result, sub_flags);
    if ((sub_flags & 0x20) == 0 || (ECFG & 4) != 0 || (ECFG & 0x28) == 8) goto <sub_store>;
    sub_flags = sub_flags | 4;
  <sub_store>
    *[data]:2 left_addr = result(2);
    local sample:8 = sext(word);
    local flags:2 = (EST & 0xcfc4) | sub_flags;
    compact_indexed_store(address, sample, multiplier, 6, flags);
    publish_alu_ce(flags);
}

macro compact_indexed_move_pair(destination, index, stride) {
    local mpy_on:2;
    local move_on:2;
    unary_ce(CECFG1, EST, CETBL, 0, mpy_on);
    unary_ce(CECFG2, EST, CETBL, 1, move_on);
    local flags:2 = EST & 0xcfff;
    local move_word:2 = A2H;
    if (mpy_on == 0 && (CECFG1 & 0x1000) == 0) goto <move>;
    local address:2 = index + stride;
    local word:2 = *[data]:2 address;
    X1 = word;
    if (mpy_on == 0) goto <move>;
    local a:8 = zext(word);
    local b:8 = zext(A3H);
    compact_indexed_store(destination, a, b, 0, flags);
  <move>
    if (move_on == 0) goto <status>;
    A0L = move_word;
    flags = (flags & 0xc13f) | (zext(move_word == 0) << 9) | (zext(move_word >= 0x8000) << 10);
  <status>
    publish_alu_ce(flags);
}

macro compact_indexed_shift_peer(count, flags) {
    local n:4 = count;
    local input:8 = sext(FF2);
    local result:8 = input;
    local carry_bit:1 = (EST & 1) != 0;
    if (n == 0) goto <align>;
    if (n s< 0) goto <right>;
    carry_bit = ((input >> (40 - n)) & 1) != 0;
    result = (input & 0xffffff) << n;
    goto <align>;
  <right>
    carry_bit = ((input >> (15 - n)) & 1) != 0;
    result = input s>> (0 - n);
  <align>
    result = (result & 0xffffff) << 16;
    local shifted_flags:2;
    shift_flags(result, carry_bit, shifted_flags);
    shift_limit(result, shifted_flags);
    A4H = result(2);
    flags = (EST & 0xcfc6) | shifted_flags;
}

macro compact_indexed_shift_pair(destination, index, stride, post, step, modulo, bound, shift, count) {
    local address:2 = index + stride;
    local first:2 = *[data]:2 address;
    local second:2 = *[data]:2 post;
    modify_ptr(post, step, modulo, bound, shift, 2);
    X2 = first;
    local flags:2;
    compact_indexed_shift_peer(count, flags);
    local a:8 = zext(first);
    local b:8 = sext(second);
    compact_indexed_store(destination, a, b, 6, flags);
    publish_alu_ce(flags);
}

macro compact_indexed_mpy_seq(destination, post, step, modulo, bound, shift, index, stride) {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <status>;
    local address:2 = index + stride;
    local first:2 = *[data]:2 post;
    local second:2 = *[data]:2 address;
    modify_ptr(post, step, modulo, bound, shift, 2);
    X1 = first;
    if (enabled == 0) goto <status>;
    local a:8 = zext(first);
    local b:8 = zext(second);
    compact_indexed_store(destination, a, b, 0, flags);
  <status>
    publish_alu_ce(flags);
}

@define INDEXED_SUB_PEER "slot_15_22=0x13 & indexed_peer_sub_dst=6 & indexed_peer_sub_first=20 & indexed_mpy_short=21 & slot_0_0=0"
@define INDEXED_MOVE_PEER "slot_5_22=0x18d50 & move_source=10 & slot_0_0=1"
@define INDEXED_SHIFT_PEER "slot_7_22=0x7b97 & indexed_peer_shift_count & slot_0_0=0"
@define INDEXED_MPYSU "indexed_mpy_form=0x444 & slot_6_7=3 & indexed_mpy_short=1 & slot_0_0=0"
@define INDEXED_MPYUU "indexed_mpy_form=0x4c4 & slot_6_7=3 & indexed_mpy_short=27 & slot_0_0=1"
@define INDEXED_MPYUS "indexed_mpy_low_form=0x90a & slot_5_6=1 & move_source=11 & slot_0_0=0"
@define INDEXED_MPYUU_SEQ "carmel_issue=3 & slot_mode=0 & indexed_mpy_low_form=0x99c & indexed_mpy_post_first=11 & indexed_mpy_index_second=1 & slot_0_0=1"

:"SUBC" "RMW1","*R4++","*R5++" "||" "MPYSU" "*R2+=RN2","*R7+RN7","R1" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SUB_PEER)); (slot_mode=0 & $(INDEXED_MPYSU) & indexed_mpy_high_dst=10) {
    compact_indexed_sub_pair(R2, RN2, RM2, RL2, 4, R7, RN7);
}
:"SUBC" "RMW1","*R4++","*R5++" "||" "MPYSU" "*R6+=RN6","*R3+RN3","R1" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SUB_PEER)); (slot_mode=0 & $(INDEXED_MPYSU) & indexed_mpy_high_dst=14) {
    compact_indexed_sub_pair(R6, RN6, RM6, RL6, 12, R3, RN3);
}
:"MPYUU CE1" "*R3","*R7+RN7","A3H" "||" "MOVE CE2" "A0L","A2H" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_MPYUU) & indexed_mpy_high_dst=3); (slot_mode=0 & $(INDEXED_MOVE_PEER)) {
    compact_indexed_move_pair(R3, R7, RN7);
}
:"MPYUU CE1" "*R7","*R3+RN3","A3H" "||" "MOVE CE2" "A0L","A2H" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_MPYUU) & indexed_mpy_high_dst=7); (slot_mode=0 & $(INDEXED_MOVE_PEER)) {
    compact_indexed_move_pair(R7, R3, RN3);
}
:"ASHIFT" "A4H","FF2",indexed_peer_shift_count "||" "MPYUS" "*R2","*R5+RN5","*R7++" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SHIFT_PEER)); (slot_mode=0 & $(INDEXED_MPYUS) & indexed_mpy_low_dst=2) {
    compact_indexed_shift_pair(R2, R5, RN5, R7, RN7, RM6, RL6, 14, indexed_peer_shift_count);
}
:"ASHIFT" "A4H","FF2",indexed_peer_shift_count "||" "MPYUS" "*R6","*R1+RN1","*R3++" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SHIFT_PEER)); (slot_mode=0 & $(INDEXED_MPYUS) & indexed_mpy_low_dst=6) {
    compact_indexed_shift_pair(R6, R1, RN1, R3, RN3, RM2, RL2, 6, indexed_peer_shift_count);
}
:"EXTRACTZ" "A3","A1","*R0" is carmel_issue=2 & slot_mode=1 & slot_9_22=0x1b79 & slot_5_7=1 & slot_8_9=3 & indexed_mpy_short=16 & slot_0_0=0 {
    local descriptor:2 = R0 + 1;
    local count:2 = *[data]:2 R0;
    local offset:2 = *[data]:2 descriptor;
    local input:8 = sext(GB1) * 0x100000000 + (zext(A1H) << 16) + zext(A1L);
    local mask:8 = (1 << (count & 31)) - 1;
    local result:8 = (input s>> (offset & 31)) & mask;
    A3L = result:2;
    A3H = result(2);
    GB3 = 0;
    publish_alu_ce((EST & 0xcfe7) | (zext(result == 0) << 3));
}
:"MPYUU CE1" "*R0","*R7++","*R5+RN5" is $(INDEXED_MPYUU_SEQ) & indexed_mpy_low_dst=0 {
    compact_indexed_mpy_seq(R0, R7, RN7, RM6, RL6, 14, R5, RN5);
}
:"MPYUU CE1" "*R4","*R3++","*R1+RN1" is $(INDEXED_MPYUU_SEQ) & indexed_mpy_low_dst=4 {
    compact_indexed_mpy_seq(R4, R3, RN3, RM2, RL2, 6, R1, RN1);
}

macro compact_long_postmodify(pointer) {
    # The explicit window of this port uses all 16 RM bits, unlike the
    # implicit window. The other modes share the ordinary compact AGU.
    if ((PACFG & 0xc00) == 0xc00 && RM4 > 0xfff) goto <full_window>;
    modify_ptr(pointer, RN5, RM4, RL4, 10, 1);
    goto <done>;
  <full_window>
    local candidate:2 = pointer + RN5;
    local size:4 = zext(RM4) + 1;
    local limit:4 = zext(RL4) + size;
    if (limit <= 0x10000 && RL4 <= candidate && zext(candidate) < limit) goto <publish>;
    if (RN5 s< 0) goto <reverse_wrap>;
    candidate = candidate - size:2;
    goto <publish>;
  <reverse_wrap>
    candidate = candidate + size:2;
  <publish>
    pointer = candidate;
  <done>
}

compact_long_left: "ADD" "CE1" "*R6","A2","A0" is slot_0_22=0x133321 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local old_address:2 = R6; local a:8; compact_long_sample(A2L, A2H, GB2, a); local b:8; compact_long_sample(A0L, A0H, GB0, b); local raw:8 = a + b; local bits:8 = raw & 0xffffffffff; local carry_out:1 = raw >= 0x10000000000; local overflow:1 = ((a ^ b) < 0x8000000000) && ((a ^ bits) >= 0x8000000000); local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 0:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x133321 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }
compact_long_left: "ADD" "CE1" "A1","A2","A0" is slot_0_22=0x130ca1 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local a:8; compact_long_sample(A2L, A2H, GB2, a); local b:8; compact_long_sample(A0L, A0H, GB0, b); local raw:8 = a + b; local bits:8 = raw & 0xffffffffff; local carry_out:1 = raw >= 0x10000000000; local overflow:1 = ((a ^ b) < 0x8000000000) && ((a ^ bits) >= 0x8000000000); local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 0:1, 0:1, result, flags); A1L = result:2; A1H = result(2); GB1 = result(4); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x130ca1 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }
compact_long_right: "SUB" "CE2" "*R5++RN5","A2","A3" is slot_0_22=0x336a7 { local previous:2 = EST; local enabled:2; unary_ce(CECFG2, previous, CETBL, 1, enabled); if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <long_done>; local old_address:2 = R5; compact_long_postmodify(R5); if (enabled == 0) goto <long_done>; local a:8; compact_long_sample(A2L, A2H, GB2, a); local b:8; compact_long_sample(A3L, A3H, GB3, b); local raw:8 = a - b; local bits:8 = raw & 0xffffffffff; local carry_out:1 = a >= b; local overflow:1 = ((a ^ b) >= 0x8000000000) && ((a ^ bits) >= 0x8000000000); local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 0:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xf13f) | (flags << 6); <long_done> }
:^nop_left "||" compact_long_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x336a7 & compact_long_right) { build compact_long_right; }
compact_long_left: "MPY" "CE1" "*R3","A2L","A1L" is slot_0_22=0x400723 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local old_address:2 = R3; local a:8 = (zext(A2L) ^ 0x8000) - 0x8000; local b:8 = (zext(A1L) ^ 0x8000) - 0x8000; local bits:8 = (a * b * (1 + zext(ECFG & 1))) & 0xffffffffff; local carry_out:1 = 0; local overflow:1 = 0; local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 0:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x400723 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }
compact_long_left: "MPYUS" "CE1" "*R3","A2L","A1L" is slot_0_22=0x480723 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local old_address:2 = R3; local a:8 = zext(A2L); local b:8 = (zext(A1L) ^ 0x8000) - 0x8000; local bits:8 = (a * b * (1 + zext(ECFG & 1))) & 0xffffffffff; local carry_out:1 = 0; local overflow:1 = 0; local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 1:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x480723 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }

# Keep the complete 40-bit ALU result in a standard C width. Finish the
# flags before narrowing the physical WB port to a high word or a guard.
macro raw_mac_finish_limit(exact, raw_adder, short_result, short_zero, store, limit_product, result, flags) {
    local bits:8 = exact & 0xffffffffff;
    local negative:1 = bits >= 0x8000000000;
    local extended:1 = bits > 0x7fffffff && bits < 0xff80000000;
    local overflow:1 = exact + 0x8000000000 > 0xffffffffff;
    local saturated:1 = (ECFG & 0x28) == 8;
    local auto_limit:1 = (ECFG & 4) != 0;
    local limited:1 = limit_product != 0 && auto_limit && (((bits >> 31) ^ (bits >> 32)) & 1) != 0;
    local loss:1 = limited || ((overflow || (short_result != 0 && extended)) && !saturated && !auto_limit);
    local carry_out:1 = (raw_adder & 0x10000000000) != 0;
    local zero:1 = bits == 0 || (short_zero != 0 && (bits >> 16) == 0);
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(zero) << 3) | (zext(negative) << 4) | (zext(extended) << 5);
    limited = limited || (limit_product != 0 && store != 0 && saturated && extended);
    result = bits;
    if (!limited) goto <done>;
    result = 0x7fffffff + zext(negative) * 0xff00000001;
    flags = flags | 4;
  <done>
}

macro raw_mac_finish(exact, raw_adder, short_result, short_zero, store, result, flags) {
    raw_mac_finish_limit(exact, raw_adder, short_result, short_zero, store, 1:1, result, flags);
}

macro compact_ff12_store(negate, long_result) {
    local address:2 = R0;
    local source:8 = zext(FF2) * 0x10000 + zext(FF1);
    local exact:8 = source - 2 * source * negate;
    local result:8;
    local flags:2;
    raw_mac_finish(exact, (0x10000000000 - source) * negate, 1:1, 0:1, 1:1, result, flags);
    # SR1 affects DATA after flags and limiting, including for a word result.
    if ((ECFG & 0x20) == 0) goto <store>;
    result = (result >> 1) | (result & 0x8000000000);
  <store>
    if (long_result == 0) goto <word>;
    local upper:2 = address + 1;
    *[data]:2 address = result:2;
    address = upper;
  <word>
    *[data]:2 address = result(2);
    EST = (EST & 0xffc4) | flags;
}

@define COMPACT_FF12_DATA "carmel_issue=1 & slot_mode=0 & compact_unary_data_dst=0 & slot_1_3=6 & slot_0_0=0"

:NEG "*R0","FF12" "||" nop_right is ($(COMPACT_FF12_DATA) & compact_unary_data_form=0x20d8); (slot_mode=0 & nop_right) { compact_ff12_store(1:8, 0:1); }
:NEG "*R0:long","FF12" "||" nop_right is ($(COMPACT_FF12_DATA) & compact_unary_data_form=0x20dc); (slot_mode=0 & nop_right) { compact_ff12_store(1:8, 1:1); }
:ABS "*R0:long","FF12" "||" nop_right is ($(COMPACT_FF12_DATA) & compact_unary_data_form=0x20fc); (slot_mode=0 & nop_right) { compact_ff12_store(0:8, 1:1); }

@define COMPACT_R3_WORD_STORE "slot_8_22=0x3152 & slot_4_7=7"

compact_store_first: "MOVE" "*R3++",move_store_left is $(COMPACT_R3_WORD_STORE) & move_store_left & move_store_left_ce=0 { }
compact_store_first: "MOVE" "CE1" "*R3++",move_store_left is $(COMPACT_R3_WORD_STORE) & move_store_left & move_store_left_ce=1 { }
compact_store_second: "MOVE" "*R3++",move_store_right is $(COMPACT_R3_WORD_STORE) & move_store_right & move_store_right_ce=0 { }
compact_store_second: "MOVE" "CE2" "*R3++",move_store_right is $(COMPACT_R3_WORD_STORE) & move_store_right & move_store_right_ce=1 { }

macro compact_store_word(address, source) {
    local word:2 = source;
    local shift:1 = (ECFG & 0x20) != 0;
    *[data]:2 address = word s>> shift;
}

macro compact_r3_store(source, qualified, cfg, bank) {
    local enabled:2 = 1;
    local check:1 = qualified;
    if (check == 0) goto <prepare>;
    unary_ce(cfg, EST, CETBL, bank, enabled);
  <prepare>
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <status>;
    local address:2 = R3;
    modify_ptr(R3, RN3, RM2, RL2, 6:4, 2:2);
    if (enabled == 0) goto <status>;
    compact_store_word(address, source);
  <status>
    publish_alu_ce(EST & 0xcfff);
}

:^compact_store_first is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_store_first & move_store_left & move_store_left_ce {
    compact_r3_store(move_store_left, move_store_left_ce, CECFG1, 0:2);
}
:^compact_store_first "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_store_first & move_store_left & move_store_left_ce); (slot_mode=0 & nop_right) {
    compact_r3_store(move_store_left, move_store_left_ce, CECFG1, 0:2);
}
:^nop_left "||" compact_store_second is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & compact_store_second & move_store_right & move_store_right_ce) {
    compact_r3_store(move_store_right, move_store_right_ce, CECFG2, 1:2);
}
:^compact_store_first "||" compact_store_second is (carmel_issue=1 & slot_mode=0 & compact_store_first & move_store_left & move_store_left_ce=0); (slot_mode=0 & compact_store_second & move_store_right & move_store_right_ce=0) {
    local first:2 = R3;
    local second:2 = first + 1;
    modify_ptr_scaled(R3, RN3, RM2, RL2, 6:4, 2:2, 2:2);
    compact_store_word(first, move_store_left);
    compact_store_word(second, move_store_right);
    publish_alu_ce(EST & 0xcfff);
}

# Signed MOVE binds these extended DATA selectors to the nonmodifying index adder.
macro compact_move_long_address(address) {
    address = R6 + RN6;
}

macro compact_move_long_read(low, high) {
    local address:2;
    compact_move_long_address(address);
    low = *[data]:2 address;
    local upper:2 = address + 1;
    high = *[data]:2 upper;
}

macro compact_move_long_write(low, high) {
    local address:2;
    compact_move_long_address(address);
    local upper:2 = address + 1;
    *[data]:2 address = low;
    *[data]:2 upper = high;
}

macro compact_move_long_from_a0(bank) {
    local value:4 = (zext(A0H) << 16) | zext(A0L);
    local guard:1 = GB0;
    local shift:1 = (ECFG & 0x20) != 0;
    if (!shift) goto <limit>;
    value = (value >> 1) | (zext(guard & 1) << 31);
    guard = (guard >> 1) | (guard & 0x80);
  <limit>
    local sign:1 = (value >= 0x80000000) * 0xff;
    if ((ECFG & 8) == 0 || guard == sign) goto <write>;
    value = 0x7fffffff + zext(guard >= 0x80);
    EST = EST | (4:2 << (bank * 6));
  <write>
    local low:2 = value(0);
    local high:2 = value(2);
    compact_move_long_write(low, high);
}

@define COMPACT_MOVE_LONG_STORE "slot_9_22=0x18f5 & (slot_4_7=6 | slot_4_7=14) & slot_1_3=0"
@define COMPACT_MOVE_LONG_LOAD "slot_7_22=0x63b0 & slot_6_6=1 & slot_1_4=6 & slot_0_0=0"

:^nop_left "||" "MOVE" "*R6+RN6:long","A0" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_MOVE_LONG_STORE) & slot_0_0=0) { compact_move_long_from_a0(1:2); }
:^nop_left "||" "MOVE" "CE2" "*R6+RN6:long","A0" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_MOVE_LONG_STORE) & slot_0_0=1) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <status>;
    compact_move_long_from_a0(1:2);
  <status>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE "*R6+RN6:long","A0" is carmel_issue=3 & slot_mode=0 & $(COMPACT_MOVE_LONG_STORE) & slot_0_0=0 { compact_move_long_from_a0(0:2); }

:MOVE "A0","*R6+RN6:long" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_MOVE_LONG_LOAD)); (slot_mode=0 & nop_right) {
    local low:2;
    local high:2;
    compact_move_long_read(low, high);
    local negative:1 = high >= 0x8000;
    A0L = low;
    A0H = high;
    GB0 = negative * 0xff;
    EST = (EST & 0xffc4) | (zext((low | high) == 0) << 3) | (zext(negative) << 4);
}

@define COMPACT_INDEXED_WORD "slot_9_22=0x18ee & slot_2_5=4 & indexed_load_acc & indexed_load_ptr & indexed_load_inc"

indexed_load_first: "MOVE" indexed_load_acc,"*"^indexed_load_ptr^"+="^indexed_load_inc is $(COMPACT_INDEXED_WORD) & slot_0_0=0 { }
indexed_load_first: "MOVE" "CE1" indexed_load_acc,"*"^indexed_load_ptr^"+="^indexed_load_inc is $(COMPACT_INDEXED_WORD) & slot_0_0=1 { }
indexed_load_second: "MOVE" indexed_load_acc,"*"^indexed_load_ptr^"+="^indexed_load_inc is $(COMPACT_INDEXED_WORD) & slot_0_0=0 { }
indexed_load_second: "MOVE" "CE2" indexed_load_acc,"*"^indexed_load_ptr^"+="^indexed_load_inc is $(COMPACT_INDEXED_WORD) & slot_0_0=1 { }

macro compact_indexed_word_load(ptr, step, lane, lo, hi, guard, qualified, cfg, bank) {
    local enabled:2 = 1;
    local check:1 = qualified;
    if (check == 0) goto <prepare>;
    unary_ce(cfg, EST, CETBL, bank, enabled);
  <prepare>
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <publish>;
    local address:2 = ptr;
    modify_ptr(ptr, step, RM0, RL0, lane, 1:2);
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <publish>;
    local negative:1 = word >= 0x8000;
    lo = word;
    hi = zext(negative) * 0xffff;
    guard = negative * 0xff;
    local shift:2 = bank * 6;
    local nz:2 = (zext(word == 0) << 3) | (zext(negative) << 4);
    flags = (flags & ~(0x3b:2 << shift)) | (nz << shift);
  <publish>
    publish_alu_ce(flags);
}

@define INDEXED_WORD_LANES "indexed_load_ptr & indexed_load_inc & indexed_load_shift & indexed_load_lo & indexed_load_hi & indexed_load_guard & slot_0_0"

:^indexed_load_first is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & indexed_load_first & $(INDEXED_WORD_LANES) {
    compact_indexed_word_load(indexed_load_ptr, indexed_load_inc, indexed_load_shift, indexed_load_lo, indexed_load_hi, indexed_load_guard, slot_0_0, CECFG1, 0:2);
}
:^indexed_load_first "||" nop_right is (carmel_issue=1 & slot_mode=0 & indexed_load_first & $(INDEXED_WORD_LANES)); (slot_mode=0 & nop_right) {
    compact_indexed_word_load(indexed_load_ptr, indexed_load_inc, indexed_load_shift, indexed_load_lo, indexed_load_hi, indexed_load_guard, slot_0_0, CECFG1, 0:2);
}
:^nop_left "||" indexed_load_second is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & indexed_load_second & $(INDEXED_WORD_LANES)) {
    compact_indexed_word_load(indexed_load_ptr, indexed_load_inc, indexed_load_shift, indexed_load_lo, indexed_load_hi, indexed_load_guard, slot_0_0, CECFG2, 1:2);
}

:MOVE "*R6+RN6:long","LSA1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x31e4c4); (slot_mode=0 & nop_right) {
    local low:2 = LSA1L;
    local high:2 = zext(LSA1H);
    if ((ECFG & 0x20) == 0) goto <write>;
    low = (low >> 1) | (high << 15);
    high = high >> 1;
  <write>
    compact_move_long_write(low, high);
}

# The loop-start result is connected before CE gates the ordinary result port.
:MOVE "LSA1","*R6+RN6:long" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_5_22=0x18f8a & slot_1_4=6); (slot_mode=0 & nop_right) {
    local low:2;
    local high:2;
    compact_move_long_read(low, high);
    LSA1L = low & 0xfffe;
    LSA1H = high:1;
    LSAL = LSA1L;
    LSAH = LSA1H;
}

:ADDC "CE1" "*R3+=RN3","RN6" is carmel_issue=2 & slot_mode=1 & slot_0_22=0x14bb97 {
    local enabled:2;
    local address:2;
    compact_rmw_r3(CECFG1, 0:1, address, enabled);
    if (enabled == 0) goto <done>;
    local word:2 = *[data]:2 address;
    local signed_word:4 = sext(word);
    local signed_increment:4 = sext(RN6);
    local exact:4 = signed_word + signed_increment + zext(EST & 1);
    local negative:1 = exact >= 0x80000000;
    local extended:1 = exact + 0x8000 > 0xffff;
    local carry_out:1 = (word >= 0x8000 && RN6 >= 0x8000) ||
                        ((word >= 0x8000 || RN6 >= 0x8000) && !negative);
    local flags:2 = zext(carry_out) | (zext(exact == 0) << 3) |
                    (zext(negative) << 4) | (zext(extended) << 5);
    local result:2 = exact:2;
    if (!extended) goto <write>;
    flags = flags | 4;
    if ((ECFG & 0x28) != 8 && (ECFG & 4) == 0) goto <write>;
    result = 0x7fff + zext(negative);
  <write>
    *[data]:2 address = result;
    publish_alu_ce((EST & 0xcfc4) | flags);
  <done>
}

macro raw_mac_flags(flags, active, shift) {
    flags = (flags & ~(0x3b:2 << shift)) | (active << shift);
}

# The two temporary ports sample the left AGUs before either result is
# published. The direct route also connects the first word to the left ALU.
macro dual_preg_addresses(first, second) {
    first = R1;
    second = R2;
    modify_ptr(R1, RN1, RM0, RL0, 2, 2);
}

macro dual_preg_fetch(first_address, second_address, first_word) {
    first_word = *[data]:2 first_address;
    local second_word:2 = *[data]:2 second_address;
}

dual_preg_left_op: "ADDABS" is slot_16_22=0x1d { export 0:2; }
dual_preg_left_op: "SUB" is slot_16_22=0x01 { export 1:2; }
dual_preg_left_op: "SUBR" is slot_16_22=0x05 { export 2:2; }
@define DUAL_PREG_LEFT "carmel_issue=1 & slot_mode=0 & slot_15_15=1 & slot_11_14=9 & slot_6_10=17 & slot_1_5=2 & slot_0_0=0"

:dual_preg_left_op "A1H","*R1++","*R2" "||" "SUBC" dual_preg_register,mac_preg_src_name,"*R3++" is ($(DUAL_PREG_LEFT) & dual_preg_left_op); (slot_mode=0 & slot_16_22=8 & slot_15_15=1 & (slot_11_14=10 | slot_11_14=11) & dual_preg_register & mac_preg_src_name & slot_1_5=19 & slot_0_0=0) {
    local first_address:2;
    local second_address:2;
    dual_preg_addresses(first_address, second_address);
    modify_ptr(R3, RN3, RM2, RL2, 6, 2);
    local first_word:2;
    dual_preg_fetch(first_address, second_address, first_word);
    local carry_in:2 = (EST >> 6) & 1;
    local left_flags:2 = 8 | zext(dual_preg_left_op != 0);
    local right_flags:2 = carry_in * 9 | ((1 - carry_in) << 4);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    raw_mac_flags(flags, right_flags, 6);
    A1H = 0;
    dual_preg_register = carry_in - 1;
    publish_alu_ce(flags);
}

# The connected direct input adds a high-bus request when its address is
# high. Lift only the established low-bus route, never an unbound variant.
:dual_preg_left_op "A1H","*R1++","*R2" "||" "SUB CE2" "*R1",mac_preg_src_name,"*R2+=RN2" is ($(DUAL_PREG_LEFT) & carmel_of_route=2 & dual_preg_left_op); (slot_mode=0 & slot_16_22=0 & slot_15_15=0 & slot_11_14=1 & mac_preg_src_name & slot_1_5=10 & slot_0_0=1) {
    local enabled:2;
    compact_preg_ce(1:1, enabled);
    local first_address:2;
    local second_address:2;
    dual_preg_addresses(first_address, second_address);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <fetch>;
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
  <fetch>
    local first_word:2;
    dual_preg_fetch(first_address, second_address, first_word);
    local exact:8 = ((zext(first_word) ^ 0x8000) - 0x8000) << 16;
    local adder:8 = 0;
    if (dual_preg_left_op != 1) goto <not_sub>;
    adder = 0x10000000000;
    goto <finish>;
  <not_sub>
    if (dual_preg_left_op != 2) goto <absolute>;
    adder = zext(first_word == 0) << 40;
    exact = -exact;
    goto <finish>;
  <absolute>
    if (exact s>= 0) goto <finish>;
    exact = -exact;
  <finish>
    local result:8;
    local left_flags:2;
    raw_mac_finish(exact, adder, 1:1, 0:1, 0:1, result, left_flags);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    if (enabled == 0) goto <publish>;
    flags = (flags & 0xf13f) | 0x240;
  <publish>
    A1H = result(2);
    publish_alu_ce(flags);
}

macro raw_mac_product(left, right, sign_left, sign_right, product) {
    local a:8 = zext(left);
    local b:8 = zext(right);
    if (sign_left == 0) goto <left_ready>;
    a = (a ^ 0x8000) - 0x8000;
  <left_ready>
    if (sign_right == 0) goto <right_ready>;
    b = (b ^ 0x8000) - 0x8000;
  <right_ready>
    product = a * b * (1 + zext(ECFG & 1));
}

# The unqualified primary MPY with an idle peer publishes a fresh status
# word. Sample both physical inputs before a pointer update or X1 write.
macro compact_routed_mpy_acc(left, right) {
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local result:8;
    local flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 0:1, 0:1, 0:1, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce(flags);
}

@define COMPACT_ROUTED_MPY "carmel_issue=1 & slot_mode=0 & slot_0_0=0"

compact_mpy_latching_first: "R2" is compact_mul_left=2 { export R2; }
compact_mpy_latching_first: "RN2" is compact_mul_left=10 { export RN2; }
compact_mpy_latching_first: "FF1" is compact_mul_left=22 { export FF1; }

:MPY "A0",compact_mpy_latching_first,"A2L" "||" nop_right is
    ($(COMPACT_ROUTED_MPY) & slot_9_22=0x20b0 & (slot_4_8=2 | slot_4_8=10 | slot_4_8=22) &
     compact_mpy_latching_first & compact_mul_right=2); (slot_mode=0 & nop_right) {
    local first:2 = compact_mpy_latching_first;
    X1 = first;
    compact_routed_mpy_acc(first, A2L);
}

:MPY "A0","X1","A2L" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_9_22=0x20b0 & compact_mul_left=20 & compact_mul_right=2); (slot_mode=0 & nop_right) {
    compact_routed_mpy_acc(X1, A2L);
}

compact_mpy_direct_second: "R0" is slot_1_5=0 { export R0; }
compact_mpy_direct_second: "X1" is slot_1_5=20 { export X1; }
compact_mpy_direct_second: "FF2" is slot_1_5=23 { export FF2; }

:MPY "A0","*R0++",compact_mpy_direct_second "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x10410 & compact_mpy_direct_second); (slot_mode=0 & nop_right) {
    local address:2 = R0;
    local second:2 = compact_mpy_direct_second;
    modify_ptr(R0, 0:2, RM0, RL0, 0, 2);
    local first:2 = *[data]:2 address;
    X1 = first;
    compact_routed_mpy_acc(first, second);
}

# First-position OP1/OP2 takes the ordinary half on input two, bypassing X.
# In position two it supplies zero, but the first input still drives OF and X.
compact_token_left_mpy: "OP1" is slot_4_8=30 { }
compact_token_left_mpy: "OP2" is slot_4_8=31 { }
@define COMPACT_TOKEN_MPY_SQUARE "slot_12_22=0x416 & slot_9_11<6 & compact_aux_acc_dst & compact_aux_dst_lo & compact_aux_dst_hi & compact_aux_dst_guard & compact_token_left_mpy & compact_mul_right"
@define COMPACT_TOKEN_MPY_DATA "slot_14_22=0x104 & $(COMPACT_TOKEN_DATA) & $(COMPACT_TOKEN_ACC) & compact_token_right"

macro compact_token_mpy_square(lo, hi, guard, word, cfg, bank, qualified) {
    local flags:2 = EST & 0xcfff;
    local enabled:2;
    compact_token_enable(cfg, bank, qualified, enabled);
    if (enabled == 0) goto <publish>;
    local product:8;
    raw_mac_product(word, word, 1:1, 1:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 0:1, 0:1, 0:1, result, active);
    write_accumulator40(lo, hi, guard, result);
    compact_token_flags(flags, active, bank);
  <publish>
    publish_alu_ce(flags);
}

macro compact_token_mpy_data(lo, hi, guard, ptr, modulo, bound, shift, latch, cfg, bank, qualified) {
    local flags:2 = EST & 0xcfff;
    local enabled:2;
    compact_token_enable(cfg, bank, qualified, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <publish>;
    compact_token_read(ptr, modulo, bound, shift, latch);
    if (enabled == 0) goto <publish>;
    write_accumulator40(lo, hi, guard, 0:8);
    compact_token_flags(flags, 8:2, bank);
  <publish>
    publish_alu_ce(flags);
}

:MPY compact_token_ce1 compact_aux_acc_dst,compact_token_left_mpy,compact_mul_right is
    $(COMPACT_TOKEN_SEQ) & $(COMPACT_TOKEN_MPY_SQUARE) & compact_token_ce1 {
    compact_token_mpy_square(compact_aux_dst_lo, compact_aux_dst_hi, compact_aux_dst_guard,
                             compact_mul_right, CECFG1, 0:2, compact_token_ce1);
}
:MPY compact_token_ce1 compact_aux_acc_dst,compact_token_left_mpy,compact_mul_right "||" nop_right is
    ($(COMPACT_TOKEN_PAR) & $(COMPACT_TOKEN_MPY_SQUARE) & compact_token_ce1); (slot_mode=0 & nop_right) {
    compact_token_mpy_square(compact_aux_dst_lo, compact_aux_dst_hi, compact_aux_dst_guard,
                             compact_mul_right, CECFG1, 0:2, compact_token_ce1);
}
:^nop_left "||" "MPY" compact_token_ce2 compact_aux_acc_dst,compact_token_left_mpy,compact_mul_right is
    ($(COMPACT_TOKEN_PAR) & nop_left); (slot_mode=0 & $(COMPACT_TOKEN_MPY_SQUARE) & compact_token_ce2) {
    compact_token_mpy_square(compact_aux_dst_lo, compact_aux_dst_hi, compact_aux_dst_guard,
                             compact_mul_right, CECFG2, 1:2, compact_token_ce2);
}

:MPY compact_token_ce1 pair_acc_11,"*"^pair_ptr_6^"++",compact_token_right is
    $(COMPACT_TOKEN_SEQ) & $(COMPACT_TOKEN_MPY_DATA) & compact_token_ce1 {
    compact_token_mpy_data(pair_acc_11_lo, pair_acc_11_hi, pair_acc_11_gb, pair_ptr_6, pair_rm_6, pair_rl_6,
                           pair_bank_6, X1, CECFG1, 0:2, compact_token_ce1);
}
:MPY compact_token_ce1 pair_acc_11,"*"^pair_ptr_6^"++",compact_token_right "||" nop_right is
    ($(COMPACT_TOKEN_PAR) & $(COMPACT_TOKEN_MPY_DATA) & compact_token_ce1); (slot_mode=0 & nop_right) {
    compact_token_mpy_data(pair_acc_11_lo, pair_acc_11_hi, pair_acc_11_gb, pair_ptr_6, pair_rm_6, pair_rl_6,
                           pair_bank_6, X1, CECFG1, 0:2, compact_token_ce1);
}
:^nop_left "||" "MPY" compact_token_ce2 pair_acc_11,"*"^pair_ptr_6^"++",compact_token_right is
    ($(COMPACT_TOKEN_PAR) & nop_left); (slot_mode=0 & $(COMPACT_TOKEN_MPY_DATA) & compact_token_ce2) {
    compact_token_mpy_data(pair_acc_11_lo, pair_acc_11_hi, pair_acc_11_gb, pair_ptr_6, pair_rm_6, pair_rl_6,
                           pair_bank_6, X2, CECFG2, 1:2, compact_token_ce2);
}

define pcodeop carmel_data_read_conflict;

parallel_shift_source: "FF1" is slot_7_11=22 { export 0:1; }
parallel_shift_source: "OP1" is slot_7_11=30 { export 1:1; }
parallel_shift_source: "OP2" is slot_7_11=31 { export 1:1; }
parallel_right_shift: "LSHIFT" shift_literal_dst,parallel_shift_source,shift_word_literal is
    slot_mode=0 & slot_16_22=0x39 & slot_0_0=0 &
    (slot_13_14=0 | slot_13_14=1 | slot_13_14=2) & shift_literal_dst &
    parallel_shift_source & shift_word_literal {
    build parallel_shift_source;
    export parallel_shift_source;
}

# A right shifter does not publish a result. OP1/OP2 nevertheless request
# both PReg words at OF, in addition to the connected left ALU inputs.
macro parallel_shift_fetch(a, b, copy_preg, word_result, first, second) {
    if (copy_preg == 0) goto <direct>;
    local region:2 = a & 0xc000;
    local peer:2 = b & 0xc000;
    if (((a ^ b) & 0x8000) == 0) goto <stopped>;
    if (region == 0x4000 || region == 0x8000) goto <stopped>;
    if (word_result == 0 || peer == 0 || peer == 0xc000) goto <fetch_copy>;
    goto <stopped>;
  <direct>
    if (((a ^ b) & 0xc001) != 0) goto <fetch_direct>;
    region = a & 0xc000;
    if (region == 0 || region == 0xc000) goto <fetch_direct>;
  <stopped>
    carmel_data_read_conflict();
    goto <stopped>;
  <fetch_copy>
    local preg_first:2 = *[data]:2 a;
    local preg_second:2 = *[data]:2 b;
    first = *[data]:2 a;
    second = 0;
    if (word_result == 0) goto <fetched>;
    second = *[data]:2 b;
    goto <fetched>;
  <fetch_direct>
    first = *[data]:2 a;
    second = *[data]:2 b;
  <fetched>
}

@define PARALLEL_SHIFT_ADDABS "carmel_issue=1 & slot_mode=0 & slot_0_0=1"

:ADDABS "CE1" "*R3+=RN3","*R6--","*R7--" "||" parallel_right_shift is
    ($(PARALLEL_SHIFT_ADDABS) & slot_16_22=0x1d & slot_9_13=31 & slot_5_8=14 & slot_1_4=15);
    parallel_right_shift {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <publish>;
    local destination:2 = R3;
    local a:2 = R6;
    local b:2 = R7;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
    modify_ptr(R6, 0:2, RM6, RL6, 12, 3);
    modify_ptr(R7, 0:2, RM6, RL6, 14, 3);
    local first:2;
    local second:2;
    parallel_shift_fetch(a, b, parallel_right_shift, 1:1, first, second);
    if (enabled == 0) goto <publish>;
    local magnitude:8 = (zext(first) ^ 0x8000) - 0x8000;
    if (first < 0x8000) goto <add>;
    magnitude = -magnitude;
  <add>
    local rhs:8 = ((zext(second) ^ 0x8000) - 0x8000) << 16;
    local lhs:8 = magnitude << 16;
    local result:8;
    local active:2;
    raw_mac_finish(lhs + rhs, lhs + (rhs & 0xffffffffff), 1:1, 0:1, 1:1, result, active);
    *[data]:2 destination = result(2);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:ADDABS "CE1" "A2","*R4--","*R0" "||" parallel_right_shift is
    ($(PARALLEL_SHIFT_ADDABS) & slot_16_22=0x19 & slot_11_13=2 & slot_6_10=28 &
    slot_1_5=0 & slot_14_15=0); parallel_right_shift {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <publish>;
    local a:2 = R4;
    local b:2 = R0;
    modify_ptr(R4, 0:2, RM4, RL4, 8, 3);
    local first:2;
    local second:2;
    parallel_shift_fetch(a, b, parallel_right_shift, 0:1, first, second);
    if (enabled == 0) goto <publish>;
    local magnitude:8 = (zext(second) ^ 0x8000) - 0x8000;
    if (second < 0x8000) goto <add>;
    magnitude = -magnitude;
  <add>
    local lhs:8 = (zext(first) ^ 0x8000) - 0x8000;
    local result:8;
    local active:2;
    raw_mac_finish(lhs + magnitude, (lhs & 0xffffffffff) + magnitude, 0:1, 0:1, 0:1, result, active);
    A2L = result:2;
    A2H = result(2);
    GB2 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MPY "A0","*R0++","*R1++" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x10610 & slot_1_5=17); (slot_mode=0 & nop_right) {
    local first_address:2 = R0;
    local second_address:2 = R1;
    modify_ptr(R0, 0:2, RM0, RL0, 0, 2);
    modify_ptr(R1, 0:2, RM0, RL0, 2, 2);
    # The two middle regions have separate one-read ports for even and odd words.
    if (((first_address ^ second_address) & 0xc001) != 0) goto <fetch>;
    local region:2 = first_address & 0xc000;
    if (region == 0 || region == 0xc000) goto <fetch>;
  <stopped>
    carmel_data_read_conflict();
    goto <stopped>;
  <fetch>
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    X1 = first;
    compact_routed_mpy_acc(first, second);
}

:MPY "A0","X1","*R1++" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x10740 & slot_1_5=17); (slot_mode=0 & nop_right) {
    local address:2 = R1;
    modify_ptr(R1, 0:2, RM0, RL0, 2, 2);
    local second:2 = *[data]:2 address;
    compact_routed_mpy_acc(X1, second);
}

:MPY "A0","*R0+RN0","A2L" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x10500 & slot_1_5=18); (slot_mode=0 & nop_right) {
    local address:2 = R0 + RN0;
    local first:2 = *[data]:2 address;
    X1 = first;
    compact_routed_mpy_acc(first, A2L);
}

:MPY "A0","X1","*R1+RN1" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x107d0 & slot_1_5=1); (slot_mode=0 & nop_right) {
    local address:2 = R1 + RN1;
    local second:2 = *[data]:2 address;
    compact_routed_mpy_acc(X1, second);
}

:MPY "A0","OP3","FF1" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x10541 & slot_1_5=22); (slot_mode=0 & nop_right) {
    X1 = FF1;
    compact_routed_mpy_acc(FF1, FF1);
}

:MPY "A0","OP3","*R2++" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x10741 & slot_1_5=18); (slot_mode=0 & nop_right) {
    local address:2 = R2;
    modify_ptr(R2, 0:2, RM2, RL2, 4, 2);
    local operand:2 = *[data]:2 address;
    X1 = operand;
    compact_routed_mpy_acc(operand, operand);
}

:MPY "X1","*R0","A2L" "||" nop_right is ($(COMPACT_ROUTED_MPY) & slot_6_22=0x109c0 & slot_1_5=18); (slot_mode=0 & nop_right) {
    local first:2 = *[data]:2 R0;
    X1 = first;
    local product:8;
    raw_mac_product(first, A2L, 1:1, 1:1, product);
    local result:8;
    local flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, result, flags);
    # The explicit high-word write supersedes the input latch in this issue.
    X1 = result(2);
    publish_alu_ce(flags);
}

# FFT samples the signed upper six bits of the DATA word pair; final
# DATA saturation is downstream of the tap, unlike ALIM and SR1.
macro compact_pair_fft(raw, stored, arithmetic, status) {
    if ((ECFG & 0x10) == 0 || (status & 0x4000) != 0) goto <done>;
    local sample:4 = stored:4;
    if (arithmetic == 0 || (ECFG & 0x28) != 8) goto <compare>;
    sample = raw:4;
    if ((ECFG & 4) == 0 || ((((raw >> 31) ^ (raw >> 32)) & 1) == 0)) goto <compare>;
    sample = 0x7fffffff + zext((raw & 0x8000000000) != 0);
  <compare>
    local top:4 = sample s>> 26;
    local limit:4 = zext(FFTV & 31);
    if (top s>= -limit && top s<= limit) goto <done>;
    status = status | 0x4000;
  <done>
}

macro compact_pair_read_check(first, second) {
    if (((first ^ second) & 0xc001) != 0) goto <fetch>;
    local region:2 = first & 0xc000;
    if (region == 0 || region == 0xc000) goto <fetch>;
  <stopped>
    carmel_data_read_conflict();
    goto <stopped>;
  <fetch>
}

macro wide_insert_bits(original, source, result) {
    local count:4 = zext(FF2 & 31);
    local offset:4 = zext(FF1 & 31);
    local mask:8 = 0x7fffffff >> (31 - count);
    result = (original & ~(mask << offset)) | ((source & mask) << offset);
}

macro wide_insert_read_pair(address, next, original) {
    local lo:2 = *[data]:2 address;
    local hi:2 = *[data]:2 next;
    original = (zext(hi) << 16) | zext(lo);
}

macro wide_insert_store_pair(address, next, source, original, status) {
    local result:8;
    wide_insert_bits(original, source, result);
    status = (status & 0xfff7) | (zext(result:4 == 0) << 3);
    compact_pair_fft(result, result, 0:1, status);
    *[data]:2 address = result:2;
    *[data]:2 next = result(2);
}

# The address override can allocate and postmodify without publishing a result.
:INSERT "CE1" "*R2+=RN2:long","FF1","FF2:FF1" is
    carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0
    & wide_0_22=0x78952d & wide_40_45=0x23 {
    local first:2;
    unary_ce(CECFG1, EST, CETBL, 0:2, first);
    local status:2 = EST & 0xcfff;
    if (first == 0 && (CECFG1 & 0x1000) == 0) goto <feedback>;
    local address:2 = R2;
    local next:2 = address + 1;
    if ((PACFG & 0x30) == 0x10) goto <reversed>;
    transfer_address_word(R2, RM2, RL2, 4, RN2, R2);
    goto <sample>;
  <reversed>
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
  <sample>
    local original:8;
    wide_insert_read_pair(address, next, original);
    if (first == 0) goto <feedback>;
    wide_insert_store_pair(address, next, zext(FF1), original, status);
  <feedback>
    local second:2;
    unary_ce(CECFG2, EST, CETBL, 1:2, second);
    EST = status | (first << 12) | (second << 13);
}

:INSERT "CE1" "GB2","*R1+"^wide_shift_dst_disp^":long","FF2:FF1" is
    carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0
    & wide_0_22=0x7904c3 & wide_40_45=0x23 & wide_shift_dst_disp {
    local first:2;
    unary_ce(CECFG1, EST, CETBL, 0:2, first);
    local status:2 = EST & 0xcfff;
    if (first == 0 && (CECFG1 & 0x1000) == 0) goto <feedback>;
    local address:2 = R1 + wide_shift_dst_disp;
    local next:2 = address + 1;
    local source:8;
    wide_insert_read_pair(address, next, source);
    if (first == 0) goto <feedback>;
    local result:8;
    wide_insert_bits(zext(GB2), source, result);
    GB2 = result(2);
    status = (status & 0xfff7) | (zext(result:2 == 0) << 3);
  <feedback>
    local second:2;
    unary_ce(CECFG2, EST, CETBL, 1:2, second);
    EST = status | (first << 12) | (second << 13);
}

:INSERT "*R1+"^wide_shift_dst_disp^":long","*R2++","FF2:FF1" is
    carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1
    & wide_0_22=0x78c225 & wide_40_45=0x23 & wide_shift_dst_disp {
    local address:2 = R1 + wide_shift_dst_disp;
    local next:2 = address + 1;
    local source_addr:2 = R2;
    transfer_address_word(R2, RM2, RL2, 4, 1:2, R2);
    # A long RMW and a short source reserve three words in one issue.
    if (((address ^ next) | (address ^ source_addr)) < 0x8000) goto <stopped>;
    local bank:2 = source_addr & 0xc000;
    if (bank == 0 || bank == 0xc000) goto <sample>;
    if (((address ^ source_addr) & 0xc001) != 0 && ((next ^ source_addr) & 0xc001) != 0) goto <sample>;
  <stopped>
    carmel_data_read_conflict();
    goto <stopped>;
  <sample>
    local original:8;
    wide_insert_read_pair(address, next, original);
    local source:2 = *[data]:2 source_addr;
    local status:2 = EST & 0xcfff;
    wide_insert_store_pair(address, next, sext(source), original, status);
    publish_ce_feedback(status, EST);
}

compact_mpy_word_kind: "MPY"   is slot_15_22=0x84 { export 3:1; }
compact_mpy_word_kind: "MPYSU" is slot_15_22=0x8c { export 1:1; }
compact_mpy_word_kind: "MPYUS" is slot_15_22=0x94 { export 2:1; }
compact_mpy_word_kind: "MPYUU" is slot_15_22=0x9c { export 0:1; }

compact_mpy_word_address: "*"^pair_ptr_6 is slot_9_10=0 & pair_ptr_6 { export 0:2; }
compact_mpy_word_address: "*"^pair_ptr_6^"+="^pair_rn_6 is slot_9_10=1 & pair_ptr_6 & pair_rn_6 { export 1:2; }
compact_mpy_word_address: "*"^pair_ptr_6^"++" is slot_9_10=2 & pair_ptr_6 { export 2:2; }
compact_mpy_word_address: "*"^pair_ptr_6^"--" is slot_9_10=3 & pair_ptr_6 { export 3:2; }

@define COMPACT_MPY_WORD "slot_mode=0 & slot_0_0=0 & compact_mpy_word_kind & pair_half_11 & compact_mpy_word_address & pair_ptr_6 & pair_rn_6 & pair_rm_6 & pair_rl_6 & pair_bank_6 & slot_4_5=1 & logical_right"

macro compact_mpy_word_result(first, second, kind, result, flags) {
    local product:8;
    raw_mac_product(first, second, kind & 1, kind & 2, product);
    raw_mac_finish_limit(product, product & 0xffffffffff, 1:1, 1:1, 0:1, kind == 3, result, flags);
}

macro compact_mpy_word_solo(dst, latch, bank_shift, ptr, rn, rm, rl, shift, action, factor, kind) {
    local address:2 = ptr;
    modify_ptr(ptr, rn, rm, rl, shift, action);
    local first:2 = *[data]:2 address;
    latch = first;
    local result:8;
    local active:2;
    compact_mpy_word_result(first, factor, kind, result, active);
    dst = result(2);
    local status:2 = EST & 0xcfff;
    raw_mac_flags(status, active, bank_shift);
    publish_alu_ce(status);
}

:^compact_mpy_word_kind pair_half_11,compact_mpy_word_address,logical_right "||" nop_right is
    ($(COMPACT_ROUTED_MPY) & $(COMPACT_MPY_WORD)); (slot_mode=0 & nop_right) {
    compact_mpy_word_solo(pair_half_11, X1, 0, pair_ptr_6, pair_rn_6, pair_rm_6, pair_rl_6,
                          pair_bank_6, compact_mpy_word_address, logical_right, compact_mpy_word_kind);
}

:^nop_left "||" compact_mpy_word_kind pair_half_11,compact_mpy_word_address,logical_right is
    (carmel_issue=1 & slot_mode=0 & nop_left); $(COMPACT_MPY_WORD) {
    compact_mpy_word_solo(pair_half_11, X2, 6, pair_ptr_6, pair_rn_6, pair_rm_6, pair_rl_6,
                          pair_bank_6, compact_mpy_word_address, logical_right, compact_mpy_word_kind);
}

macro compact_mpy_three_reads(first, second, third) {
    if ((((first ^ second) | (first ^ third)) & 0x8000) != 0) goto <check_ports>;
  <stopped>
    carmel_data_read_conflict();
    goto <stopped>;
  <check_ports>
    compact_pair_read_check(first, second);
    compact_pair_read_check(first, third);
    compact_pair_read_check(second, third);
}

macro compact_mpy_round_word(first, second, result, flags) {
    local product:8;
    raw_mac_product(first, second, 1:1, 1:1, product);
    # This port rounds ties upward even when ECFG.R is set; C is the bias adder's carry.
    local rounded:8 = (product + 0x8000) & 0xffffffffffff0000;
    local adder:8 = (product & 0xffffffffff) + 0x8000;
    raw_mac_finish(rounded, adder, 1:1, 1:1, 0:1, result, flags);
}

# Three independent DATA sources share the packet's operand-fetch ports.
# CE1/AEN control the rounded lane's reads, but only CE1 enables its result.
:MPYR "CE1" compact_round_half,"*"^compact_round_ptr_6,"*"^pair_ptr_1 "||"
    compact_mpy_word_kind pair_half_11,compact_mpy_word_address,logical_right is
    (carmel_issue=1 & slot_mode=0 & slot_15_22=0xae & slot_0_0=1 & compact_round_half & compact_round_half_id &
     slot_6_10<8 & slot_1_5<8 & compact_round_ptr_6 & pair_ptr_1);
    ($(COMPACT_MPY_WORD) & slot_11_14) {
    local a:2 = compact_round_ptr_6;
    local b:2 = pair_ptr_1;
    local address:2 = pair_ptr_6;
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local fetch_left:1 = enabled != 0 || (CECFG1 & 0x1000) != 0;
    modify_ptr(pair_ptr_6, pair_rn_6, pair_rm_6, pair_rl_6, pair_bank_6, compact_mpy_word_address);
    local left_first:2 = 0;
    local left_second:2 = 0;
    if (!fetch_left) goto <fetch_right>;
    compact_mpy_three_reads(a, b, address);
    left_first = *[data]:2 a;
    left_second = *[data]:2 b;
  <fetch_right>
    local first:2 = *[data]:2 address;
    if (!fetch_left) goto <latch_right>;
    X1 = left_first;
  <latch_right>
    X2 = first;
    local result:8;
    local active:2;
    local right_result:8;
    local right_flags:2;
    compact_mpy_word_result(first, logical_right, compact_mpy_word_kind, right_result, right_flags);
    local status:2 = EST & 0xcfff;
    if (enabled == 0) goto <commit_right>;
    compact_mpy_round_word(left_first, left_second, result, active);
    compact_round_half = result(2);
    raw_mac_flags(status, active, 0);
  <commit_right>
    pair_half_11 = right_result(2);
    if (enabled != 0 && compact_round_half_id:1 == slot_11_14:1) goto <conflict>;
    raw_mac_flags(status, right_flags, 6);
    publish_alu_ce(status);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro compact_pair_long_store(address, result) {
    local upper:2 = address + 1;
    *[data]:2 address = result:2;
    *[data]:2 upper = result(2);
}

macro compact_pair_shift(value, count, result, flags) {
    local input:8 = zext(value);
    local n:4 = (zext(count & 127) ^ 64) - 64;
    local carry_out:1 = (EST & 1) != 0;
    result = input;
    if (n == 0) goto <finish>;
    if (n s< 0) goto <right>;
    if (n <= 40) goto <left>;
    n = 40;
  <left>
    carry_out = ((input >> (40 - n)) & 1) != 0;
    result = (input << n) & 0xffffffffff;
    goto <finish>;
  <right>
    local distance:4 = 0 - n;
    if (distance <= 40) goto <shift_right>;
    distance = 40;
  <shift_right>
    carry_out = ((input >> (distance - 1)) & 1) != 0;
    result = input >> distance;
  <finish>
    shift_flags(result, carry_out, flags);
}

macro compact_pair_addabs_word(left, right, store, raw, result, flags) {
    local a:8 = ((zext(left) ^ 0x8000) - 0x8000) << 16;
    local b:8 = zext(right) << 16;
    if (right < 0x8000) goto <add>;
    b = 0x100000000 - b;
  <add>
    raw = a + b;
    raw_mac_finish(raw, (a & 0xffffffffff) + b, 1:1, 0:1, store, result, flags);
}

# The right ADDABS selects the physical X2 input, including selector 14.
:LSHIFT "CE1" pair_ptr_10,pair_shift_source,pair_count "||" "ADDABS" x_alu_half_dst,pair_abs_source,"X2" is
    (carmel_issue=1 & slot_mode=0 & slot_14_22=0xed & slot_0_0=1 & pair_ptr_10 &
     pair_rn_10 & pair_rm_10 & pair_rl_10 & pair_bank_10 & slot_13_13 & slot_5_9<30 &
     pair_shift_source & slot_1_4<14 & pair_count);
    (slot_mode=0 & slot_14_22=0x68 & slot_0_0=0 & slot_10_12<6 & x_alu_half_dst &
     slot_5_9>=24 & slot_5_9<30 & pair_abs_source & (slot_1_4=14 | slot_1_4=15)) {
    local address:2 = pair_ptr_10;
    local a:2 = pair_shift_source;
    local count:2 = pair_count;
    local rhs:2 = X2;
    local addend:2 = pair_abs_source;
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <execute>;
    modify_ptr(pair_ptr_10, pair_rn_10, pair_rm_10, pair_rl_10, pair_bank_10, slot_13_13);
  <execute>
    local result:8;
    local active:2;
    local sum:8;
    compact_pair_addabs_word(addend, rhs, 0:1, sum, result, active);
    local status:2 = EST & 0xcfff;
    raw_mac_flags(status, active, 6);
    x_alu_half_dst = result(2);
    if (enabled == 0) goto <publish>;
    compact_pair_shift(a, count, result, active);
    status = (status & 0xffc6) | active;
    compact_pair_fft(result, result, 0:1, status);
    compact_pair_long_store(address, result);
  <publish>
    publish_alu_ce(status);
}

# RMW1's high-half selector consumes the SUBC computation but has no
# register writeback on the primary parallel lane. MPYUS still fills X2.
:SUBC "RMW1","A5H",pair_ptr_1 "||" "MPYUS CE2" pair_half_11,pair_ptr_6,logical_right is
    (carmel_issue=1 & slot_mode=0 & slot_15_22=0x11 & slot_11_14=6 & slot_6_10=29 &
     slot_4_5=1 & slot_0_0=0 & pair_ptr_1 & pair_rn_1 & pair_rm_1 & pair_rl_1 & pair_bank_1);
    (slot_mode=0 & slot_15_22=0x94 & slot_0_0=1 & (slot_11_14<5 | (slot_11_14>=8 & slot_11_14<13)) &
     pair_half_11 & slot_6_10<8 & pair_ptr_6 & logical_right) {
    local sub_address:2 = pair_ptr_1;
    local mul_address:2 = pair_ptr_6;
    local factor:2 = logical_right;
    local subtrahend:8;
    local carry_in:8 = zext(EST & 1);
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    modify_ptr(pair_ptr_1, pair_rn_1, pair_rm_1, pair_rl_1, pair_bank_1, 1:2);
    local fetch_right:1 = enabled != 0 || (CECFG2 & 0x1000) != 0;
    if (!fetch_right) goto <left_fetch>;
    compact_pair_read_check(sub_address, mul_address);
  <left_fetch>
    local sub_word:2 = *[data]:2 sub_address;
    local minuend:8 = ((zext(A5H) ^ 0x8000) - 0x8000) << 16;
    subtrahend = ((zext(sub_word) ^ 0x8000) - 0x8000) << 16;
    local result:8;
    local active:2;
    raw_mac_finish(minuend - subtrahend + carry_in - 1,
                   (minuend & 0xffffffffff) + (~subtrahend & 0xffffffffff) + carry_in,
                   1:1, 0:1, 0:1, result, active);
    local status:2 = EST & 0xcfff;
    raw_mac_flags(status, active, 0);
    if (!fetch_right) goto <publish>;
    local mul_word:2 = *[data]:2 mul_address;
    X2 = mul_word;
    if (enabled == 0) goto <publish>;
    local product:8;
    raw_mac_product(mul_word, factor, 0:1, 1:1, product);
    raw_mac_finish_limit(product, product & 0xffffffffff, 1:1, 1:1, 0:1, 0:1, result, active);
    pair_half_11 = result(2);
    raw_mac_flags(status, active, 6);
  <publish>
    publish_alu_ce(status);
}

# The short indexed RMW1 route writes address/increment registers without
# selecting a result flag mux or changing the indexed pointer.
:ADD "RMW1" pair_indexed_reg,pair_ptr_1 is carmel_issue=2 & slot_mode=1 & slot_13_22=0x9b &
    slot_9_12=6 & slot_4_8<16 & slot_0_0=0 & pair_indexed_reg & pair_ptr_1 & pair_rn_1 {
    local address:2 = pair_ptr_1 + pair_rn_1;
    pair_indexed_reg = pair_indexed_reg + *[data]:2 address;
    publish_alu_ce(EST & 0xcfff);
}

define pcodeop carmel_data_write_conflict;

# Both DATA write addresses reserve their bus before either lane evaluates
# its result predicate. The source postincrement uses the incoming word.
:ADDABS "CE1" pair_ptr_11,pair_word_6,pair_ptr_1 "||" "SUB CE2" pair_ptr_7,pair_acc_4,cmp_full_rhs_full is
    (carmel_issue=1 & slot_mode=0 & slot_15_22=0x30 & slot_11_14<8 & pair_ptr_11 &
     slot_6_10<30 & pair_word_6 & slot_1_5>=22 & slot_1_5<24 & slot_0_0=1 &
     pair_ptr_1 & pair_rm_1 & pair_rl_1 & pair_bank_1);
    (slot_mode=0 & pair_op_11=0x66 & slot_7_10>=8 & slot_7_10<14 & pair_ptr_7 & pair_rn_7 &
     pair_rm_7 & pair_rl_7 & pair_bank_7 & slot_4_6<6 & slot_1_3<6 & pair_acc_4 & cmp_full_rhs_full &
     pair_acc_4_lo & pair_acc_4_hi & pair_acc_4_gb &
     cmp_full_rhs_lo & cmp_full_rhs_hi & cmp_full_rhs_guard & slot_0_0=1) {
    local short_address:2 = pair_ptr_11;
    local source_address:2 = pair_ptr_1;
    local long_address:2 = pair_ptr_7;
    local word:2 = pair_word_6;
    local a:8;
    local b:8;
    compact_long_sample(pair_acc_4_lo, pair_acc_4_hi, pair_acc_4_gb, a);
    compact_long_sample(cmp_full_rhs_lo, cmp_full_rhs_hi, cmp_full_rhs_guard, b);
    local first_on:2;
    local second_on:2;
    unary_ce(CECFG1, EST, CETBL, 0, first_on);
    unary_ce(CECFG2, EST, CETBL, 1, second_on);
    local first_address_on:1 = first_on != 0 || (CECFG1 & 0x1000) != 0;
    local second_address_on:1 = second_on != 0 || (CECFG2 & 0x1000) != 0;
    if (!first_address_on) goto <second_agu>;
    modify_ptr(pair_ptr_1, 0:2, pair_rm_1, pair_rl_1, pair_bank_1, 2:2);
  <second_agu>
    if (!second_address_on) goto <operands>;
    modify_ptr(pair_ptr_7, pair_rn_7, pair_rm_7, pair_rl_7, pair_bank_7, 1:2);
    if (!first_address_on) goto <operands>;
    if (((short_address ^ long_address) & 0x8000) != 0) goto <operands>;
  <stopped>
    carmel_data_write_conflict();
    goto <stopped>;
  <operands>
    local status:2 = EST & 0xcfff;
    local active:2;
    local result:8;
    if (!first_address_on) goto <second>;
    local operand:2 = *[data]:2 source_address;
    if (first_on == 0) goto <second>;
    local sum:8;
    compact_pair_addabs_word(word, operand, 1:1, sum, result, active);
    raw_mac_flags(status, active, 0);
    if ((ECFG & 0x20) == 0) goto <write_short>;
    result = (result >> 1) | (result & 0x8000000000);
  <write_short>
    compact_pair_fft(sum, result, 1:1, status);
    *[data]:2 short_address = result(2);
  <second>
    if (second_on == 0) goto <publish>;
    local bits:8 = (a - b) & 0xffffffffff;
    local overflow:1 = ((a ^ b) >= 0x8000000000) && ((a ^ bits) >= 0x8000000000);
    compact_long_finish(bits, a >= b, overflow, 1:1, 0:1, result, active);
    raw_mac_flags(status, active, 6);
    compact_pair_fft(bits, result, 1:1, status);
    compact_pair_long_store(long_address, result);
  <publish>
    publish_alu_ce(status);
}

# An open whole-accumulator ADDABS operand selects the unsigned FF12 pair
# on this route. The right MPY samples both DATA words independently of CE2.
:ADDABS pair_ptr_7,pair_acc_4,"FF12" "||" "MPY CE2" pair_acc_11,pair_ptr_6,pair_ptr_1 is
    (carmel_issue=1 & slot_mode=0 & pair_op_11=0x366 & slot_0_0=0 & slot_7_10<8 &
     slot_4_6<6 & pair_acc_4 & (slot_1_3=6 | slot_1_3=7) & pair_ptr_7 & pair_acc_4_lo & pair_acc_4_hi & pair_acc_4_gb);
    (slot_mode=0 & slot_14_22=0x106 & slot_0_0=1 & slot_11_13<6 & pair_acc_11 &
     slot_6_10>=24 & slot_1_5<8 & pair_ptr_6 & pair_rm_6 & pair_rl_6 & pair_bank_6 & pair_ptr_1 &
     pair_acc_11_lo & pair_acc_11_hi & pair_acc_11_gb) {
    local address:2 = pair_ptr_7;
    local first:2 = pair_ptr_6;
    local second:2 = pair_ptr_1;
    local a:8;
    compact_long_sample(pair_acc_4_lo, pair_acc_4_hi, pair_acc_4_gb, a);
    local b:8 = (zext(FF2) << 16) | zext(FF1);
    local raw:8 = a + b;
    local bits:8 = raw & 0xffffffffff;
    local stored:8;
    local active:2;
    compact_long_finish(bits, raw > 0xffffffffff, a < 0x8000000000 && bits >= 0x8000000000,
                        1:1, 0:1, stored, active);
    local status:2 = EST & 0xcfff;
    raw_mac_flags(status, active, 0);
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <store>;
    modify_ptr(pair_ptr_6, 0:2, pair_rm_6, pair_rl_6, pair_bank_6, 3:2);
    compact_pair_read_check(first, second);
    local mul_left:2 = *[data]:2 first;
    local mul_right:2 = *[data]:2 second;
    X2 = mul_left;
    if (enabled == 0) goto <store>;
    local product:8;
    raw_mac_product(mul_left, mul_right, 1:1, 1:1, product);
    local result:8;
    raw_mac_finish(product, product & 0xffffffffff, 0:1, 0:1, 0:1, result, active);
    pair_acc_11_lo = result:2;
    pair_acc_11_hi = result(2);
    pair_acc_11_gb = result(4);
    raw_mac_flags(status, active, 6);
  <store>
    compact_pair_fft(bits, stored, 1:1, status);
    compact_pair_long_store(address, stored);
    publish_alu_ce(status);
}

macro raw_mac_round_sub(base, left, right, result, flags) {
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local exact:8 = (base ^ 0x8000000000) - 0x8000000000 - product;
    local bias:8 = 0x8000;
    if ((ECFG & 2) == 0) goto <bias_ready>;
    bias = 0x7fff + ((exact >> 16) & 1);
  <bias_ready>
    local raw:8 = base + (~product & 0xffffffffff) + 1 + bias;
    exact = (exact + bias) & 0xffffffffffff0000;
    raw_mac_finish(exact, raw, 0:1, 0:1, 0:1, result, flags);
    result = result & 0xffffff0000;
}

macro raw_mac_add(left, right, carry_in, short_result, store, result, flags) {
    local exact:8 = left + right + carry_in;
    local raw:8 = (left & 0xffffffffff) + (right & 0xffffffffff) + carry_in;
    raw_mac_finish(exact, raw, short_result, 0:1, store, result, flags);
}

macro raw_mac_word(value, result) {
    result = ((zext(value) ^ 0x8000) - 0x8000) << 16;
}

# Plain products have a separate result mux from accumulating MAC.
wide_mpy_kind: "MPY"   is wide_acc_mac_op=0x30 { export 3:1; }
wide_mpy_kind: "MPYSU" is wide_acc_mac_op=0x31 { export 1:1; }
wide_mpy_kind: "MPYUS" is wide_acc_mac_op=0x32 { export 2:1; }
wide_mpy_kind: "MPYUU" is wide_acc_mac_op=0x33 { export 0:1; }
wide_mpy_kind: "MPYR"  is wide_acc_mac_op=0x35 { export 7:1; }

wide_mpy_enable: is carmel_issue=5 & wide_left_mode=1 { export 3:2; }
wide_mpy_enable: " CE1" is carmel_issue=4 & wide_left_mode=0 & wide_mac_prefix=0 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    enabled = enabled | ((CECFG1 & 0x1000) >> 11);
    export enabled;
}
wide_mpy_enable: " CE2" is carmel_issue=4 & wide_left_mode=0 & wide_mac_prefix=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    enabled = enabled | ((CECFG2 & 0x1000) >> 11);
    export enabled;
}

wide_mpy_first: "A0L" is wide_acc_mac_first=0x50 { export A0L; }
wide_mpy_first: "*R0" is wide_acc_mac_first=0 {
    local address:2 = R0;
    export *[data]:2 address;
}
wide_mpy_first: "*R7+"^wide_acc_mac_displacement is wide_acc_mac_first=0x27 & wide_acc_mac_displacement {
    local address:2 = R7 + wide_acc_mac_displacement;
    export *[data]:2 address;
}
wide_mpy_first: "*R5+RN5" is wide_acc_mac_first=0x2d {
    local address:2 = R5 + RN5;
    export *[data]:2 address;
}
wide_mpy_first: "*0xffff" is wide_acc_mac_first=0x4f {
    local address:2 = 0xffff;
    export *[data]:2 address;
}
wide_mpy_first: "unbound" is wide_acc_mac_first=0x73 { export 0:2; }

wide_mpy_second: "A0L" is wide_40_45=0x10 & wide_0_0=1 { export A0L; }
wide_mpy_second: "A1L" is wide_40_45=0x11 & wide_0_0=1 { export A1L; }
wide_mpy_second: "R2"  is wide_40_45=0x22 & wide_0_0=1 { export R2; }
wide_mpy_second: "R6"  is wide_40_45=0x26 & wide_0_0=1 { export R6; }
wide_mpy_second: "unbound" is wide_40_45=0x33 & wide_0_0=1 { export 0:2; }
wide_mpy_second: "unbound" is wide_40_45=0x39 & wide_0_0=1 { export 0:2; }
wide_mpy_second: "#"^wide_acc_mac_absolute is wide_40_45=0x0f & wide_0_0=1 & wide_acc_mac_absolute {
    export *[const]:2 wide_acc_mac_absolute;
}

wide_mpy_discard: "discard" is (wide_acc_mac_dst>=0x80 & wide_acc_mac_dst<0x87) |
    wide_acc_mac_dst=0x8f | wide_acc_mac_dst=0xd2 | wide_acc_mac_dst=0xd3 |
    wide_acc_mac_dst=0xd5 | wide_acc_mac_dst=0xd7 {}

wide_mpy_word: "FF1" is wide_acc_mac_dst=0xbe { export FF1; }
wide_mpy_word: "LC1" is wide_acc_mac_dst=0xd4 { export LC1; }

wide_mpy_latch: is wide_acc_mac_first=0x50 {
    local bypass:2;
    export bypass;
}
wide_mpy_latch: is wide_acc_mac_first!=0x50 { export X1; }

wide_mpy_flags_only: "RMW2" is wide_acc_mac_dst=0x8e { export 0:1; }
wide_mpy_flags_only: "discard" is wide_acc_mac_dst=0xd8 { export 1:1; }

@define WIDE_MPY "wide_right_mode=1 & wide_mpy_kind & wide_mpy_enable & wide_mpy_first & wide_mpy_second & wide_mpy_latch"

macro wide_mpy_result(first, second, kind, narrow, store, shift, product, result, flags) {
    local signedness:1 = kind & 3;
    raw_mac_product(first, second, signedness & 1, signedness & 2, product);
    local raw:8 = product & 0xffffffffff;
    local rounded:1 = (kind & 4) != 0;
    if (!rounded) goto <finish>;
    local quantum:8 = 0x10000 << shift;
    local bias:8 = quantum >> 1;
    product = (product + bias) & -quantum;
    raw = raw + bias;
  <finish>
    local active:2;
    raw_mac_finish_limit(product, raw, narrow | store, narrow, store,
                         signedness == 3, result, active);
    raw_mac_flags(flags, active, 0);
    if (!rounded) goto <done>;
    result = result & 0xffffff0000;
  <done>
}

:^wide_mpy_kind^wide_mpy_enable wide_mpy_discard,wide_mpy_first,wide_mpy_second is
    $(WIDE_MPY) & wide_mpy_discard {
    build wide_mpy_enable;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_first;
    wide_mpy_latch = wide_mpy_first;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:^wide_mpy_kind^wide_mpy_enable wide_mpy_flags_only,wide_mpy_first,wide_mpy_second is
    $(WIDE_MPY) & wide_mpy_flags_only {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_first;
    local first:2 = wide_mpy_first;
    wide_mpy_latch = first;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local result:8;
    local product:8;
    wide_mpy_result(first, wide_mpy_second, wide_mpy_kind, wide_mpy_flags_only, 0:1, 0:4, product, result, flags);
  <publish>
    publish_alu_ce(flags);
}

:^wide_mpy_kind^wide_mpy_enable wide_mpy_word,wide_mpy_first,wide_mpy_second is
    $(WIDE_MPY) & wide_mpy_word {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_first;
    local first:2 = wide_mpy_first;
    wide_mpy_latch = first;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local result:8;
    local product:8;
    wide_mpy_result(first, wide_mpy_second, wide_mpy_kind, 1:1, 0:1, 0:4, product, result, flags);
    wide_mpy_word = result(2);
  <publish>
    publish_alu_ce(flags);
}

:^wide_mpy_kind^wide_mpy_enable "X1",wide_mpy_first,wide_mpy_second is
    $(WIDE_MPY) & wide_acc_mac_dst=0x9e {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_first;
    local first:2 = wide_mpy_first;
    wide_mpy_latch = first;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local result:8;
    local product:8;
    wide_mpy_result(first, wide_mpy_second, wide_mpy_kind, 1:1, 0:1, 0:4, product, result, flags);
    X1 = result(2);
  <publish>
    publish_alu_ce(flags);
}

:^wide_mpy_kind^wide_mpy_enable "A0",wide_mpy_first,wide_mpy_second is
    $(WIDE_MPY) & wide_acc_mac_dst=0x88 {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_first;
    local first:2 = wide_mpy_first;
    wide_mpy_latch = first;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local result:8;
    local product:8;
    wide_mpy_result(first, wide_mpy_second, wide_mpy_kind, 0:1, 0:1, 0:4, product, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
  <publish>
    publish_alu_ce(flags);
}

:^wide_mpy_kind^wide_mpy_enable "*R0++",wide_mpy_first,wide_mpy_second is
    $(WIDE_MPY) & wide_acc_mac_dst=0x48 {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_first;
    local address:2 = R0;
    modify_ptr(R0, 0:2, RM0, RL0, 0, 2);
    local first:2 = wide_mpy_first;
    wide_mpy_latch = first;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local result:8;
    local product:8;
    local shift:4 = zext((ECFG >> 5) & 1);
    wide_mpy_result(first, wide_mpy_second, wide_mpy_kind, 0:1, 1:1, shift, product, result, flags);
    result = (result >> shift) | (result & 0x8000000000);
    compact_pair_fft(product, result, (wide_mpy_kind & 3) == 3, flags);
    compact_pair_long_store(address, result);
  <publish>
    publish_alu_ce(flags);
}

# Keep the additional physical input routes separate from the older bit-0-set mux.
wide_mpy_routed_inputs: "RN5,*R4--" is wide_acc_mac_op=0x30 & wide_0_0=0
    & wide_acc_mac_first=0x6d & wide_40_45=0x1c {
    local address:2 = R4;
    modify_ptr(R4, 0:2, RM4, RL4, 8, 3);
    local first:2 = RN5;
    local second:2 = *[data]:2 address;
    X1 = first;
    local inputs:4 = (zext(first) << 16) | zext(second);
    export inputs;
}
wide_mpy_routed_inputs: "A1L,A2L" is wide_acc_mac_op=0x33 & wide_0_0=1
    & wide_acc_mac_first=0x51 & wide_40_45=0x12 & wide_acc_mac_dst=0x3a {
    local inputs:4 = (zext(A1L) << 16) | zext(A2L);
    export inputs;
}
wide_mpy_routed_inputs: "*0xffff,RM0" is wide_acc_mac_op=0x30 & wide_0_0=1
    & wide_acc_mac_first=0x4f & wide_40_45=0x32 & (wide_acc_mac_dst=0x99 | wide_acc_mac_dst=0xe0) {
    local address:2 = 0xffff;
    local first:2 = *[data]:2 address;
    X1 = first;
    local inputs:4 = (zext(first) << 16) | zext(RM0);
    export inputs;
}
wide_mpy_routed_inputs: "FF1,RM0" is wide_acc_mac_op=0x30 & wide_0_0=1
    & wide_acc_mac_first=0x56 & wide_40_45=0x32 & wide_acc_mac_dst=0x88 {
    X1 = FF1;
    local inputs:4 = (zext(FF1) << 16) | zext(RM0);
    export inputs;
}
wide_mpy_routed_inputs: "A0L,RM0" is wide_acc_mac_op=0x30 & wide_0_0=1
    & wide_acc_mac_first=0x50 & wide_40_45=0x32 & wide_acc_mac_dst=0x88 {
    local inputs:4 = (zext(A0L) << 16) | zext(RM0);
    export inputs;
}
wide_mpy_routed_inputs: "A2L,#"^wide_acc_mac_absolute is wide_acc_mac_op=0x30 & wide_0_0=1
    & wide_acc_mac_first=0x52 & wide_40_45=0x0f & wide_acc_mac_dst=0x88 & wide_acc_mac_absolute {
    local literal:2 = wide_acc_mac_absolute;
    local inputs:4 = (zext(A2L) << 16) | zext(literal);
    export inputs;
}
wide_mpy_routed_inputs: "square #"^wide_acc_mac_absolute is wide_acc_mac_op=0x30 & wide_0_0=1
    & wide_acc_mac_first=0x46 & wide_40_45=0x0f & wide_acc_mac_dst=0x88 & wide_acc_mac_absolute {
    local literal:2 = wide_acc_mac_absolute;
    local inputs:4 = zext(literal) * 0x10001;
    export inputs;
}

wide_mpy_routed_word: "FF1" is wide_acc_mac_dst=0x96 { export FF1; }
wide_mpy_routed_word: "A1H" is wide_acc_mac_dst=0x99 & wide_0_0=1 { export A1H; }

@define WIDE_MPY_ROUTED "wide_right_mode=1 & wide_mpy_kind & wide_mpy_enable & wide_mpy_routed_inputs"

macro wide_mpy_routed_product(inputs, kind, narrow, store, product, result, flags) {
    local first:2 = inputs(2);
    local second:2 = inputs:2;
    wide_mpy_result(first, second, kind, narrow, store, 0:4, product, result, flags);
}

:^wide_mpy_kind^wide_mpy_enable "discard",wide_mpy_routed_inputs is
    $(WIDE_MPY_ROUTED) & wide_acc_mac_dst=0xe0 {
    build wide_mpy_enable;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_routed_inputs;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:^wide_mpy_kind^wide_mpy_enable wide_mpy_routed_word,wide_mpy_routed_inputs is
    $(WIDE_MPY_ROUTED) & wide_mpy_routed_word {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_routed_inputs;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local product:8;
    local result:8;
    wide_mpy_routed_product(wide_mpy_routed_inputs, wide_mpy_kind, 1:1, 0:1, product, result, flags);
    wide_mpy_routed_word = result(2);
  <publish>
    publish_alu_ce(flags);
}

:^wide_mpy_kind^wide_mpy_enable "A0",wide_mpy_routed_inputs is
    $(WIDE_MPY_ROUTED) & wide_acc_mac_dst=0x88 &
    ((wide_0_0=0 & wide_acc_mac_first=0x6d & wide_40_45=0x1c) |
     (wide_0_0=1 & wide_40_45=0x32 & (wide_acc_mac_first=0x50 | wide_acc_mac_first=0x56)) |
     (wide_0_0=1 & wide_40_45=0x0f & (wide_acc_mac_first=0x46 | wide_acc_mac_first=0x52))) {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_routed_inputs;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local product:8;
    local result:8;
    wide_mpy_routed_product(wide_mpy_routed_inputs, wide_mpy_kind, 0:1, 0:1, product, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
  <publish>
    publish_alu_ce(flags);
}

wide_mpy_absolute: "*"^wide_acc_mac_absolute is wide_acc_mac_dst=0x3a & wide_acc_mac_absolute {
    export 0:1;
}
wide_mpy_absolute: "long *"^wide_acc_mac_absolute is wide_acc_mac_dst=0x7a & wide_acc_mac_absolute {
    export 1:1;
}

:^wide_mpy_kind^wide_mpy_enable wide_mpy_absolute,wide_mpy_routed_inputs is
    $(WIDE_MPY_ROUTED) & wide_mpy_absolute & wide_acc_mac_absolute {
    build wide_mpy_enable;
    local flags:2 = EST & 0xcfff;
    if (wide_mpy_enable == 0) goto <publish>;
    build wide_mpy_routed_inputs;
    if ((wide_mpy_enable & 1) == 0) goto <publish>;
    local result:8;
    local product:8;
    local narrow:1 = 1 - wide_mpy_absolute;
    wide_mpy_routed_product(wide_mpy_routed_inputs, wide_mpy_kind, narrow, 1:1, product, result, flags);
    local address:2 = wide_acc_mac_absolute;
    local shift:4 = zext((ECFG >> 5) & 1);
    result = (result >> shift) | (result & 0x8000000000);
    if (narrow != 0) goto <word>;
    compact_pair_fft(product, result, (wide_mpy_kind & 3) == 3, flags);
    compact_pair_long_store(address, result);
    goto <publish>;
  <word>
    *[data]:2 address = result(2);
  <publish>
    publish_alu_ce(flags);
}

# The guard and control ports use the upper word of the same scaled product,
# but align their addends differently. Neither port drives arithmetic flags.
macro wide_mac_guard_result(guard, product, alignment) {
    local sum:8 = (zext(guard) << alignment) + product;
    guard = sum(2);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_mac_control_result(destination, delta) {
    # The addend is already aligned to the high word. The control port
    # discards the guard instead of applying ECFG.ALIM.
    local update:8 = delta;
    destination = destination + update(2);
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_ACC_MAC "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1"
@define WIDE_ACC_MAC_A01 "$(WIDE_ACC_MAC) & wide_acc_mac_first=0x50 & wide_0_0=1 & wide_40_45=0x11"
@define WIDE_ACC_MAC_A01_WORD "$(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x28"

macro wide_mac_fallback_word(product, subtract, rounded, limit_product) {
    local address:2 = 0xffff;
    local word:2 = *[data]:2 address;
    local base:8 = ((zext(word) ^ 0x8000) - 0x8000) * (1 + 0xffff * zext(ECFG & 1));
    local term:8 = product ^ (0 - subtract);
    local exact:8 = base + term + subtract;
    local adder:8 = (base & 0xffffffffff) + (term & 0xffffffffff) + subtract;
    local shift:4 = zext((ECFG >> 5) & 1);
    if (rounded == 0) goto <round_done>;
    # This port rounds ties upward regardless of R. SR1 moves the rounding
    # boundary from bit 16 to bit 17, not just the final extraction.
    local quantum:8 = 0x10000 << shift;
    local bias:8 = quantum >> 1;
    exact = (exact + bias) & -quantum;
    adder = adder + bias;
  <round_done>
    local result:8;
    local flags:2;
    raw_mac_finish_limit(exact, adder, 1:1, 1:1, 1:1, limit_product, result, flags);
    local stored:8 = result >> (16 + shift);
    *[data]:2 address = stored:2;
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:MAC "RMW2","A0L","A1L" is $(WIDE_ACC_MAC_A01_WORD) & wide_acc_mac_dst=0x8e {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    # The full lane reads a hardwired 40-bit -1 and only drives status.
    local result:8;
    local flags:2;
    raw_mac_add(-1:8, product, 0:8, 0:1, 0:1, result, flags);
    publish_alu_ce((EST & 0xcfc4) | flags);
}
:MAC "*0xffff","A0L","A1L" is $(WIDE_ACC_MAC_A01_WORD) & wide_acc_mac_dst=0x8f {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_fallback_word(product, 0:8, 0:1, 1:1);
}
:MACSU "*0xffff","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x29 & wide_acc_mac_dst=0x8f {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 0:1, product);
    wide_mac_fallback_word(product, 0:8, 0:1, 0:1);
}
:MSU "*0xffff","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x2c & wide_acc_mac_dst=0x8f {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_fallback_word(product, 1:8, 0:1, 1:1);
}
:MACR "*0xffff","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x20 & wide_acc_mac_dst=0x8f {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_fallback_word(product, 0:8, 1:1, 1:1);
}

@define WIDE_MSU_FF1_R5 "$(WIDE_ACC_MAC) & wide_acc_mac_op=0x2c & wide_acc_mac_first=0x7e & wide_0_0=0 & wide_40_45=0x15"

macro wide_msu_ff1_r5(product) {
    local address:2 = R5;
    modify_ptr(R5, 0:2, RM4, RL4, 10, 2);
    local left:2 = FF1;
    local right:2 = *[data]:2 address;
    X1 = left;
    raw_mac_product(left, right, 1:1, 1:1, product);
}

macro wide_msu_mux_result(base, product, short_result, result, flags) {
    local raw:8 = (base & 0xffffffffff) + (~product & 0xffffffffff) + 1;
    raw_mac_finish(base - product, raw, short_result, short_result, 0:1, result, flags);
}

:MSU "A5","FF1","*R5++" is $(WIDE_MSU_FF1_R5) & wide_acc_mac_dst=0x8d {
    local product:8;
    wide_msu_ff1_r5(product);
    local old:8;
    compact_long_sample(A5L, A5H, GB5, old);
    local base:8 = (old ^ 0x8000000000) - 0x8000000000;
    local result:8;
    local flags:2;
    wide_msu_mux_result(base, product, 0:1, result, flags);
    A5L = result:2;
    A5H = result(2);
    GB5 = result(4);
    publish_alu_ce((EST & 0xcfc4) | flags);
}
:MSU "RMW2","FF1","*R5++" is $(WIDE_MSU_FF1_R5) & wide_acc_mac_dst=0x8e {
    local product:8;
    wide_msu_ff1_r5(product);
    local result:8;
    local flags:2;
    wide_msu_mux_result(-1:8, product, 0:1, result, flags);
    publish_alu_ce((EST & 0xcfc4) | flags);
}
:MSU "*0xffff","FF1","*R5++" is $(WIDE_MSU_FF1_R5) & wide_acc_mac_dst=0x8f {
    local product:8;
    wide_msu_ff1_r5(product);
    wide_mac_fallback_word(product, 1:8, 0:1, 1:1);
}
:MSU "A0L","FF1","*R5++" is $(WIDE_MSU_FF1_R5) & wide_acc_mac_dst=0x90 {
    local product:8;
    wide_msu_ff1_r5(product);
    local base:8 = sext(A0L) * (1 + 0xffff * zext(ECFG & 1));
    local result:8;
    local flags:2;
    wide_msu_mux_result(base, product, 1:1, result, flags);
    A0L = result(2);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:MACH "GB3","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x27 & wide_acc_mac_dst=0x83 {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_guard_result(GB3, product, 0:4);
}
:MAC "GB3","A0L","A1L" is $(WIDE_ACC_MAC_A01_WORD) & wide_acc_mac_dst=0x83 {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_guard_result(GB3, product, 16:4);
}
:MACUU "GB3","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x2b & wide_acc_mac_dst=0x83 {
    local product:8;
    raw_mac_product(A0L, A1L, 0:1, 0:1, product);
    wide_mac_guard_result(GB3, product, 16:4);
}
:MACH "GB5","R5","*R0--" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x27 & wide_acc_mac_dst=0x85 & wide_acc_mac_first=0x65 & wide_0_0=0 & wide_40_45=0x18 {
    local left:2 = R5;
    local address:2 = R0;
    modify_ptr(R0, 0:2, RM0, RL0, 0, 3);
    local right:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    X1 = left;
    wide_mac_guard_result(GB5, product, 0:4);
}
:MACH "GB3","OP3","MINMAX" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x27 & wide_acc_mac_dst=0x83 & wide_acc_mac_first=0x4e & wide_0_0=1 & wide_40_45=0x3a {
    local operand:2 = MINMAX;
    local product:8;
    raw_mac_product(operand, operand, 1:1, 1:1, product);
    X1 = operand;
    wide_mac_guard_result(GB3, product, 0:4);
}

wide_acc_mac_control: "RL2" is wide_acc_mac_dst=0xb1 { export RL2; }
wide_acc_mac_control: "FF1" is wide_acc_mac_dst=0xbe { export FF1; }
wide_acc_mac_control: "X1" is wide_acc_mac_dst=0x9e { export X1; }
wide_acc_mac_control: "CECFG1" is wide_acc_mac_dst=0xc2 { export CECFG1; }
wide_acc_mac_control: "PACFG" is wide_acc_mac_dst=0xda { export PACFG; }
:MAC wide_acc_mac_control,"A0L","A1L" is $(WIDE_ACC_MAC_A01_WORD) & wide_acc_mac_control {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_control_result(wide_acc_mac_control, product);
}
:MSUUS "ECFG","*R3+=RN3","RM0" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x2e & wide_acc_mac_dst=0xc0 & wide_acc_mac_first=0x0b & wide_0_0=1 & wide_40_45=0x32 {
    local address:2 = R3;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
    local left:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, RM0, 0:1, 1:1, product);
    X1 = left;
    wide_mac_control_result(ECFG, -product);
}
:MACR "RL2","*R6+"^wide_acc_mac_displacement,"R7" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x20 & wide_acc_mac_dst=0xb1 & wide_acc_mac_first=0x26 & wide_0_0=1 & wide_40_45=0x27 & wide_acc_mac_displacement {
    local address:2 = R6 + wide_acc_mac_displacement;
    local left:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, R7, 1:1, 1:1, product);
    X1 = left;
    wide_mac_control_result(RL2, product + 0x8000);
}
:MACUS "RL2","*"^wide_acc_mac_absolute,"RN1" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x2a & wide_acc_mac_dst=0xb1 & wide_acc_mac_first=0x3e & wide_0_0=1 & wide_40_45=0x29 & wide_acc_mac_absolute {
    local address:2 = wide_acc_mac_absolute;
    local left:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, RN1, 0:1, 1:1, product);
    X1 = left;
    wide_mac_control_result(RL2, product);
}

:MSU "INTBASE","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2cd6f8 & wide_40_45=3 {
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local addend:8;
    raw_mac_word(INTBASE, addend);
    local raw:8 = (addend & 0xffffffffff) + (~product & 0xffffffffff) + 1;
    local result:8;
    local flags:2;
    raw_mac_finish(addend - product, raw, 1:1, 0:1, 0:1, result, flags);
    X1 = left;
    INTBASE = result(2);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_msu_control_word(dst, lhs, rhs) {
    local product:8;
    raw_mac_product(lhs, rhs, 1:1, 1:1, product);
    local base:8;
    raw_mac_word(dst, base);
    local difference:8 = base - product;
    wide_control_word(difference, dst);
    publish_alu_ce(EST & 0xcfff);
}

:MSU "USER_IO","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2cd7f8 & wide_40_45=3 {
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    X1 = left;
    wide_msu_control_word(USER_IO, left, right);
}
:MSU "LC","A0L","A1L" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2cd4a1 & wide_40_45=0x11 {
    wide_msu_control_word(LC1, A0L, A1L);
}

macro wide_msu_word(old, left, right, store, result) {
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local base:8 = sext(old) * (1 + zext(ECFG & 1) * 0xffff);
    local raw:8 = (base & 0xffffffffff) + (~product & 0xffffffffff) + 1;
    local bits:8;
    local active:2;
    raw_mac_finish(base - product, raw, 1:1, 1:1, store, bits, active);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
    result = bits;
}

:MSU "A0L","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2c90f8 & wide_40_45=3 {
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    X1 = left;
    local result:8;
    wide_msu_word(A0L, left, right, 0:1, result);
    A0L = result(2);
}
:MSU "*R4","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2c04f8 & wide_40_45=3 {
    local destination:2 = R4;
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    local old:2 = *[data]:2 destination;
    X1 = left;
    local result:8;
    wide_msu_word(old, left, right, 1:1, result);
    result = result >> ((ECFG >> 5) & 1);
    *[data]:2 destination = result(2);
}

macro raw_mac_predicate(cfg, bank, enabled, addresses) {
    unary_ce(cfg, EST, CETBL, bank, enabled);
    addresses = enabled | ((cfg >> 12) & 1);
}

# These MAC ports use the high word without ALU limiting or arithmetic flags.
macro mac_r3_post_r0(left, right) {
    left = R3;
    local address:2 = R0;
    modify_ptr(R0, 1:2, RM0, RL0, 0, 2);
    right = *[data]:2 address;
    X1 = left;
}

macro mac_high_control(base, left, right, subtract, signed_left, signed_right, bias, word) {
    local product:8;
    raw_mac_product(left, right, signed_left, signed_right, product);
    local bits:8 = base + product + bias;
    if (subtract == 0) goto <publish>;
    bits = base - product;
  <publish>
    word = bits(2);
    publish_alu_ce(EST & 0xcfff);
}

macro mac_r3_post_r0_control(base, signed_left, signed_right, bias, word) {
    local left:2;
    local right:2;
    mac_r3_post_r0(left, right);
    mac_high_control(base, left, right, 0:1, signed_left, signed_right, bias, word);
}

@define WIDE_MAC_CONTROL "$(WIDE_ROUTED_ALU) & wide_mac_prefix=0"
@define WIDE_MAC_R3_R0 "$(WIDE_MAC_CONTROL) & wide_40_45=0x10"
:MACHUS "LSA1","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x23d2c6 {
    local base:8 = zext(LSA1W >> 16 & 0xff);
    local word:2;
    mac_r3_post_r0_control(base, 0:1, 1:1, 0:8, word);
    LSA1W = (LSA1W & 0xffff0000) | zext(word);
}
:MACSU "LEA1","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x29d3c6 {
    local base:8 = zext(LEA1W & 0xffffff);
    local word:2;
    mac_r3_post_r0_control(base, 1:1, 0:1, 0:8, word);
    LEA1W = (LEA1W & 0xffff0000) | zext(word);
}
:MACR "LC","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x20d4c6 {
    local base:8;
    raw_mac_word(LC1, base);
    mac_r3_post_r0_control(base, 1:1, 1:1, 0x8000:8, LC1);
}
macro refresh_selected_loop() {
    if (LOOP_FRAME == 2) goto <bank2>;
    if (LOOP_FRAME == 3) goto <bank3>;
    if (LOOP_FRAME == 4) goto <bank4>;
    refresh_live_loop(LC1, LSA1W, LEA1W);
    goto <done>;
  <bank2>
    refresh_live_loop(LC2, LSA2W, LEA2W);
    goto <done>;
  <bank3>
    refresh_live_loop(LC3, LSA3W, LEA3W);
    goto <done>;
  <bank4>
    refresh_live_loop(LC4, LSA4W, LEA4W);
  <done>
}

:MACUS "PSTATUS","R4","*R2+RN2" is $(WIDE_MAC_CONTROL) & wide_0_22=0x2ad5c8 & wide_40_45=0x2a {
    local left:2 = R4;
    local address:2 = R2 + RN2;
    local right:2 = *[data]:2 address;
    local base:8;
    raw_mac_word(PSTATUS, base);
    local word:2;
    X1 = left;
    mac_high_control(base, left, right, 0:1, 0:1, 1:1, 0:8, word);
    wide_logic_rmw_pstatus(word);
    refresh_selected_loop();
}
:MACHUS "INTBASE","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x23d6c6 {
    local base:8 = sext(INTBASE);
    mac_r3_post_r0_control(base, 0:1, 1:1, 0:8, INTBASE);
}
:MACHUS "USER_IO","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x23d7c6 {
    local base:8 = sext(USER_IO);
    mac_r3_post_r0_control(base, 0:1, 1:1, 0:8, USER_IO);
}
:MACSU "RM2","*R7","R0" is $(WIDE_MAC_CONTROL) & wide_0_22=0x29b30f & wide_40_45=0x20 {
    local left:2 = *[data]:2 R7;
    local base:8;
    raw_mac_word(RM2, base);
    X1 = left;
    mac_high_control(base, left, R0, 0:1, 1:1, 0:1, 0:8, RM2);
}
:MSUUU "RN7","*"^absolute_data_addr,"RL6" is $(WIDE_MAC_CONTROL) & wide_0_22=0x2faf71 & wide_40_45=0x35 & absolute_data_addr {
    local address:2 = absolute_data_addr;
    local left:2 = *[data]:2 address;
    local base:8;
    raw_mac_word(RN7, base);
    X1 = left;
    mac_high_control(base, left, RL6, 1:1, 0:1, 0:1, 0:8, RN7);
}
:MACR "FF2","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x2097c6 {
    local base:8;
    raw_mac_word(FF2, base);
    mac_r3_post_r0_control(base, 1:1, 1:1, 0x8000:8, FF2);
}

macro wide_add_r4_post(left, shift, displacement) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    if (addresses == 0) goto <veto>;
    local address:2 = R4;
    local delta:2 = sext(displacement);
    modify_ptr(R4, delta, RM4, RL4, 8, 4);
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <veto>;
    local right:8 = ((zext(word) ^ 0x8000) - 0x8000) << shift;
    local result:8;
    wide_routed_arithmetic(left, right, 0:2, 0:1, 1:1, 0:1, result);
    R4 = result(2);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

@define WIDE_ADD_R4_POST "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & logic_ce_bank=0 & wide_alias_add_op=8 & wide_alias_add_dst=0xa4 & wide_40_45=0x34 & wide_0_0=0 & wide_shift_dst_disp"
:ADD "CE1" "R4","LSA1","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd2 {
    local left:8 = zext(LSA1W & 0xffffff);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","LEA1","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd3 {
    local left:8 = zext(LEA1W & 0xffffff);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","LC","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd4 {
    local left:8;
    raw_mac_word(LC1, left);
    wide_add_r4_post(left, 16:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","PSTATUS","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd5 {
    local left:8 = sext(PSTATUS);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","USER_IO","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd7 {
    local left:8 = sext(USER_IO);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}

@define RAW_MAC_SEQ "((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0))"
@define RAW_MAC_PAR "carmel_issue=1 & slot_mode=0"
@define RAW_MAC_A4_SHIFT "slot_16_22=0x52 & slot_14_15=0 & slot_11_13=4 & slot_6_10=15 & slot_1_5=31 & slot_0_0=0"
@define RAW_MAC_A4_ROUND "slot_16_22=0x51 & slot_14_15=0 & slot_11_13=4 & slot_6_10=10 & slot_1_5=31 & slot_0_0=1"
@define RAW_MAC_A3_ROUND "slot_16_22=0x51 & slot_13_15=5 & slot_9_11=3 & slot_6_8=2 & slot_1_5=8 & slot_0_0=1"

:MACSU "A4","*R7+=RN7","OP2" is $(RAW_MAC_SEQ) & $(RAW_MAC_A4_SHIFT) {
    local address:2 = R7;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    X1 = *[data]:2 address;
    # The OP2 input is disconnected. The signed addend enters at bit 16.
    local exact:8 = ((zext(GB4) ^ 0x80) - 0x80) * 0x10000 + zext(A4H);
    local result:8;
    local active:2;
    raw_mac_finish(exact, 0:8, 0:1, 0:1, 0:1, result, active);
    A4L = result:2;
    A4H = result(2);
    GB4 = result(4);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:ADD "A0","*R4++","A3" is $(RAW_MAC_SEQ) & slot_16_22=0x13 & slot_12_14=1 & slot_9_11=0 & slot_4_8=12 & slot_1_3=3 & slot_15_15=0 & slot_0_0=0 {
    local address:2 = R4;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local word:2 = *[data]:2 address;
    local base:8;
    compact_long_sample(A3L, A3H, GB3, base);
    local result:8;
    local active:2;
    raw_mac_add((zext(word) ^ 0x8000) - 0x8000, (base ^ 0x8000000000) - 0x8000000000, 0:8, 0:1, 0:1, result, active);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:MSUR "CE1" "A4","*R2+=RN2","OP2" is $(RAW_MAC_SEQ) & $(RAW_MAC_A4_ROUND) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local address:2 = R2;
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
    local word:2 = *[data]:2 address;
    X1 = word;
    if (enabled == 0) goto <publish>;
    local base:8;
    compact_long_sample(A4L, A4H, GB4, base);
    local result:8;
    local active:2;
    raw_mac_round_sub(base, word, 0:2, result, active);
    A4L = result:2;
    A4H = result(2);
    GB4 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MSUR "CE1" "A3","*R2+RN2","RN0" is $(RAW_MAC_SEQ) & $(RAW_MAC_A3_ROUND) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local address:2 = R2 + RN2;
    local word:2 = *[data]:2 address;
    X1 = word;
    if (enabled == 0) goto <publish>;
    local base:8;
    compact_long_sample(A3L, A3H, GB3, base);
    local result:8;
    local active:2;
    raw_mac_round_sub(base, word, RN0, result, active);
    A3L = result:2;
    A3H = result(2);
    GB3 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MPY "X2","*R1","*R0+=RN0" is $(RAW_MAC_SEQ) & slot_16_22=0x43 & slot_15_15=0 & slot_11_14=15 & slot_6_10=1 & slot_1_5=8 & slot_0_0=0 {
    local first_address:2 = R1;
    local second_address:2 = R0;
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    local product:8;
    raw_mac_product(first, second, 1:1, 1:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, result, active);
    X1 = first;
    X2 = result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:ADDC "CE1" "*R2","R4","*R4++" is $(RAW_MAC_SEQ) & slot_16_22=0x14 & slot_15_15=0 & slot_11_14=2 & slot_6_10=4 & slot_1_5=20 & slot_0_0=1 {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local old_r4:2 = R4;
    local destination:2 = R2;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local word:2 = *[data]:2 old_r4;
    if (enabled == 0) goto <publish>;
    local a:8;
    local b:8;
    raw_mac_word(old_r4, a);
    raw_mac_word(word, b);
    local result:8;
    local active:2;
    raw_mac_add(a, b, zext(EST & 1) << 16, 1:1, 1:1, result, active);
    *[data]:2 destination = result(2);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MSUR "A3","*R4++","*R6+RN6" "||" "MSUUS" "CE2" "FF12","*R7+=RN7","A0L" is ($(RAW_MAC_PAR) & slot_16_22=0x51 & slot_13_15=4 & slot_9_11=3 & slot_4_8=20 & slot_1_3=6 & slot_0_0=0); (slot_mode=0 & slot_16_22=0x5e & slot_14_15=0 & slot_11_13=6 & slot_6_10=15 & slot_1_5=16 & slot_0_0=1) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG2, 1, enabled, addresses);
    local first_address:2 = R4;
    local second_address:2 = R6 + RN6;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    local base:8;
    compact_long_sample(A3L, A3H, GB3, base);
    local left_result:8;
    local left_flags:2;
    raw_mac_round_sub(base, first, second, left_result, left_flags);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    X1 = first;
    A3L = left_result:2;
    A3H = left_result(2);
    GB3 = left_result(4);
    if (addresses == 0) goto <publish>;
    local right_address:2 = R7;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    local word:2 = *[data]:2 right_address;
    X2 = word;
    if (enabled == 0) goto <publish>;
    local product:8;
    raw_mac_product(word, A0L, 0:1, 1:1, product);
    local pair:8 = (zext(FF2) << 16) | zext(FF1);
    local right_result:8;
    local right_flags:2;
    raw_mac_finish(pair - product, pair + (~product & 0xffffffffff) + 1, 0:1, 0:1, 0:1, right_result, right_flags);
    FF1 = right_result:2;
    FF2 = right_result(2);
    raw_mac_flags(flags, right_flags, 6);
  <publish>
    publish_alu_ce(flags);
}

:ADDC "X2","A4L","*R6--" is $(RAW_MAC_SEQ) & slot_16_22=0x14 & slot_15_15=1 & slot_11_14=15 & slot_6_10=20 & slot_1_5=30 & slot_0_0=0 {
    local address:2 = R6;
    modify_ptr(R6, RN6, RM6, RL6, 12, 3);
    local word:2 = *[data]:2 address;
    local a:8;
    local b:8;
    raw_mac_word(A4L, a);
    raw_mac_word(word, b);
    local result:8;
    local active:2;
    raw_mac_add(a, b, zext(EST & 1) << 16, 1:1, 0:1, result, active);
    X2 = result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:MPYUS "CE1" "A5","R2","A0L" is $(RAW_MAC_SEQ) & slot_16_22=0x49 & slot_13_15=3 & slot_9_11=5 & slot_4_8=2 & slot_1_3=0 & slot_0_0=1 {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local first:2 = R2;
    X1 = first;
    if (enabled == 0) goto <publish>;
    local product:8;
    raw_mac_product(first, A0L, 0:1, 1:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 0:1, 0:1, 0:1, result, active);
    A5L = result:2;
    A5H = result(2);
    GB5 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MPYUS "discard","FF2","*R4--" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=0x1c & wide_0_22=0x32fdae {
    local address:2 = R4;
    modify_ptr(R4, RN4, RM4, RL4, 8, 3);
    local word:2 = *[data]:2 address;
    X1 = FF2;
    publish_alu_ce(EST & 0xcfff);
}

:MPYUU "A1H","R2","A0L" "||" "ADDABS" "CE2" "X2","RN6","*R7+RN7" is ($(RAW_MAC_PAR) & slot_16_22=0x4e & slot_13_15=6 & slot_9_12=9 & slot_4_8=2 & slot_1_3=0 & slot_0_0=0); (slot_mode=0 & slot_16_22=0x1f & slot_13_15=3 & slot_9_12=14 & slot_4_8=14 & slot_1_3=7 & slot_0_0=1) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG2, 1, enabled, addresses);
    local first:2 = R2;
    local product:8;
    raw_mac_product(first, A0L, 0:1, 0:1, product);
    local left_result:8;
    local left_flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, left_result, left_flags);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    X1 = first;
    A1H = left_result(2);
    if (addresses == 0) goto <publish>;
    local address:2 = R7 + RN7;
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <publish>;
    local a:8;
    local b:8;
    raw_mac_word(RN6, a);
    raw_mac_word(word, b);
    if (a s>= 0) goto <absolute>;
    a = -a;
  <absolute>
    local right_result:8;
    local right_flags:2;
    raw_mac_add(a, b, 0:8, 1:1, 0:1, right_result, right_flags);
    X2 = right_result(2);
    raw_mac_flags(flags, right_flags, 6);
  <publish>
    publish_alu_ce(flags);
}

:ADD "*R1+=RN1","*R7+=RN7","*R5" "||" "MPYUS" "X2","*R4+RN4","*R2--" is ($(RAW_MAC_PAR) & slot_16_22=0x11 & slot_14_15=1 & slot_9_13=29 & slot_4_8=14 & slot_1_3=1 & slot_0_0=0); (slot_mode=0 & slot_16_22=0x4b & slot_13_15=4 & slot_9_12=14 & slot_6_8=4 & slot_1_5=26 & slot_0_0=0) {
    local destination:2 = R1;
    local left_first:2 = R7;
    local left_second:2 = R5;
    local right_first:2 = R4 + RN4;
    local right_second:2 = R2;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    modify_ptr(R2, RN2, RM2, RL2, 4, 3);
    local term1:2 = *[data]:2 left_first;
    local term2:2 = *[data]:2 left_second;
    local multiplier:2 = *[data]:2 right_first;
    local multiplicand:2 = *[data]:2 right_second;
    local a:8;
    local b:8;
    raw_mac_word(term1, a);
    raw_mac_word(term2, b);
    local left_result:8;
    local left_flags:2;
    raw_mac_add(a, b, 0:8, 1:1, 1:1, left_result, left_flags);
    local product:8;
    raw_mac_product(multiplier, multiplicand, 0:1, 1:1, product);
    local right_result:8;
    local right_flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, right_result, right_flags);
    # The multiplier consumes its fetched input, not the incoming X2.
    # The word result then supersedes that OF latch in WB.
    X2 = right_result(2);
    *[data]:2 destination = left_result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    raw_mac_flags(flags, right_flags, 6);
    publish_alu_ce(flags);
}

:^nop_left "||" "MPYUU" "X2","R2","A0L" is ($(RAW_MAC_PAR) & nop_left); (slot_mode=0 & slot_16_22=0x4e & slot_13_15=6 & slot_9_12=15 & slot_4_8=2 & slot_1_3=0 & slot_0_0=0) {
    local product:8;
    raw_mac_product(R2, A0L, 0:1, 0:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, result, active);
    X2 = result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 6);
    publish_alu_ce(flags);
}

attach variables [compact_minmu_dst compact_minmu_src]
    [A0L A1L A2L A3L A4L A5L _ _ A0H A1H A2H A3H A4H A5H _ _];
attach variables [compact_minmu_base] [R0 R1 R2 R3 R4 R5 R6 R7];
attach variables [compact_minmu_step] [RN0 RN1 RN2 RN3 RN4 RN5 RN6 RN7];
attach variables [compact_minmu_mod] [RM0 RM0 RM2 RM2 RM4 RM4 RM6 RM6];
attach variables [compact_minmu_bound] [RL0 RL0 RL2 RL2 RL4 RL4 RL6 RL6];
attach values [compact_minmu_shift] [0 2 4 6 8 10 12 14];

attach variables [minmax_dst_acc minmax_src_acc] [A0 A1 A2 A3 A4 A5 _ _];
attach variables [minmax_dst_lo minmax_src_lo] [A0L A1L A2L A3L A4L A5L _ _];
attach variables [minmax_dst_hi minmax_src_hi] [A0H A1H A2H A3H A4H A5H _ _];
attach variables [minmax_dst_guard minmax_src_guard] [GB0 GB1 GB2 GB3 GB4 GB5 _ _];
attach variables [minmax_dst_word minmax_src_word] [A0L A1L A2L A3L A4L A5L FF1 FF2 A0H A1H A2H A3H A4H A5H X1 X2];
attach variables [minmax_ref_base_lo] [R0 R1 R2 R3];
attach variables [minmax_ref_base_hi] [R4 R5 R6 R7];
attach variables [minmax_ref_mod_lo] [RM0 RM0 RM2 RM2];
attach variables [minmax_ref_mod_hi] [RM4 RM4 RM6 RM6];
attach variables [minmax_ref_bound_lo] [RL0 RL0 RL2 RL2];
attach variables [minmax_ref_bound_hi] [RL4 RL4 RL6 RL6];
attach values [minmax_ref_shift_lo] [0 2 4 6];
attach values [minmax_ref_shift_hi] [8 10 12 14];
attach variables [minmax_ref_guard_lo] [GB0 GB1 GB2 GB3];
attach variables [minmax_ref_guard_hi] [GB4 GB5 _ _];
attach variables [minmax_store_dst_word minmax_pair_dst_word minmax_pair_rhs_word]
    [A0L A1L A2L A3L A4L A5L FF1 FF2 A0H A1H A2H A3H A4H A5H X1 X2];
attach variables [minmax_pair_dst_ptr minmax_pair_rhs_ptr] [R0 R1 R2 R3 R4 R5 R6 R7 RN0 RN1 RN2 RN3 RN4 RN5 RN6 RN7];
attach variables [minmax_pair_trace] [BTR1 BTR2];
attach variables [minmax_pair_rhs_acc] [A0 A1 A2 A3 A4 A5 _ _];
attach variables [minmax_pair_rhs_acc_lo minmax_rhs_lo] [A0L A1L A2L A3L A4L A5L _ _];
attach variables [minmax_pair_rhs_acc_hi minmax_rhs_hi] [A0H A1H A2H A3H A4H A5H _ _];
attach variables [minmax_pair_rhs_acc_guard minmax_rhs_guard minmax_store_dst_guard] [GB0 GB1 GB2 GB3 GB4 GB5 _ _];
attach variables [minmax_store_base] [R0 R1 R2 R3 R4 R5 R6 R7];
attach variables [minmax_store_mod] [RM0 RM0 RM2 RM2 RM4 RM4 RM6 RM6];
attach variables [minmax_store_bound] [RL0 RL0 RL2 RL2 RL4 RL4 RL6 RL6];
attach values [minmax_store_shift] [0 2 4 6 8 10 12 14];
attach variables [minmax_lhs_even_guard] [GB0 GB2 GB4 _];
attach variables [minmax_lhs_odd_guard] [GB1 GB3 GB5 _];
attach variables [minmax_lhs_even_lo] [A0L A2L A4L _];
attach variables [minmax_lhs_odd_lo] [A1L A3L A5L _];
attach variables [minmax_lhs_even_hi] [A0H A2H A4H _];
attach variables [minmax_lhs_odd_hi] [A1H A3H A5H _];

minmax_predicate: is carmel_issue=5 & wide_left_mode=1 { export 3:2; }
minmax_predicate: "CE1" is carmel_issue=4 & wide_left_mode=0 & minmax_ce_bank=0 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local stages:2 = enabled | ((enabled | ((CECFG1 >> 12) & 1)) << 1);
    export stages;
}
minmax_predicate: "CE2" is carmel_issue=4 & wide_left_mode=0 & minmax_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local stages:2 = enabled | ((enabled | ((CECFG2 >> 12) & 1)) << 1);
    export stages;
}

# A DATA reference drives MINMAX from its effective address, not from the
# addressed value. Its postmodify belongs to address generation.
minmax_disp_addr: "*"^minmax_ref_base_lo^"+"^minmax_ref_disp is minmax_ref_type=0 & minmax_ref_mode=4 & minmax_ref_bank=0 & minmax_ref_base_lo & minmax_ref_disp {
    local address:2 = minmax_ref_base_lo + minmax_ref_disp;
    export address;
}
minmax_disp_addr: "*"^minmax_ref_base_hi^"+"^minmax_ref_disp is minmax_ref_type=0 & minmax_ref_mode=4 & minmax_ref_bank=1 & minmax_ref_base_hi & minmax_ref_disp {
    local address:2 = minmax_ref_base_hi + minmax_ref_disp;
    export address;
}
minmax_abs_addr: "*"^absolute_data_addr is minmax_ref_mode=7 & minmax_ref_type<2 & absolute_data_addr {
    export *[const]:2 absolute_data_addr;
}
minmax_guard_ref: minmax_ref_guard_lo is minmax_ref_type=2 & minmax_ref_mode=0 & minmax_ref_bank=0 & minmax_ref_guard_lo { export minmax_ref_guard_lo; }
minmax_guard_ref: minmax_ref_guard_hi is minmax_ref_type=2 & minmax_ref_mode=0 & minmax_ref_bank=1 & minmax_ref_index<2 & minmax_ref_guard_hi { export minmax_ref_guard_hi; }

macro minmax_ref_update(base, modulo, bound, shift, delta, address) {
    address = base;
    local next:2;
    local step:2 = delta;
    transfer_address_word(base, modulo, bound, shift, step, next);
    base = next;
}
minmax_postdisp_addr: "*"^minmax_ref_base_lo^"+="^minmax_ref_disp is minmax_ref_type=1 & minmax_ref_mode=6 & minmax_ref_bank=0 & minmax_ref_base_lo & minmax_ref_mod_lo & minmax_ref_bound_lo & minmax_ref_shift_lo & minmax_ref_disp {
    local address:2;
    minmax_ref_update(minmax_ref_base_lo, minmax_ref_mod_lo, minmax_ref_bound_lo, minmax_ref_shift_lo, minmax_ref_disp, address);
    export address;
}
minmax_postdisp_addr: "*"^minmax_ref_base_hi^"+="^minmax_ref_disp is minmax_ref_type=1 & minmax_ref_mode=6 & minmax_ref_bank=1 & minmax_ref_base_hi & minmax_ref_mod_hi & minmax_ref_bound_hi & minmax_ref_shift_hi & minmax_ref_disp {
    local address:2;
    minmax_ref_update(minmax_ref_base_hi, minmax_ref_mod_hi, minmax_ref_bound_hi, minmax_ref_shift_hi, minmax_ref_disp, address);
    export address;
}
minmax_postinc_addr: "*"^minmax_ref_base_lo^"++:long" is minmax_ref_type=1 & minmax_ref_mode=2 & minmax_ref_bank=0 & minmax_ref_base_lo & minmax_ref_mod_lo & minmax_ref_bound_lo & minmax_ref_shift_lo {
    local address:2;
    minmax_ref_update(minmax_ref_base_lo, minmax_ref_mod_lo, minmax_ref_bound_lo, minmax_ref_shift_lo, 2:2, address);
    export address;
}
minmax_postinc_addr: "*"^minmax_ref_base_hi^"++:long" is minmax_ref_type=1 & minmax_ref_mode=2 & minmax_ref_bank=1 & minmax_ref_base_hi & minmax_ref_mod_hi & minmax_ref_bound_hi & minmax_ref_shift_hi {
    local address:2;
    minmax_ref_update(minmax_ref_base_hi, minmax_ref_mod_hi, minmax_ref_bound_hi, minmax_ref_shift_hi, 2:2, address);
    export address;
}

macro minmax_upper_result(dst, left, right, better, address) {
    local selected:8 = left;
    if (!better) goto <select_upper>;
    selected = right;
    MINMAX = address;
  <select_upper>
    dst = selected(2);
}
macro minmax_unsigned_flags(left, right) {
    EST = (EST & 0xfff6) | zext(left <= right) | (zext(left == right) << 3);
}
macro minmax_signed_flags(left, right) {
    local delta:8 = right - left;
    local overflow:1 = delta s> 0x7fffffffff || delta s< -0x8000000000;
    local sticky:1 = overflow && ((ECFG & 0xc) == 0);
    local flags:2 = (zext(overflow) << 1) | (zext(sticky) << 2) |
                    (zext((delta & 0xffffffffff) == 0) << 3) | (zext((delta & 0x8000000000) != 0) << 4);
    EST = (EST & 0xffe5) | flags;
}

compact_extremum_op: "MIN" is slot_7_22=0x451f { local kind:1 = 1; export kind; }
compact_extremum_op: "MAX" is slot_7_22=0x471f { local kind:1 = 0; export kind; }
compact_extremum_op: "MINBTR" is slot_7_22=0x441f { local kind:1 = 3; export kind; }
compact_extremum_op: "MAXBTR" is slot_7_22=0x461f { local kind:1 = 2; export kind; }

macro compact_acc_extremum(lo, hi, gb, other_lo, other_hi, other_gb, kind) {
    local left:8 = sext(gb) * 0x100000000 + zext(hi) * 0x10000 + zext(lo);
    local right:8 = sext(other_gb) * 0x100000000 + zext(other_hi) * 0x10000 + zext(other_lo);
    local better:1 = ((kind & 1) != 0 && right s< left) || ((kind & 1) == 0 && left s< right);
    if ((kind & 2) == 0) goto <result>;
    BTR1 = (BTR1 + BTR1) | zext(better);
  <result>
    if (!better) goto <flags>;
    lo = other_lo;
    hi = other_hi;
    gb = other_gb;
  <flags>
    minmax_signed_flags(left, right);
    publish_alu_ce(EST & 0xcfff);
}

@define COMPACT_ACC_EXTREMUM "compact_extremum_op & slot_0_0=0 & (slot_6_6=0 | slot_5_6=2) & (slot_3_3=0 | slot_2_3=2) & cmp_full_lhs_full & cmp_full_lhs_lo & cmp_full_lhs_hi & cmp_full_lhs_guard & cmp_full_rhs_full & cmp_full_rhs_lo & cmp_full_rhs_hi & cmp_full_rhs_guard"
:compact_extremum_op cmp_full_lhs_full,cmp_full_rhs_full "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_ACC_EXTREMUM)); (slot_mode=0 & nop_right) {
    compact_acc_extremum(cmp_full_lhs_lo, cmp_full_lhs_hi, cmp_full_lhs_guard,
                         cmp_full_rhs_lo, cmp_full_rhs_hi, cmp_full_rhs_guard, compact_extremum_op);
}
:compact_extremum_op cmp_full_lhs_full,cmp_full_rhs_full is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & $(COMPACT_ACC_EXTREMUM) {
    compact_acc_extremum(cmp_full_lhs_lo, cmp_full_lhs_hi, cmp_full_lhs_guard,
                         cmp_full_rhs_lo, cmp_full_rhs_hi, cmp_full_rhs_guard, compact_extremum_op);
}

macro compact_maxm_a0l_r0() {
    local address:2 = R0;
    modify_ptr(R0, 0:2, RM0, RL0, 0, 2);
    local word:2 = *[data]:2 address;
    local left:8 = sext(A0L);
    local right:8 = sext(word);
    if (!(left s< right)) goto <status>;
    A0L = word;
    MINMAX = address;
  <status>
    minmax_signed_flags(left, right);
    publish_alu_ce(EST & 0xcfff);
}

:MAXM "A0L","*R0++" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x23d820); (slot_mode=0 & nop_right) {
    compact_maxm_a0l_r0();
}
:MAXM "A0L","*R0++" is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_22=0x23d820 {
    compact_maxm_a0l_r0();
}

compact_minmu_gate: is slot_0_0=0 { export 3:2; }
compact_minmu_gate: "CE1" is slot_0_0=1 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local stages:2 = enabled | ((enabled | ((CECFG1 >> 12) & 1)) << 1);
    export stages;
}

compact_minmu_ref: "*"^compact_minmu_base is compact_minmu_post=0 & compact_minmu_base {
    export compact_minmu_base;
}
compact_minmu_ref: "*"^compact_minmu_base^"+="^compact_minmu_step is compact_minmu_post=1
    & compact_minmu_base & compact_minmu_step & compact_minmu_mod & compact_minmu_bound & compact_minmu_shift {
    local address:2 = compact_minmu_base;
    modify_ptr_scaled_window(compact_minmu_base, compact_minmu_step, compact_minmu_mod, compact_minmu_bound,
                             compact_minmu_shift, 1:2, 1:2, 0xffff:2);
    export address;
}

compact_minmu: "MINMU" compact_minmu_gate compact_minmu_dst,compact_minmu_src,compact_minmu_ref is slot_13_22=0x126
    & (slot_9_12<6 | (slot_9_12>=8 & slot_9_12<14)) & (slot_5_8<6 | (slot_5_8>=8 & slot_5_8<14))
    & compact_minmu_dst & compact_minmu_src & compact_minmu_ref & compact_minmu_gate {
    if ((compact_minmu_gate & 2) == 0) goto <feedback>;
    build compact_minmu_ref;
    if ((compact_minmu_gate & 1) == 0) goto <feedback>;
    local left:2 = compact_minmu_dst;
    local right:2 = compact_minmu_src;
    if (left <= right) goto <flags>;
    compact_minmu_dst = right;
    MINMAX = compact_minmu_ref;
  <flags>
    minmax_unsigned_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

:^compact_minmu "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_minmu); (slot_mode=0 & nop_right) {
    build compact_minmu;
}
:^compact_minmu is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & compact_minmu {
    build compact_minmu;
}

@define WIDE_MINMAX "wide_right_mode=1 & minmax_predicate"
@define WIDE_MINMAX_GUARD "minmax_dst_group=0 & wide_8_9<3 & minmax_dst_guard"
@define WIDE_MINMAX_SPECIAL_WORD "minmax_dst_group>=2 & wide_8_9=3 & minmax_dst_word"
@define WIDE_MINMAX_SOURCE_WORD "minmax_src_group>=2 & minmax_src_word"
@define WIDE_MINMAX_SOURCE_ACC "minmax_src_group=1 & minmax_src_acc_index<6 & minmax_src_acc & minmax_src_lo & minmax_src_hi & minmax_src_guard"

:MAXMU minmax_predicate minmax_dst_guard,minmax_src_word,minmax_disp_addr is $(WIDE_MINMAX) & wide_12_22=0x4af & $(WIDE_MINMAX_GUARD) & $(WIDE_MINMAX_SOURCE_WORD) & minmax_disp_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_guard);
    local right:8 = zext(minmax_src_word);
    minmax_upper_result(minmax_dst_guard, left, right, left < right, minmax_disp_addr);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXM minmax_predicate minmax_dst_guard,minmax_src_word,minmax_abs_addr is $(WIDE_MINMAX) & wide_12_22=0x4ae & $(WIDE_MINMAX_GUARD) & $(WIDE_MINMAX_SOURCE_WORD) & minmax_ref_type=0 & minmax_abs_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_guard);
    local right:8 = sext(minmax_src_word);
    minmax_upper_result(minmax_dst_guard, left, right, left s< right, minmax_abs_addr);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXMU minmax_predicate minmax_dst_word,minmax_src_word,minmax_guard_ref is $(WIDE_MINMAX) & wide_12_22=0x4af & $(WIDE_MINMAX_SPECIAL_WORD) & $(WIDE_MINMAX_SOURCE_WORD) & minmax_guard_ref {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_word);
    local right:8 = zext(minmax_src_word);
    local address:2 = zext(minmax_guard_ref);
    minmax_upper_result(minmax_dst_word, left, right, left < right, address);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MINMU minmax_predicate minmax_dst_word,minmax_src_word,minmax_abs_addr is $(WIDE_MINMAX) & wide_12_22=0x4ad & minmax_dst_group=2 & wide_8_9<3 & minmax_dst_word & $(WIDE_MINMAX_SOURCE_WORD) & minmax_ref_type=1 & minmax_abs_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_word);
    local right:8 = zext(minmax_src_word);
    minmax_upper_result(minmax_dst_word, left, right, left > right, minmax_abs_addr);
    minmax_unsigned_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXMU minmax_predicate minmax_dst_acc,minmax_src_word,minmax_postdisp_addr is $(WIDE_MINMAX) & wide_12_22=0x4af & minmax_dst_group=1 & wide_8_9<3 & minmax_dst_acc & minmax_dst_lo & minmax_dst_hi & minmax_dst_guard & $(WIDE_MINMAX_SOURCE_WORD) & minmax_postdisp_addr {
    if ((minmax_predicate & 2) == 0) goto <feedback>;
    build minmax_postdisp_addr;
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_guard) * 0x100000000 + zext(minmax_dst_hi) * 0x10000 + zext(minmax_dst_lo);
    local right:8 = zext(minmax_src_word);
    if (left >= right) goto <compare_flags>;
    minmax_dst_lo = minmax_src_word;
    minmax_dst_hi = 0;
    minmax_dst_guard = 0;
    MINMAX = minmax_postdisp_addr;
  <compare_flags>
    minmax_unsigned_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXM minmax_predicate minmax_dst_word,minmax_src_acc,minmax_disp_addr is $(WIDE_MINMAX) & wide_12_22=0x4ae & minmax_dst_group=2 & wide_8_9<3 & minmax_dst_word & $(WIDE_MINMAX_SOURCE_ACC) & minmax_disp_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = sext(minmax_dst_word);
    local right:8 = sext(minmax_src_guard) * 0x100000000 + zext(minmax_src_hi) * 0x10000 + zext(minmax_src_lo);
    minmax_upper_result(minmax_dst_word, left, right, left s< right, minmax_disp_addr);
    minmax_signed_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXMU minmax_predicate minmax_dst_word,minmax_src_word,minmax_postinc_addr is $(WIDE_MINMAX) & wide_12_22=0x4af & minmax_dst_group=3 & wide_8_9=3 & minmax_dst_word & $(WIDE_MINMAX_SOURCE_WORD) & minmax_postinc_addr {
    if ((minmax_predicate & 2) == 0) goto <feedback>;
    build minmax_postinc_addr;
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_word);
    local right:8 = zext(minmax_src_word);
    minmax_upper_result(minmax_dst_word, left, right, left < right, minmax_postinc_addr);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

macro minmax_extend(src, unsigned_compare, extended) {
    extended = zext(src);
    if (unsigned_compare != 0) goto <minmax_extended>;
    extended = sext(src);
  <minmax_extended>
}

macro minmax_select(left, right, maximum, selected, better) {
    better = (maximum != 0 && left s< right) || (maximum == 0 && right s< left);
    selected = left;
    if (!better) goto <minmax_selected>;
    selected = right;
  <minmax_selected>
}

macro minmax_compare_flags(left, right, unsigned_compare) {
    if (unsigned_compare != 0) goto <unsigned_flags>;
    minmax_signed_flags(left, right);
    goto <compared>;
  <unsigned_flags>
    minmax_unsigned_flags(left, right);
  <compared>
}

minmax_short_op: "MINM" is wide_12_22=0x4ac { export 0:1; }
minmax_short_op: "MINMU" is wide_12_22=0x4ad { export 1:1; }
minmax_short_op: "MAXM" is wide_12_22=0x4ae { export 2:1; }
minmax_short_op: "MAXMU" is wide_12_22=0x4af { export 3:1; }

minmax_short_word: minmax_src_word is $(WIDE_MINMAX_SOURCE_WORD) & minmax_src_acc_index<6 {
    export minmax_src_word;
}
minmax_short_word: "#"^absolute_data_addr is minmax_short_src=0xf & (wide_12_22=0x4ad | wide_12_22=0x4af)
    & absolute_data_addr {
    export *[const]:2 absolute_data_addr;
}
minmax_short_word: "*0xffff" is minmax_short_src=0xf & (wide_12_22=0x4ac | wide_12_22=0x4ae) {
    local word:2 = *[data]:2 0xffff:2;
    export word;
}
macro minmax_short_ones(kind, value) {
    value = -1;
    if ((kind & 1) == 0) goto <all_ones>;
    value = 0xffffffffff;
  <all_ones>
}

minmax_short_sink_rhs: minmax_short_word is minmax_short_word & minmax_short_op {
    local value:8;
    minmax_extend(minmax_short_word, minmax_short_op & 1, value);
    export value;
}
minmax_short_sink_rhs: "#0xffffffffff" is minmax_short_src=0xe & minmax_short_op {
    local value:8;
    minmax_short_ones(minmax_short_op, value);
    export value;
}

macro minmax_short_compare(left, right, kind, selected, better) {
    minmax_select(left, right, kind & 2, selected, better);
    if (!better) goto <recorded>;
    MINMAX = PACFG;
  <recorded>
    minmax_compare_flags(left, right, kind & 1);
}

@define WIDE_MINMAX_PACFG "$(WIDE_MINMAX) & minmax_short_op & minmax_ref_type=3 & wide_40_45=0x1a"
:minmax_short_op minmax_predicate "<discard>",minmax_short_sink_rhs,"PACFG" is $(WIDE_MINMAX_PACFG)
    & minmax_short_dst=0xe & minmax_short_sink_rhs {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_short_sink_rhs;
    local left:8;
    minmax_short_ones(minmax_short_op, left);
    local selected:8;
    local better:1;
    minmax_short_compare(left, minmax_short_sink_rhs, minmax_short_op, selected, better);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_short_op minmax_predicate minmax_dst_word,minmax_short_word,"PACFG" is $(WIDE_MINMAX_PACFG)
    & minmax_short_dst>=0x10 & minmax_short_dst<0x16 & minmax_dst_word & minmax_short_word {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_short_word;
    local left:8;
    local right:8;
    minmax_extend(minmax_dst_word, minmax_short_op & 1, left);
    minmax_extend(minmax_short_word, minmax_short_op & 1, right);
    local selected:8;
    local better:1;
    minmax_short_compare(left, right, minmax_short_op, selected, better);
    if (!better) goto <feedback>;
    minmax_dst_word = selected:2;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_short_op minmax_predicate "*0xffff",minmax_short_word,"PACFG" is $(WIDE_MINMAX_PACFG)
    & minmax_short_dst=0xf & (minmax_short_src!=0xf | wide_12_22=0x4ad | wide_12_22=0x4af) & minmax_short_word {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_short_word;
    local word:2 = *[data]:2 0xffff:2;
    local left:8;
    local right:8;
    minmax_extend(word, minmax_short_op & 1, left);
    minmax_extend(minmax_short_word, minmax_short_op & 1, right);
    local selected:8;
    local better:1;
    minmax_short_compare(left, right, minmax_short_op, selected, better);
    *[data]:2 0xffff:2 = selected:2;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_short_op minmax_predicate "*0xffff","*0xffff","PACFG" is $(WIDE_MINMAX_PACFG)
    & minmax_short_dst=0xf & minmax_short_src=0xf & (wide_12_22=0x4ac | wide_12_22=0x4ae) {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local word:2 = *[data]:2 0xffff:2;
    *[data]:2 0xffff:2 = word;
    EST = (EST & 0xffe5) | 8;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
@undef WIDE_MINMAX_PACFG

minmax_pair_op: "MINBTR1" is minmax_pair_variant=0 { export 0:1; }
minmax_pair_op: "MINUBTR1" is minmax_pair_variant=1 { export 1:1; }
minmax_pair_op: "MAXUBTR2" is minmax_pair_variant=15 { export 3:1; }

minmax_pair_word: minmax_pair_rhs_word is minmax_ref_type=2 & minmax_pair_rhs_group=1 & minmax_pair_rhs_word { export minmax_pair_rhs_word; }
minmax_pair_word: minmax_pair_rhs_ptr is minmax_ref_type=2 & minmax_pair_rhs_group=2 & minmax_pair_rhs_ptr { export minmax_pair_rhs_ptr; }

# These control inputs compare as words but drive the extended result lane.
minmax_pair_control: "PSTATUS" is minmax_ref_type=3 & wide_40_45=0x15 { export PSTATUS; }
minmax_pair_control: "USER_IO" is minmax_ref_type=3 & wide_40_45=0x17 { export USER_IO; }

minmax_pair_data: "*"^wide_move_base is minmax_ref_type<2 & minmax_ref_mode=0 & wide_move_base { export wide_move_base; }

minmax_pair_rhs: minmax_pair_word is minmax_pair_word & minmax_pair_op {
    local value:8;
    minmax_extend(minmax_pair_word, minmax_pair_op & 1, value);
    export value;
}
minmax_pair_rhs: minmax_pair_control is minmax_pair_control & minmax_pair_op {
    local value:8;
    minmax_extend(minmax_pair_control, minmax_pair_op & 1, value);
    export value;
}
minmax_pair_rhs: minmax_pair_rhs_acc is minmax_ref_type=2 & minmax_ref_mode=1 & minmax_rhs_index<6
    & minmax_pair_rhs_acc & minmax_pair_rhs_acc_lo & minmax_pair_rhs_acc_hi & minmax_pair_rhs_acc_guard & minmax_pair_op {
    local guard:8;
    minmax_extend(minmax_pair_rhs_acc_guard, minmax_pair_op & 1, guard);
    local value:8 = guard * 0x100000000 + zext(minmax_pair_rhs_acc_hi) * 0x10000 + zext(minmax_pair_rhs_acc_lo);
    export value;
}
minmax_pair_rhs: minmax_pair_data is minmax_ref_type=0 & minmax_pair_data & minmax_pair_op {
    local word:2 = *[data]:2 minmax_pair_data;
    local value:8;
    minmax_extend(word, minmax_pair_op & 1, value);
    export value;
}
minmax_pair_rhs: "long" minmax_pair_data is minmax_ref_type=1 & minmax_pair_data & minmax_pair_op {
    local address:2 = minmax_pair_data;
    local upper:2 = address + 1;
    local lo:2 = *[data]:2 address;
    local hi:2 = *[data]:2 upper;
    local high:8;
    minmax_extend(hi, minmax_pair_op & 1, high);
    local value:8 = high * 0x10000 + zext(lo);
    export value;
}
minmax_pair_lane: is minmax_pair_word { export 0:1; }
minmax_pair_lane: is minmax_pair_control { export 16:1; }
minmax_pair_lane: is minmax_ref_type=2 & minmax_ref_mode=1 & minmax_rhs_index<6 { export 16:1; }
minmax_pair_lane: is minmax_pair_data & minmax_ref_type=0 { export 0:1; }
minmax_pair_lane: is minmax_pair_data & minmax_ref_type=1 { export 16:1; }

minmax_pair_address_word: minmax_pair_dst_ptr is minmax_pair_dst_group=0xa & minmax_pair_dst_ptr { export minmax_pair_dst_ptr; }
minmax_pair_address_word: "LC1" is minmax_pair_dst=0xd4 { export LC1; }

macro minmax_pair_traced(dst, rhs, kind, trace, lane, left, right) {
    minmax_extend(dst, kind & 1, left);
    right = rhs;
    local selected:8;
    local better:1;
    minmax_select(left, right, kind & 2, selected, better);
    trace = (trace << 1) | zext(better);
    local word:8 = selected >> lane;
    dst = word:2;
}

@define WIDE_EXTREMA_PAIR "$(WIDE_MINMAX) & wide_14_22=0x10a"
:minmax_pair_op minmax_predicate minmax_pair_dst_word,minmax_pair_rhs is $(WIDE_EXTREMA_PAIR)
    & minmax_pair_dst_group=9 & minmax_pair_dst & minmax_pair_dst_word & minmax_pair_op & minmax_pair_rhs & minmax_pair_lane & minmax_pair_trace {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_pair_rhs;
    local left:8;
    local right:8;
    minmax_pair_traced(minmax_pair_dst_word, minmax_pair_rhs, minmax_pair_op, minmax_pair_trace, minmax_pair_lane, left, right);
    local destination:1 = minmax_pair_dst;
    if ((destination & 7) >= 6) goto <feedback>;
    minmax_compare_flags(left, right, minmax_pair_op & 1);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_pair_op minmax_predicate minmax_pair_address_word,minmax_pair_rhs is $(WIDE_EXTREMA_PAIR)
    & minmax_pair_address_word & minmax_pair_op & minmax_pair_rhs & minmax_pair_lane & minmax_pair_trace {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_pair_rhs;
    local left:8;
    local right:8;
    minmax_pair_traced(minmax_pair_address_word, minmax_pair_rhs, minmax_pair_op, minmax_pair_trace, minmax_pair_lane, left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MINMU minmax_predicate minmax_pair_address_word,minmax_pair_data is $(WIDE_EXTREMA_PAIR)
    & minmax_pair_variant=3 & minmax_pair_address_word & minmax_ref_type=0 & minmax_pair_data {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local address:2 = minmax_pair_data;
    local word:2 = *[data]:2 address;
    if (word >= minmax_pair_address_word) goto <feedback>;
    minmax_pair_address_word = word;
    MINMAX = address;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
@undef WIDE_EXTREMA_PAIR

macro minmax_store_long(address, value) {
    local upper:2 = address + 1;
    *[data]:2 address = value:2;
    *[data]:2 upper = value(2);
}

minmax_min_store_op: "MIN" is wide_12_22=0x484 { export 0:1; }
minmax_min_store_op: "MINU" is wide_12_22=0x485 { export 1:1; }
minmax_min_addr_op: "MINM" is wide_12_22=0x482 { export 0:1; }
minmax_min_addr_op: "MINMU" is wide_12_22=0x483 { export 1:1; }
minmax_min_signedness: is (wide_12_22=0x482 | wide_12_22=0x484) { export 0:1; }
minmax_min_signedness: is (wide_12_22=0x483 | wide_12_22=0x485) { export 1:1; }

# The left selector's low bit is in the first slot. The remaining four
# bits share the second slot with the result selector.
minmax_extrema_lhs_word: minmax_lhs_even_lo is minmax_lhs_group=2 & minmax_lhs_pair<3 & minmax_lhs_parity=0 & minmax_lhs_even_lo { export minmax_lhs_even_lo; }
minmax_extrema_lhs_word: minmax_lhs_odd_lo is minmax_lhs_group=2 & minmax_lhs_pair<3 & minmax_lhs_parity=1 & minmax_lhs_odd_lo { export minmax_lhs_odd_lo; }
minmax_extrema_lhs_word: minmax_lhs_even_hi is minmax_lhs_group=3 & minmax_lhs_pair<3 & minmax_lhs_parity=0 & minmax_lhs_even_hi { export minmax_lhs_even_hi; }
minmax_extrema_lhs_word: minmax_lhs_odd_hi is minmax_lhs_group=3 & minmax_lhs_pair<3 & minmax_lhs_parity=1 & minmax_lhs_odd_hi { export minmax_lhs_odd_hi; }
minmax_extrema_lhs_guard: minmax_lhs_even_guard is minmax_lhs_group=0 & minmax_lhs_pair<3 & minmax_lhs_parity=0 & minmax_lhs_even_guard { export minmax_lhs_even_guard; }
minmax_extrema_lhs_guard: minmax_lhs_odd_guard is minmax_lhs_group=0 & minmax_lhs_pair<3 & minmax_lhs_parity=1 & minmax_lhs_odd_guard { export minmax_lhs_odd_guard; }

minmax_extrema_lhs: minmax_extrema_lhs_word is minmax_extrema_lhs_word & minmax_min_signedness {
    local value:8;
    minmax_extend(minmax_extrema_lhs_word, minmax_min_signedness, value);
    export value;
}
minmax_extrema_lhs: minmax_extrema_lhs_guard is minmax_extrema_lhs_guard {
    local value:8 = zext(minmax_extrema_lhs_guard);
    export value;
}
minmax_extrema_lhs_lane: is minmax_extrema_lhs_word { export 0:1; }
minmax_extrema_lhs_lane: is minmax_extrema_lhs_guard { export 16:1; }

@define MINMAX_RHS_WORD_SELECTOR "(minmax_rhs_group>=2 | minmax_rhs_selector=0xf)"
minmax_extrema_rhs_word: minmax_rhs_lo is minmax_rhs_group=2 & minmax_rhs_index<6 & minmax_rhs_lo { export minmax_rhs_lo; }
minmax_extrema_rhs_word: minmax_rhs_hi is minmax_rhs_group=3 & minmax_rhs_index<6 & minmax_rhs_hi { export minmax_rhs_hi; }
minmax_extrema_rhs_word: "#"^absolute_data_addr is minmax_rhs_selector=0xf & absolute_data_addr { export *[const]:2 absolute_data_addr; }

minmax_extrema_rhs: minmax_extrema_rhs_word is $(MINMAX_RHS_WORD_SELECTOR) & minmax_extrema_rhs_word & minmax_min_signedness {
    local value:8;
    minmax_extend(minmax_extrema_rhs_word, minmax_min_signedness, value);
    export value;
}
minmax_extrema_rhs: minmax_rhs_guard is minmax_rhs_group=0 & minmax_rhs_index<6 & minmax_rhs_guard {
    local value:8 = zext(minmax_rhs_guard);
    export value;
}
minmax_extrema_rhs: "#0xffffffffff" is minmax_rhs_selector=0xe & minmax_min_signedness {
    local value:8 = 0xffffffffff;
    if (minmax_min_signedness != 0) goto <extended>;
    value = -1;
  <extended>
    export value;
}
minmax_extrema_rhs_lane: is $(MINMAX_RHS_WORD_SELECTOR) { export 0:1; }
minmax_extrema_rhs_lane: is (minmax_rhs_group=0 & minmax_rhs_index<6) | minmax_rhs_selector=0xe { export 16:1; }
@undef MINMAX_RHS_WORD_SELECTOR

minmax_extrema_data: "*"^minmax_store_base is minmax_store_is_register=0 & minmax_store_data_mode=0 & minmax_store_base {
    export minmax_store_base;
}
minmax_extrema_data: "*"^minmax_store_base^"++" is minmax_store_is_register=0 & minmax_store_is_long=0 & minmax_store_data_mode=2
    & minmax_store_base & minmax_store_mod & minmax_store_bound & minmax_store_shift {
    local address:2;
    minmax_ref_update(minmax_store_base, minmax_store_mod, minmax_store_bound, minmax_store_shift, 1:2, address);
    export address;
}
minmax_extrema_data: "*"^minmax_store_base^"++" is minmax_store_is_register=0 & minmax_store_is_long=1
    & minmax_store_data_mode=2 & minmax_store_base & minmax_store_mod & minmax_store_bound & minmax_store_shift {
    local address:2;
    minmax_ref_update(minmax_store_base, minmax_store_mod, minmax_store_bound, minmax_store_shift, 2:2, address);
    export address;
}
minmax_extrema_data: "*"^minmax_store_base^"+="^minmax_ref_disp is minmax_store_is_register=0 & minmax_store_data_mode=6
    & minmax_store_base & minmax_store_mod & minmax_store_bound & minmax_store_shift & minmax_ref_disp {
    local address:2;
    minmax_ref_update(minmax_store_base, minmax_store_mod, minmax_store_bound, minmax_store_shift, minmax_ref_disp, address);
    export address;
}

macro minmax_store_min(lhs, rhs, unsigned_compare, selected) {
    local left:8 = lhs;
    local right:8 = rhs;
    local better:1;
    minmax_select(left, right, 0:1, selected, better);
    minmax_compare_flags(right, left, unsigned_compare);
}

@define WIDE_EXTREMA_MIN_STORE "$(WIDE_MINMAX) & minmax_min_store_op & minmax_extrema_lhs & minmax_extrema_rhs"
@define WIDE_EXTREMA_STORE_ADDR "if ((minmax_predicate & 2) == 0) goto <feedback>; build minmax_extrema_data; if ((minmax_predicate & 1) == 0) goto <feedback>;"
:minmax_min_store_op minmax_predicate minmax_extrema_data,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_STORE)
    & minmax_store_is_long=0 & minmax_extrema_data & minmax_extrema_lhs_lane & minmax_extrema_rhs_lane {
    $(WIDE_EXTREMA_STORE_ADDR)
    local selected:8;
    minmax_store_min(minmax_extrema_lhs, minmax_extrema_rhs, minmax_min_store_op, selected);
    local word:8 = selected >> (minmax_extrema_lhs_lane | minmax_extrema_rhs_lane);
    *[data]:2 minmax_extrema_data = word:2;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_store_op minmax_predicate "long" minmax_extrema_data,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_STORE)
    & minmax_store_is_long=1 & minmax_extrema_data {
    $(WIDE_EXTREMA_STORE_ADDR)
    local selected:8;
    minmax_store_min(minmax_extrema_lhs, minmax_extrema_rhs, minmax_min_store_op, selected);
    local result:4 = selected:4;
    minmax_store_long(minmax_extrema_data, result);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_store_op minmax_predicate minmax_store_dst_word,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_STORE)
    & minmax_store_dst_group=9 & minmax_store_dst_word & minmax_extrema_lhs_lane & minmax_extrema_rhs_lane {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local selected:8;
    minmax_store_min(minmax_extrema_lhs, minmax_extrema_rhs, minmax_min_store_op, selected);
    local word:8 = selected >> (minmax_extrema_lhs_lane | minmax_extrema_rhs_lane);
    minmax_store_dst_word = word:2;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_store_op minmax_predicate "<discard>",minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_STORE)
    & (minmax_store_dst=0xb8 | minmax_store_dst=0xd8) {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    minmax_compare_flags(minmax_extrema_rhs, minmax_extrema_lhs, minmax_min_store_op);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
@undef WIDE_EXTREMA_MIN_STORE

# A reference can force an upper-word result without winning the comparison.
# MINMAX still observes only strict replacement and uses the reference's low word.
macro minmax_record_min(left, right, reference, selected, better) {
    minmax_select(left, right, 0:1, selected, better);
    if (!better) goto <recorded>;
    MINMAX = reference:2;
  <recorded>
}

@define WIDE_EXTREMA_MIN_ADDR "$(WIDE_MINMAX) & minmax_min_addr_op & minmax_extrema_lhs & minmax_extrema_rhs"
:minmax_min_addr_op minmax_predicate minmax_extrema_data,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_ADDR)
    & minmax_store_is_long=0 & minmax_extrema_data & minmax_extrema_rhs_lane {
    $(WIDE_EXTREMA_STORE_ADDR)
    local address:2 = minmax_extrema_data;
    local word:2 = *[data]:2 address;
    local left:8;
    minmax_extend(word, minmax_min_addr_op, left);
    local selected:8;
    local better:1;
    minmax_record_min(left, minmax_extrema_lhs, minmax_extrema_rhs, selected, better);
    if (!better && minmax_extrema_rhs_lane == 0) goto <flags>;
    local result:8 = selected >> minmax_extrema_rhs_lane;
    *[data]:2 address = result:2;
  <flags>
    minmax_compare_flags(left, minmax_extrema_lhs, minmax_min_addr_op);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_addr_op minmax_predicate "long" minmax_extrema_data,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_ADDR)
    & minmax_store_is_long=1 & minmax_extrema_data {
    $(WIDE_EXTREMA_STORE_ADDR)
    local address:2 = minmax_extrema_data;
    local upper:2 = address + 1;
    local lo:2 = *[data]:2 address;
    local hi:2 = *[data]:2 upper;
    local high:8;
    minmax_extend(hi, minmax_min_addr_op, high);
    local left:8 = high * 0x10000 + zext(lo);
    if (!(minmax_extrema_lhs s< left)) goto <flags>;
    MINMAX = minmax_extrema_rhs:2;
    local result:4 = minmax_extrema_lhs:4;
    minmax_store_long(address, result);
  <flags>
    minmax_compare_flags(left, minmax_extrema_lhs, minmax_min_addr_op);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_addr_op minmax_predicate minmax_store_dst_guard,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_ADDR)
    & minmax_store_dst_group=8 & minmax_store_dst<0x86 & minmax_store_dst_index<6 & minmax_store_dst_guard {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_store_dst_guard);
    local selected:8;
    local better:1;
    minmax_record_min(left, minmax_extrema_lhs, minmax_extrema_rhs, selected, better);
    minmax_store_dst_guard = selected(4);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

minmax_extrema_addr_word: minmax_store_dst_word is minmax_store_dst_group=9 & minmax_store_dst_word { export minmax_store_dst_word; }
minmax_extrema_addr_word: "LC1" is minmax_store_dst=0xd4 { export LC1; }

:minmax_min_addr_op minmax_predicate minmax_extrema_addr_word,minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_ADDR)
    & minmax_extrema_addr_word & minmax_store_dst & minmax_extrema_lhs_lane & minmax_extrema_rhs_lane {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8;
    minmax_extend(minmax_extrema_addr_word, minmax_min_addr_op, left);
    local selected:8;
    local better:1;
    minmax_record_min(left, minmax_extrema_lhs, minmax_extrema_rhs, selected, better);
    local result:8 = selected >> (minmax_extrema_lhs_lane | minmax_extrema_rhs_lane);
    minmax_extrema_addr_word = result:2;
    local destination:1 = minmax_store_dst;
    if ((destination >> 4) != 9 || (destination & 7) >= 6) goto <feedback>;
    minmax_compare_flags(left, minmax_extrema_lhs, minmax_min_addr_op);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_addr_op minmax_predicate "<discard>",minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_ADDR)
    & minmax_store_dst=0xd8 {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    if (!(minmax_extrema_lhs s< 0)) goto <feedback>;
    MINMAX = minmax_extrema_rhs:2;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:minmax_min_addr_op minmax_predicate "CECFG2",minmax_extrema_lhs,minmax_extrema_rhs is $(WIDE_EXTREMA_MIN_ADDR)
    & minmax_store_dst=0xc3 & minmax_extrema_lhs_lane & minmax_extrema_rhs_lane {
    # Feedback observes the old configuration, before the word result is published.
    publish_alu_ce(EST & 0xcfff);
    if ((minmax_predicate & 1) == 0) goto <done>;
    local left:8;
    minmax_extend(CECFG2, minmax_min_addr_op, left);
    local selected:8;
    local better:1;
    minmax_record_min(left, minmax_extrema_lhs, minmax_extrema_rhs, selected, better);
    local result:8 = selected >> (minmax_extrema_lhs_lane | minmax_extrema_rhs_lane);
    CECFG2 = result:2;
  <done>
}
@undef WIDE_EXTREMA_MIN_ADDR
@undef WIDE_EXTREMA_STORE_ADDR

macro minmax_signed_max_word(lhs, rhs, selected) {
    local left:8 = sext(lhs);
    local right:8 = sext(rhs);
    selected = lhs;
    if (left s>= right) goto <flags>;
    selected = rhs;
  <flags>
    minmax_signed_flags(left, right);
}

minmax_store_indexed: is wide_40_45=0x3c {
    local address:2 = R7;
    if ((PACFG & 0xc000) != 0x4000) goto <ordinary>;
    local reversed:2;
    local step:2;
    reverse_word(address, reversed);
    reverse_word(RN7, step);
    local sum:2 = reversed + step;
    reverse_word(sum, R7);
    goto <done>;
  <ordinary>
    minmax_ref_update(R7, RM6, RL6, 14, RN7, address);
  <done>
    export address;
}

# The unbound selector reads one word at the all-ones DATA address, even
# when the result is stored as a pair and an independent literal is encoded.
minmax_store_source: "*0xffff" is wide_0_22=0x48c5f7 {
    local sample:2 = *[data]:2 0xffff:2;
    export sample;
}
minmax_store_source: "A1L" is wide_0_22=0x48c5f8 { export A1L; }

@define WIDE_EXTREMA_STORE "$(WIDE_MINMAX) & carmel_issue=4 & minmax_ce_bank=1"
@define EXTREMA_INDEXED "$(WIDE_EXTREMA_STORE) & minmax_store_indexed"
@define EXTREMA_INDEXED_PREDICATE "if ((minmax_predicate & 2) == 0) goto <feedback>; build minmax_store_indexed; if ((minmax_predicate & 1) == 0) goto <feedback>;"
:MAX minmax_predicate "long *R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48c4f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local word:2;
    minmax_signed_max_word(A4H, sample, word);
    local extended:4 = sext(word);
    minmax_store_long(minmax_store_indexed, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAX minmax_predicate "*R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48c0f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local word:2;
    minmax_signed_max_word(A4H, sample, word);
    *[data]:2 minmax_store_indexed = word;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAX minmax_predicate "long *R7--",minmax_store_source,wide_load_literal_bits is $(WIDE_EXTREMA_STORE) & wide_40_45=0x2f & minmax_store_source & wide_load_literal_bits {
    if ((minmax_predicate & 2) == 0) goto <feedback>;
    local address:2;
    minmax_ref_update(R7, RM6, RL6, 14, -2:2, address);
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_store_source;
    local word:2;
    minmax_signed_max_word(wide_load_literal_bits:2, minmax_store_source, word);
    local extended:4 = sext(word);
    minmax_store_long(address, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MINBTR2 minmax_predicate "long *R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48a4f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local left:8 = sext(A4H);
    local right:8 = sext(sample);
    local take_right:1 = right s< left;
    BTR2 = (BTR2 << 1) | zext(take_right);
    minmax_signed_flags(left, right);
    local extended:4 = left:4;
    if (!take_right) goto <write>;
    extended = right:4;
  <write>
    minmax_store_long(minmax_store_indexed, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXU minmax_predicate "long *R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48d4f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local left:8 = zext(A4H);
    local right:8 = zext(sample);
    minmax_unsigned_flags(left, right);
    local extended:4 = left:4;
    if (left >= right) goto <write>;
    extended = right:4;
  <write>
    minmax_store_long(minmax_store_indexed, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
@undef EXTREMA_INDEXED_PREDICATE
@undef EXTREMA_INDEXED
@undef WIDE_EXTREMA_STORE

# The stored MINU selector straddles the two words: the high four bits
# of input 1 are in the right word; its low bit accompanies input 2.
minmax_store_minu_rhs: "A3" is wide_40_45=0xb { }
minmax_store_minu_rhs: "A3H" is wide_40_45=0x1b { }
minmax_store_minu_value: is wide_40_45=0xb {
    local rhs:8 = zext(GB3) * 0x100000000 + zext(A3H) * 0x10000 + zext(A3L);
    export rhs;
}
minmax_store_minu_value: is wide_40_45=0x1b {
    local rhs:8 = zext(A3H);
    export rhs;
}
minmax_store_minu_shift: is wide_40_45=0xb { export 16:1; }
minmax_store_minu_shift: is wide_40_45=0x1b { export 0:1; }

@define STORED_MINU_A2H "$(WIDE_MINMAX) & wide_12_22=0x485 & minmax_store_lhs_hi=0xd & minmax_store_minu_rhs"
:MINU minmax_predicate "R4","A2H",minmax_store_minu_rhs is $(STORED_MINU_A2H) & minmax_store_dst=0xa4 & minmax_store_minu_value & minmax_store_minu_shift {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_store_minu_value;
    local left:8 = zext(A2H);
    local right:8 = minmax_store_minu_value;
    minmax_unsigned_flags(right, left);
    local selected:8 = left;
    if (left <= right) goto <write>;
    selected = right;
  <write>
    local word:8 = selected >> minmax_store_minu_shift;
    R4 = word:2;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MINU minmax_predicate minmax_store_dst,"A2H",minmax_store_minu_rhs is $(STORED_MINU_A2H) & minmax_store_dst_bank=7 & minmax_store_dst {
    publish_alu_ce(EST & 0xcfff);
}
@undef STORED_MINU_A2H
@undef WIDE_MINMAX

# The word port is the upper half of the low 32-bit lane, not the low
# half of the shifter. Z still observes the guard above that word.
macro wide_shift_ports(input, count_word, left_tap, right_bias, arithmetic, result, flags) {
    local count:4 = (zext(count_word & 0x7f) ^ 64) - 64;
    local carry_bit:1 = (EST & 1) != 0;
    result = input;
    if (count == 0) goto <shift_status>;
    if (count s< 0) goto <shift_right>;
    if (count s<= 40) goto <shift_left>;
    count = 40;
  <shift_left>
    result = (input & 0xffffffffff) << count;
    carry_bit = 0;
    if (count s> left_tap) goto <shift_status>;
    carry_bit = ((input >> (left_tap - count)) & 1) != 0;
    goto <shift_status>;
  <shift_right>
    count = -count;
    if (count s<= 40) goto <shift_right_bounded>;
    count = 40;
  <shift_right_bounded>
    if (arithmetic != 0) goto <shift_arithmetic>;
    result = input >> count;
    goto <shift_right_carry>;
  <shift_arithmetic>
    result = input s>> count;
  <shift_right_carry>
    carry_bit = ((input >> (count - 1 + right_bias)) & 1) != 0;
  <shift_status>
    result = result & 0xffffffffff;
    local observed:8 = result & (0xffffffffff ^ (zext(right_bias != 0) * 0xffff));
    shift_flags(observed, carry_bit, flags);
}

macro wide_shift_word_limit(result, flags, word) {
    # The word writeback limits on all nine extension bits, not just
    # the guard boundary. C/Z/M/E still describe the pre-limit result.
    word = result(2);
    if ((ECFG & 4) == 0 || (flags & 0x20) == 0) goto <unlimited>;
    word = 0x7fff + zext((flags & 0x10) != 0);
    flags = flags | 4;
  <unlimited>
}

:LSHIFT "*R0","*R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x700004 {
    local source:2 = *[data]:2 R2;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(source) << 16;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    *[data]:2 R0 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "*R0","long *R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x700084 {
    local upper:2 = R2 + 1;
    local low:2 = *[data]:2 R2;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    *[data]:2 R0 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "long *R0","long *R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x708084 {
    local upper:2 = R2 + 1;
    local low:2 = *[data]:2 R2;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 0:4, 0:1, result, flags);
    local next:2 = R0 + 1;
    *[data]:2 R0 = result:2;
    *[data]:2 next = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "A0","long *R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x711084 {
    local upper:2 = R2 + 1;
    local low:2 = *[data]:2 R2;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 40:4, 0:4, 0:1, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "CE1" "*R6++("^wide_shift_dst_disp^")","*(R3+RN3)","*(R2+"^wide_shift_count_disp^")" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_40_45=0x22 & wide_0_22=0x706c56 & unary_wide_ce_bank=0 & wide_shift_dst_disp & wide_shift_count_disp {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <shift_veto>;
    local dest:2 = R6;
    local source_addr:2 = R3 + RN3;
    local count_addr:2 = R2 + sext(wide_shift_count_disp:1);
    local delta:2 = sext(wide_shift_dst_disp:1);
    local next:2;
    transfer_address_word(R6, RM6, RL6, 12, delta, next);
    R6 = next;
    local source:2 = *[data]:2 source_addr;
    local count:2 = *[data]:2 count_addr;
    local input:8 = zext(source) << 16;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    *[data]:2 dest = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
  <shift_veto>
}

:LSHIFT "CE2" "R2","long *(R3+RN3)","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_40_45=0x10 & wide_0_22=0x7144d7 & unary_wide_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <shift_veto>;
    local addr:2 = R3 + RN3;
    local upper:2 = addr + 1;
    local low:2 = *[data]:2 addr;
    local high:2 = *[data]:2 upper;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, A0L, 32:4, 16:4, 0:1, result, flags);
    R2 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
  <shift_veto>
}

:ASHIFT "*R6++","*R0--","*R4" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=4 & wide_0_22=0x722c30 {
    local dest:2 = R6;
    local source_addr:2 = R0;
    local next:2;
    transfer_address_word(R6, RM6, RL6, 12, 1:2, next);
    R6 = next;
    transfer_address_word(R0, RM0, RL0, 0, 0xffff:2, next);
    R0 = next;
    local source:2 = *[data]:2 source_addr;
    local count:2 = *[data]:2 R4;
    local input:8 = sext(source) * 0x10000;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 1:1, result, flags);
    shift_limit(result, flags);
    *[data]:2 dest = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

@define WIDE_ORIGINAL_BITS "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1"

:EXTRACTZ "*R0--","IOSPACE","FF1:FF2" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x29 & wide_0_22=0x7631b1 {
    local dest:2 = R0;
    modify_ptr_scaled_window(R0, 0:2, RM0, RL0, 0, 3, 1:2, 0xffff:2);
    # The IOSPACE input is unbound; all field descriptors extract zero.
    *[data]:2 dest = 0;
    publish_alu_ce((EST & 0xcfe7) | 8);
}

macro wide_extract_zero(source, width, offset, result) {
    local count:4 = zext(width & 31);
    local start:4 = zext(offset & 31);
    local mask:4 = 0x7fffffff >> (31 - count);
    result = (source s>> start) & mask;
}

wide_bitfield_data: "*"^short_alu_src_ptr is packed_lhs_group=0 & short_alu_src_ptr {
    local low:2 = *[data]:2 short_alu_src_ptr;
    local source:4 = sext(low);
    export source;
}

wide_bitfield_data: "long *"^short_alu_src_ptr is packed_lhs_group=8 & short_alu_src_ptr {
    local next:2 = short_alu_src_ptr + 1;
    local low:2 = *[data]:2 short_alu_src_ptr;
    local high:2 = *[data]:2 next;
    local source:4 = (zext(high) << 16) | zext(low);
    export source;
}

@define WIDE_LSHIFT_ROUTED "$(WIDE_ORIGINAL_BITS) & wide_shift_opcode=0x38"
@define WIDE_LSHIFT_LONG "$(WIDE_LSHIFT_ROUTED) & wide_shift_source_tail=0x8b & wide_bitfield_data"

:LSHIFT "discard",wide_bitfield_data,"A2H" is $(WIDE_LSHIFT_LONG) & wide_shift_destination=0xe1 & wide_40_45=0x1a {
    local input:8 = zext(wide_bitfield_data);
    local result:8;
    local flags:2;
    wide_shift_ports(input, A2H, 32:4, 0:4, 0:1, result, flags);
    publish_alu_ce((EST & 0xcffe) | (flags & 1));
}

:LSHIFT "flags",wide_bitfield_data,"A0L" is $(WIDE_LSHIFT_LONG) & wide_shift_destination=0xd8 & wide_40_45=0x10 {
    local input:8 = zext(wide_bitfield_data);
    local result:8;
    local flags:2;
    wide_shift_ports(input, A0L, 32:4, 16:4, 0:1, result, flags);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "flags","USER_IO","*(R4+"^wide_shift_dst_disp^")" is $(WIDE_LSHIFT_ROUTED) & wide_shift_destination=0xd8 & wide_40_45=0x24 & wide_shift_source_tail=0x1ee & wide_shift_dst_disp {
    local address:2 = R4 + sext(wide_shift_dst_disp:1);
    local count:2 = *[data]:2 address;
    local input:8 = zext(USER_IO);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    # This input preserves the bit-zero tap beyond the word boundary.
    if (((count & 0x7f) - 33) > 30) goto <publish>;
    flags = flags | (USER_IO & 1);
  <publish>
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "A0",wide_bitfield_data,"A0L" is $(WIDE_LSHIFT_LONG) & wide_shift_destination=0x88 & wide_40_45=0x10 {
    local input:8 = zext(wide_bitfield_data);
    local result:8;
    local flags:2;
    wide_shift_ports(input, A0L, 40:4, 0:4, 0:1, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

wide_lshift_intbase_src: "LC1" is wide_shift_source_tail=0x1e9 { export LC1; }
wide_lshift_intbase_src: "INTBASE" is wide_shift_source_tail=0x1ed { export INTBASE; }
wide_lshift_intbase_src: "PACFG" is wide_shift_source_tail=0x1d5 { export PACFG; }

:LSHIFT "INTBASE",wide_lshift_intbase_src,"A0L" is $(WIDE_LSHIFT_ROUTED) & wide_shift_destination=0xd6 & wide_40_45=0x10 & wide_lshift_intbase_src {
    local input:8 = zext(wide_lshift_intbase_src) << 16;
    local result:8;
    local flags:2;
    wide_shift_ports(input, A0L, 32:4, 16:4, 0:1, result, flags);
    INTBASE = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

@define WIDE_LSHIFT_R1 "$(WIDE_LSHIFT_ROUTED) & wide_40_45=1 & bitfield_descriptor=0"

:LSHIFT "FF1","A1L","*R1" is $(WIDE_LSHIFT_R1) & wide_shift_destination=0xbe & wide_shift_source_tail=0x122 {
    local count:2 = *[data]:2 R1;
    local input:8 = zext(A1L) << 16;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    FF1 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "A0","LEA","*R1" is $(WIDE_LSHIFT_R1) & wide_shift_destination=0x88 & wide_shift_source_tail=0x1a6 {
    # This operand port selects a saved bound, including bank one at depth zero.
    local depth:2 = PSTATUS & 7;
    local bound:4 = LEA1W;
    if (depth < 2) goto <selected>;
    bound = LEA2W;
    if (depth == 2) goto <selected>;
    bound = LEA3W;
    if (depth == 3) goto <selected>;
    bound = LEA4W;
  <selected>
    local input:8 = zext(bound & 0xffffff);
    local count:2 = *[data]:2 R1;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 40:4, 0:4, 0:1, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

@undef WIDE_LSHIFT_R1

@undef WIDE_LSHIFT_LONG
@undef WIDE_LSHIFT_ROUTED

:EXTRACTZ "A0",wide_bitfield_data,bitfield_descriptor is $(WIDE_ORIGINAL_BITS) & packed_opcode=0xee & packed_dst=0x10 & wide_0_0=1 & wide_40_45=0xf & wide_bitfield_data & bitfield_descriptor {
    local field:2 = bitfield_descriptor;
    local result:4;
    wide_extract_zero(wide_bitfield_data, field >> 8, field, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = 0;
    local flags:2 = zext(result == 0) << 3;
    publish_alu_ce(flags);
}

macro wide_extract_btr2(source, signed_result) {
    local count:4 = zext(FF2 & 31);
    local start:4 = zext(FF1 & 31);
    local mask:4 = 0x7fffffff >> (31 - count);
    # Bias before the unsigned shift to preserve signed input even for a concatenated word pair.
    local bias:4 = 0x80000000;
    local field:4 = (((source ^ bias) >> start) - (bias >> start)) & mask;
    local sign:4 = ((mask + 1) >> 1) * zext(signed_result);
    local result:4 = (field ^ sign) - sign;
    BTR2 = result:2;
    local flags:2 = (zext(field == 0) << 3) | (zext((field & sign) != 0) << 4);
    publish_ce_feedback((EST & 0xcfe7) | flags, EST);
}

@define WIDE_EXTRACT_BTR2 "$(WIDE_ORIGINAL_BITS) & packed_dst=0xe & packed_lhs_group=8 & wide_0_0=1 & (wide_40_45=0x3c | wide_40_45=0x3e) & wide_bitfield_data"

:EXTRACTS "BTR2",wide_bitfield_data,"FF2:FF1" is $(WIDE_EXTRACT_BTR2) & packed_opcode=0xeb {
    wide_extract_btr2(wide_bitfield_data, 1:1);
}

:EXTRACTZ "BTR2",wide_bitfield_data,"FF2:FF1" is $(WIDE_EXTRACT_BTR2) & packed_opcode=0xef {
    wide_extract_btr2(wide_bitfield_data, 0:1);
}

@undef WIDE_EXTRACT_BTR2

:EXTRACTZ "long *R2","GB2","long *R6+=RN6" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0xe & wide_0_22=0x768504 {
    local dest:2 = R2;
    local dest_high:2 = dest + 1;
    local addr:2 = R6;
    local addr_high:2 = addr + 1;
    modify_ptr_scaled_window(R6, RN6, RM6, RL6, 12, 1, 2:2, 0xffff:2);
    local width:2 = *[data]:2 addr;
    local offset:2 = *[data]:2 addr_high;
    local result:4;
    wide_extract_zero(zext(GB2), width, offset, result);
    *[data]:2 dest = result:2;
    *[data]:2 dest_high = 0;
    publish_ce_feedback((EST & 0xcfe7) | (zext(result == 0) << 3), EST);
}

:EXTRACTZ "FF1","FF2","long *R4+="^wide_shift_dst_disp is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x34 & wide_0_22=0x777d2e & wide_shift_dst_disp {
    local addr:2 = R4;
    local addr_high:2 = addr + 1;
    local delta:2 = sext(wide_shift_dst_disp:1);
    modify_ptr_scaled_window(R4, delta, RM4, RL4, 8, 4, 2:2, 0xffff:2);
    local width:2 = *[data]:2 addr;
    local offset:2 = *[data]:2 addr_high;
    local result:4;
    wide_extract_zero(sext(FF2), width, offset, result);
    FF1 = result:2;
    publish_ce_feedback((EST & 0xcfe7) | (zext(result == 0) << 3), EST);
}

:EXTRACTS "discard","RM6","long *R3--" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x1b & wide_0_22=0x75c96e {
    local addr:2 = R3;
    local addr_high:2 = addr + 1;
    modify_ptr_scaled_window(R3, 0:2, RM2, RL2, 6, 3, 2:2, 0xffff:2);
    local width:2 = *[data]:2 addr;
    local offset:2 = *[data]:2 addr_high;
    publish_ce_feedback(EST & 0xcfff, EST);
}

:EXTRACTS "LSA1","*R3+=RN3","RM4" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x36 & wide_0_22=0x75a417 {
    local addr:2 = R3;
    modify_ptr_scaled_window(R3, RN3, RM2, RL2, 6, 1, 1:2, 0xffff:2);
    local source:2 = *[data]:2 addr;
    publish_ce_feedback(EST & 0xcfff, EST);
}

:EXTRACTZ "CE1" "*R4+=RN4","GB3","FF1:FF2" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0 & wide_40_45=0x1e & wide_0_22=0x761907 {
    local enable:2;
    unary_ce(CECFG1, EST, CETBL, 0:2, enable);
    local dest:2 = R4;
    local flags:2 = EST & 0xcfff;
    if (enable == 0 && (CECFG1 & 0x1000) == 0) goto <feedback>;
    modify_ptr_scaled_window(R4, RN4, RM4, RL4, 8, 1, 1:2, 0xffff:2);
    if (enable == 0) goto <feedback>;
    local result:4;
    wide_extract_zero(zext(GB3), FF2, FF1, result);
    *[data]:2 dest = result:2;
    flags = (flags & 0xffe7) | (zext(result == 0) << 3);
  <feedback>
    local second:2;
    unary_ce(CECFG2, EST, CETBL, 1:2, second);
    EST = flags | (enable << 12) | (second << 13);
}

macro wide_shift_fallback_word(dest, count) {
    local word:2 = *[data]:2 0xffff:2;
    local input:8 = sext(word) * 0x10000;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 1:1, result, flags);
    shift_limit(result, flags);
    *[data]:2 dest = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:ASHIFT "*R0+=RN0","*0xffff","RL0" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x30 & wide_0_22=0x7211fb {
    local dest:2 = R0;
    local count:2 = RL0;
    modify_ptr_scaled_window(R0, RN0, RM0, RL0, 0, 1, 1:2, 0xffff:2);
    wide_shift_fallback_word(dest, count);
}

:ASHIFT "*R0++","*0xffff","RN2" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x2a & wide_0_22=0x7221e9 {
    local dest:2 = R0;
    modify_ptr_scaled_window(R0, 0:2, RM0, RL0, 0, 2, 1:2, 0xffff:2);
    wide_shift_fallback_word(dest, RN2);
}

macro wide_shift_carry_only(input, count) {
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 0:4, 1:1, result, flags);
    publish_alu_ce((EST & 0xcffe) | (flags & 1));
}

:ASHIFT "discard","RF0","ASTATUS" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x39 & wide_0_22=0x730b71 {
    local input:8 = sext(RF0);
    wide_shift_carry_only(input, ASTATUS);
}

:ASHIFT "discard","long *"^absolute_data_addr,"*(R6+"^wide_shift_dst_disp^")" is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x26 & wide_0_22=0x73cef2 & absolute_data_addr & wide_shift_dst_disp {
    local address:2 = absolute_data_addr;
    local upper:2 = address + 1;
    local count_addr:2 = R6 + sext(wide_shift_dst_disp:1);
    local low:2 = *[data]:2 address;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 count_addr;
    local input:8 = sext(high) * 0x10000 + zext(low);
    wide_shift_carry_only(input, count);
}

:ASHIFT "discard","BTR1","*R4+="^wide_shift_dst_disp is $(WIDE_ORIGINAL_BITS) & wide_40_45=0x34 & wide_0_22=0x73a78c & wide_shift_dst_disp {
    local addr:2 = R4;
    local delta:2 = sext(wide_shift_dst_disp:1);
    modify_ptr_scaled_window(R4, delta, RM4, RL4, 8, 4, 1:2, 0xffff:2);
    local count:2 = *[data]:2 addr;
    publish_alu_ce(EST & 0xcfff);
}

macro wide_immediate_shift_word(input, count, left_tap, word, flags) {
    local result:8;
    wide_shift_ports(input, count, left_tap, 16:4, 1:1, result, flags);
    wide_shift_word_limit(result, flags, word);
}

@define WIDE_IMMEDIATE_ASHIFT "$(WIDE_ORIGINAL_BITS) & wide_shift_opcode=0x39 & wide_40_45=0xf & wide_0_0=1 & wide_shift_immediate"

:ASHIFT "RMW1","*"^short_alu_src_ptr,wide_shift_immediate is $(WIDE_IMMEDIATE_ASHIFT) & wide_shift_destination=0x86 & wide_shift_source_tail<=0xf & short_alu_src_ptr {
    local address:2 = short_alu_src_ptr;
    local source:2 = *[data]:2 address;
    local input:8 = sext(source) * 0x10000;
    local count:2 = wide_shift_immediate;
    local word:2;
    local flags:2;
    wide_immediate_shift_word(input, count, 32:4, word, flags);
    *[data]:2 address = word;
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:ASHIFT "A0L","A1",wide_shift_immediate is $(WIDE_IMMEDIATE_ASHIFT) & wide_shift_destination=0x90 & wide_shift_source_tail=0x113 {
    local input:8 = sext(GB1) * 0x100000000 + zext(A1H) * 0x10000 + zext(A1L);
    local count:2 = wide_shift_immediate;
    local word:2;
    local flags:2;
    wide_immediate_shift_word(input, count, 40:4, word, flags);
    A0L = word;
    publish_alu_ce((EST & 0xcfc6) | flags);
}
@undef WIDE_IMMEDIATE_ASHIFT

shift_ce_destination: CECFG1 is wide_shift_destination=0xc2 & CECFG1 { export CECFG1; }
shift_ce_destination: CECFG2 is wide_shift_destination=0xc3 & CECFG2 { export CECFG2; }
shift_ce_destination: CETBL is wide_shift_destination=0xc4 & CETBL { export CETBL; }

macro wide_shift_r7_word(delta, word, flags) {
    local addr:2 = R7;
    modify_ptr_scaled_window(R7, delta, RM6, RL6, 14, 4, 1:2, 0xffff:2);
    local upper:2 = addr + 1;
    local low:2 = *[data]:2 addr;
    local high:2 = *[data]:2 upper;
    local input:8 = sext(high) * 0x10000 + zext(low);
    local result:8;
    wide_shift_ports(input, RN5, 32:4, 16:4, 1:1, result, flags);
    wide_shift_word_limit(result, flags, word);
}

:ASHIFT shift_ce_destination,"long *R7+="^wide_shift_dst_disp,"RN5" is $(WIDE_ORIGINAL_BITS) & wide_shift_opcode=0x39 & wide_40_45=0x2d & wide_shift_source_tail=0xef & shift_ce_destination & wide_shift_dst_disp {
    local word:2;
    local flags:2;
    wide_shift_r7_word(sext(wide_shift_dst_disp:1), word, flags);
    # This writeback does not drive either CE input for the same issue.
    publish_ce_feedback((EST & 0xcfc6) | flags, EST);
    shift_ce_destination = word;
}

:ASHIFT wide_shift_low_dst,"long *R7+="^wide_shift_dst_disp,"RN5" is $(WIDE_ORIGINAL_BITS) & wide_shift_opcode=0x39 & wide_40_45=0x2d & wide_shift_source_tail=0xef & wide_shift_low_bank=0x12 & wide_shift_low_dst & wide_shift_dst_disp {
    local word:2;
    local flags:2;
    wide_shift_r7_word(sext(wide_shift_dst_disp:1), word, flags);
    wide_shift_low_dst = word;
    publish_alu_ce((EST & 0xcfc6) | flags);
}

@undef WIDE_ORIGINAL_BITS

@define PACKED_WIDE "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1"
@define PACKED_WIDE_CE1 "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=0"
@define PACKED_WIDE_CE2 "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1"

packed_short_dst: packed_dst_r is packed_dst_group=0xc & packed_dst_r { export packed_dst_r; }
packed_short_dst: "FF1" is packed_dst=0x56 { export FF1; }
packed_ce1_short_dst: "FF1" is packed_dst=0x7e { export FF1; }
packed_ce1_short_dst: packed_dst_lo is packed_dst_group=0xa & packed_dst_lo { export packed_dst_lo; }
packed_lhs_word: packed_lhs_hi is packed_lhs_group=0xb & packed_lhs_hi { export packed_lhs_hi; }
packed_rhs_word: packed_rhs_hi is wide_0_0=1 & packed_rhs_group=3 & packed_rhs_hi { export packed_rhs_hi; }
packed_rmw: "RMW1" is packed_dst=0x46 { }
packed_rmw: "RMW2" is packed_dst=0x47 { }
packed_input2_dst: "RMW2" is packed_dst=0x47 { }
packed_input2_dst: "OP3" is packed_dst=0x4e { }
packed_acc_dst: packed_dst_acc is packed_dst_group=9 & packed_dst_acc & packed_dst_lo { export packed_dst_lo; }
packed_acc_lhs: packed_lhs_acc is packed_lhs_group=9 & packed_lhs_acc & packed_lhs_lo { export packed_lhs_lo; }
packed_acc_rhs: packed_rhs_acc is wide_0_0=1 & packed_rhs_group=1 & packed_rhs_acc & packed_rhs_lo { export packed_rhs_lo; }
packed_guard_lhs: packed_lhs_guard is packed_lhs_group=8 & packed_lhs_guard { export packed_lhs_guard; }
packed_guard_rhs: packed_rhs_guard is wide_0_0=1 & packed_rhs_group=0 & packed_rhs_guard { export packed_rhs_guard; }
packed_literal_rhs: bitfield_descriptor is wide_0_0=1 & wide_40_45=0xf & bitfield_descriptor { export *[const]:2 bitfield_descriptor; }

macro packed_arithmetic_lane(dst, lhs, rhs, subtract) {
    if (subtract != 0) goto <packed_subtract>;
    dst = lhs + rhs;
    goto <packed_done>;
  <packed_subtract>
    dst = lhs - rhs;
  <packed_done>
}

macro packed_acc_arithmetic(dst_lo, dst_hi, dst_guard, lhs_lo, lhs_hi, lhs_guard, rhs_lo, rhs_hi, rhs_guard, subtract) {
    local left:4 = (zext(lhs_guard) << 16) | zext(lhs_hi);
    local right:4 = (zext(rhs_guard) << 16) | zext(rhs_hi);
    local high:4;
    packed_arithmetic_lane(high, left, right, subtract);
    packed_arithmetic_lane(dst_lo, lhs_lo, rhs_lo, subtract);
    dst_hi = high:2;
    dst_guard = high(2);
}

macro packed_arithmetic_word_ce2(dst, lhs, rhs, subtract) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <publish>;
    # Two short operands feed the high lane of a connected short result.
    packed_arithmetic_lane(dst, lhs, rhs, subtract);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

macro packed_trace(high, low) {
    BTR1 = (BTR1 << 1) | zext(high);
    BTR2 = (BTR2 << 1) | zext(low);
}

macro packed_extrema(dst_lo, dst_hi, dst_guard, lhs_lo, lhs_hi, rhs_lo, rhs_hi, minimum) {
    local take_high:1 = (lhs_hi s< rhs_hi && minimum != 0) || (lhs_hi s> rhs_hi && minimum == 0);
    local take_low:1 = (lhs_lo s< rhs_lo && minimum != 0) || (lhs_lo s> rhs_lo && minimum == 0);
    local high:2 = rhs_hi;
    local low:2 = rhs_lo;
    if (!take_high) goto <packed_choose_low>;
    high = lhs_hi;
  <packed_choose_low>
    if (!take_low) goto <packed_publish>;
    low = lhs_lo;
  <packed_publish>
    packed_trace(take_high, take_low);
    dst_lo = low;
    dst_hi = high;
    dst_guard = 0 - zext(high s< 0);
}

macro packed_r2_long(displacement, high, low) {
    local address:2 = R2;
    local next:2 = address + 1;
    low = *[data]:2 address;
    high = *[data]:2 next;
    local encoded_delta:1 = displacement;
    local delta:2 = sext(encoded_delta);
    transfer_address_word(R2, RM2, RL2, 4, delta, R2);
}

:"ADD2 CE2" packed_short_dst,packed_lhs_word,packed_rhs_word is $(PACKED_WIDE_CE2) & packed_opcode=0x88 & packed_short_dst & packed_lhs_word & packed_rhs_word {
    packed_arithmetic_word_ce2(packed_short_dst, packed_lhs_word, packed_rhs_word, 0:1);
}
:"SUB2 CE2" packed_short_dst,packed_lhs_word,packed_rhs_word is $(PACKED_WIDE_CE2) & packed_opcode=0x89 & packed_dst_group=0xc & packed_short_dst & packed_lhs_word & packed_rhs_word {
    packed_arithmetic_word_ce2(packed_short_dst, packed_lhs_word, packed_rhs_word, 1:1);
}
:"ADD2 CE2" "RMW1",packed_lhs_word,packed_rhs_word is $(PACKED_WIDE_CE2) & packed_opcode=0x88 & packed_dst=0x46 & packed_lhs_word & packed_rhs_word {
    packed_arithmetic_word_ce2(packed_lhs_word, packed_lhs_word, packed_rhs_word, 0:1);
}

:MIN2 packed_short_dst,packed_lhs_word,packed_rhs_word is $(PACKED_WIDE) & packed_opcode=0x8b & packed_dst_group=0xc & packed_short_dst & packed_lhs_word & packed_rhs_word {
    local take_left:1 = packed_lhs_word s< packed_rhs_word;
    packed_trace(take_left, 0:1);
    packed_short_dst = packed_rhs_word;
    if (take_left == 0) goto <publish>;
    packed_short_dst = packed_lhs_word;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:MIN2 "RMW2",packed_lhs_word,packed_rhs_word is $(PACKED_WIDE) & packed_opcode=0x8b & packed_dst=0x47 & packed_lhs_word & packed_rhs_word {
    # The sink does not realign the two short operands to the high lane.
    local left_high:2 = 0 - zext(packed_lhs_word s< 0);
    local right_high:2 = 0 - zext(packed_rhs_word s< 0);
    packed_trace(left_high s< right_high, packed_lhs_word s< packed_rhs_word);
    publish_alu_ce(EST & 0xcfff);
}
:MIN2 packed_rmw,"*R2+="^packed_displacement^":long",packed_rhs_word is $(PACKED_WIDE) & packed_opcode=0x8b & packed_rmw & packed_lhs_code=0x32 & packed_displacement & packed_rhs_word {
    local left_low:2;
    local left_high:2;
    packed_r2_long(packed_displacement, left_high, left_low);
    local right_high:2 = 0 - zext(packed_rhs_word s< 0);
    packed_trace(left_high s< right_high, left_low s< packed_rhs_word);
    publish_alu_ce(EST & 0xcfff);
}
:MIN2 "OP3",packed_lhs_word,"*R2+="^packed_displacement^":long" is $(PACKED_WIDE) & packed_opcode=0x8b & packed_dst=0x4e & packed_lhs_word & wide_0_0=0 & wide_40_45=0x32 & packed_displacement {
    local right_low:2;
    local right_high:2;
    packed_r2_long(packed_displacement, right_high, right_low);
    local left_high:2 = 0 - zext(packed_lhs_word s< 0);
    packed_trace(left_high s< right_high, packed_lhs_word s< right_low);
    publish_alu_ce(EST & 0xcfff);
}

:"ADD2 CE1" packed_acc_dst,packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x88 & packed_acc_dst & packed_acc_lhs & packed_acc_rhs & packed_dst_hi & packed_dst_guard & packed_lhs_hi & packed_lhs_guard & packed_rhs_hi & packed_rhs_guard {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    packed_acc_arithmetic(packed_acc_dst, packed_dst_hi, packed_dst_guard, packed_acc_lhs, packed_lhs_hi, packed_lhs_guard, packed_acc_rhs, packed_rhs_hi, packed_rhs_guard, 0:1);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"SUB2 CE1" packed_acc_dst,packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x89 & packed_acc_dst & packed_acc_lhs & packed_acc_rhs & packed_dst_hi & packed_dst_guard & packed_lhs_hi & packed_lhs_guard & packed_rhs_hi & packed_rhs_guard {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    packed_acc_arithmetic(packed_acc_dst, packed_dst_hi, packed_dst_guard, packed_acc_lhs, packed_lhs_hi, packed_lhs_guard, packed_acc_rhs, packed_rhs_hi, packed_rhs_guard, 1:1);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"SUB2 CE1" packed_ce1_short_dst,packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x89 & packed_ce1_short_dst & packed_acc_lhs & packed_acc_rhs & packed_lhs_hi & packed_rhs_hi {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    packed_ce1_short_dst = packed_lhs_hi - packed_rhs_hi;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"MAX2 CE1" packed_acc_dst,packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x8a & packed_acc_dst & packed_acc_lhs & packed_acc_rhs & packed_dst_hi & packed_dst_guard & packed_lhs_hi & packed_rhs_hi {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    packed_extrema(packed_acc_dst, packed_dst_hi, packed_dst_guard, packed_acc_lhs, packed_lhs_hi, packed_acc_rhs, packed_rhs_hi, 0:1);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"MIN2 CE1" packed_acc_dst,packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x8b & packed_acc_dst & packed_acc_lhs & packed_acc_rhs & packed_dst_hi & packed_dst_guard & packed_lhs_hi & packed_rhs_hi {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    packed_extrema(packed_acc_dst, packed_dst_hi, packed_dst_guard, packed_acc_lhs, packed_lhs_hi, packed_acc_rhs, packed_rhs_hi, 1:1);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"MIN2 CE1" "discard",packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x8b & packed_dst_group=8 & packed_dst_guard & packed_acc_lhs & packed_acc_rhs & packed_lhs_hi & packed_rhs_hi {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    packed_trace(packed_lhs_hi s< packed_rhs_hi, packed_acc_lhs s< packed_acc_rhs);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"ADD2 CE1" packed_acc_dst,"DATA[0xffff]",packed_guard_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x88 & packed_acc_dst & packed_dst_hi & packed_dst_guard & packed_lhs_code=0x4f & packed_guard_rhs {
    local word:2 = *[data]:2 0xffff:2;
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    local negative:1 = word s< 0;
    packed_acc_dst = word + zext(packed_guard_rhs);
    packed_dst_hi = 0 - zext(negative);
    packed_dst_guard = 0 - zext(negative);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"ADD2 CE1" packed_acc_dst,packed_guard_lhs,packed_literal_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x88 & packed_acc_dst & packed_dst_hi & packed_dst_guard & packed_guard_lhs & packed_literal_rhs {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    local negative:1 = packed_literal_rhs s< 0;
    packed_acc_dst = zext(packed_guard_lhs) + packed_literal_rhs;
    packed_dst_hi = 0 - zext(negative);
    packed_dst_guard = 0 - zext(negative);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"SUB2 CE1" "discard",packed_acc_lhs,packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x89 & packed_dst=0x4f & packed_acc_lhs & packed_acc_rhs {
    publish_alu_ce(EST & 0xcfff);
}
:"SUB2 CE1" "RMW1",packed_guard_lhs,packed_guard_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x89 & packed_dst=0x46 & packed_guard_lhs & packed_guard_rhs {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    # Both byte sources are zero-extended; neither contributes to the upper lane.
    packed_guard_lhs = 0;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:"SUB2 CE1" packed_input2_dst,"FF2",packed_acc_rhs is $(PACKED_WIDE_CE1) & packed_opcode=0x89 & packed_input2_dst & packed_lhs_code=0x57 & packed_acc_rhs & packed_rhs_hi & packed_rhs_guard {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <publish>;
    local high:4 = (0 - zext(FF2 s< 0)) - ((zext(packed_rhs_guard) << 16) | zext(packed_rhs_hi));
    packed_acc_rhs = FF2 - packed_acc_rhs;
    packed_rhs_hi = high:2;
    packed_rhs_guard = high(2);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:TRANSFER "R2","A0L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x100422 & transfer_roles_imm { R2 = A0L + transfer_roles_imm; }
:TRANSFER "R2","A1L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1004a2 & transfer_roles_imm { R2 = A1L + transfer_roles_imm; }
:TRANSFER "R2","FF1",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101f22 & transfer_roles_imm { R2 = FF1 + transfer_roles_imm; }
:TRANSFER "R2","LSA1L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x102922 & transfer_roles_imm { R2 = LSA1L + transfer_roles_imm; }
:TRANSFER "R2","LEA1L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1029a2 & transfer_roles_imm { R2 = LEA1L + transfer_roles_imm; }
:TRANSFER "R2","LC1",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x102a22 & transfer_roles_imm { R2 = LC1 + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x100322 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1003a2 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x100722 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1007a2 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x103022 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x103fa2 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "A0L","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101188 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, A0L); }
:TRANSFER "A1L","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101189 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, A1L); }
:TRANSFER "FF1","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011be & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, FF1); }
