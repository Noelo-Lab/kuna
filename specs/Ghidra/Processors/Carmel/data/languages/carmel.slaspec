# Nonvectored TRAP skips one framed issue, but stacks the ordinary resume PC.
trap_resume: word_address is (carmel_issue=2 | carmel_issue=3) & carmel_next_issue_size=3
    [ word_address = (inst_start + 2) & 0xffffff; ] { export *[code]:3 word_address; }
trap_resume: word_address is (((carmel_issue=2 | carmel_issue=3) & carmel_next_issue_size=6) |
    (carmel_issue=1 & carmel_next_issue_size=3))
    [ word_address = (inst_start + 3) & 0xffffff; ] { export *[code]:3 word_address; }
trap_resume: word_address is carmel_issue=1 & carmel_next_issue_size=6
    [ word_address = (inst_start + 4) & 0xffffff; ] { export *[code]:3 word_address; }

macro trap_duplicate(source, duplicate) {
    duplicate = ((TRAPCTX & 3) == source) || (((TRAPCTX >> 2) & 3) == source) ||
                (((TRAPCTX >> 4) & 3) == source);
}

macro push_trap(saved, source) {
    push_link(saved);
    TRAPCTX = (TRAPCTX << 2) | source;
}

macro trap_vector_word(vector, target) {
    local source:1 = vector;
    target = (zext(INTBASE & 0x1fff) << 11) | (zext(source) << 3);
}

:"TRAP 1" "||" nop_right is ((carmel_issue=1 & slot_mode=0 & slot_0_22=0x2bd001); (slot_mode=0 & nop_right)) & link_2_0 & trap_resume {
    local duplicate:1;
    trap_duplicate(1:1, duplicate);
    if (duplicate) goto <ignored>;
    local vectored:1 = TRAPCTX == 0;
    push_trap(link_2_0, 1:1);
    if (!vectored) goto trap_resume;
    local target:4;
    trap_vector_word(1:1, target);
    goto [target];
    <ignored>
}
:"TRAP 2" "||" nop_right is ((carmel_issue=1 & slot_mode=0 & slot_0_22=0x2bd002); (slot_mode=0 & nop_right)) & link_2_0 & trap_resume {
    local duplicate:1;
    trap_duplicate(2:1, duplicate);
    if (duplicate) goto <ignored>;
