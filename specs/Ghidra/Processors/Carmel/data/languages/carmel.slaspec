# Do not materialize a 40-bit C temporary to compare two accumulators.
macro compare_full(lhs_lo, lhs_hi, lhs_guard, rhs_lo, rhs_hi, rhs_guard, shift) {
    local a:8 = sext(lhs_guard) * 0x100000000 + zext(lhs_hi) * 0x10000 + zext(lhs_lo);
    local b:8 = sext(rhs_guard) * 0x100000000 + zext(rhs_hi) * 0x10000 + zext(rhs_lo);
    local delta:8 = a - b;
    local overflow:1 = delta s> 0x7fffffffff || delta s< -0x8000000000;
    local sticky:1 = overflow && ((ECFG & 0xc) == 0);
    local flags:2 = (zext(overflow) << 1) | (zext(sticky) << 2) | (zext(delta == 0) << 3) |
                    (zext((delta & 0x8000000000) != 0) << 4);
    EST = (EST & ~(0x1a << shift)) | (flags << shift);
}
