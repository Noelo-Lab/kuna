# SWAP exchanges one DATA word even when the operand selector names a long.
swap_word_register: swap_reg_lo is wide_0_1<2 & (swap_reg_short_group=0 | swap_reg_short_group=4 | swap_reg_short_group=5 | swap_reg_short_group=7) & swap_reg_lo { export swap_reg_lo; }
# A DATA selector in the second operand can update a pointer, but the
# exchanged value comes from its register alias, not a second DATA read.
swap_word_register: swap_reg_lo is wide_0_1<2 & (swap_reg_short_group=1 | swap_reg_short_group=2 | swap_reg_short_group=3)
    & (swap_register_address=1 | swap_address_group=0 | swap_address_group=8 | swap_address_group=7 | swap_address_group=15 | swap_address_index!=swap_peer_index)
    & swap_reg_lo & wide_0_0 & swap_peer_base & swap_peer_step & swap_peer_modulo & swap_peer_bound & swap_peer_pacfg_shift & swap_peer_modify {
    local stride:2 = 1 + wide_0_0;
    modify_ptr_scaled(swap_peer_base, swap_peer_step, swap_peer_modulo, swap_peer_bound, swap_peer_pacfg_shift, swap_peer_modify, stride);
    export swap_reg_lo;
}
swap_word_register: swap_reg_full is wide_0_1=2 & swap_reg_full_group=1 & swap_reg_full { export swap_reg_full; }
swap_address: "*"^word_address is (wide_2_9=0x86 | wide_2_9=0x87 | wide_2_9=0x8e | wide_2_9=0x8f | swap_address_group=0x1c | swap_address_group=0x1d | swap_address_group=0x1e | swap_address_group=0x1f) [ word_address = 0xffff; ] { export *[const]:2 word_address; }
swap_address: "*"^absolute_data_addr is (swap_address_group=7 | swap_address_group=15) & absolute_data_addr { export *[const]:2 absolute_data_addr; }
swap_address: "*"^swap_base is swap_register_address=0 & wide_7_7=0 & swap_modify & swap_long & swap_base & swap_step & swap_modulo & swap_bound & swap_pacfg_shift {
    local address:2 = swap_base;
    local stride:2 = 1 + swap_long;
    modify_ptr_scaled(swap_base, swap_step, swap_modulo, swap_bound, swap_pacfg_shift, swap_modify, stride);
    export address;
}

:SWAP swap_address,swap_word_register is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_13_22=0x21a & swap_address & swap_word_register {
    build swap_address;
    build swap_word_register;
    local data_word:2 = *[data]:2 swap_address;
    local register_word:2 = swap_word_register;
    swap_word_register = data_word;
    *[data]:2 swap_address = register_word;
    local flags:2 = (EST & 0xffc4) | (zext(data_word == 0) << 3) | (zext(data_word >= 0x8000) << 4);
    local ce1:2;
    local ce2:2;
    unary_ce(CECFG1, flags, CETBL, 0, ce1);
    unary_ce(CECFG2, flags, CETBL, 1, ce2);
    EST = (flags & 0xcfff) | (ce1 << 12) | (ce2 << 13);
}

# The ALU sees 40 bits; use normalized u64 bit patterns, not 5-byte C arithmetic.
macro compact_long_sample(lo, hi, guard, bits) {
    bits = (zext(guard) << 32) | (zext(hi) << 16) | zext(lo);
}
macro compact_long_finish(bits, carry_out, overflow, data_result, mixed, result, flags) {
    local negative:1 = bits >= 0x8000000000;
    local extend:1 = bits > 0x7fffffff && bits < 0xff80000000;
    local auto_limit:1 = (ECFG & 4) != 0;
    local saturated:1 = (ECFG & 0x28) == 8;
    local loss:1 = (overflow || (data_result != 0 && extend)) && !auto_limit && !saturated;
    # Status uses the pre-limit value, including the guard and sign.
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(bits == 0) << 3) | (zext(negative) << 4) | (zext(extend) << 5);
    result = bits;
    if (mixed != 0) goto <limited>;
    if (data_result == 0 || !saturated || !(extend || overflow)) goto <auto>;
    # Saturation sees the sign of the exact sum, before 40-bit wrap.
    negative = negative != overflow;
    goto <clamp>;
  <auto>
    if (!auto_limit || ((((bits >> 31) ^ (bits >> 32)) & 1) == 0)) goto <limited>;
  <clamp>
    result = 0x7fffffff;
    if (!negative) goto <mark_loss>;
    result = 0xff80000000;
  <mark_loss>
    flags = flags | 4;
  <limited>
    # SR1 is a DATA port operation; bit 32 already supplies the new bit 31.
    if (data_result == 0) goto <finish>;
    result = result >> ((ECFG >> 5) & 1);
  <finish>
}

# The unqualified binary ALU routes input selectors through the chosen result bank.
@define WIDE_ALIAS_ALU "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & logic_ce_bank=0"
@define WIDE_ALIAS_ADD "$(WIDE_ALIAS_ALU) & wide_alias_add_op=8"
@define WIDE_ALIAS_XOR "$(WIDE_ALIAS_ALU) & wide_20_22=6 & wide_logic_rmw_op=2"

alias_add_acc_input: "-1" is (wide_alias_add_lhs=0x8e | wide_alias_add_lhs=0xe6 | wide_alias_add_lhs=0xf6) {
    export 0xffffffffff:8;
}
alias_add_acc_input: "FF1" is wide_alias_add_lhs=0xbe {
    local bits:8 = sext(FF1) & 0xffffffffff;
    export bits;
}
alias_add_acc_input: "LSA1" is wide_alias_add_lhs=0xd2 {
    local bits:8 = (zext(LSA1H) << 16) | zext(LSA1L);
    export bits;
}
alias_add_acc_input: "LEA1" is wide_alias_add_lhs=0xd3 {
    local bits:8 = (zext(LEA1H) << 16) | zext(LEA1L);
    export bits;
}
alias_add_acc_input: "A0" is (wide_alias_add_lhs=0xe0 | wide_alias_add_lhs=0xf0) {
    local bits:8;
    compact_long_sample(A0L, A0H, GB0, bits);
    export bits;
}
alias_add_acc_input: "A5" is (wide_alias_add_lhs=0xe5 | wide_alias_add_lhs=0xf5) {
    local bits:8;
    compact_long_sample(A5L, A5H, GB5, bits);
    export bits;
}

macro wide_alias_add(left, right, word, result) {
    local raw:8 = left + right;
    local bits:8 = raw & 0xffffffffff;
    local carry_out:1 = raw >= 0x10000000000;
    local overflow:1 = ((left ^ right) < 0x8000000000) && ((left ^ bits) >= 0x8000000000);
    local flags:2;
    compact_long_finish(bits, carry_out, overflow, 0:1, 0:1, result, flags);
    local narrow_loss:1 = word != 0 && (flags & 0x20) != 0 && (ECFG & 4) == 0 && (ECFG & 0x28) != 8;
    EST = (EST & 0xffc4) | flags | (zext(narrow_loss) << 2);
}

:ADD "A1",alias_add_acc_input,"R0" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x89 & alias_add_acc_input & wide_40_45=0x20 & wide_0_0=1 {
    local rhs:8 = sext(R0) & 0xffffffffff;
    local result:8;
    wide_alias_add(alias_add_acc_input, rhs, 0:1, result);
    A1L = result:2;
    A1H = result(2);
    GB1 = result(4);
}

# The raw selector does not encode the operand-fetch route.
alias_of_word: "OF" is carmel_of_route=1 { export 0:2; }
alias_of_word: "*0xffff" is carmel_of_route=2 {
    local word:2 = *[data]:2 0xffff:2;
    export word;
}
alias_of_word: "*0x0" is carmel_of_route=3 {
    local word:2 = *[data]:2 0:2;
    export word;
}
alias_of_long: "OF" is carmel_of_route=1 { export 0:4; }
alias_of_long: "*0xffff" is carmel_of_route=2 {
    local word:2 = *[data]:2 0xffff:2;
    local value:4 = zext(word);
    export value;
}
alias_of_long: "*0x0" is carmel_of_route=3 {
    local word:2 = *[data]:2 0:2;
    local value:4 = zext(word) | (zext(word) << 16);
    export value;
}

:ADD "A0",alias_of_word,"A3L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x88 & wide_alias_add_lhs=0xe7 & wide_40_45=0x13 & wide_0_0=1 & alias_of_word {
    local lhs:8 = sext(alias_of_word) & 0xffffffffff;
    local rhs:8 = sext(A3L) & 0xffffffffff;
    local result:8;
    wide_alias_add(lhs, rhs, 0:1, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
}

:ADD "long *R0",alias_of_long,"A3L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x40 & wide_alias_add_lhs=0xe6 & wide_40_45=0x13 & wide_0_0=1 & alias_of_long {
    local lhs:8 = zext(alias_of_long);
    local rhs:8 = sext(A3L) & 0xffffffffff;
    local result:8;
    wide_alias_add(lhs, rhs, 0:1, result);
    local upper:2 = R0 + 1;
    *[data]:2 R0 = result:2;
    *[data]:2 upper = result(2);
}

macro wide_alias_r0_word(word) {
    local address:2 = R0;
    word = *[data]:2 address;
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
}

:ADD "GB4","*R0++","A1L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x84 & wide_alias_add_lhs=0x10 & wide_40_45=0x11 & wide_0_0=1 {
    local word:2;
    wide_alias_r0_word(word);
}

:ADD "RMW2","*R0++","A1L" is $(WIDE_ALIAS_ADD) & wide_alias_add_dst=0x87 & wide_alias_add_lhs=0x10 & wide_40_45=0x11 & wide_0_0=1 {
    local word:2;
    wide_alias_r0_word(word);
    local lhs:8 = (sext(word) << 16) & 0xffffffffff;
    local rhs:8 = (sext(A1L) << 16) & 0xffffffffff;
    local result:8;
    wide_alias_add(lhs, rhs, 1:1, result);
    A1L = result(2);
}

:XOR "X1","A2L","long *R4--" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x9e & wide_alias_logic_lhs=0x92 & wide_40_45=0x1c & wide_0_1=1 {
    local low:2;
    local high:2;
    wide_unary_data_read(R4, 2:2, low, high);
    modify_ptr_scaled(R4, RN4, RM4, RL4, 8, 3, 2:2);
    local result:4 = (zext(high) << 16) | zext(low ^ A2L);
    X1 = result:2;
    local flags:2 = (zext(result == 0) << 3) | (zext(high >= 0x8000) << 5);
    commit_logic_flags(flags, 0);
}

:XOR "A0",alias_of_word,"A3L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x88 & wide_alias_logic_lhs=0xe7 & wide_40_45=0x13 & wide_0_1=2 & alias_of_word {
    local word:2 = alias_of_word;
    A0L = word ^ A3L;
    A0H = 0;
    GB0 = 0;
    commit_logic_flags(zext(A0L == 0) << 3, 0);
}

:XOR "*R0",alias_of_word,"A3L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0 & wide_alias_logic_lhs=0xee & wide_40_45=0x13 & wide_0_1=2 & alias_of_word {
    local word:2 = alias_of_word;
    local result:2 = word ^ A3L;
    *[data]:2 R0 = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

:XOR "GB4","*R0++","A1L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x84 & wide_alias_logic_lhs=0x10 & wide_40_45=0x11 & wide_0_1=2 {
    local word:2;
    wide_alias_r0_word(word);
}

:XOR "RMW2","*R0++","A1L" is $(WIDE_ALIAS_XOR) & wide_alias_logic_dst=0x8e & wide_alias_logic_lhs=0x10 & wide_40_45=0x11 & wide_0_1=2 {
    local word:2;
    wide_alias_r0_word(word);
    A1L = word ^ A1L;
    commit_logic_flags(zext(A1L == 0) << 3, 0);
}

# The two-operand logic family reads its destination before publishing the result.
wide_logic_accumulate: "OR" is wide_logic_accumulate_op=0 { export 0:2; }
wide_logic_accumulate: "AND" is wide_logic_accumulate_op=1 { export 1:2; }
wide_logic_accumulate: "XOR" is wide_logic_accumulate_op=2 { export 2:2; }

macro wide_logic_accumulate_flags(result) {
    local flags:2 = (zext(result == 0) << 3) | (zext(result >= 0x8000000000) << 4)
                  | (zext(result > 0x7fffffff && result < 0xff80000000) << 5);
    commit_logic_flags(flags, 0);
}

@define WIDE_LOGIC_ACCUMULATE "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & logic_ce_bank=0 & wide_logic_accumulate_family=0xe & wide_0_1=0"
:^wide_logic_accumulate "A0","A1" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=0x48 & wide_logic_accumulate_src=0x49 {
    local left:8;
    local right:8;
    compact_long_sample(A0L, A0H, GB0, left);
    compact_long_sample(A1L, A1H, GB1, right);
    local result:8;
    wide_logic_bitop(wide_logic_accumulate, left, right, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    wide_logic_accumulate_flags(result);
}
:^wide_logic_accumulate "A0H","A1" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=0x58 & wide_logic_accumulate_src=0x49 {
    local right:8;
    compact_long_sample(A1L, A1H, GB1, right);
    local result:8;
    wide_logic_bitop(wide_logic_accumulate, zext(A0H), right, result);
    A0H = result:2;
    wide_logic_accumulate_flags(result);
}
:^wide_logic_accumulate "GB0","A1" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=0x40 & wide_logic_accumulate_src=0x49 {
    local result:2;
    wide_logic_bitop(wide_logic_accumulate, 0:2, A1H, result);
    GB0 = result:1;
}
:^wide_logic_accumulate "*R0+=RN0","A0L" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=8 & wide_logic_accumulate_src=0x50 {
    local address:2 = R0;
    local left:2 = *[data]:2 address;
    local result:2;
    wide_logic_bitop(wide_logic_accumulate, left, A0L, result);
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    *[data]:2 address = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}
:^wide_logic_accumulate "*R0+=RN0","*R0" is $(WIDE_LOGIC_ACCUMULATE) & wide_logic_accumulate & wide_logic_accumulate_dst=8 & wide_logic_accumulate_src=0 {
    local address:2 = R0;
    local word:2 = *[data]:2 address;
    local result:2;
    wide_logic_bitop(wide_logic_accumulate, word, word, result);
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    *[data]:2 address = result;
    commit_logic_flags(zext(result == 0) << 3, 0);
}

# Immediate address-unit transfers and fixed long strides.
macro transfer_address_word(pointer, modulo, bound, shift, delta, result) {
    local base:2 = pointer;
    local mode:2 = (PACFG >> shift) & 3;
    local candidate:4 = sext(base) + sext(delta);
    if (mode < 2) goto <transfer_done>;

    local size:4;
    local lower:4;
    if (mode == 3) goto <transfer_explicit>;
    local mask:2 = modulo;
    mask = mask | (mask >> 1);
    mask = mask | (mask >> 2);
    mask = mask | (mask >> 4);
    mask = mask | (mask >> 8);
    lower = sext(base & ~mask);
    size = zext(modulo & 0xfff) + 1;
    if (candidate s>= lower && candidate s< lower + size) goto <transfer_done>;
    goto <transfer_wrap>;

  <transfer_explicit>
    candidate = zext(candidate:2);
    lower = zext(bound);
    size = zext(modulo) + 1;
    local limit:4 = lower + size;
    if (limit <= 0x10000 && lower <= candidate && candidate < limit) goto <transfer_done>;
  <transfer_wrap>
    if (delta s< 0) goto <transfer_reverse>;
    candidate = candidate - size;
    goto <transfer_done>;
  <transfer_reverse>
    candidate = candidate + size;
  <transfer_done>
    result = candidate:2;
}

macro wide_adjust_result(left, right, subtract, sticky_enabled, result) {
    local mask:8 = 0xffffffffff;
    local sign:8 = 0x8000000000;
    local lhs:8 = left;
    local rhs:8 = right & mask;
    local raw:8 = lhs + rhs;
    local carry_bit:1 = raw > mask;
    local sign_difference:1 = ((lhs ^ rhs) & sign) != 0;
    local subtracting:1 = subtract;
    if (subtracting == 0) goto <status>;
    raw = lhs - rhs;
    carry_bit = lhs >= rhs;
  <status>
    result = raw & mask;
    local overflow:1 = (sign_difference == subtracting) && (((lhs ^ result) & sign) != 0);
    local flags:2 = zext(carry_bit) | (zext(overflow) << 1)
                  | (zext(overflow && sticky_enabled) << 2) | (zext(result == 0) << 3)
                  | (zext(result >= sign) << 4)
                  | (zext(result > 0x7fffffff && result < 0xff80000000) << 5);
    EST = (EST & 0xffc4) | flags;
}

wide_adjust_high: "ADDH" is wide_adjust_op=5 { export 0:1; }
wide_adjust_high: "SUBH" is wide_adjust_op=1 { export 1:1; }

@define WIDE_ADJUST_CE2 "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1 & wide_13_22=0x210"
:ADDH "CE2" "*R1:long","*R0+="^wide_shift_dst_disp is $(WIDE_ADJUST_CE2) & wide_adjust_op=5 & wide_2_9=0x41 & wide_40_45=0x30 & wide_0_1=0 & wide_shift_dst_disp {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local source:2 = R0;
    local delta:2 = sext(wide_shift_dst_disp:1);
    transfer_address_word(source, RM0, RL0, 0, delta, R0);
    local word:2 = *[data]:2 source;
    if (enabled == 0) goto <finish>;
    local right:8 = (zext(word) << 16) | ((0 - zext(word >= 0x8000)) & 0xff00000000);
    local result:8;
    wide_adjust_result(zext(R1), right, 0:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:ADDL "CE2" "*R1+="^wide_shift_dst_disp^":long","*R0+="^wide_shift_count_disp is $(WIDE_ADJUST_CE2) & wide_adjust_op=4 & wide_2_9=0x71 & wide_40_45=0x30 & wide_0_1=0 & wide_shift_dst_disp & wide_shift_count_disp {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local destination:2 = R1;
    local source:2 = R0;
    local destination_delta:2 = sext(wide_shift_dst_disp:1);
    local source_delta:2 = sext(wide_shift_count_disp:1);
    transfer_address_word(destination, RM0, RL0, 2, destination_delta, R1);
    transfer_address_word(source, RM0, RL0, 0, source_delta, R0);
    local word:2 = *[data]:2 source;
    if (enabled == 0) goto <finish>;
    local result:8;
    wide_adjust_result(zext(destination), zext(word), 0:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:^wide_adjust_high "CE2" "*R1:long","*R0:long" is $(WIDE_ADJUST_CE2) & wide_adjust_high & wide_2_9=0x41 & wide_40_45=0 & wide_0_1=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local low:2;
    local high:2;
    wide_unary_data_read(R0, 2:2, low, high);
    if (enabled == 0) goto <finish>;
    local word:4 = zext(low) | (zext(high) << 16);
    local result:8;
    wide_adjust_result(zext(R1), sext(word), wide_adjust_high, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:ADDH "CE2" "A0","*R0:long" is $(WIDE_ADJUST_CE2) & wide_adjust_op=5 & wide_2_9=0x88 & wide_40_45=0 & wide_0_1=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local low:2;
    local high:2;
    wide_unary_data_read(R0, 2:2, low, high);
    if (enabled == 0) goto <finish>;
    local word:4 = zext(low) | (zext(high) << 16);
    local left:8;
    compact_long_sample(A0L, A0H, GB0, left);
    local result:8;
    wide_adjust_result(left, sext(word), 0:1, 1:1, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}
:SUBL "CE2" "*R1++",wide_load_literal is $(WIDE_ADJUST_CE2) & wide_adjust_op=0 & (wide_2_9=0x11 | wide_2_9=0x51) & wide_40_45=0xf & wide_0_1=2 & wide_adjust_long_dst & wide_load_literal {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <finish>;
    local destination:2 = R1;
    local stride:2 = wide_adjust_long_dst + 1;
    modify_ptr_scaled(R1, RN1, RM0, RL0, 2, 2, stride);
    if (enabled == 0) goto <finish>;
    local result:8;
    wide_adjust_result(zext(destination), zext(wide_load_literal), 1:1, 1:1, result);
  <finish>
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_ROUTED_ALU "wide_left_mode=1 & wide_right_mode=1 & carmel_issue=5"

macro wide_adjust_immediate_a0(operand, subtract) {
    local original:8;
    compact_long_sample(A0L, A0H, GB0, original);
    local result:8;
    local sticky_enabled:1 = (ECFG & 0xc) == 0;
    wide_adjust_result(original, operand, subtract, sticky_enabled, result);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_ADJUST_IMMEDIATE "$(WIDE_ROUTED_ALU) & wide_40_45=0xf & wide_load_literal_bits"
:ADDL "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x421222 {
    local operand:8 = zext(wide_load_literal_bits:2);
    wide_adjust_immediate_a0(operand, 0:1);
}
:ADDH "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x421622 {
    local operand:8 = sext(wide_load_literal_bits:2) * 0x10000;
    wide_adjust_immediate_a0(operand, 0:1);
}
:SUBL "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x420222 {
    local operand:8 = zext(wide_load_literal_bits:2);
    wide_adjust_immediate_a0(operand, 1:1);
}
:SUBH "A0",wide_load_literal_bits is $(WIDE_ADJUST_IMMEDIATE) & wide_0_22=0x420622 {
    local operand:8 = sext(wide_load_literal_bits:2) * 0x10000;
    wide_adjust_immediate_a0(operand, 1:1);
}
@undef WIDE_ADJUST_IMMEDIATE

# Inputs have already been widened or aligned by their physical ports.
macro wide_routed_arithmetic(left, right, adjust, subtract, word_result, data_result, result) {
    local mask:8 = 0xffffffffff;
    local sign:8 = 0x8000000000;
    local lhs:8 = left & mask;
    local rhs:8 = right & mask;
    local carry_in:8 = zext(adjust);
    local signed_lhs:8 = lhs - ((lhs & sign) << 1);
    local signed_rhs:8 = rhs - ((rhs & sign) << 1);
    local raw:8;
    local exact:8;
    if (subtract != 0) goto <difference>;
    raw = lhs + rhs + carry_in;
    exact = signed_lhs + signed_rhs + carry_in;
    goto <finish>;
  <difference>
    raw = lhs + (mask ^ rhs) + 1 - carry_in;
    exact = signed_lhs - signed_rhs - carry_in;
  <finish>
    local bits:8 = raw & mask;
    local overflow:1 = exact != bits - ((bits & sign) << 1);
    local flags:2;
    compact_long_finish(bits, raw > mask, overflow, 0:1, 0:1, result, flags);
    if (word_result == 0 || (bits >> 16) != 0) goto <limit>;
    flags = flags | 8;
  <limit>
    if ((word_result == 0 && data_result == 0) || (flags & 0x20) == 0 || (ECFG & 4) != 0) goto <publish>;
    if ((ECFG & 0x28) != 8) goto <mark_loss>;
    if (data_result == 0) goto <publish>;
    result = 0x7fffffff;
    if ((flags & 0x10) == 0) goto <mark_loss>;
    result = 0xff80000000;
  <mark_loss>
    flags = flags | 4;
  <publish>
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:ADDC2 "*"^absolute_data_addr,"MINMAX","GB1" is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=0xd & wide_alias_add_dst=0x3b & wide_alias_add_lhs=0xba & wide_40_45=1 & wide_0_0=1 & absolute_data_addr {
    local left:8 = sext(MINMAX);
    local right:8 = zext(GB1);
    local result:8;
    local carry_set:1 = (EST & 0x40) != 0;
    wide_routed_arithmetic(left, right, carry_set, 0:1, 1:1, 1:1, result);
    local address:2 = absolute_data_addr;
    *[data]:2 address = result(2);
}

# The extended source selector supplies a DATA route, not the extra word.
round_extended: "DATA" is wide_0_1=3 & wide_40_45>=0x20 {}
round_high_address: "A0L" is carmel_of_route=2 { export A0L; }
round_high_address: "0" is carmel_of_route=3 { export 0:2; }

round_gate: "" is carmel_issue=5 & wide_left_mode=1 { export 3:2; }
round_gate: "CE1" is carmel_issue=4 & wide_left_mode=0 & unary_wide_ce_bank=0 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local gate:2 = enabled | ((CECFG1 >> 11) & 2);
    export gate;
}
round_gate: "CE2" is carmel_issue=4 & wide_left_mode=0 & unary_wide_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local gate:2 = enabled | ((CECFG2 >> 11) & 2);
    export gate;
}

macro wide_round_write_long(address, low, high, flags) {
    local scale:4 = zext((ECFG >> 5) & 1);
    local bits:4 = zext(high);
    local upper:4 = bits >> scale;
    local midpoint:1 = low == 0x8000;
    local above:1 = low > 0x8000;
    if (scale == 0) goto <apply_round>;
    local extra_bit:1 = (high & 1) != 0;
    midpoint = extra_bit && low == 0;
    above = extra_bit && low != 0;
  <apply_round>
    local increment:1 = above || (midpoint && ((ECFG & 2) == 0 || (upper & 1) != 0));
    upper = upper + zext(increment);
    # A signed 32-bit input can extend positively, but cannot overflow the 40-bit adder.
    local sign:4 = 0x8000 >> scale;
    local carry_out:1 = upper == sign * 2;
    local negative:1 = high >= 0x8000 && !carry_out;
    local extend:1 = high < 0x8000 && upper == sign;
    flags = zext(carry_out) | (zext(upper == 0 || carry_out) << 3) |
            (zext(negative) << 4) | (zext(extend) * 0x24);
    if (!extend || ((ECFG & 4) == 0 && (ECFG & 0x28) != 8)) goto <store>;
    upper = sign - 1;
  <store>
    local word:4 = (upper & (sign * 2 - 1)) | (zext(negative) * scale << 15);
    local second:2 = address + 1;
    *[data]:2 address = 0;
    *[data]:2 second = word:2;
}

@define WIDE_ROUND_DATA "wide_right_mode=1 & wide_10_22=0x10b6 & round_gate"
:ROUND round_gate "long *R1+=RN1",round_extended^":"^round_high_address is $(WIDE_ROUND_DATA) & wide_2_9=0x49 & round_extended & round_high_address {
    local gate:2 = round_gate;
    local flags:2 = EST & 0x3f;
    if (gate == 0) goto <done>;
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    if ((gate & 1) == 0) goto <done>;
    local low:2 = *[data]:2 0xffff:2;
    local high:2 = *[data]:2 round_high_address;
    wide_round_write_long(address, low, high, flags);
  <done>
    publish_alu_ce((EST & 0xcfc0) | flags);
}

:ROUND round_gate "long *R1+=RN1","long *R1" is $(WIDE_ROUND_DATA) & wide_2_9=0x49 & wide_40_45=1 & wide_0_1=1 {
    local gate:2 = round_gate;
    local flags:2 = EST & 0x3f;
    if (gate == 0) goto <done>;
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    if ((gate & 1) == 0) goto <done>;
    local low:2;
    local high:2;
    wide_unary_data_read(address, 2:2, low, high);
    wide_round_write_long(address, low, high, flags);
  <done>
    publish_alu_ce((EST & 0xcfc0) | flags);
}

:ROUND round_gate "*R1+=RN1",round_extended is $(WIDE_ROUND_DATA) & wide_2_9=9 & round_extended {
    local gate:2 = round_gate;
    local flags:2 = EST & 0x3f;
    if (gate == 0) goto <done>;
    local address:2 = R1;
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    if ((gate & 1) == 0) goto <done>;
    local word:2 = *[data]:2 0xffff:2;
    *[data]:2 address = word;
    flags = (zext(word == 0) << 3) | (zext(word >= 0x8000) << 4);
  <done>
    publish_alu_ce((EST & 0xcfc0) | flags);
}

# These implicit DATA operands need established OF context, not a CODE-address guess.
:SUBRC1 "CE1" "long *R1+="^wide_shift_dst_disp,"*R3+RN3",alias_of_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & logic_ce_bank=0 & wide_alias_add_op=3 & wide_alias_add_dst=0x71 & wide_alias_add_lhs=0xf5 & wide_40_45=0x2b & wide_0_0=0 & wide_shift_dst_disp & carmel_of_route=2 & alias_of_word {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local destination:2 = R1;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <veto>;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(R1, displacement, RM0, RL0, 2, 4);
    if (enabled == 0) goto <veto>;
    build alias_of_word;
    local source:2 = R3 + RN3;
    local low:2 = *[data]:2 source;
    local high:2 = *[data]:2 0:2;
    local first:4 = zext(low) | (zext(high) << 16);
    local left:8 = sext(alias_of_word);
    local right:8 = (zext(first) ^ 0x80000000) - 0x80000000;
    local result:8;
    local carry_clear:1 = (EST & 1) == 0;
    wide_routed_arithmetic(left, right, carry_clear, 1:1, 0:1, 1:1, result);
    *[data]:2 destination = result:2;
    local upper:2 = destination + 1;
    *[data]:2 upper = result(2);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:ADDABS "SP","RL6","RL0" is $(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0xb & wide_alias_add_dst=0xbb & wide_alias_add_lhs=0xe5 & wide_40_45=0x30 & wide_0_0=1 {
    local left:8 = (zext(RL6) ^ 0x8000) - 0x8000;
    if (RL6 < 0x8000) goto <positive>;
    left = 0 - left;
  <positive>
    left = (left & 0xffffffffff) << 16;
    local right:8 = (zext(RL0) ^ 0x8000) - 0x8000;
    right = (right & 0xffffffffff) << 16;
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 0:1, 1:1, 0:1, result);
    SP = result(2);
}

:ADDC2 "RM6","FF1","X2" is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=0xd & wide_alias_add_dst=0xb7 & wide_alias_add_lhs=0xee & wide_40_45=0x1f & wide_0_0=1 {
    local left:8 = (sext(FF1) & 0xffffffffff) << 16;
    local right:8 = (sext(X2) & 0xffffffffff) << 16;
    local result:8;
    local carry_set:1 = (EST & 0x40) != 0;
    wide_routed_arithmetic(left, right, carry_set, 0:1, 1:1, 0:1, result);
    RM6 = result(2);
}

:SUBC1 "*"^absolute_data_addr,"*R4++",alias_of_word is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=2 & wide_alias_add_dst=0x3a & wide_alias_add_lhs=0xfa & wide_40_45=0x14 & wide_0_0=0 & absolute_data_addr & carmel_of_route=2 & alias_of_word {
    local address:2 = R4;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local word:2 = *[data]:2 address;
    local left:8 = (sext(word) & 0xffffffffff) << 16;
    local right:8 = (sext(alias_of_word) & 0xffffffffff) << 16;
    local result:8;
    local carry_clear:1 = (EST & 1) == 0;
    local word_adjust:4 = zext(carry_clear) << 16;
    wide_routed_arithmetic(left, right, word_adjust, 1:1, 1:1, 1:1, result);
    local destination:2 = absolute_data_addr;
    *[data]:2 destination = result(2);
}

:SUBRC1 "long *R4--","A2","long *R0" is $(WIDE_ROUTED_ALU) & logic_ce_bank=1 & wide_alias_add_op=3 & wide_alias_add_dst=0x5c & wide_alias_add_lhs=0x40 & wide_40_45=0xa & wide_0_0=1 {
    local destination:2 = R4;
    modify_ptr_scaled(R4, RN4, RM4, RL4, 8, 3, 2:2);
    local low:2;
    local high:2;
    wide_unary_data_read(R0, 2:2, low, high);
    local input:4 = zext(low) | (zext(high) << 16);
    local right:8 = (zext(input) ^ 0x80000000) - 0x80000000;
    local left:8;
    compact_long_sample(A2L, A2H, GB2, left);
    local result:8;
    local carry_clear:1 = (EST & 1) == 0;
    wide_routed_arithmetic(left, right, carry_clear, 1:1, 0:1, 1:1, result);
    *[data]:2 destination = result:2;
    local upper:2 = destination + 1;
    *[data]:2 upper = result(2);
}

:SUB "PSTATUS","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0 & wide_alias_add_dst=0xd5 & wide_alias_add_lhs=0x30 & wide_40_45=0x2f & wide_0_0=1 & wide_shift_dst_disp {
    local address:2 = R0;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    modify_ptr(R0, displacement, RM0, RL0, 0, 4);
    local word:2 = *[data]:2 address;
    publish_alu_ce(EST & 0xcfff);
}

macro wide_sub_r0_disp(displacement, word) {
    local address:2 = R0;
    modify_ptr(R0, displacement, RM0, RL0, 0, 4);
    word = *[data]:2 address;
}

macro wide_sub_word(lhs, rhs, to_data, word) {
    local left:8 = (sext(lhs) & 0xffffff) << 16;
    local right:8 = (sext(rhs) & 0xffffff) << 16;
    local result:8;
    wide_routed_arithmetic(left, right, 0:1, 1:1, 1:1, to_data, result);
    word = result(2);
}

# Direct USER_IO has no result or flag port, but still fetches DATA.
# The IO selector instead drives the word flags without doing an IO access.
@define WIDE_SUB_R0_RN7 "$(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0 & wide_alias_add_lhs=0x30 & wide_40_45=0x2f & wide_0_0=1 & wide_shift_dst_disp"
:SUB "USER_IO","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_SUB_R0_RN7) & wide_alias_add_dst=0xd7 {
    local word:2;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    wide_sub_r0_disp(displacement, word);
    publish_alu_ce(EST & 0xcfff);
}
:SUB "INTBASE","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_SUB_R0_RN7) & wide_alias_add_dst=0xd6 {
    local word:2;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    wide_sub_r0_disp(displacement, word);
    wide_sub_word(word, RN7, 0:1, INTBASE);
}
:SUB "IO","*R0+="^wide_shift_dst_disp,"RN7" is $(WIDE_SUB_R0_RN7) & wide_alias_add_dst=0xd8 {
    local word:2;
    local discarded:2;
    local displacement:2 = sext(wide_shift_dst_disp:1);
    wide_sub_r0_disp(displacement, word);
    wide_sub_word(word, RN7, 0:1, discarded);
}

macro wide_control_word(value, word) {
    local bits:8 = value & 0xffffffffff;
    word = bits(2);
    if ((ECFG & 4) == 0 || ((bits ^ (bits >> 1)) & 0x80000000) == 0) goto <done>;
    word = 0x7fff + zext(bits >= 0x8000000000);
  <done>
}

# The control aliases take the high word of an unaligned subtraction,
# including the borrow from the low bits, without changing ALU flags.
macro wide_sub_control(lhs, rhs, word) {
    local difference:8 = sext(lhs) - rhs;
    wide_control_word(difference, word);
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_SUB_RMW "$(WIDE_ROUTED_ALU) & logic_ce_bank=0 & wide_alias_add_op=0 & wide_alias_add_dst=0x86 & wide_0_0=1"
:SUB "PSTATUS","PSTATUS","RN7" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd5 & wide_40_45=0x2f {
    local word:2;
    wide_sub_control(PSTATUS, sext(RN7), word);
    wide_logic_rmw_pstatus(word);
}
:SUB "PSTATUS","PSTATUS","A0" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd5 & wide_40_45=8 {
    local source:8;
    compact_long_sample(A0L, A0H, GB0, source);
    local word:2;
    wide_sub_control(PSTATUS, source, word);
    wide_logic_rmw_pstatus(word);
}
:SUB "USER_IO","USER_IO","RN7" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd7 & wide_40_45=0x2f {
    wide_sub_control(USER_IO, sext(RN7), USER_IO);
}
:SUB "USER_IO","USER_IO","A0" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0xd7 & wide_40_45=8 {
    local source:8;
    compact_long_sample(A0L, A0H, GB0, source);
    wide_sub_control(USER_IO, source, USER_IO);
}
:SUB "*R0++","*R0++","RN7" is $(WIDE_SUB_RMW) & wide_alias_add_lhs=0x10 & wide_40_45=0x2f {
    local address:2 = R0;
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
    local word:2 = *[data]:2 address;
    local result:2;
    wide_sub_word(word, RN7, 1:1, result);
    *[data]:2 address = result;
}

macro compact_rmw_r3(cfg, bank, address, enabled) {
    address = R3;
    local ce_bank:2 = zext(bank);
    unary_ce(cfg, EST, CETBL, ce_bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <done>;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
  <done>
}

macro compact_rmw_half(cfg, bank, subtract, write_half, store) {
    local enabled:2;
    local address:2;
    compact_rmw_r3(cfg, bank, address, enabled);
    if (enabled == 0) goto <done>;
    local word:2 = *[data]:2 address;
    local mask:8 = 0xffffffffff;
    local a:8 = (sext(A5H) << 16) & mask;
    local b:8 = (sext(word) << 16) & mask;
    local raw:8 = a + b;
    if (subtract == 0) goto <finish>;
    raw = a + ((~b) & mask) + 1;
  <finish>
    local result:8;
    local flags:2;
    compact_long_finish(raw & mask, raw > mask, 0:1, store, 0:1, result, flags);
    if (store != 0) goto <data_writeback>;
    if ((flags & 0x20) == 0 || (ECFG & 0x28) == 8) goto <write_register>;
    flags = flags | 4;
  <write_register>
    if (write_half == 0) goto <status>;
    A5H = result(2);
    goto <status>;
  <data_writeback>
    *[data]:2 address = result(2);
  <status>
    local shift:4 = zext(bank) * 6;
    local status_bits:2 = (EST & ~(0x3000 | (0x3b << shift))) | (flags << shift);
    publish_alu_ce(status_bits);
  <done>
}

macro compact_rmw_register(cfg, bank, target, connected) {
    local enabled:2;
    local address:2;
    compact_rmw_r3(cfg, bank, address, enabled);
    if (enabled == 0) goto <done>;
    local value:2 = *[data]:2 address;
    if (connected == 0) goto <status>;
    target = target + value;
  <status>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

:"ADD" "CE1" "RMW1","A5H","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10b757); (slot_mode=0 & nop_right) { compact_rmw_half(CECFG1, 0:1, 0:1, 0:1, 0:1); }
:^nop_left "||" "ADD" "CE2" "RMW1","A5H","*R3+=RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x10b757) { compact_rmw_half(CECFG2, 1:1, 0:1, 1:1, 0:1); }
:"ADD" "CE1" "RMW1","A5H","*R3+=RN3" is carmel_issue=2 & slot_mode=1 & slot_0_22=0x10b757 { compact_rmw_half(CECFG1, 0:1, 0:1, 1:1, 0:1); }
:"ADD" "CE1" "RMW2","A5H","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10bf57); (slot_mode=0 & nop_right) { compact_rmw_half(CECFG1, 0:1, 0:1, 0:1, 1:1); }
:"SUB" "CE1" "RMW1","A5H","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0xb757); (slot_mode=0 & nop_right) { compact_rmw_half(CECFG1, 0:1, 1:1, 0:1, 0:1); }
:^nop_left "||" "SUB" "CE2" "RMW1","A5H","*R3+=RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0xb757) { compact_rmw_half(CECFG2, 1:1, 1:1, 1:1, 0:1); }
:"ADD" "CE1" "RMW1","R0","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10b017); (slot_mode=0 & nop_right) { compact_rmw_register(CECFG1, 0:1, R0, 0:1); }
:^nop_left "||" "ADD" "CE2" "RMW1","R0","*R3+=RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x10b017) { compact_rmw_register(CECFG2, 1:1, R0, 1:1); }
:"ADD" "CE1" "RMW1","FF1","*R3+=RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x10b597); (slot_mode=0 & nop_right) { compact_rmw_register(CECFG1, 0:1, FF1, 1:1); }
:"ADD" "CE1" "RMW1","RN1","*R2+RN2" is carmel_issue=2 & slot_mode=1 & slot_0_22=0x136c95 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <done>;
    local address:2 = R2 + RN2;
    local value:2 = *[data]:2 address;
    RN1 = RN1 + value;
    publish_alu_ce(EST & 0xcfff);
  <done>
}

# Selector 14 uses the physical ALU's latch; selector 15 explicitly uses X2.
x_alu_primary_rhs: "X1" is slot_1_4=14 { export X1; }
x_alu_primary_rhs: "X2" is slot_1_4=15 { export X2; }
x_alu_secondary_rhs: "X2" is (slot_1_4=14 | slot_1_4=15) { export X2; }
x_alu_secondary_lhs: "X2" is (slot_6_9=14 | slot_6_9=15) { export X2; }

macro compact_x_sum(lhs, rhs, sum, flags) {
    sum = sext(lhs) + sext(rhs);
    local lhs_negative:1 = lhs >= 0x8000;
    local rhs_negative:1 = rhs >= 0x8000;
    local negative:1 = sum s< 0;
    # Carry from sign-extended inputs requires two negatives, or a
    # negative plus a nonnegative whose sum reaches zero.
    local carry_out:1 = (lhs_negative && rhs_negative) || (!negative && (lhs_negative || rhs_negative));
    flags = zext(carry_out) | (zext(sum == 0) << 3) | (zext(negative) << 4);
}

macro compact_x_add_half(target, lhs, rhs, cfg, bank) {
    local enabled:2;
    local status:2 = EST & 0xcfff;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0) goto <feedback>;
    local sum:4;
    local flags:2;
    compact_x_sum(lhs, rhs, sum, flags);
    target = sum:2;
    # A half sees the signed sum above bit 16: E and sticky L describe
    # the discarded extension, not the sign bit of the truncated word.
    if (sum s>= -0x8000 && sum s<= 0x7fff) goto <publish>;
    flags = flags | 0x20;
    if ((ECFG & 4) == 0) goto <unlimited>;
    target = 0x7fff + zext(sum s< 0);
    flags = flags | 4;
    goto <publish>;
  <unlimited>
    if ((ECFG & 0x28) == 8) goto <publish>;
    flags = flags | 4;
  <publish>
    local shift:4 = zext(bank) * 6;
    status = (status & ~(0x3b << shift)) | (flags << shift);
  <feedback>
    publish_alu_ce(status);
}

macro compact_x_add_acc(lo, hi, guard, lhs, rhs) {
    local enabled:2;
    local status:2 = EST & 0xcfff;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <feedback>;
    local sum:4;
    local flags:2;
    compact_x_sum(lhs, rhs, sum, flags);
    lo = sum:2;
    hi = 0 - zext(sum s< 0);
    guard = hi:1;
    status = (status & ~(0x3b << 6)) | (flags << 6);
  <feedback>
    publish_alu_ce(status);
}

macro compact_x_or_acc(lo, hi, guard, lhs, rhs) {
    local enabled:2;
    local status:2 = EST & 0xcfff;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <feedback>;
    local word:2 = lhs | rhs;
    lo = word;
    hi = 0;
    guard = 0;
    status = (status & ~(0x38 << 6)) | (zext(word == 0) << 9);
  <feedback>
    publish_alu_ce(status);
}

@define X_ALU_ADD_HALF "slot_14_22=0x48 & slot_0_0=1 & slot_10_12<6 & x_alu_half_dst & parallel_word_src>=16 & slot_5_7<6 & x_alu_half_src"
@define X_ALU_ACC "slot_mode=0 & slot_0_0=1 & slot_10_12<6 & x_alu_acc & x_alu_acc_lo & x_alu_acc_hi & x_alu_acc_gb & x_alu_secondary_lhs & slot_1_5<30 & logical_right"

:ADD "CE1" x_alu_half_dst,x_alu_half_src,x_alu_primary_rhs is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & $(X_ALU_ADD_HALF) & x_alu_primary_rhs { compact_x_add_half(x_alu_half_dst, x_alu_half_src, x_alu_primary_rhs, CECFG1, 0:2); }
:ADD "CE1" x_alu_half_dst,x_alu_half_src,x_alu_primary_rhs "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(X_ALU_ADD_HALF) & x_alu_primary_rhs); (slot_mode=0 & nop_right) { compact_x_add_half(x_alu_half_dst, x_alu_half_src, x_alu_primary_rhs, CECFG1, 0:2); }
:^nop_left "||" "ADD" "CE2" x_alu_half_dst,x_alu_half_src,x_alu_secondary_rhs is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(X_ALU_ADD_HALF) & x_alu_secondary_rhs) { compact_x_add_half(x_alu_half_dst, x_alu_half_src, x_alu_secondary_rhs, CECFG2, 1:2); }
:^nop_left "||" "ADD" "CE2" x_alu_acc,x_alu_secondary_lhs,logical_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_13_22=0x94 & $(X_ALU_ACC)) { compact_x_add_acc(x_alu_acc_lo, x_alu_acc_hi, x_alu_acc_gb, x_alu_secondary_lhs, logical_right); }
:^nop_left "||" "OR" "CE2" x_alu_acc,x_alu_secondary_lhs,logical_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_13_22=0x354 & $(X_ALU_ACC)) { compact_x_or_acc(x_alu_acc_lo, x_alu_acc_hi, x_alu_acc_gb, x_alu_secondary_lhs, logical_right); }

# The logical RMW1 result bus reaches accumulator halves, but the
# address/increment and FF word ports receive zero without ALU status.
macro compact_logic_rmw1_zero(target, cfg, bank, address, qualified) {
    local enabled:2 = 1;
    if (qualified == 0) goto <fetch>;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <done>;
  <fetch>
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <done>;
    target = 0;
  <done>
}

macro compact_logic_rmw_word(target, cfg, bank, address, op, to_data) {
    local enabled:2;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (enabled == 0 && (cfg & 0x1000) == 0) goto <status>;
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <status>;
    local result:2;
    wide_logic_bitop(op, target, word, result);
    if (to_data != 0) goto <store>;
    target = result;
    goto <publish_flags>;
  <store>
    *[data]:2 address = result;
  <publish_flags>
    local shift:4 = zext(bank) * 6;
    local flags:2 = zext(result == 0) << 3;
    commit_logic_flags(flags, shift);
  <status>
    publish_alu_ce(EST & 0xcfff);
}

:"ADDC" "*R5+=RN5","A4H","*R5+RN5" "||" "OR" "RMW1","R2","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x175bca); (slot_mode=0 & slot_0_22=0x6b6c26) {
    local destination:2 = R5;
    local left_address:2 = R5 + RN5;
    local right_address:2 = R3 + RN3;
    modify_ptr(R5, RN5, RM4, RL4, 10, 1);
    local word:2 = *[data]:2 left_address;
    local mask:8 = 0xffffffffff;
    local a:8 = (sext(A4H) << 16) & mask;
    local b:8 = (sext(word) << 16) & mask;
    local raw:8 = a + b + (zext(EST & 1) << 16);
    local result:8;
    local flags:2;
    compact_long_finish(raw & mask, raw > mask, 0:1, 0:1, 0:1, result, flags);
    if ((flags & 0x20) == 0) goto <publish>;
    if ((ECFG & 0x28) != 8) goto <loss>;
    result = 0x7fffffff;
    if ((flags & 0x10) == 0) goto <loss>;
    result = 0xff80000000;
  <loss>
    flags = flags | 4;
  <publish>
    compact_logic_rmw1_zero(R2, CECFG2, 1, right_address, 0:1);
    *[data]:2 destination = result(2);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

:^nop_left "||" "OR" "CE2" "RMW1","R2","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x6b6c27) {
    local address:2 = R3 + RN3;
    compact_logic_rmw1_zero(R2, CECFG2, 1, address, 1:1);
    publish_alu_ce(EST & 0xcfff);
}
:"OR" "CE1" "RMW1","RN2","*R3+RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6b6ca7); (slot_mode=0 & nop_right) {
    local address:2 = R3 + RN3;
    compact_logic_rmw1_zero(RN2, CECFG1, 0, address, 1:1);
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" "OR" "CE2" "RMW1","FF1","*R2" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x68b585) {
    local address:2 = R2;
    compact_logic_rmw1_zero(FF1, CECFG2, 1, address, 1:1);
    publish_alu_ce(EST & 0xcfff);
}
:^nop_left "||" "AND" "CE2" "RMW1","A2L","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x636d27) {
    local address:2 = R3 + RN3;
    compact_logic_rmw_word(A2L, CECFG2, 1:2, address, 1:2, 0:1);
}
:"XOR" "CE1" "RMW1","A2L","*R3+RN3" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x6f6d27); (slot_mode=0 & nop_right) {
    local address:2 = R3 + RN3;
    compact_logic_rmw_word(A2L, CECFG1, 0:2, address, 2:2, 0:1);
}
:"OR" "CE1" "RMW1","A2L","*R2" is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & slot_0_22=0x68b485 {
    local address:2 = R2;
    compact_logic_rmw_word(A2L, CECFG1, 0:2, address, 0:2, 0:1);
}
:^nop_left "||" "OR" "CE2" "RMW2","R2","*R3+RN3" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x6b6e27) {
    local address:2 = R3 + RN3;
    compact_logic_rmw_word(R2, CECFG2, 1:2, address, 0:2, 1:1);
}

# Covered parallel logic lanes. Address override drives the AGU and OF
# even when CE vetoes the result. The next postmodify can use that AGU value.
macro parallel_logic_access(cfg, bank, enabled, access) {
    unary_ce(cfg, EST, CETBL, bank, enabled);
    access = enabled != 0 || ((cfg & 0x1000) != 0);
}

macro parallel_or_r6(cfg, bank, result, enabled) {
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local address:2 = R6;
    modify_ptr(R6, 0:2, RM6, RL6, 12, 2);
    local word:2 = *[data]:2 address;
    result = word | R2;
  <done>
}

macro parallel_or_r5(cfg, bank, result, enabled) {
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local address:2 = R5;
    modify_ptr(R5, 0:2, RM4, RL4, 10, 2);
    local first:2 = *[data]:2 R7;
    local second:2 = *[data]:2 address;
    result = first | second;
  <done>
}

macro parallel_xor_r4_r6(cfg, bank, result, enabled) {
    local access:1;
    parallel_logic_access(cfg, bank, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local first_address:2 = R4;
    local second_address:2 = R6;
    modify_ptr(R4, RN4, RM4, RL4, 8, 1);
    modify_ptr(R6, 0:2, RM6, RL6, 12, 2);
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    result = first ^ second;
  <done>
}

macro parallel_xor_r5(result, enabled) {
    local access:1;
    parallel_logic_access(CECFG2, 1:2, enabled, access);
    result = 0;
    if (!access) goto <done>;
    local address:2 = R5;
    modify_ptr(R5, 0:2, RM4, RL4, 10, 3);
    local word:2 = *[data]:2 address;
    result = R7 ^ word;
  <done>
}

macro parallel_logic_status(result, shift) {
    local flags:2 = zext(result == 0) << 3;
    commit_logic_flags(flags, shift);
}

# WB results are already visible when register contention stops the issue.
# Neither status publication nor the next issue belongs to the stop path.
define pcodeop carmel_register_write_conflict;
macro parallel_logic_conflict() {
  <stopped>
    carmel_register_write_conflict();
    goto <stopped>;
}

macro parallel_logic_full_half(half, full_cfg, full_bank, half_cfg, half_bank, shares) {
    local full_result:2;
    local half_result:2;
    local full_enabled:2;
    local half_enabled:2;
    parallel_or_r6(full_cfg, full_bank, full_result, full_enabled);
    parallel_or_r5(half_cfg, half_bank, half_result, half_enabled);
    if (full_enabled == 0) goto <half_only>;
    A2L = full_result;
    A2H = 0;
    GB2 = 0;
    if (shares && half_enabled != 0) goto <conflict>;
    parallel_logic_status(full_result, 6 * full_bank);
  <half_only>
    if (half_enabled == 0) goto <status>;
    half = half_result;
    parallel_logic_status(half_result, 6 * half_bank);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_halves() {
    local left:2;
    local right:2;
    local ce1:2;
    local ce2:2;
    parallel_or_r5(CECFG1, 0:2, left, ce1);
    parallel_or_r5(CECFG2, 1:2, right, ce2);
    if (ce1 == 0) goto <right_port>;
    A2H = left;
  <right_port>
    if (ce2 == 0) goto <left_status>;
    A2L = right;
    if (ce1 != 0) goto <conflict>;
    parallel_logic_status(right, 6);
  <left_status>
    if (ce1 == 0) goto <status>;
    parallel_logic_status(left, 0);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_xor_pair(acc_half, shares) {
    local left:2;
    local right:2;
    local ce1:2;
    local ce2:2;
    parallel_xor_r4_r6(CECFG1, 0:2, left, ce1);
    parallel_xor_r5(right, ce2);
    if (ce1 == 0) goto <right_port>;
    acc_half = left;
  <right_port>
    if (ce2 == 0) goto <left_status>;
    X2 = right;
    if (shares && ce1 != 0) goto <conflict>;
    parallel_logic_status(right, 6);
  <left_status>
    if (ce1 == 0) goto <status>;
    parallel_logic_status(left, 0);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_ff12_pair() {
    local left:2;
    local right:2;
    local ce1:2;
    local ce2:2;
    parallel_or_r6(CECFG1, 0:2, left, ce1);
    parallel_or_r6(CECFG2, 1:2, right, ce2);
    if (ce1 == 0) goto <right_port>;
    FF1 = left;
    FF2 = 0;
  <right_port>
    if (ce2 == 0) goto <left_status>;
    FF1 = right;
    FF2 = 0;
    if (ce1 != 0) goto <conflict>;
    parallel_logic_status(right, 6);
  <left_status>
    if (ce1 == 0) goto <status>;
    parallel_logic_status(left, 0);
  <status>
    publish_alu_ce(EST & 0xcfff);
    goto <done>;
  <conflict>
    parallel_logic_conflict();
  <done>
}

macro parallel_logic_mac_ff12(latch, mac_shift, word_shift) {
    local direct_word:2 = A4L | A0L;
    local incoming:2 = FF2;
    local operand:2 = *[data]:2 R7;
    local product:8 = sext(operand) * zext(R7) * (1 + zext(ECFG & 1));
    local mask:8 = 0xffffffffff;
    local raw:8 = zext(incoming) + (product & mask);
    local result:8;
    local flags:2;
    compact_long_finish(raw & mask, raw > mask, 0:1, 0:1, 0:1, result, flags);
    latch = operand;
    # The paired result suppresses the direct FF word, not that lane's flags.
    FF1 = result:2;
    FF2 = result(2);
    parallel_logic_status(direct_word, word_shift);
    local packed:2 = (EST & 0xcfff & ~(0x3b << mac_shift)) | (flags << mac_shift);
    publish_alu_ce(packed);
}

@define PAR_LOGIC_LEFT "carmel_issue=1 & slot_mode=0"
@define PAR_LOGIC_OR_R6 "slot_15_22=0xd5 & parallel_logic_src=22 & logical_right=2 & slot_0_0=1"
@define PAR_LOGIC_OR_R5 "slot_15_22=0xd3 & parallel_logic_src=7 & logical_right=21 & slot_0_0=1"
@define PAR_LOGIC_XOR_R4_R6 "slot_15_22=0xdb & parallel_logic_src=12 & logical_right=22 & slot_0_0=1"
@define PAR_LOGIC_XOR_R5 "slot_15_22=0xd9 & parallel_logic_src=7 & logical_right=29 & slot_0_0=1"
@define PAR_LOGIC_DIRECT_OR "slot_14_22=0x1a8 & parallel_word_src=20 & slot_1_4=0 & slot_0_0=0"
@define PAR_LOGIC_MAC_FF12 "slot_14_22=0x148 & parallel_logic_dst=7 & parallel_logic_src=7 & logical_right=7 & slot_0_0=0"

:OR "CE1" "A2","*R6++","R2" "||" "OR" "CE2" "A2H","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=10) { parallel_logic_full_half(A2H, CECFG1, 0:2, CECFG2, 1:2, 1:1); }
:OR "CE1" "A2H","*R7","*R5++" "||" "OR" "CE2" "A2","*R6++","R2" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10) { parallel_logic_full_half(A2H, CECFG2, 1:2, CECFG1, 0:2, 1:1); }
:OR "CE1" "A2","*R6++","R2" "||" "OR" "CE2" "A2L","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=2) { parallel_logic_full_half(A2L, CECFG1, 0:2, CECFG2, 1:2, 1:1); }
:OR "CE1" "A2","*R6++","R2" "||" "OR" "CE2" "A0H","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=8) { parallel_logic_full_half(A0H, CECFG1, 0:2, CECFG2, 1:2, 0:1); }
:OR "CE1" "A2H","*R7","*R5++" "||" "OR" "CE2" "A2L","*R7","*R5++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=10); (slot_mode=0 & $(PAR_LOGIC_OR_R5) & parallel_logic_dst=2) { parallel_logic_halves(); }

:XOR "CE1" "A0L","*R4+=RN4","*R6++" "||" "XOR" "CE2" "X2","R7","*R5--" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_XOR_R4_R6) & parallel_logic_dst=0); (slot_mode=0 & $(PAR_LOGIC_XOR_R5) & parallel_logic_dst=15) { parallel_logic_xor_pair(A0L, 1:1); }
:XOR "CE1" "A0H","*R4+=RN4","*R6++" "||" "XOR" "CE2" "X2","R7","*R5--" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_XOR_R4_R6) & parallel_logic_dst=8); (slot_mode=0 & $(PAR_LOGIC_XOR_R5) & parallel_logic_dst=14) { parallel_logic_xor_pair(A0H, 1:1); }
:XOR "CE1" "A1L","*R4+=RN4","*R6++" "||" "XOR" "CE2" "X2","R7","*R5--" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_XOR_R4_R6) & parallel_logic_dst=1); (slot_mode=0 & $(PAR_LOGIC_XOR_R5) & parallel_logic_dst=15) { parallel_logic_xor_pair(A1L, 0:1); }
:OR "X1","A4L","A0L" "||" "XOR" "CE2" "A0L","*R4+=RN4","*R6++" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_DIRECT_OR) & parallel_word_dst=14); (slot_mode=0 & $(PAR_LOGIC_XOR_R4_R6) & parallel_logic_dst=0) {
    local left:2 = A4L | A0L;
    local right:2;
    local enabled:2;
    parallel_xor_r4_r6(CECFG2, 1:2, right, enabled);
    X1 = left;
    parallel_logic_status(left, 0);
    if (enabled == 0) goto <status>;
    A0L = right;
    parallel_logic_status(right, 6);
  <status>
    publish_alu_ce(EST & 0xcfff);
}
:OR "X2","A4L","A0L" "||" "ADD" "CE2" "A0L","A0H","X2" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_DIRECT_OR) & parallel_word_dst=15); (slot_mode=0 & slot_14_22=0x48 & parallel_word_dst=0 & parallel_word_src=24 & slot_1_4=14 & slot_0_0=1) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1:2, enabled);
    local old_x2:2 = X2;
    local left:2 = A4L | A0L;
    X2 = left;
    if (enabled == 0) goto <status>;
    local mask:8 = 0xffffffffff;
    local sum:8 = ((sext(A0H) << 16) & mask) + ((sext(old_x2) << 16) & mask);
    local result:8;
    local flags:2;
    compact_long_finish(sum & mask, sum > mask, 0:1, 0:1, 0:1, result, flags);
    A0L = result(2);
    parallel_logic_conflict();
  <status>
    parallel_logic_status(left, 0);
    publish_alu_ce(EST & 0xcfff);
}

:OR "FF2","A4L","A0L" "||" "MACHUS" "FF12","*R7","R7" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_DIRECT_OR) & parallel_word_dst=7); (slot_mode=0 & $(PAR_LOGIC_MAC_FF12)) { parallel_logic_mac_ff12(X2, 6, 0); }
:MACHUS "FF12","*R7","R7" "||" "OR" "FF1","A4L","A0L" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_MAC_FF12)); (slot_mode=0 & $(PAR_LOGIC_DIRECT_OR) & parallel_word_dst=6) { parallel_logic_mac_ff12(X1, 0, 6); }
:OR "CE1" "FF12","*R6++","R2" "||" "OR" "CE2" "FF12","*R6++","R2" is ($(PAR_LOGIC_LEFT) & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=14); (slot_mode=0 & $(PAR_LOGIC_OR_R6) & parallel_logic_dst=14) { parallel_logic_ff12_pair(); }

# The left DATA ports feed PReg, not the multiplier or X1. Only the
# existing accumulator reaches the MAC result; the secondary ALU sees zero.
macro compact_mac_preg_addresses(first_address, second_address) {
    second_address = R3;
    first_address = second_address + RN3;
    modify_ptr(R3, RN3, RM2, RL2, 6, 2);
}

macro compact_mac_preg_status(first_address, second_address, enabled, clear_right, set_right) {
    local preg_first:2 = *[data]:2 first_address;
    local preg_second:2 = *[data]:2 second_address;
    local sign_word:1 = A1H >= 0x8000;
    local extended:1 = GB1 != (0 - sign_word);
    local flags:2 = (EST & 0xcfc4) | (zext((A1L | A1H) == 0 && GB1 == 0) << 3)
                  | (zext(GB1 >= 0x80) << 4) | (zext(extended) << 5);
    if (enabled == 0) goto <publish>;
    flags = (flags & ~clear_right) | set_right;
  <publish>
    publish_alu_ce(flags);
}

macro compact_preg_ce(qualified, enabled) {
    enabled = 1;
    if (qualified == 0) goto <done>;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
  <done>
}

macro compact_mac_preg_xor(qualified, postincrement) {
    local enabled:2;
    compact_preg_ce(qualified, enabled);
    local first_address:2;
    local second_address:2;
    compact_mac_preg_addresses(first_address, second_address);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <fetch>;
    modify_ptr(R6, RN6, RM6, RL6, 12, 1);
    if (postincrement == 0) goto <fetch>;
    modify_ptr(R7, RN7, RM6, RL6, 14, 2);
  <fetch>
    compact_mac_preg_status(first_address, second_address, enabled, 0xe00:2, 0x200:2);
}

macro compact_mac_preg_sub(qualified) {
    local enabled:2;
    compact_preg_ce(qualified, enabled);
    local first_address:2;
    local second_address:2;
    compact_mac_preg_addresses(first_address, second_address);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <fetch>;
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
  <fetch>
    compact_mac_preg_status(first_address, second_address, enabled, 0xec0:2, 0x240:2);
}

@define MAC_PREG_LEFT "slot_16_22=0x5b & mac_preg_form=0xa & mac_preg_acc=1 & mac_preg_index=3 & mac_preg_data=19 & slot_0_0=0"
@define MAC_PREG_XOR "slot_16_22=0x6c & mac_preg_dst=14"
@define MAC_PREG_SUB "slot_16_22=0 & mac_preg_dst=1 & mac_preg_src=31 & mac_preg_data=10"
mac_preg_src_name: "OP1" is mac_preg_src=30 { }
mac_preg_src_name: "OP2" is mac_preg_src=31 { }

:MACUU "A1","*R3+RN3","*R3++" "||" "XOR CE2" "*R6+=RN6",mac_preg_src_name,"*R7" is (carmel_issue=1 & slot_mode=0 & $(MAC_PREG_LEFT)); (slot_mode=0 & $(MAC_PREG_XOR) & mac_preg_src_name & mac_preg_data=7 & slot_0_0=1) {
    compact_mac_preg_xor(1:1, 0:1);
}
:MACUU "A1","*R3+RN3","*R3++" "||" "XOR CE2" "*R6+=RN6","OP2","*R7++" is (carmel_issue=1 & slot_mode=0 & $(MAC_PREG_LEFT)); (slot_mode=0 & $(MAC_PREG_XOR) & mac_preg_src=31 & mac_preg_data=23 & slot_0_0=1) {
    compact_mac_preg_xor(1:1, 1:1);
}
:MACUU "A1","*R3+RN3","*R3++" "||" "XOR" "*R6+=RN6","OP2","*R0" is (carmel_issue=1 & slot_mode=0 & $(MAC_PREG_LEFT)); (slot_mode=0 & $(MAC_PREG_XOR) & mac_preg_src=31 & mac_preg_data=0 & slot_0_0=0) {
    compact_mac_preg_xor(0:1, 0:1);
}
:MACUU "A1","*R3+RN3","*R3++" "||" "SUB CE2" "*R1","OP2","*R2+=RN2" is (carmel_issue=1 & slot_mode=0 & $(MAC_PREG_LEFT)); (slot_mode=0 & $(MAC_PREG_SUB) & slot_0_0=1) {
    compact_mac_preg_sub(1:1);
}
:MACUU "A1","*R3+RN3","*R3++" "||" "SUB" "*R1","OP2","*R2+=RN2" is (carmel_issue=1 & slot_mode=0 & $(MAC_PREG_LEFT)); (slot_mode=0 & $(MAC_PREG_SUB) & slot_0_0=0) {
    compact_mac_preg_sub(0:1);
}

:^nop_left "||" "XOR CE2" "*R6+=RN6","OP2","*R7" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(MAC_PREG_XOR) & mac_preg_src=31 & mac_preg_data=7 & slot_0_0=1) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    local destination:2 = R6;
    modify_ptr(R6, RN6, RM6, RL6, 12, 1);
    local word:2 = *[data]:2 R7;
    if (enabled == 0) goto <publish>;
    *[data]:2 destination = word;
    flags = (flags & 0xf1ff) | (zext(word == 0) << 9);
  <publish>
    publish_alu_ce(flags);
}

# The long DATA result selects the opposite pointer bank for these short
# inputs. The physical issue lane, not that pointer bank, selects X and EST.
macro compact_indexed_store(address, a, b, shift, flags) {
    local product:8 = a * b * (1 + zext(ECFG & 1));
    local result:8;
    local product_flags:2;
    compact_long_finish(product & 0xffffffffff, 0:1, 0:1, 1:1, 1:1, result, product_flags);
    local upper:2 = address + 1;
    *[data]:2 address = result:2;
    *[data]:2 upper = result(2);
    local lane:4 = shift;
    flags = (flags & ~(0x3b:2 << lane)) | (product_flags << lane);
}

macro compact_indexed_sub_pair(destination, delta, modulo, bound, shift, index, stride) {
    local address:2 = destination;
    local left_addr:2 = R4;
    local right_addr:2 = R5;
    local indexed_addr:2 = index + stride;
    local first:2 = *[data]:2 left_addr;
    local second:2 = *[data]:2 right_addr;
    local word:2 = *[data]:2 indexed_addr;
    local multiplier:8 = zext(R1);
    modify_ptr(destination, delta, modulo, bound, shift, 1);
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    modify_ptr(R5, RN5, RM4, RL4, 10, 2);
    X2 = word;
    local mask:8 = 0xffffffffff;
    local lhs:8 = (sext(first) & 0xffffff) << 16;
    local rhs:8 = (sext(second) & 0xffffff) << 16;
    local borrow_in:8 = (1 - zext(EST & 1)) << 16;
    local raw:8 = lhs - rhs - borrow_in;
    local result:8;
    local sub_flags:2;
    compact_long_finish(raw & mask, lhs >= rhs + borrow_in, 0:1, 0:1, 0:1, result, sub_flags);
    if ((sub_flags & 0x20) == 0 || (ECFG & 4) != 0 || (ECFG & 0x28) == 8) goto <sub_store>;
    sub_flags = sub_flags | 4;
  <sub_store>
    *[data]:2 left_addr = result(2);
    local sample:8 = sext(word);
    local flags:2 = (EST & 0xcfc4) | sub_flags;
    compact_indexed_store(address, sample, multiplier, 6, flags);
    publish_alu_ce(flags);
}

macro compact_indexed_move_pair(destination, index, stride) {
    local mpy_on:2;
    local move_on:2;
    unary_ce(CECFG1, EST, CETBL, 0, mpy_on);
    unary_ce(CECFG2, EST, CETBL, 1, move_on);
    local flags:2 = EST & 0xcfff;
    local move_word:2 = A2H;
    if (mpy_on == 0 && (CECFG1 & 0x1000) == 0) goto <move>;
    local address:2 = index + stride;
    local word:2 = *[data]:2 address;
    X1 = word;
    if (mpy_on == 0) goto <move>;
    local a:8 = zext(word);
    local b:8 = zext(A3H);
    compact_indexed_store(destination, a, b, 0, flags);
  <move>
    if (move_on == 0) goto <status>;
    A0L = move_word;
    flags = (flags & 0xc13f) | (zext(move_word == 0) << 9) | (zext(move_word >= 0x8000) << 10);
  <status>
    publish_alu_ce(flags);
}

macro compact_indexed_shift_peer(count, flags) {
    local n:4 = count;
    local input:8 = sext(FF2);
    local result:8 = input;
    local carry_bit:1 = (EST & 1) != 0;
    if (n == 0) goto <align>;
    if (n s< 0) goto <right>;
    carry_bit = ((input >> (40 - n)) & 1) != 0;
    result = (input & 0xffffff) << n;
    goto <align>;
  <right>
    carry_bit = ((input >> (15 - n)) & 1) != 0;
    result = input s>> (0 - n);
  <align>
    result = (result & 0xffffff) << 16;
    local shifted_flags:2;
    shift_flags(result, carry_bit, shifted_flags);
    shift_limit(result, shifted_flags);
    A4H = result(2);
    flags = (EST & 0xcfc6) | shifted_flags;
}

macro compact_indexed_shift_pair(destination, index, stride, post, step, modulo, bound, shift, count) {
    local address:2 = index + stride;
    local first:2 = *[data]:2 address;
    local second:2 = *[data]:2 post;
    modify_ptr(post, step, modulo, bound, shift, 2);
    X2 = first;
    local flags:2;
    compact_indexed_shift_peer(count, flags);
    local a:8 = zext(first);
    local b:8 = sext(second);
    compact_indexed_store(destination, a, b, 6, flags);
    publish_alu_ce(flags);
}

macro compact_indexed_mpy_seq(destination, post, step, modulo, bound, shift, index, stride) {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <status>;
    local address:2 = index + stride;
    local first:2 = *[data]:2 post;
    local second:2 = *[data]:2 address;
    modify_ptr(post, step, modulo, bound, shift, 2);
    X1 = first;
    if (enabled == 0) goto <status>;
    local a:8 = zext(first);
    local b:8 = zext(second);
    compact_indexed_store(destination, a, b, 0, flags);
  <status>
    publish_alu_ce(flags);
}

@define INDEXED_SUB_PEER "slot_15_22=0x13 & indexed_peer_sub_dst=6 & indexed_peer_sub_first=20 & indexed_mpy_short=21 & slot_0_0=0"
@define INDEXED_MOVE_PEER "slot_5_22=0x18d50 & move_source=10 & slot_0_0=1"
@define INDEXED_SHIFT_PEER "slot_7_22=0x7b97 & indexed_peer_shift_count & slot_0_0=0"
@define INDEXED_MPYSU "indexed_mpy_form=0x444 & slot_6_7=3 & indexed_mpy_short=1 & slot_0_0=0"
@define INDEXED_MPYUU "indexed_mpy_form=0x4c4 & slot_6_7=3 & indexed_mpy_short=27 & slot_0_0=1"
@define INDEXED_MPYUS "indexed_mpy_low_form=0x90a & slot_5_6=1 & move_source=11 & slot_0_0=0"
@define INDEXED_MPYUU_SEQ "carmel_issue=3 & slot_mode=0 & indexed_mpy_low_form=0x99c & indexed_mpy_post_first=11 & indexed_mpy_index_second=1 & slot_0_0=1"

:"SUBC" "RMW1","*R4++","*R5++" "||" "MPYSU" "*R2+=RN2","*R7+RN7","R1" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SUB_PEER)); (slot_mode=0 & $(INDEXED_MPYSU) & indexed_mpy_high_dst=10) {
    compact_indexed_sub_pair(R2, RN2, RM2, RL2, 4, R7, RN7);
}
:"SUBC" "RMW1","*R4++","*R5++" "||" "MPYSU" "*R6+=RN6","*R3+RN3","R1" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SUB_PEER)); (slot_mode=0 & $(INDEXED_MPYSU) & indexed_mpy_high_dst=14) {
    compact_indexed_sub_pair(R6, RN6, RM6, RL6, 12, R3, RN3);
}
:"MPYUU CE1" "*R3","*R7+RN7","A3H" "||" "MOVE CE2" "A0L","A2H" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_MPYUU) & indexed_mpy_high_dst=3); (slot_mode=0 & $(INDEXED_MOVE_PEER)) {
    compact_indexed_move_pair(R3, R7, RN7);
}
:"MPYUU CE1" "*R7","*R3+RN3","A3H" "||" "MOVE CE2" "A0L","A2H" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_MPYUU) & indexed_mpy_high_dst=7); (slot_mode=0 & $(INDEXED_MOVE_PEER)) {
    compact_indexed_move_pair(R7, R3, RN3);
}
:"ASHIFT" "A4H","FF2",indexed_peer_shift_count "||" "MPYUS" "*R2","*R5+RN5","*R7++" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SHIFT_PEER)); (slot_mode=0 & $(INDEXED_MPYUS) & indexed_mpy_low_dst=2) {
    compact_indexed_shift_pair(R2, R5, RN5, R7, RN7, RM6, RL6, 14, indexed_peer_shift_count);
}
:"ASHIFT" "A4H","FF2",indexed_peer_shift_count "||" "MPYUS" "*R6","*R1+RN1","*R3++" is (carmel_issue=1 & slot_mode=0 & $(INDEXED_SHIFT_PEER)); (slot_mode=0 & $(INDEXED_MPYUS) & indexed_mpy_low_dst=6) {
    compact_indexed_shift_pair(R6, R1, RN1, R3, RN3, RM2, RL2, 6, indexed_peer_shift_count);
}
:"EXTRACTZ" "A3","A1","*R0" is carmel_issue=2 & slot_mode=1 & slot_9_22=0x1b79 & slot_5_7=1 & slot_8_9=3 & indexed_mpy_short=16 & slot_0_0=0 {
    local descriptor:2 = R0 + 1;
    local count:2 = *[data]:2 R0;
    local offset:2 = *[data]:2 descriptor;
    local input:8 = sext(GB1) * 0x100000000 + (zext(A1H) << 16) + zext(A1L);
    local mask:8 = (1 << (count & 31)) - 1;
    local result:8 = (input s>> (offset & 31)) & mask;
    A3L = result:2;
    A3H = result(2);
    GB3 = 0;
    publish_alu_ce((EST & 0xcfe7) | (zext(result == 0) << 3));
}
:"MPYUU CE1" "*R0","*R7++","*R5+RN5" is $(INDEXED_MPYUU_SEQ) & indexed_mpy_low_dst=0 {
    compact_indexed_mpy_seq(R0, R7, RN7, RM6, RL6, 14, R5, RN5);
}
:"MPYUU CE1" "*R4","*R3++","*R1+RN1" is $(INDEXED_MPYUU_SEQ) & indexed_mpy_low_dst=4 {
    compact_indexed_mpy_seq(R4, R3, RN3, RM2, RL2, 6, R1, RN1);
}

macro compact_long_postmodify(pointer) {
    # The explicit window of this port uses all 16 RM bits, unlike the
    # implicit window. The other modes share the ordinary compact AGU.
    if ((PACFG & 0xc00) == 0xc00 && RM4 > 0xfff) goto <full_window>;
    modify_ptr(pointer, RN5, RM4, RL4, 10, 1);
    goto <done>;
  <full_window>
    local candidate:2 = pointer + RN5;
    local size:4 = zext(RM4) + 1;
    local limit:4 = zext(RL4) + size;
    if (limit <= 0x10000 && RL4 <= candidate && zext(candidate) < limit) goto <publish>;
    if (RN5 s< 0) goto <reverse_wrap>;
    candidate = candidate - size:2;
    goto <publish>;
  <reverse_wrap>
    candidate = candidate + size:2;
  <publish>
    pointer = candidate;
  <done>
}

compact_long_left: "ADD" "CE1" "*R6","A2","A0" is slot_0_22=0x133321 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local old_address:2 = R6; local a:8; compact_long_sample(A2L, A2H, GB2, a); local b:8; compact_long_sample(A0L, A0H, GB0, b); local raw:8 = a + b; local bits:8 = raw & 0xffffffffff; local carry_out:1 = raw >= 0x10000000000; local overflow:1 = ((a ^ b) < 0x8000000000) && ((a ^ bits) >= 0x8000000000); local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 0:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x133321 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }
compact_long_left: "ADD" "CE1" "A1","A2","A0" is slot_0_22=0x130ca1 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local a:8; compact_long_sample(A2L, A2H, GB2, a); local b:8; compact_long_sample(A0L, A0H, GB0, b); local raw:8 = a + b; local bits:8 = raw & 0xffffffffff; local carry_out:1 = raw >= 0x10000000000; local overflow:1 = ((a ^ b) < 0x8000000000) && ((a ^ bits) >= 0x8000000000); local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 0:1, 0:1, result, flags); A1L = result:2; A1H = result(2); GB1 = result(4); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x130ca1 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }
compact_long_right: "SUB" "CE2" "*R5++RN5","A2","A3" is slot_0_22=0x336a7 { local previous:2 = EST; local enabled:2; unary_ce(CECFG2, previous, CETBL, 1, enabled); if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <long_done>; local old_address:2 = R5; compact_long_postmodify(R5); if (enabled == 0) goto <long_done>; local a:8; compact_long_sample(A2L, A2H, GB2, a); local b:8; compact_long_sample(A3L, A3H, GB3, b); local raw:8 = a - b; local bits:8 = raw & 0xffffffffff; local carry_out:1 = a >= b; local overflow:1 = ((a ^ b) >= 0x8000000000) && ((a ^ bits) >= 0x8000000000); local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 0:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xf13f) | (flags << 6); <long_done> }
:^nop_left "||" compact_long_right is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & slot_0_22=0x336a7 & compact_long_right) { build compact_long_right; }
compact_long_left: "MPY" "CE1" "*R3","A2L","A1L" is slot_0_22=0x400723 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local old_address:2 = R3; local a:8 = (zext(A2L) ^ 0x8000) - 0x8000; local b:8 = (zext(A1L) ^ 0x8000) - 0x8000; local bits:8 = (a * b * (1 + zext(ECFG & 1))) & 0xffffffffff; local carry_out:1 = 0; local overflow:1 = 0; local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 0:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x400723 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }
compact_long_left: "MPYUS" "CE1" "*R3","A2L","A1L" is slot_0_22=0x480723 { local previous:2 = EST; local enabled:2; unary_ce(CECFG1, previous, CETBL, 0, enabled); if (enabled == 0) goto <long_done>; local old_address:2 = R3; local a:8 = zext(A2L); local b:8 = (zext(A1L) ^ 0x8000) - 0x8000; local bits:8 = (a * b * (1 + zext(ECFG & 1))) & 0xffffffffff; local carry_out:1 = 0; local overflow:1 = 0; local result:8; local flags:2; compact_long_finish(bits, carry_out, overflow, 1:1, 1:1, result, flags); local next_address:2 = old_address + 1; *[data]:2 old_address = result:2; *[data]:2 next_address = result(2); EST = (previous & 0xffc4) | (flags << 0); <long_done> }
:^compact_long_left "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x480723 & compact_long_left); (slot_mode=0 & nop_right) { build compact_long_left; }

# Keep the complete 40-bit ALU result in a standard C width. Finish the
# flags before narrowing the physical WB port to a high word or a guard.
macro raw_mac_finish(exact, raw_adder, short_result, short_zero, store, result, flags) {
    local bits:8 = exact & 0xffffffffff;
    local negative:1 = bits >= 0x8000000000;
    local extended:1 = bits > 0x7fffffff && bits < 0xff80000000;
    local overflow:1 = exact + 0x8000000000 > 0xffffffffff;
    local saturated:1 = (ECFG & 0x28) == 8;
    local auto_limit:1 = (ECFG & 4) != 0;
    local limited:1 = auto_limit && (((bits >> 31) ^ (bits >> 32)) & 1) != 0;
    local loss:1 = limited || ((overflow || (short_result != 0 && extended)) && !saturated && !auto_limit);
    local carry_out:1 = (raw_adder & 0x10000000000) != 0;
    local zero:1 = bits == 0 || (short_zero != 0 && (bits >> 16) == 0);
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(zero) << 3) | (zext(negative) << 4) | (zext(extended) << 5);
    limited = limited || (store != 0 && saturated && extended);
    result = bits;
    if (!limited) goto <done>;
    result = 0x7fffffff + zext(negative) * 0xff00000001;
    flags = flags | 4;
  <done>
}

macro compact_ff12_store(negate, long_result) {
    local address:2 = R0;
    local source:8 = zext(FF2) * 0x10000 + zext(FF1);
    local exact:8 = source - 2 * source * negate;
    local result:8;
    local flags:2;
    raw_mac_finish(exact, (0x10000000000 - source) * negate, 1:1, 0:1, 1:1, result, flags);
    # SR1 affects DATA after flags and limiting, including for a word result.
    if ((ECFG & 0x20) == 0) goto <store>;
    result = (result >> 1) | (result & 0x8000000000);
  <store>
    if (long_result == 0) goto <word>;
    local upper:2 = address + 1;
    *[data]:2 address = result:2;
    address = upper;
  <word>
    *[data]:2 address = result(2);
    EST = (EST & 0xffc4) | flags;
}

@define COMPACT_FF12_DATA "carmel_issue=1 & slot_mode=0 & compact_unary_data_dst=0 & slot_1_3=6 & slot_0_0=0"

:NEG "*R0","FF12" "||" nop_right is ($(COMPACT_FF12_DATA) & compact_unary_data_form=0x20d8); (slot_mode=0 & nop_right) { compact_ff12_store(1:8, 0:1); }
:NEG "*R0:long","FF12" "||" nop_right is ($(COMPACT_FF12_DATA) & compact_unary_data_form=0x20dc); (slot_mode=0 & nop_right) { compact_ff12_store(1:8, 1:1); }
:ABS "*R0:long","FF12" "||" nop_right is ($(COMPACT_FF12_DATA) & compact_unary_data_form=0x20fc); (slot_mode=0 & nop_right) { compact_ff12_store(0:8, 1:1); }

# Signed MOVE binds these extended DATA selectors to the nonmodifying index adder.
macro compact_move_long_address(address) {
    address = R6 + RN6;
}

macro compact_move_long_read(low, high) {
    local address:2;
    compact_move_long_address(address);
    low = *[data]:2 address;
    local upper:2 = address + 1;
    high = *[data]:2 upper;
}

macro compact_move_long_write(low, high) {
    local address:2;
    compact_move_long_address(address);
    local upper:2 = address + 1;
    *[data]:2 address = low;
    *[data]:2 upper = high;
}

macro compact_move_long_from_a0(bank) {
    local value:4 = (zext(A0H) << 16) | zext(A0L);
    local guard:1 = GB0;
    local shift:1 = (ECFG & 0x20) != 0;
    if (!shift) goto <limit>;
    value = (value >> 1) | (zext(guard & 1) << 31);
    guard = (guard >> 1) | (guard & 0x80);
  <limit>
    local sign:1 = (value >= 0x80000000) * 0xff;
    if ((ECFG & 8) == 0 || guard == sign) goto <write>;
    value = 0x7fffffff + zext(guard >= 0x80);
    EST = EST | (4:2 << (bank * 6));
  <write>
    local low:2 = value(0);
    local high:2 = value(2);
    compact_move_long_write(low, high);
}

@define COMPACT_MOVE_LONG_STORE "slot_9_22=0x18f5 & (slot_4_7=6 | slot_4_7=14) & slot_1_3=0"
@define COMPACT_MOVE_LONG_LOAD "slot_7_22=0x63b0 & slot_6_6=1 & slot_1_4=6 & slot_0_0=0"

:^nop_left "||" "MOVE" "*R6+RN6:long","A0" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_MOVE_LONG_STORE) & slot_0_0=0) { compact_move_long_from_a0(1:2); }
:^nop_left "||" "MOVE" "CE2" "*R6+RN6:long","A0" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_MOVE_LONG_STORE) & slot_0_0=1) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <status>;
    compact_move_long_from_a0(1:2);
  <status>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE "*R6+RN6:long","A0" is carmel_issue=3 & slot_mode=0 & $(COMPACT_MOVE_LONG_STORE) & slot_0_0=0 { compact_move_long_from_a0(0:2); }

:MOVE "A0","*R6+RN6:long" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_MOVE_LONG_LOAD)); (slot_mode=0 & nop_right) {
    local low:2;
    local high:2;
    compact_move_long_read(low, high);
    local negative:1 = high >= 0x8000;
    A0L = low;
    A0H = high;
    GB0 = negative * 0xff;
    EST = (EST & 0xffc4) | (zext((low | high) == 0) << 3) | (zext(negative) << 4);
}

:MOVE "*R6+RN6:long","LSA1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_22=0x31e4c4); (slot_mode=0 & nop_right) {
    local low:2 = LSA1L;
    local high:2 = zext(LSA1H);
    if ((ECFG & 0x20) == 0) goto <write>;
    low = (low >> 1) | (high << 15);
    high = high >> 1;
  <write>
    compact_move_long_write(low, high);
}

# The loop-start result is connected before CE gates the ordinary result port.
:MOVE "LSA1","*R6+RN6:long" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_5_22=0x18f8a & slot_1_4=6); (slot_mode=0 & nop_right) {
    local low:2;
    local high:2;
    compact_move_long_read(low, high);
    LSA1L = low & 0xfffe;
    LSA1H = high:1;
    LSAL = LSA1L;
    LSAH = LSA1H;
}

:ADDC "CE1" "*R3+=RN3","RN6" is carmel_issue=2 & slot_mode=1 & slot_0_22=0x14bb97 {
    local enabled:2;
    local address:2;
    compact_rmw_r3(CECFG1, 0:1, address, enabled);
    if (enabled == 0) goto <done>;
    local word:2 = *[data]:2 address;
    local signed_word:4 = sext(word);
    local signed_increment:4 = sext(RN6);
    local exact:4 = signed_word + signed_increment + zext(EST & 1);
    local negative:1 = exact >= 0x80000000;
    local extended:1 = exact + 0x8000 > 0xffff;
    local carry_out:1 = (word >= 0x8000 && RN6 >= 0x8000) ||
                        ((word >= 0x8000 || RN6 >= 0x8000) && !negative);
    local flags:2 = zext(carry_out) | (zext(exact == 0) << 3) |
                    (zext(negative) << 4) | (zext(extended) << 5);
    local result:2 = exact:2;
    if (!extended) goto <write>;
    flags = flags | 4;
    if ((ECFG & 0x28) != 8 && (ECFG & 4) == 0) goto <write>;
    result = 0x7fff + zext(negative);
  <write>
    *[data]:2 address = result;
    publish_alu_ce((EST & 0xcfc4) | flags);
  <done>
}

macro raw_mac_flags(flags, active, shift) {
    flags = (flags & ~(0x3b:2 << shift)) | (active << shift);
}

# The two temporary ports sample the left AGUs before either result is
# published. The direct route also connects the first word to the left ALU.
macro dual_preg_addresses(first, second) {
    first = R1;
    second = R2;
    modify_ptr(R1, RN1, RM0, RL0, 2, 2);
}

macro dual_preg_fetch(first_address, second_address, first_word) {
    first_word = *[data]:2 first_address;
    local second_word:2 = *[data]:2 second_address;
}

dual_preg_left_op: "ADDABS" is slot_16_22=0x1d { export 0:2; }
dual_preg_left_op: "SUB" is slot_16_22=0x01 { export 1:2; }
dual_preg_left_op: "SUBR" is slot_16_22=0x05 { export 2:2; }
@define DUAL_PREG_LEFT "carmel_issue=1 & slot_mode=0 & slot_15_15=1 & slot_11_14=9 & slot_6_10=17 & slot_1_5=2 & slot_0_0=0"

:dual_preg_left_op "A1H","*R1++","*R2" "||" "SUBC" dual_preg_register,mac_preg_src_name,"*R3++" is ($(DUAL_PREG_LEFT) & dual_preg_left_op); (slot_mode=0 & slot_16_22=8 & slot_15_15=1 & (slot_11_14=10 | slot_11_14=11) & dual_preg_register & mac_preg_src_name & slot_1_5=19 & slot_0_0=0) {
    local first_address:2;
    local second_address:2;
    dual_preg_addresses(first_address, second_address);
    modify_ptr(R3, RN3, RM2, RL2, 6, 2);
    local first_word:2;
    dual_preg_fetch(first_address, second_address, first_word);
    local carry_in:2 = (EST >> 6) & 1;
    local left_flags:2 = 8 | zext(dual_preg_left_op != 0);
    local right_flags:2 = carry_in * 9 | ((1 - carry_in) << 4);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    raw_mac_flags(flags, right_flags, 6);
    A1H = 0;
    dual_preg_register = carry_in - 1;
    publish_alu_ce(flags);
}

# The connected direct input adds a high-bus request when its address is
# high. Lift only the established low-bus route, never an unbound variant.
:dual_preg_left_op "A1H","*R1++","*R2" "||" "SUB CE2" "*R1",mac_preg_src_name,"*R2+=RN2" is ($(DUAL_PREG_LEFT) & carmel_of_route=2 & dual_preg_left_op); (slot_mode=0 & slot_16_22=0 & slot_15_15=0 & slot_11_14=1 & mac_preg_src_name & slot_1_5=10 & slot_0_0=1) {
    local enabled:2;
    compact_preg_ce(1:1, enabled);
    local first_address:2;
    local second_address:2;
    dual_preg_addresses(first_address, second_address);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <fetch>;
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
  <fetch>
    local first_word:2;
    dual_preg_fetch(first_address, second_address, first_word);
    local exact:8 = ((zext(first_word) ^ 0x8000) - 0x8000) << 16;
    local adder:8 = 0;
    if (dual_preg_left_op != 1) goto <not_sub>;
    adder = 0x10000000000;
    goto <finish>;
  <not_sub>
    if (dual_preg_left_op != 2) goto <absolute>;
    adder = zext(first_word == 0) << 40;
    exact = -exact;
    goto <finish>;
  <absolute>
    if (exact s>= 0) goto <finish>;
    exact = -exact;
  <finish>
    local result:8;
    local left_flags:2;
    raw_mac_finish(exact, adder, 1:1, 0:1, 0:1, result, left_flags);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    if (enabled == 0) goto <publish>;
    flags = (flags & 0xf13f) | 0x240;
  <publish>
    A1H = result(2);
    publish_alu_ce(flags);
}

macro raw_mac_product(left, right, sign_left, sign_right, product) {
    local a:8 = zext(left);
    local b:8 = zext(right);
    if (sign_left == 0) goto <left_ready>;
    a = (a ^ 0x8000) - 0x8000;
  <left_ready>
    if (sign_right == 0) goto <right_ready>;
    b = (b ^ 0x8000) - 0x8000;
  <right_ready>
    product = a * b * (1 + zext(ECFG & 1));
}

macro raw_mac_round_sub(base, left, right, result, flags) {
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local exact:8 = (base ^ 0x8000000000) - 0x8000000000 - product;
    local bias:8 = 0x8000;
    if ((ECFG & 2) == 0) goto <bias_ready>;
    bias = 0x7fff + ((exact >> 16) & 1);
  <bias_ready>
    local raw:8 = base + (~product & 0xffffffffff) + 1 + bias;
    exact = (exact + bias) & 0xffffffffffff0000;
    raw_mac_finish(exact, raw, 0:1, 0:1, 0:1, result, flags);
    result = result & 0xffffff0000;
}

macro raw_mac_add(left, right, carry_in, short_result, store, result, flags) {
    local exact:8 = left + right + carry_in;
    local raw:8 = (left & 0xffffffffff) + (right & 0xffffffffff) + carry_in;
    raw_mac_finish(exact, raw, short_result, 0:1, store, result, flags);
}

macro raw_mac_word(value, result) {
    result = ((zext(value) ^ 0x8000) - 0x8000) << 16;
}

# The guard and control ports use the upper word of the same scaled product,
# but align their addends differently. Neither port drives arithmetic flags.
macro wide_mac_guard_result(guard, product, alignment) {
    local sum:8 = (zext(guard) << alignment) + product;
    guard = sum(2);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_mac_control_result(destination, delta) {
    # The addend is already aligned to the high word. The control port
    # discards the guard instead of applying ECFG.ALIM.
    local update:8 = delta;
    destination = destination + update(2);
    publish_alu_ce(EST & 0xcfff);
}

@define WIDE_ACC_MAC "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1"
@define WIDE_ACC_MAC_A01 "$(WIDE_ACC_MAC) & wide_acc_mac_first=0x50 & wide_0_0=1 & wide_40_45=0x11"
@define WIDE_ACC_MAC_A01_WORD "$(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x28"

:MACH "GB3","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x27 & wide_acc_mac_dst=0x83 {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_guard_result(GB3, product, 0:4);
}
:MAC "GB3","A0L","A1L" is $(WIDE_ACC_MAC_A01_WORD) & wide_acc_mac_dst=0x83 {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_guard_result(GB3, product, 16:4);
}
:MACUU "GB3","A0L","A1L" is $(WIDE_ACC_MAC_A01) & wide_acc_mac_op=0x2b & wide_acc_mac_dst=0x83 {
    local product:8;
    raw_mac_product(A0L, A1L, 0:1, 0:1, product);
    wide_mac_guard_result(GB3, product, 16:4);
}
:MACH "GB5","R5","*R0--" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x27 & wide_acc_mac_dst=0x85 & wide_acc_mac_first=0x65 & wide_0_0=0 & wide_40_45=0x18 {
    local left:2 = R5;
    local address:2 = R0;
    modify_ptr(R0, 0:2, RM0, RL0, 0, 3);
    local right:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    X1 = left;
    wide_mac_guard_result(GB5, product, 0:4);
}
:MACH "GB3","OP3","MINMAX" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x27 & wide_acc_mac_dst=0x83 & wide_acc_mac_first=0x4e & wide_0_0=1 & wide_40_45=0x3a {
    local operand:2 = MINMAX;
    local product:8;
    raw_mac_product(operand, operand, 1:1, 1:1, product);
    X1 = operand;
    wide_mac_guard_result(GB3, product, 0:4);
}

wide_acc_mac_control: "RL2" is wide_acc_mac_dst=0xb1 { export RL2; }
wide_acc_mac_control: "FF1" is wide_acc_mac_dst=0xbe { export FF1; }
wide_acc_mac_control: "X1" is wide_acc_mac_dst=0x9e { export X1; }
wide_acc_mac_control: "CECFG1" is wide_acc_mac_dst=0xc2 { export CECFG1; }
wide_acc_mac_control: "PACFG" is wide_acc_mac_dst=0xda { export PACFG; }
:MAC wide_acc_mac_control,"A0L","A1L" is $(WIDE_ACC_MAC_A01_WORD) & wide_acc_mac_control {
    local product:8;
    raw_mac_product(A0L, A1L, 1:1, 1:1, product);
    wide_mac_control_result(wide_acc_mac_control, product);
}
:MSUUS "ECFG","*R3+=RN3","RM0" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x2e & wide_acc_mac_dst=0xc0 & wide_acc_mac_first=0x0b & wide_0_0=1 & wide_40_45=0x32 {
    local address:2 = R3;
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
    local left:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, RM0, 0:1, 1:1, product);
    X1 = left;
    wide_mac_control_result(ECFG, -product);
}
:MACR "RL2","*R6+"^wide_acc_mac_displacement,"R7" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x20 & wide_acc_mac_dst=0xb1 & wide_acc_mac_first=0x26 & wide_0_0=1 & wide_40_45=0x27 & wide_acc_mac_displacement {
    local address:2 = R6 + wide_acc_mac_displacement;
    local left:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, R7, 1:1, 1:1, product);
    X1 = left;
    wide_mac_control_result(RL2, product + 0x8000);
}
:MACUS "RL2","*"^wide_acc_mac_absolute,"RN1" is $(WIDE_ACC_MAC) & wide_acc_mac_op=0x2a & wide_acc_mac_dst=0xb1 & wide_acc_mac_first=0x3e & wide_0_0=1 & wide_40_45=0x29 & wide_acc_mac_absolute {
    local address:2 = wide_acc_mac_absolute;
    local left:2 = *[data]:2 address;
    local product:8;
    raw_mac_product(left, RN1, 0:1, 1:1, product);
    X1 = left;
    wide_mac_control_result(RL2, product);
}

:MSU "INTBASE","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2cd6f8 & wide_40_45=3 {
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local addend:8;
    raw_mac_word(INTBASE, addend);
    local raw:8 = (addend & 0xffffffffff) + (~product & 0xffffffffff) + 1;
    local result:8;
    local flags:2;
    raw_mac_finish(addend - product, raw, 1:1, 0:1, 0:1, result, flags);
    X1 = left;
    INTBASE = result(2);
    publish_alu_ce(EST & 0xcfff);
}

macro wide_msu_control_word(dst, lhs, rhs) {
    local product:8;
    raw_mac_product(lhs, rhs, 1:1, 1:1, product);
    local base:8;
    raw_mac_word(dst, base);
    local difference:8 = base - product;
    wide_control_word(difference, dst);
    publish_alu_ce(EST & 0xcfff);
}

:MSU "USER_IO","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2cd7f8 & wide_40_45=3 {
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    X1 = left;
    wide_msu_control_word(USER_IO, left, right);
}
:MSU "LC","A0L","A1L" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2cd4a1 & wide_40_45=0x11 {
    wide_msu_control_word(LC1, A0L, A1L);
}

macro wide_msu_word(old, left, right, store, result) {
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local base:8 = sext(old) * (1 + zext(ECFG & 1) * 0xffff);
    local raw:8 = (base & 0xffffffffff) + (~product & 0xffffffffff) + 1;
    local bits:8;
    local active:2;
    raw_mac_finish(base - product, raw, 1:1, 1:1, store, bits, active);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
    result = bits;
}

:MSU "A0L","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2c90f8 & wide_40_45=3 {
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    X1 = left;
    local result:8;
    wide_msu_word(A0L, left, right, 0:1, result);
    A0L = result(2);
}
:MSU "*R4","RF4","*R3" is $(WIDE_ROUTED_ALU) & wide_mac_prefix=0 & wide_0_22=0x2c04f8 & wide_40_45=3 {
    local destination:2 = R4;
    local left:2 = RF4;
    local right:2 = *[data]:2 R3;
    local old:2 = *[data]:2 destination;
    X1 = left;
    local result:8;
    wide_msu_word(old, left, right, 1:1, result);
    result = result >> ((ECFG >> 5) & 1);
    *[data]:2 destination = result(2);
}

macro raw_mac_predicate(cfg, bank, enabled, addresses) {
    unary_ce(cfg, EST, CETBL, bank, enabled);
    addresses = enabled | ((cfg >> 12) & 1);
}

# These MAC ports use the high word without ALU limiting or arithmetic flags.
macro mac_r3_post_r0(left, right) {
    left = R3;
    local address:2 = R0;
    modify_ptr(R0, 1:2, RM0, RL0, 0, 2);
    right = *[data]:2 address;
    X1 = left;
}

macro mac_high_control(base, left, right, subtract, signed_left, signed_right, bias, word) {
    local product:8;
    raw_mac_product(left, right, signed_left, signed_right, product);
    local bits:8 = base + product + bias;
    if (subtract == 0) goto <publish>;
    bits = base - product;
  <publish>
    word = bits(2);
    publish_alu_ce(EST & 0xcfff);
}

macro mac_r3_post_r0_control(base, signed_left, signed_right, bias, word) {
    local left:2;
    local right:2;
    mac_r3_post_r0(left, right);
    mac_high_control(base, left, right, 0:1, signed_left, signed_right, bias, word);
}

@define WIDE_MAC_CONTROL "$(WIDE_ROUTED_ALU) & wide_mac_prefix=0"
@define WIDE_MAC_R3_R0 "$(WIDE_MAC_CONTROL) & wide_40_45=0x10"
:MACHUS "LSA1","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x23d2c6 {
    local base:8 = zext(LSA1W >> 16 & 0xff);
    local word:2;
    mac_r3_post_r0_control(base, 0:1, 1:1, 0:8, word);
    LSA1W = (LSA1W & 0xffff0000) | zext(word);
}
:MACSU "LEA1","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x29d3c6 {
    local base:8 = zext(LEA1W & 0xffffff);
    local word:2;
    mac_r3_post_r0_control(base, 1:1, 0:1, 0:8, word);
    LEA1W = (LEA1W & 0xffff0000) | zext(word);
}
:MACR "LC","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x20d4c6 {
    local base:8;
    raw_mac_word(LC1, base);
    mac_r3_post_r0_control(base, 1:1, 1:1, 0x8000:8, LC1);
}
macro refresh_live_loop(counter, start, end) {
    LC = counter;
    publish_loop_word(start, LSAH, LSAL);
    publish_loop_word(end, LEAH, LEAL);
}

macro refresh_selected_loop() {
    if (LOOP_FRAME == 2) goto <bank2>;
    if (LOOP_FRAME == 3) goto <bank3>;
    if (LOOP_FRAME == 4) goto <bank4>;
    refresh_live_loop(LC1, LSA1W, LEA1W);
    goto <done>;
  <bank2>
    refresh_live_loop(LC2, LSA2W, LEA2W);
    goto <done>;
  <bank3>
    refresh_live_loop(LC3, LSA3W, LEA3W);
    goto <done>;
  <bank4>
    refresh_live_loop(LC4, LSA4W, LEA4W);
  <done>
}

:MACUS "PSTATUS","R4","*R2+RN2" is $(WIDE_MAC_CONTROL) & wide_0_22=0x2ad5c8 & wide_40_45=0x2a {
    local left:2 = R4;
    local address:2 = R2 + RN2;
    local right:2 = *[data]:2 address;
    local base:8;
    raw_mac_word(PSTATUS, base);
    local word:2;
    X1 = left;
    mac_high_control(base, left, right, 0:1, 0:1, 1:1, 0:8, word);
    wide_logic_rmw_pstatus(word);
    refresh_selected_loop();
}
:MACHUS "INTBASE","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x23d6c6 {
    local base:8 = sext(INTBASE);
    mac_r3_post_r0_control(base, 0:1, 1:1, 0:8, INTBASE);
}
:MACHUS "USER_IO","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x23d7c6 {
    local base:8 = sext(USER_IO);
    mac_r3_post_r0_control(base, 0:1, 1:1, 0:8, USER_IO);
}
:MACSU "RM2","*R7","R0" is $(WIDE_MAC_CONTROL) & wide_0_22=0x29b30f & wide_40_45=0x20 {
    local left:2 = *[data]:2 R7;
    local base:8;
    raw_mac_word(RM2, base);
    X1 = left;
    mac_high_control(base, left, R0, 0:1, 1:1, 0:1, 0:8, RM2);
}
:MSUUU "RN7","*"^absolute_data_addr,"RL6" is $(WIDE_MAC_CONTROL) & wide_0_22=0x2faf71 & wide_40_45=0x35 & absolute_data_addr {
    local address:2 = absolute_data_addr;
    local left:2 = *[data]:2 address;
    local base:8;
    raw_mac_word(RN7, base);
    X1 = left;
    mac_high_control(base, left, RL6, 1:1, 0:1, 0:1, 0:8, RN7);
}
:MACR "FF2","R3","*R0++" is $(WIDE_MAC_R3_R0) & wide_0_22=0x2097c6 {
    local base:8;
    raw_mac_word(FF2, base);
    mac_r3_post_r0_control(base, 1:1, 1:1, 0x8000:8, FF2);
}

macro wide_add_r4_post(left, shift, displacement) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    if (addresses == 0) goto <veto>;
    local address:2 = R4;
    local delta:2 = sext(displacement);
    modify_ptr(R4, delta, RM4, RL4, 8, 4);
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <veto>;
    local right:8 = ((zext(word) ^ 0x8000) - 0x8000) << shift;
    local result:8;
    wide_routed_arithmetic(left, right, 0:2, 0:1, 1:1, 0:1, result);
    R4 = result(2);
    goto <done>;
  <veto>
    publish_alu_ce(EST & 0xcfff);
  <done>
}

@define WIDE_ADD_R4_POST "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & logic_ce_bank=0 & wide_alias_add_op=8 & wide_alias_add_dst=0xa4 & wide_40_45=0x34 & wide_0_0=0 & wide_shift_dst_disp"
:ADD "CE1" "R4","LSA1","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd2 {
    local left:8 = zext(LSA1W & 0xffffff);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","LEA1","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd3 {
    local left:8 = zext(LEA1W & 0xffffff);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","LC","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd4 {
    local left:8;
    raw_mac_word(LC1, left);
    wide_add_r4_post(left, 16:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","PSTATUS","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd5 {
    local left:8 = sext(PSTATUS);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}
:ADD "CE1" "R4","USER_IO","*R4+="^wide_shift_dst_disp is $(WIDE_ADD_R4_POST) & wide_alias_add_lhs=0xd7 {
    local left:8 = sext(USER_IO);
    wide_add_r4_post(left, 0:4, wide_shift_dst_disp:1);
}

@define RAW_MAC_SEQ "((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0))"
@define RAW_MAC_PAR "carmel_issue=1 & slot_mode=0"
@define RAW_MAC_A4_SHIFT "slot_16_22=0x52 & slot_14_15=0 & slot_11_13=4 & slot_6_10=15 & slot_1_5=31 & slot_0_0=0"
@define RAW_MAC_A4_ROUND "slot_16_22=0x51 & slot_14_15=0 & slot_11_13=4 & slot_6_10=10 & slot_1_5=31 & slot_0_0=1"
@define RAW_MAC_A3_ROUND "slot_16_22=0x51 & slot_13_15=5 & slot_9_11=3 & slot_6_8=2 & slot_1_5=8 & slot_0_0=1"

:MACSU "A4","*R7+=RN7","OP2" is $(RAW_MAC_SEQ) & $(RAW_MAC_A4_SHIFT) {
    local address:2 = R7;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    X1 = *[data]:2 address;
    # The OP2 input is disconnected. The signed addend enters at bit 16.
    local exact:8 = ((zext(GB4) ^ 0x80) - 0x80) * 0x10000 + zext(A4H);
    local result:8;
    local active:2;
    raw_mac_finish(exact, 0:8, 0:1, 0:1, 0:1, result, active);
    A4L = result:2;
    A4H = result(2);
    GB4 = result(4);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:ADD "A0","*R4++","A3" is $(RAW_MAC_SEQ) & slot_16_22=0x13 & slot_12_14=1 & slot_9_11=0 & slot_4_8=12 & slot_1_3=3 & slot_15_15=0 & slot_0_0=0 {
    local address:2 = R4;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local word:2 = *[data]:2 address;
    local base:8;
    compact_long_sample(A3L, A3H, GB3, base);
    local result:8;
    local active:2;
    raw_mac_add((zext(word) ^ 0x8000) - 0x8000, (base ^ 0x8000000000) - 0x8000000000, 0:8, 0:1, 0:1, result, active);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:MSUR "CE1" "A4","*R2+=RN2","OP2" is $(RAW_MAC_SEQ) & $(RAW_MAC_A4_ROUND) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local address:2 = R2;
    modify_ptr(R2, RN2, RM2, RL2, 4, 1);
    local word:2 = *[data]:2 address;
    X1 = word;
    if (enabled == 0) goto <publish>;
    local base:8;
    compact_long_sample(A4L, A4H, GB4, base);
    local result:8;
    local active:2;
    raw_mac_round_sub(base, word, 0:2, result, active);
    A4L = result:2;
    A4H = result(2);
    GB4 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MSUR "CE1" "A3","*R2+RN2","RN0" is $(RAW_MAC_SEQ) & $(RAW_MAC_A3_ROUND) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local address:2 = R2 + RN2;
    local word:2 = *[data]:2 address;
    X1 = word;
    if (enabled == 0) goto <publish>;
    local base:8;
    compact_long_sample(A3L, A3H, GB3, base);
    local result:8;
    local active:2;
    raw_mac_round_sub(base, word, RN0, result, active);
    A3L = result:2;
    A3H = result(2);
    GB3 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MPY "X2","*R1","*R0+=RN0" is $(RAW_MAC_SEQ) & slot_16_22=0x43 & slot_15_15=0 & slot_11_14=15 & slot_6_10=1 & slot_1_5=8 & slot_0_0=0 {
    local first_address:2 = R1;
    local second_address:2 = R0;
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    local product:8;
    raw_mac_product(first, second, 1:1, 1:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, result, active);
    X1 = first;
    X2 = result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:ADDC "CE1" "*R2","R4","*R4++" is $(RAW_MAC_SEQ) & slot_16_22=0x14 & slot_15_15=0 & slot_11_14=2 & slot_6_10=4 & slot_1_5=20 & slot_0_0=1 {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local old_r4:2 = R4;
    local destination:2 = R2;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local word:2 = *[data]:2 old_r4;
    if (enabled == 0) goto <publish>;
    local a:8;
    local b:8;
    raw_mac_word(old_r4, a);
    raw_mac_word(word, b);
    local result:8;
    local active:2;
    raw_mac_add(a, b, zext(EST & 1) << 16, 1:1, 1:1, result, active);
    *[data]:2 destination = result(2);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MSUR "A3","*R4++","*R6+RN6" "||" "MSUUS" "CE2" "FF12","*R7+=RN7","A0L" is ($(RAW_MAC_PAR) & slot_16_22=0x51 & slot_13_15=4 & slot_9_11=3 & slot_4_8=20 & slot_1_3=6 & slot_0_0=0); (slot_mode=0 & slot_16_22=0x5e & slot_14_15=0 & slot_11_13=6 & slot_6_10=15 & slot_1_5=16 & slot_0_0=1) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG2, 1, enabled, addresses);
    local first_address:2 = R4;
    local second_address:2 = R6 + RN6;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local first:2 = *[data]:2 first_address;
    local second:2 = *[data]:2 second_address;
    local base:8;
    compact_long_sample(A3L, A3H, GB3, base);
    local left_result:8;
    local left_flags:2;
    raw_mac_round_sub(base, first, second, left_result, left_flags);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    X1 = first;
    A3L = left_result:2;
    A3H = left_result(2);
    GB3 = left_result(4);
    if (addresses == 0) goto <publish>;
    local right_address:2 = R7;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    local word:2 = *[data]:2 right_address;
    X2 = word;
    if (enabled == 0) goto <publish>;
    local product:8;
    raw_mac_product(word, A0L, 0:1, 1:1, product);
    local pair:8 = (zext(FF2) << 16) | zext(FF1);
    local right_result:8;
    local right_flags:2;
    raw_mac_finish(pair - product, pair + (~product & 0xffffffffff) + 1, 0:1, 0:1, 0:1, right_result, right_flags);
    FF1 = right_result:2;
    FF2 = right_result(2);
    raw_mac_flags(flags, right_flags, 6);
  <publish>
    publish_alu_ce(flags);
}

:ADDC "X2","A4L","*R6--" is $(RAW_MAC_SEQ) & slot_16_22=0x14 & slot_15_15=1 & slot_11_14=15 & slot_6_10=20 & slot_1_5=30 & slot_0_0=0 {
    local address:2 = R6;
    modify_ptr(R6, RN6, RM6, RL6, 12, 3);
    local word:2 = *[data]:2 address;
    local a:8;
    local b:8;
    raw_mac_word(A4L, a);
    raw_mac_word(word, b);
    local result:8;
    local active:2;
    raw_mac_add(a, b, zext(EST & 1) << 16, 1:1, 0:1, result, active);
    X2 = result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 0);
    publish_alu_ce(flags);
}

:MPYUS "CE1" "A5","R2","A0L" is $(RAW_MAC_SEQ) & slot_16_22=0x49 & slot_13_15=3 & slot_9_11=5 & slot_4_8=2 & slot_1_3=0 & slot_0_0=1 {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG1, 0, enabled, addresses);
    local flags:2 = EST & 0xcfff;
    if (addresses == 0) goto <publish>;
    local first:2 = R2;
    X1 = first;
    if (enabled == 0) goto <publish>;
    local product:8;
    raw_mac_product(first, A0L, 0:1, 1:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 0:1, 0:1, 0:1, result, active);
    A5L = result:2;
    A5H = result(2);
    GB5 = result(4);
    raw_mac_flags(flags, active, 0);
  <publish>
    publish_alu_ce(flags);
}

:MPYUS "discard","FF2","*R4--" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=0x1c & wide_0_22=0x32fdae {
    local address:2 = R4;
    modify_ptr(R4, RN4, RM4, RL4, 8, 3);
    local word:2 = *[data]:2 address;
    X1 = FF2;
    publish_alu_ce(EST & 0xcfff);
}

:MPYUU "A1H","R2","A0L" "||" "ADDABS" "CE2" "X2","RN6","*R7+RN7" is ($(RAW_MAC_PAR) & slot_16_22=0x4e & slot_13_15=6 & slot_9_12=9 & slot_4_8=2 & slot_1_3=0 & slot_0_0=0); (slot_mode=0 & slot_16_22=0x1f & slot_13_15=3 & slot_9_12=14 & slot_4_8=14 & slot_1_3=7 & slot_0_0=1) {
    local enabled:2;
    local addresses:2;
    raw_mac_predicate(CECFG2, 1, enabled, addresses);
    local first:2 = R2;
    local product:8;
    raw_mac_product(first, A0L, 0:1, 0:1, product);
    local left_result:8;
    local left_flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, left_result, left_flags);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    X1 = first;
    A1H = left_result(2);
    if (addresses == 0) goto <publish>;
    local address:2 = R7 + RN7;
    local word:2 = *[data]:2 address;
    if (enabled == 0) goto <publish>;
    local a:8;
    local b:8;
    raw_mac_word(RN6, a);
    raw_mac_word(word, b);
    if (a s>= 0) goto <absolute>;
    a = -a;
  <absolute>
    local right_result:8;
    local right_flags:2;
    raw_mac_add(a, b, 0:8, 1:1, 0:1, right_result, right_flags);
    X2 = right_result(2);
    raw_mac_flags(flags, right_flags, 6);
  <publish>
    publish_alu_ce(flags);
}

:ADD "*R1+=RN1","*R7+=RN7","*R5" "||" "MPYUS" "X2","*R4+RN4","*R2--" is ($(RAW_MAC_PAR) & slot_16_22=0x11 & slot_14_15=1 & slot_9_13=29 & slot_4_8=14 & slot_1_3=1 & slot_0_0=0); (slot_mode=0 & slot_16_22=0x4b & slot_13_15=4 & slot_9_12=14 & slot_6_8=4 & slot_1_5=26 & slot_0_0=0) {
    local destination:2 = R1;
    local left_first:2 = R7;
    local left_second:2 = R5;
    local right_first:2 = R4 + RN4;
    local right_second:2 = R2;
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    modify_ptr(R1, RN1, RM0, RL0, 2, 1);
    modify_ptr(R2, RN2, RM2, RL2, 4, 3);
    local term1:2 = *[data]:2 left_first;
    local term2:2 = *[data]:2 left_second;
    local multiplier:2 = *[data]:2 right_first;
    local multiplicand:2 = *[data]:2 right_second;
    local a:8;
    local b:8;
    raw_mac_word(term1, a);
    raw_mac_word(term2, b);
    local left_result:8;
    local left_flags:2;
    raw_mac_add(a, b, 0:8, 1:1, 1:1, left_result, left_flags);
    local product:8;
    raw_mac_product(multiplier, multiplicand, 0:1, 1:1, product);
    local right_result:8;
    local right_flags:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, right_result, right_flags);
    # The multiplier consumes its fetched input, not the incoming X2.
    # The word result then supersedes that OF latch in WB.
    X2 = right_result(2);
    *[data]:2 destination = left_result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, left_flags, 0);
    raw_mac_flags(flags, right_flags, 6);
    publish_alu_ce(flags);
}

:^nop_left "||" "MPYUU" "X2","R2","A0L" is ($(RAW_MAC_PAR) & nop_left); (slot_mode=0 & slot_16_22=0x4e & slot_13_15=6 & slot_9_12=15 & slot_4_8=2 & slot_1_3=0 & slot_0_0=0) {
    local product:8;
    raw_mac_product(R2, A0L, 0:1, 0:1, product);
    local result:8;
    local active:2;
    raw_mac_finish(product, product & 0xffffffffff, 1:1, 1:1, 0:1, result, active);
    X2 = result(2);
    local flags:2 = EST & 0xcfff;
    raw_mac_flags(flags, active, 6);
    publish_alu_ce(flags);
}

attach variables [minmax_dst_acc minmax_src_acc] [A0 A1 A2 A3 A4 A5 _ _];
attach variables [minmax_dst_lo minmax_src_lo] [A0L A1L A2L A3L A4L A5L _ _];
attach variables [minmax_dst_hi minmax_src_hi] [A0H A1H A2H A3H A4H A5H _ _];
attach variables [minmax_dst_guard minmax_src_guard] [GB0 GB1 GB2 GB3 GB4 GB5 _ _];
attach variables [minmax_dst_word minmax_src_word] [A0L A1L A2L A3L A4L A5L FF1 FF2 A0H A1H A2H A3H A4H A5H X1 X2];
attach variables [minmax_ref_base_lo] [R0 R1 R2 R3];
attach variables [minmax_ref_base_hi] [R4 R5 R6 R7];
attach variables [minmax_ref_mod_lo] [RM0 RM0 RM2 RM2];
attach variables [minmax_ref_mod_hi] [RM4 RM4 RM6 RM6];
attach variables [minmax_ref_bound_lo] [RL0 RL0 RL2 RL2];
attach variables [minmax_ref_bound_hi] [RL4 RL4 RL6 RL6];
attach values [minmax_ref_shift_lo] [0 2 4 6];
attach values [minmax_ref_shift_hi] [8 10 12 14];
attach variables [minmax_ref_guard_lo] [GB0 GB1 GB2 GB3];
attach variables [minmax_ref_guard_hi] [GB4 GB5 _ _];

minmax_predicate: is carmel_issue=5 & wide_left_mode=1 { export 3:2; }
minmax_predicate: "CE1" is carmel_issue=4 & wide_left_mode=0 & minmax_ce_bank=0 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local stages:2 = enabled | ((enabled | ((CECFG1 >> 12) & 1)) << 1);
    export stages;
}
minmax_predicate: "CE2" is carmel_issue=4 & wide_left_mode=0 & minmax_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local stages:2 = enabled | ((enabled | ((CECFG2 >> 12) & 1)) << 1);
    export stages;
}

# A DATA reference drives MINMAX from its effective address, not from the
# addressed value. Its postmodify belongs to address generation.
minmax_disp_addr: "*"^minmax_ref_base_lo^"+"^minmax_ref_disp is minmax_ref_type=0 & minmax_ref_mode=4 & minmax_ref_bank=0 & minmax_ref_base_lo & minmax_ref_disp {
    local address:2 = minmax_ref_base_lo + minmax_ref_disp;
    export address;
}
minmax_disp_addr: "*"^minmax_ref_base_hi^"+"^minmax_ref_disp is minmax_ref_type=0 & minmax_ref_mode=4 & minmax_ref_bank=1 & minmax_ref_base_hi & minmax_ref_disp {
    local address:2 = minmax_ref_base_hi + minmax_ref_disp;
    export address;
}
minmax_abs_addr: "*"^absolute_data_addr is minmax_ref_mode=7 & minmax_ref_type<2 & absolute_data_addr {
    export *[const]:2 absolute_data_addr;
}
minmax_guard_ref: minmax_ref_guard_lo is minmax_ref_type=2 & minmax_ref_mode=0 & minmax_ref_bank=0 & minmax_ref_guard_lo { export minmax_ref_guard_lo; }
minmax_guard_ref: minmax_ref_guard_hi is minmax_ref_type=2 & minmax_ref_mode=0 & minmax_ref_bank=1 & minmax_ref_index<2 & minmax_ref_guard_hi { export minmax_ref_guard_hi; }

macro minmax_ref_update(base, modulo, bound, shift, delta, address) {
    address = base;
    local next:2;
    local step:2 = delta;
    transfer_address_word(base, modulo, bound, shift, step, next);
    base = next;
}
minmax_postdisp_addr: "*"^minmax_ref_base_lo^"+="^minmax_ref_disp is minmax_ref_type=1 & minmax_ref_mode=6 & minmax_ref_bank=0 & minmax_ref_base_lo & minmax_ref_mod_lo & minmax_ref_bound_lo & minmax_ref_shift_lo & minmax_ref_disp {
    local address:2;
    minmax_ref_update(minmax_ref_base_lo, minmax_ref_mod_lo, minmax_ref_bound_lo, minmax_ref_shift_lo, minmax_ref_disp, address);
    export address;
}
minmax_postdisp_addr: "*"^minmax_ref_base_hi^"+="^minmax_ref_disp is minmax_ref_type=1 & minmax_ref_mode=6 & minmax_ref_bank=1 & minmax_ref_base_hi & minmax_ref_mod_hi & minmax_ref_bound_hi & minmax_ref_shift_hi & minmax_ref_disp {
    local address:2;
    minmax_ref_update(minmax_ref_base_hi, minmax_ref_mod_hi, minmax_ref_bound_hi, minmax_ref_shift_hi, minmax_ref_disp, address);
    export address;
}
minmax_postinc_addr: "*"^minmax_ref_base_lo^"++:long" is minmax_ref_type=1 & minmax_ref_mode=2 & minmax_ref_bank=0 & minmax_ref_base_lo & minmax_ref_mod_lo & minmax_ref_bound_lo & minmax_ref_shift_lo {
    local address:2;
    minmax_ref_update(minmax_ref_base_lo, minmax_ref_mod_lo, minmax_ref_bound_lo, minmax_ref_shift_lo, 2:2, address);
    export address;
}
minmax_postinc_addr: "*"^minmax_ref_base_hi^"++:long" is minmax_ref_type=1 & minmax_ref_mode=2 & minmax_ref_bank=1 & minmax_ref_base_hi & minmax_ref_mod_hi & minmax_ref_bound_hi & minmax_ref_shift_hi {
    local address:2;
    minmax_ref_update(minmax_ref_base_hi, minmax_ref_mod_hi, minmax_ref_bound_hi, minmax_ref_shift_hi, 2:2, address);
    export address;
}

macro minmax_upper_result(dst, left, right, better, address) {
    local selected:8 = left;
    if (!better) goto <select_upper>;
    selected = right;
    MINMAX = address;
  <select_upper>
    dst = selected(2);
}
macro minmax_unsigned_flags(left, right) {
    EST = (EST & 0xfff6) | zext(left <= right) | (zext(left == right) << 3);
}
macro minmax_signed_flags(left, right) {
    local delta:8 = right - left;
    local overflow:1 = delta s> 0x7fffffffff || delta s< -0x8000000000;
    local sticky:1 = overflow && ((ECFG & 0xc) == 0);
    local flags:2 = (zext(overflow) << 1) | (zext(sticky) << 2) |
                    (zext((delta & 0xffffffffff) == 0) << 3) | (zext((delta & 0x8000000000) != 0) << 4);
    EST = (EST & 0xffe5) | flags;
}

@define WIDE_MINMAX "wide_right_mode=1 & minmax_predicate"
@define WIDE_MINMAX_GUARD "minmax_dst_group=0 & wide_8_9<3 & minmax_dst_guard"
@define WIDE_MINMAX_SPECIAL_WORD "minmax_dst_group>=2 & wide_8_9=3 & minmax_dst_word"
@define WIDE_MINMAX_SOURCE_WORD "minmax_src_group>=2 & minmax_src_word"
@define WIDE_MINMAX_SOURCE_ACC "minmax_src_group=1 & minmax_src_acc_index<6 & minmax_src_acc & minmax_src_lo & minmax_src_hi & minmax_src_guard"

:MAXMU minmax_predicate minmax_dst_guard,minmax_src_word,minmax_disp_addr is $(WIDE_MINMAX) & wide_12_22=0x4af & $(WIDE_MINMAX_GUARD) & $(WIDE_MINMAX_SOURCE_WORD) & minmax_disp_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_guard);
    local right:8 = zext(minmax_src_word);
    minmax_upper_result(minmax_dst_guard, left, right, left < right, minmax_disp_addr);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXM minmax_predicate minmax_dst_guard,minmax_src_word,minmax_abs_addr is $(WIDE_MINMAX) & wide_12_22=0x4ae & $(WIDE_MINMAX_GUARD) & $(WIDE_MINMAX_SOURCE_WORD) & minmax_ref_type=0 & minmax_abs_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_guard);
    local right:8 = sext(minmax_src_word);
    minmax_upper_result(minmax_dst_guard, left, right, left s< right, minmax_abs_addr);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXMU minmax_predicate minmax_dst_word,minmax_src_word,minmax_guard_ref is $(WIDE_MINMAX) & wide_12_22=0x4af & $(WIDE_MINMAX_SPECIAL_WORD) & $(WIDE_MINMAX_SOURCE_WORD) & minmax_guard_ref {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_word);
    local right:8 = zext(minmax_src_word);
    local address:2 = zext(minmax_guard_ref);
    minmax_upper_result(minmax_dst_word, left, right, left < right, address);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MINMU minmax_predicate minmax_dst_word,minmax_src_word,minmax_abs_addr is $(WIDE_MINMAX) & wide_12_22=0x4ad & minmax_dst_group=2 & wide_8_9<3 & minmax_dst_word & $(WIDE_MINMAX_SOURCE_WORD) & minmax_ref_type=1 & minmax_abs_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_word);
    local right:8 = zext(minmax_src_word);
    minmax_upper_result(minmax_dst_word, left, right, left > right, minmax_abs_addr);
    minmax_unsigned_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXMU minmax_predicate minmax_dst_acc,minmax_src_word,minmax_postdisp_addr is $(WIDE_MINMAX) & wide_12_22=0x4af & minmax_dst_group=1 & wide_8_9<3 & minmax_dst_acc & minmax_dst_lo & minmax_dst_hi & minmax_dst_guard & $(WIDE_MINMAX_SOURCE_WORD) & minmax_postdisp_addr {
    if ((minmax_predicate & 2) == 0) goto <feedback>;
    build minmax_postdisp_addr;
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_guard) * 0x100000000 + zext(minmax_dst_hi) * 0x10000 + zext(minmax_dst_lo);
    local right:8 = zext(minmax_src_word);
    if (left >= right) goto <compare_flags>;
    minmax_dst_lo = minmax_src_word;
    minmax_dst_hi = 0;
    minmax_dst_guard = 0;
    MINMAX = minmax_postdisp_addr;
  <compare_flags>
    minmax_unsigned_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXM minmax_predicate minmax_dst_word,minmax_src_acc,minmax_disp_addr is $(WIDE_MINMAX) & wide_12_22=0x4ae & minmax_dst_group=2 & wide_8_9<3 & minmax_dst_word & $(WIDE_MINMAX_SOURCE_ACC) & minmax_disp_addr {
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = sext(minmax_dst_word);
    local right:8 = sext(minmax_src_guard) * 0x100000000 + zext(minmax_src_hi) * 0x10000 + zext(minmax_src_lo);
    minmax_upper_result(minmax_dst_word, left, right, left s< right, minmax_disp_addr);
    minmax_signed_flags(left, right);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXMU minmax_predicate minmax_dst_word,minmax_src_word,minmax_postinc_addr is $(WIDE_MINMAX) & wide_12_22=0x4af & minmax_dst_group=3 & wide_8_9=3 & minmax_dst_word & $(WIDE_MINMAX_SOURCE_WORD) & minmax_postinc_addr {
    if ((minmax_predicate & 2) == 0) goto <feedback>;
    build minmax_postinc_addr;
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    local left:8 = zext(minmax_dst_word);
    local right:8 = zext(minmax_src_word);
    minmax_upper_result(minmax_dst_word, left, right, left < right, minmax_postinc_addr);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}

macro minmax_store_long(address, value) {
    local upper:2 = address + 1;
    *[data]:2 address = value:2;
    *[data]:2 upper = value(2);
}

macro minmax_signed_max_word(lhs, rhs, selected) {
    local left:8 = sext(lhs);
    local right:8 = sext(rhs);
    selected = lhs;
    if (left s>= right) goto <flags>;
    selected = rhs;
  <flags>
    minmax_signed_flags(left, right);
}

minmax_store_indexed: is wide_40_45=0x3c {
    local address:2 = R7;
    if ((PACFG & 0xc000) != 0x4000) goto <ordinary>;
    local reversed:2;
    local step:2;
    reverse_word(address, reversed);
    reverse_word(RN7, step);
    local sum:2 = reversed + step;
    reverse_word(sum, R7);
    goto <done>;
  <ordinary>
    minmax_ref_update(R7, RM6, RL6, 14, RN7, address);
  <done>
    export address;
}

# The unbound selector reads one word at the all-ones DATA address, even
# when the result is stored as a pair and an independent literal is encoded.
minmax_store_source: "*0xffff" is wide_0_22=0x48c5f7 {
    local sample:2 = *[data]:2 0xffff:2;
    export sample;
}
minmax_store_source: "A1L" is wide_0_22=0x48c5f8 { export A1L; }

@define WIDE_EXTREMA_STORE "$(WIDE_MINMAX) & carmel_issue=4 & minmax_ce_bank=1"
@define EXTREMA_INDEXED "$(WIDE_EXTREMA_STORE) & minmax_store_indexed"
@define EXTREMA_INDEXED_PREDICATE "if ((minmax_predicate & 2) == 0) goto <feedback>; build minmax_store_indexed; if ((minmax_predicate & 1) == 0) goto <feedback>;"
:MAX minmax_predicate "long *R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48c4f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local word:2;
    minmax_signed_max_word(A4H, sample, word);
    local extended:4 = sext(word);
    minmax_store_long(minmax_store_indexed, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAX minmax_predicate "*R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48c0f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local word:2;
    minmax_signed_max_word(A4H, sample, word);
    *[data]:2 minmax_store_indexed = word;
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAX minmax_predicate "long *R7--",minmax_store_source,wide_load_literal_bits is $(WIDE_EXTREMA_STORE) & wide_40_45=0x2f & minmax_store_source & wide_load_literal_bits {
    if ((minmax_predicate & 2) == 0) goto <feedback>;
    local address:2;
    minmax_ref_update(R7, RM6, RL6, 14, -2:2, address);
    if ((minmax_predicate & 1) == 0) goto <feedback>;
    build minmax_store_source;
    local word:2;
    minmax_signed_max_word(wide_load_literal_bits:2, minmax_store_source, word);
    local extended:4 = sext(word);
    minmax_store_long(address, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MINBTR2 minmax_predicate "long *R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48a4f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local left:8 = sext(A4H);
    local right:8 = sext(sample);
    local take_right:1 = right s< left;
    BTR2 = (BTR2 << 1) | zext(take_right);
    minmax_signed_flags(left, right);
    local extended:4 = left:4;
    if (!take_right) goto <write>;
    extended = right:4;
  <write>
    minmax_store_long(minmax_store_indexed, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
:MAXU minmax_predicate "long *R7+=RN7","*0xffff","A4H" is $(EXTREMA_INDEXED) & wide_0_22=0x48d4f7 {
    $(EXTREMA_INDEXED_PREDICATE)
    local sample:2 = *[data]:2 0xffff:2;
    local left:8 = zext(A4H);
    local right:8 = zext(sample);
    minmax_unsigned_flags(left, right);
    local extended:4 = left:4;
    if (left >= right) goto <write>;
    extended = right:4;
  <write>
    minmax_store_long(minmax_store_indexed, extended);
  <feedback>
    publish_alu_ce(EST & 0xcfff);
}
@undef EXTREMA_INDEXED_PREDICATE
@undef EXTREMA_INDEXED
@undef WIDE_EXTREMA_STORE

# The word port is the upper half of the low 32-bit lane, not the low
# half of the shifter. Z still observes the guard above that word.
macro wide_shift_ports(input, count_word, left_tap, right_bias, arithmetic, result, flags) {
    local count:4 = (zext(count_word & 0x7f) ^ 64) - 64;
    local carry_bit:1 = (EST & 1) != 0;
    result = input;
    if (count == 0) goto <shift_status>;
    if (count s< 0) goto <shift_right>;
    if (count s<= 40) goto <shift_left>;
    count = 40;
  <shift_left>
    result = (input & 0xffffffffff) << count;
    carry_bit = 0;
    if (count s> left_tap) goto <shift_status>;
    carry_bit = ((input >> (left_tap - count)) & 1) != 0;
    goto <shift_status>;
  <shift_right>
    count = -count;
    if (count s<= 40) goto <shift_right_bounded>;
    count = 40;
  <shift_right_bounded>
    if (arithmetic != 0) goto <shift_arithmetic>;
    result = input >> count;
    goto <shift_right_carry>;
  <shift_arithmetic>
    result = input s>> count;
  <shift_right_carry>
    carry_bit = ((input >> (count - 1 + right_bias)) & 1) != 0;
  <shift_status>
    result = result & 0xffffffffff;
    local observed:8 = result & (0xffffffffff ^ (zext(right_bias != 0) * 0xffff));
    shift_flags(observed, carry_bit, flags);
}

:LSHIFT "*R0","*R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x700004 {
    local source:2 = *[data]:2 R2;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(source) << 16;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    *[data]:2 R0 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "*R0","long *R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x700084 {
    local upper:2 = R2 + 1;
    local low:2 = *[data]:2 R2;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    *[data]:2 R0 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "long *R0","long *R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x708084 {
    local upper:2 = R2 + 1;
    local low:2 = *[data]:2 R2;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 0:4, 0:1, result, flags);
    local next:2 = R0 + 1;
    *[data]:2 R0 = result:2;
    *[data]:2 next = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "A0","long *R2","*R1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=1 & wide_0_22=0x711084 {
    local upper:2 = R2 + 1;
    local low:2 = *[data]:2 R2;
    local high:2 = *[data]:2 upper;
    local count:2 = *[data]:2 R1;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 40:4, 0:4, 0:1, result, flags);
    A0L = result:2;
    A0H = result(2);
    GB0 = result(4);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

:LSHIFT "CE1" "*R6++("^wide_shift_dst_disp^")","*(R3+RN3)","*(R2+"^wide_shift_count_disp^")" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_40_45=0x22 & wide_0_22=0x706c56 & unary_wide_ce_bank=0 & wide_shift_dst_disp & wide_shift_count_disp {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <shift_veto>;
    local dest:2 = R6;
    local source_addr:2 = R3 + RN3;
    local count_addr:2 = R2 + sext(wide_shift_count_disp:1);
    local delta:2 = sext(wide_shift_dst_disp:1);
    local next:2;
    transfer_address_word(R6, RM6, RL6, 12, delta, next);
    R6 = next;
    local source:2 = *[data]:2 source_addr;
    local count:2 = *[data]:2 count_addr;
    local input:8 = zext(source) << 16;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 0:1, result, flags);
    *[data]:2 dest = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
  <shift_veto>
}

:LSHIFT "CE2" "R2","long *(R3+RN3)","A0L" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & wide_40_45=0x10 & wide_0_22=0x7144d7 & unary_wide_ce_bank=1 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <shift_veto>;
    local addr:2 = R3 + RN3;
    local upper:2 = addr + 1;
    local low:2 = *[data]:2 addr;
    local high:2 = *[data]:2 upper;
    local input:8 = zext(low) | (zext(high) << 16);
    local result:8;
    local flags:2;
    wide_shift_ports(input, A0L, 32:4, 16:4, 0:1, result, flags);
    R2 = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
  <shift_veto>
}

:ASHIFT "*R6++","*R0--","*R4" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_40_45=4 & wide_0_22=0x722c30 {
    local dest:2 = R6;
    local source_addr:2 = R0;
    local next:2;
    transfer_address_word(R6, RM6, RL6, 12, 1:2, next);
    R6 = next;
    transfer_address_word(R0, RM0, RL0, 0, 0xffff:2, next);
    R0 = next;
    local source:2 = *[data]:2 source_addr;
    local count:2 = *[data]:2 R4;
    local input:8 = sext(source) * 0x10000;
    local result:8;
    local flags:2;
    wide_shift_ports(input, count, 32:4, 16:4, 1:1, result, flags);
    shift_limit(result, flags);
    *[data]:2 dest = result(2);
    publish_alu_ce((EST & 0xcfc6) | flags);
}

@define PACKED_WIDE "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1"
@define PACKED_WIDE_CE2 "carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & unary_wide_ce_bank=1"

packed_short_dst: packed_dst_r is packed_dst_group=0xc & packed_dst_r { export packed_dst_r; }
packed_short_dst: "FF1" is packed_dst=0x56 { export FF1; }
packed_lhs_word: packed_lhs_hi is packed_lhs_group=0xb & packed_lhs_hi { export packed_lhs_hi; }
packed_rhs_word: packed_rhs_hi is wide_0_0=1 & packed_rhs_group=3 & packed_rhs_hi { export packed_rhs_hi; }
packed_rmw: "RMW1" is packed_dst=0x46 { }
packed_rmw: "RMW2" is packed_dst=0x47 { }

macro packed_arithmetic_word_ce2(dst, lhs, rhs, subtract) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0) goto <publish>;
    # Two short operands feed the high lane of a connected short result.
    if (subtract != 0) goto <packed_subtract>;
    dst = lhs + rhs;
    goto <publish>;
  <packed_subtract>
    dst = lhs - rhs;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

macro packed_min_trace(high, low) {
    BTR1 = (BTR1 << 1) | zext(high);
    BTR2 = (BTR2 << 1) | zext(low);
}

macro packed_r2_long(displacement, high, low) {
    local address:2 = R2;
    local next:2 = address + 1;
    low = *[data]:2 address;
    high = *[data]:2 next;
    local encoded_delta:1 = displacement;
    local delta:2 = sext(encoded_delta);
    transfer_address_word(R2, RM2, RL2, 4, delta, R2);
}

:"ADD2 CE2" packed_short_dst,packed_lhs_word,packed_rhs_word is $(PACKED_WIDE_CE2) & packed_opcode=0x88 & packed_short_dst & packed_lhs_word & packed_rhs_word {
    packed_arithmetic_word_ce2(packed_short_dst, packed_lhs_word, packed_rhs_word, 0:1);
}
:"SUB2 CE2" packed_short_dst,packed_lhs_word,packed_rhs_word is $(PACKED_WIDE_CE2) & packed_opcode=0x89 & packed_dst_group=0xc & packed_short_dst & packed_lhs_word & packed_rhs_word {
    packed_arithmetic_word_ce2(packed_short_dst, packed_lhs_word, packed_rhs_word, 1:1);
}
:"ADD2 CE2" "RMW1",packed_lhs_word,packed_rhs_word is $(PACKED_WIDE_CE2) & packed_opcode=0x88 & packed_dst=0x46 & packed_lhs_word & packed_rhs_word {
    packed_arithmetic_word_ce2(packed_lhs_word, packed_lhs_word, packed_rhs_word, 0:1);
}

:MIN2 packed_short_dst,packed_lhs_word,packed_rhs_word is $(PACKED_WIDE) & packed_opcode=0x8b & packed_dst_group=0xc & packed_short_dst & packed_lhs_word & packed_rhs_word {
    local take_left:1 = packed_lhs_word s< packed_rhs_word;
    packed_min_trace(take_left, 0:1);
    packed_short_dst = packed_rhs_word;
    if (take_left == 0) goto <publish>;
    packed_short_dst = packed_lhs_word;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:MIN2 "RMW2",packed_lhs_word,packed_rhs_word is $(PACKED_WIDE) & packed_opcode=0x8b & packed_dst=0x47 & packed_lhs_word & packed_rhs_word {
    # The sink does not realign the two short operands to the high lane.
    local left_high:2 = 0 - zext(packed_lhs_word s< 0);
    local right_high:2 = 0 - zext(packed_rhs_word s< 0);
    packed_min_trace(left_high s< right_high, packed_lhs_word s< packed_rhs_word);
    publish_alu_ce(EST & 0xcfff);
}
:MIN2 packed_rmw,"*R2+="^packed_displacement^":long",packed_rhs_word is $(PACKED_WIDE) & packed_opcode=0x8b & packed_rmw & packed_lhs_code=0x32 & packed_displacement & packed_rhs_word {
    local left_low:2;
    local left_high:2;
    packed_r2_long(packed_displacement, left_high, left_low);
    local right_high:2 = 0 - zext(packed_rhs_word s< 0);
    packed_min_trace(left_high s< right_high, left_low s< packed_rhs_word);
    publish_alu_ce(EST & 0xcfff);
}
:MIN2 "OP3",packed_lhs_word,"*R2+="^packed_displacement^":long" is $(PACKED_WIDE) & packed_opcode=0x8b & packed_dst=0x4e & packed_lhs_word & wide_0_0=0 & wide_40_45=0x32 & packed_displacement {
    local right_low:2;
    local right_high:2;
    packed_r2_long(packed_displacement, right_high, right_low);
    local left_high:2 = 0 - zext(packed_lhs_word s< 0);
    packed_min_trace(left_high s< right_high, packed_lhs_word s< right_low);
    publish_alu_ce(EST & 0xcfff);
}

:TRANSFER "R2","A0L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x100422 & transfer_roles_imm { R2 = A0L + transfer_roles_imm; }
:TRANSFER "R2","A1L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1004a2 & transfer_roles_imm { R2 = A1L + transfer_roles_imm; }
:TRANSFER "R2","FF1",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101f22 & transfer_roles_imm { R2 = FF1 + transfer_roles_imm; }
:TRANSFER "R2","LSA1L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x102922 & transfer_roles_imm { R2 = LSA1L + transfer_roles_imm; }
:TRANSFER "R2","LEA1L",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1029a2 & transfer_roles_imm { R2 = LEA1L + transfer_roles_imm; }
:TRANSFER "R2","LC1",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x102a22 & transfer_roles_imm { R2 = LC1 + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x100322 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1003a2 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x100722 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1007a2 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x103022 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "R2","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x103fa2 & transfer_roles_imm { R2 = 0xffff + transfer_roles_imm; }
:TRANSFER "A0L","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101188 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, A0L); }
:TRANSFER "A1L","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101189 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, A1L); }
:TRANSFER "FF1","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011be & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, FF1); }
:TRANSFER "LSA1L","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011d2 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, LSA1L); }
:TRANSFER "LEA1L","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011d3 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, LEA1L); }
:TRANSFER "LC1","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011d4 & transfer_roles_imm { local delta:2 = transfer_roles_imm; transfer_address_word(R3, RM2, RL2, 6, delta, LC1); }
:TRANSFER "discard","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101186 & transfer_roles_imm {  }
:TRANSFER "discard","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x101187 & transfer_roles_imm {  }
:TRANSFER "discard","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x10118e & transfer_roles_imm {  }
:TRANSFER "discard","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x10118f & transfer_roles_imm {  }
:TRANSFER "discard","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011e0 & transfer_roles_imm {  }
:TRANSFER "discard","R3",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x1011ff & transfer_roles_imm {  }
:TRANSFER "discard","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x103de5 & transfer_roles_imm {  }
:TRANSFER "discard","open",transfer_roles_imm is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_22=0x103e86 & transfer_roles_imm {  }

# Absolute peripheral words, distinct from ordinary DATA.
io_word: "IO["^io_word_address^"]" is io_word_address { export *[io]:2 io_word_address; }
ext_read_word: "EXT["^peripheral_address^"]" is ext_read_word_0 & ext_read_word_6 [ peripheral_address = ext_read_word_0 | (ext_read_word_6 << 6); ] { export *[ext]:2 peripheral_address; }
ext_write_word: "EXT["^ext_write_word_address^"]" is ext_write_word_address { export *[ext]:2 ext_write_word_address; }
peripheral_literal: peripheral_literal_bits is peripheral_literal_bits { export *[const]:2 peripheral_literal_bits; }
:MOVE "A0",io_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_11=0x620 & wide_14_22=0x119 & wide_40_45=0x0 & io_word { A0 = zext(io_word); }
:MOVE "CE1" "A0",io_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=0 & wide_0_11=0x620 & wide_14_22=0x119 & wide_40_45=0x0 & io_word { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <peripheral_done>; A0 = zext(io_word); <peripheral_done> }
:MOVE "CE2" "A0",io_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=1 & wide_0_11=0x620 & wide_14_22=0x119 & wide_40_45=0x0 & io_word { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <peripheral_done>; A0 = zext(io_word); <peripheral_done> }
:MOVE "A0L",io_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_11=0x640 & wide_14_22=0x119 & io_word { A0L = io_word; }
:MOVE "CE1" "A0L",io_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=0 & wide_0_11=0x640 & wide_14_22=0x119 & io_word { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0) goto <peripheral_done>; A0L = io_word; <peripheral_done> }
:MOVE "CE2" "A0L",io_word is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & peripheral_ce_bank=1 & wide_0_11=0x640 & wide_14_22=0x119 & io_word { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0) goto <peripheral_done>; A0L = io_word; <peripheral_done> }

io_discard_dst: "RL0" is wide_0_11=0x6c0 { }
io_discard_dst: "selector_f0" is wide_0_11=0x7c0 { }
io_discard_dst: "discard" is (wide_0_11=0x600 | wide_0_11=0x638 | wide_0_11=0x63c | wide_0_11=0x718 | wide_0_11=0x7fc) { }
io_discard_source: "IO["^io_word_address^"]" is io_word_address { export *[const]:3 io_word_address; }

macro io_read_discard(address, config, bank) {
    local enabled:2;
    unary_ce(config, EST, CETBL, bank, enabled);
    if (enabled == 0 && (config & 0x1000) == 0) goto <peripheral_done>;
    local ignored:2 = *[io]:2 address;
    <peripheral_done>
}

