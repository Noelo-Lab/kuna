    local sum:8 = ((sext(A0H) << 16) & mask) + ((sext(old_x2) << 16) & mask);
    local result:8;
    local flags:2;
    compact_long_finish(sum & mask, sum > mask, 0:1, 0:1, 0:1, result, flags);
    A0L = result(2);
