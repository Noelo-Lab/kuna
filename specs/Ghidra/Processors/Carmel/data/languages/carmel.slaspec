:POP "RM0" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x32 { local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; RM0 = word & 0x0fff; }
:POP "CE1" "RM0" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x32 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; RM0 = word & 0x0fff; <stack_done> }
:POP "CE2" "RM0" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x32 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; RM0 = word & 0x0fff; <stack_done> }
:POP "ASTATUS" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x39 { local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; ASTATUS = word & 3; }
:POP "CE1" "ASTATUS" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x39 { local enabled:2; unary_ce(CECFG1, EST, CETBL, 0, enabled); if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; ASTATUS = word & 3; <stack_done> }
:POP "CE2" "ASTATUS" is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_0_2=0x2 & wide_14_22=0x12c & wide_40_45=0x39 { local enabled:2; unary_ce(CECFG2, EST, CETBL, 1, enabled); if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <stack_done>; local address:2 = SP + 1; SP = address; local word:2 = *[data]:2 address; ASTATUS = word & 3; <stack_done> }

@define STACK_PAIR "wide_right_mode=1 & wide_14_22=0x128"
@define STACK_PAIR_CE1 "$(STACK_PAIR) & carmel_issue=4 & wide_left_mode=0 & stack_ce_bank=0"
@define STACK_PAIR_CE2 "$(STACK_PAIR) & carmel_issue=4 & wide_left_mode=0 & stack_ce_bank=1"

stack_pair_r6: "*R6++" is stack_pair_first=0x16 { export 1:2; }
stack_pair_r6: "*R6++:long" is stack_pair_first=0x56 { export 2:2; }

macro paired_pop_top(word) {
    local top:2 = SP + 1;
    SP = top + 1;
    word = *[data]:2 top;
}

macro paired_push_data(old_sp, at_sp, below_sp) {
    local below:2 = old_sp - 1;
    *[data]:2 old_sp = at_sp;
    *[data]:2 below = below_sp;
}

macro paired_push_words(at_sp, below_sp, connected, enabled, flags) {
    local old_sp:2 = SP;
    SP = old_sp - 2;
    if (enabled == 0) goto <done>;
    paired_push_data(old_sp, at_sp, below_sp);
    if ((ECFG & 0x10) == 0 || (connected & 0xfc00) == 0) goto <done>;
    flags = flags | 0x4000;
  <done>
}

macro compact_push_words(at_sp, below_sp) {
    local old_sp:2 = SP;
    SP = old_sp - 2;
    paired_push_data(old_sp, at_sp, below_sp);
}

macro compact_pop_words(first, second) {
    paired_pop_top(second);
    first = *[data]:2 SP;
}

@define COMPACT_PUSH_PAIR "slot_9_22=0x181a & slot_0_0=0"
@define COMPACT_POP_PAIR "slot_9_22=0x1818 & slot_0_0=0"
@define COMPACT_STACK_FF12 "slot_1_3=6 & slot_0_0=0"

:PUSH "R0","R4" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_PUSH_PAIR) & compact_stack_first=0 & compact_stack_second=0); (slot_mode=0 & nop_right) {
    compact_push_words(R0, R4);
}
:PUSH "R0","ASTATUS" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_PUSH_PAIR) & compact_stack_first=0 & compact_stack_second=13); (slot_mode=0 & nop_right) {
    compact_push_words(R0, ASTATUS);
}
:PUSH "ASTATUS","open" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_PUSH_PAIR) & compact_stack_first=13 & compact_stack_second=15); (slot_mode=0 & nop_right) {
    compact_push_words(ASTATUS, 0xffff:2);
}
:PUSH "FF12" is carmel_issue=2 & slot_mode=1 & compact_stack_form=0x30378 & $(COMPACT_STACK_FF12) {
    compact_push_words(FF1, FF2);
}
:^nop_left "||" "POP" "R0","R4" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=0 & compact_stack_second=0) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    R4 = second;
    R0 = first;
}
:POP "FF12" "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_stack_form=0x30338 & $(COMPACT_STACK_FF12)); (slot_mode=0 & nop_right) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    FF2 = second;
    FF1 = first;
}
:POP "ASTATUS","R4" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=13 & compact_stack_second=0); (slot_mode=0 & nop_right) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    R4 = second;
    ASTATUS = first & 3;
}
:POP "R0","ASTATUS" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=0 & compact_stack_second=13); (slot_mode=0 & nop_right) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    ASTATUS = second & 3;
    R0 = first;
}
:POP "open","R4" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=14 & compact_stack_second=0); (slot_mode=0 & nop_right) {
    local second:2;
    paired_pop_top(second);
    R4 = second;
}

macro paired_push_registers(at_sp, below_sp, connected) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    paired_push_words(at_sp, below_sp, connected, enabled, flags);
  <publish>
    publish_alu_ce(flags);
}

:POP "CE1" stack_pair_r6,"RN4" is $(STACK_PAIR_CE1) & stack_pair_push=0 & stack_pair_r6 & stack_pair_second=0xac {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 2, stack_pair_r6);
    # The direct register port consumes the top word before the WB predicate.
    local word:2;
    paired_pop_top(word);
    RN4 = word;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:POP "CE1" "*R6++:long","A3L" is $(STACK_PAIR_CE1) & stack_pair_push=0 & stack_pair_first=0x56 & stack_pair_second=0x93 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <publish>;
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 2, 2:2);
    local word:2;
    paired_pop_top(word);
    if (enabled == 0) goto <publish>;
    A3L = word;
    flags = (flags & 0xffc4) | (zext(word == 0) << 3) | (zext(word s< 0) << 4);
  <publish>
    publish_alu_ce(flags);
}

@define STACK_POP_MARKED "$(STACK_PAIR) & carmel_issue=5 & wide_left_mode=1 & stack_pair_push=0"

stack_pop_r7: "*R7++RN7" is stack_pair_second=0x0f { export 0:2; }
stack_pop_r7: "*R7++RN7:long" is stack_pair_second=0x4f { export 1:2; }
stack_pop_r3: "*R3++0" is stack_pair_second=0x33 { export 0:2; }
stack_pop_r3: "*R3++0:long" is stack_pair_second=0x73 { export 1:2; }
stack_pop_x: "X1" is stack_pair_first=0x9e { export X1; }
stack_pop_x: "X2" is stack_pair_first=0x9f { export X2; }

stack_pop_of: is carmel_of_route=1 { export 0:1; }
stack_pop_of: is carmel_of_route=2 { export 1:1; }

macro paired_pop_fallback(long_result, active) {
    if (!active) goto <done>;
    local word:2 = *[data]:2 RL6;
    local shifted:2 = word s>> ((ECFG >> 5) & 1);
    *[data]:2 0xffff:2 = shifted;
    if (long_result == 0) goto <done>;
    *[data]:2 A0L = 0 - (shifted >> 15);
  <done>
    publish_alu_ce(EST & 0xcfff);
}

:POP "*R3+0",stack_pop_r7 is $(STACK_POP_MARKED) & stack_pair_first=0x23 & stack_pop_r7 & stack_pop_of {
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    SP = SP + 2;
    paired_pop_fallback(stack_pop_r7, stack_pop_of);
}
:POP "*R3+0:long","*R7++RN7" is $(STACK_POP_MARKED) & stack_pair_first=0x63 & stack_pair_second=0x0f & stack_pop_of {
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    SP = SP + 2;
    paired_pop_fallback(0:2, stack_pop_of);
}
:POP stack_pop_x,stack_pop_r3 is $(STACK_POP_MARKED) & stack_pop_x & stack_pop_r3 & stack_pop_of {
    local address:2 = R3;
    local updated:2;
    wide_load_next(address, (PACFG >> 6) & 3, RM2, RL2, 0, updated);
    R3 = updated;
    SP = SP + 2;
    stack_pop_x = *[data]:2 address;
    paired_pop_fallback(stack_pop_r3, stack_pop_of);
}
:POP "R3","RN4" is $(STACK_POP_MARKED) & stack_pair_first=0xa3 & stack_pair_second=0xfc {
    local word:2;
    paired_pop_top(word);
    RN4 = word;
    publish_alu_ce(EST & 0xcfff);
}
:POP "RL4","RM2" is $(STACK_POP_MARKED) & stack_pair_first=0xb4 & stack_pair_second=0xe3 {
    local word:2;
    paired_pop_top(word);
    RM2 = word & 0x0fff;
    publish_alu_ce(EST & 0xcfff);
}

:PUSH "CE2" "R3","A3L" is $(STACK_PAIR_CE2) & stack_pair_push=1 & stack_pair_first=0xa3 & stack_pair_second=0x93 {
    paired_push_registers(0xffff:2, A3L, A3L);
}
:PUSH "CE2" "A2L","R3" is $(STACK_PAIR_CE2) & stack_pair_push=1 & stack_pair_first=0x92 & stack_pair_second=0xa3 {
    paired_push_registers(A2L, A2L, A2L);
}
:PUSH "CE2" stack_pair_r6,"A3L" is $(STACK_PAIR_CE2) & stack_pair_push=1 & stack_pair_r6 & stack_pair_second=0x93 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 2, stack_pair_r6);
    paired_push_words(A3L, 0xffff:2, A3L, enabled, flags);
  <publish>
    publish_alu_ce(flags);
}
:PUSH "*R5+RN5","A1H" is $(STACK_PAIR) & carmel_issue=5 & wide_left_mode=1 & stack_pair_push=1 & stack_pair_first=0x2d & stack_pair_second=0x99 {
    local flags:2 = EST & 0xcfff;
    paired_push_words(A1H, 0xffff:2, A1H, 1:2, flags);
    publish_alu_ce(flags);
}

:TRANSFER "SP","R0" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_22=0x4040ec & wide_24_45=0x0 { SP = R0; }
