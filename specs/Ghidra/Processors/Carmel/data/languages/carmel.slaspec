# Standalone signed multiplier in the primary lane. Accumulator halves bypass X.
macro compact_signed_multiply(lo, hi, guard, left, right) {
    local a:8 = sext(left);
    local b:8 = sext(right);
    local scale:8 = 1 + sext(ECFG & 1);
    local product:8 = a * b * scale;
    # The only result outside signed 32-bit range is fractional -32768 * -32768.
    local extend:1 = product s> 0x7fffffff;
    local limit:1 = extend && ((ECFG & 4) != 0);
    local result:8 = product - zext(limit);
    local flags:2 = (zext(limit) << 2) | (zext(product == 0) << 3) |
                    (zext(product s< 0) << 4) | (zext(extend) << 5);
    # Publish the physical halves and guard without creating an undefined5 C value.
    lo = result:2;
    hi = result(2);
    guard = zext(product s< 0) * 0xff;
    EST = (EST & 0xffc4) | flags;
}

macro compact_acc_commit(lo, hi, guard, value, carry_bit) {
    local raw:8 = value & 0xffffffffff;
    local negative:1 = (raw & 0x8000000000) != 0;
    local extend:1 = (raw >> 31 != 0) && (raw >> 31 != 0x1ff);
    local overflow:1 = value s< -0x8000000000 || value s> 0x7fffffffff;
    local limit:1 = ((ECFG & 4) != 0) && (((raw >> 31) ^ (raw >> 32)) & 1) != 0;
    local sticky:1 = limit || (overflow && ((ECFG & 4) == 0) && ((ECFG & 0x28) != 8));
    local flags:2 = zext(carry_bit) | (zext(overflow) << 1) | (zext(sticky) << 2) |
                    (zext(raw == 0) << 3) | (zext(negative) << 4) | (zext(extend) << 5);
    local sign:8 = zext(negative);
    local end:8 = 0x7fffffff + sign * 0xff00000001;
    local result:8 = raw * zext(!limit) + end * zext(limit);
    lo = result:2;
    hi = result(2);
    guard = result(4);
    EST = (EST & 0xffc4) | flags;
}

