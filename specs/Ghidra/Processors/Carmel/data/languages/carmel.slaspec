:LINK "CE1" "RN0",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_2_9=0xa8 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_ce(RN0, frame_displacement, CECFG1, 0:2); }
:LINK "CE2" "RN0",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_2_9=0xa8 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_ce(RN0, frame_displacement, CECFG2, 1:2); }
:LINK "RM0",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xb2 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(RM0, frame_displacement); }
:LINK "ASTATUS",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xb9 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(ASTATUS, frame_displacement); }
:LINK "FF1",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xbe & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(FF1, frame_displacement); }
:LINK "LSA1L",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xd2 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(LSA1L, frame_displacement); }
:LINK "LEA1L",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xd3 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(LEA1L, frame_displacement); }
:LINK "LC1",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xd4 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(LC1, frame_displacement); }
:LINK "PACFG",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xda & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link(PACFG, frame_displacement); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0x86 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0x8f & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xd8 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xe0 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xe6 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }
:LINK "CE1" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_2_9=0xe6 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG1, 0:2); }
:LINK "CE2" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_2_9=0xe6 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG2, 1:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xe7 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }
:LINK "CE1" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_2_9=0xe7 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG1, 0:2); }
:LINK "CE2" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_2_9=0xe7 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG2, 1:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xe8 & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }
:LINK "CE1" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_2_9=0xe8 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG1, 0:2); }
:LINK "CE2" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_2_9=0xe8 & wide_14_22=0x118 & (link_qualifier=0 | link_qualifier=2) & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG2, 1:2); }
:LINK "CE1" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=0 & wide_2_9=0xf0 & wide_14_22=0x118 & link_qualifier=0xb & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG1, 0:2); }
:LINK "CE2" "open",frame_displacement is carmel_issue=4 & wide_left_mode=0 & wide_right_mode=1 & stack_ce_bank=1 & wide_2_9=0xf0 & wide_14_22=0x118 & link_qualifier=0xb & frame_displacement { wide_frame_link_open_ce(frame_displacement, CECFG2, 1:2); }
:LINK "open",frame_displacement is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_9=0xff & wide_14_22=0x118 & link_qualifier=0 & frame_displacement { wide_frame_link_open(frame_displacement, 0xffff:2); }

@define STACK_SINGLE "wide_right_mode=1 & wide_14_22=0x12c & ((carmel_issue=5 & wide_left_mode=1) | (carmel_issue=4 & wide_left_mode=0)) & wide_ce_prefix"

macro single_push_word(prefix, source) {
    local enabled:2;
    local agu:2;
    wide_issue_enable(prefix, enabled, agu);
    if (agu == 0) goto <publish>;
    local address:2 = SP;
    SP = address - 1;
    if (enabled == 0) goto <publish>;
    local saved:2 = source;
    frame_store(address, saved);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

macro single_pop_word(prefix, destination, mask) {
    local enabled:2;
    local agu:2;
    wide_issue_enable(prefix, enabled, agu);
    if (agu == 0) goto <publish>;
    local address:2 = SP + 1;
    SP = address;
    local word:2 = *[data]:2 address;
    destination = word & mask;
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

:PUSH wide_ce_prefix "GB0" is $(STACK_SINGLE) & wide_0_2=0x6 & wide_40_45=0x0 {
    single_push_word(wide_ce_prefix, sext(GB0));
}
:PUSH wide_ce_prefix stack_single_reg is $(STACK_SINGLE) & wide_0_2=0x6 & stack_single_bank=4 & stack_single_reg {
    single_push_word(wide_ce_prefix, stack_single_reg);
}
:PUSH wide_ce_prefix "open" is $(STACK_SINGLE) & wide_0_2=0x7 & wide_40_45=0x18 {
    single_push_word(wide_ce_prefix, 0:2);
}
:POP wide_ce_prefix stack_single_reg is $(STACK_SINGLE) & wide_0_2=0x2 & stack_single_bank=4 & stack_single_reg {
    single_pop_word(wide_ce_prefix, stack_single_reg, 0xffff:2);
}
:POP wide_ce_prefix "RM0" is $(STACK_SINGLE) & wide_0_2=0x2 & wide_40_45=0x32 {
    single_pop_word(wide_ce_prefix, RM0, 0x0fff:2);
}
:POP wide_ce_prefix "ASTATUS" is $(STACK_SINGLE) & wide_0_2=0x2 & wide_40_45=0x39 {
    single_pop_word(wide_ce_prefix, ASTATUS, 3:2);
}
@undef STACK_SINGLE

@define SINGLE_POP_R7 "wide_right_mode=1 & wide_14_22=0x12c & wide_40_45=0x17 & wide_stack_pop_control=0x5c7"
@define SINGLE_POP_R7_CE1 "$(SINGLE_POP_R7) & carmel_issue=4 & wide_left_mode=0 & stack_ce_bank=0"
@define SINGLE_POP_R7_CE2 "$(SINGLE_POP_R7) & carmel_issue=4 & wide_left_mode=0 & stack_ce_bank=1"

single_pop_r7_width: "*R7++" is wide_0_2=0 { export 1:2; }
single_pop_r7_width: "*R7++:long" is wide_0_2=1 { export 2:2; }

macro single_pop_r7_ports(prefix, words, source, low_port, high_port) {
    local from:2 = source;
    local low_at:2 = low_port;
    local high_at:2 = high_port;
    local enabled:2;
    local address_enabled:2;
    wide_issue_enable(prefix, enabled, address_enabled);
    local flags:2 = EST & 0xcfff;
    if (address_enabled == 0) goto <publish>;
    SP = SP + words;
    modify_ptr_scaled(R7, RN7, RM6, RL6, 14, 2, words);
    if (enabled == 0) goto <publish>;

    local low:2 = *[data]:2 from;
    local last:2 = low;
    if (words == 1) goto <store>;
    local high_from:2 = from + 1;
    last = *[data]:2 high_from;
  <store>
    *[data]:2 low_at = low;
    if (words == 1) goto <status>;
    *[data]:2 high_at = last;
  <status>
    if ((ECFG & 0x10) == 0 || (last & 0xfc00) == 0) goto <publish>;
    flags = flags | 0x4000;
  <publish>
    publish_alu_ce(flags);
}

:POP "CE1" single_pop_r7_width is $(SINGLE_POP_R7_CE1) & single_pop_r7_width unimpl
:POP "CE2" single_pop_r7_width is $(SINGLE_POP_R7_CE2) & single_pop_r7_width unimpl
:POP "CE1" single_pop_r7_width is $(SINGLE_POP_R7_CE1) & single_pop_r7_width & carmel_of_route=2 {
    single_pop_r7_ports(1:2, single_pop_r7_width, R7, 0xffff:2, A0L);
}
:POP "CE2" single_pop_r7_width is $(SINGLE_POP_R7_CE2) & single_pop_r7_width & carmel_of_route=2 {
    single_pop_r7_ports(2:2, single_pop_r7_width, R7, A0L, A1L);
}
:POP "*R7++:long" is $(SINGLE_POP_R7) & carmel_issue=5 & wide_left_mode=1 & wide_0_2=1 {
    single_pop_r7_ports(0:2, 2:2, SP + 1, R7, R7 + 1);
}

@define STACK_PAIR "wide_right_mode=1 & wide_14_22=0x128"
@define STACK_PAIR_CE1 "$(STACK_PAIR) & carmel_issue=4 & wide_left_mode=0 & stack_ce_bank=0"
@define STACK_PAIR_CE2 "$(STACK_PAIR) & carmel_issue=4 & wide_left_mode=0 & stack_ce_bank=1"

stack_pair_r6: "*R6++" is stack_pair_first=0x16 { export 1:2; }
stack_pair_r6: "*R6++:long" is stack_pair_first=0x56 { export 2:2; }

stack_pop_est: "POP EST" is slot_0_22=0x302642 {
    local top:2 = SP + 1;
    SP = top;
    EST = (*[data]:2 top) & 0x7fff;
}

:^stack_pop_est is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & stack_pop_est { build stack_pop_est; }
:^stack_pop_est "||" nop_right is (carmel_issue=1 & slot_mode=0 & stack_pop_est); (slot_mode=0 & nop_right) { build stack_pop_est; }
:^nop_left "||" stack_pop_est is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & stack_pop_est) { build stack_pop_est; }

macro paired_pop_top(word) {
    local top:2 = SP + 1;
    SP = top + 1;
    word = *[data]:2 top;
}

macro paired_push_data(old_sp, at_sp, below_sp) {
    local below:2 = old_sp - 1;
    *[data]:2 old_sp = at_sp;
    *[data]:2 below = below_sp;
}

macro paired_push_words(at_sp, below_sp, connected, enabled, flags) {
    local old_sp:2 = SP;
    SP = old_sp - 2;
    if (enabled == 0) goto <done>;
    paired_push_data(old_sp, at_sp, below_sp);
    if ((ECFG & 0x10) == 0 || (connected & 0xfc00) == 0) goto <done>;
    flags = flags | 0x4000;
  <done>
}

macro compact_push_words(at_sp, below_sp, checked) {
    local flags:2 = EST & 0xcfff;
    paired_push_words(at_sp, below_sp, checked, 1:2, flags);
    publish_ce_feedback(flags, EST);
}

macro compact_pop_words(first, second) {
    paired_pop_top(second);
    first = *[data]:2 SP;
}

:LSHIFT "CE1" "FF1","RN5","0x11" "||" "POP" "CE2" "RL2","R5" is
    (carmel_issue=1 & slot_raw=0x3966a3); slot_raw=0x303123 {
    local left:2;
    local right:2;
    unary_ce(CECFG1, EST, CETBL, 0, left);
    unary_ce(CECFG2, EST, CETBL, 1, right);
    if (right == 0 && (CECFG2 & 0x1000) == 0) goto <alu>;
    local high:2;
    local low:2;
    compact_pop_words(high, low);
    R5 = low;
    RL2 = high;
  <alu>
    if (left == 0) goto <publish>;
    compact_word_logical(FF1, RN5, 17:4);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}

@define COMPACT_PUSH_PAIR "slot_9_22=0x181a & slot_0_0=0"
@define COMPACT_POP_PAIR "slot_9_22=0x1818 & slot_0_0=0"
@define COMPACT_STACK_FF12 "slot_1_3=6 & slot_0_0=0"

stack_push_acc: "PUSH" compact_stack_acc is compact_stack_form=0x30378 & slot_0_0=0 & compact_stack_acc {
    local high:2 = compact_stack_acc(2);
    local low:2 = compact_stack_acc:2;
    compact_push_words(high, low, high);
}

stack_pop_acc: "POP" compact_stack_acc is compact_stack_form=0x30338 & slot_0_0=0 & compact_stack_acc {
    export compact_stack_acc;
}

macro compact_pop_accumulator(destination, shift) {
    local high:2;
    local low:2;
    compact_pop_words(high, low);
    local value:4 = (zext(high) << 16) | zext(low);
    destination = sext(value);
    local flags:2 = (zext(value == 0) << 3) | (zext(value s< 0) << 4);
    publish_ce_feedback((EST & 0xcfff & ~(0x3b << shift)) | (flags << shift), EST);
}

:^stack_push_acc is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & stack_push_acc { build stack_push_acc; }
:^stack_push_acc "||" nop_right is (carmel_issue=1 & slot_mode=0 & stack_push_acc); (slot_mode=0 & nop_right) { build stack_push_acc; }
:^nop_left "||" stack_push_acc is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & stack_push_acc) { build stack_push_acc; }
:^stack_pop_acc is ((carmel_issue=2 & slot_mode=1) | (carmel_issue=3 & slot_mode=0)) & stack_pop_acc {
    compact_pop_accumulator(stack_pop_acc, 0:2);
}
:^stack_pop_acc "||" nop_right is (carmel_issue=1 & slot_mode=0 & stack_pop_acc); (slot_mode=0 & nop_right) {
    compact_pop_accumulator(stack_pop_acc, 0:2);
}
:^nop_left "||" stack_pop_acc is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & stack_pop_acc) {
    compact_pop_accumulator(stack_pop_acc, 6:2);
}

:PUSH "R0","R4" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_PUSH_PAIR) & compact_stack_first=0 & compact_stack_second=0); (slot_mode=0 & nop_right) {
    compact_push_words(R0, R4, R0);
}
:PUSH "R0","ASTATUS" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_PUSH_PAIR) & compact_stack_first=0 & compact_stack_second=13); (slot_mode=0 & nop_right) {
    compact_push_words(R0, ASTATUS, R0);
}
:PUSH "ASTATUS","open" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_PUSH_PAIR) & compact_stack_first=13 & compact_stack_second=15); (slot_mode=0 & nop_right) {
    compact_push_words(ASTATUS, 0xffff:2, ASTATUS);
}
:PUSH "FF12" is carmel_issue=2 & slot_mode=1 & compact_stack_form=0x30378 & $(COMPACT_STACK_FF12) {
    compact_push_words(FF1, FF2, 0:2);
}
:^nop_left "||" "POP" "R0","R4" is (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=0 & compact_stack_second=0) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    R4 = second;
    R0 = first;
    publish_alu_ce(EST & 0xcfff);
}
:POP "FF12" "||" nop_right is (carmel_issue=1 & slot_mode=0 & compact_stack_form=0x30338 & $(COMPACT_STACK_FF12)); (slot_mode=0 & nop_right) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    FF2 = second;
    FF1 = first;
    publish_alu_ce(EST & 0xcfff);
}
:POP "ASTATUS","R4" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=13 & compact_stack_second=0); (slot_mode=0 & nop_right) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    R4 = second;
    ASTATUS = first & 3;
    publish_alu_ce(EST & 0xcfff);
}
:POP "R0","ASTATUS" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=0 & compact_stack_second=13); (slot_mode=0 & nop_right) {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    ASTATUS = second & 3;
    R0 = first;
    publish_alu_ce(EST & 0xcfff);
}
:POP "open","R4" "||" nop_right is (carmel_issue=1 & slot_mode=0 & $(COMPACT_POP_PAIR) & compact_stack_first=14 & compact_stack_second=0); (slot_mode=0 & nop_right) {
    local second:2;
    paired_pop_top(second);
    R4 = second;
}

macro paired_push_registers(at_sp, below_sp, connected) {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    paired_push_words(at_sp, below_sp, connected, enabled, flags);
  <publish>
    publish_alu_ce(flags);
}

:POP "CE1" stack_pair_r6,"RN4" is $(STACK_PAIR_CE1) & stack_pair_push=0 & stack_pair_r6 & stack_pair_second=0xac {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <done>;
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 2, stack_pair_r6);
    # The direct register port consumes the top word before the WB predicate.
    local word:2;
    paired_pop_top(word);
    RN4 = word;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:POP "CE1" "*R6++:long","A3L" is $(STACK_PAIR_CE1) & stack_pair_push=0 & stack_pair_first=0x56 & stack_pair_second=0x93 {
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG1 & 0x1000) == 0) goto <publish>;
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 2, 2:2);
    local word:2;
    paired_pop_top(word);
    if (enabled == 0) goto <publish>;
    A3L = word;
    flags = (flags & 0xffc4) | (zext(word == 0) << 3) | (zext(word s< 0) << 4);
  <publish>
    publish_alu_ce(flags);
}

@define STACK_POP_MARKED "$(STACK_PAIR) & carmel_issue=5 & wide_left_mode=1 & stack_pair_push=0"
@define STACK_POP_CE2 "$(STACK_PAIR_CE2) & stack_pair_push=0"

stack_split_distinct: is stack_split_first_acc=0 & stack_split_second_acc!=0 { }
stack_split_distinct: is stack_split_first_acc=1 & stack_split_second_acc!=1 { }
stack_split_distinct: is stack_split_first_acc=2 & stack_split_second_acc!=2 { }
stack_split_distinct: is stack_split_first_acc=3 & stack_split_second_acc!=3 { }
stack_split_distinct: is stack_split_first_acc=4 & stack_split_second_acc!=4 { }
stack_split_distinct: is stack_split_first_acc=5 & stack_split_second_acc!=5 { }

:POP stack_split_first,stack_split_second is $(STACK_POP_MARKED) & wide_0_22=0x4a0000
    & stack_split_first_bank=9 & stack_split_second_bank=9 & stack_split_second_acc<6
    & stack_split_first & stack_split_second & stack_split_distinct {
    local first:2;
    local second:2;
    compact_pop_words(first, second);
    stack_split_second = second;
    stack_split_first = first;
    local flags:2 = (zext(first == 0) << 3) | (zext(first s< 0) << 4)
                  | (zext(second == 0) << 9) | (zext(second s< 0) << 10);
    publish_ce_feedback((EST & 0xc104) | flags, EST);
}

stack_pop_r7: "*R7++RN7" is stack_pair_second=0x0f { export 0:2; }
stack_pop_r7: "*R7++RN7:long" is stack_pair_second=0x4f { export 1:2; }
stack_pop_r3: "*R3++0" is stack_pair_second=0x33 { export 0:2; }
stack_pop_r3: "*R3++0:long" is stack_pair_second=0x73 { export 1:2; }
stack_pop_x: "X1" is stack_pair_first=0x9e { export X1; }
stack_pop_x: "X2" is stack_pair_first=0x9f { export X2; }
stack_pop_r4: "*R4+RN4" is stack_pair_second=0x2c { export 0:2; }
stack_pop_r4: "*R4++RN4:long" is stack_pair_second=0x4c { export 1:2; }

stack_pop_alu_source: "*R4+RN4" is stack_pair_second=0x2c {
    local address:2 = R4 + RN4;
    export address;
}
stack_pop_alu_source: "*R6" is stack_pair_second=0x06 { export R6; }
stack_pop_alu_right: is stack_pair_second=0x2c { export A4L; }
stack_pop_alu_right: is stack_pair_second=0x06 { export FF1; }

stack_pop_of: is carmel_of_route=1 { export 0:1; }
stack_pop_of: is carmel_of_route=2 { export 1:1; }

macro paired_pop_fallback_data(long_result) {
    local word:2 = *[data]:2 RL6;
    local shifted:2 = word s>> ((ECFG >> 5) & 1);
    *[data]:2 0xffff:2 = shifted;
    if (long_result == 0) goto <done>;
    *[data]:2 A0L = 0 - (shifted >> 15);
  <done>
}

macro paired_pop_fallback(long_result, active) {
    if (!active) goto <done>;
    paired_pop_fallback_data(long_result);
  <done>
    publish_alu_ce(EST & 0xcfff);
}

:POP "*R3+0",stack_pop_r7 is $(STACK_POP_MARKED) & stack_pair_first=0x23 & stack_pop_r7 & stack_pop_of {
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    SP = SP + 2;
    paired_pop_fallback(stack_pop_r7, stack_pop_of);
}
:POP "*R3+0:long","*R7++RN7" is $(STACK_POP_MARKED) & stack_pair_first=0x63 & stack_pair_second=0x0f & stack_pop_of {
    modify_ptr(R7, RN7, RM6, RL6, 14, 1);
    SP = SP + 2;
    paired_pop_fallback(0:2, stack_pop_of);
}
:POP stack_pop_x,stack_pop_r3 is $(STACK_POP_MARKED) & stack_pop_x & stack_pop_r3 & stack_pop_of {
    local address:2 = R3;
    local updated:2;
    wide_load_next(address, (PACFG >> 6) & 3, RM2, RL2, 0, updated);
    R3 = updated;
    SP = SP + 2;
    stack_pop_x = *[data]:2 address;
    paired_pop_fallback(stack_pop_r3, stack_pop_of);
}
:POP "CETBL",stack_pop_r4 is $(STACK_POP_MARKED) & stack_pair_first=0xc4 & stack_pop_r4 & stack_pop_of {
    if (stack_pop_r4 == 0) goto <stack>;
    modify_ptr(R4, RN4, RM4, RL4, 8, 1);
  <stack>
    SP = SP + 2;
    paired_pop_fallback(stack_pop_r4, stack_pop_of);
}
:POP "CE2" "FF1",stack_pop_r4 is $(STACK_POP_CE2) & stack_pair_first=0x96 & stack_pop_r4 & carmel_of_route=2 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    local address:2 = R4;
    if (stack_pop_r4 == 0) goto <indexed>;
    modify_ptr(R4, RN4, RM4, RL4, 8, 1);
    goto <stack>;
  <indexed>
    address = address + RN4;
  <stack>
    SP = SP + 2;
    # The direct FF1 latch belongs to EX, not the predicated DATA result.
    FF1 = *[data]:2 address;
    if (enabled == 0) goto <publish>;
    paired_pop_fallback_data(stack_pop_r4);
  <publish>
    publish_alu_ce(EST & 0xcfff);
}
:POP "CE2" "A0L",stack_pop_alu_source is $(STACK_POP_CE2) & stack_pair_first=0x90 & stack_pop_alu_source & stack_pop_alu_right {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    SP = SP + 2;
    local first:2 = *[data]:2 stack_pop_alu_source;
    local second:2 = *[data]:2 SP;
    if (enabled == 0) goto <publish>;
    A0L = first;
    stack_pop_alu_right = second;
    flags = (flags & 0xc104) | (zext(first == 0) << 3) | (zext(first s< 0) << 4) |
            (zext(second == 0) << 9) | (zext(second s< 0) << 10);
  <publish>
    publish_alu_ce(flags);
}
:POP "R3","RN4" is $(STACK_POP_MARKED) & stack_pair_first=0xa3 & stack_pair_second=0xfc {
    local word:2;
    paired_pop_top(word);
    RN4 = word;
    publish_alu_ce(EST & 0xcfff);
}
:POP "RL4","RM2" is $(STACK_POP_MARKED) & stack_pair_first=0xb4 & stack_pair_second=0xe3 {
    local word:2;
    paired_pop_top(word);
    RM2 = word & 0x0fff;
    publish_alu_ce(EST & 0xcfff);
}

:PUSH "CE2" "R3","A3L" is $(STACK_PAIR_CE2) & stack_pair_push=1 & stack_pair_first=0xa3 & stack_pair_second=0x93 {
    paired_push_registers(0xffff:2, A3L, A3L);
}
:PUSH "CE2" "A2L","R3" is $(STACK_PAIR_CE2) & stack_pair_push=1 & stack_pair_first=0x92 & stack_pair_second=0xa3 {
    paired_push_registers(A2L, A2L, A2L);
}
:PUSH "CE2" stack_pair_r6,"A3L" is $(STACK_PAIR_CE2) & stack_pair_push=1 & stack_pair_r6 & stack_pair_second=0x93 {
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local flags:2 = EST & 0xcfff;
    if (enabled == 0 && (CECFG2 & 0x1000) == 0) goto <publish>;
    modify_ptr_scaled(R6, RN6, RM6, RL6, 12, 2, stack_pair_r6);
    paired_push_words(A3L, 0xffff:2, A3L, enabled, flags);
  <publish>
    publish_alu_ce(flags);
}
:PUSH "*R5+RN5","A1H" is $(STACK_PAIR) & carmel_issue=5 & wide_left_mode=1 & stack_pair_push=1 & stack_pair_first=0x2d & stack_pair_second=0x99 {
    local flags:2 = EST & 0xcfff;
    paired_push_words(A1H, 0xffff:2, A1H, 1:2, flags);
    publish_alu_ce(flags);
}

