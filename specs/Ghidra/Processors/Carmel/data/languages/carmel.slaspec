    compact_mac_preg_xor(1:1, 0:1);
}
:MACUU "A1","*R3+RN3","*R3++" "||" "XOR CE2" "*R6+=RN6","OP2","*R7++" is (carmel_issue=1 & slot_mode=0 & $(MAC_PREG_LEFT)); (slot_mode=0 & $(MAC_PREG_XOR) & mac_preg_src=31 & mac_preg_data=23 & slot_0_0=1) {
