    & short_call_mode & link_2_2 & resume_2_2 [ carmel_counted_delay=1; ] {
    local mode:1 = short_call_mode;
    local old_sp:2;
    local target:4;
    prepare_short_call(mode, old_sp, target);
    delayslot(2);
    complete_short_call(mode, old_sp, target, link_2_2, resume_2_2);
}
