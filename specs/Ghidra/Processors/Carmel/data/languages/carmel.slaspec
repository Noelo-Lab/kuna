# SWAP exchanges one DATA word even when the operand selector names a long.
swap_word_register: swap_reg_lo is wide_0_1<2 & (swap_reg_short_group=0 | swap_reg_short_group=4 | swap_reg_short_group=5 | swap_reg_short_group=7) & swap_reg_lo { export swap_reg_lo; }
# A DATA selector in the second operand can update a pointer, but the
# exchanged value comes from its register alias, not a second DATA read.
swap_word_register: swap_reg_lo is wide_0_1<2 & (swap_reg_short_group=1 | swap_reg_short_group=2 | swap_reg_short_group=3)
    & (swap_register_address=1 | swap_address_group=0 | swap_address_group=8 | swap_address_group=7 | swap_address_group=15 | swap_address_index!=swap_peer_index)
    & swap_reg_lo & wide_0_0 & swap_peer_base & swap_peer_step & swap_peer_modulo & swap_peer_bound & swap_peer_pacfg_shift & swap_peer_modify {
    local stride:2 = 1 + wide_0_0;
    modify_ptr_scaled(swap_peer_base, swap_peer_step, swap_peer_modulo, swap_peer_bound, swap_peer_pacfg_shift, swap_peer_modify, stride);
    export swap_reg_lo;
}
swap_word_register: swap_reg_full is wide_0_1=2 & swap_reg_full_group=1 & swap_reg_full { export swap_reg_full; }
swap_address: "*"^word_address is (wide_2_9=0x86 | wide_2_9=0x87 | wide_2_9=0x8e | wide_2_9=0x8f | swap_address_group=0x1c | swap_address_group=0x1d | swap_address_group=0x1e | swap_address_group=0x1f) [ word_address = 0xffff; ] { export *[const]:2 word_address; }
swap_address: "*"^absolute_data_addr is (swap_address_group=7 | swap_address_group=15) & absolute_data_addr { export *[const]:2 absolute_data_addr; }
swap_address: "*"^swap_base is swap_register_address=0 & wide_7_7=0 & swap_modify & swap_long & swap_base & swap_step & swap_modulo & swap_bound & swap_pacfg_shift {
    local address:2 = swap_base;
    local stride:2 = 1 + swap_long;
    modify_ptr_scaled(swap_base, swap_step, swap_modulo, swap_bound, swap_pacfg_shift, swap_modify, stride);
    export address;
}

:SWAP swap_address,swap_word_register is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_13_22=0x21a & swap_address & swap_word_register {
    build swap_address;
    build swap_word_register;
    local data_word:2 = *[data]:2 swap_address;
    local register_word:2 = swap_word_register;
    swap_word_register = data_word;
    *[data]:2 swap_address = register_word;
    local flags:2 = (EST & 0xffc4) | (zext(data_word == 0) << 3) | (zext(data_word >= 0x8000) << 4);
    local ce1:2;
    local ce2:2;
    unary_ce(CECFG1, flags, CETBL, 0, ce1);
    unary_ce(CECFG2, flags, CETBL, 1, ce2);
    EST = (flags & 0xcfff) | (ce1 << 12) | (ce2 << 13);
}

# The ALU sees 40 bits; use normalized u64 bit patterns, not 5-byte C arithmetic.
macro compact_long_sample(lo, hi, guard, bits) {
    bits = (zext(guard) << 32) | (zext(hi) << 16) | zext(lo);
}
macro compact_long_finish(bits, carry_out, overflow, data_result, mixed, result, flags) {
    local negative:1 = bits >= 0x8000000000;
    local extend:1 = bits > 0x7fffffff && bits < 0xff80000000;
    local auto_limit:1 = (ECFG & 4) != 0;
    local saturated:1 = (ECFG & 0x28) == 8;
    local loss:1 = (overflow || (data_result != 0 && extend)) && !auto_limit && !saturated;
    # Status uses the pre-limit value, including the guard and sign.
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(bits == 0) << 3) | (zext(negative) << 4) | (zext(extend) << 5);
    result = bits;
    if (mixed != 0) goto <limited>;
    if (data_result == 0 || !saturated || !(extend || overflow)) goto <auto>;
    # Saturation sees the sign of the exact sum, before 40-bit wrap.
    negative = negative != overflow;
    goto <clamp>;
  <auto>
    if (!auto_limit || ((((bits >> 31) ^ (bits >> 32)) & 1) == 0)) goto <limited>;
  <clamp>
    result = 0x7fffffff;
    if (!negative) goto <mark_loss>;
    result = 0xff80000000;
  <mark_loss>
    flags = flags | 4;
  <limited>
    # SR1 is a DATA port operation; bit 32 already supplies the new bit 31.
    if (data_result == 0) goto <finish>;
    result = result >> ((ECFG >> 5) & 1);
  <finish>
}
macro compact_long_postmodify(pointer) {
    # The explicit window of this port uses all 16 RM bits, unlike the
    # implicit window. The other modes share the ordinary compact AGU.
    if ((PACFG & 0xc00) == 0xc00 && RM4 > 0xfff) goto <full_window>;
    modify_ptr(pointer, RN5, RM4, RL4, 10, 1);
    goto <done>;
  <full_window>
    local candidate:2 = pointer + RN5;
    local size:4 = zext(RM4) + 1;
    local limit:4 = zext(RL4) + size;
    if (limit <= 0x10000 && RL4 <= candidate && zext(candidate) < limit) goto <publish>;
    if (RN5 s< 0) goto <reverse_wrap>;
    candidate = candidate - size:2;
    goto <publish>;
  <reverse_wrap>
    candidate = candidate + size:2;
  <publish>
    pointer = candidate;
  <done>
}

