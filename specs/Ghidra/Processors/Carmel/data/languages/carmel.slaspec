# Bias signed operands before a 64-bit trial subtraction. Neither the
# signed 40-bit dividend nor the signed word shift needs a C signed shift.
macro wide_div_biased(lo, hi, guard, biased) {
    biased = zext(guard ^ 0x80) * 0x100000000 + zext(hi) * 0x10000 + zext(lo);
}
macro wide_div_trial(biased, word, alignment, word_bias, result) {
    local doubled:8 = biased * 2;
    local lhs:8 = doubled + word_bias;
    local rhs:8 = 0x10000000000 + (zext(word ^ 0x8000) << alignment);
    result = doubled;
    if (lhs < rhs) goto <wide_div_failed_trial>;
    result = (lhs - rhs) | 1;
    <wide_div_failed_trial>
}
macro wide_div_trace_sink(lo, hi, guard) {
    # The dividend port is fixed at zero; only the signed comparison and
    # the trace register are live. The discarded remainder has no store.
    local take:1 = guard >= 0x80 || ((guard == 0) && (hi == 0) && (lo == 0));
    local previous:2 = BTR2;
    BTR2 = (previous << 1) | zext(take);
}
:DIVIDE "A5","FF1" is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_0_9=0x236 & wide_13_22=0x218 & wide_40_45=0x3e { local dividend:8; wide_div_biased(A5L, A5H, GB5, dividend); local result:8; wide_div_trial(dividend, FF1, 16, 0x80000000, result); A5L = result:2; A5H = result(2); GB5 = result(4); }
