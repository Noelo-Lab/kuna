# Use unsigned 64-bit carriers for signed-40 arithmetic, never a size-5 value.
macro wide_mac_su_subtract(addend, left, right, word_result, result, flags) {
    local signed_left:8 = (zext(left) ^ 0x8000) - 0x8000;
    local product:8 = (signed_left * zext(right) * (1 + zext(ECFG & 1))) & 0xffffffffff;
    result = (addend - product) & 0xffffffffff;
    local carry_out:1 = addend >= product;
    local negative:1 = result >= 0x8000000000;
    local extended:1 = result > 0x7fffffff && result < 0xff80000000;
    local overflow:1 = ((addend ^ product) & (addend ^ result) & 0x8000000000) != 0;
    local zero:1 = result == 0 || (word_result != 0 && (result >> 16) == 0);
    # This mixed-sign route does not clamp at ALIM. ALIM and S (unless SR1
    # is also set) inhibit new L; neither configuration clears sticky L.
    local loss:1 = (ECFG & 4) == 0 && (ECFG & 0x28) != 8 &&
                   (overflow || (word_result != 0 && extended));
    flags = zext(carry_out) | (zext(overflow) << 1) | (zext(loss) << 2) |
            (zext(zero) << 3) | (zext(negative) << 4) | (zext(extended) << 5);
}

