# Logic uses the unsigned input bits; status describes the full ALU result.
macro commit_logic_flags(flags, shift) {
    EST = (EST & ~(0x38 << shift)) | (flags << shift);
}

# The destination selects the opposite bank from source two; each source has its own bank bit.
packed_dm_dst: "*"^packed_dm_dst_lo is packed_dm_bank_rhs=1 & packed_dm_dst_lo { export packed_dm_dst_lo; }
packed_dm_dst: "*"^packed_dm_dst_hi is packed_dm_bank_rhs=0 & packed_dm_dst_hi { export packed_dm_dst_hi; }
packed_dm_lhs: "*"^packed_dm_lhs_lo is packed_dm_bank_lhs=0 & packed_dm_lhs_lo { export packed_dm_lhs_lo; }
packed_dm_lhs: "*"^packed_dm_lhs_hi is packed_dm_bank_lhs=1 & packed_dm_lhs_hi { export packed_dm_lhs_hi; }
packed_dm_rhs: "*"^packed_dm_rhs_lo is packed_dm_bank_rhs=0 & packed_dm_rhs_lo { export packed_dm_rhs_lo; }
packed_dm_rhs: "*"^packed_dm_rhs_hi is packed_dm_bank_rhs=1 & packed_dm_rhs_hi { export packed_dm_rhs_hi; }

@define PACKED_DM_OR "slot_14_22=0x1a5 & packed_dm_dst & packed_dm_lhs & packed_dm_rhs & slot_11_11=0 & packed_dm_lhs_mode=0 & slot_3_4=0 & slot_0_0=0"
macro packed_dm_or(dst, lhs, rhs, shift) {
    local address:2 = dst;
    local left:2 = *[data]:2 lhs;
    local right:2 = *[data]:2 rhs;
    local result:2 = left | right;
    *[data]:2 address = result;
    commit_logic_flags(zext(result == 0) << 3, shift);
}

:OR packed_dm_dst,packed_dm_lhs,packed_dm_rhs "||" nop_right is
    (carmel_issue=1 & slot_mode=0 & $(PACKED_DM_OR)); (slot_mode=0 & nop_right) {
    packed_dm_or(packed_dm_dst, packed_dm_lhs, packed_dm_rhs, 0);
}
:^nop_left "||" "OR" packed_dm_dst,packed_dm_lhs,packed_dm_rhs is
    (carmel_issue=1 & slot_mode=0 & nop_left); (slot_mode=0 & $(PACKED_DM_OR)) {
    packed_dm_or(packed_dm_dst, packed_dm_lhs, packed_dm_rhs, 6);
}

