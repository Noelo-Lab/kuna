    local sign:8 = zext(negative);
    local end:8 = 0x7fffffff + sign * 0xff00000001;
    local result:8 = raw * zext(!limit) + end * zext(limit);
    lo = result:2;
    hi = result(2);
    guard = result(4);
    EST = (EST & 0xffc4) | flags;
}

