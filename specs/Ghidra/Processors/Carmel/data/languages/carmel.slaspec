:MOVE "RN5",literal_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_11=0xad & wide_14_22=0x119 & literal_word { RN5 = literal_word; }
:MOVE "RN6",literal_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_11=0xae & wide_14_22=0x119 & literal_word { RN6 = literal_word; }
:MOVE "*R0",literal_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_11=0x0 & wide_14_22=0x119 & literal_word { local address:2 = R0; local value:2 = literal_word s>> ((ECFG >> 5) & 1); *[data]:2 address = value; }
:MOVE "*R0",literal_word ";" "MOVE" data_load_dst,"*"^absolute_data_addr is carmel_single_issue=0 & carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_11=0x0 & wide_14_22=0x119 & literal_word ; (data_load_dst & absolute_data_addr) { local read_addr:2 = absolute_data_addr; local read_value:2 = *[data]:2 read_addr; local address:2 = R0; local value:2 = literal_word s>> ((ECFG >> 5) & 1); *[data]:2 address = value; data_load_dst = read_value; }
:MOVE "*R0++",literal_word is carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_11=0x10 & wide_14_22=0x119 & literal_word { local address:2 = R0; modify_ptr(R0, RN0, RM0, RL0, 0, 2); local value:2 = literal_word s>> ((ECFG >> 5) & 1); *[data]:2 address = value; }
:MOVE "*R0++",literal_word ";" "MOVE" data_load_dst,"*"^absolute_data_addr is carmel_single_issue=0 & carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_2_11=0x10 & wide_14_22=0x119 & literal_word ; (data_load_dst & absolute_data_addr) { local read_addr:2 = absolute_data_addr; local read_value:2 = *[data]:2 read_addr; local address:2 = R0; modify_ptr(R0, RN0, RM0, RL0, 0, 2); local value:2 = literal_word s>> ((ECFG >> 5) & 1); *[data]:2 address = value; data_load_dst = read_value; }

@define WIDE_MOVS_IMMEDIATE "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1 & wide_14_22=0x119 & literal_word & wide_ce_prefix"

:MOVE wide_ce_prefix "*R0+=RN0",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0x08 {
    local result:2;
    local address_enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, address_enabled);
    if (address_enabled == 0) goto <done>;
    local address:2 = R0;
    modify_ptr(R0, RN0, RM0, RL0, 0, 1);
    if (result == 0) goto <done>;
    local value:2 = literal_word s>> ((ECFG >> 5) & 1);
    *[data]:2 address = value;
  <done>
    publish_alu_ce(EST & 0xcfff);
}

macro movs_accumulator_flags(word, result, flags) {
    if (result == 0) goto <done>;
    local value:2 = word;
    flags = (flags & 0xffc4) | (zext(value == 0) << 3) | (zext(value >= 0x8000) << 4);
  <done>
}

movs_ce_low: "A0L" is wide_2_11=0x90 { export A0L; }
movs_ce_low: "A1L" is wide_2_11=0x91 { export A1L; }
:MOVE wide_ce_prefix movs_ce_low,literal_word is $(WIDE_MOVS_IMMEDIATE) & carmel_issue=4 & movs_ce_low {
    local result:2;
    local address_enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, address_enabled);
    local flags:2 = EST & 0xcfff;
    movs_accumulator_flags(literal_word, result, flags);
    if (result == 0) goto <feedback>;
    movs_ce_low = literal_word;
  <feedback>
    publish_alu_ce(flags);
}

:MOVE wide_ce_prefix "OP3",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0x8e {
    local result:2;
    local address_enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, address_enabled);
    local flags:2 = EST & 0xcfff;
    movs_accumulator_flags(literal_word, result, flags);
    publish_alu_ce(flags);
}

# System-port qualification follows the address gate, not DATA writeback.
:MOVE wide_ce_prefix "MINMAX",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xba {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    MINMAX = literal_word;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "ECFG",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xc0 {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    ECFG = literal_word & 0x3f;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "EST",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xc1 {
    build wide_ce_prefix;
    # This port writes only the transient EX debugger view.
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "CECFG1",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xc2 {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    CECFG1 = literal_word & 0x3fff;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "CETBL",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xc4 {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    CETBL = literal_word;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "PSTATUS",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xd5 {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    select_saved_loop_frame(literal_word);
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "USER_IO",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xd7 {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    USER_IO = literal_word;
  <done>
    publish_alu_ce(EST & 0xcfff);
}
:MOVE wide_ce_prefix "PACFG",literal_word is $(WIDE_MOVS_IMMEDIATE) & wide_2_11=0xda {
    local result:2; local enabled:2;
    build wide_ce_prefix;
    wide_issue_enable(wide_ce_prefix, result, enabled);
    if (enabled == 0) goto <done>;
    PACFG = literal_word;
  <done>
    publish_alu_ce(EST & 0xcfff);
}

