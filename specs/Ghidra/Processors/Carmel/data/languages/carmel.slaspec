:DIVTRACE div_btr1_dst,div_btr1_src,"BTR1" "||" nop_right is (carmel_issue=1 & slot_mode=0 & slot_0_0=0x0 & slot_7_22=0x6048 & (slot_6_6=0 | slot_5_6=2) & div_btr1_dst & div_btr1_dst_lo & div_btr1_dst_hi & div_btr1_dst_guard & (slot_3_3=0 | slot_2_3=2) & div_btr1_src & div_btr1_src_lo & div_btr1_src_hi & div_btr1_src_guard); (slot_mode=0 & nop_right) { divide_trace(div_btr1_dst_lo, div_btr1_dst_hi, div_btr1_dst_guard, div_btr1_src_lo, div_btr1_src_hi, div_btr1_src_guard, BTR1); }
