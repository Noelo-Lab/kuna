# External conditions sample the four board inputs once. A disconnected
# provider has no sample and asserts neither polarity.
define pcodeop carmel_sample_gpp;

macro sample_gpp_condition(selector, taken) {
    local select:1 = selector;
    local pins:1 = carmel_sample_gpp();
    taken = (((pins >> ((select - 20) >> 1)) ^ select) & 1) != 0;
}

@define COMPACT_GPP "(compact_input_group=5 | compact_input_group=6)"
@define WIDE_GPP "(wide_input_group=5 | wide_input_group=6)"

compact_inactive_input: "reserved" is (compact_input_select=31 | compact_input_select=59) {}
compact_inactive_input: compact_input_select is carmel_gpp_disconnected=1 & $(COMPACT_GPP) & compact_input_select {}
wide_inactive_input: "reserved" is (wide_input_select=31 | wide_input_select=59) {}
wide_inactive_input: wide_input_select is carmel_gpp_disconnected=1 & $(WIDE_GPP) & wide_input_select {}

:GOTO compact_input_select,conditional_target "||" nop_right is
    (carmel_issue=1 & slot_mode=0 & compact_conditional_opcode=0x50 & slot_0_1=0 &
     carmel_gpp_disconnected=0 & $(COMPACT_GPP) & compact_input_select & conditional_target);
    (slot_mode=0 & nop_right) {
    local taken:1;
    sample_gpp_condition(compact_input_select, taken);
    if (taken) goto conditional_target;
}
:CALL compact_input_select,conditional_target "||" nop_right is
    ((carmel_issue=1 & slot_mode=0 & compact_conditional_opcode=0x51 & slot_0_1=0 &
      carmel_gpp_disconnected=0 & $(COMPACT_GPP) & compact_input_select & conditional_target);
     (slot_mode=0 & nop_right)) & link_2_0 {
    local taken:1;
    sample_gpp_condition(compact_input_select, taken);
    store_link(SP, link_2_0);
    if (!taken) goto <veto>;
    SP = SP - 2;
    call conditional_target;
    <veto>
}
:GOTO compact_inactive_input,conditional_target "||" nop_right is
    (carmel_issue=1 & slot_mode=0 & compact_conditional_opcode=0x50 & slot_0_1=0 &
     compact_inactive_input & conditional_target); (slot_mode=0 & nop_right) {}
:CALL compact_inactive_input,conditional_target "||" nop_right is
    ((carmel_issue=1 & slot_mode=0 & compact_conditional_opcode=0x51 & slot_0_1=0 &
      compact_inactive_input & conditional_target); (slot_mode=0 & nop_right)) & link_2_0 {
    store_link(SP, link_2_0);
}

@define WIDE_DIRECT_INPUT "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1"
:GOTO wide_input_select,wide_goto_target is $(WIDE_DIRECT_INPUT) & wide_conditional_opcode=0x4e40 &
