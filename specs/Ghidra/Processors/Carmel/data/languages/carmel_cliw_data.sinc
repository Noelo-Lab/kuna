# Immutable DATA templates: address selection is independent of lane predicates.
@define CLIW_DM "carmel_issue=5 & wide_left_mode=1 & wide_right_mode=1 & wide_20_22=5 & carmel_cliw_known=1 & template_index"
@define CLIW_DM_IDLE1 "tpl_73_95=0x3fffff"
@define CLIW_DM_IDLE2 "tpl_24_31=0xff & tpl_32_46=0x3fff"
@define CLIW_DM_LOAD12 "tpl_49_51=4 & tpl_0_2=5"
@define CLIW_DM_NO_LOADS "tpl_49_51=0 & tpl_0_2=0"
@define CLIW_DM_MPY1 "tpl_91_95=16 & tpl_87_90=8 & tpl_83_86=9 & tpl_78_82=31 & tpl_73_77>=16 & tpl_73_77<=21 & mac_lo & mac_hi & mac_guard"
@define CLIW_DM_MPY2_SQUARE "cliw_mac2_op=16 & cliw_mac2_left=1 & cliw_mac2_right=1 & cliw_mac2_addend_hi=3 & cliw_mac2_addend_lo=7 & cliw_mac2_dest=18"
@define CLIW_DM_SHORT "$(CLIW_DM) & cliw_address_bank=12 & wide_34_46=0x318 & wide_0_0=0"

# The selector modes here are local to the bank-12 R0/R4 pair.
cliw_dm_first: is wide_10_14=0 { local addr:2 = R0; export addr; }
cliw_dm_first: is wide_10_14=8 { local addr:2 = R0; modify_ptr(R0, RN0, RM0, RL0, 0, 2); export addr; }
cliw_dm_first: is wide_10_14=16 { local addr:2 = R0 + RF0; export addr; }
cliw_dm_first: is wide_10_14=20 { local addr:2 = R0 + RN0; export addr; }
cliw_dm_second: is wide_3_7=0 { local addr:2 = R4; export addr; }
cliw_dm_second: is wide_3_7=4 { local addr:2 = R4; modify_ptr(R4, RN4, RM4, RL4, 8, 1); export addr; }
cliw_dm_second: is wide_3_7=8 { local addr:2 = R4; modify_ptr(R4, RN4, RM4, RL4, 8, 2); export addr; }
cliw_dm_second: is wide_3_7=12 { local addr:2 = R4; modify_ptr(R4, RN4, RM4, RL4, 8, 3); export addr; }
cliw_dm_second: is wide_3_7=16 { local addr:2 = R4 + RF4; export addr; }

:CLIW template_index is $(CLIW_DM_SHORT) & wide_8_9=1 & wide_1_2=1 & cliw_dm_first & cliw_dm_second &
    $(CLIW_DM_MPY1) & $(CLIW_DM_IDLE2) & tpl_67_72=31 & tpl_18_23=31 & $(CLIW_DM_LOAD12) {
    local first:2 = *[data]:2 cliw_dm_first;
    local second:2 = *[data]:2 cliw_dm_second;
    X1 = first;
    FF1 = first;
    FF2 = second;
    local flags:2;
    signed_product_result(mac_lo, mac_hi, mac_guard, first, second, flags);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

# Both ALUs read the incoming accumulators, not the peer MAC writebacks.
:CLIW template_index is $(CLIW_DM) & cliw_address_bank=12 & cliw_terminal_ma4=24 &
    (cliw_terminal_ma3_condition=24 | cliw_terminal_ma3_condition=152) & index_high_0=0 &
    wide_10_14=0 & wide_3_7=0 & wide_8_9=1 & wide_1_2=1 & wide_0_0 & cliw_mac1_predicate &
    $(CLIW_DM_MPY1) & tpl_73_77=16 & $(CLIW_DM_MPY2_SQUARE) & $(CLIW_DM_LOAD12) &
    tpl_67_72=32 & tpl_64_66=4 & tpl_62_63=0 & tpl_57_61=16 & tpl_52_56=17 &
    tpl_18_23=32 & tpl_13_17=18 & tpl_8_12=18 & tpl_3_7=19 {
    local first:2 = *[data]:2 R0;
    local second:2 = *[data]:2 R4;
    local factor:2 = A1L;
    local old0:8;
    local old2:8;
    cliw_alu_sample(A0L, A0H, GB0, old0);
    cliw_alu_sample(A2L, A2H, GB2, old2);
    local enable:2;
    local predicate_mac:1 = cliw_mac1_predicate;
    local predicate_alu:1 = wide_0_0;
    unary_ce(CECFG1, EST, CETBL, 0, enable);
    local flags:2 = EST & 0xcfff;
    local mac_flags:2;
    local alu_flags:2;
    local result:8;
    X1 = first;
    FF1 = first;
    FF2 = second;
    if (enable == 0 && predicate_mac != 0) goto <skip_mac>;
    signed_product_result(mac_lo, mac_hi, mac_guard, first, second, mac_flags);
    flags = flags | (mac_flags & 4);
  <skip_mac>
    if (enable == 0 && predicate_alu != 0) goto <skip_alu>;
    cliw_alu_add(old0, old0, result, alu_flags);
    write_accumulator40(A1L, A1H, GB1, result);
    flags = (flags & 0xffc4) | alu_flags;
  <skip_alu>
    signed_product_result(A2L, A2H, GB2, factor, factor, mac_flags);
    cliw_alu_add(old2, old2, result, alu_flags);
    write_accumulator40(A3L, A3H, GB3, result);
    publish_alu_ce((flags & 0xf13f) | ((alu_flags | (mac_flags & 4)) << 6));
}

:CLIW template_index is $(CLIW_DM_SHORT) & wide_8_9=2 & wide_1_2=2 & wide_10_14=8 & wide_3_7=8 &
    cliw_dm_first & cliw_dm_second & $(CLIW_DM_NO_LOADS) &
    tpl_91_95=16 & tpl_87_90=4 & tpl_83_86=2 & tpl_78_82=31 & tpl_73_77=24 &
    cliw_mac2_op=16 & cliw_mac2_left=4 & cliw_mac2_right=2 & cliw_mac2_addend_hi=3 & cliw_mac2_addend_lo=7 & cliw_mac2_dest=19 &
    tpl_67_72=36 & tpl_64_66=2 & tpl_62_63=1 & tpl_52_56=25 & tpl_18_23=31 {
    local moved:2 = A1H;
    local left:2 = A0H;
    local right:2 = A2L;
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    local result:8;
    local flags:2;
    raw_mac_finish(product, 0:8, 1:1, 0:1, 1:1, result, flags);
    local mac_flags:2;
    signed_product_result(A3L, A3H, GB3, left, right, mac_flags);
    *[data]:2 cliw_dm_first = result(2);
    *[data]:2 cliw_dm_second = moved;
    publish_alu_ce((EST & 0xc13f) | (flags & 4) | (mac_flags << 6));
}

@define CLIW_DM_WORD_MPY "$(CLIW_DM) & wide_0_0=0 & index_high_0=0 & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & tpl_52_63=0xfff & tpl_64_72=0xff & tpl_3_23=0xfffff & tpl_91_95=16 & tpl_78_82=31 & tpl_73_77>=16 & tpl_73_77<=21 & mac_lo & mac_hi & mac_guard"

cliw_mac1_continuation: is cliw_address_bank=13 & cliw_terminal_ma3_condition=24 & cliw_terminal_ma4=24 &
    wide_10_14=28 & wide_3_7=8 & tpl_83_86=9 & (tpl_87_90=9 | tpl_87_90=12) {
    local base:2 = R0;
    modify_native_agu(R0, 2:2, RM0, RL0, RM0_ALIGN, 0:4, 4:2);
    export base;
}
cliw_mac1_continuation: is cliw_address_bank=13 & cliw_terminal_ma3_condition=28 & cliw_terminal_ma4=8 &
    wide_10_14=24 & wide_3_7=24 & tpl_83_86=11 & (tpl_87_90=11 | tpl_87_90=12) {
    local base:2 = R4;
    modify_native_agu(R4, 2:2, RM4, RL4, RM4_ALIGN, 8:4, 4:2);
    export base;
}

cliw_mac1_first_is_ff: is tpl_87_90=9 | tpl_87_90=11 { export 0:1; }
cliw_mac1_first_is_ff: is tpl_87_90=12 { export 1:1; }

macro cliw_dm_word_multiply(lo, hi, guard, first, second) {
    X1 = first;
    local flags:2;
    signed_product_result(lo, hi, guard, first, second, flags);
    cliw_mac1_status(flags);
}

# A short request for the long operand's continuation is a separate RA
# reservation. Only the short result feeds the MAC operand mux.
:CLIW template_index is $(CLIW_DM_WORD_MPY) & wide_8_9=1 & wide_1_2=1 & cliw_mac1_continuation & cliw_mac1_first_is_ff {
    build cliw_mac1_continuation;
    local address:2 = cliw_mac1_continuation;
    local continuation:2 = address + 1;
    compact_mpy_three_reads(address, continuation, continuation);
    local second:2 = *[data]:2 continuation;
    cliw_read_discarded(address);
    cliw_read_discarded(continuation);
    local first:2 = second;
    if (!cliw_mac1_first_is_ff) goto <product>;
    first = FF1;
  <product>
    cliw_dm_word_multiply(mac_lo, mac_hi, mac_guard, first, second);
}

# Both postincrements are live even though only MA1 reserves a DATA read.
:CLIW template_index is $(CLIW_DM_WORD_MPY) & cliw_address_bank=15 &
    cliw_terminal_ma3_condition=24 & cliw_terminal_ma4=24 &
    wide_10_14=8 & wide_3_7=9 & wide_8_9=0 & wide_1_2=0 & tpl_87_90=12 & tpl_83_86=8 {
    local address:2 = R0;
    modify_native_agu(R0, 1:2, RM0, RL0, RM0_ALIGN, 0:4, 4:2);
    modify_native_agu(R1, 1:2, RM0, RL0, RM0_ALIGN, 2:4, 4:2);
    local second:2 = *[data]:2 address;
    cliw_dm_word_multiply(mac_lo, mac_hi, mac_guard, FF1, second);
}
@undef CLIW_DM_WORD_MPY

@define CLIW_DM_LONG "$(CLIW_DM) & cliw_address_bank=13 & wide_34_46=0x318 & wide_0_0=0 & wide_10_14=28 & wide_3_7=8 & $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & tpl_18_23=31"
:CLIW template_index is $(CLIW_DM_LONG) & wide_8_9=1 & wide_1_2=1 &
    tpl_67_72=36 & tpl_64_66=6 & tpl_62_63=0 & tpl_52_56=16 {
    local low_addr:2 = R0;
    local high_addr:2 = low_addr + 1;
    local low:2 = *[data]:2 low_addr;
    local high:2 = *[data]:2 high_addr;
    local bits:8 = ((zext(high) * 0x10000 + zext(low)) ^ 0x80000000) - 0x80000000;
    A0L = low;
    A0H = high;
    GB0 = bits(4);
    modify_ptr_scaled(R0, RN0, RM0, RL0, 0, 2, 2:2);
    local flags:2;
    cliw_alu_status(bits & 0xffffffffff, flags);
    publish_alu_ce((EST & 0xcfc7) | flags);
}
:CLIW template_index is $(CLIW_DM_LONG) & wide_8_9=2 & wide_1_2=2 &
    tpl_67_72=36 & tpl_64_66=4 & tpl_62_63=1 & tpl_52_56=24 {
    local low_addr:2 = R0;
    local high_addr:2 = low_addr + 1;
    *[data]:2 low_addr = A1L;
    *[data]:2 high_addr = A1H;
    modify_ptr_scaled(R0, RN0, RM0, RL0, 0, 2, 2:2);
}

macro cliw_dm_word_add(left, right, word, flags) {
    local a:8 = ((zext(left) ^ 0x8000) - 0x8000) << 16;
    local b:8 = ((zext(right) ^ 0x8000) - 0x8000) << 16;
    local exact:8 = a + b;
    local raw:8 = (a & 0xffffffffff) + (b & 0xffffffffff);
    local result:8;
    raw_mac_finish(exact, raw, 1:1, 0:1, 1:1, result, flags);
    word = result(2);
}
:CLIW template_index is $(CLIW_DM_SHORT) & wide_8_9=3 & wide_1_2=3 & wide_10_14=8 & wide_3_7=12 &
    cliw_dm_first & cliw_dm_second & $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) &
    tpl_67_72=32 & tpl_64_66=6 & tpl_62_63=0 & tpl_57_61=9 & tpl_52_56=24 &
    tpl_18_23=32 & tpl_13_17=25 & tpl_8_12=10 & tpl_3_7=25 {
    local first:2 = *[data]:2 cliw_dm_first;
    local second:2 = *[data]:2 cliw_dm_second;
    local out1:2;
    local out2:2;
    local flags1:2;
    local flags2:2;
    cliw_dm_word_add(first, A1H, out1, flags1);
    cliw_dm_word_add(second, A2H, out2, flags2);
    *[data]:2 cliw_dm_first = out1;
    *[data]:2 cliw_dm_second = out2;
    publish_alu_ce((EST & 0xc104) | flags1 | (flags2 << 6));
}

# Four physical postincrements: MA3 follows MA2 on R4, MA4 follows MA1 on R0.
:CLIW template_index is $(CLIW_DM) & cliw_address_bank=12 & cliw_terminal_ma3_condition=8 & cliw_terminal_ma4=8 & wide_0_0=0 &
    wide_8_9=1 & wide_1_2=1 & wide_10_14=8 & wide_3_7=8 & cliw_dm_first & cliw_dm_second & $(CLIW_DM_NO_LOADS) &
    tpl_91_95=24 & tpl_87_90=8 & tpl_83_86=9 & tpl_78_82=18 & tpl_73_77=18 &
    cliw_mac2_op=24 & cliw_mac2_left=11 & cliw_mac2_right=10 & cliw_mac2_addend_hi=2 & cliw_mac2_addend_lo=3 & cliw_mac2_dest=19 &
    tpl_67_72=28 & tpl_64_66=6 & tpl_62_63=0 & tpl_57_61=4 & tpl_52_56=4 &
    tpl_18_23=20 & tpl_13_17=27 & tpl_8_12=5 & tpl_3_7=5 {
    build cliw_dm_first;
    build cliw_dm_second;
    local ma3:2 = R4;
    local ma4:2 = R0;
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    modify_ptr(R0, RN0, RM0, RL0, 0, 2);
    local first:2 = *[data]:2 cliw_dm_first;
    local second:2 = *[data]:2 cliw_dm_second;
    local third:2 = *[data]:2 ma3;
    local fourth:2 = *[data]:2 ma4;
    local base2:8;
    local base3:8;
    cliw_alu_sample(A2L, A2H, GB2, base2);
    cliw_alu_sample(A3L, A3H, GB3, base3);
    local product2:8;
    local product3:8;
    raw_mac_product(first, second, 1:1, 1:1, product2);
    raw_mac_product(fourth, third, 1:1, 1:1, product3);
    local result2:8;
    local result3:8;
    local flags2:2;
    local flags3:2;
    cliw_alu_add(base2, product2 & 0xffffffffff, result2, flags2);
    cliw_alu_add(base3, product3 & 0xffffffffff, result3, flags3);
    X1 = first;
    X2 = fourth;
    write_accumulator40(A2L, A2H, GB2, result2);
    write_accumulator40(A3L, A3H, GB3, result3);
    if (first s<= A4L) goto <min_second>;
    A4L = first;
  <min_second>
    if (fourth s>= A5L) goto <parallel_done>;
    A5L = fourth;
  <parallel_done>
    publish_alu_ce((EST & 0xcfff) | (flags2 & 4) | ((flags3 & 4) << 6));
}

:CLIW template_index is $(CLIW_DM_SHORT) & wide_8_9=1 & wide_1_2=1 & wide_10_14=0 & wide_3_7=24 &
    $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & tpl_18_23=31 &
    tpl_67_72=26 & tpl_64_66=6 & tpl_62_63=0 & tpl_57_61=1 & tpl_52_56=1 {
    local address:2 = R0;
    local value:2 = *[data]:2 address;
    if (value s<= A1L) goto <maxm_done>;
    A1L = value;
    MINMAX = address;
  <maxm_done>
}

@define CLIW_DM_EXT_BASE "$(CLIW_DM) & cliw_terminal_ma4=24"
@define CLIW_DM_EXT_END "$(CLIW_DM_EXT_BASE) & cliw_terminal_ma3=24"
@define CLIW_DM_MOVE1 "tpl_67_72=36 & tpl_57_61=31"
@define CLIW_DM_MOVE2 "tpl_18_23=36 & tpl_8_12=31"
@define CLIW_DM_NOP_ALU1 "tpl_67_72=31 & tpl_52_56=31"
@define CLIW_DM_NOP_ALU2 "tpl_18_23=31 & tpl_3_7=31"
@define CLIW_DM_ACC1 "tpl_52_56>=16 & tpl_52_56<=21 & cliw_alu_52_acc_0_0 & cliw_alu_52_acc_0_1 & cliw_alu_52_acc_0_2"
@define CLIW_DM_ACC2 "tpl_3_7>=16 & tpl_3_7<=21 & cliw_alu_3_acc_0_0 & cliw_alu_3_acc_0_1 & cliw_alu_3_acc_0_2"
@define CLIW_DM_DISTINCT_ACC "(tpl_52_56=16 & tpl_3_7>16 | tpl_52_56=17 & (tpl_3_7<17 | tpl_3_7>17) | tpl_52_56=18 & (tpl_3_7<18 | tpl_3_7>18) | tpl_52_56=19 & (tpl_3_7<19 | tpl_3_7>19) | tpl_52_56=20 & (tpl_3_7<20 | tpl_3_7>20) | tpl_52_56=21 & tpl_3_7<21)"

cliw_word_post_ma1: is wide_10_14>=8 & wide_10_14<=11 &
    cliw_ma1_low & cliw_ma1_mod & cliw_ma1_bound & cliw_ma1_shift {
    local address:2 = cliw_ma1_low;
    modify_ptr(cliw_ma1_low, 0:2, cliw_ma1_mod, cliw_ma1_bound, cliw_ma1_shift, 2);
    export address;
}
cliw_word_post_ma2: is wide_3_7>=8 & wide_3_7<=11 &
    cliw_ma2_low & cliw_ma2_mod & cliw_ma2_bound & cliw_ma2_shift {
    local address:2 = cliw_ma2_low;
    modify_ptr(cliw_ma2_low, 0:2, cliw_ma2_mod, cliw_ma2_bound, cliw_ma2_shift, 2);
    export address;
}
cliw_long_post_ma12: is wide_10_14>=28 & wide_3_7>=8 & wide_3_7<=11 &
    cliw_ma1_low & cliw_ma1_mod & cliw_ma1_bound & cliw_ma1_shift {
    local address:2 = cliw_ma1_low;
    modify_ptr_scaled(cliw_ma1_low, 0:2, cliw_ma1_mod, cliw_ma1_bound, cliw_ma1_shift, 2, 2:2);
    export address;
}
cliw_long_post_ma34: is cliw_terminal_ma3>=28 & cliw_terminal_ma4>=8 & cliw_terminal_ma4<=11 &
    cliw_ma3_high & cliw_ma3_mod & cliw_ma3_bound & cliw_ma3_shift {
    local address:2 = cliw_ma3_high;
    modify_ptr_scaled(cliw_ma3_high, 0:2, cliw_ma3_mod, cliw_ma3_bound, cliw_ma3_shift, 2, 2:2);
    export address;
}

macro cliw_dm_sample_pair(address, low, high) {
    local upper:2 = address + 1;
    low = *[data]:2 address;
    high = *[data]:2 upper;
}
macro cliw_dm_sign_pair(low, high, value) {
    value = (sext(high) * 0x10000 + zext(low)) & 0xffffffffff;
}
macro cliw_dm_move_write(value, lo, hi, guard, cfg, predicate, bank, keep, status) {
    local enabled:2;
    local pred:1 = predicate;
    unary_ce(cfg, EST, CETBL, bank, enabled);
    if (pred != 0 && enabled == 0) goto <move_done>;
    local flags:2;
    cliw_alu_status(value, flags);
    write_accumulator40(lo, hi, guard, value);
    local shift:4 = 6 * bank;
    status = (status & keep) | (flags << shift);
  <move_done>
}

@define CLIW_DM_TERMINAL_MOVE "$(CLIW_DM) & cliw_address_bank=14 & wide_10_14=22 & wide_8_9=0 & wide_3_7=8 & wide_1_2=0 & wide_0_0=0 & $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & tpl_3_23=0xfffff & $(CLIW_DM_MOVE1) & tpl_64_66=6 & tpl_52_56=16"
macro cliw_terminal_move(low, high) {
    local negative:1 = high s< 0;
    A0L = low;
    A0H = high;
    GB0 = -zext(negative);
    local flags:2 = (zext((low | high) == 0) << 3) | (zext(negative) << 4);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

# A normal terminal suffix completes a long MA3 input at the MA3 base.
:CLIW template_index is $(CLIW_DM_TERMINAL_MOVE) & cliw_terminal_ma3_condition=28 &
    cliw_terminal_ma4=0 & tpl_62_63=2 {
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local low:2;
    local high:2;
    cliw_dm_sample_pair(R0, low, high);
    cliw_terminal_move(low, high);
}
# A terminal prefix supplies its own long input, not MA3's base.
:CLIW template_index is $(CLIW_DM_TERMINAL_MOVE) & cliw_terminal_ma3_condition=28 &
    cliw_terminal_ma4=29 & tpl_62_63=3 {
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local low:2;
    local high:2;
    cliw_dm_sample_pair(R1, low, high);
    cliw_terminal_move(low, high);
}
:CLIW template_index is $(CLIW_DM_TERMINAL_MOVE) & cliw_terminal_ma3_condition=7 &
    cliw_terminal_ma4=28 & tpl_62_63=3 {
    modify_ptr(R4, RN4, RM4, RL4, 8, 2);
    local low:2;
    local high:2;
    cliw_dm_sample_pair(R0, low, high);
    cliw_read_discarded(R3);
    modify_ptr(R3, RN3, RM2, RL2, 6, 1);
    cliw_terminal_move(low, high);
}
@undef CLIW_DM_TERMINAL_MOVE

# Bank 15 uses the low pointer bank for both word ports. Zero access
# qualifiers do not suppress an operand explicitly sourced by the template.
:CLIW template_index is $(CLIW_DM_EXT_END) & cliw_address_bank=15 & wide_8_9=0 & wide_1_2=0 &
    cliw_word_post_ma1 & cliw_word_post_ma2 &
    (wide_10_14=8 & wide_3_7>8 | wide_10_14=9 & (wide_3_7<9 | wide_3_7>9) |
     wide_10_14=10 & (wide_3_7<10 | wide_3_7>10) | wide_10_14=11 & wide_3_7<11) &
    $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) &
    $(CLIW_DM_MOVE1) & tpl_64_66=6 & tpl_62_63=0 & $(CLIW_DM_ACC1) &
    $(CLIW_DM_MOVE2) & tpl_13_17=25 & $(CLIW_DM_ACC2) & $(CLIW_DM_DISTINCT_ACC) &
    wide_0_0 & cliw_alu2_predicate {
    local first:2 = *[data]:2 cliw_word_post_ma1;
    local second:2 = *[data]:2 cliw_word_post_ma2;
    local value1:8 = sext(first) & 0xffffffffff;
    local value2:8 = sext(second) & 0xffffffffff;
    local status:2 = EST & 0xcfff;
    cliw_dm_move_write(value1, cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2,
                      CECFG1, wide_0_0, 0, 0xffc6, status);
    cliw_dm_move_write(value2, cliw_alu_3_acc_0_0, cliw_alu_3_acc_0_1, cliw_alu_3_acc_0_2,
                      CECFG2, cliw_alu2_predicate, 1, 0xf1bf, status);
    publish_alu_ce(status);
}

# Selectors 24 and 27 leave a port unbound even with a read qualifier.
:CLIW template_index is $(CLIW_DM) & cliw_address_bank=12 &
    (wide_10_14=24 | wide_10_14=27) & (wide_3_7=24 | wide_3_7=27) &
    (cliw_terminal_ma3=24 | cliw_terminal_ma3=27) & (cliw_terminal_ma4=24 | cliw_terminal_ma4=27) &
    $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & $(CLIW_DM_NOP_ALU2) &
    $(CLIW_DM_MOVE1) & cliw_ext_alu1_left & $(CLIW_DM_ACC1) & wide_0_0 {
    local status:2 = EST & 0xcfff;
    cliw_dm_move_write(cliw_ext_alu1_left, cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2,
                      CECFG1, wide_0_0, 0, 0xffc6, status);
    publish_alu_ce(status);
}

# Long MA23 uses MA2's base without modifying it. MA3 is a continuation,
# not another pointer operation, even when its encoded mode is nonzero.
@define CLIW_DM_MA23 "$(CLIW_DM_EXT_BASE) & cliw_address_bank=15 & (wide_10_14=24 | wide_10_14=27) & wide_3_7>=28 & cliw_terminal_ma3>=8 & cliw_terminal_ma3<=11 & cliw_ma2_low"
:CLIW template_index is $(CLIW_DM_MA23) & wide_1_2=1 &
    $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & $(CLIW_DM_NOP_ALU2) &
    $(CLIW_DM_MOVE1) & tpl_64_66=6 & tpl_62_63=1 & $(CLIW_DM_ACC1) & wide_0_0 {
    local low:2;
    local high:2;
    cliw_dm_sample_pair(cliw_ma2_low, low, high);
    local value:8;
    cliw_dm_sign_pair(low, high, value);
    local status:2 = EST & 0xcfff;
    cliw_dm_move_write(value, cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2,
                      CECFG1, wide_0_0, 0, 0xffc6, status);
    publish_alu_ce(status);
}

@define CLIW_DM_MA34 "$(CLIW_DM) & cliw_address_bank=13 & wide_10_14=24 & wide_3_7=24 & cliw_long_post_ma34 & $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NOP_ALU1)"
:CLIW template_index is $(CLIW_DM_MA34) & $(CLIW_DM_NO_LOADS) &
    $(CLIW_DM_MOVE2) & tpl_13_17=26 & $(CLIW_DM_ACC2) & cliw_alu2_predicate {
    local low:2;
    local high:2;
    cliw_dm_sample_pair(cliw_long_post_ma34, low, high);
    local value:8;
    cliw_dm_sign_pair(low, high, value);
    local status:2 = EST & 0xcfff;
    cliw_dm_move_write(value, cliw_alu_3_acc_0_0, cliw_alu_3_acc_0_1, cliw_alu_3_acc_0_2,
                      CECFG2, cliw_alu2_predicate, 1, 0xf1bf, status);
    publish_alu_ce(status);
}
:CLIW template_index is $(CLIW_DM_MA34) & tpl_49_51=0 & $(CLIW_DM_NOP_ALU2) & tpl_0_2=6 {
    local low:2;
    local high:2;
    cliw_dm_sample_pair(cliw_long_post_ma34, low, high);
    FF1 = high;
    FF2 = low;
    publish_alu_ce(EST & 0xcfff);
}

# The ALU samples the old FF pair before the two LOAD lanes publish the
# single latched MA12 input. The continuation is not a second AGU update.
:CLIW template_index is $(CLIW_DM_EXT_END) & cliw_address_bank=13 & wide_8_9=1 &
    cliw_long_post_ma12 & $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_LOAD12) & $(CLIW_DM_NOP_ALU2) &
    $(CLIW_DM_MOVE1) & tpl_64_66=5 & tpl_62_63=3 & $(CLIW_DM_ACC1) & wide_0_0 {
    local value:8;
    cliw_dm_sign_pair(FF2, FF1, value);
    local low:2;
    local high:2;
    cliw_dm_sample_pair(cliw_long_post_ma12, low, high);
    local status:2 = EST & 0xcfff;
    cliw_dm_move_write(value, cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2,
                      CECFG1, wide_0_0, 0, 0xffc6, status);
    FF1 = high;
    FF2 = low;
    publish_alu_ce(status);
}

macro cliw_dm_dual_product(left, right, word_port, accumulator, data_result, flags) {
    local product:8;
    raw_mac_product(left, right, 1:1, 1:1, product);
    data_result = product & 0xffffffffff;
    raw_mac_finish(product, data_result, word_port, 0:1, 0:1, accumulator, flags);
    if ((ECFG & 0x20) == 0) goto <saturate_store>;
    data_result = (data_result >> 1) | (data_result & 0x8000000000);
    goto <store_done>;
  <saturate_store>
    if ((ECFG & 8) == 0 || (flags & 0x20) == 0) goto <store_done>;
    local limited:8;
    cliw_alu_limit32(data_result, limited);
    data_result = limited;
    flags = flags | 4;
  <store_done>
}

# A dual destination drives its lane's fixed accumulator and the selected
# DATA port. Register limiting and DATA saturation/SR1 are separate paths.
:CLIW template_index is $(CLIW_DM_EXT_END) & cliw_address_bank=12 & wide_10_14<=3 &
    wide_8_9=2 & wide_3_7=24 & cliw_ma1_low & cliw_mac1_predicate &
    $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & $(CLIW_DM_NOP_ALU1) & $(CLIW_DM_NOP_ALU2) &
    tpl_91_95=16 & tpl_87_90<8 & tpl_83_86<8 & mac_left & mac_right & tpl_78_82=31 & tpl_73_77=28 {
    local status:2 = EST & 0xcfff;
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local pred:1 = cliw_mac1_predicate;
    if (pred != 0 && enabled == 0) goto <write_done>;
    local acc:8;
    local value:8;
    local flags:2;
    cliw_dm_dual_product(mac_left, mac_right, 1:1, acc, value, flags);
    A0H = acc(2);
    *[data]:2 cliw_ma1_low = value(2);
    status = (status & 0xffc4) | flags;
  <write_done>
    publish_alu_ce(status);
}
:CLIW template_index is $(CLIW_DM_MA23) & wide_1_2=2 &
    $(CLIW_DM_IDLE1) & $(CLIW_DM_NO_LOADS) & $(CLIW_DM_NOP_ALU1) & $(CLIW_DM_NOP_ALU2) &
    cliw_mac2_op=16 & cliw_mac2_left<8 & cliw_mac2_right<8 & cliw_mac2_left_word & cliw_mac2_right_word &
    cliw_mac2_addend_hi=3 & cliw_mac2_addend_lo=7 & cliw_mac2_dest=29 & cliw_mac2_predicate {
    local status:2 = EST & 0xcfff;
    local enabled:2;
    unary_ce(CECFG2, EST, CETBL, 1, enabled);
    local pred:1 = cliw_mac2_predicate;
    if (pred != 0 && enabled == 0) goto <write_done>;
    local acc:8;
    local value:8;
    local flags:2;
    cliw_dm_dual_product(cliw_mac2_left_word, cliw_mac2_right_word, 0:1, acc, value, flags);
    local upper:2 = cliw_ma2_low + 1;
    write_accumulator40(A1L, A1H, GB1, acc);
    *[data]:2 cliw_ma2_low = value:2;
    *[data]:2 upper = value(2);
    status = (status & 0xf13f) | (flags << 6);
  <write_done>
    publish_alu_ce(status);
}
:CLIW template_index is $(CLIW_DM_EXT_END) & cliw_address_bank=13 & wide_10_14>=28 & wide_3_7<=3 &
    wide_8_9=2 & cliw_ma1_low & $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) &
    $(CLIW_DM_NOP_ALU2) & $(CLIW_DM_MOVE1) & cliw_ext_alu1_left & tpl_52_56=28 & wide_0_0 {
    local status:2 = EST & 0xcfff;
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    local pred:1 = wide_0_0;
    if (pred != 0 && enabled == 0) goto <write_done>;
    local value:8 = cliw_ext_alu1_left;
    local upper:2 = cliw_ma1_low + 1;
    local flags:2;
    cliw_alu_status(value, flags);
    write_accumulator40(A0L, A0H, GB0, value);
    *[data]:2 cliw_ma1_low = value:2;
    *[data]:2 upper = value(2);
    status = (status & 0xffc6) | flags;
  <write_done>
    publish_alu_ce(status);
}

# Without the left wide marker the D2 skip width replaces MA1's immediate.
# Count only the AGU records after MA1, including any stack records.
cliw_skip_unmarked: is wide_left_mode=0 { local value:2 = 1; export value; }
cliw_skip_unmarked: is wide_left_mode=1 { local value:2 = 0; export value; }

cliw_chain_short_second: is wide_10_14=10 & wide_3_7=14 {
    export 1:2;
}
cliw_chain_short_second: is wide_10_14=10 & wide_3_7=10 & wide_left_mode=0 {
    modify_native_agu(R2, 2:2, RM2, RL2, RM2_ALIGN, 4:4, 4:2);
    export 1:2;
}
cliw_chain_short_second: is wide_10_14=14 & wide_3_7=6 & wide_left_mode=0 {
    modify_native_agu(R2, RN2, RM2, RL2, RM2_ALIGN, 4:4, 1:2);
    export 0xffff:2;
}

# MA1 and MA2 sample the incoming pointer. MA1's patched displacement
# does not alter the merged R2 update or the second read.
:CLIW template_index is ((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) &
    wide_right_mode=1 & wide_20_22=5 & template_index & carmel_cliw_known=1 &
    cliw_address_bank=15 & cliw_terminal_ma3_condition=24 & cliw_terminal_ma4=24 &
    wide_8_9=1 & wide_1_2=1 & wide_0_0=0 & cliw_skip_unmarked & cliw_chain_short_second &
    $(CLIW_DM_IDLE1) & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) &
    tpl_67_72=36 & tpl_64_66=6 & tpl_62_63=0 & tpl_57_61=0 & $(CLIW_DM_ACC1) &
    tpl_18_23=36 & tpl_13_17=25 & tpl_8_12=0 & $(CLIW_DM_ACC2) & $(CLIW_DM_DISTINCT_ACC) {
    local base:2 = R2;
    build cliw_chain_short_second;
    local first_addr:2 = base + cliw_skip_unmarked * 4;
    local second_addr:2 = base + cliw_chain_short_second;
    local first:2 = *[data]:2 first_addr;
    local second:2 = *[data]:2 second_addr;
    local left:8 = sext(first) & 0xffffffffff;
    local right:8 = sext(second) & 0xffffffffff;
    local flags1:2;
    local flags2:2;
    cliw_alu_status(left, flags1);
    cliw_alu_status(right, flags2);
    write_accumulator40(cliw_alu_52_acc_0_0, cliw_alu_52_acc_0_1, cliw_alu_52_acc_0_2, left);
    write_accumulator40(cliw_alu_3_acc_0_0, cliw_alu_3_acc_0_1, cliw_alu_3_acc_0_2, right);
    publish_alu_ce((EST & 0xc104) | flags1 | (flags2 << 6));
}

@undef CLIW_DM_MA34
@undef CLIW_DM_MA23
@undef CLIW_DM_DISTINCT_ACC
@undef CLIW_DM_ACC2
@undef CLIW_DM_ACC1
@undef CLIW_DM_NOP_ALU2
@undef CLIW_DM_NOP_ALU1
@undef CLIW_DM_MOVE2
@undef CLIW_DM_MOVE1
@undef CLIW_DM_EXT_END
@undef CLIW_DM_EXT_BASE

@define CLIW_SKIP "((carmel_issue=4 & wide_left_mode=0) | (carmel_issue=5 & wide_left_mode=1)) & wide_right_mode=1 & wide_20_22=5 & template_index & carmel_cliw_known=1 & $(CLIW_DM_IDLE2) & $(CLIW_DM_NO_LOADS) & tpl_3_23=0xfffff & cliw_skip_unmarked"
@define CLIW_SKIP_MOVE "$(CLIW_DM_IDLE1) & tpl_67_72=36 & tpl_64_66=2 & tpl_62_63=1 & tpl_57_61=31 & tpl_52_56=16"
@define CLIW_SKIP_ACC "$(CLIW_DM_IDLE1) & tpl_64_66=4 & tpl_62_63=1 & tpl_57_61=18 & tpl_52_56=16"
@define CLIW_SKIP_MPY "tpl_52_63=0xfff & tpl_64_72=0xff & tpl_91_95=16 & tpl_87_90=1 & tpl_83_86=2 & tpl_78_82=31 & tpl_73_77=16"

macro cliw_skip_move() {
    local value:8 = sext(A1H) & 0xffffffffff;
    local flags:2;
    cliw_alu_status(value, flags);
    write_accumulator40(A0L, A0H, GB0, value);
    publish_alu_ce((EST & 0xcfc7) | flags);
}

# MA1 R6--; MA2 *R4; MA3 R2++; MA4 R1++.
:CLIW template_index is $(CLIW_SKIP) & $(CLIW_SKIP_MOVE) & cliw_address_bank=8 &
    wide_10_14=14 & wide_8_9=0 & wide_3_7=0 & wide_1_2=3 & wide_0_0=0 &
    cliw_terminal_ma3_condition=10 & cliw_terminal_ma4=9 {
    local step:2 = cliw_skip_unmarked * (4 + 4 + 4 + 1) - 1;
    transfer_address_word(R6, RM6, RL6, 12, step, R6);
    transfer_address_word(R2, RM2, RL2, 4, 1:2, R2);
    transfer_address_word(R1, RM0, RL0, 2, 1:2, R1);
    *[data]:2 R4 = 0:2;
    cliw_skip_move();
}

# MA1 is long: the MA2 selector supplies its postdecrement mode.
# The two trailing indexed records contribute three bytes each.
:CLIW template_index is $(CLIW_SKIP) & $(CLIW_SKIP_ACC) & tpl_67_72=54 & cliw_address_bank=15 &
    wide_10_14=31 & wide_8_9=2 & wide_3_7=13 & wide_1_2=3 & wide_0_0=0 &
    cliw_terminal_ma3_condition=18 & cliw_terminal_ma4=5 {
    local address:2 = R3;
    local high:2 = address + 1;
    local step:2 = cliw_skip_unmarked * (3 + 3 + 2) - 2;
    transfer_address_word(R3, RM2, RL2, 6, step, R3);
    local index_step:2 = RN1;
    local next:2;
    if ((PACFG & 0xc) != 4) goto <ordinary_index>;
    local reversed:2;
    local reversed_step:2;
    reverse_word(R1, reversed);
    reverse_word(index_step, reversed_step);
    local sum:2 = reversed + reversed_step;
    reverse_word(sum, next);
    goto <index_done>;
  <ordinary_index>
    transfer_address_word(R1, RM0, RL0, 2, index_step, next);
  <index_done>
    R1 = next;
    *[data]:2 address = 0:2;
    *[data]:2 high = 0:2;
    local first:8;
    local second:8;
    cliw_alu_sample(A1L, A1H, GB1, first);
    cliw_alu_sample(A2L, A2H, GB2, second);
    local result:8 = first ^ second;
    local flags:2;
    cliw_alu_status(result, flags);
    write_accumulator40(A0L, A0H, GB0, result);
    publish_alu_ce((EST & 0xcfc7) | flags);
}

macro cliw_skip_acc_add(incoming, flags) {
    local enabled:2;
    unary_ce(CECFG1, incoming, CETBL, 0, enabled);
    if (enabled == 0) goto <add_done>;
    local first:8;
    local second:8;
    local result:8;
    local lane_flags:2;
    cliw_alu_sample(A1L, A1H, GB1, first);
    cliw_alu_sample(A2L, A2H, GB2, second);
    cliw_alu_add(first, second, result, lane_flags);
    write_accumulator40(A0L, A0H, GB0, result);
    flags = (flags & 0xffc4) | lane_flags;
  <add_done>
}

# For indirect MA1 the immediate moves the effective store address,
# not R2, even if the accumulator add is inhibited.
:CLIW template_index is $(CLIW_SKIP) & $(CLIW_SKIP_ACC) & tpl_67_72=32 & cliw_address_bank=4 &
    wide_10_14=2 & wide_8_9=2 & wide_3_7=9 & wide_1_2=1 & wide_0_0=1 &
    cliw_terminal_ma3_condition=23 & cliw_terminal_ma4=28 {
    local address:2 = R2 + cliw_skip_unmarked * (4 + 3 + 4);
    transfer_address_word(R1, RM0, RL0, 2, 1:2, R1);
    *[data]:2 address = 0:2;
    local flags:2 = EST & 0xcfff;
    cliw_skip_acc_add(EST, flags);
    publish_alu_ce(flags);
}

cliw_merged_r7_modifier_bytes: is cliw_terminal_ma4=15 {
    modify_native_agu(R7, -2:2, RM6, RL6, RM6_ALIGN, 14:4, 4:2);
    export 4:2;
}
cliw_merged_r7_modifier_bytes: is cliw_terminal_ma4=7 & wide_left_mode=0 {
    modify_native_agu(R7, RN7, RM6, RL6, RM6_ALIGN, 14:4, 1:2);
    export 3:2;
}

# The last two short reads reserve successive words of the old R7. No
# template lane consumes them, and they cannot contend with each other.
:CLIW template_index is $(CLIW_SKIP) & $(CLIW_SKIP_ACC) & tpl_67_72=32 & cliw_address_bank=13 &
    wide_10_14=3 & wide_8_9=2 & wide_3_7=17 & wide_1_2=0 & wide_0_0=1 &
    (cliw_terminal_ma3_condition=111 | cliw_terminal_ma3_condition=239) &
    cliw_mac1_predicate & cliw_merged_r7_modifier_bytes {
    build cliw_merged_r7_modifier_bytes;
    local mac_condition:1 = cliw_mac1_predicate;
    local patch:2 = 11 + zext(mac_condition) * cliw_merged_r7_modifier_bytes;
    local address:2 = R3 + cliw_skip_unmarked * patch;
    local incoming:2 = EST;
    local flags:2 = incoming & 0xcfff;
    cliw_skip_acc_add(incoming, flags);
    *[data]:2 address = 0:2;
    publish_ce_feedback(flags, incoming);
}

# MA2's stack push consumes three four-byte records and displaces MA3.
# The register product does not read either configured address.
:CLIW template_index is $(CLIW_SKIP) & $(CLIW_SKIP_MPY) & cliw_address_bank=8 &
    wide_10_14=13 & wide_8_9=1 & wide_3_7=25 & wide_1_2=3 & wide_0_0=0 &
    cliw_terminal_ma3_condition=1 & cliw_terminal_ma4=19 {
    local step:2 = cliw_skip_unmarked * (12 + 1) - 1;
    transfer_address_word(R5, RM4, RL4, 10, step, R5);
    local high:2 = SP - 1;
    SP = SP - 2;
    *[data]:2 SP = 0:2;
    *[data]:2 high = 0:2;
    local flags:2;
    signed_product_result(A0L, A0H, GB0, A1L, A2L, flags);
    publish_alu_ce((EST & 0xcfc4) | flags);
}

cliw_skip_last_bytes: is cliw_terminal_ma4=0 { local bytes:2 = 4; export bytes; }
cliw_skip_last_bytes: is cliw_terminal_ma4=16 { local bytes:2 = 3; export bytes; }

# MA4 has no template consumer but still contributes its record width.
:CLIW template_index is $(CLIW_SKIP) & $(CLIW_SKIP_MOVE) & cliw_address_bank=3 &
    wide_10_14=14 & wide_8_9=0 & wide_3_7=9 & wide_1_2=1 & wide_0_0=1 &
    cliw_terminal_ma3_condition=238 & cliw_skip_last_bytes {
    local step:2 = cliw_skip_unmarked * (4 + 4 + cliw_skip_last_bytes + 1) - 1;
    transfer_address_word(R2, RM2, RL2, 4, step, R2);
    transfer_address_word(R5, RM4, RL4, 10, 1:2, R5);
    transfer_address_word(R6, RM6, RL6, 12, -1:2, R6);
    local enabled:2;
    unary_ce(CECFG1, EST, CETBL, 0, enabled);
    if (enabled == 0) goto <inhibited>;
    cliw_skip_move();
    goto <move_done>;
  <inhibited>
    publish_alu_ce(EST & 0xcfff);
  <move_done>
}

@undef CLIW_SKIP_MPY
@undef CLIW_SKIP_ACC
@undef CLIW_SKIP_MOVE
@undef CLIW_SKIP

@undef CLIW_DM_LONG
@undef CLIW_DM_SHORT
@undef CLIW_DM_MPY2_SQUARE
@undef CLIW_DM_MPY1
@undef CLIW_DM_NO_LOADS
@undef CLIW_DM_LOAD12
@undef CLIW_DM_IDLE2
@undef CLIW_DM_IDLE1
@undef CLIW_DM
