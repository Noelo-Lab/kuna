# cm.jt / cm.jalt: an indirect jump through the jvt (CSR 0x017) jump table;
# indexes below 32 are jumps, 32..255 are calls.
:cm.jt cop0209 is Zcmp=1 & cop0001=0x2 & cop1315=0x5 & cop1012=0x0 & cop0709=0 & cop0209
{
	local jvt:$(XLEN) = *[csreg]:$(XLEN) 0x17:2;
	local ea:$(XLEN) = (jvt & ~0x3f) + cop0209 * $(XLEN);
	local target:$(XLEN) = *[ram]:$(XLEN) ea;
	goto [target];
}

:cm.jalt cop0209 is Zcmp=1 & cop0001=0x2 & cop1315=0x5 & cop1012=0x0 & (cop0707=1 | cop0808=1 | cop0909=1) & cop0209
{
	local jvt:$(XLEN) = *[csreg]:$(XLEN) 0x17:2;
	local ea:$(XLEN) = (jvt & ~0x3f) + cop0209 * $(XLEN);
	local target:$(XLEN) = *[ram]:$(XLEN) ea;
	ra = inst_next;
	call [target];
}
