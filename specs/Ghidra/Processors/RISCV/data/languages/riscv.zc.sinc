# Zcmp / Zcmt code-size extensions (RISC-V Zc* v1.0.0).
#
# cm.push, cm.pop, cm.popret, cm.popretz, cm.mvsa01, cm.mva01s (Zcmp) and
# cm.jt, cm.jalt (Zcmt) live in the c.fsdsp encoding space (op=10, funct3=101),
# so they are incompatible with Zcd and decode only under the Zcmp context
# bit, which the RISCV:LE:32:Zcmp / RISCV:LE:64:Zcmp language variants set.
# The register list rlist (bits 7:4) is a prefix of {ra,s0,...,s11}; rlist 15
# is the full list (s10 is never saved without s11). The stack adjustment is the
# list's size rounded up to 16 bytes plus 16*spimm (bits 3:2).

attach variables [ zcs0709 zcs0204 ] [ s0 s1 s2 s3 s4 s5 s6 s7 ];

@if ADDRSIZE == "32"
zcadj16: adj is cop0203 [ adj = 16 + (cop0203 << 4); ] { export *[const]:$(XLEN) adj; }
zcadj32: adj is cop0203 [ adj = 32 + (cop0203 << 4); ] { export *[const]:$(XLEN) adj; }
zcadj48: adj is cop0203 [ adj = 48 + (cop0203 << 4); ] { export *[const]:$(XLEN) adj; }
zcadj64: adj is cop0203 [ adj = 64 + (cop0203 << 4); ] { export *[const]:$(XLEN) adj; }

:cm.push "{ra}",-^zcadj16 is Zcmp=1 & cop0001=0x2 & cop1315=0x5 & cop0812=0x18 & cop0407=4 & zcadj16
{
	*[ram]:4 (sp - 4) = ra;
	sp = sp - zcadj16;
}

:cm.pop "{ra}",zcadj16 is Zcmp=1 & cop0001=0x2 & cop1315=0x5 & cop0812=0x1a & cop0407=4 & zcadj16
{
	local top:$(XLEN) = sp + zcadj16;
	ra = *[ram]:4 (top - 4);
	sp = top;
}

:cm.popretz "{ra}",zcadj16 is Zcmp=1 & cop0001=0x2 & cop1315=0x5 & cop0812=0x1c & cop0407=4 & zcadj16
{
	local top:$(XLEN) = sp + zcadj16;
	ra = *[ram]:4 (top - 4);
	sp = top;
	a0 = 0;
	return [ra];
}

:cm.popret "{ra}",zcadj16 is Zcmp=1 & cop0001=0x2 & cop1315=0x5 & cop0812=0x1e & cop0407=4 & zcadj16
{
