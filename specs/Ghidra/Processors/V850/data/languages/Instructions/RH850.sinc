# Instructions the RH850 (V850E3v5) cores add to V850E2M:
# rotate, bit-field insert, loop, register-range push/pop, linked load and
# conditional store, doubleword load/store, register-indirect JARL, cache and
# hypervisor operations, and the system-register banks LDSR/STSR select.



#####################################################
#####		  DataManipulation		#####
#####################################################


# ROTL imm5, reg2, reg3 - rrrrr111111iiiii|wwwww00011000100
:rotl op0004, R1115, R2731 is op0510=0x3F & op0004 & R1115; op1626=0xC4 & R2731
{
	local lsh:4 = op0004;
	local res:4 = (R1115 << lsh) | (R1115 >> (32 - lsh));
	R2731 = res;
	set_OV0_S_Z(res);
	$(CY) = res[0,1] && (lsh != 0);
}

# ROTL reg1, reg2, reg3 - rrrrr111111RRRRR|wwwww00011000110
:rotl R0004, R1115, R2731 is op0510=0x3F & R0004 & R1115; op1626=0xC6 & R2731
{
	local lsh:4 = R0004 & 0x1f;
	local rsh:4 = (32 - lsh) & 0x1f;
	local res:4 = (R1115 << lsh) | (R1115 >> rsh);
	R2731 = res;
	set_OV0_S_Z(res);
	$(CY) = res[0,1] && (lsh != 0);
}

# BINS reg1, pos, width, reg2 - rrrrr111111RRRRR|MMMMK0001SS1LLL0
# msb = pos + width - 1 and lsb = pos; MMMM and KLLL are their low four bits,
# SS says which of them are 16 or more.
macro bitfield_insert(dst, src, msb, lsb)
{
	local mask:4 = ((2 << msb) - 1) & ~((1 << lsb) - 1);
	local res:4 = (dst & ~mask) | ((src << lsb) & mask);
	dst = res;
	set_OV0_S_Z(res);
}

:bins R0004, pos, width, R1115 is op0510=0x3F & R0004 & R1115; op2831 & op2727 & op2026=0x09 & op1719 & op1616=0
[ pos = ((op2727 << 3) | op1719) + 16; width = op2831 + 17 - pos; ]
{
	local msb:4 = op2831 + 16;
	local lsb:4 = pos;
	bitfield_insert(R1115, R0004, msb, lsb);
}
:bins R0004, pos, width, R1115 is op0510=0x3F & R0004 & R1115; op2831 & op2727 & op2026=0x0B & op1719 & op1616=0
[ pos = (op2727 << 3) | op1719; width = op2831 + 17 - pos; ]
{
	local msb:4 = op2831 + 16;
	local lsb:4 = pos;
	bitfield_insert(R1115, R0004, msb, lsb);
}
:bins R0004, pos, width, R1115 is op0510=0x3F & R0004 & R1115; op2831 & op2727 & op2026=0x0D & op1719 & op1616=0
[ pos = (op2727 << 3) | op1719; width = op2831 + 1 - pos; ]
{
	local msb:4 = op2831;
	local lsb:4 = pos;
	bitfield_insert(R1115, R0004, msb, lsb);
}



#####################################################
#####		     Load / Store		#####
#####################################################


# LD.DW disp23[reg1], reg3 - 00000111101RRRRR|wwwwwdddddd01001|DDDDDDDDDDDDDDDD
:ld.dw disp23[R0004], R2731x2 is op0515=0x3D & R0004; R2731x2 & op2727=0 & op2126 & op1620=0x9; s3247
[ disp23 = (s3247 << 7) | (op2126 << 1); ]
{
	local adr:4 = R0004 + disp23;
	R2731x2 = *:8 adr;
}
:ld.dw disp23[R0004], R2731 is op0515=0x3D & R0004; R2731 & R2731hi & op2727=1 & op2126 & op1620=0x9; s3247
[ disp23 = (s3247 << 7) | (op2126 << 1); ]
{
	local adr:4 = R0004 + disp23;
	local data:8 = *:8 adr;
	R2731 = data:4;
	R2731hi = data(4);
}

# ST.DW reg3, disp23[reg1] - 00000111101RRRRR|wwwwwdddddd01111|DDDDDDDDDDDDDDDD
:st.dw R2731x2, disp23[R0004] is op0515=0x3D & R0004; R2731x2 & op2727=0 & op2126 & op1620=0xF; s3247
[ disp23 = (s3247 << 7) | (op2126 << 1); ]
{
	local adr:4 = R0004 + disp23;
	*:8 adr = R2731x2;
}
:st.dw R2731, disp23[R0004] is op0515=0x3D & R0004; R2731 & R2731hi & op2727=1 & op2126 & op1620=0xF; s3247
[ disp23 = (s3247 << 7) | (op2126 << 1); ]
{
	local adr:4 = R0004 + disp23;
	local data:8 = (zext(R2731hi) << 32) | zext(R2731);
	*:8 adr = data;
}

# LDL.W [reg1], reg3 - 00000111111RRRRR|wwwww01101111000
:ldl.w [R0004], R2731 is op0515=0x3F & R0004; op1626=0x378 & R2731
{
	R2731 = *:4 R0004;
	LLBIT = 1;
}

# STC.W reg3, [reg1] - 00000111111RRRRR|wwwww01101111010
:stc.w R2731, [R0004] is op0515=0x3F & R0004; op1626=0x37A & R2731
{
	local linked:1 = LLBIT;
	LLBIT = 0;
	if (!linked) goto <done>;
	*:4 R0004 = R2731;
	<done>
	R2731 = zext(linked);
}

# CLL - 1111111111111111|1111000101100000
:cll is op0015=0xFFFF; op1631=0xF160
{
	LLBIT = 0;
}



#####################################################
#####		    Stack ranges		#####
#####################################################


# PUSHSP rh-rt stores rh, rh+1, ... rt at descending addresses; POPSP rh-rt
# loads rt, rt-1, ... rh at ascending ones.  Each general register has one
# table per direction that acts only when rh <= register <= rt; the two
# comparisons are written as the bit prefixes that cover the range.
Push0: is op0004=0; op2731	{ local zero:4 = 0; push(zero); }
Push0: is op0004; op2731	{ }
Push1: is op0104=0; (op2731=1 | op2831=1 | op2931=1 | op3031=1 | op3131=1)	{ push(r1); }
Push1: is op0004; op2731	{ }
Push2: is (op0104=0 | op0004=2); (op2831=1 | op2931=1 | op3031=1 | op3131=1)	{ push(r2); }
Push2: is op0004; op2731	{ }
Push3: is op0204=0 & rh0004; (op2731=3 | op2931=1 | op3031=1 | op3131=1)	{ local old:4 = sp + ((3 - rh0004) * 4); push(old); }
Push3: is op0004; op2731	{ }
Push4: is (op0204=0 | op0004=4); (op2931=1 | op3031=1 | op3131=1)	{ push(gp); }
Push4: is op0004; op2731	{ }
Push5: is (op0204=0 | op0104=2); (op2731=5 | op2831=3 | op3031=1 | op3131=1)	{ push(tp); }
Push5: is op0004; op2731	{ }
Push6: is (op0204=0 | op0104=2 | op0004=6); (op2831=3 | op3031=1 | op3131=1)	{ push(r6); }
Push6: is op0004; op2731	{ }
Push7: is op0304=0; (op2731=7 | op3031=1 | op3131=1)	{ push(r7); }
Push7: is op0004; op2731	{ }
Push8: is (op0304=0 | op0004=8); (op3031=1 | op3131=1)	{ push(r8); }
Push8: is op0004; op2731	{ }
Push9: is (op0304=0 | op0104=4); (op2731=9 | op2831=5 | op2931=3 | op3131=1)	{ push(r9); }
Push9: is op0004; op2731	{ }
Push10: is (op0304=0 | op0104=4 | op0004=10); (op2831=5 | op2931=3 | op3131=1)	{ push(r10); }
Push10: is op0004; op2731	{ }
Push11: is (op0304=0 | op0204=2); (op2731=11 | op2931=3 | op3131=1)	{ push(r11); }
Push11: is op0004; op2731	{ }
Push12: is (op0304=0 | op0204=2 | op0004=12); (op2931=3 | op3131=1)	{ push(r12); }
Push12: is op0004; op2731	{ }
Push13: is (op0304=0 | op0204=2 | op0104=6); (op2731=13 | op2831=7 | op3131=1)	{ push(r13); }
Push13: is op0004; op2731	{ }
Push14: is (op0304=0 | op0204=2 | op0104=6 | op0004=14); (op2831=7 | op3131=1)	{ push(r14); }
Push14: is op0004; op2731	{ }
Push15: is op0404=0; (op2731=15 | op3131=1)	{ push(r15); }
Push15: is op0004; op2731	{ }
Push16: is (op0404=0 | op0004=16); op3131=1	{ push(r16); }
Push16: is op0004; op2731	{ }
Push17: is (op0404=0 | op0104=8); (op2731=17 | op2831=9 | op2931=5 | op3031=3)	{ push(r17); }
Push17: is op0004; op2731	{ }
Push18: is (op0404=0 | op0104=8 | op0004=18); (op2831=9 | op2931=5 | op3031=3)	{ push(r18); }
Push18: is op0004; op2731	{ }
Push19: is (op0404=0 | op0204=4); (op2731=19 | op2931=5 | op3031=3)	{ push(r19); }
Push19: is op0004; op2731	{ }
Push20: is (op0404=0 | op0204=4 | op0004=20); (op2931=5 | op3031=3)	{ push(r20); }
Push20: is op0004; op2731	{ }
Push21: is (op0404=0 | op0204=4 | op0104=10); (op2731=21 | op2831=11 | op3031=3)	{ push(r21); }
Push21: is op0004; op2731	{ }
Push22: is (op0404=0 | op0204=4 | op0104=10 | op0004=22); (op2831=11 | op3031=3)	{ push(r22); }
Push22: is op0004; op2731	{ }
Push23: is (op0404=0 | op0304=2); (op2731=23 | op3031=3)	{ push(r23); }
Push23: is op0004; op2731	{ }
Push24: is (op0404=0 | op0304=2 | op0004=24); op3031=3	{ push(r24); }
Push24: is op0004; op2731	{ }
Push25: is (op0404=0 | op0304=2 | op0104=12); (op2731=25 | op2831=13 | op2931=7)	{ push(r25); }
Push25: is op0004; op2731	{ }
Push26: is (op0404=0 | op0304=2 | op0104=12 | op0004=26); (op2831=13 | op2931=7)	{ push(r26); }
Push26: is op0004; op2731	{ }
Push27: is (op0404=0 | op0304=2 | op0204=6); (op2731=27 | op2931=7)	{ push(r27); }
Push27: is op0004; op2731	{ }
Push28: is (op0404=0 | op0304=2 | op0204=6 | op0004=28); op2931=7	{ push(r28); }
Push28: is op0004; op2731	{ }
Push29: is (op0404=0 | op0304=2 | op0204=6 | op0104=14); (op2731=29 | op2831=15)	{ push(r29); }
Push29: is op0004; op2731	{ }
Push30: is (op0404=0 | op0304=2 | op0204=6 | op0104=14 | op0004=30); op2831=15	{ push(ep); }
Push30: is op0004; op2731	{ }
Push31: is op0004; op2731=31	{ push(lp); }
Push31: is op0004; op2731	{ }

Pop0: is op0004=0; op2731	{ sp = sp + 4; }
Pop0: is op0004; op2731	{ }
Pop1: is op0104=0; (op2731=1 | op2831=1 | op2931=1 | op3031=1 | op3131=1)	{ pop(r1); }
Pop1: is op0004; op2731	{ }
Pop2: is (op0104=0 | op0004=2); (op2831=1 | op2931=1 | op3031=1 | op3131=1)	{ pop(r2); }
Pop2: is op0004; op2731	{ }
Pop3: is op0204=0; (op2731=3 | op2931=1 | op3031=1 | op3131=1)	{ sp = sp + 4; }
Pop3: is op0004; op2731	{ }
