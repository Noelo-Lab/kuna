:mov rd, imm4 is op8=0x04 & rd & imm4 { rd = imm4; }   # PROVEN
:mov rd, imm16 is op8=0x0c & rd ; imm16 { rd = imm16; }   # PROVEN
:mov rd, rs is op8=0x06 & rd & rs { rd = rs; }   # PROVEN
:inv rd, imm4 is op8=0x14 & rd & imm4 { rd = -imm4; }   # PROVEN negate, not bitwise NOT - the register forms 0x15/0x16 are the NOT
:inv rd, imm16 is op8=0x1c & rd ; imm16 { rd = -imm16; }   # PROVEN negate; protocol-header and checksum-seed constants only resolve under -imm
:inv rd, rs is op8=0x16 & rd & rs { rd = ~rs; }   # PROVEN
:add rd, imm4 is op8=0x24 & rd & imm4 { rd = rd + imm4; }   # PROVEN
:add rd, imm16 is op8=0x2c & rd ; imm16 { rd = rd + imm16; }   # PROVEN
:add rd, rs is op8=0x26 & rd & rs { rd = rd + rs; }   # PROVEN
:sub rd, imm4 is op8=0x34 & rd & imm4 { rd = rd - imm4; }   # PROVEN
:sub rd, imm16 is op8=0x3c & rd ; imm16 { rd = rd - imm16; }   # PROVEN
:sub rd, rs is op8=0x36 & rd & rs { rd = rd - rs; }   # PROVEN
:un_cmpx rd, imm4 is op8=0x44 & rd & imm4 { local a4:4 = imm4; rd = aps3_unknown_op(rd, a4); }   # GUESS (unused non-cc compare)
:un_cmpx rd, imm16 is op8=0x4c & rd ; imm16 { local a16:4 = imm16; rd = aps3_unknown_op_imm(rd, a16); }   # GUESS (unused non-cc compare)
:un_cmpx rd, rs is op8=0x46 & rd & rs { rd = aps3_unknown_op(rd, rs); }   # GUESS (unused non-cc compare)
:and rd, imm4 is op8=0x54 & rd & imm4 { rd = rd & imm4; }   # STRONG
:and rd, imm16 is op8=0x5c & rd ; imm16 { rd = rd & imm16; }   # STRONG
:and rd, rs is op8=0x56 & rd & rs { rd = rd & rs; }   # STRONG
:or rd, imm4 is op8=0x64 & rd & imm4 { rd = rd | imm4; }   # INFERRED
:or rd, imm16 is op8=0x6c & rd ; imm16 { rd = rd | imm16; }   # INFERRED
:or rd, rs is op8=0x66 & rd & rs { rd = rd | rs; }   # INFERRED
:xor rd, imm4 is op8=0x74 & rd & imm4 { rd = rd ^ imm4; }   # PROVEN
