:ldub.cc rd, [RSRC, imm16] is op8=0x98 & rd & RSRC ; imm16 { rd = zext(*:1 (RSRC + imm16)); ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN load
:lduh.cc rd, [RSRC] is op8=0xa0 & rd & RSRC { rd = zext(*:2 RSRC); ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN load
