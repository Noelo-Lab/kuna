# Cortus APS3 (aps3) SLEIGH -- complete 256-opcode map. Generated; see README.md.
define endian=little;
define alignment=2;
define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;
define register offset=0x00 size=4 [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
define register offset=0x40 size=4 [ rtt psr pc ];
define register offset=0x60 size=1 [ ZF NF CF VF ];
define token instr(16) op8=(0,7) op7=(0,6) sh5=(7,11) oplo=(0,3) tlo=(4,7) sd=(14,15) sb=(12,13) soff=(8,11) rd=(12,15) rdA=(12,15) rdB=(12,15) rdC=(12,15) rdD=(12,15) rs=(8,11) tmid=(8,11) thi=(12,15) imm4=(8,11) simm8=(8,15) signed disp8u=(8,15);
define token immtok(16) imm16=(0,15) simm16=(0,15) signed imm5=(0,4) rs2=(0,3);
attach variables [ rd rs rs2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ rdA ] [ r0 r0 r2 r2 r4 r4 r6 r6 r8 r8 r10 r10 r12 r12 r14 r14 ];
attach variables [ rdB ] [ r1 r1 r3 r3 r5 r5 r7 r7 r9 r9 r11 r11 r13 r13 r15 r15 ];
attach variables [ rdC ] [ r2 r2 r2 r2 r6 r6 r6 r6 r10 r10 r10 r10 r14 r14 r14 r14 ];
attach variables [ rdD ] [ r3 r3 r3 r3 r7 r7 r7 r7 r11 r11 r11 r11 r15 r15 r15 r15 ];
# r0 reads as constant zero; RSRC exports that so [r0+off] folds to an absolute address
RSRC: rs is rs        { export rs; }
RSRC: "r0" is rs=0 { export 0:4; }
RDSRC: rd is rd     { export rd; }
RDSRC: "r0" is rd=0 { export 0:4; }
attach variables [ sd ] [ r4 r5 r6 r7 ];
attach variables [ sb ] [ r4 r1 r2 r3 ];
so2: v is soff [ v = soff*2; ] { export *[const]:4 v; }
so4: v is soff [ v = soff*4; ] { export *[const]:4 v; }
relS: reloc is simm8 [ reloc = inst_start + 2*simm8; ] { export *:4 reloc; }


# Opcodes whose *length and operand format* are established but whose operation is
# not.  They are emitted as explicit unknown-value p-code rather than `unimpl`:
# `unimpl` aborts the enclosing basic block, which costs the whole function, while
# an opaque value keeps control flow and lets every other statement decompile.
define pcodeop aps3_unknown_op;
define pcodeop aps3_unknown_op_imm;

:nop            is op8=0x00 & rd & rs { }                                      # PROVEN pad
:movhi rd,imm16 is op8=0x08 & rd ; imm16 { rd = imm16 << 16; }                 # PROVEN
:ret            is op8=0xE1 & rd=15 & rs=0 { return [r15]; }                   # PROVEN
:jmp [rd]       is op8=0xE1 & rd { goto [rd]; }                                # PROVEN
:call [rd]      is op8=0xF1 & rd { local tgt:4 = rd; r15 = inst_next; call [tgt]; }   # PROVEN indirect call; tgt is snapshotted because rd is often r15 itself, which the link write would clobber
:ble relS is op8=0x02 & relS { if ((ZF!=0)||(NF!=VF)) goto relS; }   # PROVEN short branch (disp8)
lb0a: reloc is op8=0x0a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:ble lb0a is lb0a { if ((ZF!=0)||(NF!=VF)) goto lb0a; }   # PROVEN long branch (disp24)
:bgt relS is op8=0x12 & relS { if ((ZF==0)&&(NF==VF)) goto relS; }   # PROVEN short branch (disp8)
lb1a: reloc is op8=0x1a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bgt lb1a is lb1a { if ((ZF==0)&&(NF==VF)) goto lb1a; }   # PROVEN long branch (disp24)
:blt relS is op8=0x22 & relS { if (NF!=VF) goto relS; }   # PROVEN short branch (disp8)
lb2a: reloc is op8=0x2a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:blt lb2a is lb2a { if (NF!=VF) goto lb2a; }   # PROVEN long branch (disp24)
:bge relS is op8=0x32 & relS { if (NF==VF) goto relS; }   # PROVEN short branch (disp8)
lb3a: reloc is op8=0x3a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bge lb3a is lb3a { if (NF==VF) goto lb3a; }   # PROVEN long branch (disp24)
:bmi relS is op8=0x42 & relS { if (NF!=0) goto relS; }   # PROVEN short branch (disp8)
lb4a: reloc is op8=0x4a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bmi lb4a is lb4a { if (NF!=0) goto lb4a; }   # PROVEN long branch (disp24)
:bpl relS is op8=0x52 & relS { if (NF==0) goto relS; }   # PROVEN short branch (disp8)
lb5a: reloc is op8=0x5a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bpl lb5a is lb5a { if (NF==0) goto lb5a; }   # PROVEN long branch (disp24)
:bvs relS is op8=0x62 & relS { if (VF!=0) goto relS; }   # PROVEN short branch (disp8)
lb6a: reloc is op8=0x6a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bvs lb6a is lb6a { if (VF!=0) goto lb6a; }   # PROVEN long branch (disp24)
:bvc relS is op8=0x72 & relS { if (VF==0) goto relS; }   # PROVEN short branch (disp8)
lb7a: reloc is op8=0x7a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bvc lb7a is lb7a { if (VF==0) goto lb7a; }   # PROVEN long branch (disp24)
:beq relS is op8=0x82 & relS { if (ZF!=0) goto relS; }   # PROVEN short branch (disp8)
lb8a: reloc is op8=0x8a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:beq lb8a is lb8a { if (ZF!=0) goto lb8a; }   # PROVEN long branch (disp24)
:bne relS is op8=0x92 & relS { if (ZF==0) goto relS; }   # PROVEN short branch (disp8)
lb9a: reloc is op8=0x9a & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bne lb9a is lb9a { if (ZF==0) goto lb9a; }   # PROVEN long branch (disp24)
:blo relS is op8=0xa2 & relS { if (CF!=0) goto relS; }   # PROVEN short branch (disp8)
lbaa: reloc is op8=0xaa & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:blo lbaa is lbaa { if (CF!=0) goto lbaa; }   # PROVEN long branch (disp24)
:bhs relS is op8=0xb2 & relS { if (CF==0) goto relS; }   # PROVEN short branch (disp8)
lbba: reloc is op8=0xba & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bhs lbba is lbba { if (CF==0) goto lbba; }   # PROVEN long branch (disp24)
:bls relS is op8=0xc2 & relS { if ((CF!=0)||(ZF!=0)) goto relS; }   # PROVEN short branch (disp8)
lbca: reloc is op8=0xca & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bls lbca is lbca { if ((CF!=0)||(ZF!=0)) goto lbca; }   # PROVEN long branch (disp24)
:bhi relS is op8=0xd2 & relS { if ((CF==0)&&(ZF==0)) goto relS; }   # PROVEN short branch (disp8)
lbda: reloc is op8=0xda & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bhi lbda is lbda { if ((CF==0)&&(ZF==0)) goto lbda; }   # PROVEN long branch (disp24)
:brn relS is op8=0xe2 & relS {  }   # PROVEN short branch (disp8)
lbea: reloc is op8=0xea & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:brn lbea is lbea {  }   # PROVEN long branch (disp24)
:bra relS is op8=0xf2 & relS { goto relS; }   # PROVEN short branch (disp8)
lbfa: reloc is op8=0xfa & disp8u ; imm16 [ reloc = inst_start + 2*((((imm16 * 256) + disp8u) ^ 0x800000) - 0x800000); ] { export *:4 reloc; }
:bra lbfa is lbfa { goto lbfa; }   # PROVEN long branch (disp24)
:ldub rd, [RSRC] is op8=0x10 & rd & RSRC { rd = zext(*:1 RSRC); }   # PROVEN load
:stb RDSRC, [RSRC] is op8=0x91 & RDSRC & RSRC { *:1 RSRC = RDSRC:1; }   # PROVEN store
:ldub rd, [RSRC, imm16] is op8=0x18 & rd & RSRC ; imm16 { rd = zext(*:1 (RSRC + imm16)); }   # PROVEN load
:stb RDSRC, [RSRC, imm16] is op8=0x99 & RDSRC & RSRC ; imm16 { *:1 (RSRC + imm16) = RDSRC:1; }   # PROVEN store
:lduh rd, [RSRC] is op8=0x20 & rd & RSRC { rd = zext(*:2 RSRC); }   # PROVEN load
:sth RDSRC, [RSRC] is op8=0xa1 & RDSRC & RSRC { *:2 RSRC = RDSRC:2; }   # PROVEN store
:lduh rd, [RSRC, imm16] is op8=0x28 & rd & RSRC ; imm16 { rd = zext(*:2 (RSRC + imm16)); }   # PROVEN load
:sth RDSRC, [RSRC, imm16] is op8=0xa9 & RDSRC & RSRC ; imm16 { *:2 (RSRC + imm16) = RDSRC:2; }   # PROVEN store
:ld rd, [RSRC] is op8=0x30 & rd & RSRC { rd = *:4 RSRC; }   # PROVEN load
:st RDSRC, [RSRC] is op8=0xb1 & RDSRC & RSRC { *:4 RSRC = RDSRC; }   # PROVEN store
:ld rd, [RSRC, imm16] is op8=0x38 & rd & RSRC ; imm16 { rd = *:4 (RSRC + imm16); }   # PROVEN load
:st RDSRC, [RSRC, imm16] is op8=0xb9 & RDSRC & RSRC ; imm16 { *:4 (RSRC + imm16) = RDSRC; }   # PROVEN store
:ldd rdA, [RSRC] is op8=0x40 & rdA & rdB & rdC & rdD & RSRC { rdA = *:4 RSRC; rdB = *:4 (RSRC + 4); }   # STRONG load
:std rdA, [RSRC] is op8=0xc1 & rdA & rdB & rdC & rdD & RSRC { *:4 RSRC = rdA; *:4 (RSRC + 4) = rdB; }   # STRONG multi-reg store
:ldd rdA, [RSRC, imm16] is op8=0x48 & rdA & rdB & rdC & rdD & RSRC ; imm16 { rdA = *:4 (RSRC + imm16); rdB = *:4 ((RSRC + imm16) + 4); }   # STRONG load
:std rdA, [RSRC, imm16] is op8=0xc9 & rdA & rdB & rdC & rdD & RSRC ; imm16 { *:4 (RSRC + imm16) = rdA; *:4 ((RSRC + imm16) + 4) = rdB; }   # STRONG multi-reg store
:ldq rdA, [RSRC] is op8=0x50 & rdA & rdB & rdC & rdD & RSRC { rdA = *:4 RSRC; rdB = *:4 (RSRC + 4); rdC = *:4 (RSRC + 8); rdD = *:4 (RSRC + 12); }   # STRONG load
:stq rdA, [RSRC] is op8=0xd1 & rdA & rdB & rdC & rdD & RSRC { *:4 RSRC = rdA; *:4 (RSRC + 4) = rdB; *:4 (RSRC + 8) = rdC; *:4 (RSRC + 12) = rdD; }   # STRONG multi-reg store
:ldq rdA, [RSRC, imm16] is op8=0x58 & rdA & rdB & rdC & rdD & RSRC ; imm16 { rdA = *:4 (RSRC + imm16); rdB = *:4 ((RSRC + imm16) + 4); rdC = *:4 ((RSRC + imm16) + 8); rdD = *:4 ((RSRC + imm16) + 12); }   # STRONG load
:stq rdA, [RSRC, imm16] is op8=0xd9 & rdA & rdB & rdC & rdD & RSRC ; imm16 { *:4 (RSRC + imm16) = rdA; *:4 ((RSRC + imm16) + 4) = rdB; *:4 ((RSRC + imm16) + 8) = rdC; *:4 ((RSRC + imm16) + 12) = rdD; }   # STRONG multi-reg store
:ldsb rd, [RSRC] is op8=0x60 & rd & RSRC { rd = sext(*:1 RSRC); }   # INFERRED load
:ldsb rd, [RSRC, imm16] is op8=0x68 & rd & RSRC ; imm16 { rd = sext(*:1 (RSRC + imm16)); }   # INFERRED load
:ldsh rd, [RSRC] is op8=0x70 & rd & RSRC { rd = sext(*:2 RSRC); }   # INFERRED load
:ldsh rd, [RSRC, imm16] is op8=0x78 & rd & RSRC ; imm16 { rd = sext(*:2 (RSRC + imm16)); }   # INFERRED load
