# The direct call names a halfword index inside the PC's own 256 KiB window: 17 bits
# cannot carry a 32-bit address, and the three images that load outside 0x80000000
# (a 0x60000000 boot stage and its second stage) resolve every one of their call
# targets inside their own extent under this rule and none under a fixed base.
calltgt: reloc is oplo=0xB & tlo & tmid & thi ; imm5 [ reloc = (inst_start $and 0xFFFC0000) + 2*(tlo + (tmid << 4) + (thi << 8) + (imm5 << 12)); ] { export *:4 reloc; }
