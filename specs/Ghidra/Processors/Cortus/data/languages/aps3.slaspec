:ldd.cc rdA, [RSRC, imm16] is op8=0xc8 & rdA & rdB & rdC & rdD & RSRC ; imm16 { rdA = *:4 (RSRC + imm16); rdB = *:4 ((RSRC + imm16) + 4); }   # STRONG load
:ldq.cc rdA, [RSRC] is op8=0xd0 & rdA & rdB & rdC & rdD & RSRC { rdA = *:4 RSRC; rdB = *:4 (RSRC + 4); rdC = *:4 (RSRC + 8); rdD = *:4 (RSRC + 12); }   # STRONG load
:ldq.cc rdA, [RSRC, imm16] is op8=0xd8 & rdA & rdB & rdC & rdD & RSRC ; imm16 { rdA = *:4 (RSRC + imm16); rdB = *:4 ((RSRC + imm16) + 4); rdC = *:4 ((RSRC + imm16) + 8); rdD = *:4 ((RSRC + imm16) + 12); }   # STRONG load
