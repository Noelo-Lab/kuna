:mov.cc rd, imm4 is op8=0x84 & rd & imm4 { rd = imm4; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN
:mov.cc rd, imm16 is op8=0x8c & rd ; imm16 { rd = imm16; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN
:mov.cc rd, rs is op8=0x86 & rd & rs { rd = rs; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN
:inv.cc rd, imm4 is op8=0x94 & rd & imm4 { rd = -imm4; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN .cc form of 0x14
:inv.cc rd, imm16 is op8=0x9c & rd ; imm16 { rd = -imm16; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN .cc form of 0x1c
:inv.cc rd, rs is op8=0x96 & rd & rs { rd = ~rs; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN
:add.cc rd, imm4 is op8=0xa4 & rd & imm4 { CF = carry(rd, imm4); VF = scarry(rd, imm4); rd = rd + imm4; ZF=(rd==0); NF=(rd s< 0); }   # PROVEN
:add.cc rd, imm16 is op8=0xac & rd ; imm16 { CF = carry(rd, imm16); VF = scarry(rd, imm16); rd = rd + imm16; ZF=(rd==0); NF=(rd s< 0); }   # PROVEN
:add.cc rd, rs is op8=0xa6 & rd & rs { CF = carry(rd, rs); VF = scarry(rd, rs); rd = rd + rs; ZF=(rd==0); NF=(rd s< 0); }   # PROVEN
:sub.cc rd, imm4 is op8=0xb4 & rd & imm4 { CF = (rd < imm4); VF = sborrow(rd, imm4); rd = rd - imm4; ZF=(rd==0); NF=(rd s< 0); }   # PROVEN
:sub.cc rd, imm16 is op8=0xbc & rd ; imm16 { CF = (rd < imm16); VF = sborrow(rd, imm16); rd = rd - imm16; ZF=(rd==0); NF=(rd s< 0); }   # PROVEN
:sub.cc rd, rs is op8=0xb6 & rd & rs { CF = (rd < rs); VF = sborrow(rd, rs); rd = rd - rs; ZF=(rd==0); NF=(rd s< 0); }   # PROVEN
:cmp rd, imm4 is op8=0xc4 & rd & imm4 { local d = rd - imm4; ZF=(d==0); NF=(d s< 0); CF=(rd < imm4); VF = sborrow(rd, imm4); }   # PROVEN
:cmp rd, imm16 is op8=0xcc & rd ; imm16 { local d = rd - imm16; ZF=(d==0); NF=(d s< 0); CF=(rd < imm16); VF = sborrow(rd, imm16); }   # PROVEN
:cmp rd, rs is op8=0xc6 & rd & rs { local d = rd - rs; ZF=(d==0); NF=(d s< 0); CF=(rd < rs); VF = sborrow(rd, rs); }   # PROVEN
:and.cc rd, imm4 is op8=0xd4 & rd & imm4 { rd = rd & imm4; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # STRONG
:and.cc rd, imm16 is op8=0xdc & rd ; imm16 { rd = rd & imm16; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # STRONG
:and.cc rd, rs is op8=0xd6 & rd & rs { rd = rd & rs; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # STRONG
:or.cc rd, imm4 is op8=0xe4 & rd & imm4 { rd = rd | imm4; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # INFERRED
:or.cc rd, imm16 is op8=0xec & rd ; imm16 { rd = rd | imm16; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # INFERRED
:or.cc rd, rs is op8=0xe6 & rd & rs { rd = rd | rs; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # INFERRED
:xor.cc rd, imm4 is op8=0xf4 & rd & imm4 { rd = rd ^ imm4; ZF=(rd==0); NF=(rd s< 0); VF = 0; }   # PROVEN
