+/// One `SSGATE` line per function the action turned away before `synthesize`.
+fn census_gate(data: &Funcdata, started: bool, exceeded: bool, settled: bool) {
+    if std::env::var_os("KUNA_SS_CENSUS").is_none() {
+        return;
+    }
+    eprintln!(
+        "SSGATE fn=0x{:x} started={started} exceeded={exceeded} settled={settled}",
+        data.get_address().get_offset()
+    );
+}
