+/// One `SSCENSUS` line per candidate base, on stderr, when `KUNA_SS_CENSUS` is set.
+fn census_dump(data: &mut Funcdata, raw: &BTreeMap<VarnodeId, Evidence>) {
+    if std::env::var_os("KUNA_SS_CENSUS").is_none() {
+        return;
+    }
+    let fnaddr = data.get_address().get_offset();
+    let bases: Vec<VarnodeId> = raw.keys().copied().collect();
+    for base in bases {
+        let e = raw[&base].pruned();
+        let arg = census_arg_index(data, base).map(|i| i as i64).unwrap_or(-1);
+        let reason = census_reason(data, base, &e);
+        let raw_e = &raw[&base];
+        let spell = |m: &BTreeMap<intb, Slot>| -> String {
+            m.iter().map(|(o, s)| format!("{o}:{}", s.width)).collect::<Vec<_>>().join(",")
+        };
+        let dropped = e
+            .unclaimed
+            .iter()
+            .map(|(o, w)| format!("{o}:{w}"))
+            .collect::<Vec<_>>()
+            .join(",");
+        let vaddr = data
+            .vbank()
+            .get(base)
+            .map(|v| {
+                format!(
+                    "{}:{:x}:{}",
+                    v.get_addr().get_space().map(|s| s.get_index()).unwrap_or(-1),
+                    v.get_offset(),
+                    v.get_size()
+                )
+            })
+            .unwrap_or_default();
+        let hasstore = data.get_func_proto().kuna_has_store();
+        let nparams = if hasstore { data.get_func_proto().num_params() } else { -1 };
+        let ty = vn_type(data, base)
+            .map(|t| format!("{:?}/{}", t.get_metatype(), t.get_name()))
+            .unwrap_or_else(|| "none".into());
+        eprintln!(
+            "SSCENSUS fn=0x{fnaddr:x} arg={arg} input={} reason={reason} ty={ty} \
+             vn={vaddr} store={hasstore} np={nparams} \
+             raw={} pruned={} dropped=[{dropped}] dyn={} int={} phi={}",
+            data.vbank().get(base).map(|v| v.is_input()).unwrap_or(false),
+            spell(&raw_e.slots),
+            spell(&e.slots),
+            raw_e.dynamic_offset,
+            raw_e.integer_use,
+            raw_e.phi_reached,
+        );
+    }
+}
