+// ---- CENSUS INSTRUMENTATION (scratch only, never committed) ----
+/// The parameter index of the varnode `base`, when it is one.
+fn census_arg_index(data: &Funcdata, base: VarnodeId) -> Option<usize> {
+    let addr = data.vbank().get(base)?.get_addr().clone();
+    let proto = data.get_func_proto();
+    if !proto.kuna_has_store() {
+        return None;
+    }
+    let mut pos = 0usize;
+    for i in 0..proto.num_params() {
+        let p = proto.get_param(i)?;
+        if p.is_hidden_return() {
+            continue;
+        }
+        let pa = p.get_address();
+        let same = pa.get_space().map(|s| s.get_index()) == addr.get_space().map(|s| s.get_index())
+            && pa.get_offset() == addr.get_offset();
+        if same {
+            return Some(pos);
+        }
+        pos += 1;
+    }
+    None
+}
+
+/// Why `accepts` turned this base away, in the order it checks.
+fn census_reason(data: &mut Funcdata, base: VarnodeId, e: &Evidence) -> &'static str {
+    let Some(v) = data.vbank().get(base) else { return "no_varnode" };
+    let is_input = v.is_input();
+    let lock = v.is_type_lock();
+    let spacey = v.is_spacebase() || v.is_persist()
+        || v.get_space().get_type() == spacetype::IPTR_SPACEBASE;
+    if !is_input && !(data.get_arch().struct_synth.locals() && is_local_base(data, base, e)) {
+        return if is_call_return(data, base) { "local_declined" } else { "not_a_base" };
+    }
+    if lock {
+        return "type_lock";
+    }
+    if spacey {
+        return "spacebase_or_global";
+    }
+    let Some(ct) = vn_type(data, base) else { return "no_type" };
+    if ct.get_metatype() != type_metatype::TYPE_PTR {
+        return "not_a_pointer";
+    }
+    if points_at_named_composite(&ct) {
+        return "named_composite";
+    }
+    if e.dynamic_offset {
+        return "dynamic_offset";
+    }
+    if e.integer_use {
+        return "integer_use";
+    }
+    if e.phi_reached {
+        return "phi_reached";
+    }
+    if e.slots.len() < 2 {
+        return "fewer_than_two_offsets";
+    }
+    if e.slots.keys().any(|off| *off < 0 || *off >= MAX_FIELD_OFFSET) {
+        return "offset_out_of_range";
+    }
+    if !e.slots.contains_key(&0) {
+        return "no_offset_zero";
+    }
+    let ptr_size = data.get_arch().types().map(|t| t.get_size_of_pointer()).unwrap_or(8);
+    if is_array_shaped(&e.slots, ptr_size) {
+        return "array_shaped";
+    }
+    "accepted"
+}
